#!/usr/bin/env bash

# Tests: skills/adb/tests/test-adb-tile

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ADD_BIN="$DIR/../scripts/adb-tile-add"
REMOVE_BIN="$DIR/../scripts/adb-tile-remove"
LIST_BIN="$DIR/../scripts/adb-tiles"
DUMP_BIN="$DIR/../scripts/adb-tile-dump"

echo "1..41"

TMPDIR_TEST=$(mktemp -d)
OUTPUT="$TMPDIR_TEST/output"
STDOUT="$TMPDIR_TEST/stdout"
ADB_LOG="$TMPDIR_TEST/adb.log"
TRAY_STATE="$TMPDIR_TEST/tray"
MOCK_BIN="$TMPDIR_TEST/bin"
WORK="$TMPDIR_TEST/work"
mkdir -p "$MOCK_BIN" "$WORK"
trap 'rm -rf "$TMPDIR_TEST"' EXIT

# Mock adb. The tray is modelled as a state file with one "ID TYPE COMPONENT"
# line per widget; GET_WIDGETS, REMOVE_WIDGET, and DUMP_RC_DOC read and update
# it. MOCK_TRAY_V2=0 models a renderer without GET_WIDGETS / DUMP_RC_DOC.
cat <<'EOF' >"$MOCK_BIN/adb"
#!/usr/bin/env bash
# Model how adb hands commands to the device shell: adb shell joins its
# arguments unescaped, and recent adb exec-out escapes each argument when given
# several; a single argument is passed verbatim. Re-parse accordingly so that
# quoting bugs show up here.
if [[ "${1:-}" == "shell" ]] || [[ "${1:-}" == "exec-out" && $# -eq 2 ]]; then
  eval "set -- $*"
fi
echo "$*" >>"$MOCK_ADB_LOG"

RC_DOC="RCDOC-0123456789"

next_count() {
  local file="${MOCK_ADB_LOG}.$1_count" count=0
  [[ -f "$file" ]] && count=$(cat "$file")
  count=$((count + 1))
  echo "$count" >"$file"
  echo "$count"
}

widget_json() {
  local id="$1" type="$2" component="$3" type_int=1
  [[ "$type" == "SMALL" ]] && type_int=2
  printf '{"widgetId":%s,"component":"%s","containerType":%s,"containerTypeString":"%s"}' \
    "$id" "${component//\//\\/}" "$type_int" "$type"
}

widgets_json() {
  local sep="" id type component
  printf '['
  while read -r id type component; do
    [[ -z "$id" ]] && continue
    [[ -n "${1:-}" && "$component" != "$1" ]] && continue
    printf '%s' "$sep"
    widget_json "$id" "$type" "$component"
    sep=","
  done <"$MOCK_TRAY_STATE"
  printf ']'
}

unanswered() {
  echo "Broadcasting: Intent { act=$1 }"
  echo "Broadcast completed: result=0"
  exit 0
}

WIDGET_ID_RE='widget_id ([0-9]+)'
COMPONENT_RE='component ([^ ]+)'

if [[ "${MOCK_BROADCAST_FAIL:-0}" == "1" && "$*" == *"prototiles.action."* ]]; then
  echo "error: closed" >&2
  exit 1
fi

case "$*" in
  "get-state")
    if [[ "${MOCK_DEVICES:-1}" != "1" ]]; then
      echo "error: more than one device/emulator" >&2
      exit 1
    fi
    exit 0
    ;;
  "logcat -c")
    exit 0
    ;;
  "logcat -v time"*)
    if [[ -n "${MOCK_CRASH:-}" ]]; then
      echo "09-28 18:42:01.000 E/AndroidRuntime( 4242): FATAL EXCEPTION: main"
      echo "09-28 18:42:01.000 E/AndroidRuntime( 4242): Process: ${MOCK_CRASH}, PID: 4242"
      echo "09-28 18:42:01.000 E/AndroidRuntime( 4242): java.lang.RuntimeException: boom"
    fi
    if [[ "${MOCK_RENDER_SILENT:-0}" != "1" ]]; then
      echo "09-28 18:42:01.100 D/ProtoTilesTileRendererImpl( 7956): Attaching Tile to a container. 4ee5d87 com.example/.MyWidget"
      echo "09-28 18:42:03.936 D/ProtoTilesTileRendererImpl( 7956): Received tile content. com.example/.MyWidget"
      echo "09-28 18:42:03.938 D/ProtoTilesTileRendererImpl( 7956): Rendering tile com.example/.MyWidget"
    fi
    if [[ "${MOCK_RENDER_FAIL:-0}" == "1" ]]; then
      echo "09-28 18:42:03.940 E/ProtoTilesTileRendererImpl( 7956): Failed to render and attach the tile: java.lang.IllegalArgumentException: Unsupported modifier"
    fi
    sleep 5
    exit 0
    ;;
  *"pm list packages"*)
    printf 'package:com.example\r\npackage:com.google.example.wear_widget\r\n'
    exit 0
    ;;
  *"cmd package resolve-activity --brief -n"*)
    if [[ "${MOCK_TRAY_SUPPORTED:-1}" == "1" ]]; then
      printf 'priority=0 preferredOrder=0 match=0x0 specificIndex=-1 isDefault=false\r\n'
      printf 'com.google.android.wearable.protolayout.renderer/com.google.android.clockwork.prototiles.renderer.experimental.WidgetTrayActivity\r\n'
    else
      printf 'No activity found\r\n'
    fi
    exit 0
    ;;
  *"dumpsys package com.google.android.wearable.protolayout.renderer"*)
    printf '    versionCode=16018700 minSdk=30 targetSdk=35\r\n'
    printf '    versionName=1.6.1.87.924797699\r\n'
    exit 0
    ;;
  *"am start"*)
    echo "Starting: Intent { cmp=com.google.android.wearable.protolayout.renderer/com.google.android.clockwork.prototiles.renderer.experimental.WidgetTrayActivity }"
    exit 0
    ;;
  *"am force-stop"*)
    exit 0
    ;;
  "shell id -u")
    printf '%s\r\n' "${MOCK_ADB_UID:-2000}"
    exit 0
    ;;
  "shell su 0 id -u")
    if [[ "${MOCK_SU:-1}" == "1" ]]; then
      printf '0\r\n'
    else
      echo "/system/bin/sh: su: inaccessible or not found" >&2
    fi
    exit 0
    ;;
  "exec-out cat "* | "exec-out su 0 cat "*)
    path="${!#}"
    if [[ "$path" == *"'"* ]]; then
      echo "cat: $path: No such file or directory"
      exit 0
    fi
    if [[ "${MOCK_PULL_SHORT:-0}" == "1" ]]; then
      printf '%s' "${RC_DOC:0:5}"
    elif [[ "${MOCK_PULL_ERROR:-0}" == "1" ]]; then
      # Same length as RC_DOC, so only the content check can catch it.
      printf '%s' "cat: nope: gone!"
    else
      printf '%s' "$RC_DOC"
    fi
    exit 0
    ;;
  "exec-out run-as "*)
    echo "run-as: couldn't stat /data/user/0/com.google.android.wearable.protolayout.renderer: Permission denied"
    exit 0
    ;;
  *"com.google.android.clockwork.prototiles.action.ADD_WIDGET"*)
    count=$(next_count add)

    if [[ "${MOCK_ADD_ERROR:-0}" == "1" ]]; then
      echo 'Broadcasting: Intent { act=com.google.android.clockwork.prototiles.action.ADD_WIDGET }'
      echo 'Broadcast completed: result=0, data="{"status":"ERROR","message":"Missing or unresolved component extra"}"'
      exit 0
    fi

    if ((count < ${MOCK_TRAY_READY_ATTEMPT:-1})); then
      unanswered ADD_WIDGET
    fi

    echo 'Broadcasting: Intent { act=com.google.android.clockwork.prototiles.action.ADD_WIDGET }'
    echo 'Broadcast completed: result=-1, data="{"status":"OK","action":"ADD_WIDGET","widgetId":10001,"component":"com.example/.MyWidget","containerType":2,"containerTypeString":"SMALL"}"'
    exit 0
    ;;
  *"com.google.android.clockwork.prototiles.action.GET_WIDGETS"*)
    count=$(next_count get)
    if [[ "${MOCK_TRAY_V2:-1}" != "1" ]] || ((count < ${MOCK_TRAY_READY_ATTEMPT:-1})); then
      unanswered GET_WIDGETS
    fi
    echo 'Broadcasting: Intent { act=com.google.android.clockwork.prototiles.action.GET_WIDGETS }'
    if ((count >= ${MOCK_GET_BAD_FROM:-999})); then
      echo 'Broadcast completed: result=-1, data="{"status":"OK","action":"GET_WIDGETS"}"'
      exit 0
    fi
    echo "Broadcast completed: result=-1, data=\"{\"status\":\"OK\",\"action\":\"GET_WIDGETS\",\"widgets\":$(widgets_json)}\""
    exit 0
    ;;
  *"com.google.android.clockwork.prototiles.action.REMOVE_WIDGET"*)
    echo 'Broadcasting: Intent { act=com.google.android.clockwork.prototiles.action.REMOVE_WIDGET }'
    if [[ "${MOCK_REMOVE_WEIRD:-0}" == "1" ]]; then
      echo 'Broadcast completed: result=0, data="oops"'
      exit 0
    fi
    if [[ "$*" =~ $WIDGET_ID_RE ]]; then
      id="${BASH_REMATCH[1]}"
      if [[ "$id" == "${MOCK_REMOVE_STUCK:-}" ]]; then
        echo "Broadcast completed: result=-1, data=\"{\"status\":\"OK\",\"action\":\"REMOVE_WIDGET\",\"widgetId\":$id,\"removed\":true}\""
      elif grep -q "^$id " "$MOCK_TRAY_STATE"; then
        grep -v "^$id " "$MOCK_TRAY_STATE" >"$MOCK_TRAY_STATE.new" || true
        mv "$MOCK_TRAY_STATE.new" "$MOCK_TRAY_STATE"
        echo "Broadcast completed: result=-1, data=\"{\"status\":\"OK\",\"action\":\"REMOVE_WIDGET\",\"widgetId\":$id,\"removed\":true}\""
      else
        echo "Broadcast completed: result=0, data=\"{\"status\":\"ERROR\",\"action\":\"REMOVE_WIDGET\",\"widgetId\":$id,\"removed\":false}\""
      fi
    elif [[ "$*" =~ $COMPONENT_RE ]]; then
      component="${BASH_REMATCH[1]}"
      if [[ "${MOCK_REMOVE_LEGACY:-0}" == "1" ]]; then
        echo 'Broadcast completed: result=-1, data="{"status":"OK","action":"REMOVE_WIDGET","removed":true}"'
        exit 0
      fi
      removed=$(awk -v c="$component" '$3 == c' "$MOCK_TRAY_STATE" | wc -l | tr -d ' ')
      awk -v c="$component" '$3 != c' "$MOCK_TRAY_STATE" >"$MOCK_TRAY_STATE.new"
      mv "$MOCK_TRAY_STATE.new" "$MOCK_TRAY_STATE"
      echo "Broadcast completed: result=-1, data=\"{\"status\":\"OK\",\"action\":\"REMOVE_WIDGET\",\"component\":\"${component//\//\\/}\",\"removedCount\":$removed}\""
    fi
    exit 0
    ;;
  *"com.google.android.clockwork.prototiles.action.DUMP_RC_DOC"*)
    if [[ "${MOCK_TRAY_V2:-1}" != "1" ]]; then
      unanswered DUMP_RC_DOC
    fi
    echo 'Broadcasting: Intent { act=com.google.android.clockwork.prototiles.action.DUMP_RC_DOC }'
    match=""
    if [[ "$*" =~ $WIDGET_ID_RE ]]; then
      match=$(awk -v id="${BASH_REMATCH[1]}" '$1 == id' "$MOCK_TRAY_STATE")
      missing="No active widget found for widgetId ${BASH_REMATCH[1]}"
    elif [[ "$*" =~ $COMPONENT_RE ]]; then
      component="${BASH_REMATCH[1]}"
      match=$(awk -v c="$component" '$3 == c' "$MOCK_TRAY_STATE")
      missing="No active widget found for component ${component//\//\\/}"
      if (($(printf '%s\n' "$match" | grep -c .) > 1)); then
        echo "Broadcast completed: result=-1, data=\"{\"status\":\"MULTIPLE_WIDGETS\",\"action\":\"DUMP_RC_DOC\",\"message\":\"Multiple active widgets found\",\"widgets\":$(widgets_json "$component")}\""
        exit 0
      fi
    fi
    if [[ -z "$match" ]]; then
      echo "Broadcast completed: result=0, data=\"{\"status\":\"ERROR\",\"message\":\"$missing\"}\""
      exit 0
    fi
    read -r id type component <<<"$match"
    file="\\/data\\/user\\/0\\/com.google.android.wearable.protolayout.renderer\\/cache\\/${id}_rc_doc.rc"
    size=${#RC_DOC}
    [[ "${MOCK_EMPTY_DOC:-0}" == "1" ]] && size=0
    echo "Broadcast completed: result=-1, data=\"{\"package_name\":\"${component%%/*}\",\"container_type\":\"$type\",\"content_width_px\":334,\"doc_size_bytes\":$size,\"file\":\"$file\",\"pull_command\":\"adb exec-out run-as com.google.android.wearable.protolayout.renderer cat cache\\/${id}_rc_doc.rc > rc_doc.rc\",\"theme\":{\"WearM3.primary\":\"#FFD2ECA9\"},\"status\":\"OK\",\"action\":\"DUMP_RC_DOC\",\"widgetId\":$id}\""
    exit 0
    ;;
  *"com.google.android.wearable.app.DEBUG_SURFACE"*"add-tile"*)
    echo 'Broadcasting: Intent { act=com.google.android.wearable.app.DEBUG_SURFACE }'
    echo 'Broadcast completed: result=1, data="Index=[0]"'
    exit 0
    ;;
  *"com.google.android.wearable.app.DEBUG_SURFACE"*"remove-tile"*)
    echo 'Broadcasting: Intent { act=com.google.android.wearable.app.DEBUG_SURFACE }'
    echo 'Broadcast completed: result=1, data="Removed"'
    exit 0
    ;;
esac
exit 0
EOF
chmod +x "$MOCK_BIN/adb"

DEFAULT_TRAY="10001 SMALL com.example/.MyWidget"

# Runs a command against the mock. MOCK_TRAY sets the initial tray contents.
run_mock() {
  : >"$ADB_LOG"
  rm -f "${ADB_LOG}".*_count
  printf '%s\n' "${MOCK_TRAY-$DEFAULT_TRAY}" >"$TRAY_STATE"
  PATH="$MOCK_BIN:$PATH" MOCK_ADB_LOG="$ADB_LOG" MOCK_TRAY_STATE="$TRAY_STATE" \
    ADB_TILE_RETRY_DELAY="0.01" ADB_TILE_RENDER_DELAY="0.01" "$@"
}

report() {
  sed 's/^/# /' "$OUTPUT"
  [[ -s "$ADB_LOG" ]] && sed 's/^/# adb: /' "$ADB_LOG"
  return 0
}

# Test 1: adb-tile-add --help and -h include --vertical
if "$ADD_BIN" --help >"$OUTPUT" 2>&1 && [[ "$(<"$OUTPUT")" == *"--vertical"* ]] && "$ADD_BIN" -h >"$OUTPUT" 2>&1 && [[ "$(<"$OUTPUT")" == *"--vertical"* ]]; then
  echo "ok 1 - adb-tile-add help documents --vertical"
else
  echo "not ok 1 - adb-tile-add help missing --vertical"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 2: adb-tile-remove --help and -h include --vertical and --all
if "$REMOVE_BIN" --help >"$OUTPUT" 2>&1 && [[ "$(<"$OUTPUT")" == *"--vertical"* ]] && [[ "$(<"$OUTPUT")" == *"--all"* ]] &&
  "$REMOVE_BIN" -h >"$OUTPUT" 2>&1 && [[ "$(<"$OUTPUT")" == *"--vertical"* ]]; then
  echo "ok 2 - adb-tile-remove help documents --vertical and --all"
else
  echo "not ok 2 - adb-tile-remove help missing --vertical or --all"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 3: Rejects FULLSCREEN with --vertical
if ! run_mock "$ADD_BIN" --vertical --type FULLSCREEN com.example/.MyWidget >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"FULLSCREEN is not supported with --vertical"* ]]; then
  echo "ok 3 - adb-tile-add rejects --type FULLSCREEN with --vertical"
else
  echo "not ok 3 - adb-tile-add did not reject --type FULLSCREEN with --vertical"
  report
fi

# Test 4: Release renderer (no WidgetTrayActivity) fails with versionName and flavor guidance on add
if ! MOCK_TRAY_SUPPORTED=0 run_mock "$ADD_BIN" --vertical com.example/.MyWidget >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"com.google.android.wearable.protolayout.renderer 1.6.1.87.924797699"* ]] &&
  [[ "$(<"$OUTPUT")" == *"lacks WidgetTrayActivity"* ]] &&
  [[ "$(<"$OUTPUT")" == *".emu, .exp, or .dev"* ]]; then
  echo "ok 4 - adb-tile-add --vertical fails clearly with versionName when renderer lacks WidgetTrayActivity"
else
  echo "not ok 4 - adb-tile-add --vertical did not report missing WidgetTrayActivity with versionName"
  report
fi

# Test 5: Release renderer (no WidgetTrayActivity) fails with versionName and flavor guidance on remove
if ! MOCK_TRAY_SUPPORTED=0 run_mock "$REMOVE_BIN" --vertical com.example/.MyWidget >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"com.google.android.wearable.protolayout.renderer 1.6.1.87.924797699"* ]] &&
  [[ "$(<"$OUTPUT")" == *"lacks WidgetTrayActivity"* ]] &&
  [[ "$(<"$OUTPUT")" == *".emu, .exp, or .dev"* ]]; then
  echo "ok 5 - adb-tile-remove --vertical fails clearly with versionName when renderer lacks WidgetTrayActivity"
else
  echo "not ok 5 - adb-tile-remove --vertical did not report missing WidgetTrayActivity with versionName"
  report
fi

# Test 6: Vertical mode retries while receiver registers, scopes broadcast with -p, and prints widgetId + visibility
if MOCK_TRAY_READY_ATTEMPT=3 run_mock "$ADD_BIN" --vertical --type SMALL com.example/.MyWidget >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"Added/activated widget ID: 10001"* ]] &&
  [[ "$(<"$OUTPUT")" == *"Success: Tile is visible."* ]] &&
  [[ "$(<"$ADB_LOG")" == *"am start -W -n com.google.android.wearable.protolayout.renderer/com.google.android.clockwork.prototiles.renderer.experimental.WidgetTrayActivity"* ]] &&
  [[ "$(<"$ADB_LOG")" == *"am broadcast -p com.google.android.wearable.protolayout.renderer -a com.google.android.clockwork.prototiles.action.ADD_WIDGET --es component com.example/.MyWidget --es container_type SMALL"* ]] &&
  [[ "$(cat "${ADB_LOG}.add_count")" == "3" ]]; then
  echo "ok 6 - adb-tile-add --vertical opens tray with -W, retries until receiver is ready, and verifies visibility"
else
  echo "not ok 6 - adb-tile-add --vertical retry and widgetId flow failed"
  report
fi

# Test 7: Vertical mode fails fast on receiver ERROR payload without retrying 15 times
if ! MOCK_ADD_ERROR=1 run_mock "$ADD_BIN" --vertical com.example/.MyWidget >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"Missing or unresolved component extra"* ]] &&
  [[ "$(cat "${ADB_LOG}.add_count")" == "1" ]]; then
  echo "ok 7 - adb-tile-add --vertical fails fast on receiver ERROR response"
else
  echo "not ok 7 - adb-tile-add --vertical did not fail fast on ERROR response"
  report
fi

# Test 8: Default (SysUI carousel) mode is unchanged
if run_mock "$ADD_BIN" --no-show --type LARGE com.example/.MyTile >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"Added/activated tile ID: 0"* ]] &&
  [[ "$(<"$ADB_LOG")" == *"com.google.android.wearable.app.DEBUG_SURFACE --es operation add-tile --ecn component com.example/.MyTile --ei type 1"* ]] &&
  [[ "$(<"$ADB_LOG")" != *"WidgetTrayActivity"* ]]; then
  echo "ok 8 - default SysUI carousel mode in adb-tile-add is unchanged"
else
  echo "not ok 8 - default SysUI carousel mode in adb-tile-add regressed"
  report
fi

# Test 9: adb-tile-remove --vertical supports numeric widgetId and component name, reporting on stderr
if run_mock "$REMOVE_BIN" --vertical 10001 >"$STDOUT" 2>"$OUTPUT" &&
  [[ "$(<"$OUTPUT")" == "Removed widget ID: 10001" ]] && [[ ! -s "$STDOUT" ]] &&
  [[ "$(<"$ADB_LOG")" == *"am broadcast -p com.google.android.wearable.protolayout.renderer -a com.google.android.clockwork.prototiles.action.REMOVE_WIDGET --ei widget_id 10001"* ]] &&
  run_mock "$REMOVE_BIN" --vertical com.example/.MyWidget >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == "Removed 1 widget: com.example/.MyWidget" ]] &&
  [[ "$(<"$ADB_LOG")" == *"am broadcast -p com.google.android.wearable.protolayout.renderer -a com.google.android.clockwork.prototiles.action.REMOVE_WIDGET --es component com.example/.MyWidget"* ]]; then
  echo "ok 9 - adb-tile-remove --vertical removes by widgetId or component"
else
  echo "not ok 9 - adb-tile-remove --vertical failed"
  report
fi

# Test 10: Default adb-tile-remove (SysUI carousel) is unchanged
if run_mock "$REMOVE_BIN" com.example/.MyTile >"$OUTPUT" 2>&1 &&
  [[ "$(<"$ADB_LOG")" == *"com.google.android.wearable.app.DEBUG_SURFACE --es operation remove-tile --ecn component com.example/.MyTile"* ]]; then
  echo "ok 10 - default SysUI carousel mode in adb-tile-remove is unchanged"
else
  echo "not ok 10 - default SysUI carousel mode in adb-tile-remove regressed"
  report
fi

# Test 11: Vertical mode catches post-render document inflation failures (b/473745800)
if ! MOCK_RENDER_FAIL=1 run_mock "$ADD_BIN" --vertical com.example/.MyWidget >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"Error: Renderer failed to parse or attach the document"* ]] &&
  [[ "$(<"$OUTPUT")" == *"Unsupported modifier"* ]]; then
  echo "ok 11 - adb-tile-add --vertical fails when renderer rejects document after Rendering tile"
else
  echo "not ok 11 - adb-tile-add --vertical missed post-render inflation failure"
  report
fi

TWO_WIDGETS=$'10001 LARGE com.example/.MyWidget\n10002 SMALL com.example/.MyWidget\n10003 LARGE com.example/.Other'

# Test 12: adb-tiles --help documents --vertical and its output format
if "$LIST_BIN" --help >"$OUTPUT" 2>&1 && [[ "$(<"$OUTPUT")" == *"--vertical"* ]] &&
  [[ "$(<"$OUTPUT")" == *"WIDGET_ID TYPE COMPONENT"* ]]; then
  echo "ok 12 - adb-tiles help documents --vertical output format"
else
  echo "not ok 12 - adb-tiles help missing --vertical"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 13: adb-tiles --vertical opens the tray, retries until GET_WIDGETS is answered, and prints ID TYPE COMPONENT
if MOCK_TRAY="$TWO_WIDGETS" MOCK_TRAY_READY_ATTEMPT=3 run_mock "$LIST_BIN" --vertical >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == $'10001 LARGE com.example/.MyWidget\n10002 SMALL com.example/.MyWidget\n10003 LARGE com.example/.Other' ]] &&
  [[ "$(<"$ADB_LOG")" == *"am broadcast -p com.google.android.wearable.protolayout.renderer -a com.google.android.clockwork.prototiles.action.GET_WIDGETS"* ]] &&
  [[ "$(<"$ADB_LOG")" == *"am start -W -n com.google.android.wearable.protolayout.renderer/"* ]] &&
  [[ "$(cat "${ADB_LOG}.get_count")" == "3" ]]; then
  echo "ok 13 - adb-tiles --vertical lists tray widgets after the receiver registers"
else
  echo "not ok 13 - adb-tiles --vertical listing failed"
  report
fi

# Test 14: adb-tiles --vertical on an empty tray prints nothing and succeeds
if MOCK_TRAY="" run_mock "$LIST_BIN" --vertical >"$OUTPUT" 2>&1 && [[ ! -s "$OUTPUT" ]]; then
  echo "ok 14 - adb-tiles --vertical prints nothing for an empty tray"
else
  echo "not ok 14 - adb-tiles --vertical mishandled an empty tray"
  report
fi

# Test 15: adb-tiles --vertical fails clearly on a renderer without GET_WIDGETS
if ! MOCK_TRAY_V2=0 ADB_TILE_TRAY_ATTEMPTS=3 run_mock "$LIST_BIN" --vertical >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"renderer (com.google.android.wearable.protolayout.renderer 1.6.1.87.924797699) did not answer GET_WIDGETS"* ]]; then
  echo "ok 15 - adb-tiles --vertical fails clearly when GET_WIDGETS is unsupported"
else
  echo "not ok 15 - adb-tiles --vertical did not report unsupported GET_WIDGETS"
  report
fi

# Test 16: adb-tiles rejects --vertical combined with filters
if ! run_mock "$LIST_BIN" --vertical --user-only >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"--vertical cannot be combined with filter options"* ]]; then
  echo "ok 16 - adb-tiles rejects --vertical with filter options"
else
  echo "not ok 16 - adb-tiles accepted --vertical with filter options"
  report
fi

# Test 17: adb-tile-remove --vertical --all removes every widget by ID and verifies the tray is empty
if MOCK_TRAY="$TWO_WIDGETS" run_mock "$REMOVE_BIN" --vertical --all >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == $'Removed widget ID: 10001\nRemoved widget ID: 10002\nRemoved widget ID: 10003' ]] &&
  [[ ! -s "$TRAY_STATE" || -z "$(tr -d '[:space:]' <"$TRAY_STATE")" ]] &&
  [[ "$(cat "${ADB_LOG}.get_count")" == "2" ]]; then
  echo "ok 17 - adb-tile-remove --vertical --all clears the tray and verifies it"
else
  echo "not ok 17 - adb-tile-remove --vertical --all failed"
  report
fi

# Test 18: adb-tile-remove --all validates its companions
if ! run_mock "$REMOVE_BIN" --all >"$OUTPUT" 2>&1 && [[ "$(<"$OUTPUT")" == *"--all requires --vertical"* ]] &&
  ! run_mock "$REMOVE_BIN" --vertical --all com.example/.MyWidget >"$OUTPUT" 2>&1 &&
  [[ "$(<"$OUTPUT")" == *"--all cannot be combined"* ]]; then
  echo "ok 18 - adb-tile-remove --all requires --vertical and no component"
else
  echo "not ok 18 - adb-tile-remove --all argument validation failed"
  report
fi

# Test 19: adb-tile-remove --vertical --all fails clearly on a renderer without GET_WIDGETS
