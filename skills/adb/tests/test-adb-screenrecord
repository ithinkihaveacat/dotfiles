#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""TAP-compatible test suite for adb-screenrecord."""

import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
SCREENRECORD_BIN = str(SKILL_DIR / "scripts" / "adb-screenrecord")


class TapRunner:
    def __init__(self, plan_count: int | None = None) -> None:
        self.count = 0
        self.failed = 0
        if plan_count is not None:
            print(f"1..{plan_count}")

    def ok(self, description: str) -> None:
        self.count += 1
        print(f"ok {self.count} - {description}")

    def not_ok(self, description: str, diagnostic: str = "") -> None:
        self.count += 1
        self.failed += 1
        print(f"not ok {self.count} - {description}")
        if diagnostic:
            for line in diagnostic.strip().splitlines():
                print(f"# {line}")

    def skip(self, description: str, reason: str) -> None:
        self.count += 1
        print(f"ok {self.count} - {description} # SKIP {reason}")

    def finish(self, total: int | None = None) -> int:
        if total is None:
            print(f"1..{self.count}")
        return 0 if self.failed == 0 else 1


def is_device_connected() -> bool:
    if not shutil.which("adb"):
        return False
    try:
        res = subprocess.run(["adb", "shell", "true"], capture_output=True, check=False)
        return res.returncode == 0
    except (FileNotFoundError, OSError):
        return False


def validate_mp4(file_path: str) -> tuple[bool, str]:
    if not os.path.exists(file_path):
        return False, f"File does not exist: {file_path}"
    if os.path.getsize(file_path) == 0:
        return False, f"File is empty: {file_path}"
    if not shutil.which("ffprobe"):
        return True, "ffprobe not installed, skipping container validation"

    try:
        probe = subprocess.run(
            [
                "ffprobe",
                "-v",
                "error",
                "-show_entries",
                "format=duration,size,bit_rate",
                "-of",
                "json",
                file_path,
            ],
            capture_output=True,
            text=True,
            check=False,
        )
    except (FileNotFoundError, OSError):
        return True, "ffprobe not installed, skipping container validation"

    if probe.returncode != 0:
        return False, f"ffprobe failed (moov atom missing or invalid):\n{probe.stderr}"

    try:
        data = json.loads(probe.stdout)
        duration = float(data.get("format", {}).get("duration", 0.0))
        if duration <= 0.0:
            return False, f"Duration {duration} <= 0"
    except Exception as e:
        return False, f"Failed parsing ffprobe output: {e}"

    return True, f"Valid MP4 (duration: {duration}s)"


MOCK_ADB = r"""#!/bin/bash
echo "$*" >>"$MOCK_ADB_LOG"
[[ "${1:-}" == "-s" ]] && shift 2
case "$*" in
  "exec-out getprop ro.build.characteristics") echo "${MOCK_CHARS:-phone}" ;;
  "exec-out wm size") echo "Physical size: 454x454" ;;
  "exec-out settings get system show_touches") echo 0 ;;
esac
exit 0
"""

MOCK_SCRCPY = r"""#!/bin/bash
echo "$*" >>"$MOCK_SCRCPY_LOG"
while [[ $# -gt 0 ]]; do
  [[ "$1" == "-r" ]] && echo data >"$2"
  shift
done
"""

MOCK_FFMPEG = r"""#!/bin/bash
echo "$*" >>"$MOCK_FFMPEG_LOG"
for ((i = 1; i <= $#; i++)); do
  if [[ "${!i}" == "-i" ]]; then
    j=$((i + 1))
    [[ -p "${!j}" ]] && cat "${!j}" >/dev/null
  fi
done
echo data >"${!#}"
"""


def run_mocked(
    args: list[str], env_extra: dict[str, str] | None = None
) -> tuple[subprocess.CompletedProcess, dict[str, list[str]]]:
    """Run adb-screenrecord against mock adb, scrcpy, and ffmpeg binaries.

    Returns the completed process and the argument lines each mock logged.
    """
    with tempfile.TemporaryDirectory() as temp_dir:
        mock_bin = Path(temp_dir) / "bin"
        mock_bin.mkdir()
        for name, body in (
            ("adb", MOCK_ADB),
            ("scrcpy", MOCK_SCRCPY),
            ("ffmpeg", MOCK_FFMPEG),
        ):
            path = mock_bin / name
            path.write_text(body)
            path.chmod(0o755)
        logs = {
            name: Path(temp_dir) / f"{name}.log" for name in ("adb", "scrcpy", "ffmpeg")
        }
        env = {
            "PATH": f"{mock_bin}:/usr/bin:/bin",
            "HOME": temp_dir,
            "TMPDIR": temp_dir,
            "MOCK_ADB_LOG": str(logs["adb"]),
            "MOCK_SCRCPY_LOG": str(logs["scrcpy"]),
            "MOCK_FFMPEG_LOG": str(logs["ffmpeg"]),
        }
        env.update(env_extra or {})
        res = subprocess.run(
            [SCREENRECORD_BIN, *args],
            capture_output=True,
            text=True,
            check=False,
            cwd=temp_dir,
            env=env,
            timeout=30,
        )
        lines = {
            name: log.read_text().splitlines() if log.exists() else []
            for name, log in logs.items()
        }
        return res, lines


def all_adb_targeted(adb_lines: list[str], serial: str) -> bool:
    return bool(adb_lines) and all(
        line.startswith(f"-s {serial} ") for line in adb_lines
    )


def main() -> int:
    tap = TapRunner(plan_count=11)
    device_available = is_device_connected()

    # Test 1: Help and usage
    res = subprocess.run(
        [SCREENRECORD_BIN, "--help"], capture_output=True, text=True, check=False
    )
    res_h = subprocess.run(
        [SCREENRECORD_BIN, "-h"], capture_output=True, text=True, check=False
    )
    if res.returncode == 0 and res_h.returncode == 0 and "Usage:" in res.stdout:
        tap.ok("prints usage on --help and -h")
    else:
        tap.not_ok("help flags failed", f"stdout: {res.stdout}\nstderr: {res.stderr}")

    # Test 2: Invalid argument validation
    res_unknown = subprocess.run(
        [SCREENRECORD_BIN, "--invalid-flag"], capture_output=True, check=False
    )
    res_missing_arg = subprocess.run(
        [SCREENRECORD_BIN, "-o"], capture_output=True, check=False
    )
    if res_unknown.returncode != 0 and res_missing_arg.returncode != 0:
        tap.ok("rejects unknown and missing argument flags")
    else:
        tap.not_ok("failed to reject invalid arguments")

    # Test 3: Timed capture (--duration)
    if not device_available:
        tap.skip("timed capture produces valid playable MP4", "no adb device connected")
    else:
        with tempfile.TemporaryDirectory() as temp_dir:
            out_file = os.path.join(temp_dir, "test_timed.mp4")
            res = subprocess.run(
                [SCREENRECORD_BIN, "--duration", "3", out_file],
                capture_output=True,
                text=True,
                check=False,
            )
            valid, msg = validate_mp4(out_file)
            if res.returncode == 0 and valid:
                tap.ok(f"timed capture produces valid playable MP4 ({msg})")
            else:
                tap.not_ok("timed capture failed", f"{msg}\nstderr: {res.stderr}")

    # Test 4: SIGINT interruption (Ctrl-C clean exit & moov atom writing)
    if not device_available:
        tap.skip(
            "SIGINT interruption produces valid playable MP4", "no adb device connected"
        )
    else:
        with tempfile.TemporaryDirectory() as temp_dir:
            out_file = os.path.join(temp_dir, "test_sigint.mp4")
            proc = subprocess.Popen(
                [SCREENRECORD_BIN, out_file],
                start_new_session=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            time.sleep(3)
            try:
                os.killpg(proc.pid, signal.SIGINT)
            except ProcessLookupError:
                pass
            try:
                _, stderr_data = proc.communicate(timeout=10)
                ret = proc.returncode
                stderr = stderr_data.decode("utf-8", errors="replace")
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                _, stderr_data = proc.communicate()
                ret = proc.returncode
                stderr = (
                    stderr_data.decode("utf-8", errors="replace")
                    + "\n(timed out after 10s)"
                )
            valid, msg = validate_mp4(out_file)
            if ret == 0 and valid:
                tap.ok(f"SIGINT interruption produces valid playable MP4 ({msg})")
            else:
                tap.not_ok(
                    "SIGINT interruption failed",
                    f"exit: {ret}, {msg}\nstderr: {stderr}",
                )

    # Test 5: Double SIGINT (rapid Ctrl-C) resilience during cleanup
    if not device_available:
        tap.skip(
            "double SIGINT interruption completes cleanup cleanly",
            "no adb device connected",
        )
    else:
        with tempfile.TemporaryDirectory() as temp_dir:
            out_file = os.path.join(temp_dir, "test_double_sigint.mp4")
            proc = subprocess.Popen(
                [SCREENRECORD_BIN, out_file],
                start_new_session=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            time.sleep(3)
            try:
                os.killpg(proc.pid, signal.SIGINT)
                time.sleep(0.05)
                os.killpg(proc.pid, signal.SIGINT)
            except ProcessLookupError:
                pass
            try:
                _, stderr_data = proc.communicate(timeout=10)
                ret = proc.returncode
                stderr = stderr_data.decode("utf-8", errors="replace")
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                _, stderr_data = proc.communicate()
                ret = proc.returncode
                stderr = (
                    stderr_data.decode("utf-8", errors="replace")
                    + "\n(timed out after 10s)"
                )
            valid, msg = validate_mp4(out_file)
            if ret == 0 and valid:
                tap.ok(f"double SIGINT interruption completes cleanup cleanly ({msg})")
            else:
                tap.not_ok(
                    "double SIGINT interruption failed",
                    f"exit: {ret}, {msg}\nstderr: {stderr}",
                )

    # Test 6: SIGTERM interruption (Task cancellation clean exit & moov atom writing)
    if not device_available:
        tap.skip(
            "SIGTERM interruption produces valid playable MP4",
            "no adb device connected",
        )
    else:
        with tempfile.TemporaryDirectory() as temp_dir:
            out_file = os.path.join(temp_dir, "test_sigterm.mp4")
            proc = subprocess.Popen(
                [SCREENRECORD_BIN, out_file],
                start_new_session=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            time.sleep(3)
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                _, stderr_data = proc.communicate(timeout=10)
                ret = proc.returncode
                stderr = stderr_data.decode("utf-8", errors="replace")
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                _, stderr_data = proc.communicate()
                ret = proc.returncode
                stderr = (
                    stderr_data.decode("utf-8", errors="replace")
                    + "\n(timed out after 10s)"
                )
            valid, msg = validate_mp4(out_file)
            if ret == 0 and valid:
                tap.ok(f"SIGTERM interruption produces valid playable MP4 ({msg})")
            else:
                tap.not_ok(
                    "SIGTERM interruption failed",
                    f"exit: {ret}, {msg}\nstderr: {stderr}",
                )

    # Test 7: --serial targets the scrcpy path and overrides ANDROID_SERIAL
    res, logs = run_mocked(
        ["-s", "SERIAL-A", "out.mp4"], {"ANDROID_SERIAL": "SERIAL-B"}
    )
    if (
        res.returncode == 0
        and logs["scrcpy"]
        and "--serial=SERIAL-A" in logs["scrcpy"][0].split()
        and all_adb_targeted(logs["adb"], "SERIAL-A")
    ):
        tap.ok("--serial is passed to scrcpy and every adb call")
    else:
        tap.not_ok(
            "--serial not applied on scrcpy path",
            f"exit: {res.returncode}\nlogs: {logs}\nstderr: {res.stderr}",
        )

    # Test 8: --serial targets the raw ffmpeg path
    res, logs = run_mocked(["--serial", "SERIAL-A", "--raw", "out.mp4"])
    if (
        res.returncode == 0
        and not logs["scrcpy"]
        and logs["ffmpeg"]
        and any("exec-out screenrecord" in line for line in logs["adb"])
        and all_adb_targeted(logs["adb"], "SERIAL-A")
    ):
        tap.ok("--serial is passed to every adb call on raw path")
    else:
        tap.not_ok(
            "--serial not applied on raw path",
            f"exit: {res.returncode}\nlogs: {logs}\nstderr: {res.stderr}",
        )

    # Test 9: without --serial or ANDROID_SERIAL, no device is pinned
    res, logs = run_mocked(["out.mp4"])
    if (
        res.returncode == 0
        and logs["scrcpy"]
        and "--serial" not in logs["scrcpy"][0]
        and logs["adb"]
        and not any(line.startswith("-s ") for line in logs["adb"])
    ):
        tap.ok("no serial is pinned by default")
    else:
        tap.not_ok(
            "unexpected serial pinning by default",
            f"exit: {res.returncode}\nlogs: {logs}\nstderr: {res.stderr}",
        )

    # Test 10: --serial must precede FILE (positional or --output form)
    res_pos, logs_pos = run_mocked(["out.mp4", "-s", "SERIAL-A"])
    res_out, logs_out = run_mocked(["-o", "out.mp4", "--serial", "SERIAL-A"])
    if (
        res_pos.returncode == 1
        and res_out.returncode == 1
        and "must precede FILE" in res_pos.stderr
        and "must precede FILE" in res_out.stderr
        and not logs_pos["adb"]
        and not logs_out["adb"]
    ):
        tap.ok("rejects --serial after FILE")
    else:
        tap.not_ok(
            "accepted --serial after FILE",
            f"stderr: {res_pos.stderr}\n{res_out.stderr}",
        )

    # Test 11: --serial requires an argument
    res, logs = run_mocked(["-s"])
    if res.returncode == 1 and "requires an argument" in res.stderr:
        tap.ok("rejects --serial without an argument")
    else:
        tap.not_ok("accepted --serial without an argument", res.stderr)

    return tap.finish(total=11)


if __name__ == "__main__":
    sys.exit(main())
