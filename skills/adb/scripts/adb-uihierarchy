#!/usr/bin/env bash

# Tests: skills/adb/tests/test-adb-cli

set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] [FILE]

Dumps the UI hierarchy from an adb-connected device.

The hierarchy is saved to the specified file, or to a timestamped file in the
current directory if no file is specified.

Arguments:
  FILE              The path to save the hierarchy to.
                    (defaults to 'adb-uihierarchy-YYYYMMDDHHMMSS.xml')
                    If '-', the hierarchy is written to stdout.

Options:
  -s, --serial SERIAL
                  Target device serial; must precede arguments or commands.
  -o, --output FILE The path to save the hierarchy to.
                    If '-', the hierarchy is written to stdout.
  --compressed      Skip non-important views during dump (faster on busy UIs).
  -h, --help        Display this help message and exit

Environment:
  ANDROID_SERIAL  Serial number of device to connect to (see 'adb devices -l').
                  The --serial option takes precedence when both are set.

Examples:
  # Save hierarchy to a timestamped file in the current directory
  $(basename "$0")

  # Save hierarchy to a specific file
  $(basename "$0") /tmp/my-hierarchy.xml

  # Save hierarchy to a specific file using the --output flag
  $(basename "$0") --output /tmp/my-hierarchy.xml

  # Save hierarchy to stdout
  $(basename "$0") -
EOF
  exit 0
}

OUTPUT_FILE=""
DUMP_TIMEOUT="${ADB_UIHIERARCHY_TIMEOUT:-10}"
COMPRESSED_ONLY=false
ARGUMENT_SEEN=false

# Manual parsing for --output, compatible with macOS getopt
while [[ $# -gt 0 ]]; do
  case "$1" in
    -s | --serial)
      if $ARGUMENT_SEEN; then
        echo "$(basename "$0"): $1 must precede FILE" >&2
        exit 1
      fi
      if [[ -z "${2:-}" ]]; then
        echo "$(basename "$0"): $1 option requires an argument" >&2
        exit 1
      fi
      export ANDROID_SERIAL="$2"
      shift 2
      ;;
    --help | -h)
      usage
      ;;
    -o | --output)
      if [ -z "${2:-}" ]; then
        echo "$(basename "$0"): --output option requires an argument" >&2
        exit 1
      fi
      OUTPUT_FILE="$2"
      ARGUMENT_SEEN=true
      shift 2
      ;;
    --compressed)
      COMPRESSED_ONLY=true
      shift
      ;;
    -)
      if [ -n "$OUTPUT_FILE" ]; then
        echo "$(basename "$0"): cannot specify both FILE and --output" >&2
        exit 1
      fi
      OUTPUT_FILE="-"
      ARGUMENT_SEEN=true
      shift
      ;;
    -*)
      echo "$(basename "$0"): unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [ -n "$OUTPUT_FILE" ] && [ -n "$1" ]; then
        echo "$(basename "$0"): cannot specify both FILE and --output" >&2
        exit 1
      fi
      OUTPUT_FILE="$1"
      ARGUMENT_SEEN=true
      shift
      ;;
  esac
done

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require adb
require xmllint
require sed

# Check if device is available
adb get-state >/dev/null || exit 1

if [ -z "$OUTPUT_FILE" ]; then
  OUTPUT_FILE=$(date -u +'adb-uihierarchy-%Y%m%d%H%M%S.xml')
fi

TIMEOUT_BIN=$(command -v timeout || command -v gtimeout)

dump_hierarchy() {
  local raw="" rc=0
  if ! $COMPRESSED_ONLY; then
    raw=$("$TIMEOUT_BIN" "$DUMP_TIMEOUT" adb exec-out uiautomator dump /dev/stdout 2>/dev/null) || rc=$?
    raw="${raw//UI hierchary dumped to: \/dev\/stdout/}"
    if [[ "$raw" == *"<hierarchy"* ]]; then
      printf '%s\n' "$raw"
      return 0
    fi
  fi

  rc=0
  raw=$("$TIMEOUT_BIN" "$DUMP_TIMEOUT" adb exec-out uiautomator dump --compressed /dev/stdout 2>/dev/null) || rc=$?
  raw="${raw//UI hierchary dumped to: \/dev\/stdout/}"
  if [[ "$raw" == *"<hierarchy"* ]]; then
    printf '%s\n' "$raw"
    return 0
  fi

  if [[ $rc -eq 124 ]]; then
    echo "$(basename "$0"): uiautomator dump timed out after ${DUMP_TIMEOUT}s" >&2
  else
    echo "$(basename "$0"): failed to dump UI hierarchy from device" >&2
  fi
  return 1
}

RAW_XML=$(dump_hierarchy) || exit 1

if [[ "$OUTPUT_FILE" == "-" ]]; then
  printf '%s\n' "$RAW_XML" | xmllint --format -
else
  mkdir -p "$(dirname "$OUTPUT_FILE")"
  printf '%s\n' "$RAW_XML" | xmllint --format - >"$OUTPUT_FILE"
  echo "Saved to $OUTPUT_FILE" >&2
fi
