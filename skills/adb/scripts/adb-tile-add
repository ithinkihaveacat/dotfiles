#!/usr/bin/env bash

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] COMPONENT_NAME

Adds a tile provided by COMPONENT_NAME to the carousel. The script automatically
shows the tile after it has been added (no separate call to adb-tile-switch is
needed).

Note on Output:
  In default SysUI carousel mode, the script extracts the tile index from the
  system broadcast output (e.g., 'Index=[0]'). 'Index=[0]' means the tile was
  added to the first position in the carousel, pushing others down. It does not
  mean it overwrote previous tiles. Use 'adb-tiles' to list all installed tiles
  and see which are in the carousel.
  In --tray mode, the script opens WidgetTrayActivity if needed, sends
  ADD_WIDGET to com.google.android.wearable.protolayout.renderer, and prints the
  assigned widgetId (e.g., 'Added/activated widget ID: 10001').

Arguments:
  COMPONENT_NAME  A string composed of the package name and a class in that
                  package, for example:
                  com.example.wear.tiles/com.example.wear.tiles.PreviewTileService

Options:
  -s, --serial SERIAL
                  Target device serial; must precede arguments or commands.
  --tray          Add the widget to the standalone renderer's vertical carousel
                  (WidgetTrayActivity) instead of the SysUI horizontal carousel.
                  Requires the .emu, .exp, or .dev renderer flavor.
  --type TYPE     Tile type: FULLSCREEN, LARGE (default), or SMALL. Only applies
                  to tiles supporting the BIND_WIDGET_PROVIDER intent (e.g.,
                  Glance-based tiles). With --tray, only LARGE and SMALL are
                  supported.
  --no-show       Do not show the tile after adding it
  --wait          Wait for the tile to be visible (default)
  --no-wait       Do not wait for visibility (return immediately)
  --help          Display this help message and exit

Environment:
  ANDROID_SERIAL  Serial number of device to connect to (see 'adb devices -l').
                  The --serial option takes precedence when both are set.

Examples:
  $(basename "$0") com.google.android.wearable.shell/.weather.WeatherTileService
  $(basename "$0") --type LARGE com.google.example.wear_widget/.HelloWidgetService
  $(basename "$0") --tray --type SMALL com.google.example.wear_widget/.HelloWidgetService
  $(basename "$0") --no-show com.google.example.wear_widget/.HelloWidgetService
EOF
  exit 0
}

usage_short() {
  cat <<EOF >&2
Usage: $(basename "$0") COMPONENT [OPTIONS]

Add a Wear OS tile to the active tile carousel on an adb-connected watch.

Examples:
  $(basename "$0") com.google.android.wearable.shell/.weather.WeatherTileService

Try '$(basename "$0") --help' for more information.
EOF
  exit 1
}

if [[ $# -eq 0 ]]; then
  usage_short
fi

SHOW=true
WAIT=true
TRAY=false
TYPE_STR="LARGE"
TYPE_INT=1 # Default to LARGE
COMPONENT_NAME=""

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -s | --serial)
      if [[ -n "${COMPONENT_NAME:-}" ]]; then
        echo "$(basename "$0"): $1 must precede COMPONENT_NAME" >&2
        exit 1
      fi
      if [[ -z "${2:-}" ]]; then
        echo "$(basename "$0"): $1 option requires an argument" >&2
        exit 1
      fi
      export ANDROID_SERIAL="$2"
      shift 2
      ;;
    --tray)
      TRAY=true
      shift
      ;;
    --no-show)
      SHOW=false
      shift
      ;;
    --wait)
      WAIT=true
      shift
      ;;
    --no-wait)
      WAIT=false
      shift
      ;;
    --type)
      shift
      if [[ -z "${1:-}" ]]; then
        echo "Error: --type requires an argument (FULLSCREEN, LARGE, SMALL)" >&2
        exit 1
      fi
      case "$1" in
        FULLSCREEN)
          TYPE_STR="FULLSCREEN"
          TYPE_INT=0
          ;;
        LARGE)
          TYPE_STR="LARGE"
          TYPE_INT=1
          ;;
        SMALL)
          TYPE_STR="SMALL"
          TYPE_INT=2
          ;;
        *)
          echo "Error: Invalid type '$1'. Must be FULLSCREEN, LARGE, or SMALL." >&2
          exit 1
          ;;
      esac
      shift
      ;;
    --help | -h)
      usage
      ;;
    -*)
      echo "Error: Unknown option $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$COMPONENT_NAME" ]]; then
        COMPONENT_NAME="$1"
      else
        echo "Error: Unexpected argument '$1'" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [ -z "$COMPONENT_NAME" ]; then
  echo "Error: COMPONENT_NAME is required" >&2
  exit 1
fi

if [[ "$TRAY" == true && "$TYPE_STR" == "FULLSCREEN" ]]; then
  echo "$(basename "$0"): FULLSCREEN is not supported with --tray (use LARGE or SMALL)" >&2
  exit 1
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require adb

# Check device availability
if ! adb get-state >/dev/null 2>&1; then
  if [[ -n "${ANDROID_SERIAL:-}" ]]; then
    echo "$(basename "$0"): device '$ANDROID_SERIAL' not available" >&2
  else
    echo "$(basename "$0"): no device connected" >&2
  fi
  exit 1
fi

RENDERER_PACKAGE="com.google.android.wearable.protolayout.renderer"
TRAY_ACTIVITY="${RENDERER_PACKAGE}/com.google.android.clockwork.prototiles.renderer.experimental.WidgetTrayActivity"
TRAY_ACTION_ADD="com.google.android.clockwork.prototiles.action.ADD_WIDGET"

if [[ "$TRAY" == true ]]; then
  RESOLVE_OUT=$(adb shell cmd package resolve-activity --brief -n "$TRAY_ACTIVITY" 2>/dev/null | tr -d '\r')
  if [[ "$RESOLVE_OUT" != *"$TRAY_ACTIVITY"* ]]; then
    echo "$(basename "$0"): installed renderer ($RENDERER_PACKAGE) lacks WidgetTrayActivity; --tray requires the .emu, .exp, or .dev renderer flavor" >&2
    exit 1
  fi
fi

PACKAGE_NAME="${COMPONENT_NAME%%/*}"

# Check if the package is installed
if ! adb shell pm list packages | tr -d '\r' | grep -q "^package:${PACKAGE_NAME}$"; then
  echo "Error: Package '$PACKAGE_NAME' not found. Is the app installed?" >&2
  exit 1
fi

# -----------------------------------------------------------------------------
# REMOTE COMPOSE VISIBILITY & FAILURE DETECTION
# -----------------------------------------------------------------------------
# Wear Widgets use a remote rendering architecture (Remote Compose).
# The app generates a document and serializes it over a Binder IPC connection.
# SysUI or WidgetTrayActivity (via ProtoTilesTileRendererImpl) receives,
# deserializes, and renders it.
#
# Because of this IPC boundary, we cannot rely on app-level logs or just "sleep".
# Failures happen asynchronously AFTER the initial 'add-tile' or 'ADD_WIDGET'
# broadcast. We explicitly detect known failure modes to fail fast and prevent
# false positives:
#
#   1. Binder Overload: Sending large unscaled images exceeds
#      the ~1MB Binder IPC limit. (b/488353353)
#      Result: 'FATAL EXCEPTION' in AndroidRuntime (TransactionTooLargeException)
#
#   2. Unsupported Modifiers: e.g., using alpha or blur effects. (b/473745800)
#      Result: 'Failed to render and attach the tile' in the renderer.
#
#   3. Renderer Timeouts: The provider hung or crashed silently before responding.
#      Result: 'Error getting tile response' in the renderer.
#
# Visibility Heuristics:
# SysUI provides two distinct signals for a successful addition:
#   - Signal 1 (Container): SysUI allocates the carousel slot and shifts focus.
#     (e.g., "Visible tile added", "Jumped to the tile")
#   - Signal 2 (Content): The renderer has received and parsed the app's data.
#     (e.g., "Received tile content", "Rendering tile")
#
# We wait for Signal 2 to ensure that automated tools (like screenshots) don't
# capture the tile in its transient "loading" state (generic app icon or blank
# tray slot).
#
# Robustness: Signal 2 logs can be inconsistent across OS versions. If Signal 1
# is confirmed, we only wait a short grace period (~3s) for Signal 2 before
# assuming success, preventing a full timeout if the rendering log was missed.
# -----------------------------------------------------------------------------

LOG_FILE=""
LOG_PID=""
if [ "$WAIT" = true ] && { [ "$SHOW" = true ] || [ "$TRAY" = true ]; }; then
  LOG_FILE=$(mktemp)
  if [ ! -w "$LOG_FILE" ]; then
    echo "Error: Could not create writable temporary file for logcat monitoring." >&2
    exit 1
  fi

  # Clear buffer to avoid reading old logs from previous runs
  adb logcat -c

  # Monitor relevant tags in the background. We filter specifically for errors
  # from the renderer and runtime to catch async crashes.
  adb logcat -v time SysUI:D ProtoTilesTileRendererImpl:D AndroidRuntime:E "*:S" >"$LOG_FILE" &
  LOG_PID=$!

  # Robust cleanup trap: Handles normal exits, INT (Ctrl+C), and TERM signals.
  trap '
    EXIT_CODE=$?
    [ -n "$LOG_PID" ] && kill "$LOG_PID" 2>/dev/null
    [ -n "$LOG_FILE" ] && rm -f "$LOG_FILE"
    if [ $EXIT_CODE -eq 130 ]; then
       echo -e "\nWarning: Script interrupted by user. Background logcat killed."
    fi
    exit $EXIT_CODE
  ' EXIT INT TERM
fi

# Workaround for a bug: force-stop the package to ensure a fresh bind
adb shell am force-stop "$PACKAGE_NAME"

if [[ "$TRAY" == true ]]; then
  if [[ "$SHOW" == true ]]; then
    adb shell am start -n "$TRAY_ACTIVITY" >/dev/null 2>&1
  fi

  WIDGET_ID=""
  WIDGET_ID_RE='"widgetId":[[:space:]]*([0-9]+)'
  ERROR_MSG_RE='"message":"([^"]+)"'
  STARTED_TRAY="$SHOW"

  for _ in {1..15}; do
    OUTPUT=$(adb shell am broadcast \
      -p "$RENDERER_PACKAGE" \
      -a "$TRAY_ACTION_ADD" \
      --es component "$COMPONENT_NAME" \
      --es container_type "$TYPE_STR" | tr -d '\r')

    if [[ "$OUTPUT" == *"result=-1"* && "$OUTPUT" =~ $WIDGET_ID_RE ]]; then
      WIDGET_ID="${BASH_REMATCH[1]}"
      break
    fi

    if [[ "$OUTPUT" == *'"status":"ERROR"'* ]]; then
      if [[ "$OUTPUT" =~ $ERROR_MSG_RE ]]; then
        echo "$(basename "$0"): ${BASH_REMATCH[1]}" >&2
      else
        echo "$(basename "$0"): ADD_WIDGET failed: $OUTPUT" >&2
      fi
      exit 1
    fi

    if [[ "$STARTED_TRAY" == false ]]; then
      adb shell am start -n "$TRAY_ACTIVITY" >/dev/null 2>&1
      STARTED_TRAY=true
    fi

    sleep "${ADB_TILE_RETRY_DELAY:-0.5}"
  done

  if [[ -z "$WIDGET_ID" ]]; then
    echo "$(basename "$0"): timed out waiting for WidgetTrayReceiver to handle ADD_WIDGET:" >&2
    echo "$OUTPUT" >&2
    exit 1
  fi

  echo "Added/activated widget ID: $WIDGET_ID"

  if [[ "$WAIT" == true ]]; then
    START_TIME=$(date +%s)
    TIMEOUT=15
    while true; do
      CURRENT_TIME=$(date +%s)
      ELAPSED=$((CURRENT_TIME - START_TIME))

      if ! kill -0 "$LOG_PID" 2>/dev/null; then
        break
      fi

      if grep -Eq "(Received tile content|Rendering tile).*$PACKAGE_NAME" "$LOG_FILE"; then
        sleep "${ADB_TILE_RENDER_DELAY:-0.8}"
        break
      fi

      if grep -q "FATAL EXCEPTION" "$LOG_FILE"; then
        echo "Error: Remote Compose App Crash detected!" >&2
        grep -A 5 "FATAL EXCEPTION" "$LOG_FILE" >&2
        exit 1
      fi
      if grep -q "Error getting tile response" "$LOG_FILE"; then
        echo "Error: Renderer timed out getting the tile response." >&2
        grep "Error getting tile response" "$LOG_FILE" >&2
        exit 1
      fi
      if grep -q "Failed to render and attach the tile" "$LOG_FILE"; then
        echo "Error: Renderer failed to parse or attach the document." >&2
        grep -A 2 "Failed to render and attach the tile" "$LOG_FILE" >&2
        exit 1
      fi

      if ((ELAPSED >= TIMEOUT)); then
        echo "Warning: Timeout waiting for widget render ($TIMEOUT s)." >&2
        break
      fi

      sleep "${ADB_TILE_RETRY_DELAY:-0.2}"
    done
  fi

  exit 0
fi

# Add the tile and capture output
OUTPUT=$(adb shell am broadcast \
  -a com.google.android.wearable.app.DEBUG_SURFACE \
  --es operation add-tile \
  --ecn component "$COMPONENT_NAME" \
  --ei type "$TYPE_INT")

# Check for "Requested tile provider does not exist" error (result=2)
if echo "$OUTPUT" | grep -q "Requested tile provider does not exist"; then
  echo "Error: The requested tile provider does not exist or is disabled."
  echo "This commonly happens with system tiles that cannot be added via this method."
  exit 1
fi

# Extract Index (e.g., from Index=[0])
INDEX=$(echo "$OUTPUT" | grep -o 'Index=\[[0-9]*\]' | sed 's/Index=\[\([0-9]*\)\]/\1/')

if [ -z "$INDEX" ] && echo "$OUTPUT" | grep -q "add-tile failed"; then
  # Tile is already present in carousel; default index to 0
  INDEX=0
fi

if [ -n "$INDEX" ]; then
  echo "Added/activated tile ID: $INDEX"
  if [ "$SHOW" = true ]; then
    adb shell am broadcast \
      -a com.google.android.wearable.app.DEBUG_SYSUI \
      --es operation show-tile \
      --ei index "$INDEX" >/dev/null

    # Wait logic
    if [ "$WAIT" = true ]; then
      echo "Waiting for tile visibility..."
      START_TIME=$(date +%s)
      TIMEOUT=15
      VISIBLE=false
      VISIBLE_TIME=0

      while true; do
        CURRENT_TIME=$(date +%s)
        ELAPSED=$((CURRENT_TIME - START_TIME))

        # Check if logcat background process died unexpectedly
        if ! kill -0 "$LOG_PID" 2>/dev/null; then
          echo "Error: Background logcat process died unexpectedly. Cannot verify visibility."
          exit 1
        fi

        # Check if device disconnected
        if ! adb get-state >/dev/null 2>&1; then
          echo "Error: Device disconnected during visibility check."
          exit 1
        fi

        # Check for Container Visibility (Success Signal 1)
        if [ "$VISIBLE" = false ] && grep -Eq "Visible tile added|onVisibleTileAdded|Jumped to the tile|Index=\[|show-tile" "$LOG_FILE"; then
          VISIBLE=true
          VISIBLE_TIME=$CURRENT_TIME
        fi

        # Check for Content Rendering (Success Signal 2)
        if [ "$VISIBLE" = true ]; then
          # If we find evidence of rendering, we are done.
          if grep -Eq "(Received tile content|Rendering tile|provideWidgetData|ProtoTiles).*$PACKAGE_NAME" "$LOG_FILE"; then
            break
          fi

          # Robustness: If the container is visible, don't wait more than 3 seconds for
          # the specific rendering log. Some devices or tile types might not emit it.
          if [ $((CURRENT_TIME - VISIBLE_TIME)) -ge 3 ]; then
            break
          fi
        fi

        # Global timeout
        if [ $ELAPSED -ge $TIMEOUT ]; then
          if [ "$VISIBLE" = false ]; then
            echo "Warning: Timeout waiting for tile visibility ($TIMEOUT s)."
            echo "The tile may be visible, but the success log was missed, or it's stuck loading."
          fi
          break
        fi

        # --- Failure Detection (Pre-Visibility) ---
        if grep -q "FATAL EXCEPTION" "$LOG_FILE"; then
          # b/488353353
          echo "Error: Remote Compose App Crash detected!"
          echo "This usually indicates an IPC payload limit was exceeded (TransactionTooLargeException) or a local runtime crash."
          grep -A 5 "FATAL EXCEPTION" "$LOG_FILE"
          exit 1
        fi
        if grep -q "Error getting tile response" "$LOG_FILE"; then
          echo "Error: Renderer timed out getting the tile response."
          echo "The provider may have hung or crashed silently before responding."
          grep "Error getting tile response" "$LOG_FILE"
          exit 1
        fi
        if grep -q "Failed to render and attach the tile" "$LOG_FILE"; then
          # b/473745800
          echo "Error: Renderer failed to parse or attach the document."
          echo "This is typically caused by unsupported Remote Compose modifiers (e.g., alpha, blur)."
          grep -A 2 "Failed to render and attach the tile" "$LOG_FILE"
          exit 1
        fi

        sleep 0.2
      done

      if [ "$VISIBLE" = true ]; then
        # Continue monitoring for a short buffer. SysUI says the container is
        # visible, but the renderer might still throw an async parsing exception
        # a few hundred milliseconds later.
        sleep 1.5

        # --- Failure Detection (Post-Visibility Buffer) ---
        if grep -q "FATAL EXCEPTION" "$LOG_FILE"; then
          # b/488353353
          echo "Error: Remote Compose App Crash detected immediately after visibility!"
          echo "This usually indicates an IPC payload limit was exceeded (TransactionTooLargeException)."
          grep -A 5 "FATAL EXCEPTION" "$LOG_FILE"
          exit 1
        fi
        if grep -q "Error getting tile response" "$LOG_FILE"; then
          echo "Error: Renderer timed out getting the tile response after visibility."
          grep "Error getting tile response" "$LOG_FILE"
          exit 1
        fi
        if grep -q "Failed to render and attach the tile" "$LOG_FILE"; then
          # b/473745800
          echo "Error: Renderer rejected the document after visibility."
          echo "This is typically caused by unsupported Remote Compose modifiers (e.g., alpha, blur)."
          grep -A 2 "Failed to render and attach the tile" "$LOG_FILE"
          exit 1
        fi
        echo "Success: Tile is visible."
      fi
    fi
  fi
else
  echo "Failed to parse tile ID from output:"
  echo "$OUTPUT"
  exit 1
fi
