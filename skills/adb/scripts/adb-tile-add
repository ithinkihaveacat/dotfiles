#!/usr/bin/env bash

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] COMPONENT_NAME

Adds a tile provided by COMPONENT_NAME to the carousel. The script automatically
shows the tile after it has been added (no separate call to adb-tile-switch is
needed).

Arguments:
  COMPONENT_NAME  A string composed of the package name and a class in that
                  package, for example:
                  com.example.wear.tiles/com.example.wear.tiles.PreviewTileService

Options:
  -s, --serial SERIAL
                  Target device serial; must precede arguments or commands.
  --vertical      Add the widget to the standalone renderer's vertical carousel
                  (WidgetTrayActivity) instead of the SysUI horizontal carousel.
                  Requires the .emu, .exp, or .dev renderer flavor.
  --type TYPE     Tile type: FULLSCREEN, LARGE (default), or SMALL. Only applies
                  to tiles supporting the BIND_WIDGET_PROVIDER intent (e.g.,
                  Glance-based tiles). With --vertical, only LARGE and SMALL are
                  supported.
  --no-show       Do not show the tile after adding it
  --wait          Wait for the tile to be visible (default); exit 1 if that is
                  not confirmed within 15 seconds
  --no-wait       Do not wait for visibility (return immediately)
  --help          Display this help message and exit

Environment:
  ANDROID_SERIAL  Serial number of device to connect to (see 'adb devices -l').
                  The --serial option takes precedence when both are set.

Examples:
  $(basename "$0") com.google.android.wearable.shell/.weather.WeatherTileService
  $(basename "$0") --type LARGE com.google.example.wear_widget/.HelloWidgetService
  $(basename "$0") --vertical --type SMALL com.google.example.wear_widget/.HelloWidgetService
  $(basename "$0") --no-show com.google.example.wear_widget/.HelloWidgetService

Note on Output:
  In default SysUI carousel mode, the script extracts the tile index from the
  system broadcast output (e.g., 'Index=[0]'). 'Index=[0]' means the tile was
  added to the first position in the carousel, pushing others down. It does not
  mean it overwrote previous tiles. Use 'adb-tiles' to list all installed tiles
  and see which are in the carousel.
  In --vertical mode, the script opens WidgetTrayActivity if needed, sends
  ADD_WIDGET to com.google.android.wearable.protolayout.renderer, and prints the
  assigned widgetId (e.g., 'Added/activated widget ID: 10001').
EOF
  exit 0
}

usage_short() {
  cat <<EOF >&2
Usage: $(basename "$0") COMPONENT [OPTIONS]

Add a Wear OS tile to the active tile carousel on an adb-connected watch.

Examples:
  $(basename "$0") com.google.android.wearable.shell/.weather.WeatherTileService

Try '$(basename "$0") --help' for more information.
EOF
  exit 1
}

if [[ $# -eq 0 ]]; then
  usage_short
fi

SHOW=true
WAIT=true
VERTICAL=false
TYPE_STR="LARGE"
TYPE_INT=1 # Default to LARGE
COMPONENT_NAME=""

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -s | --serial)
      if [[ -n "${COMPONENT_NAME:-}" ]]; then
        echo "$(basename "$0"): $1 must precede COMPONENT_NAME" >&2
        exit 1
      fi
      if [[ -z "${2:-}" ]]; then
        echo "$(basename "$0"): $1 option requires an argument" >&2
        exit 1
      fi
      export ANDROID_SERIAL="$2"
      shift 2
      ;;
    --vertical)
      VERTICAL=true
      shift
      ;;
    --no-show)
      SHOW=false
      shift
      ;;
    --wait)
      WAIT=true
      shift
      ;;
    --no-wait)
      WAIT=false
      shift
      ;;
    --type)
      shift
      if [[ -z "${1:-}" ]]; then
        echo "Error: --type requires an argument (FULLSCREEN, LARGE, SMALL)" >&2
        exit 1
      fi
      case "$1" in
        FULLSCREEN)
          TYPE_STR="FULLSCREEN"
          TYPE_INT=0
          ;;
        LARGE)
          TYPE_STR="LARGE"
          TYPE_INT=1
          ;;
        SMALL)
          TYPE_STR="SMALL"
          TYPE_INT=2
          ;;
        *)
          echo "Error: Invalid type '$1'. Must be FULLSCREEN, LARGE, or SMALL." >&2
          exit 1
          ;;
      esac
      shift
      ;;
    --help | -h)
      usage
      ;;
    -*)
      echo "Error: Unknown option $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$COMPONENT_NAME" ]]; then
        COMPONENT_NAME="$1"
      else
        echo "Error: Unexpected argument '$1'" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [ -z "$COMPONENT_NAME" ]; then
  echo "Error: COMPONENT_NAME is required" >&2
  exit 1
fi

if [[ "$VERTICAL" == true && "$TYPE_STR" == "FULLSCREEN" ]]; then
  echo "$(basename "$0"): FULLSCREEN is not supported with --vertical (use LARGE or SMALL)" >&2
  exit 1
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require adb

# Check device availability
if ! DEVICE_ERROR=$(adb get-state 2>&1 >/dev/null); then
  if [[ "$DEVICE_ERROR" == *"more than one"* ]]; then
    echo "$(basename "$0"): more than one device connected; use --serial or set ANDROID_SERIAL" >&2
  elif [[ -n "${ANDROID_SERIAL:-}" ]]; then
    echo "$(basename "$0"): device '$ANDROID_SERIAL' not available" >&2
  else
    echo "$(basename "$0"): no device connected" >&2
  fi
  exit 1
fi

# Quotes a value for the device shell. Commands carrying arbitrary values go to
# adb as one pre-quoted string: adb shell joins several arguments unescaped,
# while recent adb exec-out escapes each one, but a single argument reaches the
# device shell verbatim with every adb version.
device_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

RENDERER_PACKAGE="com.google.android.wearable.protolayout.renderer"
TRAY_ACTIVITY="${RENDERER_PACKAGE}/com.google.android.clockwork.prototiles.renderer.experimental.WidgetTrayActivity"
TRAY_ACTION_ADD="com.google.android.clockwork.prototiles.action.ADD_WIDGET"

if [[ "$VERTICAL" == true ]]; then
  RESOLVE_OUT=$(adb shell cmd package resolve-activity --brief -n "$TRAY_ACTIVITY" 2>/dev/null | tr -d '\r')
  if [[ "$RESOLVE_OUT" != *"$TRAY_ACTIVITY"* ]]; then
    RENDERER_VER=$(adb shell dumpsys package "$RENDERER_PACKAGE" 2>/dev/null | tr -d '\r' | sed -n 's/^[[:space:]]*versionName=//p' | head -n 1)
    RENDERER_DESC="${RENDERER_PACKAGE}${RENDERER_VER:+ $RENDERER_VER}"
    echo "$(basename "$0"): installed renderer ($RENDERER_DESC) lacks WidgetTrayActivity; --vertical requires the .emu, .exp, or .dev renderer flavor" >&2
    exit 1
  fi
fi

PACKAGE_NAME="${COMPONENT_NAME%%/*}"

# Check if the package is installed
if ! adb shell pm list packages | tr -d '\r' | grep -q "^package:${PACKAGE_NAME}$"; then
  echo "$(basename "$0"): package '$PACKAGE_NAME' not found; is the app installed?" >&2
  exit 1
fi

# -----------------------------------------------------------------------------
# REMOTE COMPOSE VISIBILITY & FAILURE DETECTION
# -----------------------------------------------------------------------------
# Wear Widgets use a remote rendering architecture (Remote Compose).
# The app generates a document and serializes it over a Binder IPC connection.
# SysUI or WidgetTrayActivity (via ProtoTilesTileRendererImpl) receives,
# deserializes, and renders it.
#
# Because of this IPC boundary, we cannot rely on app-level logs or just "sleep".
# Failures happen asynchronously AFTER the initial 'add-tile' or 'ADD_WIDGET'
# broadcast. We explicitly detect known failure modes to fail fast and prevent
# false positives:
#
#   1. Binder Overload: Sending large unscaled images exceeds
#      the ~1MB Binder IPC limit. (b/488353353)
#      Result: 'FATAL EXCEPTION' in AndroidRuntime (TransactionTooLargeException)
#
#   2. Unsupported Modifiers: e.g., using alpha or blur effects. (b/473745800)
#      Result: 'Failed to render and attach the tile' in the renderer.
#
#   3. Renderer Timeouts: The provider hung or crashed silently before responding.
#      Result: 'Error getting tile response' in the renderer.
#
# Visibility Heuristics (Two-Signal State Machine):
# Both SysUI and WidgetTrayActivity (--vertical) emit two distinct signals:
#   - Signal 1 (Container):
#     * SysUI allocates the carousel slot and shifts focus
#       ("Visible tile added", "onVisibleTileAdded", "Jumped to the tile").
#     * WidgetTrayActivity attaches the Compose AndroidView container to
#       ProtoTilesTileRendererImpl ("Attaching Tile to a container").
#   - Signal 2 (Content & Inflation):
#     * ProtoTilesTileRendererImpl receives the provider's RemoteCompose
#       payload ("Received tile content") and inflates it into the attached
#       container ("Rendering tile"). In TileRendererImpl.java, "Rendering tile"
#       is only logged inside inflateIfNeededAndAttach() when BOTH a container
#       is attached AND valid tile data has been set.
#
# We wait for Signal 2 (followed by a post-render failure check) so automated
# tools (like screenshots) never capture a blank slot or loading icon, and so
# synchronous inflation exceptions ("Failed to render and attach the tile")
# thrown right after "Rendering tile" are caught reliably.
#
# Robustness: If Signal 1 is confirmed, we bound the additional wait for
# Signal 2 to a short grace period (~3s) before proceeding to the post-render
# check, preventing a full 15s timeout if a rendering log line was suppressed.
# -----------------------------------------------------------------------------

LOG_FILE=""
LOG_PID=""
if [ "$WAIT" = true ] && { [ "$SHOW" = true ] || [ "$VERTICAL" = true ]; }; then
  LOG_FILE=$(mktemp)
  if [ ! -w "$LOG_FILE" ]; then
    echo "Error: Could not create writable temporary file for logcat monitoring." >&2
    exit 1
  fi

  # Clear buffer to avoid reading old logs from previous runs
  adb logcat -c

  # Monitor relevant tags in the background. We filter specifically for errors
  # from the renderer and runtime to catch async crashes.
  adb logcat -v time SysUI:D ProtoTilesTileRendererImpl:D AndroidRuntime:E "*:S" >"$LOG_FILE" &
  LOG_PID=$!

  # Cleanup runs on every exit; an interrupt exits 130, which triggers it.
  trap '
    [ -n "$LOG_PID" ] && kill "$LOG_PID" 2>/dev/null
    [ -n "$LOG_FILE" ] && rm -f "$LOG_FILE"
  ' EXIT
  trap '{ echo >&2; } 2>/dev/null; exit 130' INT TERM
fi

check_render_failures() {
  local phase="$1"
  # AndroidRuntime logs crashes from every process; only the provider, the
  # renderer, and SysUI are relevant. The "Process:" line follows the
  # "FATAL EXCEPTION" line.
  if grep -A 1 "FATAL EXCEPTION" "$LOG_FILE" | grep -F "Process: " |
    grep -qF -e "Process: $PACKAGE_NAME," -e "Process: $PACKAGE_NAME:" \
      -e "Process: $RENDERER_PACKAGE," -e "Process: $RENDERER_PACKAGE:" -e "sysui"; then
    # b/488353353
    echo "Error: Remote Compose App Crash detected (${phase})!" >&2
    echo "This usually indicates an IPC payload limit was exceeded (TransactionTooLargeException) or a local runtime crash." >&2
    grep -A 5 "FATAL EXCEPTION" "$LOG_FILE" >&2
    exit 1
  fi
  if grep -q "Error getting tile response" "$LOG_FILE"; then
    echo "Error: Renderer timed out getting the tile response (${phase})." >&2
    echo "The provider may have hung or crashed silently before responding." >&2
    grep "Error getting tile response" "$LOG_FILE" >&2
    exit 1
  fi
  if grep -q "Failed to render and attach the tile" "$LOG_FILE"; then
    # b/473745800
    echo "Error: Renderer failed to parse or attach the document (${phase})." >&2
    echo "This is typically caused by unsupported Remote Compose modifiers (e.g., alpha, blur)." >&2
    grep -A 2 "Failed to render and attach the tile" "$LOG_FILE" >&2
    exit 1
  fi
}

wait_for_tile_visibility() {
  echo "Waiting for tile visibility..."
  local start_time
  start_time=$(date +%s)
  local timeout="${ADB_TILE_VISIBILITY_TIMEOUT:-15}"
  local visible=false
  local visible_time=0

  while true; do
    local current_time
    current_time=$(date +%s)
    local elapsed=$((current_time - start_time))

    # Check if logcat background process died unexpectedly
    if ! kill -0 "$LOG_PID" 2>/dev/null; then
      echo "Error: Background logcat process died unexpectedly. Cannot verify visibility." >&2
      exit 1
    fi

    # Check if device disconnected
    if ! adb get-state >/dev/null 2>&1; then
      echo "Error: Device disconnected during visibility check." >&2
      exit 1
    fi

    # Check for Container Visibility (Success Signal 1)
    if [ "$visible" = false ]; then
      if [ "$VERTICAL" = true ]; then
        if grep -Eq "(Attaching Tile to a container|Rendering tile).*$PACKAGE_NAME" "$LOG_FILE"; then
          visible=true
          visible_time=$current_time
        fi
      elif grep -Eq "Visible tile added|onVisibleTileAdded|Jumped to the tile|Index=\[|show-tile" "$LOG_FILE"; then
        visible=true
        visible_time=$current_time
      fi
    fi

    # Check for Content Rendering (Success Signal 2)
    if [ "$visible" = true ]; then
      if [ "$VERTICAL" = true ]; then
        # In TileRendererImpl.java, "Rendering tile" is logged only when both
        # the container is attached and valid tile content has been received.
        if grep -Eq "Rendering tile.*$PACKAGE_NAME" "$LOG_FILE"; then
          break
        fi
      elif grep -Eq "(Received tile content|Rendering tile|provideWidgetData|ProtoTiles).*$PACKAGE_NAME" "$LOG_FILE"; then
        break
      fi

      # Robustness: If the container is attached/visible, don't wait more than
      # 3 seconds for the specific rendering log.
      if [ $((current_time - visible_time)) -ge 3 ]; then
        break
      fi
    fi

    # --- Failure Detection (Pre-Visibility) ---
    check_render_failures "pre-visibility"

    # Global timeout: the add succeeded, but visibility was not confirmed, which
    # is what --wait promises; report that rather than exit 0.
    if [ "$elapsed" -ge "$timeout" ]; then
      if [ "$visible" = false ]; then
        echo "$(basename "$0"): added, but the tile did not become visible within $timeout s; it may still be loading, or its log lines were missed (retry with --no-wait to skip this check)" >&2
        if grep -qF "$PACKAGE_NAME" "$LOG_FILE"; then
          echo "$(basename "$0"): last log lines mentioning $PACKAGE_NAME:" >&2
          grep -F "$PACKAGE_NAME" "$LOG_FILE" | tail -n 5 >&2
        else
          echo "$(basename "$0"): no log lines mentioning $PACKAGE_NAME were seen" >&2
        fi
        exit 1
      fi
      break
    fi

    sleep "${ADB_TILE_RETRY_DELAY:-0.2}"
  done

  if [ "$visible" = true ]; then
    # Continue monitoring briefly after "Rendering tile" / container visibility:
    # TileRendererImpl logs "Rendering tile" right before calling
    # RcTileViewInstance.renderAndAttach(), which may throw
    # "Failed to render and attach the tile" or trigger an async crash.
    sleep "${ADB_TILE_RENDER_DELAY:-0.8}"

    # --- Failure Detection (Post-Visibility Buffer) ---
    check_render_failures "post-visibility"
    echo "Success: Tile is visible."
  fi
}

# Workaround for a bug: force-stop the package to ensure a fresh bind
adb shell am force-stop "$PACKAGE_NAME"

if [[ "$VERTICAL" == true ]]; then
  if [[ "$SHOW" == true ]]; then
    adb shell am start -W -n "$TRAY_ACTIVITY" >/dev/null 2>&1
  fi

  WIDGET_ID=""
  WIDGET_ID_RE='"widgetId":[[:space:]]*([0-9]+)'
  ERROR_MSG_RE='"message":"([^"]+)"'
  STARTED_TRAY="$SHOW"

  for _ in {1..15}; do
    OUTPUT=$(adb shell "am broadcast -p $RENDERER_PACKAGE -a $TRAY_ACTION_ADD \
--es component $(device_quote "$COMPONENT_NAME") --es container_type $TYPE_STR" 2>&1 | tr -d '\r')

    if [[ "$OUTPUT" == *"result=-1"* && "$OUTPUT" =~ $WIDGET_ID_RE ]]; then
      WIDGET_ID="${BASH_REMATCH[1]}"
      break
    fi

    if [[ "$OUTPUT" == *'"status":"ERROR"'* ]]; then
      if [[ "$OUTPUT" =~ $ERROR_MSG_RE ]]; then
        echo "$(basename "$0"): ${BASH_REMATCH[1]}" >&2
      else
        echo "$(basename "$0"): ADD_WIDGET failed: $OUTPUT" >&2
      fi
      exit 1
    fi

    # Only an unanswered broadcast is safe to resend; anything else (adb or am
    # failing) might have added the widget already.
    if [[ "$OUTPUT" != *"Broadcast completed: result="* ]]; then
      echo "$(basename "$0"): am broadcast ADD_WIDGET failed: ${OUTPUT:-no output from adb}" >&2
      exit 1
    fi

    if [[ "$STARTED_TRAY" == false ]]; then
      adb shell am start -W -n "$TRAY_ACTIVITY" >/dev/null 2>&1
      STARTED_TRAY=true
      continue
    fi

    sleep "${ADB_TILE_RETRY_DELAY:-0.5}"
  done

  if [[ -z "$WIDGET_ID" ]]; then
    echo "$(basename "$0"): timed out waiting for WidgetTrayReceiver to handle ADD_WIDGET:" >&2
    echo "$OUTPUT" >&2
    exit 1
  fi

  echo "Added/activated widget ID: $WIDGET_ID"

  if [[ "$WAIT" == true ]]; then
    wait_for_tile_visibility
  fi

  exit 0
fi

# Add the tile and capture output
OUTPUT=$(adb shell "am broadcast -a com.google.android.wearable.app.DEBUG_SURFACE \
--es operation add-tile --ecn component $(device_quote "$COMPONENT_NAME") --ei type $TYPE_INT")

# Check for "Requested tile provider does not exist" error (result=2)
if echo "$OUTPUT" | grep -q "Requested tile provider does not exist"; then
  echo "Error: The requested tile provider does not exist or is disabled."
  echo "This commonly happens with system tiles that cannot be added via this method."
  exit 1
fi

# Extract Index (e.g., from Index=[0])
INDEX=$(echo "$OUTPUT" | grep -o 'Index=\[[0-9]*\]' | sed 's/Index=\[\([0-9]*\)\]/\1/')

if [ -z "$INDEX" ] && echo "$OUTPUT" | grep -q "add-tile failed"; then
  # Tile is already present in carousel; default index to 0
  INDEX=0
fi

if [ -n "$INDEX" ]; then
  echo "Added/activated tile ID: $INDEX"
  if [ "$SHOW" = true ]; then
    adb shell am broadcast \
      -a com.google.android.wearable.app.DEBUG_SYSUI \
      --es operation show-tile \
      --ei index "$INDEX" >/dev/null

    if [ "$WAIT" = true ]; then
      wait_for_tile_visibility
    fi
  fi
else
  echo "Failed to parse tile ID from output:"
  echo "$OUTPUT"
  exit 1
fi
