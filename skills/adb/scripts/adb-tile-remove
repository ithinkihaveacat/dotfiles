#!/usr/bin/env bash

# Tests: skills/adb/tests/test-adb-tile

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] COMPONENT_NAME
       $(basename "$0") --vertical WIDGET_ID
       $(basename "$0") --vertical --all

Removes a tile from the SysUI carousel, or widgets from the standalone
renderer's vertical carousel (--vertical).

Arguments:
  COMPONENT_NAME  A string composed of the package name and a class in that
                  package, for example:
                  com.example.wear.tiles/com.example.wear.tiles.PreviewTileService
                  Every instance of the component is removed. With --vertical, a
                  short class name (e.g. WeatherWidgetService) is matched
                  case-insensitively against installed providers.
  WIDGET_ID       A numeric tray widget ID, as printed by 'adb-tiles --vertical'
                  or 'adb-tile-add --vertical'. Use it to remove one instance
                  when a provider has several.

Options:
  -s, --serial SERIAL
                  Target device serial; must precede arguments or commands.
  --vertical      Remove from the standalone renderer's vertical carousel
                  (WidgetTrayActivity) instead of the SysUI horizontal carousel,
                  opening it if needed. Requires the .emu, .exp, or .dev renderer
                  flavor.
  --all           With --vertical, remove every widget in the tray. Requires a
                  recent renderer.
  --help          Display this help message and exit

Environment:
  ANDROID_SERIAL  Serial number of device to connect to (see 'adb devices -l').
                  The --serial option takes precedence when both are set.

Examples:
  $(basename "$0") com.google.android.wearable.shell/.weather.WeatherTileService
  $(basename "$0") --vertical com.google.example.wear_widget/.HelloWidgetService
  $(basename "$0") --vertical 10001
  $(basename "$0") --vertical --all

With --vertical, each removal is reported on stderr (e.g. 'Removed widget ID:
10001' or 'Removed 2 widgets: COMPONENT'), and the exit status is 1 if no tray
widget matched.
EOF
  exit 0
}

usage_short() {
  cat <<EOF >&2
Usage: $(basename "$0") [OPTIONS] COMPONENT_NAME

Remove a Wear OS tile, or a tray widget with --vertical, on an adb-connected watch.

Examples:
  $(basename "$0") com.google.android.wearable.shell/.weather.WeatherTileService
  $(basename "$0") --vertical --all

Try '$(basename "$0") --help' for more information.
EOF
  exit 1
}

if [[ $# -eq 0 ]]; then
  usage_short
fi

VERTICAL=false
ALL=false
COMPONENT_NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s | --serial)
      if [[ -n "${COMPONENT_NAME:-}" ]]; then
        echo "$(basename "$0"): $1 must precede arguments or commands" >&2
        exit 1
      fi
      if [[ -z "${2:-}" ]]; then
        echo "$(basename "$0"): $1 option requires an argument" >&2
        exit 1
      fi
      export ANDROID_SERIAL="$2"
      shift 2
      ;;
    --vertical)
      VERTICAL=true
      shift
      ;;
    --all)
      ALL=true
      shift
      ;;
    --help | -h)
      usage
      ;;
    -*)
      echo "$(basename "$0"): unknown option '$1'" >&2
      exit 1
      ;;
    *)
      if [[ -z "$COMPONENT_NAME" ]]; then
        COMPONENT_NAME="$1"
      else
        echo "$(basename "$0"): unexpected argument '$1'" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ "$ALL" == true ]]; then
  if [[ "$VERTICAL" != true ]]; then
    echo "$(basename "$0"): --all requires --vertical" >&2
    exit 1
  fi
  if [[ -n "$COMPONENT_NAME" ]]; then
    echo "$(basename "$0"): --all cannot be combined with '$COMPONENT_NAME'" >&2
    exit 1
  fi
elif [[ -z "$COMPONENT_NAME" ]]; then
  usage_short
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require adb
trap '{ echo >&2; } 2>/dev/null; exit 130' INT TERM
if [[ "$VERTICAL" == true ]]; then
  require jq
fi

# Check device availability
if ! DEVICE_ERROR=$(adb get-state 2>&1 >/dev/null); then
  if [[ "$DEVICE_ERROR" == *"more than one"* ]]; then
    echo "$(basename "$0"): more than one device connected; use --serial or set ANDROID_SERIAL" >&2
  elif [[ -n "${ANDROID_SERIAL:-}" ]]; then
    echo "$(basename "$0"): device '$ANDROID_SERIAL' not available" >&2
  else
    echo "$(basename "$0"): no device connected" >&2
  fi
  exit 1
fi

# adb shell joins its arguments with spaces and the device shell re-parses the
# result, so commands carrying arbitrary values (a '$' in a nested class name)
# are sent as one string with each value single-quoted.
device_quote() {
  local escaped="'\\''"
  printf "'%s'" "${1//\'/$escaped}"
}

if [[ "$VERTICAL" == true ]]; then
  RENDERER_PACKAGE="com.google.android.wearable.protolayout.renderer"
  TRAY_ACTIVITY="${RENDERER_PACKAGE}/com.google.android.clockwork.prototiles.renderer.experimental.WidgetTrayActivity"
  TRAY_ACTION_PREFIX="com.google.android.clockwork.prototiles.action."
  TRAY_DATA_RE='data="(.*)"'

  renderer_desc() {
    local version
    version=$(adb shell dumpsys package "$RENDERER_PACKAGE" 2>/dev/null | tr -d '\r' | sed -n 's/^[[:space:]]*versionName=//p' | head -n 1)
    echo "${RENDERER_PACKAGE}${version:+ $version}"
  }

  # Sends a WidgetTrayReceiver action and prints its JSON result. The receiver
  # is registered only while WidgetTrayActivity is alive, so an unanswered
  # broadcast (result=0, no data) opens the tray and retries. Returns 1 if the
  # receiver never answers, which is also how renderers without the action
  # respond, and 2 (after reporting it) if am broadcast itself fails, e.g. the
  # device went away. An unanswered broadcast was not handled, so retrying a
  # removal cannot remove twice.
  tray_broadcast() {
    local action="$1" output attempt started=false cmdline arg
    shift
    for ((attempt = 1; attempt <= ${ADB_TILE_TRAY_ATTEMPTS:-10}; attempt++)); do
      cmdline="am broadcast -p $RENDERER_PACKAGE -a ${TRAY_ACTION_PREFIX}${action}"
      for arg in "$@"; do
        cmdline+=" $(device_quote "$arg")"
      done
      output=$(adb shell "$cmdline" 2>&1 | tr -d '\r')
      if [[ "$output" =~ $TRAY_DATA_RE ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
      fi
      if [[ "$output" != *"Broadcast completed: result="* ]]; then
        echo "$(basename "$0"): am broadcast $action failed: ${output:-no output from adb}" >&2
        return 2
      fi
      if [[ "$started" == false ]]; then
        adb shell am start -W -n "$TRAY_ACTIVITY" >/dev/null 2>&1
        started=true
        continue
      fi
      sleep "${ADB_TILE_RETRY_DELAY:-0.5}"
    done
    return 1
  }

  # Prints the widget IDs in a GET_WIDGETS answer, one per line. Fails unless
  # the answer is a well-formed OK response, so that no output reliably means
  # an empty tray.
  tray_widget_ids() {
    jq -r 'if .status == "OK" and (.widgets | type == "array")
      then .widgets[] | (.widgetId | numbers) // error("bad widgetId")
      else error("unexpected answer") end' <<<"$1" 2>/dev/null
  }

  # Removes one widget by ID; reports the outcome on stderr.
  remove_widget_id() {
    local widget_id="$1" result outcome message
    result=$(tray_broadcast REMOVE_WIDGET --ei widget_id "$widget_id")
    case $? in
      0) ;;
      1)
        echo "$(basename "$0"): timed out waiting for WidgetTrayReceiver to handle REMOVE_WIDGET for widget ID $widget_id" >&2
        return 1
        ;;
      *) return 1 ;;
    esac
    outcome=$(jq -r 'if .status == "OK" and .removed != false then "removed"
      elif .status == "ERROR" and .removed == false then "missing"
      else "other" end' <<<"$result" 2>/dev/null)
    case "$outcome" in
      removed)
        echo "Removed widget ID: $widget_id" >&2
        return 0
        ;;
      missing)
        echo "$(basename "$0"): no widget with ID $widget_id in the tray (see 'adb-tiles --vertical')" >&2
        ;;
      *)
        message=$(jq -r '.message // empty' <<<"$result" 2>/dev/null)
        echo "$(basename "$0"): ${message:-unexpected REMOVE_WIDGET answer: $result}" >&2
        ;;
    esac
    return 1
  }

  RESOLVE_OUT=$(adb shell cmd package resolve-activity --brief -n "$TRAY_ACTIVITY" 2>/dev/null | tr -d '\r')
  if [[ "$RESOLVE_OUT" != *"$TRAY_ACTIVITY"* ]]; then
    echo "$(basename "$0"): installed renderer ($(renderer_desc)) lacks WidgetTrayActivity; --vertical requires the .emu, .exp, or .dev renderer flavor" >&2
    exit 1
  fi

  if [[ "$ALL" == true ]]; then
    RESULT=$(tray_broadcast GET_WIDGETS)
    case $? in
      0) ;;
      1)
        echo "$(basename "$0"): installed renderer ($(renderer_desc)) did not answer GET_WIDGETS; --all requires a newer .emu, .exp, or .dev renderer" >&2
        exit 1
        ;;
      *) exit 1 ;;
    esac
    if ! WIDGET_IDS=$(tray_widget_ids "$RESULT"); then
      echo "$(basename "$0"): unexpected GET_WIDGETS answer: $RESULT" >&2
      exit 1
    fi
    if [[ -z "$WIDGET_IDS" ]]; then
      echo "$(basename "$0"): tray is already empty" >&2
      exit 0
    fi

    # Keep going after a failed removal; the final listing decides the outcome.
    FAILED=0
    for widget_id in $WIDGET_IDS; do
      remove_widget_id "$widget_id" || FAILED=$((FAILED + 1))
    done

    RESULT=$(tray_broadcast GET_WIDGETS)
    case $? in
      0) ;;
      1)
        echo "$(basename "$0"): cannot verify the tray is empty: GET_WIDGETS was not answered" >&2
        exit 1
        ;;
      *) exit 1 ;;
    esac
    if ! REMAINING=$(tray_widget_ids "$RESULT"); then
      echo "$(basename "$0"): cannot verify the tray is empty: unexpected GET_WIDGETS answer: $RESULT" >&2
      exit 1
    fi
    if [[ -n "$REMAINING" ]]; then
      echo "$(basename "$0"): tray still contains widget IDs: $(printf '%s\n' "$REMAINING" | paste -sd ' ' -)" >&2
      exit 1
    fi
    if ((FAILED > 0)); then
      echo "$(basename "$0"): tray is now empty, although $FAILED removal(s) above reported an error" >&2
    fi
    exit 0
  fi

  if [[ "$COMPONENT_NAME" =~ ^[0-9]+$ ]]; then
    remove_widget_id "$COMPONENT_NAME"
    exit $?
  fi

  if [[ "$COMPONENT_NAME" == */* ]]; then
    PACKAGE_NAME="${COMPONENT_NAME%%/*}"
    if ! adb shell pm list packages | tr -d '\r' | grep -q "^package:${PACKAGE_NAME}$"; then
      echo "$(basename "$0"): package '$PACKAGE_NAME' not found; is the app installed?" >&2
      exit 1
    fi
  fi

  RESULT=$(tray_broadcast REMOVE_WIDGET --es component "$COMPONENT_NAME")
  case $? in
    0) ;;
    1)
      echo "$(basename "$0"): timed out waiting for WidgetTrayReceiver to handle REMOVE_WIDGET" >&2
      exit 1
      ;;
    *) exit 1 ;;
  esac

  if [[ "$(jq -r '.status // empty' <<<"$RESULT" 2>/dev/null)" != "OK" ]]; then
    MESSAGE=$(jq -r '.message // empty' <<<"$RESULT" 2>/dev/null)
    echo "$(basename "$0"): ${MESSAGE:-REMOVE_WIDGET failed: $RESULT}" >&2
    exit 1
  fi

  # Current renderers report removedCount; older ones only a removed flag.
  REMOVED=$(jq -r 'if (.removedCount | type) == "number" then .removedCount
    elif .removed == true then "some" else "unknown" end' <<<"$RESULT" 2>/dev/null)
  RESOLVED=$(jq -r --arg c "$COMPONENT_NAME" '.component // $c' <<<"$RESULT" 2>/dev/null)
  case "$REMOVED" in
    0)
      echo "$(basename "$0"): no tray widget matches $COMPONENT_NAME (see 'adb-tiles --vertical')" >&2
      exit 1
      ;;
    1)
      echo "Removed 1 widget: ${RESOLVED:-$COMPONENT_NAME}" >&2
      ;;
    some)
      echo "Removed widgets: ${RESOLVED:-$COMPONENT_NAME}" >&2
      ;;
    '' | unknown | *[!0-9]*)
      echo "$(basename "$0"): unexpected REMOVE_WIDGET answer: $RESULT" >&2
      exit 1
      ;;
    *)
      echo "Removed $REMOVED widgets: ${RESOLVED:-$COMPONENT_NAME}" >&2
      ;;
  esac
  exit 0
fi

PACKAGE_NAME="${COMPONENT_NAME%%/*}"

# Check if the package is installed
if ! adb shell pm list packages | tr -d '\r' | grep -q "^package:${PACKAGE_NAME}$"; then
  echo "$(basename "$0"): package '$PACKAGE_NAME' not found; is the app installed?" >&2
  exit 1
fi

adb shell "am broadcast -a com.google.android.wearable.app.DEBUG_SURFACE --es operation remove-tile --ecn component $(device_quote "$COMPONENT_NAME")"
