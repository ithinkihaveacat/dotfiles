#!/usr/bin/env bash

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] COMPLICATION_ID

Triggers an update for a specific complication on a Wear OS device.

This script is a convenient wrapper around 'adb shell am broadcast' to force
the system to update a complication's data feed via DEBUG_SYSUI.

Arguments:
  COMPLICATION_ID  Integer ID of the complication to update

Options:
  -s, --serial SERIAL
                  Target device serial; must precede arguments or commands.
  --help          Display this help message and exit

Environment:
  ANDROID_SERIAL  Serial number of device to connect to (see 'adb devices -l').
                  The --serial option takes precedence when both are set.

Examples:
  # Force update complication with ID 1
  $(basename "$0") 1
EOF
  exit 0
}

usage_short() {
  cat <<EOF >&2
Usage: $(basename "$0") COMPLICATION_ID

Trigger a complication update on an adb-connected Wear OS device.

Examples:
  $(basename "$0") 1

Try '$(basename "$0") --help' for more information.
EOF
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s | --serial)
      if [[ -z "${2:-}" ]]; then
        echo "$(basename "$0"): $1 option requires an argument" >&2
        exit 1
      fi
      export ANDROID_SERIAL="$2"
      shift 2
      ;;
    --help | -h)
      usage
      ;;
    *)
      break
      ;;
  esac
done

for arg in "${@:2}"; do
  case "$arg" in
    -s | --serial)
      echo "$(basename "$0"): $arg must precede arguments or commands" >&2
      exit 1
      ;;
  esac
done

if [ -z "${1:-}" ]; then
  usage_short
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require adb

# Check device availability
if ! adb get-state >/dev/null 2>&1; then
  if [[ -n "$ANDROID_SERIAL" ]]; then
    echo "$(basename "$0"): device '$ANDROID_SERIAL' not available" >&2
  else
    echo "$(basename "$0"): no device connected" >&2
  fi
  exit 1
fi

adb exec-out am broadcast \
  -a "com.google.android.wearable.app.DEBUG_SYSUI" \
  --es "operation" "complication_update" \
  --ei "complication_id" "$1"
