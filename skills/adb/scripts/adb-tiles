#!/usr/bin/env bash

if ((BASH_VERSINFO[0] < 4)); then
  echo "$(basename "$0"): requires bash 4.0 or higher (found ${BASH_VERSION})" >&2
  exit 1
fi

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Lists the tile and widget services/receivers installed on the connected device,
or the widgets in the standalone renderer's vertical carousel (--vertical).

Options:
  -s, --serial SERIAL
                  Target device serial; must precede arguments or commands.
  --vertical       List widgets in the standalone renderer's vertical carousel
                   (WidgetTrayActivity) instead, opening it if needed. Requires
                   a recent .emu, .exp, or .dev renderer. Cannot be combined
                   with the filter options below.
  --tiles-only     List only tile services
  --widgets-only   List only widget services
  --user-only      List only services from user-installed apps
  --system-only    List only services from system apps
  --carousel-only  List only services currently in the carousel
  --help           Display this help message and exit

Environment:
  ANDROID_SERIAL  Serial number of device to connect to (see 'adb devices -l').
                  The --serial option takes precedence when both are set.

Examples:
  $(basename "$0")
  $(basename "$0") --tiles-only
  $(basename "$0") --carousel-only
  $(basename "$0") --vertical
  $(basename "$0") --vertical | awk '\$2 == "SMALL" { print \$1 }'

Output format:
  [Source][Tile][Widget][Carousel] Component

  Source:   S (System) or U (User)
  Tile:     T or space
  Widget:   W or space
  Carousel: C or space

Output format (--vertical):
  WIDGET_ID TYPE COMPONENT

  WIDGET_ID is the ID accepted by 'adb-tile-remove --vertical' and
  'adb-tile-dump'; TYPE is LARGE or SMALL. Documents uploaded as raw .rc
  files appear with the UploadedDocWidget component.
EOF
  exit 0
}

# Parse args
tiles_only=0
widgets_only=0
user_only=0
system_only=0
carousel_only=0
vertical=0

while [[ "$#" -gt 0 ]]; do
  case $1 in
    -s | --serial)
      if [[ -z "${2:-}" ]]; then
        echo "$(basename "$0"): $1 option requires an argument" >&2
        exit 1
      fi
      export ANDROID_SERIAL="$2"
      shift 2
      continue
      ;;
    --vertical) vertical=1 ;;
    --tiles-only) tiles_only=1 ;;
    --widgets-only) widgets_only=1 ;;
    --user-only) user_only=1 ;;
    --system-only) system_only=1 ;;
    --carousel-only) carousel_only=1 ;;
    --help | -h) usage ;;
    *)
      echo "$(basename "$0"): unknown option '$1'" >&2
      exit 1
      ;;
  esac
  shift
done

if ((tiles_only && widgets_only)); then
  echo "$(basename "$0"): cannot specify both --tiles-only and --widgets-only" >&2
  exit 1
fi

if ((vertical && (tiles_only || widgets_only || user_only || system_only || carousel_only))); then
  echo "$(basename "$0"): --vertical cannot be combined with filter options" >&2
  exit 1
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require adb
trap '{ echo >&2; } 2>/dev/null; exit 130' INT TERM
if ((vertical)); then
  require jq
fi

# Check device availability
if ! DEVICE_ERROR=$(adb get-state 2>&1 >/dev/null); then
  if [[ "$DEVICE_ERROR" == *"more than one"* ]]; then
    echo "$(basename "$0"): more than one device connected; use --serial or set ANDROID_SERIAL" >&2
  elif [[ -n "$ANDROID_SERIAL" ]]; then
    echo "$(basename "$0"): device '$ANDROID_SERIAL' not available" >&2
  else
    echo "$(basename "$0"): no device connected" >&2
  fi
  exit 1
fi

RENDERER_PACKAGE="com.google.android.wearable.protolayout.renderer"
TRAY_ACTIVITY="${RENDERER_PACKAGE}/com.google.android.clockwork.prototiles.renderer.experimental.WidgetTrayActivity"
TRAY_ACTION_PREFIX="com.google.android.clockwork.prototiles.action."
TRAY_DATA_RE='data="(.*)"'

renderer_desc() {
  local version
  version=$(adb shell dumpsys package "$RENDERER_PACKAGE" 2>/dev/null | tr -d '\r' | sed -n 's/^[[:space:]]*versionName=//p' | head -n 1)
  echo "${RENDERER_PACKAGE}${version:+ $version}"
}

# adb shell joins its arguments with spaces and the device shell re-parses the
# result, so commands carrying arbitrary values (a '$' in a nested class name)
# are sent as one string with each value single-quoted.
device_quote() {
  local escaped="'\\''"
  printf "'%s'" "${1//\'/$escaped}"
}

# Sends a WidgetTrayReceiver action and prints its JSON result. The receiver is
# registered only while WidgetTrayActivity is alive, so an unanswered broadcast
# (result=0, no data) opens the tray and retries. Returns 1 if the receiver
# never answers, which is also how renderers without the action respond, and 2
# (after reporting it) if am broadcast itself fails, e.g. the device went away.
tray_broadcast() {
  local action="$1" output attempt started=false cmdline arg
  shift
  for ((attempt = 1; attempt <= ${ADB_TILE_TRAY_ATTEMPTS:-10}; attempt++)); do
    cmdline="am broadcast -p $RENDERER_PACKAGE -a ${TRAY_ACTION_PREFIX}${action}"
    for arg in "$@"; do
      cmdline+=" $(device_quote "$arg")"
    done
    output=$(adb shell "$cmdline" 2>&1 | tr -d '\r')
    if [[ "$output" =~ $TRAY_DATA_RE ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
    if [[ "$output" != *"Broadcast completed: result="* ]]; then
      echo "$(basename "$0"): am broadcast $action failed: ${output:-no output from adb}" >&2
      return 2
    fi
    if [[ "$started" == false ]]; then
      adb shell am start -W -n "$TRAY_ACTIVITY" >/dev/null 2>&1
      started=true
      continue
    fi
    sleep "${ADB_TILE_RETRY_DELAY:-0.5}"
  done
  return 1
}

if ((vertical)); then
  RESOLVE_OUT=$(adb shell cmd package resolve-activity --brief -n "$TRAY_ACTIVITY" 2>/dev/null | tr -d '\r')
  if [[ "$RESOLVE_OUT" != *"$TRAY_ACTIVITY"* ]]; then
    echo "$(basename "$0"): installed renderer ($(renderer_desc)) lacks WidgetTrayActivity; --vertical requires the .emu, .exp, or .dev renderer flavor" >&2
    exit 1
  fi

  RESULT=$(tray_broadcast GET_WIDGETS)
  case $? in
    0) ;;
    1)
      echo "$(basename "$0"): installed renderer ($(renderer_desc)) did not answer GET_WIDGETS; listing tray widgets requires a newer .emu, .exp, or .dev renderer" >&2
      exit 1
      ;;
    *) exit 1 ;;
  esac

  # An empty list must mean an empty tray, never an answer that was not read.
  if ! jq -e '.status == "OK" and (.widgets | type == "array")' <<<"$RESULT" >/dev/null 2>&1; then
    echo "$(basename "$0"): unexpected GET_WIDGETS answer: $RESULT" >&2
    exit 1
  fi

  jq -r '.widgets[] | "\(.widgetId) \(.containerTypeString) \(.component)"' <<<"$RESULT" || exit 1
  exit 0
fi

# Fetch user packages to distinguish system vs user apps
declare -A user_pkgs
while read -r line; do
  pkg=${line#package:}
  [[ -z "$pkg" ]] && continue
  user_pkgs["$pkg"]=1
done < <(adb shell pm list packages -3 | tr -d '\r')

# Fetch visible tiles and widgets in carousel (Visible Tiles and DB Visible Tiles)
declare -A visible_tiles
while read -r comp; do
  [[ -z "$comp" ]] && continue
  visible_tiles["$comp"]=1
done < <(
  adb shell dumpsys wear_service | tr -d '\r' | awk '
    function normalize(c,    slash, pkg, cls) {
      gsub(/^[ \t]+|[ \t]+$/, "", c)
      slash = index(c, "/")
      if (slash > 0 && substr(c, slash + 1, 1) == ".") {
        pkg = substr(c, 1, slash - 1)
        cls = substr(c, slash + 1)
        c = pkg "/" pkg cls
      }
      return c
    }
    /DB Visible Tiles/ { in_db = 1; in_visible = 0; next }
    /Visible Tiles/ { in_visible = 1; in_db = 0; next }
    (in_visible || in_db) && /^[ ]{0,4}[^ ]/ { in_visible = 0; in_db = 0 }
    in_visible && /TileInstance/ && /componentName=ComponentInfo\{/ {
      s = $0
      sub(/^.*componentName=ComponentInfo\{/, "", s)
      sub(/\}.*$/, "", s)
      print normalize(s)
      next
    }
    in_db && /id=/ {
      pkg = ""
      cls = ""
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^packageName=/) {
          pkg = $i
          sub(/^packageName=/, "", pkg)
        } else if ($i ~ /^className=/) {
          cls = $i
          sub(/^className=/, "", cls)
        }
      }
      if (pkg != "" && cls != "") {
        print normalize(pkg "/" cls)
      }
      next
    }
  '
)

# Define constants
TILE_PERM="com.google.android.wearable.permission.BIND_TILE_PROVIDER"
TILE_ACTION="androidx.wear.tiles.action.BIND_TILE_PROVIDER"
WIDGET_ACTION="androidx.glance.wear.action.BIND_WIDGET_PROVIDER"
APPWIDGET_ACTION="android.appwidget.action.APPWIDGET_UPDATE"

# Awk script to parse 'cmd package query-services' and 'cmd package query-receivers' output
# Extract package/class from ServiceInfo or ActivityInfo blocks, ignoring ApplicationInfo
# shellcheck disable=SC2016
PARSE_CMD_OUTPUT_AWK='
  /ServiceInfo:/ || /ActivityInfo:/ { in_comp = 1; next }
  /ApplicationInfo:/ { in_comp = 0; next }
  in_comp && $1 ~ /^name=/ { sub(/^name=/, "", $1); comp_name = $1 }
  in_comp && $1 ~ /^packageName=/ { sub(/^packageName=/, "", $1); pkg_name = $1; print pkg_name "/" comp_name }
'

# 1. Get Tiles via Permission (Legacy/Standard method)
# dumpsys package services lists "Component: Permission"
# We extract components that require BIND_TILE_PROVIDER
dump_tiles=$(adb shell dumpsys package services |
  grep "${TILE_PERM}" |
  grep -v "Permission \[" |
  grep -v "perm=PermissionInfo" |
  grep -v "^[[:space:]]*${TILE_PERM}" |
  sed -E 's/^[[:space:]]*([^:]+):.*/\1/' |
  tr -d '\r')

# 2. Get Tiles via Action (Modern method)
action_tiles=$(adb shell cmd package query-services -a "${TILE_ACTION}" 2>/dev/null |
  awk "$PARSE_CMD_OUTPUT_AWK" |
  tr -d '\r')

# 3. Get Widgets via Action (Glance)
action_widgets=$(adb shell cmd package query-services -a "${WIDGET_ACTION}" 2>/dev/null |
  awk "$PARSE_CMD_OUTPUT_AWK" |
  tr -d '\r')

# 4. Get AppWidgets via Action (BroadcastReceivers)
action_appwidgets=$(adb shell cmd package query-receivers -a "${APPWIDGET_ACTION}" 2>/dev/null |
  awk "$PARSE_CMD_OUTPUT_AWK" |
  tr -d '\r')

# Process and Merge using awk
# Emit whitespace-delimited "IS_TILE IS_WIDGET COMPONENT" (0/1 flags) so
# downstream read never relies on significant leading spaces or string offsets.
awk '
  # Helper to clean and normalize component names (pkg/.Class -> pkg/pkg.Class)
  function normalize(c,    slash, pkg, cls) {
    gsub(/^[ \t]+|[ \t]+$/, "", c)
    slash = index(c, "/")
    if (slash > 0 && substr(c, slash + 1, 1) == ".") {
      pkg = substr(c, 1, slash - 1)
      cls = substr(c, slash + 1)
      c = pkg "/" pkg cls
    }
    return c
  }

  {
    type = $1
    # Component is the rest of the line (fields 2+)
    $1 = ""
    comp = normalize($0)

    if (comp == "") next

    if (type == "TILE:") {
      tiles[comp] = 1
    } else if (type == "WIDGET:") {
      widgets[comp] = 1
    }
  }

  END {
    # Combine all unique keys
    for (c in tiles) all[c] = 1
    for (c in widgets) all[c] = 1

    for (c in all) {
      printf "%d %d %s\n", (c in tiles), (c in widgets), c
    }
  }
' <(
  # Feed the streams with prefixes
  echo "$dump_tiles" | awk '{print "TILE: " $0}'
  echo "$action_tiles" | awk '{print "TILE: " $0}'
  echo "$action_widgets" | awk '{print "WIDGET: " $0}'
  echo "$action_appwidgets" | awk '{print "WIDGET: " $0}'
) | LC_ALL=C sort -u | while read -r is_tile is_widget comp; do
  [[ -z "$comp" ]] && continue

  pkg=${comp%%/*}
  if [[ -n "${user_pkgs[$pkg]+_}" ]]; then
    source_str="U"
  else
    source_str="S"
  fi

  tile_str=" "
  ((is_tile)) && tile_str="T"

  widget_str=" "
  ((is_widget)) && widget_str="W"

  carousel_str=" "
  if [[ -n "${visible_tiles[$comp]+_}" ]]; then
    carousel_str="C"
  fi

  # Apply filters
  if ((tiles_only && ! is_tile)); then
    continue
  fi
  if ((widgets_only && ! is_widget)); then
    continue
  fi
  if ((user_only)) && [[ "$source_str" != "U" ]]; then
    continue
  fi
  if ((system_only)) && [[ "$source_str" != "S" ]]; then
    continue
  fi
  if ((carousel_only)) && [[ "$carousel_str" != "C" ]]; then
    continue
  fi

  echo "${source_str}${tile_str}${widget_str}${carousel_str} ${comp}"
done
