#!/usr/bin/env bash
#
# Tests for bin/jetpack resolve subcommand

set -u

# Setup paths
SCRIPT_DIR=$(dirname "$0")
ROOT_DIR="$SCRIPT_DIR/.."
BIN_JETPACK="$ROOT_DIR/scripts/jetpack"
TEST_CACHE_DIR=$(mktemp -d)

# Mock cache directories to isolate from host ~/.cache/jetpack
export XDG_CACHE_HOME="$TEST_CACHE_DIR"
export JETPACK_CACHE_DIR="$TEST_CACHE_DIR/jetpack"
export TMPDIR="$TEST_CACHE_DIR"

# Total number of tests
TOTAL_TESTS=12
TEST_NUM=0

echo "1..$TOTAL_TESTS"

cleanup() {
  rm -rf "$TEST_CACHE_DIR"
}
trap cleanup EXIT

# Create mock cache directory and write the mock index once.
mkdir -p "$TEST_CACHE_DIR/jetpack"
cat <<EOF >"$TEST_CACHE_DIR/jetpack/androidx-index.json"
{
  "Index": [
    {
      "groupId": "androidx.core",
      "artifactId": "core-splashscreen",
      "version": "1.0.0",
      "fqcns": [
        "androidx.core.splashscreen.SplashScreen"
      ]
    },
    {
      "groupId": "androidx.wear.protolayout",
      "artifactId": "protolayout-material3",
      "version": "1.0.0",
      "fqcns": []
    },
    {
      "groupId": "androidx.lifecycle",
      "artifactId": "lifecycle-viewmodel",
      "version": "2.8.7",
      "fqcns": []
    },
    {
      "groupId": "androidx.lifecycle",
      "artifactId": "lifecycle-viewmodel-android",
      "version": "2.8.7",
      "fqcns": [
        "androidx.lifecycle.ViewModel"
      ]
    },
    {
      "groupId": "androidx.lifecycle",
      "artifactId": "lifecycle-viewmodel-compose",
      "version": "2.8.7",
      "fqcns": [
        "androidx.lifecycle.viewmodel.compose.ViewModel"
      ]
    },
    {
      "groupId": "androidx.wear.watchface",
      "artifactId": "watchface",
      "version": "1.0.0",
      "fqcns": [
        "androidx.wear.watchface.ComplicationSlot"
      ]
    },
    {
      "groupId": "androidx.wear",
      "artifactId": "wear-watchface",
      "version": "1.0.0-alpha22",
      "fqcns": [
        "androidx.wear.watchface.ComplicationSlot"
      ]
    },
    {
      "groupId": "androidx.annotation",
      "artifactId": "annotation",
      "version": "1.0.0",
      "fqcns": []
    },
    {
      "groupId": "androidx.annotation",
      "artifactId": "annotation-iosarm64",
      "version": "1.0.0",
      "fqcns": [
        "androidx.annotation.IosSpecific"
      ]
    }
  ]
}
EOF

run_test() {
  local input="$1"
  local expected="$2"

  TEST_NUM=$((TEST_NUM + 1))

  local err_file
  err_file=$(mktemp)

  OUTPUT=$("$BIN_JETPACK" resolve "$input" 2>"$err_file" || true)
  local err_msg
  err_msg=$(cat "$err_file")
  rm -f "$err_file"

  if [ "$OUTPUT" == "$expected" ]; then
    echo "ok $TEST_NUM - $input -> $expected"
  else
    echo "not ok $TEST_NUM - $input -> $expected"
    echo "# Got: $OUTPUT"
    echo "# Expected: $expected"
    if [[ -n "$err_msg" ]]; then
      while IFS= read -r line; do
        echo "# Stderr: $line"
      done <<<"$err_msg"
    fi
  fi
}

# A package, function, nested name, or class missing from the index must fail
# loudly and point at search, rather than guessing a coordinate from the
# package prefix.
run_test_fails() {
  local input="$1"

  TEST_NUM=$((TEST_NUM + 1))

  local err_file status
  err_file=$(mktemp)

  OUTPUT=$("$BIN_JETPACK" resolve "$input" 2>"$err_file")
  status=$?
  local err_msg
  err_msg=$(cat "$err_file")
  rm -f "$err_file"

  if [[ $status -ne 0 && -z "$OUTPUT" && "$err_msg" == *"search"* ]]; then
    echo "ok $TEST_NUM - $input is not a class, and the error points at search"
  else
    echo "not ok $TEST_NUM - $input is not a class, and the error points at search"
    echo "# Got: status=$status output=$OUTPUT"
    echo "# Stderr: $err_msg"
  fi
}

# Distinct resolve cases: simple class, KMP -android/-iosarm64 redirection,
# group tie-breakers, and coordinate passthrough.
run_test "androidx.core.splashscreen.SplashScreen" "androidx.core:core-splashscreen"
run_test "androidx.lifecycle.ViewModel" "androidx.lifecycle:lifecycle-viewmodel"
run_test "androidx.lifecycle.viewmodel.compose.ViewModel" "androidx.lifecycle:lifecycle-viewmodel-compose"
run_test "androidx.wear.watchface.ComplicationSlot" "androidx.wear.watchface:watchface"
run_test "androidx.annotation.IosSpecific" "androidx.annotation:annotation"
run_test "androidx.wear.tiles:tiles" "androidx.wear.tiles:tiles"
run_test "androidx.lifecycle:lifecycle-viewmodel" "androidx.lifecycle:lifecycle-viewmodel"

# Not classes: a package, a Kotlin top-level function, a nested class, and a
# function in an artifact whose classes the index does not list.
run_test_fails "androidx.compose.ui"
run_test_fails "androidx.compose.foundation.layout.padding"
run_test_fails "androidx.wear.watchface.ComplicationSlot.Builder"
run_test_fails "androidx.wear.protolayout.material3.textButton"
run_test_fails "com.example.nonexistent.Foo"
