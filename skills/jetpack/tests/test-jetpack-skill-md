#!/usr/bin/env bash
#
# Tests that SKILL.md instructs the agent to report a scripts/jetpack failure
# instead of silently falling back to a memorized answer, and that the
# referenced troubleshooting guidance stays in sync with the script's actual
# error messages (network failure vs. genuine 404).

set -u

# Setup paths
SCRIPT_DIR=$(dirname "$0")
ROOT_DIR="$SCRIPT_DIR/.."
SKILL_MD="$ROOT_DIR/SKILL.md"
TROUBLESHOOTING_MD="$ROOT_DIR/references/troubleshooting.md"
BIN_JETPACK="$ROOT_DIR/scripts/jetpack"

TOTAL_TESTS=5
TEST_NUM=0

echo "1..$TOTAL_TESTS"

assert_file_contains() {
  local description="$1"
  local file="$2"
  local needle="$3"

  TEST_NUM=$((TEST_NUM + 1))
  if grep -qF "$needle" "$file" 2>/dev/null; then
    echo "ok $TEST_NUM - $description"
  else
    echo "not ok $TEST_NUM - $description"
    echo "# Expected $file to contain: $needle"
  fi
}

assert_file_exists() {
  local description="$1"
  local file="$2"

  TEST_NUM=$((TEST_NUM + 1))
  if [[ -f "$file" ]]; then
    echo "ok $TEST_NUM - $description"
  else
    echo "not ok $TEST_NUM - $description"
    echo "# Expected file to exist: $file"
  fi
}

assert_file_contains "SKILL.md tells the agent not to silently fall back on failure" \
  "$SKILL_MD" "Do not silently fall back"

assert_file_exists "SKILL.md's troubleshooting reference exists" "$TROUBLESHOOTING_MD"

# Guard against the guidance drifting from the script it describes: both
# error strings fetch_maven_metadata can emit should be documented.
assert_file_contains "scripts/jetpack still emits the network-failure message" \
  "$BIN_JETPACK" "could not reach"

assert_file_contains "scripts/jetpack still emits the genuine-404 message" \
  "$BIN_JETPACK" "not found at"

assert_file_contains "troubleshooting.md documents the network-failure message" \
  "$TROUBLESHOOTING_MD" "could not reach"
