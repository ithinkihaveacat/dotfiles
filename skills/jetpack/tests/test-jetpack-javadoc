assert_contains "oversized HTML page logs byte size notice on stderr" \
  "$STDERR" "70000 bytes (> 65536 bytes); printing path instead of contents"
if [[ -f "$STDOUT" ]]; then
  ok "printed path for oversized HTML page exists on disk"
else
  not_ok "printed path for oversized HTML page exists on disk" "Missing: $STDOUT"
fi

