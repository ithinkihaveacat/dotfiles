#!/usr/bin/env bash
#
# Hermetic tests for `jetpack javadoc`, `jetpack inspect` fallback to
# `-javadoc.jar`, placeholder `-javadoc.jar` rejection, the 64 KiB single-file
# stdout cap, Dackka `/kotlin/` mirror deduplication, and nested class lookup.

set -u

SCRIPT_DIR=$(dirname "$0")
ROOT_DIR="$SCRIPT_DIR/.."
ABS_JETPACK=$(cd "$(dirname "$ROOT_DIR/scripts/jetpack")" && pwd)/jetpack

unset AGENT_OFFLINE

TEST_TMP=$(mktemp -d)
CLEAN_TMP=$(mktemp -d)
export TMPDIR="$CLEAN_TMP"
export JETPACK_CACHE_DIR="$TEST_TMP/cache"

SHIM_DIR="$TEST_TMP/shim"
SERVE_DIR="$TEST_TMP/serve"
CURL_LOG="$TEST_TMP/curl.log"
mkdir -p "$SHIM_DIR" "$SERVE_DIR" "$JETPACK_CACHE_DIR"

TOTAL_TESTS=16
TEST_NUM=0
echo "1..$TOTAL_TESTS"

cleanup() {
  rm -rf "$TEST_TMP" "$CLEAN_TMP"
}
trap cleanup EXIT

check() {
  local description="$1" cond="$2"
  shift 2
  TEST_NUM=$((TEST_NUM + 1))
  if [[ "$cond" == "1" ]]; then
    echo "ok $TEST_NUM - $description"
  else
    echo "not ok $TEST_NUM - $description"
    local line
    for line in "$@"; do
      echo "# $line"
    done
  fi
}

cat >"$JETPACK_CACHE_DIR/androidx-index.json" <<'EOF'
{
  "Index": [
    {
      "groupId": "com.google.android.gms",
      "artifactId": "play-services-wearable",
      "version": "19.0.0",
      "fqcns": [
        "com.google.android.gms.wearable.NodeClient",
        "com.google.android.gms.wearable.WearableListenerService"
      ]
    },
    {
      "groupId": "com.android.billingclient",
      "artifactId": "billing",
      "version": "7.1.1",
      "fqcns": [
        "com.android.billingclient.api.BillingClient"
      ]
    },
    {
      "groupId": "com.google.firebase",
      "artifactId": "firebase-analytics",
      "version": "24.0.0",
      "fqcns": [
        "com.google.firebase.analytics.FirebaseAnalytics"
      ]
    },
    {
      "groupId": "androidx.lifecycle",
      "artifactId": "lifecycle-common",
      "version": "2.8.7",
      "fqcns": [
        "androidx.lifecycle.Lifecycle"
      ]
    }
  ]
}
EOF

# Build all Maven metadata, POMs, and fixture JARs in one Python invocation.
python3 - "$SERVE_DIR" <<'PY'
import os, sys, zipfile

serve = sys.argv[1]

def seed_meta(repo, group, artifact, version):
    base = os.path.join(serve, repo, *group.split("."), artifact)
    os.makedirs(os.path.join(base, version), exist_ok=True)
    with open(os.path.join(base, "maven-metadata.xml"), "w") as f:
        f.write(
            f"<metadata><groupId>{group}</groupId><artifactId>{artifact}</artifactId>"
            f"<versioning><latest>{version}</latest><release>{version}</release>"
            f"<versions><version>{version}</version></versions></versioning></metadata>\n"
        )
    with open(os.path.join(base, version, f"{artifact}-{version}.pom"), "w") as f:
        f.write(
            f"<project><groupId>{group}</groupId><artifactId>{artifact}</artifactId>"
            f"<version>{version}</version></project>\n"
        )
    return os.path.join(base, version, f"{artifact}-{version}")

# 1. Closed-source Doclava SDK: normal, nested, and >64 KiB HTML pages (no -sources.jar)
wear_prefix = seed_meta(
    "dl.google.com/android/maven2",
    "com.google.android.gms",
    "play-services-wearable",
    "19.0.0",
)
big_head = "<html><body><h1>WearableListenerService</h1><p>"
big_tail = "</p><h2>Public Methods</h2><p>onDataChanged contract</p></body></html>\n"
big_html = big_head + ("c" * (70000 - len(big_head) - len(big_tail))) + big_tail
with zipfile.ZipFile(wear_prefix + "-javadoc.jar", "w") as z:
    z.writestr("META-INF/MANIFEST.MF", "Manifest-Version: 1.0\n")
    z.writestr("client/wearable/packages.html", "<html><body>packages</body></html>\n")
    z.writestr(
        "com/google/android/gms/wearable/NodeClient.html",
        "<html><body><h1>NodeClient</h1><p>Top-level client contract.</p></body></html>\n",
    )
    z.writestr(
        "com/google/android/gms/wearable/NodeClient.OnNodeMigratedListener.html",
        "<html><body><h1>NodeClient.OnNodeMigratedListener</h1><p>DataItemBuffer closes on return.</p></body></html>\n",
    )
    z.writestr("com/google/android/gms/wearable/WearableListenerService.html", big_html)

# 2. Dackka dual-language SDK: reference/ + reference/kotlin/ mirror + real kotlin/* package
billing_prefix = seed_meta(
    "dl.google.com/android/maven2", "com.android.billingclient", "billing", "7.1.1"
)
with zipfile.ZipFile(billing_prefix + "-javadoc.jar", "w") as z:
    z.writestr(
        "reference/com/android/billingclient/api/BillingClient.Builder.html",
        "<html devsite='true'><body><h1>BillingClient.Builder (Java)</h1></body></html>\n",
    )
    z.writestr(
        "reference/kotlin/com/android/billingclient/api/BillingClient.Builder.html",
        "<html devsite='true'><body><h1>BillingClient.Builder (Kotlin)</h1></body></html>\n",
    )
    z.writestr(
        "kotlin/collections/RealKotlinPkgOnly.html",
        "<html><body><h1>RealKotlinPkgOnly</h1></body></html>\n",
    )

# 3. Placeholder -javadoc.jar: 0-byte index.html + index boilerplate only
fb_prefix = seed_meta(
    "dl.google.com/android/maven2", "com.google.firebase", "firebase-analytics", "24.0.0"
)
with zipfile.ZipFile(fb_prefix + "-javadoc.jar", "w") as z:
    z.writestr("META-INF/MANIFEST.MF", "Manifest-Version: 1.0\n")
    z.writestr("index.html", "")
    z.writestr("client/analytics/packages.html", "<html>packages</html>\n")
    z.writestr("allclasses.html", "<html>allclasses</html>\n")
    z.writestr("overview-summary.html", "<html>overview</html>\n")

# 4. Maven Central JDK modular Javadoc with class-use/ cross-reference page
gson_prefix = seed_meta("repo1.maven.org/maven2", "com.google.code.gson", "gson", "2.11.0")
with zipfile.ZipFile(gson_prefix + "-javadoc.jar", "w") as z:
    z.writestr("allclasses-index.html", "<html>index</html>\n")
    z.writestr(
        "com.google.gson/com/google/gson/Gson.html",
        "<html><body><h1>Class Gson</h1></body></html>\n",
    )
    z.writestr(
        "com.google.gson/com/google/gson/GsonBuilder.html",
        "<html><body><h1>Class GsonBuilder</h1></body></html>\n",
    )
    z.writestr(
        "com.google.gson/com/google/gson/class-use/Gson.html",
        "<html><body><h1>Uses of Class Gson</h1></body></html>\n",
    )

# 5. Open-source Kotlin artifact with nested enum in enclosing Outer.kt
lc_prefix = seed_meta(
    "dl.google.com/android/maven2", "androidx.lifecycle", "lifecycle-common", "2.8.7"
)
with zipfile.ZipFile(lc_prefix + "-sources.jar", "w") as z:
    z.writestr(
        "androidx/lifecycle/Lifecycle.kt",
        "package androidx.lifecycle\nabstract class Lifecycle {\n  enum class State { CREATED, STARTED, RESUMED }\n}\n",
    )
PY

cat >"$SHIM_DIR/curl" <<'SHIM'
#!/usr/bin/env bash
out="" url="" prev=""
for a in "$@"; do
  [[ "$prev" == "-o" ]] && out="$a"
  prev="$a"
  case "$a" in
    http://* | https://*) url="$a" ;;
  esac
done
printf '%s\n' "$url" >>"$CURL_LOG"

if [[ -n "${FORCE_STATUS:-}" ]]; then
  [[ -n "$out" ]] && printf 'forced error body' >"$out"
  printf '%s' "$FORCE_STATUS"
  exit 0
fi

rel="${url#*://}"
if [[ -f "$SERVE_DIR/$rel" ]]; then
  [[ -n "$out" ]] && cp "$SERVE_DIR/$rel" "$out"
  printf '200'
else
  [[ -n "$out" ]] && printf '<html>404 Not Found</html>' >"$out"
  printf '404'
fi
SHIM
chmod +x "$SHIM_DIR/curl"
export SERVE_DIR CURL_LOG

run_jetpack() {
  : >"$CURL_LOG"
  local err_file="$TEST_TMP/stderr.tmp"
  STDOUT=$(PATH="$SHIM_DIR:$PATH" "$ABS_JETPACK" "$@" 2>"$err_file")
  STATUS=$?
  STDERR=$(cat "$err_file")
  rm -f "$err_file"
  CURL_CALLS=$(wc -l <"$CURL_LOG" | tr -d ' ')
  CURL_URLS=$(cat "$CURL_LOG")
}

# 1. Directory extraction strips META-INF and prints output path
run_jetpack javadoc --output "$TEST_TMP/wear-docs" com.google.android.gms:play-services-wearable
cond=0
[[ $STATUS -eq 0 && "$STDOUT" == "$TEST_TMP/wear-docs" &&
  -f "$TEST_TMP/wear-docs/com/google/android/gms/wearable/NodeClient.html" &&
  ! -d "$TEST_TMP/wear-docs/META-INF" ]] && cond=1
check "javadoc extracts raw .html tree and removes META-INF" "$cond" \
  "status=$STATUS stdout=$STDOUT"

# 2. Inline <= 64 KiB --find prefers exact <Class>.html and cleans up $TMPDIR
rm -rf "${CLEAN_TMP:?}"/*
run_jetpack javadoc --find NodeClient com.google.android.gms:play-services-wearable
cond=0
[[ $STATUS -eq 0 && "$STDOUT" == *"<h1>NodeClient</h1>"* &&
  "$STDOUT" != *"OnNodeMigratedListener"* && -z "$(ls -A "$CLEAN_TMP")" ]] && cond=1
check "javadoc --find <=64 KiB prints exact class HTML inline and cleans TMPDIR" "$cond" \
  "status=$STATUS stdout=$STDOUT tmp=$(ls -A "$CLEAN_TMP")"

# 3. Oversized > 64 KiB --find retains temp HTML file and prints path + size note
rm -rf "${CLEAN_TMP:?}"/*
run_jetpack javadoc --find WearableListenerService com.google.android.gms:play-services-wearable
cond=0
[[ $STATUS -eq 0 && "$STDOUT" == "$CLEAN_TMP/"*"/WearableListenerService.html" &&
  -f "$STDOUT" && "$STDERR" == *"70000 bytes (> 65536 bytes)"* ]] && cond=1
check "javadoc --find >64 KiB retains HTML file and prints path with size notice" "$cond" \
  "status=$STATUS stdout=$STDOUT stderr=$STDERR"
rm -rf "${CLEAN_TMP:?}"/*

# 4. Slash-qualified --find matches path substrings without find -name warnings
run_jetpack javadoc --find wearable/Node com.google.android.gms:play-services-wearable
cond=0
[[ $STATUS -eq 0 && "$STDOUT" == *"NodeClient.html"* && "$STDERR" != *"warning:"* ]] && cond=1
check "javadoc --find supports slash-qualified path patterns" "$cond" \
  "status=$STATUS stdout=$STDOUT stderr=$STDERR"

# 5. Relative trailing-slash -o + Outer$Inner + Dackka /kotlin/ mirror deduplication
REL_OUT=$(cd "$TEST_TMP" && PATH="$SHIM_DIR:$PATH" "$ABS_JETPACK" javadoc -o rel-billing/ \
  --find "BillingClient\$Builder" com.android.billingclient:billing 2>"$TEST_TMP/rel.err")
REL_RC=$?
cond=0
[[ $REL_RC -eq 0 && "$REL_OUT" == *"<h1>BillingClient.Builder (Java)</h1>"* &&
  -f "$TEST_TMP/rel-billing/reference/com/android/billingclient/api/BillingClient.Builder.html" ]] && cond=1
check "javadoc handles relative trailing-slash -o, Outer\$Inner, and /kotlin/ deduplication" "$cond" \
  "rc=$REL_RC out=$REL_OUT"

# 6. Genuine kotlin/* package without a non-kotlin twin is preserved
run_jetpack javadoc --find RealKotlinPkgOnly com.android.billingclient:billing
cond=0
[[ $STATUS -eq 0 && "$STDOUT" == *"<h1>RealKotlinPkgOnly</h1>"* ]] && cond=1
check "javadoc preserves genuine kotlin/* package pages" "$cond" \
  "status=$STATUS stdout=$STDOUT"

# 7 & 8. JDK modular class-use/ cross-reference pages are skipped unless requested
run_jetpack javadoc --find Gson com.google.code.gson:gson
cond=0
[[ $STATUS -eq 0 && "$STDOUT" == *"<h1>Class Gson</h1>"* &&
  "$STDOUT" != *"Uses of Class Gson"* ]] && cond=1
check "javadoc --find skips JDK class-use/ pages by default" "$cond" \
  "status=$STATUS stdout=$STDOUT"

run_jetpack javadoc --find class-use/Gson com.google.code.gson:gson
cond=0
[[ $STATUS -eq 0 && "$STDOUT" == *"Uses of Class Gson"* ]] && cond=1
check "javadoc --find class-use/... locates cross-reference page when requested" "$cond" \
  "status=$STATUS stdout=$STDOUT"

# 9. Placeholder -javadoc.jar (0-byte index.html + boilerplate) fails and cleans TMPDIR
rm -rf "${CLEAN_TMP:?}"/*
run_jetpack javadoc com.google.firebase:firebase-analytics
cond=0
[[ $STATUS -eq 1 && "$STDERR" == *"contains no class documentation HTML pages"* &&
  -z "$(ls -A "$CLEAN_TMP")" ]] && cond=1
check "javadoc rejects placeholder -javadoc.jar and cleans TMPDIR" "$cond" \
  "status=$STATUS stderr=$STDERR tmp=$(ls -A "$CLEAN_TMP")"

# 10. `source` stays strict on 404, hints `javadoc`, and leaves --output clean
run_jetpack source --output "$TEST_TMP/src-404" com.google.android.gms:play-services-wearable
cond=0
[[ $STATUS -eq 1 && "$STDERR" == *"try 'jetpack javadoc com.google.android.gms:play-services-wearable 19.0.0'"* &&
  "$CURL_URLS" != *"-javadoc.jar"* && -z "$(ls -A "$TEST_TMP/src-404")" ]] && cond=1
check "source exits 1 on 404 with javadoc hint and no stray output" "$cond" \
  "status=$STATUS stderr=$STDERR urls=$CURL_URLS"

# 11. `inspect` falls back from -sources.jar 404 to -javadoc.jar for nested Outer.Inner
run_jetpack inspect com.google.android.gms.wearable.NodeClient.OnNodeMigratedListener
cond=0
[[ $STATUS -eq 0 && "$STDERR" == *"falling back to -javadoc.jar"* &&
  "$STDOUT" == *"DataItemBuffer closes on return."* ]] && cond=1
check "inspect falls back to -javadoc.jar on 404 for nested Outer.Inner" "$cond" \
  "status=$STATUS stderr=$STDERR stdout=$STDOUT"

# 12. `inspect` coordinate fallback leaves no stray 404 -sources.jar in --output
run_jetpack inspect --output "$TEST_TMP/inspect-coord" com.google.android.gms:play-services-wearable
cond=0
[[ $STATUS -eq 0 && "$STDOUT" == "$TEST_TMP/inspect-coord" &&
  -f "$TEST_TMP/inspect-coord/com/google/android/gms/wearable/NodeClient.html" &&
  ! -f "$TEST_TMP/inspect-coord/play-services-wearable-19.0.0-sources.jar" ]] && cond=1
check "inspect GROUP:ARTIFACT falls back to -javadoc.jar cleanly" "$cond" \
  "status=$STATUS stdout=$STDOUT"

# 13. `inspect` does NOT fall back to -javadoc.jar on transient HTTP 429
FORCE_STATUS=429 run_jetpack inspect com.google.android.gms:play-services-wearable 19.0.0
cond=0
[[ $STATUS -eq 1 && "$CURL_URLS" != *"-javadoc.jar"* ]] && cond=1
check "inspect does not fall back to -javadoc.jar on HTTP 429" "$cond" \
  "status=$STATUS urls=$CURL_URLS"

# 14. Offline `inspect` replays -javadoc.jar fallback with 0 HTTP requests
AGENT_OFFLINE=1 run_jetpack inspect "com.google.android.gms.wearable.NodeClient\$OnNodeMigratedListener"
cond=0
[[ $STATUS -eq 0 && "$CURL_CALLS" == "0" && "$STDERR" == *"falling back to -javadoc.jar"* &&
  "$STDOUT" == *"DataItemBuffer closes on return."* ]] && cond=1
check "offline inspect replays -javadoc.jar fallback for Outer\$Inner" "$cond" \
  "status=$STATUS calls=$CURL_CALLS stderr=$STDERR"

# 15. Cold-cache offline `inspect` quotes Outer$Inner safely without SNAPSHOT noise
COLD_CACHE="$TEST_TMP/cold_cache"
mkdir -p "$COLD_CACHE"
cp "$JETPACK_CACHE_DIR/androidx-index.json" "$COLD_CACHE/androidx-index.json"
COLD_ERR=$(AGENT_OFFLINE=1 JETPACK_CACHE_DIR="$COLD_CACHE" PATH="$SHIM_DIR:$PATH" \
  "$ABS_JETPACK" inspect "com.google.android.gms.wearable.NodeClient\$OnNodeMigratedListener" \
  2>&1 >/dev/null)
COLD_RC=$?
cond=0
[[ $COLD_RC -eq 1 && "$COLD_ERR" == *"'com.google.android.gms.wearable.NodeClient\$OnNodeMigratedListener'"* &&
  "$COLD_ERR" != *"not found"* && "$COLD_ERR" != *"SNAPSHOT"* ]] && cond=1
check "cold-cache offline inspect quotes Outer\$Inner without SNAPSHOT hint" "$cond" \
  "rc=$COLD_RC err=$COLD_ERR"

# 16. Open-source nested Outer.Inner and Outer$Inner resolve to enclosing Outer.kt
run_jetpack inspect androidx.lifecycle.Lifecycle.State
OUT_DOT="$STDOUT" RC_DOT=$STATUS
run_jetpack inspect "androidx.lifecycle.Lifecycle\$State"
cond=0
[[ $RC_DOT -eq 0 && $STATUS -eq 0 &&
  "$OUT_DOT" == *"enum class State { CREATED, STARTED, RESUMED }"* &&
  "$STDOUT" == *"enum class State { CREATED, STARTED, RESUMED }"* ]] && cond=1
check "inspect resolves nested Outer.Inner and Outer\$Inner to enclosing Outer.kt" "$cond" \
  "rc_dot=$RC_DOT rc_dollar=$STATUS"
