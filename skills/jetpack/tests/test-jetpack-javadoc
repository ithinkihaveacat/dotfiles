# 1. Google Maven closed-source Doclava SDK: play-services-wearable:19.0.0
#    (NO -sources.jar; has normal + nested + oversized >64 KiB HTML pages)
GMS_WEAR="$SERVE_DIR/dl.google.com/android/maven2/com/google/android/gms/play-services-wearable"
seed_metadata "$GMS_WEAR" "com.google.android.gms" "play-services-wearable" "19.0.0"

python3 - "$GMS_WEAR/19.0.0/play-services-wearable-19.0.0-javadoc.jar" <<'PY'
import sys, zipfile
jar_path = sys.argv[1]
with zipfile.ZipFile(jar_path, "w") as z:
    z.writestr("META-INF/MANIFEST.MF", "Manifest-Version: 1.0\n")
    z.writestr("client/wearable/packages.html", "<html><body>packages</body></html>\n")
    z.writestr(
        "com/google/android/gms/wearable/NodeClient.html",
        "<html><body><h1>NodeClient</h1><p>Top-level client contract.</p></body></html>\n",
    )
    z.writestr(
        "com/google/android/gms/wearable/NodeClient.OnNodeMigratedListener.html",
        "<html><body><h1>NodeClient.OnNodeMigratedListener</h1><p>DataItemBuffer closes on return.</p></body></html>\n",
    )
    # Exact 65536-byte boundary page (should still print inline)
    exact_prefix = "<html><body><h1>ExactBoundary</h1><p>"
    exact_suffix = "</p></body></html>\n"
    exact_body = exact_prefix + ("x" * (65536 - len(exact_prefix) - len(exact_suffix))) + exact_suffix
    assert len(exact_body.encode("utf-8")) == 65536
    z.writestr("com/google/android/gms/wearable/ExactBoundary.html", exact_body)
    # Oversized 70000-byte page (> 65536, should print path + stderr size info)
    big_prefix = "<html><body><h1>WearableListenerService</h1><p>"
    big_suffix = "</p><h2>Public Methods</h2><p>onDataChanged contract</p></body></html>\n"
    big_body = big_prefix + ("c" * (70000 - len(big_prefix) - len(big_suffix))) + big_suffix
    assert len(big_body.encode("utf-8")) == 70000
    z.writestr("com/google/android/gms/wearable/WearableListenerService.html", big_body)
PY

