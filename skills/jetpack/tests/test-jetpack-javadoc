# Stubbed curl serving from $SERVE_DIR and recording every URL to $CURL_LOG
cat >"$SHIM_DIR/curl" <<'SHIM'
#!/usr/bin/env bash
out=""
url=""
prev=""
for a in "$@"; do
  case "$prev" in
    -o) out="$a" ;;
  esac
  prev="$a"
  case "$a" in
    http://* | https://*) url="$a" ;;
  esac
done
printf '%s\n' "$url" >>"$CURL_LOG"

if [[ -n "${FORCE_STATUS:-}" ]]; then
  [[ -n "$out" ]] && printf 'forced error body' >"$out"
  if [[ "$FORCE_STATUS" == "000" ]]; then
    printf '000'
    exit 7
  fi
  printf '%s' "$FORCE_STATUS"
  exit 0
fi

rel="${url#*://}"
if [[ -f "$SERVE_DIR/$rel" ]]; then
  [[ -n "$out" ]] && cp "$SERVE_DIR/$rel" "$out"
  printf '200'
  exit 0
else
  [[ -n "$out" ]] && printf '<html>404 Not Found</html>' >"$out"
  printf '404'
  exit 0
fi
SHIM
chmod +x "$SHIM_DIR/curl"

export SERVE_DIR CURL_LOG

run_shimmed() {
  : >"$CURL_LOG"
  local err_file="$TEST_TMP/stderr.tmp"
  STDOUT=$(PATH="$SHIM_DIR:$PATH" "$BIN_JETPACK" "$@" 2>"$err_file")
  STATUS=$?
  STDERR=$(cat "$err_file")
  rm -f "$err_file"
  CURL_CALLS=$(wc -l <"$CURL_LOG" | tr -d ' ')
  CURL_URLS=$(cat "$CURL_LOG")
}

