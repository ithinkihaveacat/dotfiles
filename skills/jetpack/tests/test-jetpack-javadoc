# --- 6. `jetpack source` hint vs. `jetpack inspect` automatic fallback ------

run_shimmed source --output "$TEST_TMP/src-404" com.google.android.gms:play-services-wearable
assert_status "jetpack source exits 1 when -sources.jar returns HTTP 404" "$STATUS" 1
assert_contains "jetpack source prints hint pointing to jetpack javadoc" \
  "$STDERR" "try 'jetpack javadoc com.google.android.gms:play-services-wearable 19.0.0'"
assert_not_contains "jetpack source never fetches -javadoc.jar" "$CURL_URLS" "-javadoc.jar"
if [[ -z "$(ls -A "$TEST_TMP/src-404")" ]]; then
  ok "failed jetpack source leaves no stray 404 body file in --output"
else
  not_ok "failed jetpack source leaves no stray 404 body file in --output" \
    "Stray files: $(ls -A "$TEST_TMP/src-404")"
fi

run_shimmed inspect com.google.android.gms.wearable.NodeClient.OnNodeMigratedListener
assert_status "inspect nested Outer.Inner falls back from 404 -sources.jar to -javadoc.jar" "$STATUS" 0
assert_contains "inspect logs fallback provenance notice on stderr" \
  "$STDERR" "no -sources.jar published for com.google.android.gms:play-services-wearable; falling back to -javadoc.jar"
assert_contains "inspect prints nested Javadoc HTML contract" \
  "$STDOUT" "DataItemBuffer closes on return."

run_shimmed inspect "com.google.android.gms.wearable.NodeClient\$OnNodeMigratedListener"
assert_status "inspect nested Outer\$Inner falls back to -javadoc.jar" "$STATUS" 0
assert_contains "inspect Outer\$Inner prints nested Javadoc HTML contract" \
  "$STDOUT" "DataItemBuffer closes on return."

run_shimmed inspect --output "$TEST_TMP/inspect-coord" com.google.android.gms:play-services-wearable
assert_status "inspect GROUP:ARTIFACT without --find falls back to -javadoc.jar" "$STATUS" 0
assert_equals "inspect GROUP:ARTIFACT prints extracted Javadoc directory" \
  "$STDOUT" "$TEST_TMP/inspect-coord"
if [[ -f "$TEST_TMP/inspect-coord/com/google/android/gms/wearable/NodeClient.html" &&
  ! -f "$TEST_TMP/inspect-coord/play-services-wearable-19.0.0-sources.jar" ]]; then
  ok "inspect GROUP:ARTIFACT directory has HTML docs and no stray 404 -sources.jar"
else
  not_ok "inspect GROUP:ARTIFACT directory has HTML docs and no stray 404 -sources.jar" \
    "Unexpected contents in $TEST_TMP/inspect-coord"
fi

run_shimmed inspect --output "$TEST_TMP/inspect-big" \
  com.google.android.gms.wearable.WearableListenerService
assert_status "inspect oversized closed-source class exits 0" "$STATUS" 0
assert_equals "inspect oversized closed-source class prints HTML file path" \
  "$STDOUT" "$TEST_TMP/inspect-big/com/google/android/gms/wearable/WearableListenerService.html"
assert_contains "inspect oversized closed-source class logs size notice" \
  "$STDERR" "printing path instead of contents"

# Guardrail: HTTP 429 on -sources.jar must NOT trigger -javadoc.jar fallback
FORCE_STATUS=429 run_shimmed inspect com.google.android.gms:play-services-wearable 19.0.0
assert_status "HTTP 429 during inspect fails without falling back to javadoc" "$STATUS" 1
assert_not_contains "HTTP 429 never touches -javadoc.jar" "$CURL_URLS" "-javadoc.jar"

