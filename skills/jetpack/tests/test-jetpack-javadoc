  "$STDERR" "printing path instead of contents"

run_shimmed javadoc --output "$TEST_TMP/wear-big" --find WearableListenerService \
  com.google.android.gms:play-services-wearable
assert_status "javadoc --find on >64 KiB HTML page exits 0" "$STATUS" 0
