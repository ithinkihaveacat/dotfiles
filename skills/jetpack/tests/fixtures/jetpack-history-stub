#!/usr/bin/env bash

set -u

SCRIPT_NAME=$(basename "$0")

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$SCRIPT_NAME: $1 not found"
    exit 127
  }
}

require mkdir

if [[ $# -ne 5 || $1 != "source" || $2 != "androidx.wear.compose:compose-material3" || $4 != "--output" ]]; then
  echo "$SCRIPT_NAME: unexpected invocation: $*" >&2
  exit 1
fi

VERSION=$3
OUTPUT=$5
SOURCE_DIR="$OUTPUT/androidx/wear/compose/material3/onehandedgesture"

mkdir -p "$OUTPUT"
case "$VERSION" in
  1.7.0-alpha0[1-5])
    ;;
  1.7.0-alpha0[6-7])
    mkdir -p "$SOURCE_DIR"
    printf '%s\n' \
      'package androidx.wear.compose.material3.onehandedgesture' \
      'public fun rememberOneHandedGestureConfiguration() = Unit' \
      >"$SOURCE_DIR/OneHandedGestureConfiguration.kt"
    ;;
  *)
    echo "$SCRIPT_NAME: unexpected version: $VERSION" >&2
    exit 1
    ;;
esac

printf '%s\n' "$OUTPUT"
