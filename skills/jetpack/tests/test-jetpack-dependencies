#!/usr/bin/env bash
#
# Tests for bin/jetpack dependencies subcommand

set -u

# Setup paths
SCRIPT_DIR=$(dirname "$0")
ROOT_DIR="$SCRIPT_DIR/.."
BIN_JETPACK="$ROOT_DIR/scripts/jetpack"

# Total number of tests
TOTAL_TESTS=1
TEST_NUM=0

echo "1..$TOTAL_TESTS"

TEST_NUM=$((TEST_NUM + 1))

# Execute dependencies list check
err_file=$(mktemp)
DEPS_OUTPUT=$("$BIN_JETPACK" list dependencies androidx.wear.tiles:tiles STABLE 2>"$err_file" || true)
err_msg=$(cat "$err_file")
rm -f "$err_file"
DEPS_COUNT=$(printf '%s\n' "$DEPS_OUTPUT" | grep -c . || true)

if [ "$DEPS_COUNT" -gt 0 ]; then
  echo "ok $TEST_NUM - dependencies lists dependencies correctly (found $DEPS_COUNT)"
elif [[ "${AGENT_OFFLINE:-}" == "1" || "${JETPACK_OFFLINE:-}" == "1" ]] && [[ "$err_msg" == *"offline"* ]]; then
  echo "ok $TEST_NUM - dependencies lists dependencies correctly # SKIP cold cache in offline mode"
elif [[ "$err_msg" == *"could not reach"* ]]; then
  echo "ok $TEST_NUM - dependencies lists dependencies correctly # SKIP network unavailable"
else
  echo "not ok $TEST_NUM - dependencies lists dependencies correctly (found 0)"
  [ -n "$err_msg" ] && echo "# Stderr: $err_msg"
fi
