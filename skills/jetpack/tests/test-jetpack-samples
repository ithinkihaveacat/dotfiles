#!/usr/bin/env bash
#
# Tests for bin/jetpack-samples

set -u

SCRIPT_DIR=$(dirname "$0")
ROOT_DIR="$SCRIPT_DIR/.."
BIN_JETPACK_SAMPLES="$ROOT_DIR/scripts/jetpack-samples"

TOTAL_TESTS=10
TEST_NUM=0

echo "1..$TOTAL_TESTS"

run_test() {
  local artifact="$1"
  TEST_NUM=$((TEST_NUM + 1))

  if [[ "${AGENT_OFFLINE:-}" == "1" ]]; then
    echo "ok $TEST_NUM - samples module for $artifact # SKIP offline mode (AGENT_OFFLINE=1)"
    return 0
  fi

  OUT_DIR=$(mktemp -d)
  local log_file
  log_file=$(mktemp)

  if "$BIN_JETPACK_SAMPLES" "$artifact" --output "$OUT_DIR" >"$log_file" 2>&1; then
    if [ ! "$(ls -A "$OUT_DIR")" ]; then
      echo "not ok $TEST_NUM - no files in output dir for $artifact"
      sed 's/^/# /' "$log_file"
    elif [ "$(find "$OUT_DIR" -type d -name "src" | wc -l)" -eq 0 ]; then
      echo "not ok $TEST_NUM - no 'src' directories found for $artifact"
      sed 's/^/# /' "$log_file"
    elif [ "$(find "$OUT_DIR" -name "build.gradle" -o -name "build.gradle.kts" | wc -l)" -eq 0 ]; then
      echo "not ok $TEST_NUM - no build.gradle files found (failed to download complete module archive) for $artifact"
      sed 's/^/# /' "$log_file"
    else
      echo "ok $TEST_NUM - successfully extracted complete samples module for $artifact"
    fi
  else
    if grep -Eq "returned HTTP (503|429)|could not reach" "$log_file"; then
      echo "ok $TEST_NUM - samples module for $artifact # SKIP remote service unavailable or rate limited"
      sed 's/^/# /' "$log_file"
    else
      echo "not ok $TEST_NUM - failed to run jetpack-samples for $artifact"
      sed 's/^/# /' "$log_file"
    fi
  fi
  rm -f "$log_file"
  rm -rf "$OUT_DIR"
}

run_test "androidx.compose.remote:remote-creation-compose"

# Test invalid artifact
TEST_NUM=$((TEST_NUM + 1))
log_file=$(mktemp)
if ! "$BIN_JETPACK_SAMPLES" "invalid-artifact" >"$log_file" 2>&1; then
  echo "ok $TEST_NUM - failed on invalid artifact"
else
  echo "not ok $TEST_NUM - accepted invalid artifact"
  sed 's/^/# /' "$log_file"
fi
rm -f "$log_file"

# ---- Offline mode and network-failure reporting -----------------------------
#
# These cases are hermetic: the offline one makes no call at all, and the rest
# put a stub 'curl' ahead of the real one on PATH so a given transport outcome
# can be forced without depending on the machine's network. What is under test
# is the message, not the fetch: a request that never reached a server, one
# answered with 404, and one answered with 429 are three different facts and
# must not be reported the same way (caching.md, "Scope: Three Obligations").

SHIM_DIR=$(mktemp -d)
trap 'rm -rf "$SHIM_DIR"' EXIT

make_curl_shim() {
  # $1: shell body for the stub curl
  cat >"$SHIM_DIR/curl" <<EOF
#!/bin/sh
$1
EOF
  chmod +x "$SHIM_DIR/curl"
}

# 1. Offline declared: fails naming the switch, without reaching for curl at all
#    (no shim is installed here, so any call would use the real network).
TEST_NUM=$((TEST_NUM + 1))
log_file=$(mktemp)
if AGENT_OFFLINE=1 "$BIN_JETPACK_SAMPLES" androidx.wear.tiles:tiles >"$log_file" 2>&1; then
  echo "not ok $TEST_NUM - succeeded while offline"
  sed 's/^/# /' "$log_file"
elif grep -q "offline (AGENT_OFFLINE=1)" "$log_file"; then
  echo "ok $TEST_NUM - offline mode names the switch in force"
else
  echo "not ok $TEST_NUM - offline failure did not name AGENT_OFFLINE"
  sed 's/^/# /' "$log_file"
fi
rm -f "$log_file"

# 2. AGENT_OFFLINE=0 allows the tool to run when offline policy is disabled.
TEST_NUM=$((TEST_NUM + 1))
make_curl_shim "exit 6"
log_file=$(mktemp)
if AGENT_OFFLINE=0 PATH="$SHIM_DIR:$PATH" \
  "$BIN_JETPACK_SAMPLES" androidx.wear.tiles:tiles >"$log_file" 2>&1; then
  echo "not ok $TEST_NUM - unexpectedly succeeded against a failing curl"
  sed 's/^/# /' "$log_file"
elif grep -q "could not reach" "$log_file"; then
  echo "ok $TEST_NUM - AGENT_OFFLINE=0 reaches the network path"
else
  echo "not ok $TEST_NUM - AGENT_OFFLINE=0 did not reach the network path"
  sed 's/^/# /' "$log_file"
fi
rm -f "$log_file"

# 3. No response at all is reported as a network failure, not an empty result.
# Clean baseline for the curl-shim transport tests: these cases test curl error
# code handling and must not be aborted early by an inherited AGENT_OFFLINE.
unset AGENT_OFFLINE
TEST_NUM=$((TEST_NUM + 1))
make_curl_shim "exit 6"
log_file=$(mktemp)
PATH="$SHIM_DIR:$PATH" "$BIN_JETPACK_SAMPLES" androidx.wear.tiles:tiles \
  >"$log_file" 2>&1
if grep -q "could not reach" "$log_file" && ! grep -q "no files found" "$log_file"; then
  echo "ok $TEST_NUM - unreachable network is not reported as 'no files found'"
else
  echo "not ok $TEST_NUM - network failure misreported"
  sed 's/^/# /' "$log_file"
fi
rm -f "$log_file"

# 4. A 404 is the resource being absent, and still reads that way.
TEST_NUM=$((TEST_NUM + 1))
# Single-quoted on purpose: this is the stub's source, to be expanded when the
# stub runs, not when this test builds it.
# shellcheck disable=SC2016
make_curl_shim 'for a in "$@"; do case "$prev" in -o) out="$a";; esac; prev="$a"; done
: > "$out"
printf 404'
log_file=$(mktemp)
PATH="$SHIM_DIR:$PATH" "$BIN_JETPACK_SAMPLES" androidx.wear.tiles:tiles \
  >"$log_file" 2>&1
if grep -q "no files found" "$log_file" && grep -q "HTTP 404" "$log_file"; then
  echo "ok $TEST_NUM - a 404 is reported as an absent path, naming the status"
else
  echo "not ok $TEST_NUM - 404 misreported"
  sed 's/^/# /' "$log_file"
fi
rm -f "$log_file"

# 5. A 429 or 5xx is the server declining to answer, not the artifact being
#    absent. Reporting it as "no files found" would tell a caller this library
#    ships no samples on the strength of a rate limit.
TEST_NUM=$((TEST_NUM + 1))
# shellcheck disable=SC2016  # stub source, expanded when the stub runs
make_curl_shim 'for a in "$@"; do case "$prev" in -o) out="$a";; esac; prev="$a"; done
[ -n "$out" ] && : > "$out"
printf 429'
log_file=$(mktemp)
PATH="$SHIM_DIR:$PATH" "$BIN_JETPACK_SAMPLES" androidx.wear.tiles:tiles \
  >"$log_file" 2>&1
if grep -q "HTTP 429" "$log_file" && ! grep -q "no files found" "$log_file"; then
  echo "ok $TEST_NUM - a 429 is not reported as an absent path"
else
  echo "not ok $TEST_NUM - 429 misreported as absence"
  sed 's/^/# /' "$log_file"
fi
rm -f "$log_file"

# 6. Version specified both in artifact coordinate and argument fails.
TEST_NUM=$((TEST_NUM + 1))
log_file=$(mktemp)
if ! "$BIN_JETPACK_SAMPLES" "androidx.wear.tiles:tiles:1.0.0" "1.0.0" >"$log_file" 2>&1; then
  if grep -q "version specified both in artifact coordinate and as argument" "$log_file"; then
    echo "ok $TEST_NUM - version specified in both formats is rejected"
  else
    echo "not ok $TEST_NUM - rejected duplicate version with unexpected message"
    sed 's/^/# /' "$log_file"
  fi
else
  echo "not ok $TEST_NUM - accepted version specified in both formats"
  sed 's/^/# /' "$log_file"
fi
rm -f "$log_file"

# 7. Unparseable release notes error immediately and advise omitting version.
TEST_NUM=$((TEST_NUM + 1))
# shellcheck disable=SC2016
make_curl_shim '
for a in "$@"; do case "$prev" in -o) out="$a";; esac; prev="$a"; url="$a"; done
if [[ "$url" =~ \.pom$ ]]; then
  echo "<project><url>https://developer.android.com/jetpack/androidx/releases/tiles</url></project>" > "$out"
  printf 200
elif [[ "$url" =~ releases/tiles ]]; then
  echo "<html><body><h1>Tiles Release</h1><p>No commits link here</p></body></html>" > "$out"
  printf 200
else
  : > "$out"
  printf 404
fi'
log_file=$(mktemp)
PATH="$SHIM_DIR:$PATH" "$BIN_JETPACK_SAMPLES" androidx.wear.tiles:tiles 1.0.0 \
  >"$log_file" 2>&1 || true
if grep -q "could not resolve commit SHA for version 1.0.0" "$log_file" &&
  grep -q "fetching 'latest' samples" "$log_file"; then
  echo "ok $TEST_NUM - unparseable release notes fail fast and suggest omitting version"
else
  echo "not ok $TEST_NUM - unparseable release notes error misreported"
  sed 's/^/# /' "$log_file"
fi
rm -f "$log_file"

# 8. Successful versioned SHA resolution and sample download via direct probe.
TEST_NUM=$((TEST_NUM + 1))
MOCK_TAR=$(mktemp)
(
  MOCK_SRC=$(mktemp -d)
  mkdir -p "$MOCK_SRC/src"
  touch "$MOCK_SRC/build.gradle"
  tar -czf "$MOCK_TAR" -C "$MOCK_SRC" .
  rm -rf "$MOCK_SRC"
)
# shellcheck disable=SC2016
make_curl_shim '
for a in "$@"; do case "$prev" in -o) out="$a";; esac; prev="$a"; url="$a"; done
if [[ "$url" =~ \.pom$ ]]; then
  echo "<project><url>https://developer.android.com/jetpack/androidx/releases/tiles</url></project>" > "$out"
  printf 200
elif [[ "$url" =~ releases/tiles ]]; then
  echo "Version 1.0.0 contains [these commits](https://android.googlesource.com/platform/frameworks/support/+log/111111..abcdef1234567890abcdef1234567890abcdef12/tiles)." > "$out"
  printf 200
elif [[ "$url" =~ \?format=JSON$ ]]; then
  echo "{}" > "$out"
  printf 200
elif [[ "$url" =~ \.tar\.gz$ ]]; then
  cat '"$MOCK_TAR"' > "$out"
  printf 200
else
  : > "$out"
  printf 404
fi'
log_file=$(mktemp)
MOCK_OUT=$(mktemp -d)
if PATH="$SHIM_DIR:$PATH" "$BIN_JETPACK_SAMPLES" androidx.wear.tiles:tiles 1.0.0 --output "$MOCK_OUT" \
  >"$log_file" 2>&1; then
  if grep -q "Resolved androidx.wear.tiles:tiles 1.0.0 -> commit abcdef1234567890abcdef1234567890abcdef12" "$log_file" &&
    [ -d "$MOCK_OUT/wear/tiles/tiles/samples/src" ] && [ -f "$MOCK_OUT/wear/tiles/tiles/samples/build.gradle" ]; then
    echo "ok $TEST_NUM - successfully resolved version SHA and extracted samples via probe"
  else
    echo "not ok $TEST_NUM - versioned extraction missing files or commit log"
    sed 's/^/# /' "$log_file"
  fi
else
  echo "not ok $TEST_NUM - versioned extraction failed"
  sed 's/^/# /' "$log_file"
fi
rm -f "$log_file" "$MOCK_TAR"
rm -rf "$MOCK_OUT"
