#!/usr/bin/env bash
#
# Tests for bin/jetpack inspect subcommand

set -u

# Setup paths
SCRIPT_DIR=$(dirname "$0")
ROOT_DIR="$SCRIPT_DIR/.."
BIN_JETPACK="$ROOT_DIR/scripts/jetpack"

# Temporary directory for downloads
TEST_TMP=$(mktemp -d)
trap 'rm -rf "$TEST_TMP"' EXIT

# Total number of tests
TOTAL_TESTS=7
TEST_NUM=0

echo "1..$TOTAL_TESTS"

run_test() {
  local args="$1"
  local description="$2"

  TEST_NUM=$((TEST_NUM + 1))

  # Run in subshell to capture exit code
  # We use a unique output dir for each test to avoid conflicts
  # shellcheck disable=SC2086  # Intended word splitting for test arguments
  if "$BIN_JETPACK" inspect --output "$TEST_TMP/$TEST_NUM" $args >"$TEST_TMP/out.$TEST_NUM" 2>&1; then
    echo "ok $TEST_NUM - $description"
  else
    echo "not ok $TEST_NUM - $description"
    echo "# Command failed: $BIN_JETPACK inspect $args"
    cat "$TEST_TMP/out.$TEST_NUM" | sed 's/^/# /'
  fi
}

run_test_warning() {
  local args="$1"
  local expected_warning="$2"
  local description="$3"

  TEST_NUM=$((TEST_NUM + 1))

  # shellcheck disable=SC2086  # Intended word splitting for test arguments
  if "$BIN_JETPACK" inspect --output "$TEST_TMP/$TEST_NUM" $args >"$TEST_TMP/out.$TEST_NUM" 2>&1; then
    if grep -Fq "$expected_warning" "$TEST_TMP/out.$TEST_NUM"; then
      echo "ok $TEST_NUM - $description"
    else
      echo "not ok $TEST_NUM - $description (warning not found: $expected_warning)"
      cat "$TEST_TMP/out.$TEST_NUM" | sed 's/^/# /'
    fi
  else
    echo "not ok $TEST_NUM - $description"
    echo "# Command failed: $BIN_JETPACK inspect $args"
    cat "$TEST_TMP/out.$TEST_NUM" | sed 's/^/# /'
  fi
}

run_test_failure_with_hint() {
  local args="$1"
  local expected_hint="$2"
  local description="$3"

  TEST_NUM=$((TEST_NUM + 1))

  # shellcheck disable=SC2086  # Intended word splitting for test arguments
  if ! "$BIN_JETPACK" inspect --output "$TEST_TMP/$TEST_NUM" $args >"$TEST_TMP/out.$TEST_NUM" 2>&1; then
    if grep -Fq "$expected_hint" "$TEST_TMP/out.$TEST_NUM"; then
      echo "ok $TEST_NUM - $description"
    else
      echo "not ok $TEST_NUM - $description (hint not found: $expected_hint)"
      cat "$TEST_TMP/out.$TEST_NUM" | sed 's/^/# /'
    fi
  else
    echo "not ok $TEST_NUM - $description (expected command to fail)"
    cat "$TEST_TMP/out.$TEST_NUM" | sed 's/^/# /'
  fi
}

# The failing test case reported by user
run_test "androidx.lifecycle.ViewModel" "inspect androidx.lifecycle.ViewModel should succeed"

# Additional examples from help
run_test "androidx.core.splashscreen.SplashScreen" "inspect androidx.core.splashscreen.SplashScreen"
run_test "androidx.wear.tiles:tiles" "inspect androidx.wear.tiles:tiles (coordinate)"
run_test "androidx.wear.ambient.AmbientLifecycleObserver" "inspect androidx.wear.ambient.AmbientLifecycleObserver"

# Pinned version test
# shellcheck disable=SC2086
run_test "androidx.lifecycle.ViewModel 2.8.7" "inspect androidx.lifecycle.ViewModel 2.8.7 (pinned)"

# Missing package and class in STABLE checks
# shellcheck disable=SC2086
run_test_warning "androidx.wear.compose.material3.onehandedgesture" "was not found in STABLE of androidx.wear.compose:compose-material3" "inspect missing package in STABLE emits warning"
# shellcheck disable=SC2086
run_test_failure_with_hint "androidx.wear.compose.material3.onehandedgesture.OneHandedGestureManager" "was not found in STABLE; it may be in a newer pre-release track; try:" "inspect missing class in STABLE fails and emits hint"
