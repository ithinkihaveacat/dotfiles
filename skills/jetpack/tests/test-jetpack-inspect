#!/usr/bin/env bash
#
# Hermetic tests for bin/jetpack inspect subcommand (offline seeded cache).

set -u

SCRIPT_DIR=$(dirname "$0")
ROOT_DIR="$SCRIPT_DIR/.."
BIN_JETPACK="$ROOT_DIR/scripts/jetpack"

TEST_TMP=$(mktemp -d)
trap 'rm -rf "$TEST_TMP"' EXIT
export XDG_CACHE_HOME="$TEST_TMP/cache"
export JETPACK_CACHE_DIR="$TEST_TMP/cache/jetpack"
export TMPDIR="$TEST_TMP"
export AGENT_OFFLINE=1

TOTAL_TESTS=5
TEST_NUM=0
echo "1..$TOTAL_TESTS"

mkdir -p "$JETPACK_CACHE_DIR"
cat >"$JETPACK_CACHE_DIR/androidx-index.json" <<'EOF'
{
  "Index": [
    {
      "groupId": "androidx.lifecycle",
      "artifactId": "lifecycle-viewmodel",
      "version": "2.8.7",
      "fqcns": []
    },
    {
      "groupId": "androidx.lifecycle",
      "artifactId": "lifecycle-viewmodel-android",
      "version": "2.8.7",
      "fqcns": [
        "androidx.lifecycle.ViewModel"
      ]
    },
    {
      "groupId": "androidx.wear.tiles",
      "artifactId": "tiles",
      "version": "1.4.0",
      "fqcns": [
        "androidx.wear.tiles.TileService"
      ]
    },
    {
      "groupId": "androidx.wear.compose",
      "artifactId": "compose-material3",
      "version": "1.0.0",
      "fqcns": [
        "androidx.wear.compose.material3.Button",
        "androidx.wear.compose.material3.futurepkg.FutureFeature"
      ]
    }
  ]
}
EOF

seed_artifact() {
  local group="$1" artifact="$2" version="$3" rel_src="$4" src_body="$5"
  local gpath="${group//./\/}"
  local base="$JETPACK_CACHE_DIR/http/dl.google.com/android/maven2/$gpath/$artifact"
  mkdir -p "$base/$version" "$TEST_TMP/src/$(dirname "$rel_src")"
  cat >"$base/maven-metadata.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<metadata>
  <groupId>$group</groupId>
  <artifactId>$artifact</artifactId>
  <versioning>
    <latest>$version</latest>
    <release>$version</release>
    <versions><version>$version</version></versions>
  </versioning>
</metadata>
EOF
  cat >"$base/$version/$artifact-$version.pom" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<project>
  <groupId>$group</groupId>
  <artifactId>$artifact</artifactId>
  <version>$version</version>
</project>
EOF
  printf '%s\n' "$src_body" >"$TEST_TMP/src/$rel_src"
  python3 - "$TEST_TMP/src" "$base/$version/$artifact-$version-sources.jar" "$rel_src" <<'PY'
import os, sys, zipfile
root, jar_path, rel = sys.argv[1:4]
with zipfile.ZipFile(jar_path, "w") as z:
    z.write(os.path.join(root, rel), rel)
PY
  rm -rf "$TEST_TMP/src"
}

seed_artifact "androidx.lifecycle" "lifecycle-viewmodel" "2.8.7" \
  "androidx/lifecycle/ViewModel.kt" "public abstract class ViewModel"
seed_artifact "androidx.wear.tiles" "tiles" "1.4.0" \
  "androidx/wear/tiles/TileService.java" "public abstract class TileService {}"
seed_artifact "androidx.wear.compose" "compose-material3" "1.0.0" \
  "androidx/wear/compose/material3/Button.kt" "public fun Button() = Unit"

run_inspect() {
  local description="$1" expected_rc="$2" expected_out="$3"
  shift 3
  TEST_NUM=$((TEST_NUM + 1))
  local out_file="$TEST_TMP/out.$TEST_NUM" rc=0
  "$BIN_JETPACK" inspect --output "$TEST_TMP/work.$TEST_NUM" "$@" >"$out_file" 2>&1 || rc=$?
  if [[ "$rc" -eq "$expected_rc" ]] && grep -Fq "$expected_out" "$out_file"; then
    echo "ok $TEST_NUM - $description"
  else
    echo "not ok $TEST_NUM - $description (rc=$rc, expected $expected_rc)"
    sed 's/^/# /' "$out_file"
  fi
}

run_inspect "inspect FQCN resolves and prints class source" 0 \
  "public abstract class ViewModel" "androidx.lifecycle.ViewModel"

run_inspect "inspect Maven coordinate extracts sources" 0 \
  "$TEST_TMP/work.2" "androidx.wear.tiles:tiles"

run_inspect "inspect FQCN with pinned version extracts sources" 0 \
  "public abstract class ViewModel" "androidx.lifecycle.ViewModel" "2.8.7"

run_inspect "inspect missing package in STABLE emits warning" 0 \
  "was not found in STABLE of androidx.wear.compose:compose-material3" \
  "androidx.wear.compose.material3.futurepkg"

run_inspect "inspect missing class in STABLE fails with SNAPSHOT hint" 1 \
  "was not found in STABLE; it may be in a newer pre-release track; try:" \
  "androidx.wear.compose.material3.futurepkg.FutureFeature"
