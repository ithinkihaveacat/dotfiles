#!/usr/bin/env bash

# jetpack-samples - Extract reference files for inspection
#
# Usage: jetpack-samples ARTIFACT [--output DIR]

set -euo pipefail

if ((BASH_VERSINFO[0] < 4)); then
  echo "$(basename "$0"): requires bash 4.0 or higher (found ${BASH_VERSION})" >&2
  exit 1
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

# Verify external dependencies. Deferred until after the --help check so that
# --help works even when dependencies are absent.
check_deps() {
  require curl
  require jq
  require perl
}

usage() {
  cat <<EOF
Usage: $(basename "$0") ARTIFACT [VERSION] [OPTIONS]

Extract reference files (samples and integration tests) from the AndroidX 
source repository for inspection.

Arguments:
  ARTIFACT       The Maven coordinate of the Jetpack library (e.g., androidx.compose.remote:remote-creation-compose).
                 Can also include version (e.g., androidx.wear.compose:compose-material3:1.7.0).
  VERSION        Optional version or release tier to extract (e.g., 1.7.0, 1.7.0-rc01,
                 STABLE, RC, BETA, ALPHA). If omitted, samples are extracted from
                 the latest development tree (androidx-main).

Options:
  --output DIR   Directory where extracted files will be downloaded.
                 If omitted, a temporary directory is used.
  --help         Display this help message and exit

Environment:
  AGENT_OFFLINE  Refuse to use the network. This tool caches nothing,
                 so offline mode fails immediately rather than
                 serving a stale answer.

Examples:
  $(basename "$0") androidx.compose.remote:remote-creation-compose
  $(basename "$0") androidx.wear.compose:compose-material3 1.7.0-rc01
  $(basename "$0") androidx.wear.compose:compose-material3 STABLE --output ./my-samples
EOF
  exit 0
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
  usage
fi

check_deps

ARTIFACT=""
VERSION=""
OUTPUT_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output)
      if [[ -z "${2:-}" ]]; then
        echo "$(basename "$0"): option '--output' requires an argument" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
      fi
      OUTPUT_DIR="$2"
      shift 2
      ;;
    -*)
      echo "$(basename "$0"): unknown option: $1" >&2
      echo "Try '$(basename "$0") --help' for more information." >&2
      exit 1
      ;;
    *)
      if [[ -z "$ARTIFACT" ]]; then
        ARTIFACT="$1"
      elif [[ -z "$VERSION" ]]; then
        VERSION="$1"
      else
        echo "$(basename "$0"): too many arguments" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ -z "$ARTIFACT" ]]; then
  echo "$(basename "$0"): missing artifact operand" >&2
  echo "Try '$(basename "$0") --help' for more information." >&2
  exit 1
fi

if [[ "$ARTIFACT" =~ ^([^:]+):([^:]+):([^:]+)$ ]]; then
  if [[ -n "$VERSION" ]]; then
    echo "$(basename "$0"): version specified both in artifact coordinate and as argument" >&2
    echo "Try '$(basename "$0") --help' for more information." >&2
    exit 1
  fi
  VERSION="${BASH_REMATCH[3]}"
  ARTIFACT="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
fi

if [[ ! "$ARTIFACT" =~ ^[^:]+:[^:]+$ ]]; then
  echo "$(basename "$0"): invalid artifact format '$ARTIFACT' (expected GROUP_ID:ARTIFACT_ID)" >&2
  echo "Try '$(basename "$0") --help' for more information." >&2
  exit 1
fi

GROUP_ID=$(echo "$ARTIFACT" | cut -d: -f1)
ARTIFACT_ID=$(echo "$ARTIFACT" | cut -d: -f2)
DERIVED_PATH=$(echo "$GROUP_ID" | sed 's/^androidx\.//' | sed 's/\./\//g')

is_offline() {
  case "$(echo "${AGENT_OFFLINE:-}" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | on) return 0 ;;
    *) return 1 ;;
  esac
}

# This tool caches nothing -- it extracts a fresh copy of the AndroidX tree into
# a directory the caller names -- so every offline invocation is a miss. Checked
# before the output directory is created, so a run that cannot proceed leaves
# nothing behind (the cleanup trap below is on ERR, which an explicit exit does
# not fire), and before any fetch, so the retry budget is not spent on calls the
# environment has already forbidden.
if is_offline; then
  echo "$(basename "$0"): offline (AGENT_OFFLINE=${AGENT_OFFLINE:-}) and no cached copy of the AndroidX source tree" >&2
  echo "$(basename "$0"): run this where there is network:" >&2
  echo "  $(basename "$0") $ARTIFACT" >&2
  exit 1
fi

CLEANUP_ON_FAILURE=false
if [[ -z "$OUTPUT_DIR" ]]; then
  OUTPUT_DIR=$(mktemp -d "${TMPDIR:-/tmp}/jetpack-samples.XXXXXXXXXX")
  CLEANUP_ON_FAILURE=true
fi

mkdir -p "$OUTPUT_DIR"

trap_failure() {
  if [[ "$CLEANUP_ON_FAILURE" == "true" ]]; then
    rm -rf "$OUTPUT_DIR"
  fi
}
trap trap_failure ERR

CURL_RETRY_OPTS=(--retry 5 --retry-delay 4 --retry-all-errors --retry-connrefused
  --connect-timeout 10)

# http_get URL OUTFILE -- write the response body to OUTFILE.
#
# Reads the status via -w '%{http_code}' rather than trusting curl's exit code,
# which does not reliably separate an HTTP-level error from a transport one: the
# status is "000" only when no response was received at all. Sets HTTP_ERROR for
# the caller's message.
#
# Exit codes:
#   0  body available
#   1  the resource is genuinely absent (404/410)
#   2  no response at all (network unreachable, DNS failure, blocked egress)
#   3  the server answered, but with an error that says nothing about whether
#      the resource exists (429, 5xx, 403...)
#
# 1 and 3 are separate because only the first is evidence of absence. Folding
# them together lets a rate-limited or briefly-broken Gitiles read as "this
# artifact has no samples", which is the confidently-wrong answer this whole
# path exists to avoid.
http_get() {
  local url="$1" outfile="$2" curl_status=0 status
  HTTP_ERROR=""

  status=$(curl -sSL "${CURL_RETRY_OPTS[@]}" -o "$outfile" \
    -w '%{http_code}' "$url" 2>/dev/null) || curl_status=$?

  # Classify by status first: -w emits three digits whenever a response arrived
  # and "000" when none did, while curl's exit code cannot tell those apart (a
  # complete 404 can still exit 56).
  if [[ ! "$status" =~ ^[0-9]{3}$ || "$status" == "000" ]]; then
    HTTP_ERROR="could not reach $url (curl exit $curl_status, http ${status:-none}: network unreachable, DNS failure, or blocked egress)"
    return 2
  fi

  if [[ "$status" == "404" || "$status" == "410" ]]; then
    HTTP_ERROR="$url returned HTTP $status"
    return 1
  fi

  if [[ "$status" != 2?? ]]; then
    HTTP_ERROR="$url returned HTTP $status (the server is reachable but did not serve the resource; this says nothing about whether it exists)"
    return 3
  fi

  # Only on a 2xx does the exit code say something the status cannot: whether
  # the body finished arriving. A tarball truncated mid-transfer still reads as
  # HTTP 200, and would otherwise be extracted as a partial module and counted
  # as a success.
  if [[ $curl_status -ne 0 ]]; then
    HTTP_ERROR="$url returned HTTP $status but the body did not finish transferring (curl exit $curl_status)"
    return 2
  fi

  return 0
}

SCRIPT_DIR=$(dirname "$0")

resolve_version_to_sha() {
  local artifact="$1" version="$2"
  local group_id artifact_id
  group_id=$(echo "$artifact" | cut -d: -f1)
  artifact_id=$(echo "$artifact" | cut -d: -f2)

  # 1. Resolve symbolic release tiers (STABLE, RC, BETA, ALPHA)
  if [[ "$version" =~ ^(ALPHA|BETA|RC|STABLE)$ ]]; then
    local resolved=""
    if [[ -x "$SCRIPT_DIR/jetpack" ]]; then
      resolved=$("$SCRIPT_DIR/jetpack" version "$artifact" "$version" 2>/dev/null || true)
    elif command -v jetpack >/dev/null 2>&1; then
      resolved=$(jetpack version "$artifact" "$version" 2>/dev/null || true)
    fi
    if [[ -n "$resolved" ]]; then
      version="$resolved"
    fi
  fi

  # 2. Fetch Maven POM to locate canonical DAC release notes URL
  local group_path
  group_path=$(echo "$group_id" | tr '.' '/')
  local pom_url="https://dl.google.com/android/maven2/${group_path}/${artifact_id}/${version}/${artifact_id}-${version}.pom"
  local pom_file="$OUTPUT_DIR/.pom.xml"
  local pom_status=0

  http_get "$pom_url" "$pom_file" || pom_status=$?
  if [[ $pom_status -eq 1 ]]; then
    echo "$(basename "$0"): error: artifact $artifact version $version not found on Google Maven (HTTP 404)" >&2
    echo "$(basename "$0"): fetching 'latest' samples (by omitting the version) might succeed" >&2
    exit 1
  elif [[ $pom_status -ne 0 ]]; then
    echo "$(basename "$0"): $HTTP_ERROR" >&2
    exit 1
  fi

  local dac_url_raw dac_url
  dac_url_raw=$(grep -o '<url>[^<]*' "$pom_file" | head -n 1 | sed 's/<url>//' || true)
  rm -f "$pom_file"

  if [[ -z "$dac_url_raw" || ! "$dac_url_raw" =~ developer\.android\.com ]]; then
    local slug
    slug=$(echo "$group_id" | sed 's/^androidx\.//' | tr '.' '-')
    dac_url="https://developer.android.com/jetpack/androidx/releases/${slug}"
  else
    dac_url="${dac_url_raw%%#*}"
  fi

  # 3. Fetch DAC release notes
  local dac_file="$OUTPUT_DIR/.dac.html"
  local dac_status=0
  http_get "$dac_url" "$dac_file" || dac_status=$?
  if [[ $dac_status -ne 0 ]]; then
    echo "$(basename "$0"): error: could not fetch release notes from $dac_url" >&2
    if [[ -n "$HTTP_ERROR" ]]; then
      echo "$(basename "$0"): $HTTP_ERROR" >&2
    fi
    echo "$(basename "$0"): fetching 'latest' samples (by omitting the version) might succeed" >&2
    exit 1
  fi

  # 4. Extract release commit SHA
  local release_sha=""
  release_sha=$(TARGET_VERSION="$version" perl -0777 -ne '
    my $ver = $ENV{"TARGET_VERSION"};
    my $ver_short = $ver;
    $ver_short =~ s/\.0$//;
    if (/(?:Version\s+\Q$ver\E|Version\s+\Q$ver_short\E)\b.*?\+log\/[0-9a-fA-F]+\.\.([0-9a-fA-F]+)/s) {
      print "$1\n";
    }
  ' <"$dac_file" || true)
  rm -f "$dac_file"

  if [[ -z "$release_sha" ]]; then
    echo "$(basename "$0"): error: could not resolve commit SHA for version $version from release notes" >&2
    echo "$(basename "$0"): the release notes format was not as expected or the version has not been published yet" >&2
    echo "$(basename "$0"): fetching 'latest' samples (by omitting the version) might succeed" >&2
    exit 1
  fi

  printf '%s\n' "$release_sha"
}

TARGET_REF="refs/heads/androidx-main"
if [[ -n "$VERSION" && "$VERSION" != "latest" && "$VERSION" != "LATEST" && "$VERSION" != "HEAD" && "$VERSION" != "SNAPSHOT" ]]; then
  echo "info: Resolving version $VERSION to Git commit SHA..." >&2
  RELEASE_SHA=$(resolve_version_to_sha "$ARTIFACT" "$VERSION")
  TARGET_REF="$RELEASE_SHA"
  echo "info: Resolved $ARTIFACT $VERSION -> commit $RELEASE_SHA" >&2
fi

# Prioritized AndroidX direct sample module paths. Probing avoids heavy
# recursive git tree traversals (recursive=1) on parent directories that
# frequently trigger Gitiles HTTP 503 load-shedding timeouts.
PROBE_PATHS=(
  "${DERIVED_PATH}/${ARTIFACT_ID}/samples"
  "${DERIVED_PATH}/samples"
  "${DERIVED_PATH}/${ARTIFACT_ID}-samples"
)

FOUND_SAMPLES=0

for probe_dir in "${PROBE_PATHS[@]}"; do
  probe_url="https://android.googlesource.com/platform/frameworks/support/+/${TARGET_REF}/${probe_dir}?format=JSON"
  probe_file="$OUTPUT_DIR/.probe.json"
  probe_status=0
  http_get "$probe_url" "$probe_file" || probe_status=$?

  if [[ $probe_status -eq 0 ]]; then
    rm -f "$probe_file"
    target_path="$OUTPUT_DIR/$probe_dir"
    mkdir -p "$target_path"

    echo "info: Downloading optimized archive for $probe_dir..." >&2
    tar_url="https://android.googlesource.com/platform/frameworks/support/+archive/${TARGET_REF}/${probe_dir}.tar.gz"
    archive="$target_path/.archive.tar.gz"
    tar_status=0
    http_get "$tar_url" "$archive" || tar_status=$?

    if [[ $tar_status -eq 0 ]] && tar -xz -C "$target_path" -f "$archive"; then
      FOUND_SAMPLES=$((FOUND_SAMPLES + 1))
      rm -f "$archive"
      break
    elif [[ $tar_status -ne 0 && $tar_status -ne 1 ]]; then
      echo "$(basename "$0"): $HTTP_ERROR" >&2
      rm -f "$archive"
      exit 1
    fi
    rm -f "$archive"
  elif [[ $probe_status -ne 1 ]]; then
    # Server declined to answer (429, 5xx) or transport failure
    rm -f "$probe_file"
    echo "$(basename "$0"): $HTTP_ERROR" >&2
    exit 1
  fi
  rm -f "$probe_file"
done

# Fallback to broader group search if direct probing found no samples
if [[ $FOUND_SAMPLES -eq 0 ]]; then
  gitiles_url="https://android.googlesource.com/platform/frameworks/support/+/${TARGET_REF}/${DERIVED_PATH}?format=JSON&recursive=1"
  response_file="$OUTPUT_DIR/.gitiles.json"
  gitiles_status=0
  http_get "$gitiles_url" "$response_file" || gitiles_status=$?

  if [[ $gitiles_status -eq 1 ]]; then
    echo "$(basename "$0"): no files found for path $DERIVED_PATH ($HTTP_ERROR)" >&2
    exit 1
  elif [[ $gitiles_status -ne 0 ]]; then
    echo "$(basename "$0"): $HTTP_ERROR" >&2
    exit 1
  fi

  response=$(cat "$response_file")
  rm -f "$response_file"

  paths=$(echo "$response" | tail -n +2 | jq -r --arg prefix "$DERIVED_PATH" \
    '.entries[]? | select(.type == "blob") | "\($prefix)/\(.name)"' | sort -u)

  if [[ -z "$paths" ]]; then
    echo "$(basename "$0"): no files found for path $DERIVED_PATH" >&2
    exit 1
  fi

  module_dirs=$(echo "$paths" | grep "/src/" | sed -E 's|/src/.*||' | sort -u)

  if [[ -n "$module_dirs" ]]; then
    while IFS= read -r mod_dir; do
      if [[ "$mod_dir" =~ /samples || "$mod_dir" =~ /integration-tests ]]; then
        target_path="$OUTPUT_DIR/$mod_dir"
        mkdir -p "$target_path"

        echo "info: Downloading optimized archive for $mod_dir..." >&2
        tar_url="https://android.googlesource.com/platform/frameworks/support/+archive/${TARGET_REF}/${mod_dir}.tar.gz"
        archive="$target_path/.archive.tar.gz"
        tar_status=0
        http_get "$tar_url" "$archive" || tar_status=$?

        if [[ $tar_status -eq 1 ]]; then
          echo "$(basename "$0"): warning: skipping $mod_dir ($HTTP_ERROR)" >&2
        elif [[ $tar_status -ne 0 ]]; then
          echo "$(basename "$0"): $HTTP_ERROR" >&2
          exit 1
        elif tar -xz -C "$target_path" -f "$archive"; then
          FOUND_SAMPLES=$((FOUND_SAMPLES + 1))
        else
          echo "$(basename "$0"): warning: skipping $mod_dir (archive could not be extracted)" >&2
        fi
        rm -f "$archive"
      fi
    done <<<"$module_dirs"
  fi
fi

if [[ $FOUND_SAMPLES -eq 0 ]]; then
  echo "$(basename "$0"): found files but none matched samples or integration-tests with a 'src' directory" >&2
  exit 1
fi

echo "info: Downloaded $FOUND_SAMPLES modules to $OUTPUT_DIR" >&2
echo "$OUTPUT_DIR"
