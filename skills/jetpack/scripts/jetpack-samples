#!/usr/bin/env bash

# jetpack-samples - Extract reference files for inspection
#
# Usage: jetpack-samples ARTIFACT [--output DIR]

set -euo pipefail

if ((BASH_VERSINFO[0] < 4)); then
  echo "$(basename "$0"): requires bash 4.0 or higher (found ${BASH_VERSION})" >&2
  exit 1
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

# Verify external dependencies. Deferred until after the --help check so that
# --help works even when dependencies are absent.
check_deps() {
  require curl
  require jq
}

usage() {
  cat <<EOF
Usage: $(basename "$0") ARTIFACT [OPTIONS]

Extract reference files (samples and integration tests) from the AndroidX 
source repository for inspection.

Arguments:
  ARTIFACT       The Maven coordinate of the Jetpack library (e.g., androidx.compose.remote:remote-creation-compose).

Options:
  --output DIR   Directory where extracted files will be downloaded.
                 If omitted, a temporary directory is used.
  --help         Display this help message and exit

Environment:
  JETPACK_SAMPLES_OFFLINE  Refuse to use the network. This tool caches nothing,
                           so offline mode fails immediately rather than
                           serving a stale answer. Falls back to AGENT_OFFLINE
                           when unset.
  AGENT_OFFLINE            Workspace-wide offline policy (see above).

Examples:
  $(basename "$0") androidx.compose.remote:remote-creation-compose
  $(basename "$0") androidx.compose.remote:remote-creation-compose --output ./my-samples
EOF
  exit 0
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
  usage
fi

check_deps

ARTIFACT=""
OUTPUT_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output)
      if [[ -z "${2:-}" ]]; then
        echo "$(basename "$0"): option '--output' requires an argument" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
      fi
      OUTPUT_DIR="$2"
      shift 2
      ;;
    -*)
      echo "$(basename "$0"): unknown option: $1" >&2
      echo "Try '$(basename "$0") --help' for more information." >&2
      exit 1
      ;;
    *)
      if [[ -z "$ARTIFACT" ]]; then
        ARTIFACT="$1"
      else
        echo "$(basename "$0"): too many arguments" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ -z "$ARTIFACT" ]]; then
  echo "$(basename "$0"): missing artifact operand" >&2
  echo "Try '$(basename "$0") --help' for more information." >&2
  exit 1
fi

if [[ ! "$ARTIFACT" =~ ^[^:]+:[^:]+$ ]]; then
  echo "$(basename "$0"): invalid artifact format '$ARTIFACT' (expected GROUP_ID:ARTIFACT_ID)" >&2
  echo "Try '$(basename "$0") --help' for more information." >&2
  exit 1
fi

GROUP_ID=$(echo "$ARTIFACT" | cut -d: -f1)
DERIVED_PATH=$(echo "$GROUP_ID" | sed 's/^androidx\.//' | sed 's/\./\//g')

# Which offline switch is in force. The per-tool variable wins when set
# (including when set to 0, to exempt this tool from a workspace-wide policy),
# otherwise the AGENT_OFFLINE policy applies -- see
# skills/coding-standards/references/caching.md.
offline_var() {
  if [[ -n "${JETPACK_SAMPLES_OFFLINE+x}" ]]; then
    echo "JETPACK_SAMPLES_OFFLINE"
  else
    echo "AGENT_OFFLINE"
  fi
}

is_offline() {
  local var value
  var=$(offline_var)
  value="${!var:-}"
  case "$(echo "$value" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | on) return 0 ;;
    *) return 1 ;;
  esac
}

# This tool caches nothing -- it extracts a fresh copy of the AndroidX tree into
# a directory the caller names -- so every offline invocation is a miss. Checked
# before the output directory is created, so a run that cannot proceed leaves
# nothing behind (the cleanup trap below is on ERR, which an explicit exit does
# not fire), and before any fetch, so the retry budget is not spent on calls the
# environment has already forbidden.
if is_offline; then
  OFFLINE_VAR=$(offline_var)
  echo "$(basename "$0"): offline ($OFFLINE_VAR=${!OFFLINE_VAR:-}) and no cached copy of the AndroidX source tree" >&2
  echo "$(basename "$0"): run this where there is network:" >&2
  echo "  $(basename "$0") $ARTIFACT" >&2
  exit 1
fi

CLEANUP_ON_FAILURE=false
if [[ -z "$OUTPUT_DIR" ]]; then
  OUTPUT_DIR=$(mktemp -d "${TMPDIR:-/tmp}/jetpack-samples.XXXXXXXXXX")
  CLEANUP_ON_FAILURE=true
fi

mkdir -p "$OUTPUT_DIR"

trap_failure() {
  if [[ "$CLEANUP_ON_FAILURE" == "true" ]]; then
    rm -rf "$OUTPUT_DIR"
  fi
}
trap trap_failure ERR

CURL_RETRY_OPTS=(--retry 5 --retry-delay 4 --retry-all-errors --retry-connrefused
  --connect-timeout 10)

# http_get URL OUTFILE -- write the response body to OUTFILE.
#
# Reads the status via -w '%{http_code}' rather than trusting curl's exit code,
# which does not reliably separate an HTTP-level error from a transport one: the
# status is "000" only when no response was received at all. Sets HTTP_ERROR for
# the caller's message.
#
# Exit codes:
#   0  body available
#   1  the resource is genuinely absent (404/410)
#   2  no response at all (network unreachable, DNS failure, blocked egress)
#   3  the server answered, but with an error that says nothing about whether
#      the resource exists (429, 5xx, 403...)
#
# 1 and 3 are separate because only the first is evidence of absence. Folding
# them together lets a rate-limited or briefly-broken Gitiles read as "this
# artifact has no samples", which is the confidently-wrong answer this whole
# path exists to avoid.
http_get() {
  local url="$1" outfile="$2" curl_status=0 status
  HTTP_ERROR=""

  status=$(curl -sSL "${CURL_RETRY_OPTS[@]}" -o "$outfile" \
    -w '%{http_code}' "$url" 2>/dev/null) || curl_status=$?

  # Classify by status first: -w emits three digits whenever a response arrived
  # and "000" when none did, while curl's exit code cannot tell those apart (a
  # complete 404 can still exit 56).
  if [[ ! "$status" =~ ^[0-9]{3}$ || "$status" == "000" ]]; then
    HTTP_ERROR="could not reach $url (curl exit $curl_status, http ${status:-none}: network unreachable, DNS failure, or blocked egress)"
    return 2
  fi

  if [[ "$status" == "404" || "$status" == "410" ]]; then
    HTTP_ERROR="$url returned HTTP $status"
    return 1
  fi

  if [[ "$status" != 2?? ]]; then
    HTTP_ERROR="$url returned HTTP $status (the server is reachable but did not serve the resource; this says nothing about whether it exists)"
    return 3
  fi

  # Only on a 2xx does the exit code say something the status cannot: whether
  # the body finished arriving. A tarball truncated mid-transfer still reads as
  # HTTP 200, and would otherwise be extracted as a partial module and counted
  # as a success.
  if [[ $curl_status -ne 0 ]]; then
    HTTP_ERROR="$url returned HTTP $status but the body did not finish transferring (curl exit $curl_status)"
    return 2
  fi

  return 0
}

# Gitiles (the browser behind android.googlesource.com, the same host used
# below to download matched directories) can list a directory's full
# recursive file tree as JSON in a single request, scoped to just the
# derived path. This replaces an older approach that scraped an API key out
# of cs.android.com's HTML to query Google's internal, undocumented Code
# Search backend.
GITILES_URL="https://android.googlesource.com/platform/frameworks/support/+/refs/heads/androidx-main/${DERIVED_PATH}?format=JSON&recursive=1"

RESPONSE_FILE="$OUTPUT_DIR/.gitiles.json"
GITILES_STATUS=0
http_get "$GITILES_URL" "$RESPONSE_FILE" || GITILES_STATUS=$?

# Only a 404 is evidence the artifact has no such path in the tree. A transport
# failure or a 5xx means we never learned whether it does, and reporting either
# as "no files found" is the one failure mode this must not have -- a caller
# cannot tell an empty result from a broken lookup, and will believe the former.
if [[ $GITILES_STATUS -eq 1 ]]; then
  echo "$(basename "$0"): no files found for path $DERIVED_PATH ($HTTP_ERROR)" >&2
  exit 1
elif [[ $GITILES_STATUS -ne 0 ]]; then
  echo "$(basename "$0"): $HTTP_ERROR" >&2
  exit 1
fi

RESPONSE=$(cat "$RESPONSE_FILE")
rm -f "$RESPONSE_FILE"

# Gitiles prefixes JSON responses with an anti-XSSI line ()]}'); strip it
# before parsing, then reconstruct each entry's path relative to the repo
# root (the API returns paths relative to the requested directory).
PATHS=$(echo "$RESPONSE" | tail -n +2 | jq -r --arg prefix "$DERIVED_PATH" \
  '.entries[]? | select(.type == "blob") | "\($prefix)/\(.name)"' | sort -u)

if [[ -z "$PATHS" ]]; then
  echo "$(basename "$0"): no files found for path $DERIVED_PATH" >&2
  exit 1
fi

# Extract unique module directories containing a 'src' folder
MODULE_DIRS=$(echo "$PATHS" | grep "/src/" | sed -E 's|/src/.*||' | sort -u)

FOUND_SAMPLES=0
if [[ -n "$MODULE_DIRS" ]]; then
  while IFS= read -r mod_dir; do
    if [[ "$mod_dir" =~ /samples || "$mod_dir" =~ /integration-tests ]]; then
      TARGET_PATH="$OUTPUT_DIR/$mod_dir"
      mkdir -p "$TARGET_PATH"

      echo "info: Downloading optimized archive for $mod_dir..." >&2
      TAR_URL="https://android.googlesource.com/platform/frameworks/support/+archive/refs/heads/androidx-main/${mod_dir}.tar.gz"

      # Fetch to a file rather than straight into tar so the HTTP status is
      # readable: a module that 404s is a real gap in this artifact's tree and
      # the remaining modules are still worth having, but a transport failure or
      # a 5xx makes the count below meaningless -- some modules simply were not
      # asked about successfully -- so those stop the run rather than shrinking
      # the result silently.
      ARCHIVE="$TARGET_PATH/.archive.tar.gz"
      TAR_STATUS=0
      http_get "$TAR_URL" "$ARCHIVE" || TAR_STATUS=$?

      if [[ $TAR_STATUS -eq 1 ]]; then
        echo "$(basename "$0"): warning: skipping $mod_dir ($HTTP_ERROR)" >&2
      elif [[ $TAR_STATUS -ne 0 ]]; then
        echo "$(basename "$0"): $HTTP_ERROR" >&2
        exit 1
      elif tar -xz -C "$TARGET_PATH" -f "$ARCHIVE"; then
        FOUND_SAMPLES=$((FOUND_SAMPLES + 1))
      else
        echo "$(basename "$0"): warning: skipping $mod_dir (archive could not be extracted)" >&2
      fi
      rm -f "$ARCHIVE"
    fi
  done <<<"$MODULE_DIRS"
fi

if [[ $FOUND_SAMPLES -eq 0 ]]; then
  echo "$(basename "$0"): found files but none matched samples or integration-tests with a 'src' directory" >&2
  exit 1
fi

echo "info: Downloaded $FOUND_SAMPLES modules to $OUTPUT_DIR" >&2
echo "$OUTPUT_DIR"
