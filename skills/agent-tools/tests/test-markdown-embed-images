#!/usr/bin/env bash

# Tests: skills/agent-tools/tests/test-markdown-embed-images

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/markdown-embed-images"

echo "1..4"

TMPDIR_WORK=$(mktemp -d "${TMPDIR:-/tmp}/test-embed.XXXXXX")
trap 'rm -rf -- "$TMPDIR_WORK"' EXIT

# Generate a small 1x1 red PNG using python/base64
RED_PNG_B64="iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
echo "$RED_PNG_B64" | base64 -d > "$TMPDIR_WORK/red.png"

# Test 1: Markdown with no images is untouched
DOC_NO_IMG="$TMPDIR_WORK/no-images.md"
printf "# Title\n\nNo images here.\n" > "$DOC_NO_IMG"
"$BIN" "$DOC_NO_IMG" 2>/dev/null
if grep -q "No images here." "$DOC_NO_IMG"; then
  echo "ok 1 - document with no images left intact"
else
  echo "not ok 1 - document with no images modified unexpectedly"
fi

# Test 2: Inlines local relative image as reference Base64
DOC_IMG="$TMPDIR_WORK/doc.md"
printf "# With Image\n\n![Red Dot](red.png)\n" > "$DOC_IMG"
(cd "$TMPDIR_WORK" && "$BIN" "$DOC_IMG" 2>/dev/null)
if grep -q "data:image/png;base64," "$DOC_IMG" && grep -q '!\[Red Dot\]\[img-red\]' "$DOC_IMG"; then
  echo "ok 2 - embedded local image as reference-style data URI"
else
  echo "not ok 2 - failed to embed image: $(cat "$DOC_IMG")"
fi

# Test 3: --dry-run does not modify file
DOC_DRY="$TMPDIR_WORK/dry.md"
printf "# Dry Run\n\n![Red Dot](red.png)\n" > "$DOC_DRY"
(cd "$TMPDIR_WORK" && "$BIN" --dry-run "$DOC_DRY" 2>/dev/null)
if ! grep -q "data:image/png;base64," "$DOC_DRY"; then
  echo "ok 3 - --dry-run did not mutate document"
else
  echo "not ok 3 - --dry-run unexpectedly mutated document"
fi

# Test 4: -o/--output writes to separate file
DOC_SRC="$TMPDIR_WORK/src.md"
DOC_OUT="$TMPDIR_WORK/out.md"
printf "# Output Test\n\n![Red Dot](red.png)\n" > "$DOC_SRC"
(cd "$TMPDIR_WORK" && "$BIN" -o "$DOC_OUT" "$DOC_SRC" 2>/dev/null)
if ! grep -q "data:image/png;base64," "$DOC_SRC" && grep -q "data:image/png;base64," "$DOC_OUT"; then
  echo "ok 4 - -o wrote to output file leaving source untouched"
else
  echo "not ok 4 - -o flag failed"
fi
