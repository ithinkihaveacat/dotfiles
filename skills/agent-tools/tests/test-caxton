BIN = Path(__file__).resolve().parent.parent / "scripts" / "caxton"


def load_caxton():
    loader = importlib.machinery.SourceFileLoader("caxton_under_test", str(BIN))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = mod
    loader.exec_module(mod)
    return mod


class Tap:
    def __init__(self, total: int):
        print(f"1..{total}", flush=True)
        self.n = 0
        self.failed = 0

    def check(self, desc: str, ok: bool, detail: object = "") -> None:
        self.n += 1
        if not ok:
            self.failed += 1
        print(f"{'ok' if ok else 'not ok'} {self.n} - {desc}", flush=True)
        if not ok and detail:
            for line in str(detail).splitlines()[:25]:
                print(f"# {line}", file=sys.stderr, flush=True)

    def skip(self, reason: str) -> None:
        self.n += 1
        print(f"ok {self.n} # SKIP {reason}", flush=True)


def run_cli(
    args: list[str],
    *,
    use_shebang: bool = False,
    cwd: Path | None = None,
    env: dict[str, str | None] | None = None,
) -> subprocess.CompletedProcess[str]:
    cmd = [str(BIN), *args] if use_shebang else [sys.executable, str(BIN), *args]
    run_env = os.environ.copy()
    if env:
        for k, v in env.items():
            if v is None:
                run_env.pop(k, None)
            else:
                run_env[k] = v
    return subprocess.run(
        cmd,
        cwd=cwd,
        env=run_env,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        check=False,
    )


def run_inproc(
    caxton,
    argv: list[str],
    *,
    cwd: Path,
    env: dict[str, str | None] | None = None,
    stdin_bytes: bytes = b"",
) -> tuple[int, str, str]:
    stdout_buf = io.StringIO()
    stderr_buf = io.StringIO()
    old_argv = sys.argv
    old_cwd = Path.cwd()
    old_stdin = sys.stdin
    old_sigalrm = (
        signal.getsignal(signal.SIGALRM) if hasattr(signal, "SIGALRM") else None
    )
    old_sigterm = signal.getsignal(signal.SIGTERM)
    old_sigint = signal.getsignal(signal.SIGINT)
    old_help_defaults = caxton.print_help.__defaults__
    old_usage_defaults = caxton.print_short_usage.__defaults__
    saved_env: dict[str, str | None] = {}
    if env:
        for k, v in env.items():
            saved_env[k] = os.environ.get(k)
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
    rc = 0
    try:
        os.chdir(cwd)
        sys.argv = ["caxton", *argv]
        sys.stdin = io.TextIOWrapper(
            io.BytesIO(stdin_bytes),
            encoding="utf-8",
            errors="surrogateescape",
            newline="",
        )
        caxton.print_help.__defaults__ = (stdout_buf,)
        caxton.print_short_usage.__defaults__ = (stderr_buf,)
        with (
            contextlib.redirect_stdout(stdout_buf),
            contextlib.redirect_stderr(stderr_buf),
        ):
            caxton.main()
    except SystemExit as exc:
        rc = int(exc.code) if exc.code is not None else 0
    finally:
        caxton.print_help.__defaults__ = old_help_defaults
        caxton.print_short_usage.__defaults__ = old_usage_defaults
        if hasattr(signal, "SIGALRM"):
            signal.alarm(0)
            if old_sigalrm is not None:
                signal.signal(signal.SIGALRM, old_sigalrm)
        signal.signal(signal.SIGTERM, old_sigterm)
        signal.signal(signal.SIGINT, old_sigint)
        os.chdir(old_cwd)
        sys.argv = old_argv
        sys.stdin = old_stdin
        for k, orig in saved_env.items():
            if orig is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = orig
    return rc, stdout_buf.getvalue(), stderr_buf.getvalue()


def resolved_tags(output: str) -> list[str]:
    return [
        f"{m.group(2)} {m.group(1)}"
        for m in re.finditer(r"^  \[([RW I-]*)\]  (.*) \(.*\)$", output, re.MULTILINE)
    ]


def resolved_block(output: str) -> str:
    lines = output.splitlines()
    collecting = False
    out = []
    for line in lines:
        if line.startswith("Resolved Files:"):
            collecting = True
        if collecting:
            out.append(line)
            if line.startswith("Excluded"):
                break
    return "\n".join(out)


def snapshot(repo: Path) -> list[tuple[str, bytes]]:
    items: list[tuple[str, bytes]] = []
    for root, dirs, files in os.walk(repo):
        dirs[:] = sorted(d for d in dirs if d != ".git")
        for f in sorted(files):
            p = Path(root) / f
            items.append((str(p.relative_to(repo)), p.read_bytes()))
    return sorted(items)


def init_base_repo(path: Path) -> Path:
    path.mkdir(parents=True, exist_ok=True)
    for cmd in (
        ["git", "init", "-q", "."],
        ["git", "config", "user.email", "test@example.com"],
        ["git", "config", "user.name", "Test"],
        ["git", "config", "commit.gpgsign", "false"],
        ["git", "config", "core.excludesFile", "/dev/null"],
    ):
        subprocess.run(cmd, cwd=path, check=True, capture_output=True)
    return path


def commit_all(repo: Path, msg: str = "init") -> None:
    subprocess.run(["git", "add", "-A"], cwd=repo, check=True, capture_output=True)
    res = subprocess.run(
        ["git", "commit", "-q", "--no-gpg-sign", "-m", msg],
        cwd=repo,
        capture_output=True,
        text=True,
        check=False,
    )
    if res.returncode != 0:
        print(f"Bail out! fixture '{repo}' could not be committed", flush=True)
        for line in (res.stdout + res.stderr).splitlines():
            print(f"# {line}", flush=True)
        sys.exit(1)


@contextlib.contextmanager
def serve_http(handler_cls):
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler_cls)
    server.daemon_threads = True
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        yield server, f"http://127.0.0.1:{server.server_address[1]}"
    finally:
        server.shutdown()
        server.server_close()
        thread.join(timeout=2.0)


