            # Test 77 (was T76): max_output_tokens + CONTINUATION hops merged
            rc77, out77, err77 = run_limited(
                [
                    '{"content": {"role": "model", "parts": [{"text": "Planning.", "thought": true}]}, "finishReason": "CONTINUATION", "continuationToken": "dG9rZW4tMQ=="}',
                    '{"content": {"role": "model", "parts": [{"functionCall": {"name": "complete_task", "args": {"success": true, "report": "Long report."}}}]}, "finishReason": "STOP"}',
                ]
            )
            tel77 = (
                json.loads(limit_tel.read_text(encoding="utf-8"))
                if limit_tel.is_file()
                else {}
            )
            reqs77 = list(limit_reqs)
            tap.check(
                "Sends max_output_tokens and merges CONTINUATION hops into one turn",
                rc77 == 0
                and len(reqs77) == 2
                and all(
                    r["generationConfig"]["maxOutputTokens"] == 131072
                    and r.get("_x_server_timeout") == "1800"
                    for r in reqs77
                )
                and "continuationToken" not in reqs77[0]
                and reqs77[1].get("continuationToken") == "dG9rZW4tMQ=="
                and reqs77[1]["contents"] == reqs77[0]["contents"]
                and tel77.get("status") == "Succeeded"
                and tel77.get("max_output_tokens") == 131072
                and tel77.get("long_decode_turns") == 1
                and tel77.get("finish_reason") == "STOP"
                and tel77.get("prompt_tokens") == 100
                and tel77.get("input_tokens_total") == 200
                and tel77.get("partial_report") is None
                and "Long report." in out77.splitlines()
                and "complete_task(success=True) -> OK" in err77,
                f"rc={rc77} reqs={len(reqs77)} tel={tel77!r}\n{out77}\n{err77}",
            )

            # Test 78 (was T77): MAX_TOKENS without tool call exits 1 and keeps partial text
            rc78, out78, err78 = run_limited(
                [
                    '{"content": {"role": "model", "parts": [{"text": "Thinking.", "thought": true}, {"text": "## Partial findings"}]}, "finishReason": "MAX_TOKENS"}'
                ]
            )
            resp_files = list(limit_state.glob("response_*.md"))
            resp78_txt = resp_files[0].read_text(encoding="utf-8") if resp_files else ""
            tel78 = (
                json.loads(limit_tel.read_text(encoding="utf-8"))
                if limit_tel.is_file()
                else {}
            )
            tap.check(
                "Reports an output-ceiling stop and keeps the partial text",
                rc78 == 1
                and "## Partial findings" in out78.splitlines()
                and "Thinking." not in out78
                and re.search(
                    r"Error: model returned no tool call \(finish_reason: .*MAX_TOKENS\)",
                    err78,
                )
                is not None
                and "The turn reached --max-output-tokens (131072, thinking included); raise it or lower --thinking"
                in err78
                and "## Partial findings" in resp78_txt.splitlines()
                and "Status: Incomplete" in resp78_txt
                and tel78.get("partial_report") == "## Partial findings"
                and tel78.get("finish_reason") == "MAX_TOKENS",
                f"rc={rc78} tel={tel78!r}\n{out78}\n{err78}",
            )

        # Test 79 (was T78): --max-output-tokens default, env, precedence, validation (reuse REPO!)
        r79_def = run_inproc(
            caxton,
            ["--dry-run", "Audit"],
            cwd=repo,
            env={"CAXTON_MAX_OUTPUT_TOKENS": None},
        )
        r79_env = run_inproc(
            caxton,
            ["--dry-run", "Audit"],
            cwd=repo,
            env={"CAXTON_MAX_OUTPUT_TOKENS": "256k"},
        )
        r79_flag = run_inproc(
            caxton,
            ["--dry-run", "Audit", "--max-output-tokens", "65536"],
            cwd=repo,
            env={"CAXTON_MAX_OUTPUT_TOKENS": "256k"},
        )
        r79_bad = run_inproc(
            caxton,
            ["--dry-run", "Audit", "--max-output-tokens", "lots"],
            cwd=repo,
        )
        tap.check(
            "--max-output-tokens default, environment, precedence, and validation",
            "Max output:    131072 tokens per turn" in r79_def[1]
            and "Max output:    256000 tokens per turn" in r79_env[1]
            and "Max output:    65536 tokens per turn" in r79_flag[1]
            and r79_bad[0] == 1
            and "error: --max-output-tokens: invalid token count: 'lots'" in r79_bad[2],
            f"bad_rc={r79_bad[0]}\n{r79_bad[2]}",
        )

    return 1 if tap.failed else 0


