#!/usr/bin/env bash

# Tests: skills/agent-tools/tests/test-context

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/context"

echo "1..9"

diag() {
  while IFS= read -r line; do
    printf '# %s\n' "$line"
  done <<<"$1"
}

# Test 1: Usage (no args)
OUTPUT=$(mktemp)
trap 'rm -f "$OUTPUT"' EXIT

if ! "$BIN" >"$OUTPUT" 2>&1; then
  if grep -q "usage:" "$OUTPUT" || grep -q "Generate aggregated context" "$OUTPUT"; then
    echo "ok 1 - Usage displayed correctly when no arguments provided"
  else
    echo "not ok 1 - Script failed and usage output missing expected text"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 1 - Script succeeded with no arguments, expected failure"
fi

# Test 2: Local Directory Support (using 'show')
TMP_DIR=$(mktemp -d)
trap 'rm -f "$OUTPUT"; rm -rf "$TMP_DIR"' EXIT

mkdir -p "$TMP_DIR/subdir"
echo "Root file" >"$TMP_DIR/root.txt"
echo "Subdir file" >"$TMP_DIR/subdir/sub.txt"

if RESPONSE=$("$BIN" show "$TMP_DIR"); then
  if echo "$RESPONSE" | grep -q "Root file" &&
    echo "$RESPONSE" | grep -q "Subdir file" &&
    echo "$RESPONSE" | grep -q "# Context:" &&
    echo "$RESPONSE" | grep -q "### Directory Manifest" &&
    echo "$RESPONSE" | grep -q "### Table of Contents"; then
    echo "ok 2 - Local directory packaged correctly into Markdown with manifest using 'show'"
  else
    echo "not ok 2 - Markdown output missing expected file content or sections"
    echo "# Response was:"
    diag "$RESPONSE"
  fi
else
  echo "not ok 2 - Failed to run context show on local directory"
fi

# Test 3: Catalog subcommand
if CATALOG_OUT=$("$BIN" catalog); then
  if echo "$CATALOG_OUT" | grep -q "skills" && echo "$CATALOG_OUT" | grep -q "gemini-api"; then
    echo "ok 3 - Catalog subcommand listed default entries"
  else
    echo "not ok 3 - Catalog output missing expected entries"
    diag "$CATALOG_OUT"
  fi
else
  echo "not ok 3 - Catalog subcommand failed"
fi

# Test 4: Template subcommand
if TEMPLATE_OUT=$("$BIN" template); then
  if echo "$TEMPLATE_OUT" | grep -q "api.add_entry" && echo "$TEMPLATE_OUT" | grep -q "my_custom_entry_handler"; then
    echo "ok 4 - Template subcommand output correct template"
  else
    echo "not ok 4 - Template output missing expected content"
    diag "$TEMPLATE_OUT"
  fi
else
  echo "not ok 4 - Template subcommand failed"
fi

# Test 5: Invalid subcommand
if ! "$BIN" invalid-command >"$OUTPUT" 2>&1; then
  if grep -q "invalid choice: 'invalid-command'" "$OUTPUT" || grep -q "invalid choice" "$OUTPUT"; then
    echo "ok 5 - Invalid subcommand failed as expected with usage error"
  else
    echo "not ok 5 - Invalid subcommand failed but error message was unexpected"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 5 - Invalid subcommand succeeded, expected failure"
fi

# Test 6: Offline mode with no cached copy of a URL target fails with an
# actionable error rather than reaching for the network.
CACHE_DIR=$(mktemp -d)
trap 'rm -f "$OUTPUT"; rm -rf "$TMP_DIR" "$CACHE_DIR"' EXIT

if ! CONTEXT_CACHE_DIR="$CACHE_DIR" AGENT_OFFLINE=1 \
  "$BIN" show "https://github.com/example/repo" >"$OUTPUT" 2>&1; then
  if grep -q "no cached copy" "$OUTPUT" && grep -q "AGENT_OFFLINE=1" "$OUTPUT"; then
    echo "ok 6 - Offline with a cold cache fails and names the missing URL"
  else
    echo "not ok 6 - Offline cold-cache error missing expected text"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 6 - Offline with a cold cache succeeded, expected failure"
fi

# Test 7: A local directory target needs no network, so offline mode must not
# get in its way.
if RESPONSE=$(CONTEXT_CACHE_DIR="$CACHE_DIR" AGENT_OFFLINE=1 "$BIN" show "$TMP_DIR"); then
  if echo "$RESPONSE" | grep -q "Root file" && echo "$RESPONSE" | grep -q "Subdir file"; then
    echo "ok 7 - Offline mode leaves local directory targets alone"
  else
    echo "not ok 7 - Offline local directory output missing expected content"
    # shellcheck disable=SC2001  # matches the diagnostic dumps above
    echo "$RESPONSE" | sed 's/^/# /'
  fi
else
  echo "not ok 7 - Offline mode broke a local directory target"
fi

# Test 8: Offline mode must also gate catalog entries, whose handlers all fetch
# over the network -- otherwise `context show <entry>` reaches the network in a
# sandbox that forbids it.
if ! CONTEXT_CACHE_DIR="$CACHE_DIR" AGENT_OFFLINE=1 \
  "$BIN" show gemini-api >"$OUTPUT" 2>&1; then
  if grep -q "no cached copy" "$OUTPUT"; then
    echo "ok 8 - Offline catalog entry fails instead of fetching"
  else
    echo "not ok 8 - Offline catalog entry failed for the wrong reason"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 8 - Offline catalog entry succeeded, expected a cache-miss failure"
fi

# Test 9: Table of Contents line numbers match exact entry header locations
MD_DIR=$(mktemp -d)
trap 'rm -f "$OUTPUT"; rm -rf "$TMP_DIR" "$CACHE_DIR" "$MD_DIR"' EXIT

echo "alpha" >"$MD_DIR/a.txt"
echo "beta line 1" >"$MD_DIR/b.txt"
echo "beta line 2" >>"$MD_DIR/b.txt"
mkdir "$MD_DIR/sub"
echo "gamma" >"$MD_DIR/sub/c.txt"

MD_OUT="$MD_DIR/output.md"
"$BIN" show "$MD_DIR" >"$MD_OUT" 2>/dev/null

ENTRY1_ACTUAL=$(grep -n '^###.*Entry 1:' "$MD_OUT" | cut -d: -f1)
ENTRY2_ACTUAL=$(grep -n '^###.*Entry 2:' "$MD_OUT" | cut -d: -f1)
ENTRY3_ACTUAL=$(grep -n '^###.*Entry 3:' "$MD_OUT" | cut -d: -f1)

ENTRY1_TOC=$(grep -o '\[Entry 1\](#entry-1) (lines [0-9]*' "$MD_OUT" | grep -o '[0-9]*$')
ENTRY2_TOC=$(grep -o '\[Entry 2\](#entry-2) (lines [0-9]*' "$MD_OUT" | grep -o '[0-9]*$')
ENTRY3_TOC=$(grep -o '\[Entry 3\](#entry-3) (lines [0-9]*' "$MD_OUT" | grep -o '[0-9]*$')

if [[ "$ENTRY1_ACTUAL" == "$ENTRY1_TOC" && "$ENTRY2_ACTUAL" == "$ENTRY2_TOC" && "$ENTRY3_ACTUAL" == "$ENTRY3_TOC" ]]; then
  echo "ok 9 - Table of Contents line numbers exactly match entry starting lines"
else
  echo "not ok 9 - Table of Contents line numbers did not match entry lines (Actual: $ENTRY1_ACTUAL,$ENTRY2_ACTUAL,$ENTRY3_ACTUAL vs TOC: $ENTRY1_TOC,$ENTRY2_TOC,$ENTRY3_TOC)"
fi
