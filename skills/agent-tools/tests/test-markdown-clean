#!/usr/bin/env bash

# Tests: skills/agent-tools/tests/test-markdown-clean

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/markdown-clean"

echo "1..10"

# Test 1: clean input is untouched
OUTPUT=$(printf "Hello world\n" | "$BIN" -q)
if [[ "$OUTPUT" == "Hello world" ]]; then
  echo "ok 1 - clean input passes through untouched"
else
  echo "not ok 1 - clean input modified: $OUTPUT"
fi

# Test 2: non-breaking space converted to normal space
OUTPUT=$(printf "foo\u00a0bar\n" | "$BIN" -q)
if [[ "$OUTPUT" == "foo bar" ]]; then
  echo "ok 2 - non-breaking space converted to regular space"
else
  echo "not ok 2 - non-breaking space failed: $OUTPUT"
fi

# Test 3: LLM citations and sources stripped
OUTPUT=$(printf "Answer[cite: 1] ([source](https://example.com))\n" | "$BIN" -q)
if [[ "$OUTPUT" == "Answer" ]]; then
  echo "ok 3 - LLM citation and source tags stripped"
else
  echo "not ok 3 - citations not stripped: $OUTPUT"
fi

# Test 4: Base64 image references stripped
INPUT=$(printf "Text\n\n[img1]: <data:image/png;base64,iVBORw0KGgoAAAANSUhEUg==>\n")
OUTPUT=$(printf "%s" "$INPUT" | "$BIN" -q)
if [[ "$OUTPUT" == "Text" ]]; then
  echo "ok 4 - Base64 image references stripped"
else
  echo "not ok 4 - Base64 image reference remained: $OUTPUT"
fi

# Test 5: Inline data URIs stripped
INPUT=$(printf "Image: ![diagram](data:image/png;base64,AAAA)\n")
OUTPUT=$(printf "%s" "$INPUT" | "$BIN" -q)
if [[ "$OUTPUT" == "Image: ![diagram]()" ]]; then
  echo "ok 5 - Inline data URI payload stripped"
else
  echo "not ok 5 - inline data URI failed: $OUTPUT"
fi

# Test 6: Preserves YAML frontmatter while stripping body dividers
INPUT=$(printf -- "---\ntitle: Doc\n---\nBody\n---\nFooter\n")
OUTPUT=$(printf "%s" "$INPUT" | "$BIN" -q)
EXPECTED=$(printf -- "---\ntitle: Doc\n---\nBody\n\nFooter")
if [[ "$OUTPUT" == "$EXPECTED" ]]; then
  echo "ok 6 - YAML frontmatter preserved and body divider stripped"
else
  echo "not ok 6 - frontmatter divider preservation failed: $OUTPUT"
fi

# Test 7: --keep-dividers preserves body dividers
INPUT=$(printf "Section 1\n---\nSection 2\n")
OUTPUT=$(printf "%s" "$INPUT" | "$BIN" -q --keep-dividers)
EXPECTED=$(printf "Section 1\n---\nSection 2")
if [[ "$OUTPUT" == "$EXPECTED" ]]; then
  echo "ok 7 - --keep-dividers flag preserves horizontal rules"
else
  echo "not ok 7 - keep-dividers failed: $OUTPUT"
fi

# Test 8: --check flag exits 0 on clean and 1 on dirty
if printf "Clean text\n" | "$BIN" --check >/dev/null 2>&1; then
  if ! printf "Dirty\u00a0text\n" | "$BIN" --check >/dev/null 2>&1; then
    echo "ok 8 - --check exits 0 on clean and 1 on dirty"
  else
    echo "not ok 8 - --check failed to detect dirty input"
  fi
else
  echo "not ok 8 - --check failed on clean input"
fi

# Test 9: in-place file modification
TMP=$(mktemp "${TMPDIR:-/tmp}/test-clean.XXXXXX.md")
printf "foo\u00a0bar\n---\n" >"$TMP"
"$BIN" -q "$TMP"
RESULT=$(cat "$TMP")
rm -f "$TMP"
if [[ "$RESULT" == "foo bar" ]]; then
  echo "ok 9 - in-place file modification succeeded"
else
  echo "not ok 9 - in-place file modification failed: $RESULT"
fi

# Test 10: -o/--output writes to separate file leaving input untouched
IN_TMP=$(mktemp "${TMPDIR:-/tmp}/test-in.XXXXXX.md")
OUT_TMP=$(mktemp "${TMPDIR:-/tmp}/test-out.XXXXXX.md")
printf "foo\u00a0bar\n" >"$IN_TMP"
"$BIN" -q -o "$OUT_TMP" "$IN_TMP"
IN_RES=$(cat "$IN_TMP")
OUT_RES=$(cat "$OUT_TMP")
rm -f "$IN_TMP" "$OUT_TMP"
if [[ "$IN_RES" == "foo bar" && "$OUT_RES" == "foo bar" ]]; then
  echo "ok 10 - --output wrote to target and preserved source file"
else
  echo "not ok 10 - --output failed"
fi
