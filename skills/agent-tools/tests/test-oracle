#!/usr/bin/env bash

# Tests: skills/agent-tools/tests/test-oracle

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/oracle"

OUTPUT=$(mktemp)
WORK=$(cd "$(mktemp -d)" && pwd -P)
export ORACLE_CACHE_DIR="$WORK/cache"
trap 'rm -rf "$OUTPUT" "$WORK"' EXIT

echo "1..14"

# Test 1: oracle --help outputs valid help and exits 0
if "$BIN" --help >"$OUTPUT" 2>&1; then
  if grep -q "Usage: oracle" "$OUTPUT" && grep -q "Options:" "$OUTPUT" && grep -q "Best Practices for Context:" "$OUTPUT"; then
    echo "ok 1 - Help output is formatted correctly"
  else
    echo "not ok 1 - Help output missing expected sections"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 1 - oracle --help exited non-zero"
fi

# Test 2: Bare oracle with no arguments exits 1 with error on stderr
if "$BIN" >"$OUTPUT" 2>&1 </dev/null; then
  echo "not ok 2 - Expected bare oracle to fail"
else
  if grep -q "error: prompt is required" "$OUTPUT" && grep -q "Usage: oracle" "$OUTPUT"; then
    echo "ok 2 - Bare oracle prints error and usage to stderr"
  else
    echo "not ok 2 - Bare oracle output missing expected error message"
    sed 's/^/# /' "$OUTPUT"
  fi
fi

# Test 3: oracle --dry-run "prompt" prints dry run summary on stdout
if "$BIN" --dry-run "Explain quantum computing" >"$OUTPUT" 2>&1; then
  if grep -q "Oracle Dry Run Summary" "$OUTPUT" && grep -q "Prompt:" "$OUTPUT" && grep -q "Payload Summary:" "$OUTPUT"; then
    echo "ok 3 - Dry run summary produces expected sections"
  else
    echo "not ok 3 - Dry run summary missing expected headers"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 3 - oracle --dry-run failed"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 4: Directory traversal filters out secret files and directories
SAMPLE_DIR="$WORK/sample_project"
mkdir -p "$SAMPLE_DIR/src" "$SAMPLE_DIR/.ssh" "$SAMPLE_DIR/config"
echo "console.log('hello');" >"$SAMPLE_DIR/src/index.js"
echo "SECRET_KEY=12345" >"$SAMPLE_DIR/.env"
echo "LOCAL_SECRET=abc" >"$SAMPLE_DIR/.env.local"
echo "-----BEGIN PRIVATE KEY-----" >"$SAMPLE_DIR/config/server.pem"
echo "id_rsa_content" >"$SAMPLE_DIR/.ssh/id_rsa"
echo "regular docs" >"$SAMPLE_DIR/README.md"

if "$BIN" --dry-run "Audit this project" "$SAMPLE_DIR" >"$OUTPUT" 2>&1; then
  if grep -q "index.js" "$OUTPUT" && grep -q "README.md" "$OUTPUT"; then
    if ! grep -q "\.env" "$OUTPUT" && ! grep -q "server\.pem" "$OUTPUT" && ! grep -q "id_rsa" "$OUTPUT"; then
      echo "ok 4 - Secret files and credential directories are filtered from directory context"
    else
      echo "not ok 4 - Secret files were erroneously included in context"
      sed 's/^/# /' "$OUTPUT"
    fi
  else
    echo "not ok 4 - Expected files missing from resolved context"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 4 - Dry run on sample project failed"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 5: Symlinks are skipped and not followed
SYMLINK_DIR="$WORK/symlink_project"
mkdir -p "$SYMLINK_DIR/real"
echo "Real content" >"$SYMLINK_DIR/real/file.txt"
ln -s "$SYMLINK_DIR/real/file.txt" "$SYMLINK_DIR/symlinked_file.txt"
ln -s "$SYMLINK_DIR/real" "$SYMLINK_DIR/symlinked_dir"

if "$BIN" --dry-run "Review code" "$SYMLINK_DIR" >"$OUTPUT" 2>&1; then
  if grep -q "real/file.txt" "$OUTPUT" && ! grep -q "symlinked_file.txt" "$OUTPUT" && ! grep -q "symlinked_dir" "$OUTPUT"; then
    echo "ok 5 - Symlinks are ignored and skipped during traversal"
  else
    echo "not ok 5 - Symlinks were not properly excluded"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 5 - Dry run on symlinks failed"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 6: Hybrid media classification: small media tagged [MEDIA-INLINE]
MEDIA_DIR="$WORK/media_project"
mkdir -p "$MEDIA_DIR"
head -c 100 /dev/zero >"$MEDIA_DIR/screenshot.png"
echo "Text documentation" >"$MEDIA_DIR/doc.txt"

if "$BIN" --dry-run "Inspect image and text" "$MEDIA_DIR" >"$OUTPUT" 2>&1; then
  if grep -q "\[MEDIA-INLINE\]" "$OUTPUT" && grep -q "screenshot.png" "$OUTPUT" && grep -q "\[TEXT\]" "$OUTPUT"; then
    echo "ok 6 - Small media files are classified as [MEDIA-INLINE]"
  else
    echo "not ok 6 - Media file classification output missing expected tags"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 6 - Dry run on media project failed"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 7: AGENT_TELEMETRY_JSON is populated on dry-run/completion
TEL_JSON="$WORK/telemetry.json"
if env AGENT_TELEMETRY_JSON="$TEL_JSON" "$BIN" --dry-run "Test telemetry" "$MEDIA_DIR" >"$OUTPUT" 2>&1; then
  if [[ -f "$TEL_JSON" ]] && grep -q '"status": "Succeeded"' "$TEL_JSON" && grep -q '"text_files_count"' "$TEL_JSON" && grep -q '"media_inline_count"' "$TEL_JSON"; then
    echo "ok 7 - AGENT_TELEMETRY_JSON is generated with structured fields"
  else
    echo "not ok 7 - AGENT_TELEMETRY_JSON was not written or is missing expected keys"
    if [[ -f "$TEL_JSON" ]]; then
      cat "$TEL_JSON" | sed 's/^/# /'
    fi
  fi
else
  echo "not ok 7 - Failed running with AGENT_TELEMETRY_JSON"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 8: Reject paths whose ancestors are symlinks on direct CLI args
ANCESTOR_DIR="$WORK/ancestor_test"
mkdir -p "$ANCESTOR_DIR/real_ssh"
echo "Host github.com" >"$ANCESTOR_DIR/real_ssh/config"
ln -s "$ANCESTOR_DIR/real_ssh" "$ANCESTOR_DIR/symlink_parent"

if "$BIN" --dry-run "Check config" "$ANCESTOR_DIR/symlink_parent/config" >"$OUTPUT" 2>&1; then
  if grep -q "skipping symlink" "$OUTPUT" && ! grep -q "\[TEXT\].*real_ssh/config" "$OUTPUT"; then
    echo "ok 8 - Direct paths with symlink ancestors are rejected"
  else
    echo "not ok 8 - Path with symlink ancestor was erroneously included in context"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 8 - Dry run failed for symlink ancestor test"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 9: Aggregate media budget overflows to [MEDIA-UPLOAD]
BUDGET_DIR="$WORK/budget_test"
mkdir -p "$BUDGET_DIR"
# Two 4MB files (total 8MB <= 10MB limit: both inline)
# Third 4MB file (total 12MB > 10MB limit: third overflows to upload)
head -c $((4 * 1024 * 1024)) /dev/zero >"$BUDGET_DIR/img1.png"
head -c $((4 * 1024 * 1024)) /dev/zero >"$BUDGET_DIR/img2.png"
head -c $((4 * 1024 * 1024)) /dev/zero >"$BUDGET_DIR/img3.png"

if "$BIN" --dry-run "Check budget" "$BUDGET_DIR" >"$OUTPUT" 2>&1; then
  if grep -q "Inline Media:   2 file(s)" "$OUTPUT" && grep -q "Uploaded Media: 1 file(s)" "$OUTPUT"; then
    echo "ok 9 - Aggregate media budget overflows excess files to uploaded media"
  else
    echo "not ok 9 - Aggregate media budget did not correctly split inline and upload"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 9 - Dry run failed on aggregate media budget test"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 10: Error telemetry is preserved and not overwritten on failure
ERROR_TEL_JSON="$WORK/error_telemetry.json"
if env -u GEMINI_API_KEY AGENT_TELEMETRY_JSON="$ERROR_TEL_JSON" "$BIN" "Prompt without key" "$SAMPLE_DIR" >"$OUTPUT" 2>&1; then
  echo "not ok 10 - Expected failure when GEMINI_API_KEY is missing"
else
  if [[ -f "$ERROR_TEL_JSON" ]] && grep -q '"status": "Error"' "$ERROR_TEL_JSON" && grep -q '"error": "GEMINI_API_KEY not set"' "$ERROR_TEL_JSON"; then
    echo "ok 10 - Error telemetry retains error status and message without being overwritten"
  else
    echo "not ok 10 - Error telemetry was overwritten or missing error fields"
    if [[ -f "$ERROR_TEL_JSON" ]]; then
      cat "$ERROR_TEL_JSON" | sed 's/^/# /'
    fi
  fi
fi

# Test 11: .config/gcloud and application_default_credentials.json are excluded, src/gcloud is kept
ADC_DIR="$WORK/adc_test"
mkdir -p "$ADC_DIR/.config/gcloud" "$ADC_DIR/src/gcloud"
echo '{"client_secret": "xyz", "refresh_token": "abc"}' >"$ADC_DIR/.config/gcloud/application_default_credentials.json"
echo 'class Client: pass' >"$ADC_DIR/src/gcloud/client.py"

if "$BIN" --dry-run "Audit gcloud config" "$ADC_DIR" >"$OUTPUT" 2>&1; then
  if grep -q "src/gcloud/client.py" "$OUTPUT" && ! grep -q "application_default_credentials" "$OUTPUT" && ! grep -q "\.config/gcloud" "$OUTPUT"; then
    echo "ok 11 - .config/gcloud and ADC are filtered while src/gcloud source code is retained"
  else
    echo "not ok 11 - gcloud filtering did not correctly separate credentials from source code"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 11 - Dry run on gcloud project failed"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 12: macOS /tmp system alias paths are supported without false symlink rejection
TMP_TEST_FILE="/tmp/oracle_test_file_$$.txt"
echo "Valid temporary notes" >"$TMP_TEST_FILE"
trap 'rm -f "$TMP_TEST_FILE"; rm -rf "$OUTPUT" "$WORK"' EXIT

if "$BIN" --dry-run "Inspect temp note" "$TMP_TEST_FILE" >"$OUTPUT" 2>&1; then
  if grep -q "oracle_test_file_" "$OUTPUT" && ! grep -q "skipping symlink" "$OUTPUT"; then
    echo "ok 12 - macOS /tmp path is canonicalized and accepted without symlink rejection"
  else
    echo "not ok 12 - /tmp path was rejected as a symlink"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 12 - Dry run failed for /tmp path"
  sed 's/^/# /' "$OUTPUT"
fi
rm -f "$TMP_TEST_FILE"

# Test 13: Preprocessing failure (e.g. text > 1MB) writes error telemetry
PREPROC_TEL_JSON="$WORK/preproc_telemetry.json"
LARGE_FILE="$WORK/oversized.txt"
head -c $((2 * 1024 * 1024)) /dev/zero | tr '\0' 'A' >"$LARGE_FILE"

if env AGENT_TELEMETRY_JSON="$PREPROC_TEL_JSON" "$BIN" "Oversized context" "$LARGE_FILE" >"$OUTPUT" 2>&1; then
  echo "not ok 13 - Expected failure when text exceeds 1MB threshold without --force"
else
  if [[ -f "$PREPROC_TEL_JSON" ]] && grep -q '"status": "Error"' "$PREPROC_TEL_JSON" && grep -q '"error": "text context exceeds 1MB threshold"' "$PREPROC_TEL_JSON"; then
    echo "ok 13 - Preprocessing failure emits error telemetry to AGENT_TELEMETRY_JSON"
  else
    echo "not ok 13 - Preprocessing failure did not record expected telemetry"
    if [[ -f "$PREPROC_TEL_JSON" ]]; then
      cat "$PREPROC_TEL_JSON" | sed 's/^/# /'
    fi
  fi
fi

# Test 14: Text-only invocation reaches API generation path and does not exit prematurely
if [[ -z "${GEMINI_API_KEY:-}" ]]; then
  echo "ok 14 # SKIP GEMINI_API_KEY not set (offline test mode)"
else
  TEXT_NOTE="$WORK/note.txt"
  echo "Regular note content" >"$TEXT_NOTE"
  if "$BIN" "Say hello in one word" "$TEXT_NOTE" >"$OUTPUT" 2>&1; then
    echo "ok 14 - Text-only invocation successfully streams answer from API"
  else
    echo "not ok 14 - Text-only invocation failed against Gemini API"
    sed 's/^/# /' "$OUTPUT"
  fi
fi
