        stall_posts = 0
        stall_lock = threading.Lock()
        stall_release = threading.Event()

        class StallThenRecover(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                nonlocal stall_posts
                self.rfile.read(int(self.headers.get("Content-Length", 0)))
                with stall_lock:
                    stall_posts += 1
                    count = stall_posts
                if count == 1:
                    stall_release.wait(timeout=10.0)
                    return
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.end_headers()
                payload = (
                    b'data: {"candidates": [{"content": {"parts": [{"text":'
                    b' "Recovered oracle answer"}], "role": "model"}}],'
                    b' "usageMetadata": {"promptTokenCount": 12,'
                    b' "candidatesTokenCount": 3}}\r\n\r\n'
