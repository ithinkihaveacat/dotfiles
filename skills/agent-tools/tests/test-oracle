            env={**base_env, "AGENT_TELEMETRY_JSON": str(code_tel)},
        )
        rc_mp, out_mp, err_mp = run_inproc(
            oracle, ["--dry-run", "--maps", "--no-search", "Maps query"], env=base_env
        )
        re_p = extract_payload_path(out_re + err_re)
        dis_p = extract_payload_path(out_dis + err_dis)
        mp_p = extract_payload_path(out_mp + err_mp)
        re_xml = re_p.read_text(encoding="utf-8") if re_p else ""
        dis_xml = dis_p.read_text(encoding="utf-8") if dis_p else ""
        mp_xml = mp_p.read_text(encoding="utf-8") if mp_p else ""
        code_tel_obj = (
            json.loads(code_tel.read_text(encoding="utf-8"))
            if code_tel.is_file()
            else {}
        )
        tap.check(
            "Flag override order (--no-search/--search), --no-search --code, and --maps interaction work",
            rc_re == 0
            and rc_dis == 0
            and rc_co == 0
            and rc_mp == 0
            and "Tools:          search" in out_re
            and "Use the Google Search tool" in re_xml
            and "Tools:          none" in out_dis
            and "Google Search" not in dis_xml
            and "Tools:          code" in out_co
            and code_tel_obj.get("tools") == "code"
            and "Tools:          maps" in out_mp
            and "Google Maps tool" in mp_xml,
            f"rc=({rc_re},{rc_dis},{rc_co},{rc_mp})",
        )

        # Test 20: '-' stdin positional works with --no-search while unknown '-*' flags are rejected
        # (kept as real CLI subprocess smoke check for piped stdin handling)
        p_stdin = run_cli(
            ["--dry-run", "--no-search", "Summarize stdin only", "-"],
            env=base_env,
            stdin_text="Piped stdin reference text\n",
        )
        p_unk = run_cli(["--dry-run", "--unknown-option", "Prompt"], env=base_env)
        stdin_p = extract_payload_path(p_stdin.stdout + p_stdin.stderr)
        stdin_xml = stdin_p.read_text(encoding="utf-8") if stdin_p else ""
        tap.check(
            "Preserves '-' stdin positional argument and rejects unrecognized options",
            p_stdin.returncode == 0
            and "<stdin>" in p_stdin.stdout
            and "Piped stdin reference text" in stdin_xml
            and p_unk.returncode != 0
            and "oracle: error: unrecognized option: --unknown-option"
            in (p_unk.stdout + p_unk.stderr),
            f"stdin_rc={p_stdin.returncode} unk_rc={p_unk.returncode}\n{p_stdin.stdout}\n{p_unk.stderr}",
        )

        # Test 21: Wire API requests attach exact expected tools, thinking level, and X-Server-Timeout
        captured_reqs: list[dict] = []
        cap_lock = threading.Lock()

        class CaptureHandler(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
                obj = json.loads(body)
                obj["_x_server_timeout"] = self.headers.get("X-Server-Timeout")
                with cap_lock:
                    captured_reqs.append(obj)
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.end_headers()
                payload = (
                    b'data: {"candidates": [{"content": {"parts": [{"text":'
                    b' "Stub answer"}], "role": "model"}}],'
                    b' "usageMetadata": {"promptTokenCount": 10,'
                    b' "candidatesTokenCount": 2}}\r\n\r\n'
                )
                self.wfile.write(payload)
                self.wfile.flush()

            def log_message(self, *args):
                pass

        with serve_http(CaptureHandler) as (_, cap_url):
            cap_env = {
                **base_env,
                "GEMINI_API_KEY": "stub",
                "GOOGLE_GEMINI_BASE_URL": cap_url,
            }
            c1 = run_inproc(oracle, ["--no-serialize", "Default run"], env=cap_env)
            c2 = run_inproc(
                oracle, ["--no-serialize", "--no-search", "Closed run"], env=cap_env
            )
            c3 = run_inproc(
                oracle,
                ["--no-serialize", "--no-search", "--code", "Code run"],
                env=cap_env,
            )
            c4 = run_inproc(
                oracle,
                [
                    "--no-serialize",
                    "--thinking",
                    "medium",
                    "--request-timeout",
                    "2400",
                    "Medium run",
                ],
                env=cap_env,
            )

        def thinking_level_of(req: dict) -> str:
            cfg = req.get("generationConfig", {}).get("thinkingConfig", {})
            return str(cfg.get("thinkingLevel", cfg.get("thinking_level", ""))).upper()

        wire_ok = (
            all(r[0] == 0 for r in (c1, c2, c3, c4))
            and len(captured_reqs) == 4
            and (
                "googleSearch" in json.dumps(captured_reqs[0].get("tools"))
                or "google_search" in json.dumps(captured_reqs[0].get("tools"))
            )
            and "codeExecution" not in json.dumps(captured_reqs[0].get("tools"))
            and "code_execution" not in json.dumps(captured_reqs[0].get("tools"))
            and not captured_reqs[1].get("tools")
            and "Google Search"
            not in json.dumps(captured_reqs[1].get("systemInstruction", ""))
            and (
                "codeExecution" in json.dumps(captured_reqs[2].get("tools"))
                or "code_execution" in json.dumps(captured_reqs[2].get("tools"))
            )
            and "googleSearch" not in json.dumps(captured_reqs[2].get("tools"))
            and "google_search" not in json.dumps(captured_reqs[2].get("tools"))
            and thinking_level_of(captured_reqs[0]) == "HIGH"
            and thinking_level_of(captured_reqs[3]) == "MEDIUM"
            and captured_reqs[0].get("_x_server_timeout") == "1800"
            and captured_reqs[3].get("_x_server_timeout") == "2400"
            and "| search | thinking=high |" in c1[2]
            and "| none | thinking=high |" in c2[2]
            and "| code | thinking=high |" in c3[2]
            and "| search | thinking=medium |" in c4[2]
        )
        tap.check(
            "Sends expected wire tools and thinking config and status lines",
            wire_ok,
            f"reqs={len(captured_reqs)}",
        )

        # Test 22: --thinking defaults to high, honors ORACLE_THINKING, flag wins over env
        td_tel = work / "think_default.json"
        tf_tel = work / "think_flag.json"
        r22a = run_inproc(
            oracle,
            ["--dry-run", "Default thinking"],
            env={
                **base_env,
                "ORACLE_THINKING": None,
                "AGENT_TELEMETRY_JSON": str(td_tel),
            },
        )
        r22b = run_inproc(
            oracle,
            ["--dry-run", "--thinking", "medium", "Medium thinking"],
            env={
                **base_env,
                "ORACLE_THINKING": None,
                "AGENT_TELEMETRY_JSON": str(tf_tel),
            },
        )
        r22c = run_inproc(
            oracle,
            ["--dry-run", "Env thinking"],
            env={**base_env, "ORACLE_THINKING": "low"},
        )
        r22d = run_inproc(
            oracle,
            ["--dry-run", "--thinking", "medium", "Flag beats env"],
            env={**base_env, "ORACLE_THINKING": "low"},
        )
        r22e = run_inproc(
            oracle,
            ["--dry-run", "--thinking=low", "Equals form"],
            env={**base_env, "ORACLE_THINKING": None},
        )
        td_obj = (
            json.loads(td_tel.read_text(encoding="utf-8")) if td_tel.is_file() else {}
        )
        tf_obj = (
            json.loads(tf_tel.read_text(encoding="utf-8")) if tf_tel.is_file() else {}
        )
        tap.check(
            "--thinking default, flag, --thinking=LEVEL, ORACLE_THINKING, and flag-over-env precedence",
            all(r[0] == 0 for r in (r22a, r22b, r22c, r22d, r22e))
            and "Thinking:       high" in r22a[1]
            and td_obj.get("thinking_level") == "high"
            and "Thinking:       medium" in r22b[1]
            and tf_obj.get("thinking_level") == "medium"
            and "Thinking:       low" in r22c[1]
            and "Thinking:       medium" in r22d[1]
            and "Thinking:       low" in r22e[1],
            f"rcs={[r[0] for r in (r22a, r22b, r22c, r22d, r22e)]}",
        )

        # Test 23: --thinking rejects invalid levels and missing arguments with error telemetry
        bad_tel = work / "think_bad.json"
        r23a = run_inproc(
            oracle,
            ["--dry-run", "--thinking", "extreme", "Bad level"],
            env={**base_env, "AGENT_TELEMETRY_JSON": str(bad_tel)},
        )
        r23b = run_inproc(
            oracle,
            ["--dry-run", "Bad env level"],
            env={**base_env, "ORACLE_THINKING": "none"},
        )
        r23c = run_inproc(
            oracle, ["--dry-run", "Missing level", "--thinking"], env=base_env
        )
        r23d = run_inproc(
            oracle, ["--dry-run", "--thinking=", "Empty level"], env=base_env
        )
        bad_obj = (
            json.loads(bad_tel.read_text(encoding="utf-8")) if bad_tel.is_file() else {}
        )
        tap.check(
            "--thinking rejects invalid levels and missing arguments with error telemetry",
            r23a[0] != 0
            and "oracle: error: --thinking: invalid level: 'extreme' (choose from high, medium, low)"
            in r23a[2]
            and bad_obj.get("status") == "Error"
            and "--thinking: invalid level" in bad_obj.get("error", "")
            and r23b[0] != 0
            and "oracle: error: --thinking: invalid level: 'none'" in r23b[2]
            and r23c[0] != 0
            and "oracle: error: --thinking requires an argument" in r23c[2]
            and r23d[0] != 0
            and "oracle: error: --thinking requires an argument" in r23d[2],
            f"rcs={[r[0] for r in (r23a, r23b, r23c, r23d)]}",
        )

        # Tests 24-26: share one scripted HTTP server cleaned up in finally
        limit_script: list[str] = []
        limit_reqs: list[dict] = []
        limit_lock = threading.Lock()

        class ScriptedHandler(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
                with limit_lock:
                    limit_reqs.append(json.loads(body))
                    idx = min(len(limit_reqs), len(limit_script)) - 1
                    line = limit_script[idx]
                text, reason, token = line.split("|")
                parts = [{"text": "Planning the answer.", "thought": True}]
                if text:
                    parts.append({"text": text})
                candidate: dict = {
                    "content": {"parts": parts, "role": "model"},
                    "finishReason": reason,
                }
                if token:
                    candidate["continuationToken"] = token
                chunk = {
                    "candidates": [candidate],
                    "usageMetadata": {
                        "promptTokenCount": 10,
                        "candidatesTokenCount": 5,
                        "thoughtsTokenCount": 7,
                    },
                }
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.end_headers()
                self.wfile.write(b"data: " + json.dumps(chunk).encode() + b"\r\n\r\n")
                self.wfile.flush()

            def log_message(self, *args):
                pass

        limit_state = work / "limit-state"
        limit_tel = work / "limit.tel"

        with serve_http(ScriptedHandler) as (_, limit_url):

            def run_limited(lines: list[str], extra_args: list[str]):
                with limit_lock:
                    limit_script[:] = lines
                    limit_reqs.clear()
                if limit_tel.exists():
                    limit_tel.unlink()
                return run_inproc(
                    oracle,
                    [*extra_args, "Write a long report"],
                    env={
                        "ORACLE_MAX_OUTPUT_TOKENS": None,
                        "GEMINI_API_KEY": "stub",
                        "GOOGLE_GEMINI_BASE_URL": limit_url,
                        "AGENT_TELEMETRY_JSON": str(limit_tel),
                        "ORACLE_STATE_DIR": str(limit_state),
                    },
                )

            # Test 24: CONTINUATION hops merged into one streamed answer
            rc24, out24, err24 = run_limited(
                ["Part one, |CONTINUATION|dG9rZW4tMQ==", "part two.|STOP|"], []
            )
            ans24_p = extract_answer_path(err24)
            tel24 = (
                json.loads(limit_tel.read_text(encoding="utf-8"))
                if limit_tel.is_file()
                else {}
            )
            reqs24 = list(limit_reqs)
            ok24 = (
                rc24 == 0
                and len(reqs24) == 2
                and all(
                    r["generationConfig"]["maxOutputTokens"] == 131072
                    and len(r["contents"]) == 1
                    for r in reqs24
                )
                and "continuationToken" not in reqs24[0]
                and reqs24[1].get("continuationToken") == "dG9rZW4tMQ=="
                and tel24.get("status") == "Succeeded"
                and tel24.get("max_output_tokens") == 131072
                and tel24.get("finish_reason") == "STOP"
                and tel24.get("continuation_tokens") == 1
                and tel24.get("truncated") is False
                and tel24.get("candidate_tokens") == 10
                and tel24.get("thinking_tokens") == 14
                and "Part one, part two." in out24.splitlines()
                and ans24_p is not None
                and ans24_p.read_text(encoding="utf-8") == "Part one, part two."
            )
            tap.check(
                "Sends max_output_tokens and streams CONTINUATION hops as one answer",
                ok24,
                f"rc={rc24} reqs={len(reqs24)} tel={tel24!r}\n{out24}\n{err24}",
            )

            # Test 25: MAX_TOKENS keeps partial answer, warns, and exits 1
            rc25, out25, err25 = run_limited(
                ["Cut off mid-sent|MAX_TOKENS|"], ["--max-output-tokens", "70000"]
            )
            ans25_p = extract_answer_path(err25)
            ans25_txt = ans25_p.read_text(encoding="utf-8") if ans25_p else ""
            tel25 = (
                json.loads(limit_tel.read_text(encoding="utf-8"))
                if limit_tel.is_file()
                else {}
            )
            reqs25 = list(limit_reqs)
            ok25 = (
                rc25 == 1
                and len(reqs25) == 1
                and reqs25[0]["generationConfig"]["maxOutputTokens"] == 70000
                and "Cut off mid-sent" in out25.splitlines()
                and "warning: answer is incomplete: the response reached --max-output-tokens (70000, thinking included)"
                in err25
                and tel25.get("truncated") is True
                and tel25.get("finish_reason") == "MAX_TOKENS"
                and tel25.get("status") == "Error"
                and "answer is incomplete" in tel25.get("error", "")
                and "Cut off mid-sent" in ans25_txt.splitlines()
                and "<!-- oracle: answer is incomplete" in ans25_txt
            )
            tap.check(
                "Warns, keeps the partial answer, and exits 1 when the output ceiling is reached",
                ok25,
                f"rc={rc25} tel={tel25!r}\n{out25}\n{err25}",
            )

            # Test 26: empty answer exits 1 with a warning
            rc26a, _, err26a = run_limited(["|MAX_TOKENS|"], [])
            rc26b, _, err26b = run_limited(["|STOP|"], [])
            tel26b = (
                json.loads(limit_tel.read_text(encoding="utf-8"))
                if limit_tel.is_file()
                else {}
            )
            ok26 = (
                rc26a == 1
                and "warning: answer is incomplete" in err26a
                and "saved answer" not in err26a
                and rc26b == 1
                and "warning: the model returned no answer text (finish reason: STOP)"
                in err26b
                and "the model returned no answer text" in tel26b.get("error", "")
            )
            tap.check(
                "An empty answer exits 1 with a warning",
                ok26,
                f"rc=({rc26a},{rc26b})\n{err26a}\n{err26b}\n{tel26b!r}",
            )

        # Test 27: --max-output-tokens default, ORACLE_MAX_OUTPUT_TOKENS, precedence, validation
        mo_tel = work / "mo_default.json"
        r27_def = run_inproc(
            oracle,
            ["--dry-run", "Default"],
            env={
                **base_env,
                "ORACLE_MAX_OUTPUT_TOKENS": None,
                "AGENT_TELEMETRY_JSON": str(mo_tel),
            },
        )
        r27_env = run_inproc(
            oracle,
            ["--dry-run", "Env"],
            env={**base_env, "ORACLE_MAX_OUTPUT_TOKENS": "262144"},
        )
        r27_both = run_inproc(
            oracle,
            ["--dry-run", "--max-output-tokens=65536", "Both"],
            env={**base_env, "ORACLE_MAX_OUTPUT_TOKENS": "262144"},
        )
        r27_bad = run_inproc(
            oracle, ["--dry-run", "--max-output-tokens", "128k", "Bad"], env=base_env
        )
        r27_badenv = run_inproc(
            oracle,
            ["--dry-run", "Bad env"],
            env={**base_env, "ORACLE_MAX_OUTPUT_TOKENS": "0"},
        )
        r27_miss = run_inproc(
            oracle, ["--dry-run", "Missing", "--max-output-tokens"], env=base_env
        )
        mo_tel_obj = (
            json.loads(mo_tel.read_text(encoding="utf-8")) if mo_tel.is_file() else {}
        )
        tap.check(
            "--max-output-tokens default, ORACLE_MAX_OUTPUT_TOKENS, precedence, and validation",
            r27_def[0] == 0
            and r27_env[0] == 0
            and r27_both[0] == 0
            and "Max Output:     131072 tokens" in r27_def[1]
            and mo_tel_obj.get("max_output_tokens") == 131072
            and "Max Output:     262144 tokens" in r27_env[1]
            and "Max Output:     65536 tokens" in r27_both[1]
            and r27_bad[0] != 0
            and "oracle: error: --max-output-tokens: invalid token count: '128k'"
            in r27_bad[2]
            and r27_badenv[0] != 0
            and "oracle: error: --max-output-tokens: invalid token count: '0'"
            in r27_badenv[2]
            and r27_miss[0] != 0
            and "oracle: error: --max-output-tokens requires an argument"
            in r27_miss[2],
            f"rcs={[r[0] for r in (r27_def, r27_env, r27_both, r27_bad, r27_badenv, r27_miss)]}",
        )

    return 1 if tap.failed else 0


