# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
import sys
from pathlib import Path

source = Path(sys.argv[1]).read_text()
stripped = "\n".join(
    line
    for line in source.splitlines()
    if not line.startswith(("from google", "import httpx"))
