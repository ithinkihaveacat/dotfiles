#!/usr/bin/env bash

# Tests: skills/agent-tools/tests/test-pascal

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/pascal"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/shim"
OUTPUT="$WORK/out.log"

cat >"$WORK/shim/curl" <<'EOF'
#!/bin/sh
cat >/dev/null 2>&1
printf '{"candidates":[{"content":{"parts":[{"text":"Four."}]},"finishReason":"STOP"}]}\n200'
EOF
chmod +x "$WORK/shim/curl"

LIVE=false
if [[ -n "${GEMINI_API_KEY:-}" && "${AGENT_OFFLINE:-}" != "1" ]]; then
  LIVE=true
fi

echo "1..5"

# Test 1: Missing prompt is a usage error (hermetic)
if PATH="$WORK/shim:$PATH" GEMINI_API_KEY="${GEMINI_API_KEY:-dummy}" "$BIN" >"$OUTPUT" 2>&1 </dev/null; then
  echo "not ok 1 - Script succeeded with no arguments (expected non-zero exit)"
  sed 's/^/# /' "$OUTPUT"
else
  if grep -q "missing PROMPT argument" "$OUTPUT"; then
    echo "ok 1 - Missing prompt reported as an error"
  else
    echo "not ok 1 - Error output missing expected text"
    sed 's/^/# /' "$OUTPUT"
  fi
fi

# Test 2: Simple Query (live API only)
if $LIVE; then
  QUERY="What is 2 + 2? Answer in one word."
  if RESPONSE=$("$BIN" "$QUERY"); then
    if grep -qi "four" <<<"$RESPONSE" || [[ "$RESPONSE" == *'4'* ]]; then
      echo "ok 2 - Simple query returned correct answer"
    else
      echo "not ok 2 - Simple query returned unexpected answer: $RESPONSE"
    fi
  else
    echo "not ok 2 - Simple query failed to execute"
  fi
else
  echo "ok 2 # SKIP GEMINI_API_KEY not set or AGENT_OFFLINE=1"
fi

# Test 3: Context Query (live API only)
if $LIVE; then
  CONTEXT="The secret code is 'bananarama'."
  QUERY="What is the secret code?"
  if RESPONSE=$(echo "$CONTEXT" | "$BIN" - "$QUERY"); then
    if grep -qi "bananarama" <<<"$RESPONSE"; then
      echo "ok 3 - Context query returned correct answer"
    else
      echo "not ok 3 - Context query returned unexpected answer: $RESPONSE"
    fi
  else
    echo "not ok 3 - Context query failed to execute"
  fi
else
  echo "ok 3 # SKIP GEMINI_API_KEY not set or AGENT_OFFLINE=1"
fi

# Test 4: Warning on fast piped input (hermetic with curl shim offline)
if $LIVE; then
  echo "secret is xyz" | "$BIN" "What is 2+2?" >/dev/null 2>"$OUTPUT" || true
else
  echo "secret is xyz" | PATH="$WORK/shim:$PATH" GEMINI_API_KEY=dummy "$BIN" "What is 2+2?" >/dev/null 2>"$OUTPUT" || true
fi
if grep -q "warning: stdin contains piped input" "$OUTPUT"; then
  echo "ok 4 - Fast piped input warning printed"
else
  echo "not ok 4 - Warning not printed for fast piped input"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 5: Warning on slow piped input (hermetic with curl shim offline)
if $LIVE; then
  ( (
    sleep 0.2
    echo "secret is xyz"
  ) | "$BIN" "What is 2+2?" >/dev/null 2>"$OUTPUT") || true
else
  ( (
    sleep 0.2
    echo "secret is xyz"
  ) | PATH="$WORK/shim:$PATH" GEMINI_API_KEY=dummy "$BIN" "What is 2+2?" >/dev/null 2>"$OUTPUT") || true
fi
if grep -q "warning: stdin contains piped input" "$OUTPUT"; then
  echo "ok 5 - Slow piped input warning printed"
else
  echo "not ok 5 - Warning not printed for slow piped input"
  sed 's/^/# /' "$OUTPUT"
fi
