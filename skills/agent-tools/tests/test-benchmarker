    grep -q '"status": "TerminatedGracefully"' "$OUTDIR_GRACE"/runs/*/telemetry.json; then
    echo "ok 12 - Gracefully sends SIGTERM allowing child process to flush telemetry during grace period"
  else
    echo "not ok 12 - Graceful termination telemetry was not captured on timeout"
    sed 's/^/# /' "$OUTPUT"
  fi
fi

