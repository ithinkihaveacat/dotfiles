if "$BIN" --cmd "$MOCK_TASK_RUNNER '{prompt}' {task_flags}" \
  --tasks "$TASKS_DIR" \
  --output-dir "$OUTDIR_TASKS" >"$OUTPUT" 2>&1; then
  if grep -q '"task":"task_greeting"' "$OUTDIR_TASKS/index.jsonl" &&
    grep -q '"verify_passed":true' "$OUTDIR_TASKS/index.jsonl"; then
    echo "ok 8 - Discovers task directory, executes setup and verify hooks, and reports verification"
  else
    echo "not ok 8 - Task execution or verification was not recorded properly"
    sed 's/^/# /' "$OUTPUT"
