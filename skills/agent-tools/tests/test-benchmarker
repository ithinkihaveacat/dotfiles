# Test 12: Graceful SIGTERM escalation allows child processes to flush telemetry before kill
OUTDIR_GRACE="$WORK/bench_grace"
MOCK_TRAP_TOOL="$WORK/mock_trap_tool.sh"
cat <<'EOF' >"$MOCK_TRAP_TOOL"
#!/usr/bin/env bash
cleanup() {
  if [[ -n "${AGENT_TELEMETRY_JSON:-}" ]]; then
    cat <<TEL >"$AGENT_TELEMETRY_JSON"
{
  "status": "TerminatedGracefully",
  "steps": 2,
  "prompt_tokens": 5000,
  "candidate_tokens": 100
}
TEL
  fi
  exit 0
}
trap cleanup TERM INT
sleep 10 &
wait $!
EOF
chmod +x "$MOCK_TRAP_TOOL"

if "$BIN" --cmd "$MOCK_TRAP_TOOL" \
  --timeout 1 \
  --output-dir "$OUTDIR_GRACE" >"$OUTPUT" 2>&1; then
  echo "not ok 12 - Expected timeout run to return non-zero exit code"
else
  if grep -q '"status":"timed_out"' "$OUTDIR_GRACE/index.jsonl" &&
