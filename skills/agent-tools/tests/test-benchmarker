#!/usr/bin/env bash

# Tests: skills/agent-tools/tests/test-benchmarker

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/benchmarker"

OUTPUT=$(mktemp)
WORK=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$OUTPUT" "$WORK"' EXIT

echo "1..17"

# Test 1: benchmarker --help
if "$BIN" --help >"$OUTPUT" 2>&1; then
  if grep -q "Usage: benchmarker" "$OUTPUT" && grep -q "Options:" "$OUTPUT" && grep -q "Examples:" "$OUTPUT"; then
    echo "ok 1 - Help output is formatted correctly"
  else
    echo "not ok 1 - Help output missing expected sections"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 1 - benchmarker --help exited non-zero"
fi

# Test 2: Bare benchmarker prints short usage and exits 1
if "$BIN" >"$OUTPUT" 2>&1; then
  echo "not ok 2 - Expected bare benchmarker to fail"
else
  if grep -q "Usage: benchmarker" "$OUTPUT" && grep -q "Try 'benchmarker --help'" "$OUTPUT"; then
    echo "ok 2 - Bare benchmarker prints concise usage to stderr"
  else
    echo "not ok 2 - Bare benchmarker output missing expected usage"
    sed 's/^/# /' "$OUTPUT"
  fi
fi

# Test 3: --dry-run expands Cartesian product matrix correctly
if "$BIN" --cmd "echo '{script} {model} {trial}'" \
  --dim script=v1,v2 \
  --dim model=pro,flash \
  --trials 2 \
  --dry-run >"$OUTPUT" 2>&1; then
  if grep -q "Generated 8 run(s) across 4 parameter combination(s)" "$OUTPUT" &&
    grep -q "CMD: echo 'v1 pro 1'" "$OUTPUT" &&
    grep -q "CMD: echo 'v2 flash 2'" "$OUTPUT"; then
    echo "ok 3 - --dry-run expands Cartesian product matrix"
  else
    echo "not ok 3 - Dry-run matrix schedule did not match expected combinations"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 3 - --dry-run exited non-zero"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 4: Real execution creates directory artifacts and index.jsonl
OUTDIR="$WORK/bench_out"
if "$BIN" --cmd "echo 'result for {var}'" \
  --dim var=A,B \
  --trials 1 \
  --workers 2 \
  --output-dir "$OUTDIR" >"$OUTPUT" 2>&1; then
  if [[ -f "$OUTDIR/index.jsonl" ]] && [[ $(wc -l <"$OUTDIR/index.jsonl" | awk '{print $1}') -eq 2 ]] &&
    grep -q "result for A" "$OUTDIR"/runs/*/stdout.txt &&
    grep -q "result for B" "$OUTDIR"/runs/*/stdout.txt; then
    echo "ok 4 - Executes matrix and populates output directory with index.jsonl and artifacts"
  else
    echo "not ok 4 - Output artifacts missing or incomplete"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 4 - Execution failed"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 5: AGENT_TELEMETRY_JSON is passed and captured in metadata.json & index.jsonl
OUTDIR_TEL="$WORK/bench_tel"
MOCK_TOOL="$WORK/mock_tool.sh"
cat <<'EOF' >"$MOCK_TOOL"
#!/usr/bin/env bash
echo "tool output for $1"
if [[ -n "${AGENT_TELEMETRY_JSON:-}" ]]; then
  cat <<TEL >"$AGENT_TELEMETRY_JSON"
{
  "status": "Succeeded",
  "steps": 3,
  "prompt_tokens": 12000,
  "candidate_tokens": 450,
  "tools": {
    "search_replace": {
      "attempts": 2,
      "successes": 2,
      "failures": 0
    }
  }
}
TEL
fi
exit 0
EOF
chmod +x "$MOCK_TOOL"

if "$BIN" --cmd "$MOCK_TOOL '{name}'" \
  --dim name=test1 \
  --output-dir "$OUTDIR_TEL" >"$OUTPUT" 2>&1; then
  INDEX_CONTENT=$(cat "$OUTDIR_TEL/index.jsonl")
  if grep -q '"prompt_tokens":12000' "$OUTDIR_TEL/index.jsonl" &&
    grep -q '"steps":3' "$OUTDIR_TEL/index.jsonl" &&
    grep -q '"tool_calls":2' "$OUTDIR_TEL/index.jsonl" &&
    grep -q '"tool_successes":2' "$OUTDIR_TEL/index.jsonl" &&
    grep -q '"search_replace"' "$OUTDIR_TEL"/runs/*/telemetry.json; then
    echo "ok 5 - Captures AGENT_TELEMETRY_JSON and indexes token/step/tool telemetry"
  else
    echo "not ok 5 - Telemetry JSON was not captured or indexed correctly"
    echo "# index.jsonl: $INDEX_CONTENT"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 5 - Telemetry test run failed"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 6: Captures git diffs in ephemeral worktrees (including untracked files)
OUTDIR_DIFF="$WORK/bench_diff"
MOCK_MUTATOR="$WORK/mock_mutator.sh"
cat <<'EOF' >"$MOCK_MUTATOR"
#!/usr/bin/env bash
git init -q .
git config user.email "test@example.com"
git config user.name "Test"
printf "initial\n" > file.txt
git add file.txt
git commit -q -m "initial"
printf "modified by mutator\n" > file.txt
printf "new file\n" > added.txt
EOF
chmod +x "$MOCK_MUTATOR"

if "$BIN" --cmd "$MOCK_MUTATOR" \
  --dim trial=1 \
  --output-dir "$OUTDIR_DIFF" >"$OUTPUT" 2>&1; then
  DIFF_FILE=$(ls "$OUTDIR_DIFF"/runs/*/diff.patch 2>/dev/null || true)
  if [[ -n "$DIFF_FILE" ]] && grep -q -- "-initial" "$DIFF_FILE" &&
    grep -q -- "+modified by mutator" "$DIFF_FILE" &&
    grep -q -- "+new file" "$DIFF_FILE"; then
    echo "ok 6 - Captures git diff patches from ephemeral worktrees"
  else
    echo "not ok 6 - diff.patch missing or did not capture modified file"
    sed 's/^/# /' "$OUTPUT"
  fi
else
  echo "not ok 6 - Git diff test execution failed"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 7: Timeouts terminate process group cleanly and record status
OUTDIR_TO="$WORK/bench_timeout"
if "$BIN" --cmd "sleep 10" \
  --timeout 1 \
  --output-dir "$OUTDIR_TO" >"$OUTPUT" 2>&1; then
  echo "not ok 7 - Expected timeout run to return non-zero overall"
else
  if grep -q '"status":"timed_out"' "$OUTDIR_TO/index.jsonl" &&
    grep -q '"exit_code":124' "$OUTDIR_TO/index.jsonl"; then
    echo "ok 7 - Enforces timeout, terminates process group, and records timed_out exit code 124"
  else
    echo "not ok 7 - Timeout status or exit code not recorded as expected"
    sed 's/^/# /' "$OUTPUT"
  fi
fi

