#!/usr/bin/env python3
"""Single-purpose HTTP stub for the Gemini Interactions endpoint.

Used by skills/agent-tools/tests/test-gemini-cli-contract to run the real
`gemini-api` binary without network access. Serves any number of requests with
a fixed status/body, and appends each request body to a record file so a test
can assert on what the CLI actually sent.

  gemini-api-stub --port PORT --response FILE [--status CODE] [--record FILE]

Exits 0 when killed. Prints nothing unless the request is malformed.
"""

import argparse
import json
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer


class Handler(BaseHTTPRequestHandler):
    response_body = b"{}"
    status = 200
    record = None

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length)
        if self.record:
            with open(self.record, "ab") as fh:
                fh.write(body + b"\n")
        self.send_response(self.status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(self.response_body)))
        self.end_headers()
        self.wfile.write(self.response_body)

    def log_message(self, *args):
        pass


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, required=True)
    ap.add_argument("--response", required=True)
    ap.add_argument("--status", type=int, default=200)
    ap.add_argument("--record")
    args = ap.parse_args()

    with open(args.response, "rb") as fh:
        Handler.response_body = fh.read()
    Handler.status = args.status
    Handler.record = args.record

    if args.status >= 400:
        # Same envelope shape the real service uses for errors.
        try:
            json.loads(Handler.response_body)
        except json.JSONDecodeError as exc:
            print(f"bad error fixture: {exc}", file=sys.stderr)
            return 1

    server = HTTPServer(("127.0.0.1", args.port), Handler)
    print("READY", flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
