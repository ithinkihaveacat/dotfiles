#!/usr/bin/env -S uv run --script
# Requires uv (https://docs.astral.sh/uv/).
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "uiautomator2",
#   "google-genai>=2.31.0",
#   "google-api-core",
#   "pillow",
#   # apkutils is an optional dependency of uiautomator2, needed for installing
#   # its agent APKs onto the device. Must be declared explicitly for uv to
#   # include it.
#   "apkutils",
# ]
# ///
# Tests: skills/agent-tools/tests/test-popper
"""AI-driven semantic UI interaction for Android via ADB."""

import argparse
import atexit
import base64
import datetime
import io
import json
import os
import re
import signal
import sys
import tempfile
import time
import xml.etree.ElementTree as ET

import uiautomator2 as u2
from google import genai
from google.api_core import retry
from google.genai import types

DEFAULT_MODEL = "gemini-3.8-flash"

# A window token in `dumpsys window` output: "Window{90c2680 u0 PKG/ACTIVITY}" or,
# for mFocusedApp, "ActivityRecord{113077881 u0 PKG/ACTIVITY t21}". System windows
# such as "Window{... u0 NotificationShade}" have no "/" and do not match.
_FOCUS_RE = re.compile(r"\bu\d+ ([A-Za-z0-9_.]+)/")


def callable_to_interaction_tool(client: genai.Client, fn) -> dict:
    """Convert a Python tool function into an Interactions API function tool dict."""
    fd = types.FunctionDeclaration.from_callable(
        client=client, callable=fn, use_json_schema=True
    )
    return {
        "type": "function",
        "name": fd.name,
        "description": fd.description or "",
        "parameters": fd.parameters_json_schema or {"type": "object", "properties": {}},
    }


def error_status_code(exc: Exception) -> int | None:
    """Extract an HTTP status code from APIError, Interactions GenAiError, or its cause."""
    for err in (exc, exc.__cause__):
        if err is None:
            continue
        code = getattr(err, "code", None)
        if code is None:
            code = getattr(err, "status_code", None)
        if isinstance(code, int):
            return code
    return None


def is_retryable_interaction_error(exc: Exception) -> bool:
    """Whether an Interactions API error or timeout should be retried."""
    if isinstance(exc, TimeoutError) or type(exc).__name__ == "APITimeoutError":
        return True
    if isinstance(exc.__cause__, TimeoutError):
        return True
    return error_status_code(exc) in (429, 500, 502, 503, 504)


def foreground_package(d) -> str:
    """Return the package of the foreground app, or "" if it cannot be found.

    uiautomator2's d.app_current() returns stale packages on some devices (for
    example, the Play Store while Chrome is in front on a Pixel 6 Pro, SDK 37),
    so this reads the window manager's state directly. The focused window
    (mCurrentFocus) wins, so that a dialog from another package counts as
    leaving the app; when focus is on a system window that belongs to no app
    (the notification shade, the lock screen), the focused app's activity
    (mFocusedApp) is used instead.
    """
    try:
        output = d.shell("dumpsys window").output
    except Exception:
        output = ""
    for key in ("mCurrentFocus=", "mFocusedApp="):
        for line in output.splitlines():
            line = line.strip()
            if line.startswith(key):
                m = _FOCUS_RE.search(line)
                if m:
                    return m.group(1)
    try:
        return d.app_current().get("package", "")
    except Exception:
        return ""


def offline_switch() -> tuple[bool, str]:
    """Whether network access is forbidden here, and which switch says so."""
    var = "AGENT_OFFLINE"
    value = os.environ.get(var, "")
    return value.strip().lower() in ("1", "true", "yes", "on"), f"{var}={value}"


def main():
    if len(sys.argv) == 1:
        sys.argv.append("--help")

    parser = argparse.ArgumentParser(
        description="Interact with Android UIs using an AI agent.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        add_help=False,
        epilog="""
Environment:
  ANDROID_SERIAL  Serial number of device to connect to (see 'adb devices -l').
                  To target a specific device, use:
                    env ANDROID_SERIAL=<serial> popper "accept all permissions"
  GEMINI_API_KEY  Required. Your Gemini API key.
  GEMINI_MODEL    Optional. Default model if --model is not given.
  AGENT_OFFLINE   Refuse to use the network. This tool caches nothing, so
                  offline mode fails immediately rather than serving a stale
                  answer.
""",
    )
    parser.add_argument(
        "goal",
        type=str,
        nargs="?",
        help="The goal for the AI to achieve (e.g. 'start an exercise')",
    )
    parser.add_argument(
        "--launch",
        type=str,
        metavar="PACKAGE",
        help="Launch the specified app before starting (e.g. com.example.fitness)",
    )
    parser.add_argument(
        "--stay-in-app",
        action="store_true",
        help="Restrict the agent to a single application package for the entire run",
    )
    parser.add_argument(
        "--dismiss-interstitials",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Close cookie banners, sign-up popups and similar clutter that "
        "covers the content; login screens are left alone (default: enabled)",
    )
    parser.add_argument(
        "--timeout",
        type=int,
        default=180,
        metavar="SECONDS",
        help="Maximum execution time in seconds (default: 180; exit code 2 on timeout)",
    )
    parser.add_argument(
        "--output-format",
        choices=["text", "stream-json"],
        default="text",
        help="Output format: 'text' (default, human-readable) or 'stream-json' (NDJSON to stdout)",
    )
    parser.add_argument(
        "--agent-screenshots",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Enable/disable transmitting screenshots to the Gemini API (default: enabled)",
    )
    parser.add_argument(
        "--local-screenshots",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Enable/disable saving screenshots to the local disk for debugging (default: enabled)",
    )
    parser.add_argument(
        "--local-screenshot-dir",
        type=str,
        metavar="DIR",
        help="Directory to save step-by-step debug screenshots (default: XDG_RUNTIME_DIR/popper or fallback to tmp)",
    )
    parser.add_argument(
        "--output-dir",
        type=str,
        default=".",
        metavar="DIR",
        help="Directory to save explicit screenshots requested by the agent (default: current directory)",
    )
    parser.add_argument(
        "--dump-layout",
        action="store_true",
        help="Dump the UI layout as JSON and exit",
    )
    parser.add_argument(
        "--model",
        type=str,
        default=os.environ.get("GEMINI_MODEL", DEFAULT_MODEL),
        metavar="MODEL",
        help=f"Gemini model to use (default: $GEMINI_MODEL if set, else {DEFAULT_MODEL})",
    )
    parser.add_argument(
        "-h",
        "--help",
        action="help",
        default=argparse.SUPPRESS,
        help="show this help message and exit",
    )

    args = parser.parse_args()
    if not args.dump_layout and not args.goal:
        parser.error("the following arguments are required: goal")

    # Checked here, before any device or session setup, because everything below
    # has side effects on the phone: connecting, changing the screen timeout,
    # unlocking, and with --launch starting an app. A run that cannot reach the
    # model must not leave the device in a different state than it found it, and
    # must fail naming the switch rather than on whatever device error happens
    # to surface first. --dump-layout is exempt: it never calls the API.
    if not args.dump_layout:
        offline, desc = offline_switch()
        if offline:
            print(
                f"popper: offline ({desc}) and no cached answer: this command "
                "calls the Gemini API. Re-run where there is network, or set "
                "AGENT_OFFLINE=0 to exempt this tool",
                file=sys.stderr,
            )
            sys.exit(1)

    step = 0
    context_usage = {
        "input_limit": 1048576,  # Default fallback
        "prompt_tokens": 0,
        "candidate_tokens": 0,
    }

    def emit(event: dict):
        """Emit a stream-json event to stdout."""
        if args.output_format != "stream-json":
            return
        event["timestamp"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
        print(json.dumps(event, separators=(",", ":")), flush=True)

    def timeout_handler(signum, frame):
        emit(
            {
                "type": "result",
                "success": False,
                "reason": "timeout",
                "steps": step,
                "elapsed_ms": args.timeout * 1000,
            }
        )
        print(
            f"popper: timed out after {args.timeout} seconds",
            file=sys.stderr,
        )
        sys.exit(2)

    if args.timeout:
        if hasattr(signal, "SIGALRM"):
            signal.signal(signal.SIGALRM, timeout_handler)
            signal.alarm(args.timeout)
        else:
            print(
                "popper: --timeout is not supported on this platform (requires SIGALRM)",
                file=sys.stderr,
            )

    api_key = os.environ.get("GEMINI_API_KEY")
    if not api_key:
        print("popper: GEMINI_API_KEY environment variable not set", file=sys.stderr)
        sys.exit(1)

    # Setup XDG-compliant run directory
    session_timestamp = datetime.datetime.now(datetime.timezone.utc).strftime(
        "%Y%m%d_%H%M%S"
    )
    session_id = f"run_{session_timestamp}_{os.getpid()}"

    if args.local_screenshot_dir:
        base_temp_dir = args.local_screenshot_dir
    else:
        xdg_runtime = os.environ.get("XDG_RUNTIME_DIR")
        base_temp_dir = (
            os.path.join(xdg_runtime, "popper")
            if xdg_runtime
            else os.path.join(tempfile.gettempdir(), "popper")
        )

    session_dir = os.path.join(base_temp_dir, session_id)
    if args.local_screenshots:
        os.makedirs(session_dir, exist_ok=True)
        print(f"[local] Screenshots will be saved to: {session_dir}", file=sys.stderr)

    serial = os.environ.get("ANDROID_SERIAL")
    try:
        # Connect to the device
        if not args.dump_layout:
            print(
                f"[local] Connecting to device {serial or 'default'}",
                file=sys.stderr,
            )
        d = u2.connect(serial)
    except Exception as e:
        print(f"popper: Failed to connect to device: {e}", file=sys.stderr)
        sys.exit(1)

    # --- SLEEP PREVENTION STARTUP ---
    original_timeout = "30000"  # Default fallback (30s)
    if not args.dump_layout:
        try:
            val = d.shell("settings get system screen_off_timeout").output.strip()
            if val.isdigit():
                original_timeout = val

            # Elevate the screen-off timeout to 30 minutes (1800000 ms)
            d.shell("settings put system screen_off_timeout 1800000")
            print(
                f"[local] Saved original timeout ({original_timeout}ms) and set to 30 minutes",
                file=sys.stderr,
            )
        except Exception as e:
            print(
                f"[local] Warning: Could not manage screen timeout: {e}",
                file=sys.stderr,
            )

        # Wake up and unlock the screen with shell commands. uiautomator2's
        # d.screen_on() and d.unlock() call d.info, which crashes on SDK 37+ with
        # "ApplicationSharedMemory not initialized", leaving the device asleep on
        # the lock screen. Reported, unfixed as of 2026-11-21:
        # https://github.com/openatx/uiautomator2/issues/1209
        # Return to d.screen_on() and d.unlock() once d.info works on SDK 37.
        # dismiss-keyguard cannot get past a PIN, pattern or password.
        try:
            print("[local] Waking up and unlocking device...", file=sys.stderr)
            d.shell("input keyevent KEYCODE_WAKEUP")
            d.shell("wm dismiss-keyguard")
            time.sleep(1.0)
            keyguard = d.shell("dumpsys window | grep isKeyguardShowing").output
            if "isKeyguardShowing=true" in keyguard:
                print(
                    "[local] Warning: Lock screen is still showing; unlock the device by hand",
                    file=sys.stderr,
                )
        except Exception as e:
            print(f"[local] Warning: Failed to unlock screen: {e}", file=sys.stderr)

        # Register immediate restore on exit using atexit
        def restore_timeout():
            try:
                d.shell(f"settings put system screen_off_timeout {original_timeout}")
                print(
                    f"[local] Restored screen-off timeout to {original_timeout} ms",
                    file=sys.stderr,
                )
            except Exception as e:
                print(
                    f"[local] Warning: Failed to restore screen timeout: {e}",
                    file=sys.stderr,
                )

        atexit.register(restore_timeout)
    # --- SLEEP PREVENTION STARTUP END ---

    current_layout_map = {}

    def get_ui_state():
        current_layout_map.clear()
        try:
            res = []
            nodes = [
                n
                for n in ET.fromstring(d.dump_hierarchy()).iter("node")
                if n.get("text") or n.get("content-desc")
            ]
            for idx, n in enumerate(nodes):
                b = [int(x) for x in re.findall(r"\d+", n.get("bounds") or "")]
                if len(b) >= 4:
                    cx, cy = (b[0] + b[2]) // 2, (b[1] + b[3]) // 2
                    element_id = f"{step}:{idx}"
                    item = {
                        "id": element_id,
                        "text": n.get("text"),
                        "content-desc": n.get("content-desc"),
                        "resource-id": n.get("resource-id").split("/")[-1]
                        if n.get("resource-id")
                        else "",
                        "center": f"[{cx},{cy}]",
                    }
                    current_layout_map[element_id] = {
                        "coords": (cx, cy),
                        "text": item["text"],
                        "desc": item["content-desc"],
                        "res_id": item["resource-id"],
                    }
                    res.append({k: v for k, v in item.items() if v})
            return json.dumps(res, ensure_ascii=False)
        except Exception:
            return "[]"

    if args.dump_layout:
        print(get_ui_state())
        sys.exit(0)

    print("[local] Initializing AI", file=sys.stderr)

    # Screen wake and unlock now handled dynamically during startup

    if args.launch:
        print(f"[local] Launching {args.launch}", file=sys.stderr)
        try:
            d.app_start(args.launch)

            # Polling the window manager is used because d.app_current() and
            # d.app_wait() were unreliable/stale on some devices.
            timeout_seconds = 10.0
            start_time = time.perf_counter()
            while time.perf_counter() - start_time < timeout_seconds:
                if foreground_package(d) == args.launch:
                    break
                time.sleep(0.5)
            else:
                print(
                    f"[local] Warning: {args.launch} did not reach foreground within {timeout_seconds}s (ADB check).",
                    file=sys.stderr,
                )
            # Brief buffer to allow layout inflation and entry animations to fully settle
            time.sleep(1.0)
        except Exception as e:
            print(f"popper: failed to launch {args.launch}: {e}", file=sys.stderr)
            sys.exit(1)

    # Note: `app_auto_grant_permissions(pkg)` is intentionally omitted.
    # We want this script to replicate manual UI actions (taps, swipes) as much as possible.

    # Get device metadata to help the agent
    try:
        # d.app_current() is not used: it can report a stale package (see
        # foreground_package). Its activity name is not needed either.
        initial_package = foreground_package(d)
        device_info = {"package": initial_package}

        # Fallback to shell commands because uiautomator2's d.info crashes on SDK 37+ with
        # "IllegalStateException: ApplicationSharedMemory not initialized". To check if this
        # is fixed, try calling d.info on an SDK 37+ device and see if it still throws.
        # https://github.com/openatx/uiautomator2/issues/1209
        try:
            size_output = d.shell("wm size").output.strip()
            if "Physical size: " in size_output:
                dims = size_output.replace("Physical size: ", "").split("x")
                if len(dims) == 2:
                    device_info["display_width"] = int(dims[0].strip())
                    device_info["display_height"] = int(dims[1].strip())

            density_output = d.shell("wm density").output.strip()
            if "Physical density: " in density_output:
                density_val = density_output.replace("Physical density: ", "").strip()
                if density_val.isdigit():
                    device_info["display_density"] = int(density_val)

            sdk_output = d.shell("getprop ro.build.version.sdk").output.strip()
            if sdk_output.isdigit():
                device_info["sdk_int"] = int(sdk_output)
        except Exception as e:
            print(
                f"[local] Warning: Could not get extended device info: {e}",
                file=sys.stderr,
            )

        # Determine if it's a watch, tv, auto, or generic mobile device
        characteristics = d.shell("getprop ro.build.characteristics").output.strip()
        device_info["characteristics"] = characteristics
        if "watch" in characteristics:
            device_info["device_type"] = "Wear OS Watch"
        elif "tv" in characteristics:
            device_info["device_type"] = "Android TV"
        elif "automotive" in characteristics:
            device_info["device_type"] = "Android Automotive"
        else:
            device_info["device_type"] = "Android Phone/Tablet"

        print(f"[local] Device Info: {device_info}", file=sys.stderr)
    except Exception as e:
        device_info = {}
        initial_package = ""
        print(f"[local] Warning: Failed to get device info: {e}", file=sys.stderr)
    print(f"[local] Starting package: {initial_package}", file=sys.stderr)

    restricted_package = initial_package if args.stay_in_app else ""
    if args.stay_in_app and not restricted_package:
        print(
            "popper: --stay-in-app requires a current app package; launch an app first or use --launch",
            file=sys.stderr,
        )
        sys.exit(1)

    client = genai.Client()

    try:
        model_info = client.models.get(model=args.model)
        context_usage["input_limit"] = model_info.input_token_limit
    except Exception as e:
        print(f"[local] Warning: Failed to fetch model limits: {e}", file=sys.stderr)

    def capture_state_as_parts(current_step: int):
        """Attempts to dump the hierarchy and screenshot. Returns the XML string,
        the screenshot formatted as a FunctionResponsePart, and the saved filepath.
        """
        xml = get_ui_state()

        img_part = None
        screenshot_path = None

        if args.agent_screenshots or args.local_screenshots:
            try:
                img = d.screenshot()
                img_byte_arr = io.BytesIO()
                img.save(img_byte_arr, format="JPEG", quality=85)
                img_bytes = img_byte_arr.getvalue()

                if args.agent_screenshots:
                    img_part = {
                        "type": "image",
                        "data": base64.b64encode(img_bytes).decode("ascii"),
                        "mime_type": "image/jpeg",
                    }

                if args.local_screenshots:
                    screenshot_path = os.path.join(
                        session_dir, f"step_{current_step:03d}.jpg"
                    )
                    with open(screenshot_path, "wb") as f:
                        f.write(img_bytes)
                    print(
                        f"[local] Saved screenshot: {screenshot_path}", file=sys.stderr
                    )
            except Exception as e:
                print(
                    f"[local] Warning: Failed to capture/process screenshot: {e}",
                    file=sys.stderr,
                )

        return xml, img_part, screenshot_path

    # Define UI tools
    def tap_element(
        text: str | None = None,
        resource_id: str | None = None,
        description: str | None = None,
        duration_ms: int = 0,
    ) -> dict:
        """Taps (or long-presses) a UI element. Only provide ONE search criteria.

        Args:
            text: The exact text of the element to tap.
            resource_id: The exact resource-id of the element to tap.
            description: The exact content-desc of the element to tap.
            duration_ms: If greater than 0, performs a long-press (tap and hold)
                         for the specified number of milliseconds.
        """
        criteria = []
        if text:
            criteria.append(f"text='{text}'")
        if resource_id:
            criteria.append(f"resource_id='{resource_id}'")
        if description:
            criteria.append(f"description='{description}'")
        criteria_str = ", ".join(criteria) if criteria else "none provided"
        action = "Tapping"
        if duration_ms > 0:
            action = f"Long-pressing ({duration_ms}ms)"
        print(f"[agent] {action} element ({criteria_str})", file=sys.stderr)

        try:
            if text:
                el = d(text=text)
            elif resource_id:
                el = d(resourceId=resource_id)
            elif description:
                el = d(description=description)
            else:
                return {
                    "status": "error",
                    "message": "Must provide text, resource_id, or description",
                }

            if el.exists:
                if duration_ms > 0:
                    el.long_click(duration=duration_ms / 1000.0)
                else:
                    el.click()
                time.sleep(1.5)
                return {"status": "success"}
            else:
                return {
                    "status": "error",
                    "message": "Element not found. Try scrolling or checking criteria.",
                }
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def tap_by_id(element_id: str) -> dict:
        """Taps the screen at the coordinates of the UI element with the specified ID.

        Args:
            element_id: The ID of the element to tap in 'step:index' format
                (e.g. '1:5').
        """
        if element_id not in current_layout_map:
            print(f"[agent] Tapping by ID: {element_id}", file=sys.stderr)
            try:
                s, _ = map(int, element_id.split(":"))
                if s != step:
                    return {
                        "status": "error",
                        "message": f"ID '{element_id}' belongs to step {s}, but current step is {step}. Use IDs from the current UI state.",
                    }
            except ValueError:
                pass
            return {
                "status": "error",
                "message": f"Element ID '{element_id}' not found in current layout.",
            }

        element_info = current_layout_map[element_id]
        x, y = element_info["coords"]

        label = (
            element_info.get("text")
            or element_info.get("desc")
            or element_info.get("res_id")
        )
        if label:
            if len(label) > 20:
                label = label[:17] + "..."
            print(f'[agent] Tapping by ID: {element_id} ("{label}")', file=sys.stderr)
        else:
            print(f"[agent] Tapping by ID: {element_id}", file=sys.stderr)

        try:
            d.click(x, y)
            time.sleep(1.5)
            return {"status": "success"}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def scroll(direction: str) -> dict:
        """Scrolls the screen in the specified direction.

        Args:
            direction: The direction to scroll. MUST be one of: 'forward' (scrolls down to reveal content below), 'backward' (scrolls up to reveal content above), 'left' (scrolls left to reveal the next page), 'right' (scrolls right to reveal the previous page).
        """
        print(f"[agent] Scrolling {direction}", file=sys.stderr)
        try:
            if direction == "forward":
                d.swipe_ext("up")
            elif direction == "backward":
                d.swipe_ext("down")
            elif direction == "left":
                d.swipe_ext("right")
            elif direction == "right":
                d.swipe_ext("left")
            else:
                return {
                    "status": "error",
                    "message": f"Invalid direction '{direction}'. Must be one of: 'forward', 'backward', 'left', 'right'",
                }

            time.sleep(1.5)
            return {"status": "success"}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def press_button(button: str, is_long_press: bool = False) -> dict:
        """Presses (or long-presses) a physical device button.

        Args:
            button: The button to press. MUST be one of: 'home', 'back', or 'enter'.
            is_long_press: If True, performs a long-press of the button.
        """
        action = "Long-pressing" if is_long_press else "Pressing"
        print(f"[agent] {action} {button} button", file=sys.stderr)
        try:
            if button not in ["home", "back", "enter"]:
                return {
                    "status": "error",
                    "message": f"Invalid button '{button}'. Must be one of: 'home', 'back', 'enter'",
                }

            if is_long_press:
                d.long_press(button)
            else:
                d.press(button)

            time.sleep(1.5)
            return {"status": "success"}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def input_text(
        text_to_type: str,
        text: str | None = None,
        resource_id: str | None = None,
        description: str | None = None,
    ) -> dict:
        """Inputs text into a UI element matching the provided criteria. If criteria are provided, it will tap the element first to focus it. If no criteria are provided, it types into the currently focused element.

        Args:
            text_to_type: The exact text to input into the field.
            text: Optional. The exact text of the element to tap before typing.
            resource_id: Optional. The exact resource-id of the element to tap before typing.
            description: Optional. The exact content-desc of the element to tap before typing.
        """
        criteria = []
        if text:
            criteria.append(f"text='{text}'")
        if resource_id:
            criteria.append(f"resource_id='{resource_id}'")
        if description:
            criteria.append(f"description='{description}'")
        criteria_str = ", ".join(criteria) if criteria else "currently focused element"
        print(
            f"[agent] Inputting text '{text_to_type}' into {criteria_str}",
            file=sys.stderr,
        )

        try:
            if text or resource_id or description:
                if text:
                    el = d(text=text)
                elif resource_id:
                    el = d(resourceId=resource_id)
                else:
                    el = d(description=description)

                if el.exists:
                    el.set_text(text_to_type)
                    time.sleep(1.5)
                    return {"status": "success"}
                else:
                    return {
                        "status": "error",
                        "message": "Element not found. Try scrolling or checking criteria.",
                    }
            else:
                d.send_keys(text_to_type, clear=True)
                time.sleep(1.5)
                return {"status": "success"}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def open_notification() -> dict:
        """Opens the system notification shade."""
        print("[agent] Opening notification shade", file=sys.stderr)
        try:
            d.open_notification()
            time.sleep(1.5)
            return {"status": "success"}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def open_quick_settings() -> dict:
        """Opens the system quick settings panel."""
        print("[agent] Opening quick settings", file=sys.stderr)
        try:
            d.open_quick_settings()
            time.sleep(1.5)
            return {"status": "success"}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def observe(delay_ms: int = 0) -> dict:
        """Retrieve the current UI hierarchy without performing any action. Use this
        to wait for the screen to update after a previous action, or to re-examine
        the current state.

        Args:
            delay_ms: Minimum milliseconds to wait before reading the screen.
        """
        if delay_ms > 0:
            time.sleep(delay_ms / 1000.0)
        print(f"[agent] Observing screen (delay={delay_ms}ms)", file=sys.stderr)
        try:
            return {"status": "success"}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def tap_coordinates(x: int, y: int, duration_ms: int = 0) -> dict:
        """Taps (or long-presses) the screen at the exact (x, y) pixel coordinates.

        Args:
            x: The horizontal pixel coordinate (0 to display_width).
            y: The vertical pixel coordinate (0 to display_height).
            duration_ms: If greater than 0, performs a long-press (tap and hold)
                         for the specified number of milliseconds.
        """
        msg = f"Tapping coordinates ({x}, {y})"
        if duration_ms > 0:
            msg = f"Long-pressing coordinates ({x}, {y}) for {duration_ms}ms"
        print(f"[agent] {msg}", file=sys.stderr)

        try:
            if duration_ms > 0:
                d.long_click(x, y, duration=duration_ms / 1000.0)
            else:
                d.click(x, y)
            time.sleep(1.5)
            return {"status": "success"}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def complete_task(
        success: bool, reason: str, dismissed: list[str] | None = None
    ) -> dict:
        """Call this when the goal has been definitively achieved or cannot be achieved.

        Args:
            success: True if the goal was achieved, False if it failed.
            reason: Explanation of the outcome.
            dismissed: Each interstitial you dismissed and saw disappear, with the
                button used, e.g. ["cookie banner (Reject all)"]. Empty if none.
        """
        dismissed = [str(x) for x in (dismissed or [])]
        if dismissed:
            print(f"[agent] Dismissed: {'; '.join(dismissed)}", file=sys.stderr)
        print(
            f"[agent] Task marked complete (success={success}, reason={reason})",
            file=sys.stderr,
        )
        return {"success": success, "reason": reason, "dismissed": dismissed}

    def save_screenshot(filename: str | None = None) -> dict:
        """Saves a screenshot of the current UI state to the output directory.

        Use this to provide visual proof of a completed task, record a final confirmation screen, or preserve important information.

        Args:
            filename: Optional. A descriptive name for the file (e.g., 'goal_completed', 'order_confirmation').
        """
        if not filename:
            timestamp = datetime.datetime.now(datetime.timezone.utc).strftime("%H%M%S")
            filename = f"agent_screenshot_{step:03d}_{timestamp}.jpg"

        # Prevent directory traversal by forcing the file into the output_dir
        safe_filename = os.path.basename(filename)
        if not safe_filename.lower().endswith((".jpg", ".jpeg", ".png")):
            safe_filename += ".jpg"

        output_path = os.path.join(args.output_dir, safe_filename)
        print(f"[agent] Saving screenshot to {output_path}", file=sys.stderr)

        try:
            img = d.screenshot()
            save_format = "PNG" if safe_filename.lower().endswith(".png") else "JPEG"
            img.save(output_path, format=save_format, quality=85)
            time.sleep(0.5)
            return {"status": "success", "message": f"Saved to {safe_filename}"}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    ui_tools = [
        tap_element,
        tap_by_id,
        scroll,
        press_button,
        input_text,
        open_notification,
        open_quick_settings,
        observe,
        tap_coordinates,
        save_screenshot,
        complete_task,
    ]

    tool_map = {fn.__name__: fn for fn in ui_tools}

    # Set up AI context
    if args.stay_in_app and restricted_package:
        cross_app_instruction = (
            f"You MUST stay within the application package '{restricted_package}' "
            "for the entire task. If an action would leave this package, do not "
            "take it. Use complete_task(success=False, ...) instead."
        )
    elif args.launch:
        cross_app_instruction = (
            f"The target application is {args.launch}. "
            "Prefer to accomplish the goal within this app."
        )
    else:
        cross_app_instruction = (
            "You are ALLOWED to cross app boundaries "
            "(e.g. into system settings or other apps) to achieve the goal."
        )

    # Worded as a default rather than a rule, with reasons and examples, so the
    # model applies it with judgement; "never" is kept for the login boundary.
    if args.dismiss_interstitials:
        interstitial_instruction = """Interstitials: By default, before and while working on the goal, close
interstitials that cover the content: cookie or consent banners, newsletter and
email sign-up popups, promotional offers, feature tours, rating prompts, and
"update later" nags. They carry no user intent and obscure what the user wants
to see, so dismissing them is a low-risk step that clears the way for the task.
Prefer the least-committal option: "Reject all", "Necessary only", "No thanks",
"Not now", or the close (X) button; tap "Accept" only when it is the only way out.
If the goal itself concerns the interstitial, treat it as part of the task instead.

Leave these alone unless the goal asks you to act on them: system permission
dialogs, login or sign-in screens, paywalls, age gates, and anything that asks
for personal details. Never enter credentials, and never skip a login screen or
choose "continue as guest": the user may want the logged-in experience. If the
goal cannot be reached without signing in, call complete_task(success=False)
and say a login screen is blocking it.

When you call complete_task, list each interstitial you dismissed and saw
disappear in the dismissed argument, e.g. ["cookie banner (Reject all)",
"newsletter popup (X)"]. Pass [] if you dismissed nothing.

<example>Cookie banner over a news article; goal "screenshot the headline":
tap "Reject all", then save_screenshot.</example>
<example>"Get 10% off: join our list" popup: tap the X or "No thanks".</example>
<example>"Sign in to continue" with a "Skip" link; goal "describe the home
screen": do not tap Skip; describe the sign-in screen.</example>"""
    else:
        interstitial_instruction = (
            "Interstitials: Leave popups, banners and dialogs as they are unless "
            "the goal requires acting on them."
        )

    # The core system instruction template is adapted from the official Google Gemini documentation
    # for agentic workflows: https://ai.google.dev/gemini-api/docs/prompting-strategies#agentic-si-template
    system_instruction = f"""You are a very strong reasoner and planner operating a complex user interface. Use these critical instructions to structure your plans, thoughts, and responses.

Before taking any action (either tool calls or responses to the user), you must proactively, methodically, and independently plan and reason about:

1) Logical dependencies and constraints: Analyze the intended UI action against the following factors. Resolve conflicts in order of importance:
    1.1) Policy-based rules, mandatory prerequisites, and constraints of the interface.
    1.2) Order of operations: Ensure taking a UI action does not prevent a subsequent necessary action.
        1.2.1) The user may request actions in a random order, but you may need to reorder operations to maximize successful completion of the task.
    1.3) Other prerequisites (information and/or actions needed).
    1.4) Explicit user constraints or preferences.

2) Risk assessment: What are the consequences of taking the action? Will the new UI state cause any future issues?

3) Abductive reasoning and hypothesis exploration: At each step, identify the most logical and likely reason for any UI problem or error encountered.
    3.1) Wear OS specific: If you are operating a Wear OS watch and cannot find an expected action button (like Pause, Stop, or Settings), it is highly likely located on an adjacent horizontal page. Use the scroll tool to swipe 'left' or 'right' to discover hidden pages. Paging indicators often do not appear in the XML hierarchy.
    3.2) Visual Fallback: If an element is clearly visible in the screenshot but does not appear in the XML (e.g. game engines, WebViews, icons without descriptions), use the tap_coordinates tool to interact with it visually.

4) Outcome evaluation and adaptability: Does the previous observation require any changes to your plan?

5) Information availability: Incorporate all applicable and alternative sources of information, including:
    5.1) Using available tools and their capabilities.
    5.2) All policies, rules, checklists, and constraints.
    5.3) Previous observations and conversation history.

6) Precision and Grounding: Ensure your reasoning is extremely precise and relevant to each exact ongoing situation.

7) Completeness: Ensure that all requirements, constraints, options, and preferences are exhaustively incorporated into your plan.

8) Persistence and patience: Do not give up unless all the reasoning above is exhausted.
    8.1) Don't be dissuaded by time taken or user frustration.
    8.2) This persistence must be intelligent: On transient errors (e.g. timeout, UI loading), you must retry unless an explicit retry limit (e.g., max 3 tries) has been reached. If such a limit is hit, you must stop. On other errors, you must change your strategy or arguments, not repeat the same failed tool call.

9) Inhibit your response: only take an action after all the above reasoning is completed. Once you've executed a state-changing UI action, you cannot take it back.

When thinking silently: ALWAYS start the thought with a brief (one sentence) recap of the current progress on the task. In particular, consider whether the task is already done.

In quoted strings, the only allowed escape sequences are \\\\, \\n, and \\". Instead of \\\\u escapes, use UTF-8.

---
Device Information:
{device_info}

Constraints:
{cross_app_instruction}

{interstitial_instruction}
"""

    interaction_tools = [callable_to_interaction_tool(client, fn) for fn in ui_tools]
    # temperature=1.0 is required by Gemini 3 and later models, which were
    # trained at this temperature; lower values degrade output quality.
    generation_config = {
        "temperature": 1.0,
        "thinking_level": "low",
        "tool_choice": "any",
    }
    previous_interaction_id: str | None = None
    created_interaction_ids: list[str] = []

    print(f"[goal] {args.goal}", file=sys.stderr)

    # Send the initial UI state and goal to the model
    initial_xml = get_ui_state()

    initial_screenshot_path = None
    initial_img_b64 = None

    if args.agent_screenshots or args.local_screenshots:
        try:
            initial_img = d.screenshot()
            img_buf = io.BytesIO()
            initial_img.save(img_buf, format="JPEG", quality=85)
            initial_img_bytes = img_buf.getvalue()
            if args.agent_screenshots:
                initial_img_b64 = base64.b64encode(initial_img_bytes).decode("ascii")
            if args.local_screenshots:
                initial_screenshot_path = os.path.join(session_dir, "step_000.jpg")
                with open(initial_screenshot_path, "wb") as f:
                    f.write(initial_img_bytes)
                print(
                    f"[local] Saved screenshot: {initial_screenshot_path}",
                    file=sys.stderr,
                )
        except Exception as e:
            print(
                f"[local] Warning: Failed to process initial screenshot: {e}",
                file=sys.stderr,
            )
            initial_img_b64 = None

    prompt: list[dict] = [
        {
            "type": "text",
            "text": f"""Goal: {args.goal}

Current UI State:
{initial_xml}

Element IDs use 'step:index' format such as '0:12'. When calling tap_by_id,
use IDs from the latest UI state.

What is your first action?""",
        }
    ]
    if args.agent_screenshots and initial_img_b64:
        prompt.append(
            {"type": "image", "data": initial_img_b64, "mime_type": "image/jpeg"}
        )

    def should_retry(exception: Exception) -> bool:
        """Retry on rate limits (429), server errors (5xx), and timeouts."""
        if is_retryable_interaction_error(exception):
            code = error_status_code(exception) or type(exception).__name__
            msg = getattr(exception, "status", None) or getattr(
                exception, "message", str(exception)
            )
            print(
                f"[local] Warning: API error {code} ({msg}). Retrying with backoff...",
                file=sys.stderr,
            )
            return True
        return False

    @retry.Retry(
        predicate=should_retry,
        initial=2.0,
        maximum=60.0,
        multiplier=2.0,
        timeout=300.0,
    )
    def send_with_retry(message):
        nonlocal previous_interaction_id
        kwargs = {
            "model": args.model,
            "input": message,
            "system_instruction": system_instruction,
            "tools": interaction_tools,
            "generation_config": generation_config,
            "store": True,
        }
        if previous_interaction_id:
            kwargs["previous_interaction_id"] = previous_interaction_id
        resp = client.interactions.create(**kwargs)
        if getattr(resp, "id", None):
            previous_interaction_id = resp.id
            for cid in getattr(resp, "continuation_ids", None) or [resp.id]:
                if cid not in created_interaction_ids:
                    created_interaction_ids.append(cid)
        usage = getattr(resp, "usage", None)
        if usage:
            prompt_toks = getattr(usage, "initial_input_tokens", None) or getattr(
                usage, "total_input_tokens", None
            )
            if prompt_toks:
                context_usage["prompt_tokens"] = prompt_toks
            if getattr(usage, "total_output_tokens", None):
                context_usage["candidate_tokens"] += usage.total_output_tokens

            # Print reactive usage to stderr for human readability
            rem_pct = 100 * (
                1.0 - (context_usage["prompt_tokens"] / context_usage["input_limit"])
            )
            print(
                f"[context] Input: {context_usage['prompt_tokens']}/{context_usage['input_limit']} ({rem_pct:.1f}% remaining)",
                file=sys.stderr,
            )
        return resp

    try:
        session_start = time.perf_counter()

        emit({"type": "start", "goal": args.goal, "device": device_info})

        init_emit_data = {"type": "hierarchy", "step": 0, "xml": initial_xml}
        if initial_screenshot_path:
            init_emit_data["screenshot_path"] = initial_screenshot_path
        emit(init_emit_data)

        response = send_with_retry(prompt)
        task_result = None

        while task_result is None:
            function_calls = [
                s
                for s in (getattr(response, "steps", None) or [])
                if getattr(s, "type", None) == "function_call"
            ]

            if not function_calls:
                text = (getattr(response, "output_text", None) or "").strip()
                print(
                    f"[agent] Model responded without tool call: {text}",
                    file=sys.stderr,
                )
                sys.exit(1)

            tool_results = []
            for fc in function_calls:
                step += 1
                fn = tool_map[fc.name]

                step_start = time.perf_counter()

                args_dict = dict(fc.arguments) if fc.arguments else {}
                result = fn(**args_dict)

                elapsed_ms = int((time.perf_counter() - step_start) * 1000)
                session_elapsed_ms = int((time.perf_counter() - session_start) * 1000)

                emit(
                    {
                        "type": "step",
                        "step": step,
                        "action": fc.name,
                        "args": args_dict,
                        "status": result.get("status", "success")
                        if isinstance(result, dict)
                        else "success",
                        "elapsed_ms": elapsed_ms,
                    }
                )

                # Check if it is a dictionary (our tools return dicts)
                img_part = None
                if isinstance(result, dict):
                    if fc.name == "complete_task":
                        task_result = result

                    # Inject timing so the agent sees it in the function response
                    result["step_elapsed_ms"] = elapsed_ms
                    result["session_elapsed_ms"] = session_elapsed_ms

                    # Capture state for the function response (unless complete)
                    if fc.name != "complete_task":
                        xml_str, img_part, screenshot_path = capture_state_as_parts(
                            step
                        )
                        result["new_ui_hierarchy"] = xml_str

                        step_emit_data = {
                            "type": "hierarchy",
                            "step": step,
                            "xml": xml_str,
                        }
                        if screenshot_path:
                            step_emit_data["screenshot_path"] = screenshot_path
                        emit(step_emit_data)

                        if restricted_package:
                            current_package = foreground_package(d)

                            if current_package != restricted_package:
                                task_result = {
                                    "success": False,
                                    "reason": (
                                        "Left restricted application package "
                                        f"'{restricted_package}' and entered "
                                        f"'{current_package or 'unknown'}'"
                                    ),
                                }
                                result["status"] = "error"
                                result["message"] = task_result["reason"]

                        if img_part:
                            result["screenshot"] = "attached"

                result_payload = (
                    [{"type": "text", "text": json.dumps(result)}, img_part]
                    if img_part
                    else result
                )
                tool_results.append(
                    {
                        "type": "function_result",
                        "call_id": fc.id,
                        "name": fc.name,
                        "result": result_payload,
                    }
                )

                if task_result is not None:
                    break

            if task_result is not None:
                break

            response = send_with_retry(tool_results)

        total_elapsed = time.perf_counter() - session_start
        emit(
            {
                "type": "result",
                "success": task_result.get("success", False),
                "reason": task_result.get("reason", ""),
                "dismissed": task_result.get("dismissed", []),
                "steps": step,
                "elapsed_ms": int(total_elapsed * 1000),
                "context": context_usage,
            }
        )

        sys.exit(0 if task_result.get("success") else 1)
    except Exception as e:
        print(
            f"[local] Error communicating with AI or executing UI actions: {e}",
            file=sys.stderr,
        )
        sys.exit(1)
    finally:
        for cid in reversed(created_interaction_ids):
            try:
                client.interactions.delete(cid, timeout=15.0)
            except Exception:
                pass


def sigterm_handler(signum, frame):
    # Translate SIGTERM to KeyboardInterrupt for clean exit
    raise KeyboardInterrupt


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, sigterm_handler)
    try:
        main()
    except KeyboardInterrupt:
        # Mask signals during final cleanup (protects atexit timeout restoration)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        try:
            sys.stderr.write("\n")
            sys.stderr.flush()
        except Exception:
            pass
        sys.exit(130)
