#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") [-] "QUESTION"

Ask a question and print a short, paragraph-style answer wrapped to 80 columns.
Uses the gemini-flash-latest model by default.

Arguments:
  -           Read additional context from stdin.
  QUESTION    The question to answer.

Options:
  --help         Display this help message and exit
  --model MODEL  Gemini model to use (default: gemini-flash-latest)

Environment:
  GEMINI_API_KEY   Optional. Read by gemini-api; a key stored with
                   "gemini-api configure" is also accepted.
  GEMINI_MODEL     Optional. Default model if --model is not given.

Exit Codes:
  0    Success
  1    General error (usage, no input, API error)
  127  Missing required dependency

Examples:
  $(basename "$0") "What is the capital of Peru?"
  cat article.md | $(basename "$0") - "Summarize this article"
  $(basename "$0") - "Explain this code" < script.sh
EOF
  exit 0
}

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

MODEL="${GEMINI_MODEL:-gemini-flash-latest}"
READ_STDIN=false
USER_PROMPT_PARTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help | -h)
      usage
      ;;
    --model)
      if [[ $# -lt 2 ]]; then
        echo "$(basename "$0"): --model requires an argument" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
      fi
      MODEL="$2"
      shift 2
      ;;
    -)
      READ_STDIN=true
      shift
      ;;
    --)
      shift
      USER_PROMPT_PARTS+=("$@")
      break
      ;;
    -*)
      echo "$(basename "$0"): unknown option: $1" >&2
      echo "Try '$(basename "$0") --help' for more information." >&2
      exit 1
      ;;
    *)
      USER_PROMPT_PARTS+=("$1")
      shift
      ;;
  esac
done

require fmt
require gemini-text

if [[ ${#USER_PROMPT_PARTS[@]} -lt 1 ]]; then
  echo "Usage: $(basename "$0") PROMPT [OPTIONS]" >&2
  echo "Examples: $(basename "$0") \"What is the capital of France?\"" >&2
  echo "Try '$(basename "$0") --help' for more information." >&2
  exit 1
fi

USER_PROMPT="${USER_PROMPT_PARTS[*]}"

if { [ -p /dev/stdin ] || [ -s /dev/stdin ]; } && ! ${READ_STDIN}; then
  echo "$(basename "$0"): warning: stdin contains piped input, but '-' was not specified. Stdin is ignored." >&2
fi

# System Instruction
SYSTEM_INSTRUCTION="You are a helpful assistant. Provide a short, direct answer (less than 300 characters) in a single full paragraph. Do not use point form, lists, or markdown formatting (like bold or headers). Just plain text."

BODY='{"generation_config":{"temperature":1.0,"max_output_tokens":2048,"thinking_level":"low"}}'

if $READ_STDIN; then
  # Read stdin into a temp file so the context never travels through a command
  # line.
  STDIN_FILE=$(mktemp)
  trap 'rm -f "$STDIN_FILE"' EXIT
  cat >"$STDIN_FILE"
  CONTEXT_FILE=$(mktemp)
  trap 'rm -f "$STDIN_FILE" "$CONTEXT_FILE"' EXIT
  {
    printf 'Context:\n'
    cat "$STDIN_FILE"
  } >"$CONTEXT_FILE"
  if ! TEXT=$(gemini-text \
    --model "$MODEL" \
    --system "$SYSTEM_INSTRUCTION" \
    --body "$BODY" \
    --context "$CONTEXT_FILE" \
    "Question:
$USER_PROMPT"); then
    exit 1
  fi
else
  if ! TEXT=$(gemini-text \
    --model "$MODEL" \
    --system "$SYSTEM_INSTRUCTION" \
    --body "$BODY" \
    "$USER_PROMPT"); then
    exit 1
  fi
fi

# Wrap to 80 chars
printf '%s\n' "$TEXT" | fmt -w 80
