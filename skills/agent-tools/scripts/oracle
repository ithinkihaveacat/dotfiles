# Tests: skills/agent-tools/tests/test-oracle
"""The Oracle: A high-quality, researched, and authoritative reasoning tool."""

import asyncio
import datetime
import fnmatch
import json
import mimetypes
import os
import re
import signal
import sys
import time
import uuid
from pathlib import Path

from google import genai
from google.genai import errors as genai_errors
from google.genai import types

MAX_TEXT_SIZE = 1 * 1024 * 1024  # 1MB
MAX_MEDIA_SIZE = 20 * 1024 * 1024  # 20MB per media file limit
MAX_INLINE_MEDIA_FILE_SIZE = 5 * 1024 * 1024  # 5MB per inline media file
MAX_AGGREGATE_INLINE_MEDIA_SIZE = 10 * 1024 * 1024  # 10MB total aggregate inline media
SMALL_PAYLOAD_SIZE = 50 * 1024  # below this, nudge the caller to add context

TEXT_EXTENSIONS = {
    ".txt",
    ".md",
    ".csv",
    ".json",
    ".xml",
    ".html",
    ".css",
    ".js",
    ".ts",
    ".py",
    ".java",
    ".kt",
    ".c",
    ".cpp",
    ".h",
    ".hpp",
    ".rs",
    ".go",
    ".rb",
    ".sh",
    ".bash",
    ".zsh",
    ".fish",
    ".yaml",
    ".yml",
    ".toml",
    ".ini",
    ".gradle",
    ".properties",
    ".bat",
    ".ps1",
    ".sql",
    ".graphql",
    ".graphqls",
}

IGNORED_DIRS = {
    ".git",
    "node_modules",
    "__pycache__",
    "venv",
    ".venv",
    "env",
    ".env",
    ".idea",
    ".vscode",
    "build",
    "dist",
    "out",
    "target",
    ".next",
    ".nuxt",
}

SECRET_DIRS = {
    ".ssh",
    ".gnupg",
    ".aws",
    ".azure",
    ".gcloud",
    "gcloud",
    ".kube",
    ".docker",
    ".chef",
    ".password-store",
}

SECRET_FILE_NAMES = {
    ".netrc",
    "_netrc",
    ".npmrc",
    ".pypirc",
    ".git-credentials",
    ".dockercfg",
    ".pgpass",
    ".my.cnf",
    ".htpasswd",
    ".htdigest",
    ".envrc",
    "credentials",
    "credentials.json",
    "application_default_credentials.json",
}

SECRET_FILE_PATTERNS = (
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.jks",
    "*.keystore",
    "id_rsa*",
    "id_dsa*",
    "id_ecdsa*",
    "id_ed25519*",
)

SYSTEM_SYMLINK_PREFIXES = {
    Path("/tmp"): Path("/private/tmp"),
    Path("/var"): Path("/private/var"),
    Path("/etc"): Path("/private/etc"),
}


def canonicalize_system_prefix(path: Path) -> Path:
    """Canonicalize standard OS aliases like macOS /tmp -> /private/tmp."""
    for alias, target in SYSTEM_SYMLINK_PREFIXES.items():
        try:
            if path == alias or alias in path.parents:
                rel = path.relative_to(alias)
                return target / rel
        except Exception:
            pass
    return path


def has_symlink_component(path: Path) -> bool:
    """Whether path or any of its parent components is a symlink."""
    curr = canonicalize_system_prefix(path)
    while True:
        if curr.is_symlink():
            return True
        if curr.parent == curr or curr.parent == Path("."):
            break
        curr = curr.parent
    return False


def is_secret_path(path: Path) -> bool:
    """Whether a path matches credential patterns or directories."""
    paths_to_check = [path]
    try:
        resolved = path.resolve()
        if resolved != path:
            paths_to_check.append(resolved)
    except Exception:
        pass

    for p in paths_to_check:
        if any(part in SECRET_DIRS for part in p.parts):
            return True
        name = p.name
        if name in SECRET_FILE_NAMES:
            return True
        if any(fnmatch.fnmatch(name, pat) for pat in SECRET_FILE_PATTERNS):
            return True
    return False


def extract_retry_delay(exc: Exception) -> float | None:
    """Extracts suggested retry delay in seconds from an API exception message.

    Matches the deterministic 'Please retry in Xs' string provided in quota
    exceeded error messages. Returns None if no delay is found.
    """
    msg = getattr(exc, "message", None)
    candidates = [str(msg)] if msg else []
    candidates.append(str(exc))

    for text in candidates:
        match = re.search(r"Please retry in ([0-9]+(?:\.[0-9]+)?)\s*s", text)
        if match:
            try:
                sec = float(match.group(1))
                if sec > 0:
                    return sec
            except ValueError:
                pass
    return None


def is_text_file(path: Path) -> bool:
    ext = path.suffix.lower()
    if ext in TEXT_EXTENSIONS:
        return True
    mime, _ = mimetypes.guess_type(path)
    if mime and mime.startswith("text/"):
        return True
    if mime in ["application/json", "application/xml", "application/javascript"]:
        return True
    # For unrecognized files, sniff for null bytes — no nulls means text
    try:
        with open(path, "rb") as f:
            return b"\x00" not in f.read(8192)
    except Exception:
        return False


def usage():
    print(
        f"""\
Usage: {os.path.basename(sys.argv[0])} [OPTIONS] "PROMPT" [FILE_OR_DIR ...]

Consult the Oracle for a very carefully researched and considered answer.
Designed for the highest quality response possible, utilizing deep reasoning
and Google Search grounding.

The Oracle is not a standard, quick-reply AI. It is designed to process massive
amounts of information and synthesize authoritative answers.

Stateless: every invocation is an independent, one-shot consultation. The
Oracle retains nothing between calls — including your own earlier oracle calls
in the same session. Never write "as you suggested earlier"; attach the earlier
answer instead (answers are saved to the cache, see --serialize).

Best Practices for Context:
  To get the most out of the Oracle, you must provide comprehensive context.
  The model on the other side handles very large context, and what you send is
  all it has. A well-fed consultation is typically tens to hundreds of KB of
  context; if your payload is under ~50 KB you have probably under-provided.
  The 1MB ceiling is a guardrail, not a target.
  - Self-Contained Prompts: Write the prompt as if explaining the problem to an
    expert who has zero prior knowledge of your task. Do not use references like
    "the solution we implemented" without explaining exactly what it was.
    Prompts of several hundred words are normal; a one-line prompt is almost
    always a mistake.
  - Broad File Context: Include source files and directories as positional
    arguments. Err on the side of providing too much context—whole directories
    rather than hand-picked excerpts, plus documentation, even if only
    marginally relevant—so the Oracle can discover non-obvious connections.
  - Session Brief: Much of what the Oracle needs is not in any file —
    requirements, decisions, and history from your conversation. Write them
    into a notes file and pass it as context; do not rely on the prompt alone.
  - Follow-ups: To continue a previous consultation, attach the saved answer
    (and, if useful, the saved payload) from the cache as context files
    alongside your new question.
  - Persona & Audience: Who are you, and who is this answer for?
  - Goals & Intent: What is the ultimate objective of this request?
  - Success Criteria: How will you know the answer is correct or useful?
  - Format & Style: Should the output be a technical spec, an essay, or a report?
  - Constraints: What must the Oracle explicitly avoid doing?
  - Examples: Provide a "few-shot" example of what a good output looks like.
  - Assumptions: Clarify ambiguous terms or state decisions already made.
  - Failed Attempts: If you are stuck, describe what approaches have already
    been tried and why each failed or was rejected (including any error messages
    or constraints). This prevents the Oracle from re-proposing dead ends and
    focuses its reasoning on genuinely novel solutions.

Arguments:
  PROMPT        The specific question or task for the Oracle.
  FILE_OR_DIR   Optional. Files or directories to include as context. Directories
                are recursively walked (ignoring hidden files, credential patterns,
                and standard ignore lists like node_modules). Text files are inlined;
                media files are attached directly or uploaded via the Gemini Files API.

Input:
  stdin         Optional. Context or reference material piped into the script.

Options:
  --force       Bypass context size limits (1MB for text, 20MB per media file).
  --maps        Use Google Maps grounding instead of Google Search. (Cannot be combined with --code).
  --code        Enable Code Execution for Python.
  --dry-run     Output a summary of the payload (resolved files, sizes, and prompt) without calling the Gemini API.
  --model MODEL Gemini model to use (default: gemini-pro-latest).
  --serialize   Save the request payload and the answer to files in the cache
                (~/.cache/oracle/). (Default: on).
  --no-serialize Disable saving the payload and answer to the cache.
  --help        Display this help message and exit.

Environment:
  GEMINI_API_KEY        Required. Your Gemini API key.
  GEMINI_MODEL          Optional. Default model if --model is not given.
  AGENT_TELEMETRY_JSON  Optional. Destination path for structured JSON execution telemetry.

Examples:
  cat codebase.md | {os.path.basename(sys.argv[0])} "Propose a refactoring plan" -
  {os.path.basename(sys.argv[0])} "Does this code match the spec?" src/ spec.pdf
"""
    )


def sigterm_handler(signum, frame):
    # Translate SIGTERM to KeyboardInterrupt for clean exit
    raise KeyboardInterrupt


def main():
    signal.signal(signal.SIGTERM, sigterm_handler)
    uploaded_files = []
    telemetry_file = os.environ.get("AGENT_TELEMETRY_JSON")
    start_time = time.perf_counter()
    prompt_tokens = 0
    candidate_tokens = 0
    thinking_tokens = 0
    session_id = uuid.uuid4()
    text_files = []
    media_files_to_inline = []
    media_files_to_upload = []
    total_text_size = 0
    answer_chunks = []
    telemetry_status = "Failed"
    telemetry_error = None

    def write_telemetry(status_label: str, error_msg: str | None = None):
        if not telemetry_file:
            return
        try:
            elapsed = time.perf_counter() - start_time
            telemetry_data = {
                "status": status_label,
                "success": status_label == "Succeeded",
                "elapsed_seconds": round(elapsed, 3),
                "prompt_tokens": prompt_tokens,
                "candidate_tokens": candidate_tokens,
                "thinking_tokens": thinking_tokens,
                "steps": 1,
                "text_files_count": len(text_files),
                "media_inline_count": len(media_files_to_inline),
                "media_upload_count": len(media_files_to_upload),
                "text_bytes": total_text_size,
                "media_bytes": sum(s for _, _, s in media_files_to_inline)
                + sum(s for _, _, s in media_files_to_upload),
                "session_id": str(session_id),
            }
            if error_msg:
                telemetry_data["error"] = error_msg
            out_path = Path(telemetry_file)
            out_path.parent.mkdir(parents=True, exist_ok=True)
            with open(out_path, "w", encoding="utf-8") as f:
                json.dump(telemetry_data, f, indent=2)
        except Exception as e:
            print(
                f"{os.path.basename(sys.argv[0])}: warning: failed to write telemetry to {telemetry_file}: {e}",
                file=sys.stderr,
            )

    try:
        if "--help" in sys.argv or "-h" in sys.argv:
            usage()
            telemetry_status = "Succeeded"
            sys.exit(0)

        force = False
        use_maps = False
        use_code = False
        dry_run = False
        serialize = True
        model_id = os.environ.get("GEMINI_MODEL", "gemini-pro-latest")
        args = []
        argv = sys.argv[1:]
        i = 0
        while i < len(argv):
            arg = argv[i]
            if arg == "--force":
                force = True
            elif arg == "--maps":
                use_maps = True
            elif arg == "--code":
                use_code = True
            elif arg == "--dry-run":
                dry_run = True
            elif arg == "--serialize":
                serialize = True
            elif arg == "--no-serialize":
                serialize = False
            elif arg == "--model":
                if i + 1 >= len(argv):
                    print(
                        f"{os.path.basename(sys.argv[0])}: error: --model requires an argument",
                        file=sys.stderr,
                    )
                    telemetry_status = "Error"
                    telemetry_error = "--model requires an argument"
                    sys.exit(1)
                model_id = argv[i + 1]
                i += 1
            else:
                args.append(arg)
            i += 1

        if not args:
            print(
                f"{os.path.basename(sys.argv[0])}: error: prompt is required",
                file=sys.stderr,
            )
            usage()
            telemetry_status = "Error"
            telemetry_error = "prompt is required"
            sys.exit(1)

        user_prompt = args[0]
        paths = args[1:]

        read_stdin = False
        cleaned_paths = []
        for p in paths:
            if p == "-":
                read_stdin = True
            else:
                cleaned_paths.append(p)
        paths = cleaned_paths

        text_context = ""

        # 1. Read stdin
        if read_stdin:
            stdin_content = sys.stdin.read()
            if stdin_content:
                text_context += f'<document path="stdin">\n<![CDATA[\n{stdin_content}\n]]>\n</document>\n'
                total_text_size += len(stdin_content.encode("utf-8"))

        # 2. Gather files with secret and symlink filtering
        collected_files = []
        for p in paths:
            path = Path(p)
            if is_secret_path(path):
                print(
                    f"{os.path.basename(sys.argv[0])}: warning: skipping secret/credential path: {path}",
                    file=sys.stderr,
                )
                continue
            if has_symlink_component(path):
                print(
                    f"{os.path.basename(sys.argv[0])}: warning: skipping symlink path: {path}",
                    file=sys.stderr,
                )
                continue
            if path.is_file():
                collected_files.append(path)
            elif path.is_dir():
                for root, dirs, files in os.walk(path):
                    dirs[:] = [
                        d
                        for d in sorted(dirs)
                        if not d.startswith(".")
                        and d not in IGNORED_DIRS
                        and d not in SECRET_DIRS
                        and not (Path(root) / d).is_symlink()
                        and not has_symlink_component(Path(root) / d)
                        and not is_secret_path(Path(root) / d)
                    ]
                    for file in sorted(files):
                        file_path = Path(root) / file
                        if (
                            file.startswith(".")
                            or file_path.is_symlink()
                            or has_symlink_component(file_path)
                            or is_secret_path(file_path)
                        ):
                            continue
                        collected_files.append(file_path)
            else:
                print(
                    f"{os.path.basename(sys.argv[0])}: path not found: {p}",
                    file=sys.stderr,
                )

        # 3. Categorize and enforce limits
        current_inline_media_size = 0
        for path in collected_files:
            size = path.stat().st_size
            if is_text_file(path):
                total_text_size += size
                if total_text_size > MAX_TEXT_SIZE and not force:
                    print(
                        f"{os.path.basename(sys.argv[0])}: text context exceeds 1MB threshold",
                        file=sys.stderr,
                    )
                    print("hint: use --force to bypass", file=sys.stderr)
                    telemetry_status = "Error"
                    telemetry_error = "text context exceeds 1MB threshold"
                    sys.exit(1)
                try:
                    content = path.read_text(encoding="utf-8", errors="replace")
                    text_context += f'<document path="{path}">\n<![CDATA[\n{content}\n]]>\n</document>\n'
                    text_files.append(path)
                    if not dry_run:
                        print(
                            f"{os.path.basename(sys.argv[0])}: inlining {path.name} into context ({size / 1024:.2f} KB)...",
                            file=sys.stderr,
                        )
                except Exception as e:
                    print(
                        f"{os.path.basename(sys.argv[0])}: error: failed to read file {path}: {e}",
                        file=sys.stderr,
                    )
                    telemetry_status = "Error"
                    telemetry_error = f"failed to read file {path}: {e}"
                    sys.exit(1)
            else:
                mime_type, _ = mimetypes.guess_type(str(path))
                if not mime_type:
                    print(
                        f"{os.path.basename(sys.argv[0])}: warning: skipping {path.name}: unknown file type",
                        file=sys.stderr,
                    )
                    continue
                if size > MAX_MEDIA_SIZE and not force:
                    print(
                        f"{os.path.basename(sys.argv[0])}: media file {path} exceeds 20MB threshold",
                        file=sys.stderr,
                    )
                    print("hint: use --force to bypass", file=sys.stderr)
                    telemetry_status = "Error"
                    telemetry_error = f"media file {path} exceeds 20MB threshold"
                    sys.exit(1)
                if (
                    size <= MAX_INLINE_MEDIA_FILE_SIZE
                    and (current_inline_media_size + size)
                    <= MAX_AGGREGATE_INLINE_MEDIA_SIZE
                ):
                    media_files_to_inline.append((path, mime_type, size))
                    current_inline_media_size += size
                else:
                    media_files_to_upload.append((path, mime_type, size))

        total_media_count = len(media_files_to_inline) + len(media_files_to_upload)

        if not text_context and total_media_count == 0:
            print(
                f"{os.path.basename(sys.argv[0])}: no context provided via stdin or files",
                file=sys.stderr,
            )

        # Define system instruction early for payload caching
        now = datetime.datetime.now().astimezone()
        current_date_str = now.strftime("%A, %d %B %Y")

        system_instruction = f"""You are the Oracle, an elite researcher and strategist known for providing the highest quality, most carefully considered answers possible. You combine deep technical expertise with rigorous reasoning and real-time research.

### Core Mandates

1.  **Highest Quality & Depth:** Your answers must be exhaustive, insightful, and technically precise. Do not settle for surface-level summaries.
2.  **Unwavering Acceptance:** Assume the user's question is correct and well-informed. Do not second-guess the intent, push back against the premise, or suggest the question is misinformed. Answer the question exactly as posed using your best judgment and the provided context.
3.  **Authoritative Voice:** Present information directly as fact. Instead of using weak conversational meta-references (e.g., "The provided text says..." or "According to the documentation..."), use formal, explicit citations (like Markdown footnotes, bracketed references, or direct blockquotes) to attribute information while maintaining a confident tone.
4.  **Markdown Excellence:** Use valid Markdown. Start with a descriptive H1 title. Use lists, tables, and code blocks (preferring Python, then Kotlin, then curl) to enhance clarity.
5.  **Context & Citations:** Prioritize any provided context, assuming it contains highly relevant information. When your answer draws upon this context, use explicit citations (e.g., inlining exact code snippets, quoting transcripts, or citing specific records) to make your response trustworthy and verifiable. Use the Google Search tool to supplement with up-to-date information, especially for technical details or recent developments.

### Contextual Awareness

- **Current Date:** Today is {current_date_str}.
- **Time Sensitivity:** For queries requiring up-to-date information, you MUST use the provided current date when formulating search queries.

### Output Style

- **Verbosity:** High. Provide detailed analysis and comprehensive answers.
- **Tone:** Professional, direct, and authoritative.
- **Directness:** Just answer the question. Skip conversational filler or introductory pleasantries.
"""

        # Construct self-contained XML document for caching
        payload_xml = "<oracle_payload>\n"
        payload_xml += f"  <system_instruction><![CDATA[\n{system_instruction}\n]]></system_instruction>\n"
        if text_context:
            payload_xml += f"  <context>\n{text_context}\n  </context>\n"
            payload_xml += f"  <task><![CDATA[\nBased on the information in the context above, please perform the following task:\n{user_prompt}\n]]></task>\n"
        else:
            payload_xml += f"  <task><![CDATA[\n{user_prompt}\n]]></task>\n"
        payload_xml += "</oracle_payload>\n"

        # Save to the cache directory if enabled
        oracle_cache_dir = None
        if serialize:
            try:
                oracle_cache_dir = os.environ.get("ORACLE_CACHE_DIR")
                if not oracle_cache_dir:
                    cache_dir = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser(
                        "~/.cache"
                    )
                    oracle_cache_dir = os.path.join(cache_dir, "oracle")
                oracle_cache_dir = os.path.expanduser(oracle_cache_dir)
                os.makedirs(oracle_cache_dir, exist_ok=True)
                payload_file_path = os.path.join(
                    oracle_cache_dir, f"payload_{session_id}.xml"
                )
                with open(payload_file_path, "w", encoding="utf-8") as f:
                    f.write(payload_xml)
                print(
                    f"{os.path.basename(sys.argv[0])}: saved self-contained payload to {payload_file_path}",
                    file=sys.stderr,
                )
            except Exception as e:
                print(
                    f"{os.path.basename(sys.argv[0])}: warning: failed to save payload to cache: {e}",
                    file=sys.stderr,
                )

        if dry_run:
            text_files_count = len(text_files)
            total_inline_media_size = sum(s for _, _, s in media_files_to_inline)
            total_upload_media_size = sum(s for _, _, s in media_files_to_upload)
            stdin_note = (
                " (+ stdin)" if '<document path="stdin">' in text_context else ""
            )

            print("\nOracle Dry Run Summary\n", file=sys.stdout)
            print("Prompt:", file=sys.stdout)
            print(f"{user_prompt}\n", file=sys.stdout)

            print("Payload Summary:", file=sys.stdout)
            print(
                f"  Text Context:   {text_files_count} file(s){stdin_note} ({total_text_size / 1024:.2f} KB, ~{total_text_size / 4 / 1000:.0f}k tokens)",
                file=sys.stdout,
            )
            if media_files_to_inline:
                print(
                    f"  Inline Media:   {len(media_files_to_inline)} file(s) ({total_inline_media_size / 1024:.2f} KB)",
                    file=sys.stdout,
                )
            if media_files_to_upload:
                print(
                    f"  Uploaded Media: {len(media_files_to_upload)} file(s) ({total_upload_media_size / 1024 / 1024:.2f} MB)",
                    file=sys.stdout,
                )
            if not media_files_to_inline and not media_files_to_upload:
                print("  Media Context:  0 files", file=sys.stdout)

            print("\nResolved Files:", file=sys.stdout)
            if stdin_note:
                print(
                    "  [TEXT]         <stdin> (included in total text size)",
                    file=sys.stdout,
                )
            for p in text_files:
                size_kb = p.stat().st_size / 1024
                print(f"  [TEXT]         {p} ({size_kb:.2f} KB)", file=sys.stdout)
            for p, mime, s in media_files_to_inline:
                size_kb = s / 1024
                print(
                    f"  [MEDIA-INLINE] {p} ({mime}, {size_kb:.2f} KB)", file=sys.stdout
                )
            for p, mime, s in media_files_to_upload:
                size_mb = s / 1024 / 1024
                print(
                    f"  [MEDIA-UPLOAD] {p} ({mime}, {size_mb:.2f} MB)", file=sys.stdout
                )

            if not collected_files and not stdin_note:
                print("  (No files or context resolved)", file=sys.stdout)

            if total_text_size < SMALL_PAYLOAD_SIZE and total_media_count == 0:
                print(
                    "\nNote: this payload is small. The Oracle handles hundreds of"
                    " KB, and this is all it gets — consider adding whole"
                    " directories, documentation, prior attempts, session notes,"
                    " and previous Oracle answers.",
                    file=sys.stdout,
                )

            print(
                "\n[Action Required] Present this summary to the user for"
                " confirmation — unless the user already specified the context and"
                " approved the run, in which case check the payload against the"
                " size guidance yourself and proceed.",
                file=sys.stdout,
            )
            telemetry_status = "Succeeded"
            sys.exit(0)

        api_key = os.environ.get("GEMINI_API_KEY")
        if not api_key:
            print(
                f"{os.path.basename(sys.argv[0])}: error: GEMINI_API_KEY environment variable not set",
                file=sys.stderr,
            )
            telemetry_status = "Error"
            telemetry_error = "GEMINI_API_KEY not set"
            sys.exit(1)

        client = genai.Client(api_key=api_key)

        tools_config = []
        if use_maps:
            tools_config.append(types.Tool(google_maps=types.GoogleMaps()))
            tools_str = "maps"
            if use_code:
                print(
                    f"{os.path.basename(sys.argv[0])}: warning: --code cannot be combined with --maps, ignoring --code",
                    file=sys.stderr,
                )
        else:
            tools_config.append(types.Tool(google_search=types.GoogleSearch()))
            if use_code:
                tools_config.append(
                    types.Tool(code_execution=types.ToolCodeExecution())
                )
                tools_str = "search+code"
            else:
                tools_str = "search"

        context_parts = []
        if total_text_size > 0:
            context_parts.append(f"{total_text_size / 1024:.2f} KB text")
        if media_files_to_inline:
            context_parts.append(f"{len(media_files_to_inline)} inline media")
        if media_files_to_upload:
            context_parts.append(f"{len(media_files_to_upload)} uploaded media")
        context_str = ", ".join(context_parts) if context_parts else "no context"

        print(
            f"{os.path.basename(sys.argv[0])}: {model_id} | {tools_str} | thinking=high | {context_str}",
            file=sys.stderr,
        )
        if total_text_size < SMALL_PAYLOAD_SIZE and total_media_count == 0:
            print(
                f"{os.path.basename(sys.argv[0])}: note: payload is small"
                f" ({total_text_size / 1024:.0f} KB); the Oracle handles hundreds"
                " of KB of context",
                file=sys.stderr,
            )

        async def upload_all(
            items: list[tuple[Path, str, int]],
        ) -> list[tuple[Path, types.File]]:
            async def upload_one(
                item: tuple[Path, str, int],
            ) -> tuple[Path, types.File]:
                path, mime_type, size = item
                print(
                    f"{os.path.basename(sys.argv[0])}: uploading {path.name} ({size / 1024 / 1024:.2f} MB)...",
                    file=sys.stderr,
                )
                uf = await client.aio.files.upload(
                    file=str(path),
                    config=types.UploadFileConfig(mime_type=mime_type),
                )
                return (path, uf)

            return list(await asyncio.gather(*[upload_one(it) for it in items]))

        uploaded_files = []
        if media_files_to_upload:
            uploaded_files = asyncio.run(upload_all(media_files_to_upload))

            parts = []
            if text_context:
                parts.append(
                    types.Part.from_text(text=f"<context>\n{text_context}\n</context>")
                )

            # 1. Inline small media (< 5MB file, <= 10MB aggregate) directly with explicit file labels
            for path, mime_type, _ in media_files_to_inline:
                data = path.read_bytes()
                parts.append(
                    types.Part.from_text(
                        text=f"### Attached File: `{path.name}` (Path: `{path}`, MIME: `{mime_type}`)"
                    )
                )
                parts.append(
                    types.Part.from_bytes(
                        data=data,
                        mime_type=mime_type,
                    )
                )

            # 2. Attach uploaded large media via Files API with explicit file labels
            for path, uf in uploaded_files:
                parts.append(
                    types.Part.from_text(
                        text=f"### Attached File: `{path.name}` (Path: `{path}`, MIME: `{uf.mime_type}`)"
                    )
                )
                parts.append(
                    types.Part.from_uri(
                        file_uri=uf.uri,
                        mime_type=uf.mime_type,
                    )
                )

            parts.append(types.Part.from_text(text=f"<task>\n{user_prompt}\n</task>"))

            initial_backoff = 2.0
            max_backoff = 60.0
            backoff_multiplier = 2.0
            max_retry_seconds = 300.0

            current_backoff = initial_backoff
            retry_start = time.monotonic()

            while True:
                try:
                    response = client.models.generate_content_stream(
                        model=model_id,
                        contents=[types.Content(role="user", parts=parts)],
                        config=types.GenerateContentConfig(
                            system_instruction=system_instruction,
                            tools=tools_config,
                            thinking_config=types.ThinkingConfig(
                                thinking_level="high", include_thoughts=True
                            ),
                            temperature=1.0,
                        ),
                    )

                    in_thought = False
                    for chunk in response:
                        if chunk.usage_metadata:
                            if chunk.usage_metadata.prompt_token_count:
                                prompt_tokens = chunk.usage_metadata.prompt_token_count
                            if chunk.usage_metadata.candidates_token_count:
                                candidate_tokens = (
                                    chunk.usage_metadata.candidates_token_count
                                )
                            if getattr(
                                chunk.usage_metadata, "thoughts_token_count", None
                            ):
                                thinking_tokens = (
                                    chunk.usage_metadata.thoughts_token_count
                                )

                        if not chunk.candidates:
                            continue
                        for part in chunk.candidates[0].content.parts:
                            if part.thought:
                                if not in_thought:
                                    print(
                                        f"\n{os.path.basename(sys.argv[0])}: thinking...\n\033[2m",
                                        end="",
                                        file=sys.stderr,
                                        flush=True,
                                    )
                                    in_thought = True
                                print(part.text, end="", file=sys.stderr, flush=True)
                            elif part.text:
                                if in_thought:
                                    print(
                                        "\033[0m\n\n",
                                        end="",
                                        file=sys.stderr,
                                        flush=True,
                                    )  # Dim end
                                    in_thought = False
                                print(part.text, end="", flush=True)
                                answer_chunks.append(part.text)

                    if in_thought:
                        print("\033[0m\n", end="", file=sys.stderr, flush=True)
                    print(flush=True)  # Final newline
                    telemetry_status = "Succeeded"
                    break

                except Exception as e:
                    is_retryable = isinstance(e, genai_errors.APIError) and e.code in (
                        429,
                        500,
                        502,
                        503,
                        504,
                    )
                    if not is_retryable or answer_chunks:
                        raise

                    elapsed = time.monotonic() - retry_start
                    delay = extract_retry_delay(e)
                    if delay is not None:
                        sleep_sec = delay + 1.0
                        wait_desc = f"Retrying in {sleep_sec:.1f}s (quota reset)..."
                    else:
                        sleep_sec = current_backoff
                        current_backoff = min(
                            current_backoff * backoff_multiplier, max_backoff
                        )
                        wait_desc = f"Retrying in {sleep_sec:.1f}s with backoff..."

                    if elapsed + sleep_sec > max_retry_seconds:
                        raise

                    msg = getattr(e, "message", getattr(e, "status", "Unknown"))
                    print(
                        f"\n{os.path.basename(sys.argv[0])}: warning: API error {getattr(e, 'code', 'error')} ({msg}). {wait_desc}",
                        file=sys.stderr,
                    )
                    time.sleep(sleep_sec)

            if oracle_cache_dir and answer_chunks:
                try:
                    answer_file_path = os.path.join(
                        oracle_cache_dir, f"answer_{session_id}.md"
                    )
                    with open(answer_file_path, "w", encoding="utf-8") as f:
                        f.write("".join(answer_chunks))
                    print(
                        f"{os.path.basename(sys.argv[0])}: saved answer to {answer_file_path} (attach it as context to follow up)",
                        file=sys.stderr,
                    )
                except Exception as e:
                    print(
                        f"{os.path.basename(sys.argv[0])}: warning: failed to save answer to cache: {e}",
                        file=sys.stderr,
                    )

    except SystemExit as e:
        if e.code == 0:
            if telemetry_status == "Failed":
                telemetry_status = "Succeeded"
        else:
            if telemetry_status != "Error":
                telemetry_status = "Error"
                if not telemetry_error:
                    telemetry_error = f"Process exited with code {e.code}"
        raise
    except Exception as e:
        print(f"{os.path.basename(sys.argv[0])}: error: {e}", file=sys.stderr)
        telemetry_status = "Error"
        telemetry_error = str(e)
        sys.exit(1)
    finally:
        # Mask signals to protect this critical cleanup phase from re-entrant Ctrl+C
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)

        if uploaded_files:
            for _, uf in uploaded_files:
                try:
                    print(f"Cleaning up {uf.name}...", file=sys.stderr)
                    client.files.delete(name=uf.name)
                except Exception as e:
                    print(
                        f"{os.path.basename(sys.argv[0])}: warning: failed to delete {uf.name}: {e}",
                        file=sys.stderr,
                    )

        write_telemetry(telemetry_status, error_msg=telemetry_error)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        try:
            sys.stderr.write("\n")
            sys.stderr.flush()
        except Exception:
            pass
        sys.exit(130)
