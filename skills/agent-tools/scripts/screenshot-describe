#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] [IMAGE] [PROMPT]

Generate a text description of a screenshot using the Gemini API. Optimized for
screenshots and UI captures; the default prompt focuses on UI elements, text,
colors, and layout.

Arguments:
  IMAGE       Path to a screenshot, or '-' for stdin (default: '-')
  PROMPT      Custom prompt for the AI model (optional)

Options:
  --help         Display this help message and exit
  --model MODEL  Gemini model to use (default: gemini-3.6-flash)

Environment:
  GEMINI_API_KEY               Required. Your Gemini API key.
  GEMINI_MODEL                 Optional. Default model if --model is not given.
  SCREENSHOT_DESCRIBE_OFFLINE  Refuse to use the network. This tool caches nothing,
                               so offline mode fails immediately rather than serving
                               a stale answer. Falls back to AGENT_OFFLINE when unset.
  AGENT_OFFLINE                Workspace-wide offline policy (see above).

Exit Codes:
  0    Success
  1    General error (API error, missing file)
  127  Missing required dependency

Examples:
  $(basename "$0") screenshot.png
  $(basename "$0") screen-capture.png "What objects are in this image?"
  $(basename "$0") ui-mockup.png "List all UI elements visible"
EOF
  exit 0
}

MODEL="${GEMINI_MODEL:-gemini-3.6-flash}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help | -h)
      usage
      ;;
    --model)
      if [[ $# -lt 2 ]]; then
        echo "$(basename "$0"): --model requires an argument" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
      fi
      MODEL="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require curl
require jq

# Refuse to run when the environment declares there is no network. Every run is
# a fresh model call against a new prompt, so there is nothing cached to serve
# and offline mode fails here rather than on a connect timeout. The per-tool
# variable wins when set (including when set to 0, to exempt this tool from a
# workspace-wide policy) -- see coding-standards/references/caching.md.
require_network() {
  local var="$1" value
  [[ -n "${!var+x}" ]] || var="AGENT_OFFLINE"
  value="${!var:-}"
  case "$(echo "$value" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | on)
      echo "$(basename "$0"): offline ($var=$value) and no cached answer: this command calls the Gemini API" >&2
      echo "$(basename "$0"): re-run where there is network, or set $1=0 to exempt this tool" >&2
      exit 1
      ;;
  esac
}

require_network SCREENSHOT_DESCRIBE_OFFLINE
require base64
require magick

DEFAULT_PROMPT=$(
  cat <<'EOF'
<role>You are an expert UX analyst.</role>
<task>Generate concise alt text describing the specific UI content of this screenshot.</task>
<instructions>
Focus exclusively on the internal UI elements, text content, color schemes, margins, and layout characteristics. This description will be used to distinguish this exact screen state from visually similar states.
</instructions>
<constraints>
- Keep the description under 300 characters.
- Ignore the hardware frame, device shape, or physical form factor surrounding the UI.
</constraints>
EOF
)

if [[ $# -eq 0 ]]; then
  IMAGE_PATH="-"
  PROMPT="${DEFAULT_PROMPT}"
elif [[ "$1" == "-" ]]; then
  IMAGE_PATH="-"
  PROMPT="${2:-${DEFAULT_PROMPT}}"
else
  IMAGE_PATH="$1"
  PROMPT="${2:-${DEFAULT_PROMPT}}"
fi

GEMINI_API_KEY="${GEMINI_API_KEY:-}"
if [[ -z "${GEMINI_API_KEY:-}" ]]; then
  echo "$(basename "$0"): GEMINI_API_KEY environment variable not set" >&2
  exit 1
fi

URL="https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent"

if [[ "$IMAGE_PATH" != "-" && ! -f "$IMAGE_PATH" ]]; then
  echo "$(basename "$0"): $IMAGE_PATH: No such file or directory" >&2
  exit 1
fi

# Convert to lossless webp and base64 encode
# base64: macOS uses -b 0, Linux uses -w 0
if base64 --help 2>&1 | grep -q -- '-w'; then
  IMAGE_BASE64=$(magick "$IMAGE_PATH" -alpha off -define webp:lossless=true webp:- | base64 -w 0)
else
  IMAGE_BASE64=$(magick "$IMAGE_PATH" -alpha off -define webp:lossless=true webp:- | base64 -b 0)
fi

# Image before text for single-image prompts per:
# https://ai.google.dev/gemini-api/docs/image-understanding
REQUEST_BODY=$(jq -n \
  --arg prompt "$PROMPT" \
  --arg img "$IMAGE_BASE64" \
  '{
    contents: [{
      parts: [
        {inlineData: {mimeType: "image/webp", data: $img}},
        {text: $prompt}
      ]
    }]
  }')

# Read the status via -w '%{http_code}' rather than trusting curl's exit code:
# it is "000" only when no HTTP response arrived at all, which is what separates
# a blocked or absent network from an API that answered with an error. Capturing
# the exit code also stops a failed curl from killing the script silently under
# `set -e`, before any of the handling below can run.
CURL_STATUS=0
RAW=$(echo "${REQUEST_BODY}" | curl -sS -X POST \
  -H "x-goog-api-key: $GEMINI_API_KEY" \
  -H "Content-Type: application/json" \
  -d @- -w '\n%{http_code}' \
  "${URL}" 2>/dev/null) || CURL_STATUS=$?

HTTP_STATUS="${RAW##*$'\n'}"
RESPONSE="${RAW%$'\n'*}"

# The status decides, not curl's exit code: -w always emits a three-digit code
# when a response arrived, and "000" only when none did. The exit code cannot be
# trusted for this -- in a `jq | curl` pipeline `pipefail` reports the pipeline's
# status, so a curl that answered fine still surfaces as non-zero -- so it is
# reported for diagnosis but does not drive the decision.
if [[ ! "$HTTP_STATUS" =~ ^[0-9]{3}$ || "$HTTP_STATUS" == "000" ]]; then
  echo "$(basename "$0"): could not reach $URL (curl exit $CURL_STATUS, http ${HTTP_STATUS:-none}: network unreachable, DNS failure, or blocked egress)" >&2
  exit 1
fi

if [[ "$HTTP_STATUS" != 2?? ]]; then
  ERROR_MSG=$(echo "$RESPONSE" | jq -r '.error.message // empty' 2>/dev/null || true)
  echo "$(basename "$0"): API error (HTTP $HTTP_STATUS): ${ERROR_MSG:-no error message in response}" >&2
  exit 1
fi

# Extract and output the text response
TEXT=$(echo "$RESPONSE" | jq -r '.candidates[0].content.parts[0].text // empty')
if [[ -z "$TEXT" ]]; then
  echo "$(basename "$0"): no response text received from API" >&2
  exit 1
fi

echo "$TEXT"
