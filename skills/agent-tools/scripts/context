def entry_kamal():
    repo = fetch("github://basecamp/kamal-site")

    docs_dir = os.path.join(repo, "docs")
    search_pattern = os.path.join(docs_dir, "**", "*.md")
    files = glob.glob(search_pattern, recursive=True)
    files.sort()

    for file in files:
        rel = os.path.relpath(file, repo)
        slug = rel
        slug = slug.removesuffix(".md")
        if slug.endswith("/index"):
            slug = slug[:-6]
        elif slug == "docs/index":
            slug = "docs"

        published = f"https://kamal-deploy.org/{slug}/"

        entry_file(
            file,
            f"https://raw.githubusercontent.com/basecamp/kamal-site/main/{rel}",
            published,
        )

    entry_url(
        "https://raw.githubusercontent.com/basecamp/kamal-proxy/refs/heads/main/README.md",
        "https://github.com/basecamp/kamal-proxy/blob/main/README.md",
    )


