def entry_inkyframe():
    inky = fetch("github://pimoroni/inky-frame")
    pico = fetch("github://pimoroni/pimoroni-pico")

    # inky-frame README
    readme = os.path.join(inky, "README.md")
    if os.path.exists(readme):
        entry_file(
            readme,
            "https://raw.githubusercontent.com/pimoroni/inky-frame/main/README.md",
        )

    # inky-frame docs, examples, modules
    for dir_name in ["docs", "examples", "modules"]:
        dir_path = os.path.join(inky, dir_name)
        if os.path.exists(dir_path):
            files = []
            for ext in ["*.md", "*.py"]:
                files.extend(
                    glob.glob(os.path.join(dir_path, "**", ext), recursive=True)
                )
            files.sort()

            for file in files:
                rel = os.path.relpath(file, inky)
                entry_file(
                    file,
                    f"https://raw.githubusercontent.com/pimoroni/inky-frame/main/{rel}",
                )

    # pimoroni-pico picographics
    pico_docs = os.path.join(pico, "micropython/modules/picographics")
    if os.path.exists(pico_docs):
        files = glob.glob(os.path.join(pico_docs, "**", "*.md"), recursive=True)
        files.sort()
        for file in files:
            rel = os.path.relpath(file, pico)
            entry_file(
                file,
                f"https://raw.githubusercontent.com/pimoroni/pimoroni-pico/main/{rel}",
            )

    # pimoroni-pico inky_frame examples
    pico_examples = os.path.join(pico, "micropython/examples/inky_frame")
    if os.path.exists(pico_examples):
        files = []
        for ext in ["*.md", "*.py"]:
            files.extend(
                glob.glob(os.path.join(pico_examples, "**", ext), recursive=True)
            )
        files.sort()
        for file in files:
            rel = os.path.relpath(file, pico)
            entry_file(
                file,
                f"https://raw.githubusercontent.com/pimoroni/pimoroni-pico/main/{rel}",
            )

    # External URLs
    entry_url(
        "https://docs.micropython.org/en/latest/_sources/reference/mpremote.rst.txt"
    )
    entry_url(
        "https://r.jina.ai/https://learn.pimoroni.com/article/getting-started-with-inky-frame",
        "https://learn.pimoroni.com/article/getting-started-with-inky-frame",
    )


def entry_rpi():
    repo = fetch("github://raspberrypi/documentation@master")
    src = os.path.join(repo, "documentation/asciidoc/computers")

    dirs = [
        "config_txt",
        "configuration",
        "getting-started",
        "os",
        "raspberry-pi",
        "remote-access",
    ]

    for dir_name in dirs:
        published = (
            f"https://www.raspberrypi.com/documentation/computers/{dir_name}.html"
        )

        # Index file
        index_file = os.path.join(src, f"{dir_name}.adoc")
        if os.path.exists(index_file):
            entry_file(
                index_file,
                f"https://raw.githubusercontent.com/raspberrypi/documentation/master/documentation/asciidoc/computers/{dir_name}.adoc",
                published,
            )

        # Directory contents
        dir_path = os.path.join(src, dir_name)
        if os.path.exists(dir_path):
            search_pattern = os.path.join(dir_path, "**", "*.adoc")
            files = glob.glob(search_pattern, recursive=True)
            files = [f for f in files if "device-tree.adoc" not in f]
            files.sort()

            for file in files:
                rel = os.path.relpath(file, repo)
                entry_file(
                    file,
                    f"https://raw.githubusercontent.com/raspberrypi/documentation/master/{rel}",
                    published,
                )

    # Standalone file
    software_sources = os.path.join(src, "software-sources.adoc")
    if os.path.exists(software_sources):
        entry_file(
            software_sources,
            "https://raw.githubusercontent.com/raspberrypi/documentation/master/documentation/asciidoc/computers/software-sources.adoc",
            "https://www.raspberrypi.com/documentation/computers/software-sources.html",
        )


def entry_homeassistant():
    ha_io = fetch("github://home-assistant/home-assistant.io@current")
    dev_docs = fetch("github://home-assistant/developers.home-assistant@master")
    ha_skills = fetch("github://homeassistant-ai/skills@main")

    # Integration docs
    integrations = [
        "binary_sensor",
        "climate",
        "derivative",
        "esphome",
        "hassio",
        "home_connect",
        "homeassistant",
        "input_boolean",
        "input_datetime",
        "input_number",
        "matter",
        "metoffice",
        "min_max",
        "mqtt",
        "nest",
        "openweathermap",
        "recorder",
        "ruuvitag_ble",
        "sensor",
        "shelly",
        "sql",
        "statistics",
        "switch_as_x",
        "template",
        "threshold",
        "utility_meter",
        "vicare",
        "water_heater",
    ]
    for integration in integrations:
        path = os.path.join(ha_io, f"source/_integrations/{integration}.markdown")
        published = f"https://www.home-assistant.io/integrations/{integration}/"
        entry_file(
            path,
            f"https://raw.githubusercontent.com/home-assistant/home-assistant.io/current/source/_integrations/{integration}.markdown",
            published,
        )

    # Automation docs
    for doc in ["trigger", "condition", "action", "templating"]:
        path = os.path.join(ha_io, f"source/_docs/automation/{doc}.markdown")
        published = f"https://www.home-assistant.io/docs/automation/{doc}/"
        entry_file(
            path,
            f"https://raw.githubusercontent.com/home-assistant/home-assistant.io/current/source/_docs/automation/{doc}.markdown",
            published,
        )

    # Script docs
    for doc in ["scripts", "scripts/conditions", "scripts/perform-actions"]:
        path = os.path.join(ha_io, f"source/_docs/{doc}.markdown")
        slug = doc
        published = f"https://www.home-assistant.io/docs/{slug}/"
        entry_file(
            path,
            f"https://raw.githubusercontent.com/home-assistant/home-assistant.io/current/source/_docs/{doc}.markdown",
            published,
        )

    # Configuration and templating docs
    for doc in ["configuration/yaml", "configuration/templating"]:
        path = os.path.join(ha_io, f"source/_docs/{doc}.markdown")
        published = f"https://www.home-assistant.io/docs/{doc}/"
        entry_file(
            path,
            f"https://raw.githubusercontent.com/home-assistant/home-assistant.io/current/source/_docs/{doc}.markdown",
            published,
        )

    # Dashboard docs
    files = []
    for d in ["source/_dashboards", "source/dashboards"]:
        dir_path = os.path.join(ha_io, d)
        if os.path.exists(dir_path):
            for f in os.listdir(dir_path):
                if f.endswith(".markdown"):
                    files.append(os.path.join(dir_path, f))
    files.sort()

    for file in files:
        rel = os.path.relpath(file, ha_io)
        dashboard = os.path.splitext(os.path.basename(file))[0]
        if dashboard == "index":
            published_slug = "dashboards/"
        else:
            published_slug = f"dashboards/{dashboard}/"
        published = f"https://www.home-assistant.io/{published_slug}"
        entry_file(
            file,
            f"https://raw.githubusercontent.com/home-assistant/home-assistant.io/current/{rel}",
            published,
        )

    # REST API and WebSocket API
    apis = [
        "rest.md",
        "websocket.md",
        "supervisor/endpoints.md",
        "supervisor/models.md",
    ]
    for api_file in apis:
        path = os.path.join(dev_docs, "docs/api", api_file)
        slug = os.path.splitext(api_file)[0]
        published = f"https://developers.home-assistant.io/docs/api/{slug}"
        entry_file(
            path,
            f"https://raw.githubusercontent.com/home-assistant/developers.home-assistant/master/docs/api/{api_file}",
            published,
        )

    # Apps documentation
    apps = [
        "communication.md",
        "configuration.md",
        "presentation.md",
        "publishing.md",
        "repository.md",
        "security.md",
        "testing.md",
        "tutorial.md",
    ]
    for apps_file in apps:
        path = os.path.join(dev_docs, "docs/apps", apps_file)
        slug = os.path.splitext(apps_file)[0]
        published = f"https://developers.home-assistant.io/docs/apps/{slug}"
        entry_file(
            path,
            f"https://raw.githubusercontent.com/home-assistant/developers.home-assistant/master/docs/apps/{apps_file}",
            published,
        )

    # Home Assistant AI Skills
    search_pattern = os.path.join(ha_skills, "skills", "**", "*.md")
    files = glob.glob(search_pattern, recursive=True)
    files.extend(
        glob.glob(os.path.join(ha_skills, "skills", "**", "*.markdown"), recursive=True)
    )
    files.sort()

    for file in files:
        rel = os.path.relpath(file, ha_skills)
        entry_file(
            file,
            f"https://raw.githubusercontent.com/homeassistant-ai/skills/main/{rel}",
            f"https://github.com/homeassistant-ai/skills/blob/main/{rel}",
        )


def entry_prompting():
    # Claude platform best practices
    claude_urls = [
        "https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/overview",
        "https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/claude-prompting-best-practices",
        "https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/prompting-claude-fable-5",
        "https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/prompting-claude-opus-5",
        "https://platform.claude.com/docs/en/agents-and-tools/tool-use/overview",
    ]
    for url in claude_urls:
        entry_url(f"{url}.md", url)

    # Google AI / Gemini API docs
    gemini_urls = [
        "https://ai.google.dev/gemini-api/docs/prompting-strategies",
        "https://ai.google.dev/gemini-api/docs/thinking",
        "https://ai.google.dev/gemini-api/docs/files",
        "https://ai.google.dev/gemini-api/docs/text-generation",
    ]
    for url in gemini_urls:
        entry_url(f"{url}.md.txt", url)

    # OpenAI Docs
    openai_slugs = [
        "guides/prompt-engineering",
        "guides/latest-model",
        "guides/text",
        "guides/reasoning",
    ]
    for slug in openai_slugs:
        entry_url(
            f"https://developers.openai.com/api/docs/{slug}.md",
            f"https://platform.openai.com/docs/{slug}",
        )

    entry_url(
        "https://raw.githubusercontent.com/openai/skills/main/skills/.curated/openai-docs/references/prompting-guide.md",
        "https://github.com/openai/skills/blob/main/skills/.curated/openai-docs/references/prompting-guide.md",
    )

    # OpenAI Cookbook - GPT-5 Prompting Guide
    try:
        raw_url = "https://raw.githubusercontent.com/openai/openai-cookbook/main/examples/gpt-5/gpt-5_prompting_guide.ipynb"
        print(f"[local] Fetching {raw_url}", file=sys.stderr)
        response = requests.get(raw_url)
        response.raise_for_status()
        data = response.json()

        # Strip outputs to keep it clean
        _clean_notebook_data(data)

        content = json.dumps(data, indent=2)
        display_url = "https://raw.githubusercontent.com/openai/openai-cookbook/main/examples/gpt-5/gpt-5_prompting_guide.ipynb"
        web_url = "https://cookbook.openai.com/examples/gpt-5/gpt-5_prompting_guide"
        display_cmd = f"curl -sfSL '{display_url}' | jq '.cells[] |= if .cell_type == \"code\" then .outputs = [] | .execution_count = null else . end'  # published to {web_url}"
        _emit_entry(display_cmd, content)
    except Exception as e:
        print(
            f"context: failed to fetch/parse OpenAI cookbook: {e}",
            file=sys.stderr,
        )


