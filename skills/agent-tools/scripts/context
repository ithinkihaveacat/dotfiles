        "https://raw.githubusercontent.com/anthropics/skills/refs/heads/main/skills/skill-creator/SKILL.md"
    )


def format_tree_manifest(paths: list[str | Path]) -> str:
    """Generate an ASCII directory tree manifest from a list of paths."""
    if not paths:
        return ""
    tree: dict[str, Any] = {}
    for p_raw in sorted(paths):
        p = Path(p_raw)
        parts = p.parts
        curr = tree
        for part in parts:
            if part not in curr:
                curr[part] = {}
            curr = curr[part]

    lines = ["Directory Structure:"]

    def render(node: dict[str, Any], prefix: str = ""):
        items = list(node.keys())
        for idx, item in enumerate(items):
            is_last = idx == len(items) - 1
            connector = "└── " if is_last else "├── "
            lines.append(f"{prefix}{connector}{item}")
            child_prefix = prefix + ("    " if is_last else "│   ")
            render(node[item], child_prefix)

    render(tree)
    return "\n".join(lines)


def generate_markdown(topic_desc, use_toc=True):
    entry_strings = []
    for entry in ENTRIES:
        content = entry["output"]
        max_ticks = 0
        for match in re.finditer(r"`+", content):
            max_ticks = max(max_ticks, len(match.group(0)))
        fence = "`" * max(3, max_ticks + 1)

        cmd_str = entry["command"]
        published_url = None
        if "  # published to " in cmd_str:
            cmd_part, published_url = cmd_str.split("  # published to ", 1)
            cmd_str = cmd_part.strip()
            published_url = published_url.strip()

        lang = ""
        m_file = re.search(r"['\"]?([^'\"\s]+\.([a-zA-Z0-9_-]+))['\"]?", cmd_str)
        if m_file:
            ext = m_file.group(2).lower()
            if ext in ("md", "markdown", "mdx"):
                lang = "markdown"
            elif ext in ("py", "python"):
                lang = "python"
            elif ext in ("json", "ipynb"):
                lang = "json"
            elif ext in ("sh", "bash", "zsh"):
                lang = "bash"
            elif ext in ("yaml", "yml"):
                lang = "yaml"
            elif ext in ("xml", "html", "svg"):
                lang = ext
            elif ext in ("toml", "ini"):
                lang = "toml"
            elif ext in ("js", "ts", "jsx", "tsx"):
                lang = ext

        lines = [
            f'### <a id="entry-{entry["id"]}"></a>Entry {entry["id"]}: `{cmd_str}`\n'
        ]
        if published_url:
            lines.append(f"* **Published URL:** <{published_url}>\n")
        lines.append(f"\n{fence}{lang}\n{content}\n{fence}\n\n")
        entry_strings.append("".join(lines))

    timestamp = datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")
    header = f"""# Context: {topic_desc}

> **Generated at:** {timestamp}
> **Provenance & Citations:** Commands indicate data retrieval sources. When citing documentation or linking external resources for users, prioritize the canonical **Published URL**.

"""

    manifest_str = ""
    if MANIFEST_PATHS:
        tree_text = format_tree_manifest(MANIFEST_PATHS)
        manifest_str = f"### Directory Manifest\n\n```text\n{tree_text}\n```\n\n"

    toc_items = []
    if use_toc and ENTRIES:
        header_lines = header.count("\n")
        manifest_lines = manifest_str.count("\n") if manifest_str else 0
        toc_header = "### Table of Contents\n\n"
        toc_footer = "\n---\n\n"
        toc_fixed_lines = toc_header.count("\n") + len(ENTRIES) + toc_footer.count("\n")

        current_line = header_lines + manifest_lines + toc_fixed_lines + 1

        for i, entry in enumerate(ENTRIES):
            est = entry_strings[i]
            n_lines = est.count("\n")
            start = current_line
            end = current_line + n_lines - 1
            cmd_str = entry["command"]
            published_url = None
            if "  # published to " in cmd_str:
                cmd_part, published_url = cmd_str.split("  # published to ", 1)
                cmd_str = cmd_part.strip()
                published_url = published_url.strip()

            pub_note = f" (Published: <{published_url}>)" if published_url else ""
            toc_items.append(
                f"{i + 1}. [Entry {entry['id']}](#entry-{entry['id']}) (lines {start}-{end}) — `{cmd_str}`{pub_note}\n"
            )
            current_line += n_lines

    output = [header]
    if manifest_str:
        output.append(manifest_str)
    if use_toc and ENTRIES:
        output.append(toc_header)
        output.extend(toc_items)
        output.append(toc_footer)
    output.extend(entry_strings)
    return "".join(output)


def entry_gemini_api():
    repo = fetch("github://google-gemini/cookbook")

    notebooks = [
        "examples/Book_illustration.ipynb",
        "examples/Tag_and_caption_images.ipynb",
        "examples/json_capabilities/Entity_Extraction_JSON.ipynb",
        "examples/prompting/Basic_Evaluation.ipynb",
        "examples/prompting/Basic_Information_Extraction.ipynb",
        "quickstarts/Caching.ipynb",
        "quickstarts/Code_Execution.ipynb",
        "quickstarts/Counting_Tokens.ipynb",
        "quickstarts/Error_handling.ipynb",
        "quickstarts/Function_calling.ipynb",
        "quickstarts/Get_Started_Nano_Banana.ipynb",
        "quickstarts/Get_started.ipynb",
        "quickstarts/Get_started_imagen.ipynb",
        "quickstarts/Get_started_thinking.ipynb",
        "quickstarts/Grounding.ipynb",
        "quickstarts/JSON_mode.ipynb",
        "quickstarts/Safety.ipynb",
        "quickstarts/System_instructions.ipynb",
    ]

    for nb in notebooks:
        nb_path = os.path.join(repo, nb)
        colab = f"https://colab.research.google.com/github/google-gemini/cookbook/blob/main/{nb}"

        try:
            with open(nb_path, encoding="utf-8") as f:
                data = json.load(f)

            _clean_notebook_data(data)

            content = json.dumps(data, indent=2)

            display_url = (
                f"https://raw.githubusercontent.com/google-gemini/cookbook/main/{nb}"
            )
            display_cmd = f"curl -sfSL '{display_url}' | jq '.cells[] |= if .cell_type == \"code\" then .outputs = [] | .execution_count = null else . end'  # published to {colab}"
            _emit_entry(display_cmd, content)
        except Exception as e:
            print(f"context: failed to process notebook {nb}: {e}", file=sys.stderr)

    urls = [
        "https://ai.google.dev/gemini-api/docs/caching.md.txt",
        "https://ai.google.dev/gemini-api/docs/code-execution.md.txt",
        "https://ai.google.dev/gemini-api/docs/files.md.txt",
        "https://ai.google.dev/gemini-api/docs/function-calling.md.txt",
        "https://ai.google.dev/gemini-api/docs/google-search.md.txt",
        "https://ai.google.dev/gemini-api/docs/imagen.md.txt",
        "https://ai.google.dev/gemini-api/docs/image-generation.md.txt",
        "https://ai.google.dev/gemini-api/docs/image-understanding.md.txt",
        "https://ai.google.dev/gemini-api/docs/interactions.md.txt",
        "https://ai.google.dev/gemini-api/docs/long-context.md.txt",
        "https://ai.google.dev/gemini-api/docs/models.md.txt",
        "https://ai.google.dev/gemini-api/docs/pricing.md.txt",
        "https://ai.google.dev/gemini-api/docs/prompting-strategies.md.txt",
        "https://ai.google.dev/gemini-api/docs/rate-limits.md.txt",
        "https://ai.google.dev/gemini-api/docs/safety-settings.md.txt",
        "https://ai.google.dev/gemini-api/docs/structured-output.md.txt",
        "https://ai.google.dev/gemini-api/docs/text-generation.md.txt",
        "https://ai.google.dev/gemini-api/docs/thinking.md.txt",
        "https://ai.google.dev/gemini-api/docs/tokens.md.txt",
        "https://ai.google.dev/gemini-api/docs/troubleshooting.md.txt",
        "https://ai.google.dev/gemini-api/docs/url-context.md.txt",
    ]

    for url in urls:
        entry_url(url)


