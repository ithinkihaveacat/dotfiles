#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") PROMPT

Evaluates if the input from stdin satisfies the PROMPT.
Returns true (exit 0) or false (exit 1). Uses the gemini-flash-lite-latest
model by default.

Arguments:
  PROMPT      The condition or question to evaluate (e.g., "mentions Elvis")

Options:
  --help         Display this help message and exit
  --model MODEL  Gemini model to use (default: gemini-flash-lite-latest)
  -v, --verbose  Output "true" or "false" to stderr

Environment:
  GEMINI_API_KEY     Optional. Read by gemini-api; a key stored with
                     "gemini-api configure" is also accepted.
  GEMINI_MODEL       Optional. Default model if --model is not given.

Exit Codes:
  0  True (satisfies prompt)
  1  False (does not satisfy prompt)
  2  Error (no input, API or transport failure, unparseable response)
  127  Missing required dependency

Examples:
  cat file.txt | $(basename "$0") "mentions Elvis"
  echo "hello world" | $(basename "$0") "is a greeting" && echo "It is!"
EOF
  exit 0
}

PROMPT=""
VERBOSE=false
MODEL="${GEMINI_MODEL:-gemini-flash-lite-latest}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help | -h)
      usage
      ;;
    --model)
      if [[ $# -lt 2 ]]; then
        echo "$(basename "$0"): --model requires an argument" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 2
      fi
      MODEL="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -*)
      echo "$(basename "$0"): unknown option: $1" >&2
      echo "Try '$(basename "$0") --help' for more information." >&2
      exit 2
      ;;
    *)
      if [[ -z "$PROMPT" ]]; then
        PROMPT="$1"
        shift
      else
        echo "$(basename "$0"): too many arguments" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 2
      fi
      ;;
  esac
done

if [[ -z "$PROMPT" ]]; then
  echo "Usage: $(basename "$0") PROMPT [OPTIONS]" >&2
  echo "Examples: $(basename "$0") \"Is the user asking for help?\"" >&2
  echo "Try '$(basename "$0") --help' for more information." >&2
  exit 2
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require jq
require gemini-text

# Read stdin into a temp file and use --rawfile-style handling so large inputs
# never hit ARG_MAX.
STDIN_FILE=$(mktemp)
trap 'rm -f "$STDIN_FILE"' EXIT
cat >"$STDIN_FILE"
if [[ ! -s "$STDIN_FILE" ]]; then
  echo "$(basename "$0"): missing input from stdin" >&2
  echo "Try '$(basename "$0") --help' for more information." >&2
  exit 2
fi

CONTEXT_FILE=$(mktemp)
trap 'rm -f "$STDIN_FILE" "$CONTEXT_FILE"' EXIT
{
  printf '<context>\n'
  cat "$STDIN_FILE"
  printf '\n</context>\n'
} >"$CONTEXT_FILE"

# Build the response schema with jq so the condition is escaped, whatever the
# caller passed.
BODY=$(jq -cn --arg prompt "$PROMPT" '
  {
    response_format: {
      type: "text",
      mime_type: "application/json",
      schema: {
        type: "object",
        properties: {
          satisfies: {
            type: "boolean",
            description: ("True if the text satisfies the condition: " + $prompt)
          }
        },
        required: ["satisfies"]
      }
    }
  }')

TASK="<task>
Evaluate if the text in the context satisfies this condition: $PROMPT
</task>
<instructions>
Respond with true if the condition is satisfied, and false otherwise. Provide only the requested JSON.
</instructions>"

if ! TEXT=$(gemini-text \
  --model "$MODEL" \
  --body "$BODY" \
  --context "$CONTEXT_FILE" \
  "$TASK"); then
  exit 2
fi

# Parse the boolean result
RESULT=$(printf '%s' "$TEXT" | jq -r '.satisfies' 2>/dev/null || true)
if [[ "$RESULT" != "true" && "$RESULT" != "false" ]]; then
  echo "$(basename "$0"): failed to parse response: $TEXT" >&2
  exit 2
fi

if [[ "$VERBOSE" == "true" ]]; then
  echo "$RESULT" >&2
fi

if [[ "$RESULT" == "true" ]]; then
  exit 0
else
  exit 1
fi
