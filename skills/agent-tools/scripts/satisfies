#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") PROMPT

Evaluates if the input from stdin satisfies the PROMPT.
Returns true (exit 0) or false (exit 1).

Arguments:
  PROMPT      The condition or question to evaluate (e.g., "mentions Elvis")

Options:
  --help         Display this help message and exit
  --model MODEL  Gemini model to use (default: gemini-2.5-flash-lite)
  -v, --verbose  Output "true" or "false" to stderr

Environment:
  GEMINI_API_KEY     Required. Your Gemini API key.
  GEMINI_MODEL       Optional. Default model if --model is not given.
  SATISFIES_OFFLINE  Refuse to use the network. This tool caches nothing, so
                     offline mode fails immediately rather than serving a
                     stale answer. Falls back to AGENT_OFFLINE when unset.
  AGENT_OFFLINE      Workspace-wide offline policy (see above).

Exit Codes:
  0  True (satisfies prompt)
  1  False (does not satisfy prompt)

Examples:
  cat file.txt | $(basename "$0") "mentions Elvis"
  echo "hello world" | $(basename "$0") "is a greeting" && echo "It is!"
EOF
  exit 0
}

PROMPT=""
VERBOSE=false
MODEL="${GEMINI_MODEL:-gemini-2.5-flash-lite}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help | -h)
      usage
      ;;
    --model)
      if [[ $# -lt 2 ]]; then
        echo "$(basename "$0"): --model requires an argument" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
      fi
      MODEL="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -*)
      echo "$(basename "$0"): unknown option: $1" >&2
      echo "Try '$(basename "$0") --help' for more information." >&2
      exit 1
      ;;
    *)
      if [[ -z "$PROMPT" ]]; then
        PROMPT="$1"
        shift
      else
        echo "$(basename "$0"): too many arguments" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
      fi
      ;;
  esac
done

if [[ -z "$PROMPT" ]]; then
  echo "$(basename "$0"): missing PROMPT argument" >&2
  echo "Try '$(basename "$0") --help' for more information." >&2
  exit 1
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require curl
require jq

# Refuse to run when the environment declares there is no network. Every run is
# a fresh model call against a new prompt, so there is nothing cached to serve
# and offline mode fails here rather than on a connect timeout. The per-tool
# variable wins when set (including when set to 0, to exempt this tool from a
# workspace-wide policy) -- see coding-standards/references/caching.md.
require_network() {
  local var="$1" value
  [[ -n "${!var+x}" ]] || var="AGENT_OFFLINE"
  value="${!var:-}"
  case "$(echo "$value" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | on)
      echo "$(basename "$0"): offline ($var=$value) and no cached answer: this command calls the Gemini API" >&2
      echo "$(basename "$0"): re-run where there is network, or set $1=0 to exempt this tool" >&2
      exit 1
      ;;
  esac
}

require_network SATISFIES_OFFLINE

GEMINI_API_KEY="${GEMINI_API_KEY:-}"
if [[ -z "${GEMINI_API_KEY:-}" ]]; then
  echo "$(basename "$0"): GEMINI_API_KEY environment variable not set" >&2
  exit 1
fi

# Read stdin into a temp file and use --rawfile to avoid ARG_MAX limits on
# large inputs (see shell.md "Handling Large Inputs with jq").
STDIN_FILE=$(mktemp)
trap 'rm -f "$STDIN_FILE"' EXIT
cat >"$STDIN_FILE"
if [[ ! -s "$STDIN_FILE" ]]; then
  echo "$(basename "$0"): missing input from stdin" >&2
  exit 1
fi

URL="https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent"

# Construct JSON payload using jq to ensure safe escaping
REQUEST_BODY=$(jq -n \
  --arg prompt "$PROMPT" \
  --rawfile stdin_content "$STDIN_FILE" \
  '{
    contents: [{
      parts: [
        {text: ("<context>\n" + $stdin_content + "\n</context>")},
        {text: ("<task>\nEvaluate if the text in the context satisfies this condition: " + $prompt + "\n</task>\n<instructions>\nRespond with true if the condition is satisfied, and false otherwise. Provide only the requested JSON.\n</instructions>")}
      ]
    }],
    generationConfig: {
      responseMimeType: "application/json",
      responseJsonSchema: {
        type: "object",
        properties: {
          satisfies: {
            type: "boolean",
            description: ("True if the text satisfies the condition: " + $prompt)
          }
        },
        required: ["satisfies"]
      }
    }
  }')

# Read the status via -w '%{http_code}' rather than trusting curl's exit code:
# it is "000" only when no HTTP response arrived at all, which is what separates
# a blocked or absent network from an API that answered with an error. Capturing
# the exit code also stops a failed curl from killing the script silently under
# `set -e`, before any of the handling below can run.
CURL_STATUS=0
RAW=$(echo "${REQUEST_BODY}" | curl -sS -X POST \
  -H "x-goog-api-key: $GEMINI_API_KEY" \
  -H "Content-Type: application/json" \
  -d @- -w '\n%{http_code}' \
  "${URL}" 2>/dev/null) || CURL_STATUS=$?

HTTP_STATUS="${RAW##*$'\n'}"
RESPONSE="${RAW%$'\n'*}"

# The status decides, not curl's exit code: -w always emits a three-digit code
# when a response arrived, and "000" only when none did. The exit code cannot be
# trusted for this -- in a `jq | curl` pipeline `pipefail` reports the pipeline's
# status, so a curl that answered fine still surfaces as non-zero -- so it is
# reported for diagnosis but does not drive the decision.
if [[ ! "$HTTP_STATUS" =~ ^[0-9]{3}$ || "$HTTP_STATUS" == "000" ]]; then
  echo "$(basename "$0"): could not reach $URL (curl exit $CURL_STATUS, http ${HTTP_STATUS:-none}: network unreachable, DNS failure, or blocked egress)" >&2
  exit 1
fi

if [[ "$HTTP_STATUS" != 2?? ]]; then
  ERROR_MSG=$(echo "$RESPONSE" | jq -r '.error.message // empty' 2>/dev/null || true)
  echo "$(basename "$0"): API error (HTTP $HTTP_STATUS): ${ERROR_MSG:-no error message in response}" >&2
  exit 1
fi

# Extract the JSON response text
TEXT=$(echo "$RESPONSE" | jq -r '.candidates[0].content.parts[0].text // empty')
if [[ -z "$TEXT" ]]; then
  echo "$(basename "$0"): no response text received from API" >&2
  echo "Full response: $RESPONSE" >&2
  exit 1
fi

# Parse the boolean result
RESULT=$(echo "$TEXT" | jq -r '.satisfies')
if [[ "$RESULT" != "true" && "$RESULT" != "false" ]]; then
  echo "$(basename "$0"): failed to parse response: $TEXT" >&2
  exit 1
fi

if [[ "$VERBOSE" == "true" ]]; then
  echo "$RESULT" >&2
fi

if [[ "$RESULT" == "true" ]]; then
  exit 0
else
  exit 1
fi
