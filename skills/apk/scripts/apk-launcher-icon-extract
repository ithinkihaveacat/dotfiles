#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] APK_FILE

Extracts the launcher icon and round launcher icon from an APK.

The script decodes the APK, finds the icon resources referenced in the
AndroidManifest.xml, and saves them to the current directory or a specified
output directory. It handles both vector drawables (XML) and raster images (PNG)
and picks the highest density version available.

Arguments:
  APK_FILE    Path to an APK file, split-APK archive (.zip/.apks), or split directory.

Options:
  -o, --output DIR  The directory to save the icons to. Defaults to the current directory.
  -h, --help        Display this help message and exit

Examples:
  # Extract launcher icons to the current directory
  $(basename "$0") /path/to/your/app.apk

  # Extract launcher icons to a specific directory
  $(basename "$0") --output /tmp/icons /path/to/your/app.zip
EOF
  exit 0
}

OUTPUT_DIR="."

while [[ $# -gt 0 ]]; do
  case "$1" in
    help | --help | -h)
      usage
      ;;
    -o | --output)
      if [ -z "${2:-}" ]; then
        echo "$(basename "$0"): --output option requires an argument" >&2
        exit 1
      fi
      OUTPUT_DIR="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option $1" >&2
      exit 1
      ;;
    *)
      break # First non-option argument is the APK_FILE
      ;;
  esac
done

usage_short() {
  cat <<EOF >&2
Usage: $(basename "$0") [OPTIONS] APK_FILE

Extract launcher icon image file from an Android APK package.

Examples:
  $(basename "$0") app-release.apk

Try '$(basename "$0") --help' for more information.
EOF
  exit 1
}

if [ -z "${1:-}" ]; then
  usage_short
fi

shopt -s nullglob

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require unzip
require apktool
require xmllint
require xpath

function match_vector() {
  GLOB="$1"
  GLOB="${GLOB/@/res\/}"
  GLOB="${GLOB/mipmap/mipmap*}"
  GLOB="${GLOB}*.xml"
  # shellcheck disable=SC2206
  MATCHES=($2/$GLOB)
  echo "${MATCHES[0]:-}"
}

function match_raster() {
  densities=(xxxhdpi xxhdpi xhdpi hdpi mdpi)
  if [[ $1 =~ ^@drawable ]]; then
    for d in "${densities[@]}"; do
      GLOB="$1"
      GLOB="${GLOB/@/res\/}"
      GLOB="${GLOB/drawable/drawable-*}" # More specific glob
      GLOB="${GLOB}.png"
      # shellcheck disable=SC2206
      MATCHES=($2/$GLOB)
      if [ ${#MATCHES[@]} -gt 0 ]; then
        echo "${MATCHES[0]}"
        return
      fi
    done
  elif [[ $1 =~ ^@mipmap ]]; then
    for d in "${densities[@]}"; do
      GLOB="$1"
      GLOB="${GLOB/@/res\/}"
      GLOB="${GLOB/mipmap/mipmap-${d}*}"
      GLOB="${GLOB}*.png"
      # shellcheck disable=SC2206
      MATCHES=($2/$GLOB)
      if [ ${#MATCHES[@]} -gt 0 ]; then
        echo "${MATCHES[0]}"
        return
      fi
    done
  fi
}

function extract_resource() {
  DIR="$1"
  REFERENCE="$2"
  PREFIX="$3"

  VECTOR_ICON=$(match_vector "$REFERENCE" "$DIR")
  RASTER_ICON=$(match_raster "$REFERENCE" "$DIR")

  if [ -n "$VECTOR_ICON" ]; then
    FILENAME="$OUTPUT_DIR/$PREFIX.xml"
    xmllint --format "$VECTOR_ICON" >"$FILENAME"
    echo >&2 "Saved $FILENAME ($REFERENCE resolved to $VECTOR_ICON)"
  elif [ -n "$RASTER_ICON" ]; then
    FILENAME="$OUTPUT_DIR/$PREFIX.png"
    cp "$RASTER_ICON" "$FILENAME"
    echo >&2 "Saved $FILENAME ($REFERENCE resolved to $RASTER_ICON)"
  fi
}

TMPDIR_EXTRACT=""
DECODED_TMPDIR=""

cleanup() {
  if [ -n "${TMPDIR_EXTRACT:-}" ] && [ -d "$TMPDIR_EXTRACT" ]; then
    rm -rf -- "$TMPDIR_EXTRACT"
  fi
  if [ -n "${DECODED_TMPDIR:-}" ] && [ -d "$DECODED_TMPDIR" ]; then
    rm -rf -- "$DECODED_TMPDIR"
  fi
}
trap cleanup EXIT

is_base_apk_name() {
  local lower_name
  lower_name=$(basename "$1" | tr '[:upper:]' '[:lower:]')
  case "$lower_name" in
    base.apk | *-base-split.apk | *base-master.apk) return 0 ;;
    *) return 1 ;;
  esac
}

if [ ! -e "$1" ]; then
  echo "$(basename "$0"): $1: No such file or directory" >&2
  exit 1
fi

if [ -d "$1" ]; then
  BASEAPK=""
  for candidate in "$1"/*.apk; do
    [ -f "$candidate" ] || continue
    if is_base_apk_name "$candidate"; then
      BASEAPK="$candidate"
      break
    fi
  done
  if [ -z "$BASEAPK" ]; then
    echo "$(basename "$0"): no base APK (base.apk, base-master.apk, or *-base-split.apk) found in $1" >&2
    exit 1
  fi
elif [ ! -f "$1" ]; then
  echo "$(basename "$0"): $1: Not a regular file or directory" >&2
  exit 1
elif [[ "$1" == *.zip || "$1" == *.apks ]]; then
  base_entry=""
  while IFS= read -r entry; do
    [[ -z "$entry" || "$entry" == */ ]] && continue
    if is_base_apk_name "$entry"; then
      base_entry="$entry"
      break
    fi
  done < <(unzip -Z1 "$1" 2>/dev/null | tr -d '\r')

  if [ -z "$base_entry" ]; then
    echo "$(basename "$0"): no base APK (base.apk, base-master.apk, or *-base-split.apk) found in $1" >&2
    exit 1
  fi

  TMPDIR_EXTRACT=$(mktemp -d)
  unzip -q -j "$1" "$base_entry" -d "$TMPDIR_EXTRACT"
  BASEAPK="$TMPDIR_EXTRACT/$(basename "$base_entry")"
  if [ ! -f "$BASEAPK" ]; then
    echo "$(basename "$0"): failed to extract $base_entry from $1" >&2
    exit 1
  fi
else
  BASEAPK="$1"
fi

mkdir -p "$OUTPUT_DIR"
DECODED_TMPDIR=$(mktemp -d)
apktool d "$BASEAPK" -f -s -o "$DECODED_TMPDIR" >/dev/null 2>&1

MANIFEST_PATH="$DECODED_TMPDIR/AndroidManifest.xml"
INPUT_PREFIX=$(basename "${1%/}")
INPUT_PREFIX="${INPUT_PREFIX%.zip}"
INPUT_PREFIX="${INPUT_PREFIX%.apks}"

extract_resource \
  "$DECODED_TMPDIR" \
  "$(xpath -n -q -e 'string(/manifest/application/@android:icon)' <"$MANIFEST_PATH")" \
  "${INPUT_PREFIX}-launcher-icon"

if [[ -n "$(xpath -n -q -e 'string(/manifest/application/@android:roundIcon)' <"$MANIFEST_PATH")" ]]; then
  extract_resource \
    "$DECODED_TMPDIR" \
    "$(xpath -n -q -e 'string(/manifest/application/@android:roundIcon)' <"$MANIFEST_PATH")" \
    "${INPUT_PREFIX}-launcher-icon-round"
fi
