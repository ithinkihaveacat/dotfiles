# Annotations hidden by 'show annotations' unless --all is given: compiler
# bookkeeping rather than annotations written in source.
NOISE_ANNOTATIONS = ("Lkotlin/Metadata;",)
NOISE_ANNOTATION_PREFIXES = ("Ldalvik/annotation/",)

DEX_MAGIC = b"dex\n"
DEX_NAME_RE = re.compile(r"^classes(\d*)\.dex$")
APKTOOL_SMALI_DIR_RE = re.compile(r"^smali(?:_classes(\d+))?$")
INVOKE_RE = re.compile(r"^\s*invoke-[\w/-]+\s+\{[^}]*\},\s*([^\s,]+)")

