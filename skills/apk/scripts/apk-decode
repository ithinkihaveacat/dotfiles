#!/usr/bin/env bash

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] APK_FILE

Decodes an APK file using apktool and outputs the directory path.

This script uses 'apktool d' to decode the APK's resources.
The path to the output directory is printed to standard output.

Arguments:
  APK_FILE          Path to an APK file.

Options:
  -o, --output DIR  The directory to decode the APK into.
                    (defaults to a new temporary directory)
  --help            Display this help message and exit

Examples:
  # Decode an APK into a new temporary directory
  DECODED_PATH=\$($(basename "$0") /path/to/your/app.apk)
  ls "\$DECODED_PATH"

  # Decode an APK into a specific directory
  $(basename "$0") --output /tmp/decoded-apk /path/to/your/app.apk
EOF
  exit 0
}

OUTPUT_DIR=""
OUTPUT_DIR_USER=""

# Manual parsing for --output, compatible with macOS getopt
while [[ $# -gt 0 ]]; do
  case "$1" in
    help | --help | -h)
      usage
      ;;
    -o | --output)
      if [ -z "$2" ]; then
        echo "$(basename "$0"): --output option requires an argument" >&2
        exit 1
      fi
      OUTPUT_DIR="$2"
      OUTPUT_DIR_USER=1
      shift 2
      ;;
    *)
      break # First non-option argument is the APK_FILE
      ;;
  esac
done

find_apktool() {
  if command -v apktool >/dev/null 2>&1; then
    command -v apktool
    return 0
  fi
  local candidate
  for candidate in \
    "$HOME/.local/bin/apktool" \
    "/opt/homebrew/bin/apktool" \
    "/usr/local/bin/apktool" \
    "/usr/bin/apktool"; do
    if [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

APKTOOL_BIN=""
APKTOOL_CMD=()
if APKTOOL_BIN=$(find_apktool); then
  APKTOOL_CMD=("$APKTOOL_BIN")
elif [ -f "$HOME/.local/share/apktool/apktool.jar" ] && command -v java >/dev/null 2>&1; then
  APKTOOL_CMD=(java -jar "$HOME/.local/share/apktool/apktool.jar")
else
  cat >&2 <<EOF
$(basename "$0"): apktool not found on PATH
  Install: sudo apt-get install apktool (Debian/Ubuntu), brew install apktool (macOS),
           or ~/.dotfiles/install.sh --with android
  Alternatives without apktool:
    apk-info file <apk> <path>             # extract/format binary XML
    aapt2 dump resources <apk>             # dump resource table entries
    aapt2 dump xmltree <apk> --file <path> # inspect compiled XML tree
EOF
  exit 127
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require unzip

usage_short() {
  cat <<EOF >&2
Usage: $(basename "$0") [OPTIONS] APK_FILE

Decompile and extract Android APK file resources and manifest using apktool.

Examples:
  $(basename "$0") app-release.apk

Try '$(basename "$0") --help' for more information.
EOF
  exit 1
}

if [ -z "${1:-}" ]; then
  usage_short
fi

if [ ! -f "$1" ]; then
  echo "$(basename "$0"): $1: No such file or directory" >&2
  exit 1
fi

if [[ $1 == *.zip ]]; then
  TMPDIR=$(mktemp -d)
  trap 'rm -rf -- "$TMPDIR"' EXIT
  unzip -q -j "$1" '*-base-split.apk' -d "$TMPDIR"
  BASEAPKS=("$TMPDIR"/*-base-split.apk)
  BASEAPK="${BASEAPKS[0]}"
  if [ ! -f "$BASEAPK" ]; then
    echo "$(basename "$0"): *-base-split.apk not found in zip, aborting" >&2
    exit 1
  fi
else
  BASEAPK="$1"
fi

if [ -z "$OUTPUT_DIR" ]; then
  OUTPUT_DIR=$(mktemp -d)
else
  mkdir -p "$OUTPUT_DIR"
fi

# -s to skip source (resources only)
if ! "${APKTOOL_CMD[@]}" d "$BASEAPK" -f -o "$OUTPUT_DIR" >/dev/null 2>&1; then
  echo "$(basename "$0"): apktool failed to decode $BASEAPK" >&2
  if [ -z "$OUTPUT_DIR_USER" ]; then
    rm -rf "$OUTPUT_DIR"
  fi
  exit 1
fi

echo "$OUTPUT_DIR"
