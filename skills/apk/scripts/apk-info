#!/usr/bin/env bash

set -euo pipefail

SCRIPT_NAME=$(basename "$0")

# Global variables for base APK extraction and cleanup
BASEAPK=""
TMPDIR=""

cleanup() {
  if [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ]; then
    rm -rf "$TMPDIR"
  fi
}
trap cleanup EXIT

# Helper to extract split-APKs from ZIP or use standalone APK
prepare_apk() {
  local apk_path="$1"
  if [ -z "$apk_path" ]; then
    echo "$SCRIPT_NAME: APK file path required" >&2
    exit 1
  fi
  if [ ! -f "$apk_path" ]; then
    echo "$SCRIPT_NAME: $apk_path: No such file or directory" >&2
    exit 1
  fi

  if [[ "$apk_path" == *.zip ]]; then
    TMPDIR=$(mktemp -d)
    unzip -q -j "$apk_path" '*-base-split.apk' -d "$TMPDIR"
    local base_apks=("$TMPDIR"/*-base-split.apk)
    BASEAPK="${base_apks[0]:-}"
    if [ ! -f "$BASEAPK" ]; then
      echo "$SCRIPT_NAME: *-base-split.apk not found in zip, aborting" >&2
      exit 1
    fi
  else
    BASEAPK="$apk_path"
  fi
}

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME COMMAND [ARGUMENTS]

A unified tool for inspecting Android APK files and split-APK ZIP archives.

Commands:
  package              Print the package name (application ID) of the APK.
  manifest             Display the formatted AndroidManifest.xml.
  version              Print package version details (name and code).
  libraries            List or query embedded Jetpack/Kotlinx library versions.
  tiles                List Wear OS tiles services declared in the manifest.
  complications        List Wear OS complications data providers.
  launcher             Print the path of the launcher icon resource.
  file                 Extract and print the contents of a specific file from the APK.

Options:
  --help, -h           Display this help message and exit.

Examples:
  $SCRIPT_NAME package app.apk
  $SCRIPT_NAME version app.apk
  $SCRIPT_NAME libraries --json app.zip
  $SCRIPT_NAME libraries --only androidx.wear.compose_compose-foundation app.apk
  $SCRIPT_NAME file app.apk res/xml/watch_face_info.xml
EOF
  exit "${1:-0}"
}

usage_short() {
  cat <<EOF >&2
Usage: $SCRIPT_NAME COMMAND [ARGUMENTS]

A unified tool for inspecting Android APK files and split-APK ZIP archives.

Commands:
  package, manifest, version, libraries, tiles, complications, launcher, file

Examples:
  $SCRIPT_NAME package app.apk
  $SCRIPT_NAME version app.apk
  $SCRIPT_NAME libraries app.apk

Try '$SCRIPT_NAME --help' for more information.
EOF
  exit 1
}

if [[ $# -lt 1 ]]; then
  usage_short
fi

case "$1" in
  help | --help | -h)
    if [[ -n "${2:-}" ]]; then
      "$0" "$2" --help
    fi
    usage 0
    ;;
  *)
    COMMAND="$1"
    shift
    ;;
esac

# Check dependencies
require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$SCRIPT_NAME: $1 not found"
    exit 127
  }
}

require apkanalyzer
require unzip

# =============================================================================
# COMMAND IMPLEMENTATIONS
# =============================================================================

cmd_package() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
    cat <<EOF
Usage: $SCRIPT_NAME package APK_FILE

Print the package name (application ID) of the APK.

Arguments:
  APK_FILE    Path to an APK file or split-APK ZIP archive.

Options:
  --help, -h  Display this help message and exit.

Examples:
  $SCRIPT_NAME package app.apk
  $SCRIPT_NAME package app.zip
EOF
    exit 0
  fi
  if [ $# -lt 1 ]; then
    cat <<EOF >&2
Usage: $SCRIPT_NAME package APK_FILE

Print the package name (application ID) of the APK.

Examples:
  $SCRIPT_NAME package app.apk

Try '$SCRIPT_NAME package --help' for more information.
EOF
    exit 1
  fi
  prepare_apk "$1"
  apkanalyzer manifest application-id "$BASEAPK"
}

cmd_manifest() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
    cat <<EOF
Usage: $SCRIPT_NAME manifest APK_FILE

Display the formatted AndroidManifest.xml.

Arguments:
  APK_FILE    Path to an APK file or split-APK ZIP archive.

Options:
  --help, -h  Display this help message and exit.

Examples:
  $SCRIPT_NAME manifest app.apk
  $SCRIPT_NAME manifest app.zip
EOF
    exit 0
  fi
  require xmllint
  if [ $# -lt 1 ]; then
    cat <<EOF >&2
Usage: $SCRIPT_NAME manifest APK_FILE

Display the formatted AndroidManifest.xml.

Examples:
  $SCRIPT_NAME manifest app.apk

Try '$SCRIPT_NAME manifest --help' for more information.
EOF
    exit 1
  fi
  prepare_apk "$1"
  apkanalyzer manifest print "$BASEAPK" | xmllint --format -
}

get_library_version() {
  local lib="$1"
  local file=""

  if [[ "$lib" == "whs" || "$lib" == "androidx.health_health-services-client" ]]; then
    file=$(apkanalyzer files list "$BASEAPK" | grep -E -m1 '/(META-INF/androidx.health_health-services-client\.version|whs\.properties)$')
  else
    file=$(apkanalyzer files list "$BASEAPK" | grep -E -m1 "/META-INF/${lib}\.version$")
  fi

  if [ -n "$file" ]; then
    local raw_val
    raw_val=$(apkanalyzer files cat --file "$file" "$BASEAPK" 2>/dev/null | tr -d '\r\n')
    if [[ "$file" == *whs.properties ]]; then
      if [[ "$raw_val" == *"="* ]]; then
        echo "$raw_val" | awk -F= '/version/ {print $2}' | tr -d ' '
      else
        echo "$raw_val"
      fi
    else
      echo "$raw_val"
    fi
  fi
}

list_all_libraries_json() {
  require jq
  local files
  files=$(apkanalyzer files list "$BASEAPK" | grep -E '/META-INF/.*\.version$')

  if apkanalyzer files list "$BASEAPK" | grep -q '/whs.properties$' && ! echo "$files" | grep -q 'androidx.health_health-services-client'; then
    files=$(printf "%s\n%s" "$files" "/whs.properties")
  fi

  if [ -z "$files" ]; then
    echo "{}"
    return
  fi

  local tsv_data
  # Run the entire loop inside a single command substitution block to preserve newlines
  tsv_data=$(
    while read -r file; do
      [ -z "$file" ] && continue
      local lib_id
      if [[ "$file" == *whs.properties ]]; then
        lib_id="whs"
      else
        lib_id=$(basename "$file" .version)
      fi

      local version_val
      version_val=$(apkanalyzer files cat --file "$file" "$BASEAPK" 2>/dev/null | tr -d '\r\n')
      if [[ "$file" == *whs.properties && "$version_val" == *"="* ]]; then
        version_val=$(echo "$version_val" | awk -F= '/version/ {print $2}' | tr -d ' ')
      fi

      if [ -n "$version_val" ]; then
        printf "%s\t%s\n" "$lib_id" "$version_val"
      fi
    done <<<"$files"
  )

  if [ -z "$tsv_data" ]; then
    echo "{}"
  else
    echo "$tsv_data" | jq -Rs 'split("\n") | map(select(length > 0) | split("\t")) | map({(.[0]): .[1]}) | add'
  fi
}

cmd_version() {
  local mode="all"

  usage_version() {
    cat <<EOF
Usage: $SCRIPT_NAME version [OPTIONS] APK_FILE

Print package version details (name and code).

Arguments:
  APK_FILE             Path to an APK file or split-APK ZIP archive.

Options:
  --code               Print only the application version code string.
  --name               Print only the application version name string.
  --help, -h           Display this help message and exit.

Examples:
  $SCRIPT_NAME version app.apk
  $SCRIPT_NAME version --code app.apk
  $SCRIPT_NAME version --name app.zip
EOF
    exit "${1:-0}"
  }

  while [[ $# -gt 0 ]]; do
    case "$1" in
      help | --help | -h)
        usage_version 0
        ;;
      --code)
        mode="code"
        shift
        ;;
      --name)
        mode="name"
        shift
        ;;
      -*)
        echo "$SCRIPT_NAME version: unknown option: $1" >&2
        exit 1
        ;;
      *)
        break
        ;;
    esac
  done

  if [ $# -lt 1 ]; then
    cat <<EOF >&2
Usage: $SCRIPT_NAME version [OPTIONS] APK_FILE

Print package version details (name and code).

Examples:
  $SCRIPT_NAME version app.apk
  $SCRIPT_NAME version --code app.apk

Try '$SCRIPT_NAME version --help' for more information.
EOF
    exit 1
  fi

  prepare_apk "$1"

  case "$mode" in
    code)
      apkanalyzer manifest version-code "$BASEAPK"
      ;;
    name)
      apkanalyzer manifest version-name "$BASEAPK"
      ;;
    all)
      local code name
      code=$(apkanalyzer manifest version-code "$BASEAPK")
      name=$(apkanalyzer manifest version-name "$BASEAPK")
      echo "Version Name: $name"
      echo "Version Code: $code"
      ;;
  esac
}

cmd_libraries() {
  local json_out=false
  local only_lib=""

  usage_libraries() {
    cat <<EOF
Usage: $SCRIPT_NAME libraries [OPTIONS] APK_FILE

List or query embedded Jetpack/Kotlinx library versions.

Arguments:
  APK_FILE             Path to an APK file or split-APK ZIP archive.

Options:
  --json               Output all library versions as a JSON map.
  --only | --library   Print only the version string of a specific library.
  --help, -h           Display this help message and exit.

Examples:
  $SCRIPT_NAME libraries app.apk
  $SCRIPT_NAME libraries --json app.zip
  $SCRIPT_NAME libraries --only androidx.wear.compose_compose-foundation app.apk

Common Jetpack Library IDs:
  androidx.wear.compose_compose-foundation
  androidx.health_health-services-client
EOF
    exit "${1:-0}"
  }

  while [[ $# -gt 0 ]]; do
    case "$1" in
      help | --help | -h)
        usage_libraries 0
        ;;
      --json)
        json_out=true
        shift
        ;;
      --only | --library)
        if [ -z "${2:-}" ]; then
          echo "$SCRIPT_NAME libraries: $1 requires an argument" >&2
          exit 1
        fi
        only_lib="$2"
        shift 2
        ;;
      -*)
        echo "$SCRIPT_NAME libraries: unknown option: $1" >&2
        exit 1
        ;;
      *)
        break
        ;;
    esac
  done

  if [ $# -lt 1 ]; then
    cat <<EOF >&2
Usage: $SCRIPT_NAME libraries [OPTIONS] APK_FILE

List or query embedded Jetpack/Kotlinx library versions.

Examples:
  $SCRIPT_NAME libraries app.apk
  $SCRIPT_NAME libraries --json app.zip

Try '$SCRIPT_NAME libraries --help' for more information.
EOF
    exit 1
  fi

  prepare_apk "$1"

  if [ -n "$only_lib" ]; then
    # OPTIMIZED DIRECT QUERY PATH
    local ver
    ver=$(get_library_version "$only_lib")
    if [ -n "$ver" ]; then
      echo "$ver"
    else
      echo "$SCRIPT_NAME libraries: library '$only_lib' not found in APK" >&2
      exit 1
    fi
  elif [ "$json_out" = true ]; then
    list_all_libraries_json
  else
    # TABULAR OUTPUT (Space-aligned columns via column)
    require jq
    require column
    local libs
    libs=$(list_all_libraries_json)
    if [ "$libs" = "{}" ]; then
      echo "No internal libraries detected."
      return
    fi

    (
      printf "%s\t%s\n" "Library" "Version"
      printf "%s\t%s\n" "-------" "-------"
      echo "$libs" | jq -r 'to_entries | map("\(.key)\t\(.value)") | .[]'
    ) | column -t -s $'\t'
  fi
}

cmd_tiles() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
    cat <<EOF
Usage: $SCRIPT_NAME tiles APK_FILE

List Wear OS tiles services declared in the manifest.

Arguments:
  APK_FILE    Path to an APK file or split-APK ZIP archive.

Options:
  --help, -h  Display this help message and exit.

Examples:
  $SCRIPT_NAME tiles app.apk
  $SCRIPT_NAME tiles app.zip
EOF
    exit 0
  fi
  require xpath
  require xmllint
  if [ $# -lt 1 ]; then
    cat <<EOF >&2
Usage: $SCRIPT_NAME tiles APK_FILE

List Wear OS tiles services declared in the manifest.

Examples:
  $SCRIPT_NAME tiles app.apk

Try '$SCRIPT_NAME tiles --help' for more information.
EOF
    exit 1
  fi
  prepare_apk "$1"
  apkanalyzer manifest print "$BASEAPK" | xmllint --format - | xpath -n -q -e \
    "//service[intent-filter/action[@android:name='androidx.wear.tiles.action.BIND_TILE_PROVIDER']]"
}

cmd_complications() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
    cat <<EOF
Usage: $SCRIPT_NAME complications APK_FILE

List Wear OS complications data providers.

Arguments:
  APK_FILE    Path to an APK file or split-APK ZIP archive.

Options:
  --help, -h  Display this help message and exit.

Examples:
  $SCRIPT_NAME complications app.apk
  $SCRIPT_NAME complications app.zip
EOF
    exit 0
  fi
  require xpath
  require xmllint
  if [ $# -lt 1 ]; then
    cat <<EOF >&2
Usage: $SCRIPT_NAME complications APK_FILE

List Wear OS complications data providers.

Examples:
  $SCRIPT_NAME complications app.apk

Try '$SCRIPT_NAME complications --help' for more information.
EOF
    exit 1
  fi
  prepare_apk "$1"
  apkanalyzer manifest print "$BASEAPK" | xmllint --format - | xpath -n -q -e \
    "//service[intent-filter/action[@android:name='android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST']]"
}

cmd_launcher() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
    cat <<EOF
Usage: $SCRIPT_NAME launcher APK_FILE

Print the path of the launcher icon resource.

Arguments:
  APK_FILE    Path to an APK file or split-APK ZIP archive.

Options:
  --help, -h  Display this help message and exit.

Examples:
  $SCRIPT_NAME launcher app.apk
  $SCRIPT_NAME launcher app.zip
EOF
    exit 0
  fi
  require aapt
  if [ $# -lt 1 ]; then
    cat <<EOF >&2
Usage: $SCRIPT_NAME launcher APK_FILE

Print the path of the launcher icon resource.

Examples:
  $SCRIPT_NAME launcher app.apk

Try '$SCRIPT_NAME launcher --help' for more information.
EOF
    exit 1
  fi
  prepare_apk "$1"
  local launcher_path
  launcher_path=$(aapt d badging "$BASEAPK" | awk -F\' '/^application:/ {print $4}')
  if [ -n "$launcher_path" ]; then
    echo "$launcher_path"
  else
    echo "$SCRIPT_NAME launcher: launcher icon not found" >&2
    exit 1
  fi
}

cmd_file() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
    cat <<EOF
Usage: $SCRIPT_NAME file APK_FILE FILE_PATH

Extract and print the contents of a specific file from the APK.

Arguments:
  APK_FILE    Path to an APK file or split-APK ZIP archive.
  FILE_PATH   Path to the file within the APK archive.

Options:
  --help, -h  Display this help message and exit.

Examples:
  $SCRIPT_NAME file app.apk res/xml/watch_face_info.xml
  $SCRIPT_NAME file app.zip AndroidManifest.xml
EOF
    exit 0
  fi
  require xmllint
  if [ $# -lt 2 ]; then
    cat <<EOF >&2
Usage: $SCRIPT_NAME file APK_FILE FILE_PATH

Extract and print the contents of a specific file from the APK.

Examples:
  $SCRIPT_NAME file app.apk res/xml/watch_face_info.xml

Try '$SCRIPT_NAME file --help' for more information.
EOF
    exit 1
  fi
  prepare_apk "$1"
  local path="$2"

  if [[ "$path" == *.xml ]]; then
    if apkanalyzer files cat --file "$path" "$BASEAPK" >/dev/null 2>&1; then
      apkanalyzer files cat --file "$path" "$BASEAPK" | xmllint --format -
    else
      unzip -p "$BASEAPK" "$path" | xmllint --format -
    fi
  else
    if apkanalyzer files cat --file "$path" "$BASEAPK" >/dev/null 2>&1; then
      apkanalyzer files cat --file "$path" "$BASEAPK"
    else
      unzip -p "$BASEAPK" "$path"
    fi
  fi
}

# =============================================================================
# ROUTING MAIN
# =============================================================================

CMD_FUNC="cmd_${COMMAND//-/_}"
if ! declare -f "$CMD_FUNC" >/dev/null 2>&1; then
  echo "$SCRIPT_NAME: unknown command: $COMMAND" >&2
  echo "Run '$SCRIPT_NAME --help' to see available commands" >&2
  exit 1
fi

"$CMD_FUNC" "$@"
