class Error(Exception):
    """Expected operational or validation error."""


class NotFoundError(Error):
    """Requested briefing or item does not exist in the store."""


class OfflineError(Error):
    """Network operation attempted while AGENT_OFFLINE is active."""


class BoundaryError(Error):
    """Attempted violation of a read-only, path, or constitutional boundary."""


class Parser(argparse.ArgumentParser):
    """ArgumentParser matching repository GNU-style conventions and exit 1."""

    def error(self, message: str) -> NoReturn:
        self.print_usage(sys.stderr)
        print(
            f"{self.prog}: {message}\nTry '{self.prog} --help' for more information.",
            file=sys.stderr,
        )
        sys.exit(1)

    def format_help(self) -> str:
        return (
            super()
            .format_help()
            .replace("usage:", "Usage:", 1)
            .replace("options:", "Options:", 1)
            .replace(
                "show this help message and exit",
                "Display this help message and exit",
                1,
            )
        )


def die(message: str, code: int = 1) -> NoReturn:
    print(f"{PROG}: {message}", file=sys.stderr)
    sys.exit(code)


def note(message: str) -> None:
    print(f"{PROG}: {message}", file=sys.stderr)


def is_offline() -> bool:
    val = os.environ.get("AGENT_OFFLINE", "").strip().lower()
    return val in {"1", "true", "yes", "on"}


def use_color(stream: Any = None) -> bool:
    stream = stream or sys.stdout
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR"):
        return True
    return bool(getattr(stream, "isatty", lambda: False)())


def default_dir() -> Path:
    override = os.environ.get(DIR_ENV, "").strip()
    if override:
        return Path(override).expanduser()
    xdg = os.environ.get("XDG_STATE_HOME", "").strip()
    base = Path(xdg).expanduser() if xdg else Path.home() / ".local" / "state"
    return base / "daybrief"


def default_cache_dir() -> Path:
    override = os.environ.get(CACHE_ENV, "").strip()
    if override:
        return Path(override).expanduser()
    xdg = os.environ.get("XDG_CACHE_HOME", "").strip()
    base = Path(xdg).expanduser() if xdg else Path.home() / ".cache"
    return base / "daybrief"


def resolve_model(explicit: str | None = None) -> str:
    for candidate in (
        explicit,
        os.environ.get(MODEL_ENV),
        os.environ.get("GEMINI_MODEL"),
    ):
        if candidate and candidate.strip():
            return candidate.strip()
    return DEFAULT_MODEL


def utc_now() -> datetime.datetime:
    return datetime.datetime.now(datetime.UTC)


def utc_iso(dt: datetime.datetime | None = None) -> str:
    stamp = dt or utc_now()
    return (
        stamp.astimezone(datetime.UTC)
        .isoformat(timespec="milliseconds")
        .replace("+00:00", "Z")
    )


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_text(text: str) -> str:
    return sha256_bytes(text.encode("utf-8"))


def format_age(seconds: float) -> str:
    secs = max(0, int(seconds))
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        return f"{secs // 3600}h"
    return f"{secs // 86400}d"


def write_output(content: str, output_arg: str | None) -> None:
    if not content.endswith("\n"):
        content += "\n"
    if not output_arg or output_arg == "-":
        sys.stdout.write(content)
        sys.stdout.flush()
        return
    dest = Path(output_arg).expanduser()
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(content, encoding="utf-8")


# --- Configuration -----------------------------------------------------------


@dataclass(slots=True)
class SourceConfig:
    timezone: str
    taskgo_root: Path | None
    pinboard_repo: Path | None
    private_skills: Path | None
    chalk_db: Path | None
    calendar_ics: list[str]
    tripit_ics: list[str]
    owner_emails: frozenset[str]
    weather_lat: float | None
    weather_lon: float | None
    weather_label: str


def _opt_path(raw: str | None, fallback: Path | None = None) -> Path | None:
    if raw is not None:
        cleaned = raw.strip()
        if not cleaned:
            return None
        return Path(cleaned).expanduser()
    if fallback is not None and fallback.exists():
        return fallback
    return None


def _split_list(raw: str | list[Any] | None) -> list[str]:
    if raw is None:
        return []
    if isinstance(raw, list):
        return [str(x).strip() for x in raw if str(x).strip()]
    parts = re.split(r"[\s,]+", str(raw).strip())
    return [p for p in parts if p]


def load_config(store_dir: Path) -> SourceConfig:
    cfg_data: dict[str, Any] = {}
    cfg_path = store_dir / "config.toml"
    if cfg_path.is_file():
        try:
            cfg_data = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError) as e:
            raise Error(f"invalid config {cfg_path}: {e}") from None

    sources_tbl = cfg_data.get("sources") or {}
    weather_tbl = cfg_data.get("weather") or {}

    tz_name = (
        os.environ.get("DAYBRIEF_TIMEZONE")
        or cfg_data.get("timezone")
        or DEFAULT_TIMEZONE
    )
    try:
        ZoneInfo(str(tz_name))
    except ZoneInfoNotFoundError:
        raise Error(f"unknown timezone: {tz_name}") from None

    home = Path.home()
    env_taskgo = os.environ.get("DAYBRIEF_TASKGO_ROOT")
    cfg_taskgo = sources_tbl.get("taskgo_root")
    taskgo_root = _opt_path(
        env_taskgo if env_taskgo is not None else cfg_taskgo,
        home / ".projects",
    )

    env_pinboard = os.environ.get("DAYBRIEF_PINBOARD_REPO")
    cfg_pinboard = sources_tbl.get("pinboard_repo")
    pinboard_repo = _opt_path(
        env_pinboard if env_pinboard is not None else cfg_pinboard,
        home / ".pinboard",
    )

    env_skills = os.environ.get("DAYBRIEF_PRIVATE_SKILLS")
    cfg_skills = sources_tbl.get("private_skills")
    private_skills = _opt_path(
        env_skills if env_skills is not None else cfg_skills,
        home / ".private" / "skills",
    )

    env_chalk = os.environ.get("DAYBRIEF_CHALK_DB")
    cfg_chalk = sources_tbl.get("chalk_db")
    chalk_db = _opt_path(env_chalk if env_chalk is not None else cfg_chalk, None)

    env_ics = os.environ.get("DAYBRIEF_CALENDAR_ICS")
    calendar_ics = _split_list(
        env_ics if env_ics is not None else sources_tbl.get("calendar_ics")
    )

    env_tripit = os.environ.get("DAYBRIEF_TRIPIT_ICS")
    tripit_ics = _split_list(
        env_tripit if env_tripit is not None else sources_tbl.get("tripit_ics")
    )

    env_owners = os.environ.get("DAYBRIEF_OWNER_EMAILS")
    owners_raw = _split_list(
        env_owners if env_owners is not None else sources_tbl.get("owner_emails")
    )
    owner_emails = frozenset(e.lower().removeprefix("mailto:") for e in owners_raw)

    lat_raw = os.environ.get("DAYBRIEF_WEATHER_LAT", weather_tbl.get("latitude"))
    lon_raw = os.environ.get("DAYBRIEF_WEATHER_LON", weather_tbl.get("longitude"))
    lat = float(lat_raw) if lat_raw not in (None, "") else None
    lon = float(lon_raw) if lon_raw not in (None, "") else None
    label = str(
        os.environ.get("DAYBRIEF_WEATHER_LABEL") or weather_tbl.get("label") or "Local"
    )

    return SourceConfig(
        timezone=str(tz_name),
        taskgo_root=taskgo_root,
        pinboard_repo=pinboard_repo,
        private_skills=private_skills,
        chalk_db=chalk_db,
        calendar_ics=calendar_ics,
        tripit_ics=tripit_ics,
        owner_emails=owner_emails,
        weather_lat=lat,
        weather_lon=lon,
        weather_label=label,
    )


# --- Caching & HTTP Fetch ----------------------------------------------------


def fetch_cached_bytes(
    url: str,
    cache_namespace: str,
    *,
    ttl_seconds: int = 1800,
    timeout: float = 15.0,
) -> tuple[bytes, dict[str, Any]]:
    """Fetch a GET URL with write-through caching and AGENT_OFFLINE support."""
    key = sha256_text(url)[:24]
    cdir = default_cache_dir() / cache_namespace
    data_path = cdir / f"{key}.dat"
    meta_path = cdir / f"{key}.json"
    now = time.time()

    if is_offline():
        if data_path.is_file():
            age = now - data_path.stat().st_mtime
            note(f"using cached {cache_namespace} data ({format_age(age)} old)")
            return data_path.read_bytes(), {"cached": True, "age_seconds": int(age)}
        raise OfflineError(
            f"offline (AGENT_OFFLINE=1) and no cached {cache_namespace} entry; "
            f"run 'AGENT_OFFLINE=0 {PROG} collect' once online to populate cache"
        )

    if data_path.is_file():
        age = now - data_path.stat().st_mtime
        if age < ttl_seconds:
            return data_path.read_bytes(), {"cached": True, "age_seconds": int(age)}

    req = urllib.request.Request(
        url,
        headers={"User-Agent": f"daybrief/1 ({cache_namespace})"},
        method="GET",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read(8 * 1024 * 1024)
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        host = urllib.parse.urlsplit(url).hostname or "remote host"
        raise Error(
            f"failed to fetch {cache_namespace} from {host}: {e} "
            "(set AGENT_OFFLINE=1 to use cached data if available)"
        ) from None

    with contextlib.suppress(OSError):
        cdir.mkdir(parents=True, exist_ok=True)
        tmp = cdir / f".tmp-{os.getpid()}-{key}"
        tmp.write_bytes(body)
        os.replace(tmp, data_path)
        meta_path.write_text(
            json.dumps({"fetched_at": utc_iso(), "bytes": len(body)}) + "\n",
            encoding="utf-8",
        )
    return body, {"cached": False, "age_seconds": 0}


# --- iCalendar (.ics) Parser & Upstream Prompt-Injection Sanitizer -----------


def _unfold_ics(text: str) -> list[str]:
    unfolded = re.sub(r"\r?\n[ \t]", "", text)
    return [line for line in re.split(r"\r?\n", unfolded) if line.strip()]


def _unescape_ics(val: str) -> str:
    out: list[str] = []
    i = 0
    n = len(val)
    while i < n:
        if val[i] == "\\" and i + 1 < n:
            nxt = val[i + 1]
            if nxt in ("n", "N"):
                out.append("\n")
            elif nxt in ("\\", ";", ","):
                out.append(nxt)
            else:
                out.append(nxt)
            i += 2
        else:
            out.append(val[i])
            i += 1
    return "".join(out)


def _parse_ics_prop(line: str) -> tuple[str, dict[str, str], str]:
    if ":" not in line:
        return line.upper(), {}, ""
    # Split on first ':' outside double quotes.
    in_quotes = False
    colon_idx = -1
    for idx, ch in enumerate(line):
        if ch == '"':
            in_quotes = not in_quotes
        elif ch == ":" and not in_quotes:
            colon_idx = idx
            break
    if colon_idx < 0:
        return line.upper(), {}, ""
    left, raw_val = line[:colon_idx], line[colon_idx + 1 :]
    parts = left.split(";")
    name = parts[0].strip().upper()
    params: dict[str, str] = {}
    for param in parts[1:]:
        if "=" in param:
            k, v = param.split("=", 1)
            params[k.strip().upper()] = v.strip().strip('"')
    return name, params, raw_val


def _parse_ics_dt(
    raw: str, params: dict[str, str], default_tz: ZoneInfo
) -> tuple[datetime.date, str | None, bool]:
    """Return (local_date, iso_start_or_date, is_all_day)."""
    val = raw.strip()
    if params.get("VALUE") == "DATE" or re.fullmatch(r"\d{8}", val):
        d = datetime.date(int(val[0:4]), int(val[4:6]), int(val[6:8]))
        return d, d.isoformat(), True

    tz = default_tz
    tzid = params.get("TZID")
    if tzid:
        with contextlib.suppress(ZoneInfoNotFoundError):
            tz = ZoneInfo(tzid)

    is_utc = val.endswith("Z")
    clean = val.rstrip("Z")
    dt = datetime.datetime.strptime(clean[:15], "%Y%m%dT%H%M%S").replace(
        tzinfo=datetime.UTC if is_utc else tz
    )
    dt = dt.astimezone(default_tz)
    return dt.date(), dt.isoformat(timespec="minutes"), False


def _clean_plain_text(raw: str, max_chars: int, *, strip_urls: bool = False) -> str:
    text = html.unescape(re.sub(r"<[^>]+>", " ", raw))
    if strip_urls:
        text = re.sub(r"https?://\S+", "", text)
        text = re.sub(r"\bwww\.\S+", "", text)
    # Collapse control chars and excessive whitespace.
    text = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", "", text)
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text).strip()
    if len(text) > max_chars:
        return text[: max_chars - 1].rstrip() + "…"
    return text


def _expand_rrule_dates(
    start_date: datetime.date,
    rrule_raw: str,
    exdates: set[datetime.date],
    window_start: datetime.date,
    window_end: datetime.date,
) -> list[datetime.date]:
    rules: dict[str, str] = {}
    for part in rrule_raw.split(";"):
        if "=" in part:
            k, v = part.split("=", 1)
            rules[k.strip().upper()] = v.strip().upper()
    freq = rules.get("FREQ", "")
    interval = max(1, int(rules.get("INTERVAL", "1") or "1"))
    count_limit = (
        int(rules["COUNT"]) if "COUNT" in rules and rules["COUNT"].isdigit() else None
    )
    until_date: datetime.date | None = None
    if "UNTIL" in rules and len(rules["UNTIL"]) >= 8:
        u = rules["UNTIL"][:8]
        if u.isdigit():
            until_date = datetime.date(int(u[0:4]), int(u[4:6]), int(u[6:8]))

    byday_nums: set[int] = set()
    if "BYDAY" in rules:
        for token in rules["BYDAY"].split(","):
            code = token[-2:]
            if code in WEEKDAY_MAP:
                byday_nums.add(WEEKDAY_MAP[code])

    results: list[datetime.date] = []
    emitted = 0
    cur = start_date
    steps = 0
    while cur <= window_end and steps < 2000:
        steps += 1
        if until_date and cur > until_date:
            break
        if freq == "WEEKLY" and byday_nums:
            week_monday = cur - datetime.timedelta(days=cur.weekday())
            for wd in sorted(byday_nums):
                cand = week_monday + datetime.timedelta(days=wd)
                if cand < start_date:
                    continue
                if until_date and cand > until_date:
                    break
                emitted += 1
                if cand not in exdates and window_start <= cand <= window_end:
                    results.append(cand)
                if count_limit and emitted >= count_limit:
                    return results
            cur = week_monday + datetime.timedelta(days=7 * interval)
            continue

        emitted += 1
        if cur not in exdates and window_start <= cur <= window_end:
            results.append(cur)
        if count_limit and emitted >= count_limit:
            break

        if freq == "DAILY":
            cur += datetime.timedelta(days=interval)
        elif freq == "WEEKLY":
            cur += datetime.timedelta(days=7 * interval)
        elif freq == "MONTHLY":
            month_idx = (cur.year * 12 + (cur.month - 1)) + interval
            y, m = divmod(month_idx, 12)
            m += 1
            day = min(start_date.day, 28)
            cur = datetime.date(y, m, day)
        elif freq == "YEARLY":
            try:
                cur = datetime.date(
                    cur.year + interval, start_date.month, start_date.day
                )
            except ValueError:
                cur = datetime.date(cur.year + interval, start_date.month, 28)
        else:
            break
    return results


def parse_and_sanitize_ics(
    ics_text: str,
    *,
    ref_date: datetime.date,
    tz: ZoneInfo,
    owner_emails: frozenset[str],
    source_label: str,
) -> tuple[list[dict[str, Any]], dict[str, int]]:
    """Parse RFC 5545 VEVENTs and enforce upstream prompt-injection sanitization."""
    lines = _unfold_ics(ics_text)
    raw_events: list[list[tuple[str, dict[str, str], str]]] = []
    current: list[tuple[str, dict[str, str], str]] | None = None
    for line in lines:
        name, params, val = _parse_ics_prop(line)
        if name == "BEGIN" and val.strip().upper() == "VEVENT":
            current = []
        elif name == "END" and val.strip().upper() == "VEVENT":
            if current is not None:
                raw_events.append(current)
            current = None
        elif current is not None:
            current.append((name, params, val))

    win_start = ref_date - datetime.timedelta(days=1)
    win_regular_end = ref_date + datetime.timedelta(days=21)
    win_allday_end = ref_date + datetime.timedelta(days=45)

    stats = {
        "parsed_vevents": len(raw_events),
        "dropped_cancelled": 0,
        "dropped_unaccepted_external": 0,
        "sanitized_external": 0,
        "included": 0,
    }
    events: list[dict[str, Any]] = []

    for props in raw_events:
        prop_map: dict[str, tuple[dict[str, str], str]] = {}
        attendees: list[tuple[dict[str, str], str]] = []
        exdates: set[datetime.date] = set()
        for name, params, val in props:
            if name == "ATTENDEE":
                attendees.append((params, val))
            elif name == "EXDATE":
                for tok in val.split(","):
                    tok = tok.strip()
                    if len(tok) >= 8 and tok[:8].isdigit():
                        exdates.add(
                            datetime.date(int(tok[0:4]), int(tok[4:6]), int(tok[6:8]))
                        )
            elif name not in prop_map:
                prop_map[name] = (params, val)

        status = prop_map.get("STATUS", ({}, ""))[1].strip().upper()
        if status == "CANCELLED":
            stats["dropped_cancelled"] += 1
            continue

        if "DTSTART" not in prop_map:
            continue
        dt_params, dt_val = prop_map["DTSTART"]
        try:
            start_date, start_repr, all_day = _parse_ics_dt(dt_val, dt_params, tz)
        except ValueError:
            continue

        end_repr: str | None = None
        if "DTEND" in prop_map:
            with contextlib.suppress(ValueError):
                _, end_repr, _ = _parse_ics_dt(
                    prop_map["DTEND"][1], prop_map["DTEND"][0], tz
                )

        org_raw = prop_map.get("ORGANIZER", ({}, ""))[1].strip().lower()
        org_email = org_raw.removeprefix("mailto:").strip()
        trusted = (not org_email) or (org_email in owner_emails)

        if not trusted:
            # Drop unaccepted or declined external invites so unsolicited calendar
            # spam can never inject text into the briefing pipeline.
            owner_partstats = [
                p.get("PARTSTAT", "").upper()
                for p, v in attendees
                if not owner_emails
                or v.strip().lower().removeprefix("mailto:") in owner_emails
            ]
            if any(ps in ("NEEDS-ACTION", "DECLINED") for ps in owner_partstats) or (
                not attendees and status == "TENTATIVE"
            ):
                stats["dropped_unaccepted_external"] += 1
                continue

        uid = _unescape_ics(prop_map.get("UID", ({}, ""))[1].strip())
        raw_summary = _unescape_ics(prop_map.get("SUMMARY", ({}, "(Untitled)"))[1])
        raw_loc = _unescape_ics(prop_map.get("LOCATION", ({}, ""))[1])
        raw_desc = _unescape_ics(prop_map.get("DESCRIPTION", ({}, ""))[1])

        if trusted:
            summary = _clean_plain_text(raw_summary, 140, strip_urls=False)
            location = _clean_plain_text(raw_loc, 120, strip_urls=False)
            description = _clean_plain_text(raw_desc, 400, strip_urls=False)
            sanitized = False
        else:
            summary = _clean_plain_text(raw_summary, 100, strip_urls=True)
            location = _clean_plain_text(raw_loc, 80, strip_urls=True)
            description = ""
            sanitized = True

        horizon = win_allday_end if all_day else win_regular_end
        occ_dates: list[datetime.date]
        if "RRULE" in prop_map:
            occ_dates = _expand_rrule_dates(
                start_date, prop_map["RRULE"][1], exdates, win_start, horizon
            )
        elif win_start <= start_date <= horizon and start_date not in exdates:
            occ_dates = [start_date]
        else:
            occ_dates = []

        for occ_date in occ_dates:
            if sanitized:
                stats["sanitized_external"] += 1
            stats["included"] += 1
            time_suffix = ""
            if not all_day and start_repr and "T" in start_repr:
                time_suffix = "T" + start_repr.split("T", 1)[1]
            occ_start = occ_date.isoformat() + time_suffix
            event_rec: dict[str, Any] = {
                "uid_hash": sha256_text(f"{source_label}:{uid}:{occ_start}")[:12],
                "date": occ_date.isoformat(),
                "start": occ_start,
                "all_day": all_day,
                "summary": summary or "(Event)",
                "trusted_organizer": trusted,
                "sanitized_external": sanitized,
                "source": source_label,
            }
            if end_repr and occ_date == start_date:
                event_rec["end"] = end_repr
            if location:
                event_rec["location"] = location
            if description:
                event_rec["description"] = description
            events.append(event_rec)

    events.sort(key=lambda e: (e["date"], "" if e["all_day"] else e["start"]))
    return events, stats


# --- Source Collectors (Read-Only) -------------------------------------------


def _parse_md_frontmatter(text: str) -> tuple[dict[str, Any], str]:
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}, text
    end = next((i for i, ln in enumerate(lines[1:], 1) if ln.strip() == "---"), 0)
    if not end:
        return {}, text
    meta: dict[str, Any] = {}
    cur_list_key: str | None = None
    for ln in lines[1:end]:
        if not ln.strip() or ln.lstrip().startswith("#"):
            continue
        if ln.startswith("  - ") and cur_list_key:
            meta.setdefault(cur_list_key, []).append(ln[4:].strip())
            continue
        cur_list_key = None
        if ":" in ln:
            k, v = ln.split(":", 1)
            key = k.strip()
            val = v.strip()
            if not val:
                cur_list_key = key
                meta[key] = []
            elif val.startswith("[") and val.endswith("]"):
                inner = val[1:-1].strip()
                meta[key] = [x.strip() for x in inner.split(",") if x.strip()]
            else:
                meta[key] = val.strip("'\"")
    body = "\n".join(lines[end + 1 :]).strip()
    return meta, body


def collect_taskgo(root: Path, ref_date: datetime.date) -> dict[str, Any]:
    if not root.is_dir():
        return {"available": False, "reason": "directory not found"}
    projects: list[dict[str, Any]] = []
    ready_tasks: list[dict[str, Any]] = []
    in_progress_tasks: list[dict[str, Any]] = []
    due_soon_tasks: list[dict[str, Any]] = []
    done_ids: set[str] = set()
    all_open_rows: list[dict[str, Any]] = []

    for child in sorted(root.iterdir()):
        if not child.is_dir() or child.name.startswith("."):
            continue
        if not ((child / "README.md").is_file() or (child / "STATUS.md").is_file()):
            continue
        proj_name = child.name
        summary = ""
        status_file = child / "STATUS.md"
        if status_file.is_file():
            st_text = status_file.read_text(encoding="utf-8", errors="replace")
            m = re.search(
                r"## Summary\s+(.+?)(?:\n<!-- taskgo:begin -->|\n## |\Z)",
                st_text,
                re.DOTALL,
            )
            if m:
                summary = re.sub(r"\s+", " ", m.group(1)).strip()[:320]

        last_commit_days: int | None = None
        if (root / ".git").exists():
            with contextlib.suppress(OSError, subprocess.TimeoutExpired, ValueError):
                proc = subprocess.run(
                    [
                        "git",
                        "-C",
                        str(root),
                        "log",
                        "-1",
                        "--format=%ct",
                        "--",
                        proj_name,
                    ],
                    capture_output=True,
                    text=True,
                    timeout=5,
                    check=False,
                )
                if proc.returncode == 0 and proc.stdout.strip().isdigit():
                    commit_dt = datetime.datetime.fromtimestamp(
                        int(proc.stdout.strip()), datetime.UTC
                    ).date()
                    last_commit_days = (ref_date - commit_dt).days

        tasks_dir = child / "tasks"
        open_count = 0
        done_count = 0
        if tasks_dir.is_dir():
            for tf in sorted(tasks_dir.glob("TASK-*.md")):
                raw = tf.read_text(encoding="utf-8", errors="replace")
                meta, body = _parse_md_frontmatter(raw)
                tid = str(meta.get("id") or tf.name.split("-", 2)[:2])
                if isinstance(tid, list):
                    tid = "-".join(tid)
                st = str(meta.get("status", "todo")).strip()
                if st in ("done", "cancelled"):
                    if st == "done":
                        done_count += 1
                    done_ids.add(tid)
                    continue
                open_count += 1
                title_m = re.search(r"^#\s+(.+)$", body, re.MULTILINE)
                title = title_m.group(1).strip() if title_m else tf.stem
                goal_m = re.search(
                    r"\*\*Goal:\*\*\s*(.+?)(?:\n\n|\n\*\*|\Z)", body, re.DOTALL
                )
                goal = (
                    re.sub(r"\s+", " ", goal_m.group(1)).strip()[:220] if goal_m else ""
                )
                rel_path = f"{proj_name}/tasks/{tf.name}"
                row = {
                    "id": tid,
                    "project": proj_name,
                    "status": st,
                    "title": title,
                    "goal": goal,
                    "due": meta.get("due"),
                    "stale_after": meta.get("stale_after"),
                    "blocked_by": meta.get("blocked_by") or [],
                    "wait_for": meta.get("wait_for") or [],
                    "path": rel_path,
                    "state_hash": sha256_text(raw)[:12],
                }
                all_open_rows.append(row)

        projects.append(
            {
                "project": proj_name,
                "summary": summary,
                "open_tasks": open_count,
                "done_tasks": done_count,
                "days_since_commit": last_commit_days,
                "dormant": bool(
                    open_count > 0
                    and last_commit_days is not None
                    and last_commit_days >= 14
                ),
            }
        )

    for row in all_open_rows:
        st = row["status"]
        blockers = [b for b in row["blocked_by"] if b not in done_ids]
        waits = row["wait_for"]
        if st == "in-progress":
            in_progress_tasks.append(row)
        elif st == "todo" and not blockers and not waits:
            ready_tasks.append(row)
        due_str = row.get("due")
        if isinstance(due_str, str) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", due_str):
            with contextlib.suppress(ValueError):
                due_d = datetime.date.fromisoformat(due_str)
                if (due_d - ref_date).days <= 10:
                    due_soon_tasks.append(
                        {**row, "days_until_due": (due_d - ref_date).days}
                    )

    recent_commits: list[str] = []
    if (root / ".git").exists():
        since = (ref_date - datetime.timedelta(days=7)).isoformat()
        with contextlib.suppress(OSError, subprocess.TimeoutExpired):
            proc = subprocess.run(
                [
                    "git",
                    "-C",
                    str(root),
                    "log",
                    f"--since={since}",
                    "-n",
                    "15",
                    "--format=%h %ad %s",
                    "--date=short",
                ],
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            )
            if proc.returncode == 0:
                recent_commits = [ln for ln in proc.stdout.splitlines() if ln.strip()]

    return {
        "available": True,
        "project_count": len(projects),
        "projects": projects,
        "in_progress": in_progress_tasks[:20],
        "ready": ready_tasks[:25],
        "due_soon": due_soon_tasks,
        "dormant_projects": [p["project"] for p in projects if p["dormant"]],
        "recent_commits": recent_commits,
    }


def extract_profile_brands(
    private_skills: Path | None,
) -> tuple[list[str], dict[str, Any]]:
    if not private_skills or not private_skills.is_dir():
        return [], {"available": False}
    info: dict[str, Any] = {"available": True, "skills": []}
    brands: list[str] = []
    seen: set[str] = set()

    profile_dir = private_skills / "personal-profile"
    if profile_dir.is_dir():
        info["skills"].append("personal-profile")
        brands_file = profile_dir / "references" / "brands-and-preferences.md"
        if brands_file.is_file():
            text = brands_file.read_text(encoding="utf-8", errors="replace")
            # Extract bolded brand entries and first Markdown table cells.
            for m in re.finditer(r"^\|\s*\*\*?([^|*]+?)\*\*?\s*\|", text, re.MULTILINE):
                cand = m.group(1).strip()
                low = cand.lower()
                if (
                    2 <= len(cand) <= 40
                    and low not in ("brand", "store", "retailer", "category", "---")
                    and not set(cand).issubset({"-", ":"})
                    and low not in seen
                ):
                    seen.add(low)
                    brands.append(cand)
            for m in re.finditer(r"^-\s+\*\*([^*:]+?)\*\*", text, re.MULTILINE):
                cand = m.group(1).strip()
                low = cand.lower()
                if 2 <= len(cand) <= 40 and low not in seen:
                    seen.add(low)
                    brands.append(cand)
        info["brand_count"] = len(brands)
        info["sample_brands"] = brands[:40]
        refs = sorted(
            str(p.relative_to(private_skills))
            for p in (profile_dir / "references").glob("*.md")
            if p.is_file()
        )
        info["profile_files"] = refs

    manual_dir = private_skills / "home-manual"
    if manual_dir.is_dir():
        info["skills"].append("home-manual")
        refs = sorted(
            str(p.relative_to(private_skills))
            for p in (manual_dir / "references").glob("*.md")
            if p.is_file()
        )
        info["home_manual_files"] = refs

    return brands, info


def collect_pinboard(
    repo: Path | None, keywords: list[str], *, limit: int = 20
) -> dict[str, Any]:
    if not repo or not repo.is_dir():
        return {"available": False}
    bm_dir = repo / "bookmarks"
    if not bm_dir.is_dir():
        return {"available": False, "reason": "bookmarks directory missing"}

    state_meta: dict[str, Any] = {}
    state_file = repo / "state.json"
    if state_file.is_file():
        with contextlib.suppress(OSError, json.JSONDecodeError):
            state_meta = json.loads(state_file.read_text(encoding="utf-8"))

    all_records: list[dict[str, Any]] = []
    for jf in sorted(bm_dir.glob("*.jsonl"), reverse=True):
        lines = jf.read_text(encoding="utf-8", errors="replace").splitlines()
        for ln in reversed(lines):
            if not ln.strip():
                continue
            with contextlib.suppress(json.JSONDecodeError):
                rec = json.loads(ln)
                if isinstance(rec, dict) and rec.get("url"):
                    all_records.append(rec)

    kw_low = [k.lower() for k in keywords if len(k) >= 3]
    recent = all_records[:10]
    toread = [r for r in all_records if r.get("toread") in (True, "yes", 1)][:10]
    matched: list[dict[str, Any]] = []
    if kw_low:
        for rec in all_records:
            hay = " ".join(
                [
                    str(rec.get("title", "")),
                    str(rec.get("notes", "")),
                    " ".join(rec.get("tags", []))
                    if isinstance(rec.get("tags"), list)
                    else str(rec.get("tags", "")),
                ]
            ).lower()
            hits = [k for k in kw_low if k in hay]
            if hits:
                matched.append({**_slim_bookmark(rec), "matched_terms": hits[:3]})
                if len(matched) >= limit:
                    break

    return {
        "available": True,
        "total_bookmarks": len(all_records),
        "last_update_time": state_meta.get("update_time"),
        "recent": [_slim_bookmark(r) for r in recent],
        "toread": [_slim_bookmark(r) for r in toread],
        "contextual_matches": matched,
    }


def _slim_bookmark(rec: dict[str, Any]) -> dict[str, Any]:
    tags = rec.get("tags", [])
    if isinstance(tags, str):
        tags = tags.split()
    return {
        "hash": rec.get("hash") or sha256_text(str(rec.get("url", "")))[:12],
        "url": str(rec.get("url", ""))[:300],
        "title": _clean_plain_text(str(rec.get("title", "")), 140),
        "notes": _clean_plain_text(str(rec.get("notes", "")), 220),
        "tags": [str(t) for t in tags[:12]],
        "time": rec.get("time"),
        "toread": bool(rec.get("toread") in (True, "yes", 1)),
    }


def search_pinboard_mirror(
    repo: Path | None,
    query: str = "",
    tag: str = "",
    unread_only: bool = False,
    limit: int = 12,
) -> list[dict[str, Any]]:
    if not repo or not (repo / "bookmarks").is_dir():
        return []
    terms = [t.lower() for t in query.split() if t.strip()]
    tag_low = tag.strip().lower()
    out: list[dict[str, Any]] = []
    for jf in sorted((repo / "bookmarks").glob("*.jsonl"), reverse=True):
        lines = jf.read_text(encoding="utf-8", errors="replace").splitlines()
        for ln in reversed(lines):
            if not ln.strip():
                continue
            try:
                rec = json.loads(ln)
            except json.JSONDecodeError:
                continue
            if unread_only and rec.get("toread") not in (True, "yes", 1):
                continue
            raw_tags = rec.get("tags", [])
            tag_list = raw_tags if isinstance(raw_tags, list) else str(raw_tags).split()
            tags_low = [str(t).lower() for t in tag_list]
            if tag_low and tag_low not in tags_low:
                continue
            hay = " ".join(
                [
                    str(rec.get("title", "")),
                    str(rec.get("notes", "")),
                    str(rec.get("url", "")),
                    " ".join(tags_low),
                ]
            ).lower()
            if all(term in hay for term in terms):
                out.append(_slim_bookmark(rec))
                if len(out) >= limit:
                    return out
    return out


def open_readonly_sqlite(db_path: Path) -> sqlite3.Connection:
    resolved = db_path.expanduser().resolve()
    if not resolved.is_file():
        raise Error(f"SQLite database not found: {db_path}")
    uri = "file:" + urllib.parse.quote(str(resolved)) + "?mode=ro&immutable=1"
    conn = sqlite3.connect(uri, uri=True, timeout=5.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA query_only = ON")
    return conn


def query_chalk_db(
    db_path: Path | None,
    preferred_brands: list[str],
    *,
    brand_filter: str = "",
    min_discount_pct: float = 15.0,
    limit: int = 20,
) -> dict[str, Any]:
    if not db_path or not db_path.is_file():
        return {"available": False}
    conn = open_readonly_sqlite(db_path)
    try:
        tables = {
            r["name"]
            for r in conn.execute(
                "SELECT name FROM sqlite_master WHERE type='table'"
            ).fetchall()
        }
        rows: list[dict[str, Any]] = []
        if {"recent_price_drops", "variants", "products"}.issubset(tables):
            sql = """
                SELECT
                    p.id AS product_id,
                    p.store AS store,
                    COALESCE(p.vendor, p.store) AS vendor,
                    p.title AS product_title,
                    p.product_type AS product_type,
                    p.url AS product_url,
                    v.title AS variant_title,
                    v.size AS size,
                    r.drop_date AS drop_date,
                    r.prev_price_cents AS prev_cents,
                    r.cur_price_cents AS cur_cents,
                    ROUND((1.0 - (CAST(r.cur_price_cents AS REAL) / NULLIF(r.prev_price_cents, 0))) * 100.0, 1) AS discount_pct
                FROM recent_price_drops r
                JOIN variants v ON v.id = r.variant_id
                JOIN products p ON p.id = v.product_id
                WHERE p.available = 1 AND v.available = 1
                  AND r.prev_price_cents > r.cur_price_cents
                ORDER BY r.drop_date DESC, discount_pct DESC
                LIMIT 200
            """
            raw_rows = conn.execute(sql).fetchall()
            pref_low = {b.lower() for b in preferred_brands}
            filt_low = brand_filter.strip().lower()
            for r in raw_rows:
                pct = float(r["discount_pct"] or 0.0)
                if pct < min_discount_pct:
                    continue
                vendor = str(r["vendor"] or "")
                store = str(r["store"] or "")
                title = str(r["product_title"] or "")
                hay = f"{vendor} {store} {title}".lower()
                if filt_low and filt_low not in hay:
                    continue
                brand_match = any(
                    b in vendor.lower() or b in store.lower() for b in pref_low
                )
                rows.append(
                    {
                        "product_id": r["product_id"],
                        "store": store,
                        "vendor": vendor,
                        "title": title,
                        "variant": r["size"] or r["variant_title"],
                        "drop_date": r["drop_date"],
                        "prev_price": round(int(r["prev_cents"]) / 100.0, 2),
                        "cur_price": round(int(r["cur_cents"]) / 100.0, 2),
                        "discount_pct": pct,
                        "preferred_brand_match": brand_match,
                        "url": r["product_url"],
                    }
                )
                if len(rows) >= limit:
                    break
        return {
            "available": True,
            "drops": rows,
            "preferred_matches": [r for r in rows if r["preferred_brand_match"]],
        }
    finally:
        conn.close()


def collect_weather(cfg: SourceConfig) -> dict[str, Any]:
    if cfg.weather_lat is None or cfg.weather_lon is None:
        return {"available": False}
    params = urllib.parse.urlencode(
        {
            "latitude": f"{cfg.weather_lat:.4f}",
            "longitude": f"{cfg.weather_lon:.4f}",
            "daily": "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum",
            "timezone": cfg.timezone,
            "forecast_days": "7",
        }
    )
    base = os.environ.get("DAYBRIEF_WEATHER_URL", OPEN_METEO_URL).rstrip("?")
    url = f"{base}?{params}"
    body, cache_meta = fetch_cached_bytes(url, "weather", ttl_seconds=3600)
    data = json.loads(body.decode("utf-8"))
    daily = data.get("daily") or {}
    dates = daily.get("time") or []
    codes = daily.get("weather_code") or []
    tmax = daily.get("temperature_2m_max") or []
    tmin = daily.get("temperature_2m_min") or []
    pprob = daily.get("precipitation_probability_max") or []
    psum = daily.get("precipitation_sum") or []
    days: list[dict[str, Any]] = []
    for i, d in enumerate(dates):
        code = int(codes[i]) if i < len(codes) and codes[i] is not None else -1
        days.append(
            {
                "date": d,
                "summary": WMO_WEATHER.get(code, f"Code {code}"),
                "temp_max_c": tmax[i] if i < len(tmax) else None,
                "temp_min_c": tmin[i] if i < len(tmin) else None,
                "precip_prob_pct": pprob[i] if i < len(pprob) else None,
                "precip_mm": psum[i] if i < len(psum) else None,
            }
        )
    return {
        "available": True,
        "label": cfg.weather_label,
        "cached": cache_meta["cached"],
        "days": days,
    }


def collect_calendars(
    cfg: SourceConfig, ref_date: datetime.date, tz: ZoneInfo
) -> dict[str, Any]:
    if not cfg.calendar_ics:
        return {"available": False, "reason": "no calendar_ics configured"}
    all_events: list[dict[str, Any]] = []
    agg_stats = {
        "sources": len(cfg.calendar_ics),
        "parsed_vevents": 0,
        "dropped_cancelled": 0,
        "dropped_unaccepted_external": 0,
        "sanitized_external": 0,
        "included": 0,
    }
    for idx, entry in enumerate(cfg.calendar_ics, 1):
        label = f"cal-{idx}"
        if entry.startswith(("http://", "https://")):
            raw_bytes, _ = fetch_cached_bytes(entry, "calendar", ttl_seconds=900)
            ics_text = raw_bytes.decode("utf-8", errors="replace")
        else:
            p = Path(entry).expanduser()
            if not p.is_file():
                raise Error(f"calendar .ics file not found: {entry}")
            ics_text = p.read_text(encoding="utf-8", errors="replace")
        evs, st = parse_and_sanitize_ics(
            ics_text,
            ref_date=ref_date,
            tz=tz,
            owner_emails=cfg.owner_emails,
            source_label=label,
        )
        all_events.extend(evs)
        for k in (
            "parsed_vevents",
            "dropped_cancelled",
            "dropped_unaccepted_external",
            "sanitized_external",
            "included",
        ):
            agg_stats[k] += st[k]

    all_events.sort(key=lambda e: (e["date"], "" if e["all_day"] else e["start"]))
    return {
        "available": True,
        "stats": agg_stats,
        "events": all_events[:60],
    }


TRIPIT_DROP_LINE_RE = re.compile(
    r"^\s*(?:"
    r"confirmation|booking(?:\s*(?:reference|ref|code|id|number|#))?|"
    r"record\s*locator|pnr|reservation(?:\s*(?:id|number|code|#))?|"
    r"e?-?ticket(?:\s*(?:number|no\.?|#))?|"
    r"frequent\s*flyer|loyalty|membership|known\s*travel+er|ktn|redress|"
    r"pin|access\s*code|passcode|view\s*(?:/|or)?\s*edit|manage\s*trip"
    r")(?:\b|\s*[#:=])",
    re.IGNORECASE,
)

TRIPIT_INLINE_CODE_RE = re.compile(
    r"(?:(?i:\b(?:"
    r"confirmation|booking\s*(?:reference|ref|code|id|number)|booking|"
    r"record\s*locator|pnr|reservation|e?-?ticket|frequent\s*flyer|"
    r"loyalty|membership|known\s*travel+er|ktn|redress|pin|access\s*code|passcode"
    r")\b"
    r"(?:\s*(?:number|no\.?|code|id)\b)?"
    r"(?:\s*#)?"
    r"(?:\s*[:=-]\s*|\s+))"
    r"(?:(?=[A-Za-z0-9-]*\d)[A-Za-z0-9-]{4,24}|[A-Z0-9-]{4,24})\b)"
    r"|(?:\b\d{3}[-\s]?\d{10}\b)"
)


def sanitize_tripit_text(raw: str, max_chars: int) -> tuple[str, bool]:
    """Strip PNRs, ticket numbers, loyalty IDs, PINs, and URLs from TripIt text."""
    untagged = html.unescape(re.sub(r"<[^>]+>", " ", raw))
    no_urls = re.sub(r"https?://\S+|\bwww\.\S+", "", untagged)
    scrubbed = False
    if no_urls != untagged:
        scrubbed = True
    kept_lines: list[str] = []
    for line in no_urls.splitlines():
        if TRIPIT_DROP_LINE_RE.search(line):
            scrubbed = True
            continue
        cleaned_line, n_subs = TRIPIT_INLINE_CODE_RE.subn("", line)
        if n_subs:
            scrubbed = True
        cleaned_line = re.sub(r"\(\s*\)", "", cleaned_line)
        cleaned_line = re.sub(r"[ \t]+", " ", cleaned_line).strip(" ,;-")
        if cleaned_line:
            kept_lines.append(cleaned_line)
    joined = "\n".join(kept_lines)
    joined = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", "", joined).strip()
    if len(joined) > max_chars:
        joined = joined[: max_chars - 1].rstrip() + "…"
    return joined, scrubbed


def parse_and_sanitize_tripit_ics(
    ics_text: str,
    *,
    ref_date: datetime.date,
    tz: ZoneInfo,
    source_label: str,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], dict[str, int]]:
    """Parse TripIt .ics into upcoming (+365d) and compact past (-18m) trips."""
    lines = _unfold_ics(ics_text)
    raw_events: list[list[tuple[str, dict[str, str], str]]] = []
    current: list[tuple[str, dict[str, str], str]] | None = None
    for line in lines:
        name, params, val = _parse_ics_prop(line)
        if name == "BEGIN" and val.strip().upper() == "VEVENT":
            current = []
        elif name == "END" and val.strip().upper() == "VEVENT":
            if current is not None:
                raw_events.append(current)
            current = None
        elif current is not None:
            current.append((name, params, val))

    past_floor = ref_date - datetime.timedelta(days=548)
    future_ceil = ref_date + datetime.timedelta(days=365)
    stats = {
        "parsed_vevents": len(raw_events),
        "dropped_cancelled": 0,
        "scrubbed_sensitive_fields": 0,
        "upcoming": 0,
        "past": 0,
    }
    upcoming: list[dict[str, Any]] = []
    past: list[dict[str, Any]] = []

    for props in raw_events:
        prop_map: dict[str, tuple[dict[str, str], str]] = {}
        for name, params, val in props:
            if name not in prop_map:
                prop_map[name] = (params, val)
        if prop_map.get("STATUS", ({}, ""))[1].strip().upper() == "CANCELLED":
            stats["dropped_cancelled"] += 1
            continue
        if "DTSTART" not in prop_map:
            continue
        try:
            start_date, start_repr, all_day = _parse_ics_dt(
                prop_map["DTSTART"][1], prop_map["DTSTART"][0], tz
            )
        except ValueError:
            continue
        if start_date < past_floor or start_date > future_ceil:
            continue

        end_repr: str | None = None
        end_date = start_date
        if "DTEND" in prop_map:
            with contextlib.suppress(ValueError):
                end_date, end_repr, _ = _parse_ics_dt(
                    prop_map["DTEND"][1], prop_map["DTEND"][0], tz
                )

        uid = _unescape_ics(prop_map.get("UID", ({}, ""))[1].strip())
        raw_sum = _unescape_ics(prop_map.get("SUMMARY", ({}, "(Trip item)"))[1])
        raw_loc = _unescape_ics(prop_map.get("LOCATION", ({}, ""))[1])
        raw_desc = _unescape_ics(prop_map.get("DESCRIPTION", ({}, ""))[1])

        summary, s_sum = sanitize_tripit_text(raw_sum, 140)
        location, s_loc = sanitize_tripit_text(raw_loc, 120)
        description, s_desc = sanitize_tripit_text(raw_desc, 360)
        if s_sum or s_loc or s_desc:
            stats["scrubbed_sensitive_fields"] += 1

        uid_hash = sha256_text(f"{source_label}:{uid}:{start_repr}")[:12]
        is_upcoming = end_date >= ref_date or start_date >= ref_date
        if is_upcoming:
            stats["upcoming"] += 1
            rec: dict[str, Any] = {
                "uid_hash": uid_hash,
                "date": start_date.isoformat(),
                "start": start_repr or start_date.isoformat(),
                "all_day": all_day,
                "summary": summary or "(Trip item)",
                "source": source_label,
            }
            if end_repr:
                rec["end"] = end_repr
            if location:
                rec["location"] = location
            if description:
                rec["description"] = description
            upcoming.append(rec)
        else:
            stats["past"] += 1
            past_rec: dict[str, Any] = {
                "uid_hash": uid_hash,
                "date": start_date.isoformat(),
                "summary": summary or "(Past trip)",
            }
            if location:
                past_rec["location"] = location
            past.append(past_rec)

    upcoming.sort(key=lambda e: (e["date"], "" if e["all_day"] else e["start"]))
    past.sort(key=lambda e: e["date"], reverse=True)
    return upcoming[:40], past[:30], stats


def collect_tripit(
    cfg: SourceConfig, ref_date: datetime.date, tz: ZoneInfo
) -> dict[str, Any]:
    if not cfg.tripit_ics:
        return {"available": False, "reason": "no tripit_ics configured"}
    upcoming_all: list[dict[str, Any]] = []
    past_all: list[dict[str, Any]] = []
    agg = {
        "sources": len(cfg.tripit_ics),
        "parsed_vevents": 0,
        "dropped_cancelled": 0,
        "scrubbed_sensitive_fields": 0,
        "upcoming": 0,
        "past": 0,
    }
    for idx, entry in enumerate(cfg.tripit_ics, 1):
        label = f"tripit-{idx}"
        if entry.startswith(("http://", "https://")):
            raw_bytes, _ = fetch_cached_bytes(entry, "tripit", ttl_seconds=1800)
            ics_text = raw_bytes.decode("utf-8", errors="replace")
        else:
            p = Path(entry).expanduser()
            if not p.is_file():
                raise Error(f"TripIt .ics file not found: {entry}")
            ics_text = p.read_text(encoding="utf-8", errors="replace")
        up, pa, st = parse_and_sanitize_tripit_ics(
            ics_text, ref_date=ref_date, tz=tz, source_label=label
        )
        upcoming_all.extend(up)
        past_all.extend(pa)
        for k in (
            "parsed_vevents",
            "dropped_cancelled",
            "scrubbed_sensitive_fields",
            "upcoming",
            "past",
        ):
            agg[k] += st[k]

    upcoming_all.sort(key=lambda e: (e["date"], "" if e["all_day"] else e["start"]))
    past_all.sort(key=lambda e: e["date"], reverse=True)
    return {
        "available": True,
        "stats": agg,
        "upcoming_trips": upcoming_all[:40],
        "past_trips": past_all[:30],
    }


def _check_safe_subpath(resolved_root: Path, rel_path: str) -> Path:
    clean_rel = rel_path.strip().lstrip("/")
    if ".." in Path(clean_rel).parts:
        raise BoundaryError(f"refused relative path: {rel_path}")
    probe = resolved_root
    for part in Path(clean_rel).parts:
        if not part or part == ".":
            continue
        lower = part.lower()
        if any(
            lower == pat or lower.startswith(pat + ".") for pat in CREDENTIAL_PATTERNS
        ):
            raise BoundaryError(f"refused protected path component: {part}")
        if lower.endswith(CREDENTIAL_SUFFIXES):
            raise BoundaryError(f"refused credential file suffix: {part}")
        probe = probe / part
        if probe.is_symlink():
            raise BoundaryError(f"refused symlink inside source root: {rel_path}")
    resolved = probe.resolve()
    if not resolved.is_relative_to(resolved_root):
        raise BoundaryError(f"path escapes source root: {rel_path}")
    return resolved


def safe_list_source_files(
    source_roots: dict[str, Path],
    source: str,
    subdir: str = "",
    *,
    limit: int = 120,
) -> list[str]:
    root = source_roots.get(source)
    if root is None or not root.is_dir():
        raise BoundaryError(f"unknown or unavailable source: {source}")
    resolved_root = root.resolve()
    start_dir = _check_safe_subpath(resolved_root, subdir)
    if not start_dir.is_dir():
        raise NotFoundError(f"directory not found: {source}:{subdir}")

    out: list[str] = []
    stack = [start_dir]
    while stack and len(out) < limit:
        cur = stack.pop()
        try:
            entries = sorted(cur.iterdir(), reverse=True)
        except OSError:
            continue
        for entry in entries:
            name_low = entry.name.lower()
            if name_low.startswith(".") or entry.is_symlink():
                continue
            if any(
                name_low == pat or name_low.startswith(pat + ".")
                for pat in CREDENTIAL_PATTERNS
            ):
                continue
            if name_low.endswith(CREDENTIAL_SUFFIXES):
                continue
            if entry.is_dir():
                stack.append(entry)
            elif entry.is_file():
                out.append(str(entry.relative_to(resolved_root)))
                if len(out) >= limit:
                    break
    out.sort()
    return out


def safe_search_source_text(
    source_roots: dict[str, Path],
    source: str,
    query: str,
    subdir: str = "",
    *,
    limit: int = 20,
) -> list[dict[str, Any]]:
    cleaned_q = query.strip()
    if not cleaned_q:
        raise Error("search query must not be empty")
    terms = [t.lower() for t in cleaned_q.split() if t.strip()]
    files = safe_list_source_files(source_roots, source, subdir, limit=400)
    resolved_root = source_roots[source].resolve()
    matches: list[dict[str, Any]] = []
    for rel in files:
        target = resolved_root / rel
        try:
            if target.stat().st_size > 256 * 1024:
                continue
            fd = os.open(target, os.O_RDONLY)
            try:
                raw = os.read(fd, 256 * 1024)
            finally:
                os.close(fd)
        except OSError:
            continue
        if b"\x00" in raw:
            continue
        text = raw.decode("utf-8", errors="replace")
        for lineno, line in enumerate(text.splitlines(), 1):
            low = line.lower()
            if all(t in low for t in terms):
                matches.append(
                    {
                        "path": rel,
                        "line": lineno,
                        "snippet": line.strip()[:180],
                    }
                )
                if len(matches) >= limit:
                    return matches
    return matches


def safe_read_source_file(
    source_roots: dict[str, Path], source: str, rel_path: str
) -> str:
    root = source_roots.get(source)
    if root is None or not root.is_dir():
        raise BoundaryError(f"unknown or unavailable source: {source}")
    resolved_root = root.resolve()
    clean_rel = rel_path.strip().lstrip("/")
    if not clean_rel or ".." in Path(clean_rel).parts:
        raise BoundaryError(f"refused relative path: {rel_path}")

    candidate = resolved_root / clean_rel
    # Refuse symlinks anywhere along the relative segments.
    probe = resolved_root
    for part in Path(clean_rel).parts:
        lower = part.lower()
        if any(
            lower == pat or lower.startswith(pat + ".") for pat in CREDENTIAL_PATTERNS
        ):
            raise BoundaryError(f"refused protected path component: {part}")
        if lower.endswith(CREDENTIAL_SUFFIXES):
            raise BoundaryError(f"refused credential file suffix: {part}")
        probe = probe / part
        if probe.is_symlink():
            raise BoundaryError(f"refused symlink inside source root: {rel_path}")

    resolved = candidate.resolve()
    if not resolved.is_relative_to(resolved_root):
        raise BoundaryError(f"path escapes source root: {rel_path}")
    if not resolved.is_file():
        raise NotFoundError(f"file not found: {source}:{clean_rel}")

    fd = os.open(resolved, os.O_RDONLY)
    try:
        raw = os.read(fd, MAX_SOURCE_READ_BYTES + 1)
    finally:
        os.close(fd)
    if b"\x00" in raw:
        raise BoundaryError(f"refused binary file: {source}:{clean_rel}")
    text = raw[:MAX_SOURCE_READ_BYTES].decode("utf-8", errors="replace")
    if len(raw) > MAX_SOURCE_READ_BYTES:
        text += "\n… [truncated]"
    return text


