ACTIVE = 0
ACTIVE_LOCK = threading.Lock()


def sdk_server(store: Any, log: RequestLog) -> Any:
    import anyio
    import mcp_types as types
    from mcp.server.lowlevel import Server
    from mcp.shared.exceptions import MCPError

    def ok_result(payload: dict[str, Any]) -> Any:
        encoded = json.dumps(payload, ensure_ascii=False)
        event = EVENT.get()
        if event:
            event.size = len(encoded.encode("utf-8"))
        return types.CallToolResult(
            content=[types.TextContent(type="text", text=encoded)],
            structured_content=payload,
        )

    def fail_result(message: str, reason: str = "invalid request") -> Any:
        event = EVENT.get()
        if event:
            event.fail("tool-error", reason)
        return types.CallToolResult(
            content=[types.TextContent(type="text", text=f"error: {message}")],
            is_error=True,
        )

    async def list_tools(ctx: Any, params: Any) -> Any:
        return types.ListToolsResult(
            tools=[types.Tool.model_validate(t) for t in tool_listing()]
        )

    async def list_prompts(ctx: Any, params: Any) -> Any:
        return types.ListPromptsResult(
            prompts=[
                types.Prompt(
                    name="morning-brief",
                    title="Present today's Daybrief",
                    description=(
                        "Fetch today's Daybrief and present `deliver_verbatim_to_user` "
                        "while holding the Producer's Packet in working memory."
                    ),
                    arguments=[
                        types.PromptArgument(
                            name="date",
                            description="Optional YYYY-MM-DD override",
                            required=False,
                        )
                    ],
                )
            ]
        )

    async def get_prompt(ctx: Any, params: Any) -> Any:
        if params.name != "morning-brief":
            raise MCPError(
                code=types.INVALID_PARAMS, message=f"unknown prompt: {params.name}"
            )
        date_arg = (params.arguments or {}).get("date")
        call_hint = (
            f"Call `get_today_brief` with date='{date_arg}'."
            if date_arg
            else "Call `get_today_brief`."
        )
        prompt_text = (
            f"{call_hint} Output `deliver_verbatim_to_user` directly with no "
            "preamble, cheerleading, or extra bullets. Keep "
            "`backstage_context_for_followups_only` silent in working memory "
            "until the user asks a follow-up question."
        )
        return types.GetPromptResult(
            description="Present today's morning briefing",
            messages=[
                types.PromptMessage(
                    role="user",
                    content=types.TextContent(type="text", text=prompt_text),
                )
            ],
        )

    async def call_tool(ctx: Any, params: Any) -> Any:
        if params.name not in TOOLS:
            raise MCPError(
                code=types.INVALID_PARAMS, message=f"unknown tool: {params.name}"
            )
        global ACTIVE
        with ACTIVE_LOCK:
            ACTIVE += 1
        try:
            return await _call_tool(params)
        finally:
            with ACTIVE_LOCK:
                ACTIVE -= 1

    async def _call_tool(params: Any) -> Any:
        args = params.arguments or {}
        event = EVENT.get()
        if event:
            event.tool = params.name
            event.args = log_args(args)
        try:
            if params.name == "get_today_brief":
                include_bg = bool(args.get("include_backstage", True))
                payload = await anyio.to_thread.run_sync(
                    lambda: store.get_brief(
                        args.get("date"), include_backstage=include_bg
                    )
                )
                return ok_result(payload)
            if params.name == "get_brief":
                payload = await anyio.to_thread.run_sync(
                    lambda: store.get_brief(
                        str(args["id_or_date"]),
                        item_id=args.get("item_id"),
                        include_backstage=True,
                    )
                )
                return ok_result(payload)
            if params.name == "list_briefs":
                limit = int(args.get("limit", 10))
                rows = await anyio.to_thread.run_sync(
                    lambda: store.list_briefs(limit=limit)
                )
                return ok_result({"briefs": rows})
            rec = await anyio.to_thread.run_sync(
                lambda: store.record_feedback(
                    str(args["text"]),
                    brief_id=args.get("brief_id"),
                    item_id=args.get("item_id"),
                    kind=str(args.get("kind") or "note"),
                    snooze_days=int(args.get("snooze_days", 14)),
                )
            )
            return ok_result(rec)
        except KeyError as e:
            return fail_result(f"missing argument: {e.args[0]}")
        except cli.NotFoundError as e:
            return fail_result(str(e), reason="not found")
        except (cli.Error, ValueError) as e:
            return fail_result(str(e), reason="invalid request")

    sdk = Server(
        "daybrief",
        version=VERSION,
        title="Daybrief",
        instructions=SERVER_INSTRUCTIONS,
        on_list_tools=list_tools,
        on_call_tool=call_tool,
        on_list_prompts=list_prompts,
        on_get_prompt=get_prompt,
    )
    sdk.middleware.append(request_logging(log))
    return sdk


def build_app(
    store: Any,
    verifier: AccessVerifier | None,
    log: RequestLog,
    allow_hosts: list[str],
) -> Any:
    from mcp.server.transport_security import TransportSecuritySettings
    from starlette.applications import Starlette
    from starlette.responses import JSONResponse, Response
    from starlette.routing import Route

    sdk = sdk_server(store, log)
    hosts = ["127.0.0.1:*", "localhost:*", "[::1]:*"]
    hosts += [h if ":" in h else f"{h}:*" for h in allow_hosts] + allow_hosts
    hosts = [h.lower() for h in hosts]
    security = TransportSecuritySettings(
        enable_dns_rebinding_protection=True,
        allowed_hosts=hosts,
        allowed_origins=["http://127.0.0.1:*", "http://localhost:*", "http://[::1]:*"],
    )
    mcp_app = sdk.streamable_http_app(
        streamable_http_path=MCP_PATH,
        stateless_http=True,
        json_response=True,
        max_request_body_size=MAX_REQUEST_BYTES,
        transport_security=security,
    )

    async def health(request: Any) -> Response:
        return JSONResponse(
            {"status": "ok", "version": VERSION, "commit": source_commit()}
        )

    @contextlib.asynccontextmanager
    async def lifespan(app: Any) -> Any:
        async with sdk.session_manager.run():
            yield

    routes = [Route("/up", health, methods=["GET", "HEAD"]), *mcp_app.routes]
    app = Starlette(routes=routes, lifespan=lifespan)
    return Gate(app, verifier, log, hosts)


def serve_http(
    store: Any,
    host: str,
    port: int,
    verifier: AccessVerifier | None,
    log: RequestLog,
    allow_hosts: list[str],
) -> None:
    import uvicorn

    auth = f"Access {verifier.team}" if verifier else "no authentication"
    log_line(
        f"serving {MCP_PATH} on http://{host}:{port} ({auth}); request log {log.path}"
    )
    uvicorn.run(
        build_app(store, verifier, log, allow_hosts),
        host=host,
        port=port,
        log_level="warning",
        access_log=False,
        server_header=False,
    )


def serve_stdio(store: Any, log: RequestLog) -> None:
    import anyio
    from mcp.server.stdio import stdio_server

    def wait_idle() -> None:
        deadline = time.monotonic() + 30.0
        while time.monotonic() < deadline:
            with ACTIVE_LOCK:
                if not ACTIVE:
                    os._exit(0)
            time.sleep(0.1)
        os._exit(0)

    def stop(signum: int, frame: Any) -> None:
        threading.Thread(target=wait_idle, daemon=True).start()

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, stop)

    async def serve() -> None:
        sdk = sdk_server(store, log)
        async with stdio_server() as (read, write):
            await sdk.run(read, write, sdk.create_initialization_options())

    anyio.run(serve)


# --- Command line ------------------------------------------------------------

EPILOG = """\
Tools:
  get_today_brief   latest (or dated) briefing with silent Producer's Packet
  get_brief         inspect a briefing or single item dossier by ID or date
  list_briefs       metadata list of recent briefings, newest first
  record_feedback   record explicit user note, answer, preference, or snooze

Environment:
  DAYBRIEF_DIR                  State directory (default: ~/.local/state/daybrief)
  DAYBRIEF_MCP_LOG              Request log (default: $XDG_STATE_HOME/daybrief/mcp.jsonl)
  DAYBRIEF_MCP_ACCESS_TEAM      Cloudflare Access team domain
  DAYBRIEF_MCP_ACCESS_AUD       Cloudflare Access application audience tag
  DAYBRIEF_MCP_ACCESS_CERTS_URL Team certificate URL, for testing

Examples:
  claude mcp add daybrief -- daybrief mcp
  daybrief mcp --http
  daybrief mcp --http --host 0.0.0.0 --allow-host daybrief.example.com \\
    --access-team example.cloudflareaccess.com --access-aud AUD
  mcp logs --server daybrief --since 1d

GET /up is open for a proxy health check and is not logged. With both Access
flags, every other HTTP request must carry a valid Cf-Access-Jwt-Assertion
token; without them --http binds loopback only."""


class Parser(argparse.ArgumentParser):
    def error(self, message: str) -> NoReturn:
        self.print_usage(sys.stderr)
        print(
            f"{self.prog}: {message}\nTry '{self.prog} --help' for more information.",
            file=sys.stderr,
        )
        sys.exit(1)

    def format_help(self) -> str:
        return (
            super()
            .format_help()
            .replace("usage:", "Usage:", 1)
            .replace("options:", "Options:", 1)
            .replace(
                "show this help message and exit",
                "Display this help message and exit",
                1,
            )
        )


def build_parser() -> argparse.ArgumentParser:
    parser = Parser(
        prog=PROG,
        description=(
            "Serve stored Daybrief morning briefings and Producer's Packets "
            "over MCP, and record explicit owner feedback."
        ),
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--dir",
        metavar="DIR",
        help=f"State directory (default: ${DIR_ENV}, else ~/.local/state/daybrief)",
    )
    parser.add_argument(
        "--http", action="store_true", help=f"Serve HTTP at {MCP_PATH}, not stdio"
    )
    parser.add_argument("--host", default="127.0.0.1", help="HTTP address")
    parser.add_argument(
        "--port",
        type=int,
        default=DEFAULT_PORT,
        help=f"HTTP port (default: {DEFAULT_PORT})",
    )
    parser.add_argument(
        "--allow-host",
        action="append",
        default=[],
        metavar="HOST",
        help="Also accept requests addressed to HOST, such as a tunnel's hostname",
    )
    parser.add_argument(
        "--access-team",
        metavar="HOST",
        help="Cloudflare Access team domain (default: DAYBRIEF_MCP_ACCESS_TEAM)",
    )
    parser.add_argument(
        "--access-aud",
        metavar="AUD",
        help="Cloudflare Access application audience tag "
        "(default: DAYBRIEF_MCP_ACCESS_AUD)",
    )
    parser.add_argument(
        "--log", metavar="FILE", help=f"Request log (default: ${LOG_ENV})"
    )
    return parser


def main() -> int:
    args = build_parser().parse_args()
    log_path = Path(args.log or os.environ.get(LOG_ENV) or default_log()).expanduser()
    log = RequestLog(log_path)
    team = args.access_team or os.environ.get("DAYBRIEF_MCP_ACCESS_TEAM")
    audience = args.access_aud or os.environ.get("DAYBRIEF_MCP_ACCESS_AUD")
    if bool(team) != bool(audience):
        die(
            "Access needs both --access-team and --access-aud "
            "(or DAYBRIEF_MCP_ACCESS_TEAM and DAYBRIEF_MCP_ACCESS_AUD)"
        )
    verifier = None
    if args.http:
        if team and audience:
            verifier = AccessVerifier(
                team,
                audience,
                os.environ.get("DAYBRIEF_MCP_ACCESS_CERTS_URL") or None,
            )
        elif args.host not in LOOPBACK:
            die(f"--http without Access serves loopback only, not {args.host}")
    elif args.access_team or args.access_aud:
        die("--access-team and --access-aud apply only to --http")

    path = args.dir or os.environ.get(DIR_ENV) or cli.default_dir()
    store = cli.Store(path)
    store.ensure()
    if args.http:
        serve_http(store, args.host, args.port, verifier, log, args.allow_host)
    else:
        serve_stdio(store, log)
    return 0


def sigterm_handler(signum: int, frame: Any) -> NoReturn:
    raise KeyboardInterrupt


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, sigterm_handler)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        sys.exit(0)
