def free_port() -> int:
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return int(sock.getsockname()[1])


def log_format_spec() -> tuple[set[str], set[str]]:
    """Parse allowed fields and outcomes from skills/agent-config/references/mcp-logs.md."""
    tables: dict[str, set[str]] = {"Field": set(), "Outcome": set()}
    current: set[str] | None = None
    for line in LOG_FORMAT.read_text(encoding="utf-8").splitlines():
        if m := re.match(r"\| (Field|Outcome) ", line):
            current = tables[m[1]]
        elif current is not None and (m := re.match(r"\| `([\w-]+)` ", line)):
            current.add(m[1])
        elif not line.startswith("|"):
            current = None
    return tables["Field"], tables["Outcome"]


def assert_mcp_log_records(
    log_path: Path,
    *,
    forbidden_substrings: tuple[str, ...] = (),
) -> list[dict[str, Any]]:
    assert log_path.is_file(), f"missing MCP log: {log_path}"
    raw = log_path.read_text(encoding="utf-8")
    for secret in forbidden_substrings:
        assert secret not in raw, f"secret leaked into mcp.jsonl: {secret!r}"
    fields, outcomes = log_format_spec()
    assert "ts" in fields
    assert "refused" in outcomes
    records = [json.loads(ln) for ln in raw.splitlines() if ln.strip()]
    assert records, "expected at least one MCP log record"
    for rec in records:
        extra_keys = set(rec) - fields
        assert not extra_keys, f"undocumented mcp.jsonl keys {extra_keys} in {rec}"
        assert {"ts", "transport", "outcome", "ms"} <= set(rec), rec
        assert rec["outcome"] in outcomes, rec
        assert re.fullmatch(r"\d{4}-\d\d-\d\dT[\d:.]+Z", rec["ts"]), rec
    return records


def mint_access_material() -> dict[str, Any]:
    """Generate test RSA-2048 JWKS and RS256 Access tokens via DAYBRIEF_MCP_PY."""
    helper = """
import base64, json, time
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric import padding, rsa

def b64(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()

def jwk(key, kid: str) -> dict:
    pub = key.public_key().public_numbers()
    return {
        "kid": kid,
        "kty": "RSA",
        "alg": "RS256",
        "use": "sig",
        "n": b64(pub.n.to_bytes((pub.n.bit_length() + 7) // 8, "big")),
        "e": b64(pub.e.to_bytes(3, "big")),
    }

def sign(key, kid: str, claims: dict) -> str:
    head = b64(json.dumps({"alg": "RS256", "kid": kid, "typ": "JWT"}).encode())
    body = b64(json.dumps(claims).encode())
    sig = key.sign(f"{head}.{body}".encode(), padding.PKCS1v15(), hashes.SHA256())
    return f"{head}.{body}.{b64(sig)}"

k1 = rsa.generate_private_key(public_exponent=65537, key_size=2048)
k_other = rsa.generate_private_key(public_exponent=65537, key_size=2048)
now = int(time.time())
team, aud = __import__("sys").argv[1], __import__("sys").argv[2]
base = {
    "iss": f"https://{team}",
    "aud": [aud],
    "sub": "user-synthetic-01",
    "email": "alice@example.test",
    "iat": now - 10,
    "nbf": now - 10,
    "exp": now + 600,
}
out = {
    "jwks": {"keys": [jwk(k1, "k1")]},
    "valid": sign(k1, "k1", base),
    "expired": sign(k1, "k1", {**base, "exp": now - 600}),
    "wrong_aud": sign(k1, "k1", {**base, "aud": ["other-aud"]}),
    "wrong_iss": sign(k1, "k1", {**base, "iss": "https://other.example.test"}),
    "wrong_key": sign(k_other, "k1", base),
}
print(json.dumps(out))
"""
    raw = subprocess.check_output(
        [DAYBRIEF_MCP_PY, "-c", helper, TEAM, AUD],
        text=True,
        timeout=30,
    )
