def test_cli_contract_and_doctor(tmp: Path) -> str:
    store = tmp / "cli-store"
    env = clean_env(tmp, DAYBRIEF_DIR=str(store))

    help_long = run_cli(["--help"], env=env)
    help_short = run_cli(["-h"], env=env)
    help_bare = run_cli([], env=env)
    assert help_long.stdout == help_short.stdout == help_bare.stdout
    assert "Usage: daybrief" in help_long.stdout
    assert "Options:" in help_long.stdout
    assert "Display this help message and exit" in help_long.stdout

    unknown = run_cli(["--unknown-option"], env=env, check=False)
    assert unknown.returncode == 1, unknown.returncode
    assert "Try 'daybrief --help'" in unknown.stderr

    init_out = json.loads(
        run_cli(["--dir", str(store), "init", "--json"], env=env).stdout
    )
    assert set(init_out["created"]) == {
        "constitution.md",
        "editorial-guidance.md",
        "config.toml",
    }
    const_path = store / "constitution.md"
    guid_path = store / "editorial-guidance.md"
    assert stat.S_IMODE(const_path.stat().st_mode) == 0o444
    assert (store / "guidance-history" / "v0001.md").is_file()
    assert (store / "memory.db").is_file()

    # Clean doctor -> [PASS], exit 0
    doc_ok = run_cli(["--dir", str(store), "doctor"], env=env)
    assert "[PASS]" in doc_ok.stdout, doc_ok.stdout
    assert "[WARN]" not in doc_ok.stdout
    assert "[FAIL]" not in doc_ok.stdout

    # Writable constitution.md (0644) -> [WARN], exit 1
    const_path.chmod(0o644)
    doc_warn = run_cli(["--dir", str(store), "doctor"], env=env, check=False)
    assert doc_warn.returncode == 1, doc_warn.stdout
    assert "[WARN]" in doc_warn.stdout
    assert "constitution.md is writable" in doc_warn.stdout
    const_path.chmod(0o444)

    # Oversized editorial-guidance.md (> 2,000 chars) -> [FAIL], exit 1
    orig_guidance = guid_path.read_text(encoding="utf-8")
    guid_path.write_text("# Guidance\n\n" + ("x" * 2050) + "\n", encoding="utf-8")
    doc_fail = run_cli(["--dir", str(store), "doctor"], env=env, check=False)
    assert doc_fail.returncode == 1, doc_fail.stdout
    assert "[FAIL]" in doc_fail.stdout
    assert "cap 2000" in doc_fail.stdout
    guid_path.write_text(orig_guidance, encoding="utf-8")

    return "help/-h/bare exit 0, unknown exits 1, init & doctor PASS/WARN/FAIL verified"


