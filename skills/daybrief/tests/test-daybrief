def bypass_proxy_for_loopback() -> None:
    """Ensure loopback servers bypass any sandbox HTTP proxy."""
    for var in ("no_proxy", "NO_PROXY"):
        hosts = [h for h in os.environ.get(var, "").split(",") if h]
        hosts += [h for h in ("127.0.0.1", "localhost") if h not in hosts]
        os.environ[var] = ",".join(hosts)


bypass_proxy_for_loopback()


def script_python(script: Path) -> str:
    subprocess.run(
        ["uv", "sync", "-q", "--script", str(script)],
        stdin=subprocess.DEVNULL,
        check=True,
    )
    return subprocess.run(
        ["uv", "python", "find", "--script", str(script)],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()


DAYBRIEF_PY = script_python(DAYBRIEF)
