        )
        case(
            "daybrief-mcp DAYBRIEF_SKILL_DIR resolution and HTTP/Access CLI guardrails",
            lambda: test_mcp_self_containment_and_cli_guards(tmp),
        )

        def require_populated() -> tuple[Path, str, str, str]:
            if populated is None:
                raise RuntimeError("populated store prerequisite failed")
            return populated

        case(
            "daybrief-mcp over stdio (initialize, prompts, tools, feedback hash, SIGTERM)",
            lambda: test_mcp_stdio(tmp, *require_populated()),
        )
        case(
            "daybrief-mcp over HTTP with RS256 Cloudflare Access and mcp.jsonl compliance",
            lambda: test_mcp_http_access_and_logs(
                tmp, require_populated()[0], require_populated()[2]
            ),
        )
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    print(f"1..{NUMBER}", flush=True)
    return 1 if FAILED else 0


