    tmp = Path(tempfile.mkdtemp(prefix="daybrief-test."))
    populated: tuple[Path, str, str, str] | None = None
    try:
        case(
            "CLI contract (--help/-h/bare/unknown), init, and doctor PASS/WARN/FAIL",
            lambda: test_cli_contract_and_doctor(tmp),
        )
