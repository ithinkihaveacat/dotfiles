            "read-only Chalk/Pinboard adapters and safe_read_source_file boundaries",
            lambda: test_readonly_sources_and_boundaries(tmp),
        )
        case(
            "loopback HTTP caching, server-down AGENT_OFFLINE=1 hit, and uncached refusal",
            lambda: test_http_cache_and_offline_mode(tmp),
