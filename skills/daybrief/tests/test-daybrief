    (paths["taskgo"] / "secrets").mkdir(exist_ok=True)
    (paths["taskgo"] / "secrets" / "token.txt").write_text("TOK\n", encoding="utf-8")
    (paths["taskgo"] / "atlas" / "signing.key").write_text("KEY\n", encoding="utf-8")

