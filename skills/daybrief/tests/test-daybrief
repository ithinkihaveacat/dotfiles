def load_cli() -> Any:
    global _CLI_MOD
    if _CLI_MOD is None:
        loader = SourceFileLoader("daybrief_cli_under_test", str(DAYBRIEF))
        spec = importlib.util.spec_from_loader("daybrief_cli_under_test", loader)
        assert spec is not None
        module = importlib.util.module_from_spec(spec)
        sys.modules["daybrief_cli_under_test"] = module
        loader.exec_module(module)
        _CLI_MOD = module
    return _CLI_MOD


def report(name: str, ok: bool, detail: str = "") -> None:
    global NUMBER, FAILED
    NUMBER += 1
    if not ok:
        FAILED += 1
    print(f"{'ok' if ok else 'not ok'} {NUMBER} - {name}", flush=True)
    if not ok:
        for line in detail.splitlines():
            print(f"# {line}", flush=True)


def case(name: str, fn: Any) -> None:
    try:
        detail = str(fn() or "")
    except Exception:
        report(name, False, traceback.format_exc())
    else:
        report(name, True, detail)


