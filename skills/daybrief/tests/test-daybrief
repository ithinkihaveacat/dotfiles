            assert new_until == (today_date + datetime.timedelta(days=25)).isoformat()
        finally:
            db.close()

        # 2. Retrospective: --dry-run, verify ambiguous_silence tag, live v0002, >2000 cap refusal, rollback
        recorded_requests.clear()
        retro_dry = json.loads(
            run_cli(
                ["--dir", str(store), "retro", "--days", "7", "--dry-run", "--json"],
                env=env,
            ).stdout
        )
        assert retro_dry["should_update"] is True
        assert retro_dry["applied"] is False
        assert retro_dry["from_version"] == 1
        assert retro_dry["to_version"] == 1
        assert "--- editorial-guidance.md (v0001)" in retro_dry["diff"]
        assert (store / "editorial-guidance.md").read_text(
            encoding="utf-8"
        ) == v1_guidance

        # Inspect payload sent to mock Gemini during retro
        retro_sent = json.loads(
            recorded_requests[-1]["body"]["contents"][0]["parts"][0]["text"]
        )
        sent_items = {
            it["id"]: it["response_state"]
            for it in retro_sent["briefings_in_window"][0]["items"]
        }
        assert sent_items == {
            item1_id: "ambiguous_silence_do_not_infer_dislike",
            item2_id: "explicit_feedback_present",
        }, sent_items

        # Live retro apply -> v0002
        retro_live = json.loads(
            run_cli(
                ["--dir", str(store), "retro", "--days", "7", "--json"], env=env
            ).stdout
        )
        assert retro_live["applied"] is True
        assert retro_live["from_version"] == 1
        assert retro_live["to_version"] == 2
        assert (store / "guidance-history" / "v0002.md").is_file()
        assert "seasonal knitwear snoozes" in (
            store / "editorial-guidance.md"
        ).read_text(encoding="utf-8")

        # Oversize (>2,000-char) proposed guidance -> BoundaryError in-process & CLI exit 1
        retro_mode["oversize"] = True
        caught_msg = ""
        with patched_environ(env):
            store_obj = cli.Store(store)
            try:
                store_obj.retro(days=7)
            except cli.BoundaryError as exc:
                caught_msg = str(exc)
        assert "2000-character guidance cap" in caught_msg

        oversize_cli = run_cli(
            ["--dir", str(store), "retro", "--days", "7"],
            env=env,
            check=False,
        )
        assert oversize_cli.returncode == 1
        assert "2000-character guidance cap" in oversize_cli.stderr
        retro_mode["oversize"] = False

        # Rollback restores v0001 content byte-for-byte
        rb = json.loads(
            run_cli(
                ["--dir", str(store), "retro", "--rollback", "--json"],
                env=env,
            ).stdout
        )
        assert rb["rolled_back_from"] == 2
        assert rb["restored_source"] == "v0001"
        assert rb["guidance_version"] == 3
        assert (store / "editorial-guidance.md").read_text(
            encoding="utf-8"
        ) == v1_guidance
        assert (
            hashlib.sha256((store / "constitution.md").read_bytes()).hexdigest()
            == const_sha_before
        )
    finally:
        srv.shutdown()
        srv.server_close()
        thread.join(timeout=5)

    return store, today_iso, brief_id, item1_id


# --- MCP Stdio & HTTP Helpers ------------------------------------------------


class StdioClient:
    def __init__(self, cmd: list[str], env: dict[str, str]):
        self.proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            env=env,
        )
        self.next_id = 0

    def send(
        self, method: str, params: Any = None, *, notify: bool = False
    ) -> int | None:
        msg: dict[str, Any] = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            msg["params"] = params
        if not notify:
            self.next_id += 1
            msg["id"] = self.next_id
        assert self.proc.stdin is not None
        self.proc.stdin.write(json.dumps(msg) + "\n")
        self.proc.stdin.flush()
        return None if notify else self.next_id

    def read(self, want: int, timeout: float = 30.0) -> dict[str, Any]:
        assert self.proc.stdout is not None
        deadline = time.monotonic() + timeout
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                raise AssertionError(f"timed out waiting for JSON-RPC id={want}")
            ready, _, _ = select.select([self.proc.stdout], [], [], left)
            if not ready:
                raise AssertionError(f"timed out waiting for JSON-RPC id={want}")
            line = self.proc.stdout.readline()
            if not line:
                stderr = self.proc.stderr.read() if self.proc.stderr else ""
                raise AssertionError(f"stdio MCP server closed unexpectedly: {stderr}")
            parsed = json.loads(line)
            if parsed.get("id") == want:
                return parsed

    def request(self, method: str, params: Any = None) -> dict[str, Any]:
        ident = self.send(method, params)
        assert ident is not None
        return self.read(ident)

    def terminate_cleanly(self) -> int:
        self.proc.send_signal(signal.SIGTERM)
        try:
            return self.proc.wait(timeout=15)
        finally:
            if self.proc.stdin:
                self.proc.stdin.close()
            if self.proc.stdout:
                self.proc.stdout.close()
            if self.proc.stderr:
                self.proc.stderr.close()


def test_mcp_self_containment_and_cli_guards(tmp: Path) -> str:
    env = clean_env(tmp)

    # 1. Lone copy of daybrief-mcp outside skill tree fails naming DAYBRIEF_SKILL_DIR
    lone_dir = tmp / "isolated-copy"
    lone_dir.mkdir(parents=True)
    lone_mcp = lone_dir / "daybrief-mcp"
    shutil.copy2(DAYBRIEF_MCP, lone_mcp)

    failed_copy = run_mcp_cli(["--help"], env=env, exe=lone_mcp)
    assert failed_copy.returncode == 1, failed_copy.stderr
    assert "DAYBRIEF_SKILL_DIR" in failed_copy.stderr, failed_copy.stderr

    # Succeeds when DAYBRIEF_SKILL_DIR points back to skill root
    ok_copy = run_mcp_cli(
        ["--help"],
        env={**env, "DAYBRIEF_SKILL_DIR": str(SKILL)},
        exe=lone_mcp,
    )
    assert ok_copy.returncode == 0, ok_copy.stderr
    assert "Usage: daybrief mcp" in ok_copy.stdout

    # Also verify `daybrief mcp --help` forwarding
    via_main = run_mcp_cli(["--help"], env=env, via_daybrief=True)
    assert via_main.returncode == 0, via_main.stderr
    assert "--access-team" in via_main.stdout

    # 2. HTTP bind & Cloudflare Access CLI guardrails
    for bad_args, expected_err in (
        (["--http", "--host", "0.0.0.0"], "loopback only"),
        (["--http", "--access-team", TEAM], "both --access-team and --access-aud"),
        (["--http", "--access-aud", AUD], "both --access-team and --access-aud"),
        (["--access-team", TEAM, "--access-aud", AUD], "apply only to --http"),
    ):
        res = run_mcp_cli(bad_args, env=env)
        assert res.returncode == 1, (bad_args, res.stderr)
        assert expected_err in res.stderr, (bad_args, res.stderr)

    return "DAYBRIEF_SKILL_DIR fallback and --http/--access-* guardrails verified"


def test_mcp_stdio(
    tmp: Path, store: Path, today_iso: str, brief_id: str, item1_id: str
) -> str:
    log_path = tmp / "stdio-mcp.jsonl"
    env = clean_env(tmp, DAYBRIEF_DIR=str(store), DAYBRIEF_MCP_LOG=str(log_path))
    client = StdioClient(
        [
            DAYBRIEF_MCP_PY,
            str(DAYBRIEF_MCP),
            "--dir",
            str(store),
            "--log",
            str(log_path),
        ],
        env=env,
    )
    try:
        # initialize -> instructions present
        init_msg = client.request(
            "initialize",
            {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {"name": "daybrief-stdio-test", "version": "1"},
            },
        )
        init_res = init_msg["result"]
        assert "deliver_verbatim_to_user" in init_res["instructions"]
        assert "backstage_context_for_followups_only" in init_res["instructions"]
        client.send("notifications/initialized", notify=True)

        # prompts/list & prompts/get (morning-brief)
        prompts = client.request("prompts/list")["result"]["prompts"]
        assert [p["name"] for p in prompts] == ["morning-brief"]
        prompt_got = client.request(
            "prompts/get",
            {"name": "morning-brief", "arguments": {"date": today_iso}},
        )["result"]
        prompt_text = prompt_got["messages"][0]["content"]["text"]
        assert f"date='{today_iso}'" in prompt_text
        assert "deliver_verbatim_to_user" in prompt_text

        # tools/list & readOnlyHint annotations
        tools = {t["name"]: t for t in client.request("tools/list")["result"]["tools"]}
        assert set(tools) == {
            "get_today_brief",
            "get_brief",
            "list_briefs",
            "record_feedback",
        }
        for ro_tool in ("get_today_brief", "get_brief", "list_briefs"):
            assert tools[ro_tool]["annotations"]["readOnlyHint"] is True, ro_tool
        assert tools["record_feedback"]["annotations"]["readOnlyHint"] is False

        # get_today_brief returns both deliver_verbatim_to_user & backstage_context_for_followups_only
        today_res = client.request(
            "tools/call", {"name": "get_today_brief", "arguments": {}}
        )["result"]
        assert not today_res.get("isError")
        sc = today_res["structuredContent"]
        assert sc["brief_id"] == brief_id
        assert "Atlas winter wheelset" in sc["deliver_verbatim_to_user"]
        assert "item_dossiers" in sc["backstage_context_for_followups_only"]

        # get_brief valid item dossier + not found isError
        dossier_res = client.request(
            "tools/call",
            {
                "name": "get_brief",
                "arguments": {"id_or_date": brief_id, "item_id": item1_id},
            },
        )["result"]
        assert dossier_res["structuredContent"]["item"]["id"] == item1_id

        missing_res = client.request(
            "tools/call",
            {"name": "get_brief", "arguments": {"id_or_date": "DB-19990101-missing"}},
        )["result"]
        assert missing_res["isError"] is True

        # list_briefs
        listed_res = client.request(
            "tools/call", {"name": "list_briefs", "arguments": {"limit": 5}}
        )["result"]
        assert len(listed_res["structuredContent"]["briefs"]) == 1

        # record_feedback with secret canary text
        fb_res = client.request(
            "tools/call",
            {
                "name": "record_feedback",
                "arguments": {
                    "text": STDIO_CANARY,
                    "brief_id": brief_id,
                    "item_id": item1_id,
                    "kind": "answer",
                },
            },
        )["result"]
        assert fb_res["structuredContent"]["kind"] == "answer"

        # Unknown tool -> JSON-RPC -32602
        bad_tool = client.request(
            "tools/call", {"name": "unknown_tool_xyz", "arguments": {}}
        )
        assert bad_tool["error"]["code"] == -32602, bad_tool

        # Clean exit 0 on SIGTERM while stdin is still open
        rc = client.terminate_cleanly()
        assert rc == 0, f"expected SIGTERM exit 0, got {rc}"
    finally:
        if client.proc.poll() is None:
            client.proc.kill()
            client.proc.wait()

    records = assert_mcp_log_records(
        log_path,
        forbidden_substrings=(STDIO_CANARY, "Atlas winter wheelset"),
    )
    fb_log = next(r for r in records if r.get("tool") == "record_feedback")
    assert re.fullmatch(r"#[0-9a-f]{12}", fb_log["args"]["text"]), fb_log
    not_found_log = next(
        r
        for r in records
        if r.get("tool") == "get_brief" and r.get("outcome") == "tool-error"
    )
    assert not_found_log["reason"] == "not found", not_found_log
    rpc_err_log = next(r for r in records if r.get("outcome") == "rpc-error")
    assert rpc_err_log["reason"] == "invalid params", rpc_err_log
    return f"stdio tools/prompts/SIGTERM verified ({len(records)} log records)"


def raw_http_request(
    port: int,
    method: str,
    path: str,
    *,
    body: bytes | None = None,
    headers: dict[str, str] | None = None,
) -> tuple[int, dict[str, str], bytes]:
    conn = HTTPConnection("127.0.0.1", port, timeout=15)
    try:
        conn.request(method, path, body=body, headers=headers or {})
        resp = conn.getresponse()
        data = resp.read()
        hdrs = {k.lower(): v for k, v in resp.getheaders()}
        return resp.status, hdrs, data
    finally:
        conn.close()


def test_mcp_http_access_and_logs(tmp: Path, store: Path, brief_id: str) -> str:
    tokens = mint_access_material()
    jwks_bytes = json.dumps(tokens["jwks"]).encode("utf-8")

    class JwksHandler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(jwks_bytes)))
            self.end_headers()
            self.wfile.write(jwks_bytes)

        def log_message(self, *args: Any) -> None:
            pass

    jwks_srv = ThreadingHTTPServer(("127.0.0.1", 0), JwksHandler)
    jwks_port = jwks_srv.server_address[1]
    jwks_thread = threading.Thread(target=jwks_srv.serve_forever, daemon=True)
    jwks_thread.start()

    port = free_port()
    log_path = tmp / "http-mcp.jsonl"
    env = clean_env(
        tmp,
        DAYBRIEF_DIR=str(store),
        DAYBRIEF_MCP_LOG=str(log_path),
        DAYBRIEF_MCP_ACCESS_CERTS_URL=f"http://127.0.0.1:{jwks_port}/certs",
    )
    proc = subprocess.Popen(
        [
            DAYBRIEF_MCP_PY,
            str(DAYBRIEF_MCP),
            "--http",
            "--host",
            "127.0.0.1",
            "--port",
            str(port),
            "--allow-host",
            "daybrief.example.test",
            "--access-team",
            TEAM,
            "--access-aud",
            AUD,
            "--dir",
            str(store),
            "--log",
            str(log_path),
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
    )
    try:
        # Wait for /up readiness
        deadline = time.monotonic() + 20.0
        while time.monotonic() < deadline:
            if proc.poll() is not None:
                err = proc.stderr.read() if proc.stderr else ""
                raise AssertionError(
                    f"daybrief-mcp exited early ({proc.returncode}): {err}"
                )
            try:
                st, _, data = raw_http_request(
                    port, "GET", "/up", headers={"Host": "evil.example"}
                )
                if st == 200 and json.loads(data)["status"] == "ok":
                    break
            except OSError:
                time.sleep(0.02)
        else:
            raise AssertionError("daybrief-mcp /up did not become ready")

        # 1. GET /up must NOT be logged at all
        assert not log_path.exists() or log_path.read_text(encoding="utf-8") == ""

        mcp_headers = {
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
        }
        ping_body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "ping"}).encode()

        # 2. Untrusted Host -> 421 refused ("untrusted host")
        st_host, _, _ = raw_http_request(
            port,
            "POST",
            "/mcp",
            body=ping_body,
            headers={**mcp_headers, "Host": "evil.example"},
        )
        assert st_host == 421, st_host

        # 3. Missing / expired / wrong-aud / wrong-iss / wrong-key JWT -> 401 refused
        for label, bad_tok in (
            ("missing", None),
            ("expired", tokens["expired"]),
            ("wrong_aud", tokens["wrong_aud"]),
            ("wrong_iss", tokens["wrong_iss"]),
            ("wrong_key", tokens["wrong_key"]),
        ):
            hdrs = dict(mcp_headers)
            if bad_tok is not None:
                hdrs["Cf-Access-Jwt-Assertion"] = bad_tok
            st_bad, _, _ = raw_http_request(
                port, "POST", "/mcp", body=ping_body, headers=hdrs
            )
            assert st_bad == 401, (label, st_bad)

        authed_headers = {
            **mcp_headers,
            "Host": "daybrief.example.test",
            "Cf-Access-Jwt-Assertion": tokens["valid"],
            "User-Agent": "daybrief-http-test/1",
        }

        # 4. GET /mcp -> 405 with Allow: POST
        st_get, get_hdrs, _ = raw_http_request(
            port,
            "GET",
            "/mcp",
            headers={
                "Host": "daybrief.example.test",
                "Cf-Access-Jwt-Assertion": tokens["valid"],
            },
        )
        assert st_get == 405, st_get
        assert get_hdrs.get("allow") == "POST", get_hdrs

        # 5. Valid RS256 JWT over POST /mcp: initialize, get_today_brief, record_feedback
        init_req = json.dumps(
            {
                "jsonrpc": "2.0",
                "id": 10,
                "method": "initialize",
                "params": {
                    "protocolVersion": "2025-06-18",
                    "capabilities": {},
                    "clientInfo": {"name": "http-client", "version": "1"},
                },
            }
        ).encode()
        st_init, _, init_raw = raw_http_request(
            port, "POST", "/mcp", body=init_req, headers=authed_headers
        )
        assert st_init == 200, (st_init, init_raw)
        assert (
            "deliver_verbatim_to_user" in json.loads(init_raw)["result"]["instructions"]
        )

        brief_req = json.dumps(
            {
                "jsonrpc": "2.0",
                "id": 11,
                "method": "tools/call",
                "params": {"name": "get_today_brief", "arguments": {}},
            }
        ).encode()
        st_brief, _, brief_raw = raw_http_request(
            port, "POST", "/mcp", body=brief_req, headers=authed_headers
        )
        assert st_brief == 200, st_brief
        http_sc = json.loads(brief_raw)["result"]["structuredContent"]
        assert http_sc["brief_id"] == brief_id
        assert "backstage_context_for_followups_only" in http_sc

        fb_req = json.dumps(
            {
                "jsonrpc": "2.0",
                "id": 12,
                "method": "tools/call",
                "params": {
                    "name": "record_feedback",
                    "arguments": {
                        "text": HTTP_CANARY,
                        "brief_id": brief_id,
                        "kind": "preference",
                    },
                },
            }
        ).encode()
        st_fb, _, fb_raw = raw_http_request(
            port, "POST", "/mcp", body=fb_req, headers=authed_headers
        )
        assert st_fb == 200, st_fb
        assert json.loads(fb_raw)["result"]["structuredContent"]["kind"] == "preference"

        # Clean exit 0 on SIGTERM
        proc.send_signal(signal.SIGTERM)
        exit_rc = proc.wait(timeout=15)
        assert exit_rc == 0, f"HTTP server SIGTERM exited {exit_rc}"
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
        if proc.stderr:
            proc.stderr.close()
        jwks_srv.shutdown()
        jwks_srv.server_close()
        jwks_thread.join(timeout=5)

    # 6. Validate mcp.jsonl schema against mcp-logs.md and verify secret canary redaction
    records = assert_mcp_log_records(
        log_path,
        forbidden_substrings=(
            HTTP_CANARY,
            STDIO_CANARY,
            tokens["valid"],
            "alice@example.test",
            "Atlas winter wheelset",
        ),
    )
    assert all(r["transport"] == "http" for r in records), records

    host_refusal = next(r for r in records if r.get("status") == 421)
    assert (host_refusal["outcome"], host_refusal["reason"]) == (
        "refused",
        "untrusted host",
    ), host_refusal

    unauth_statuses = [
        r["status"]
        for r in records
        if r["outcome"] == "refused" and r.get("reason") == "unauthorized"
    ]
    assert unauth_statuses == [401, 401, 401, 401, 401], unauth_statuses

    probe_refusal = next(r for r in records if r.get("status") == 405)
    assert (probe_refusal["outcome"], probe_refusal["reason"]) == (
        "refused",
        "method not allowed",
    ), probe_refusal

    fb_rec = next(r for r in records if r.get("tool") == "record_feedback")
    assert fb_rec["outcome"] == "ok", fb_rec
    assert re.fullmatch(r"#[0-9a-f]{12}", fb_rec["args"]["text"]), fb_rec
    assert re.fullmatch(r"[0-9a-f]{10}", fb_rec["caller"]), fb_rec
    return f"HTTP Access RS256, 421/401/405 refusals, and mcp.jsonl verified ({len(records)} records)"


