def test_http_cache_and_offline_mode(tmp: Path) -> str:
    store = tmp / "cache-store"
    cache_dir = tmp / "http-cache"
    ref_date = "2026-11-28"
    hits = {"weather": 0, "ics": 0}

    weather_payload = json.dumps(
        {
            "daily": {
                "time": ["2026-11-28", "2026-11-29"],
                "weather_code": [1, 61],
                "temperature_2m_max": [11.5, 9.0],
                "temperature_2m_min": [4.2, 5.1],
                "precipitation_probability_max": [10, 80],
                "precipitation_sum": [0.0, 6.4],
            }
        }
    ).encode("utf-8")
    ics_payload = (
        b"BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\n"
        b"UID:remote-1@example.test\r\n"
        b"DTSTART;TZID=Europe/London:20261128T140000\r\n"
        b"SUMMARY:Cached workshop check\r\n"
        b"END:VEVENT\r\nEND:VCALENDAR\r\n"
    )

    class UpstreamHandler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            if self.path.startswith("/forecast"):
                hits["weather"] += 1
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(weather_payload)
            elif self.path == "/feed.ics":
                hits["ics"] += 1
                self.send_response(200)
                self.send_header("Content-Type", "text/calendar")
                self.end_headers()
                self.wfile.write(ics_payload)
            else:
                self.send_response(404)
                self.end_headers()

        def log_message(self, *args: Any) -> None:
            pass

    srv = ThreadingHTTPServer(("127.0.0.1", 0), UpstreamHandler)
    port = srv.server_address[1]
    thread = threading.Thread(target=srv.serve_forever, daemon=True)
    thread.start()

    base_env = clean_env(
        tmp,
        DAYBRIEF_DIR=str(store),
        DAYBRIEF_CACHE_DIR=str(cache_dir),
        DAYBRIEF_WEATHER_URL=f"http://127.0.0.1:{port}/forecast",
        DAYBRIEF_WEATHER_LAT="51.5000",
        DAYBRIEF_WEATHER_LON="-0.1200",
        DAYBRIEF_WEATHER_LABEL="TestBorough",
        DAYBRIEF_CALENDAR_ICS=f"http://127.0.0.1:{port}/feed.ics",
    )
    try:
        # 1. Uncached URL under AGENT_OFFLINE=1 exits 1 naming AGENT_OFFLINE=0
        cold = run_cli(
            ["--dir", str(store), "collect", "--date", ref_date, "--json"],
            env={**base_env, "AGENT_OFFLINE": "1"},
            check=False,
        )
        assert cold.returncode == 1, cold.stderr
        assert "AGENT_OFFLINE=0" in cold.stderr, cold.stderr
        assert hits == {"weather": 0, "ics": 0}

        # 2. Online warm-up populates $DAYBRIEF_CACHE_DIR
        warm = run_cli(
            ["--dir", str(store), "collect", "--date", ref_date, "--json"],
            env={**base_env, "AGENT_OFFLINE": "0"},
        )
        warm_snap = json.loads(warm.stdout)
        assert hits == {"weather": 1, "ics": 1}, hits
        assert warm_snap["sources"]["weather"]["cached"] is False
        assert warm_snap["sources"]["weather"]["days"][0]["summary"] == "Mainly clear"
        assert (
            warm_snap["sources"]["calendar"]["events"][0]["summary"]
            == "Cached workshop check"
        )
        assert list((cache_dir / "weather").glob("*.dat"))
        assert list((cache_dir / "calendar").glob("*.dat"))
    finally:
        srv.shutdown()
        srv.server_close()
        thread.join(timeout=5)

    # 3. With loopback server completely stopped, AGENT_OFFLINE=1 serves from cache
    offline_hit = run_cli(
        ["--dir", str(store), "collect", "--date", ref_date, "--json"],
        env={**base_env, "AGENT_OFFLINE": "1"},
    )
    cached_snap = json.loads(offline_hit.stdout)
    assert cached_snap["sources"]["weather"]["cached"] is True
    assert cached_snap["sources"]["weather"]["days"][1]["summary"] == "Light rain"
    assert (
        cached_snap["sources"]["calendar"]["events"][0]["summary"]
        == "Cached workshop check"
    )
    assert "using cached weather data (" in offline_hit.stderr, offline_hit.stderr
    assert "using cached calendar data (" in offline_hit.stderr, offline_hit.stderr

    # 4. A different uncached URL under AGENT_OFFLINE=1 exits 1 naming AGENT_OFFLINE=0
    uncached = run_cli(
        ["--dir", str(store), "collect", "--date", ref_date, "--json"],
        env={
            **base_env,
            "AGENT_OFFLINE": "1",
            "DAYBRIEF_CALENDAR_ICS": f"http://127.0.0.1:{port}/uncached-other.ics",
        },
        check=False,
    )
    assert uncached.returncode == 1, uncached.stderr
    assert "AGENT_OFFLINE=0" in uncached.stderr, uncached.stderr
    return "warm-up cached, offline served after server shutdown with age note, uncached refused"


