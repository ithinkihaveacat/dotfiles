#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "mdformat==1.0.0",
#     "mdformat-gfm==1.0.0",
#     "mdformat-frontmatter==2.2.0",
#     "markdown-it-py==4.2.0",
#     "mdit-py-plugins==0.6.1",
#     "mdurl==0.1.2",
#     "wcwidth==0.9.4",
#     "ruamel.yaml==0.19.1",
# ]
# ///

# Tests: skills/coding-standards/tests/test-markdown-format

from __future__ import annotations

import io
import os
import sys
from pathlib import Path

import mdformat
from ruamel.yaml import YAML

SCRIPT_NAME = os.path.basename(sys.argv[0])
WRAP_WIDTH = 80
SKIP_DIRS = {
    ".git",
    "node_modules",
    "__pycache__",
    ".venv",
    ".direnv",
    ".tox",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
}


def usage() -> None:
    print(
        f"""Usage: {SCRIPT_NAME} [OPTIONS] [PATH...]

Format Markdown files using mdformat.

When PATHs are provided, each file is formatted in place. If a directory is
provided, recursively formats all .md files in it. When no PATH is provided,
reads from standard input and writes to standard output.

Arguments:
  PATH...           Paths to Markdown files or directories to format (optional)

Options:
  --check           Check formatting without making changes
  --help, -h        Display this help message and exit
  --                Treat remaining arguments as file names

Examples:

# Format a file in place
  {SCRIPT_NAME} README.md

# Format all Markdown files in a directory recursively
  {SCRIPT_NAME} docs/

# Check formatting without writing
  {SCRIPT_NAME} --check README.md

# Format reading from stdin
  {SCRIPT_NAME} < notes.md"""
    )


def reformat_frontmatter(text: str) -> str:
    # mdformat-frontmatter passes YAML through verbatim; ruamel.yaml is needed
    # to reflow long folded scalars to WRAP_WIDTH (see tests/markdown-format).
    if not text.startswith("---\n"):
        return text
    end = text.find("\n---\n", 4)
    if end == -1:
        return text

    frontmatter_str = text[4 : end + 1]
    body = text[end + 5 :]

    yaml = YAML()
    yaml.width = WRAP_WIDTH
    yaml.preserve_quotes = True
    yaml.default_flow_style = False

    try:
        data = yaml.load(frontmatter_str)
    except Exception as e:
        print(
            f"{SCRIPT_NAME}: warning: failed to parse front matter: {e}",
            file=sys.stderr,
        )
        return text

    if not data:
        return text

    buf = io.StringIO()
    yaml.dump(data, buf)
    return f"---\n{buf.getvalue()}---\n{body}"


def format_text(text: str) -> str:
    text = reformat_frontmatter(text)
    return mdformat.text(
        text,
        options={"wrap": WRAP_WIDTH},
        extensions={"gfm", "frontmatter"},
    )


def collect_markdown_files(directory: Path) -> list[Path]:
    found: list[Path] = []
    for root, dirs, filenames in os.walk(directory):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
        for name in sorted(filenames):
            if name.endswith(".md"):
                filepath = Path(root) / name
                if filepath.is_file():
                    found.append(filepath)
    return found


def main() -> int:
    args = sys.argv[1:]

    end_options = False
    for arg in args:
        if not end_options:
            if arg in ("--help", "-h"):
                usage()
                return 0
            if arg == "--":
                end_options = True

    check_mode = False
    paths: list[str] = []
    end_options = False
    for arg in args:
        if end_options:
            paths.append(arg)
            continue
        if arg == "--check":
            check_mode = True
        elif arg == "--":
            end_options = True
        elif arg.startswith("-"):
            print(f"{SCRIPT_NAME}: unknown option: {arg}", file=sys.stderr)
            return 1
        else:
            paths.append(arg)

    if not paths and sys.stdin.isatty():
        usage()
        return 1

    if not paths:
        try:
            original = sys.stdin.read()
            formatted = format_text(original)
            if check_mode:
                return 0 if formatted == original else 1
            sys.stdout.write(formatted)
        except Exception as e:
            print(f"{SCRIPT_NAME}: error: {e}", file=sys.stderr)
            return 1
        return 0

    for p in paths:
        if not os.path.exists(p):
            print(f"{SCRIPT_NAME}: {p}: No such file or directory", file=sys.stderr)
            return 1

    targets: list[Path] = []
    for p in paths:
        path = Path(p)
        if path.is_dir():
            targets.extend(collect_markdown_files(path))
        elif path.is_file():
            targets.append(path)
        else:
            print(f"{SCRIPT_NAME}: {p}: No such file or directory", file=sys.stderr)
            return 1

    failed = 0
    for path in targets:
        f = str(path)
        try:
            original = path.read_text(encoding="utf-8")
            formatted = format_text(original)
        except Exception as e:
            print(
                f"{SCRIPT_NAME}: error: mdformat failed on {f}: {e}",
                file=sys.stderr,
            )
            failed = 1
            continue
        if formatted != original:
            if check_mode:
                print(f"{SCRIPT_NAME}: {f}: needs formatting", file=sys.stderr)
                failed = 1
            else:
                path.write_text(formatted, encoding="utf-8")
                print(f"{SCRIPT_NAME}: {f}: formatted")
        elif not check_mode:
            print(f"{SCRIPT_NAME}: {f}: already formatted")
    return failed


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        try:
            sys.stderr.write("\n")
            sys.stderr.flush()
        except Exception:
            pass
        sys.exit(130)
