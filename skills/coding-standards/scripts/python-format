#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "ruff==0.16.0",
# ]
# ///

# Tests: skills/coding-standards/tests/test-python-format

from __future__ import annotations

import os
import subprocess
import sys
import tempfile
from pathlib import Path

# Ruff version and lint rules enforced across the repo. This is the single
# source of truth: CI invokes this script rather than calling ruff directly,
# so there is no separate config file to keep in sync. --isolated makes the
# selection deterministic regardless of any ruff.toml/pyproject.toml near the
# target files. The version is pinned (in the PEP 723 script metadata above)
# and the rule set is explicit, so neither drifts on its own: bumping the ruff
# pin or extending RUFF_SELECT is always a deliberate, reviewed change, never a
# side effect of ruff shipping a new release with different defaults.
#
# Beyond the E/F defaults this adds high-signal, low-noise correctness and
# modernization rules. Most families below are ruff 0.16's own default
# selection (see `ruff check --isolated --show-settings`), adopted wholesale
# because they didn't fire, or fired with real value, against this repo's
# Python entrypoints; a few (PLR, T, S, RET, D, PTH) are narrowed to specific
# codes because their full family — or even their full 0.16-default subset —
# includes members that are noisy or contrary to this repo's own conventions
# for these scripts (see exclusions below).
RUFF_SELECT = (
    "E4,E7,E9,F,B,PLE,ISC,FLY,C4,ASYNC,"
    "UP,RUF,FURB,PIE,DTZ,I,EXE,LOG,G,N,TC,PGH,YTT,PYI,PT,FA,INT,W,SIM,TRY,PERF,PLC,PLW,"
    "T100,S102,S112,RET501,D419,PTH124,PTH210,"
    "PLR0124,PLR0133,PLR0206,PLR0402,PLR1704,PLR1708,PLR1711,PLR1716,PLR1722,PLR1730,PLR1733,PLR1736,PLR2044"
)
# Rules/families deliberately left out, one line each:
#   BLE (blind-except): flags the `except Exception` used throughout this repo
#     as the documented top-level CLI error/signal boundary (see
#     coding-standards/references/python.md, "Handling Ctrl+C, Signals, and
#     Broken Pipes") — narrowing the type is often impossible at that
#     boundary, and would otherwise need dozens of blanket noqas for no
#     bug-catching benefit.
#   S (bandit) beyond S102/S112: S110 hits the same intentional
#     except-Exception-pass shutdown/cleanup pattern as BLE above; the rest
#     (subprocess/network/crypto audit rules like S603/S607/S310) are not part
#     of ruff's own 0.16 default subset and are high-noise for tools that
#     legitimately shell out and fetch URLs.
#   SIM105/SIM112: not part of 0.16's SIM default subset; SIM105 again targets
#     the intentional except-pass pattern, SIM112 flags an intentionally
#     lowercase legacy environment variable spelling.
#   TRY003/TRY300: not part of 0.16's TRY default subset; overly opinionated
#     for scripts that raise plain built-ins with descriptive messages per
#     this repo's error-message style (cli-tools.md).
#   PERF401/PERF203: not part of 0.16's PERF default subset; marginal
#     micro-optimizations not worth the rewrite churn here.
#   PLC0415 (import-outside-top-level): not part of 0.16's PLC default subset;
#     this repo relies on deferred imports for optional/heavy dependencies.
#   PLW0603/PLW2901 (global-statement/redefined-loop-name): not part of 0.16's
#     PLW default subset; flag common, safe idioms here (module-level caches,
#     `line = line.strip()`) rather than real bugs.
#   PLR beyond the codes listed above: the too-many-branches/statements/args
#     complexity metrics are noisy for this repo's script sizes and not part
#     of 0.16's own PLR default subset either.
#   T beyond T100: T201/T203 flag print()/pprint(), which is simply how these
#     CLI tools produce their output.
#   RET beyond RET501: the rest (e.g. RET505 else-after-return) is subjective
#     style, not part of 0.16's RET default subset.
#   D (pydocstyle) beyond D419: this repo's scripts document behavior in
#     usage()/--help text, not docstrings (see cli-tools.md); D419 (empty
#     docstring) is the one exception worth catching regardless.
#   PTH (flake8-use-pathlib) beyond PTH124/PTH210: migrating this repo's
#     extensive os.path usage to pathlib wholesale is a large, low-value
#     rewrite unrelated to correctness.
#   PYI, PT, YTT, FA, INT, N, TC, LOG, G, PGH, EXE: none currently fire here
#     (no stub files, pytest tests, Python 2 compat, i18n, or naming issues in
#     these scripts), so they're included at zero cost as a guard against
#     future regressions rather than for a demonstrated need.
RUFF_IGNORE = "SIM105,SIM112,TRY003,TRY300,PERF401,PERF203,PLC0415,PLW0603,PLW2901"
RUFF_CHECK = [
    "ruff",
    "check",
    "--isolated",
    "--select",
    RUFF_SELECT,
    "--ignore",
    RUFF_IGNORE,
]
RUFF_FORMAT = ["ruff", "format", "--isolated"]

SCRIPT_NAME = os.path.basename(sys.argv[0])


def usage() -> None:
    print(
        f"""Usage: {SCRIPT_NAME} [OPTION] [PATH...]

Format and lint Python files using ruff.

When PATHs are provided, formats and lints files in place. If a directory is
provided, recursively processes all Python files in it.
When no PATH is provided, reads from standard input and writes to standard output.

Arguments:
  PATH...           Paths to Python files or directories to format/lint (optional)

Options:
  --check           Check for lint errors and formatting without making changes
  --help            Display this help message and exit

Examples:

# Format and fix lint errors in a file in place
  {SCRIPT_NAME} script.py

# Format and fix lint errors in a directory recursively
  {SCRIPT_NAME} src/

# Check a file for issues without modifying it
  {SCRIPT_NAME} --check script.py

# Format reading from stdin
  {SCRIPT_NAME} < script.py"""
    )


def run_ruff(args: list[str], *, redirect_stdout_to_stderr: bool = False) -> int:
    res = subprocess.run(
        args,
        stdout=sys.stderr if redirect_stdout_to_stderr else None,
        check=False,
    )
    return res.returncode


def main() -> int:
    check_mode = False
    paths: list[str] = []

    for arg in sys.argv[1:]:
        if arg in ("--help", "-h"):
            usage()
            return 0
        if arg == "--check":
            check_mode = True
        elif arg.startswith("-"):
            print(f"{SCRIPT_NAME}: unknown option: {arg}", file=sys.stderr)
            return 1
        else:
            paths.append(arg)

    if not paths:
        if sys.stdin.isatty():
            usage()
            return 1

        with tempfile.TemporaryDirectory() as tmpdir:
            tmpfile = Path(tmpdir) / "python-format.py"
            tmpfile.write_bytes(sys.stdin.buffer.read())
            tmp_str = str(tmpfile)

            if check_mode:
                if (
                    run_ruff([*RUFF_CHECK, tmp_str], redirect_stdout_to_stderr=True)
                    != 0
                ):
                    return 1
                return run_ruff(
                    [*RUFF_FORMAT, "--check", tmp_str], redirect_stdout_to_stderr=True
                )

            if (
                run_ruff(
                    [*RUFF_CHECK, "--fix", tmp_str], redirect_stdout_to_stderr=True
                )
                == 0
            ):
                run_ruff([*RUFF_FORMAT, tmp_str], redirect_stdout_to_stderr=True)
            sys.stdout.buffer.write(tmpfile.read_bytes())
            return 0

    for p in paths:
        if not os.path.exists(p):
            print(f"{SCRIPT_NAME}: {p}: No such file or directory", file=sys.stderr)
            return 1

    if check_mode:
        print("Checking lint rules with ruff...", file=sys.stderr)
        if run_ruff([*RUFF_CHECK, *paths]) != 0:
            return 1
        print("Checking format with ruff...", file=sys.stderr)
        if run_ruff([*RUFF_FORMAT, "--check", *paths]) != 0:
            return 1
    else:
        print("Fixing lint rules with ruff...", file=sys.stderr)
        if run_ruff([*RUFF_CHECK, "--fix", *paths]) != 0:
            return 1
        print("Formatting with ruff...", file=sys.stderr)
        if run_ruff([*RUFF_FORMAT, *paths]) != 0:
            return 1

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        try:
            sys.stderr.write("\n")
            sys.stderr.flush()
        except Exception:
            pass
        sys.exit(130)
