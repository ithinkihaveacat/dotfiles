#!/usr/bin/env bash

# Tests: skills/coding-standards/tests/test-json-format

set -o pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] [FILE...]

Format JSON files using jq.

When FILEs are provided, each file is formatted in place. When no FILE is
provided, reads from standard input and writes to standard output.

Arguments:
  FILE...     Paths to JSON files to format (optional)

Options:
  --check     Check formatting without changing files or emitting JSON
  --help, -h  Display this help message and exit
  --          Treat remaining arguments as file names

Examples:

# Format a file in place

  $(basename "$0") config.json

# Format multiple files

  $(basename "$0") *.json

# Format from stdin to stdout

  curl -s https://api.example.com/data | $(basename "$0")

# Format a file and see the result

  $(basename "$0") < data.json

# Check formatting without writing

  $(basename "$0") --check config.json
EOF
  exit 0
}

CHECK=0
FILES=()
END_OPTIONS=0
for ARG in "$@"; do
  if [[ "$END_OPTIONS" -eq 0 ]]; then
    case "$ARG" in
      --help | -h) usage ;;
      --) END_OPTIONS=1 ;;
    esac
  fi
done

END_OPTIONS=0
for ARG in "$@"; do
  if [[ "$END_OPTIONS" -eq 1 ]]; then
    FILES+=("$ARG")
    continue
  fi
  case "$ARG" in
    --check) CHECK=1 ;;
    --) END_OPTIONS=1 ;;
    -*)
      echo "$(basename "$0"): unknown option: $ARG" >&2
      exit 1
      ;;
    *) FILES+=("$ARG") ;;
  esac
done

if [[ ${#FILES[@]} -eq 0 && -t 0 ]]; then
  usage
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require jq
require cmp

for FILE in "${FILES[@]}"; do
  if [[ ! -f "$FILE" ]]; then
    echo "$(basename "$0"): $FILE: No such file or directory" >&2
    exit 1
  fi
done

if [[ ${#FILES[@]} -eq 0 && "$CHECK" -eq 0 ]]; then

  # Read from stdin, write to stdout

  jq .
else

  TMPDIR_JSON=$(mktemp -d) || exit 1
  TMPFILE="$TMPDIR_JSON/formatted"
  trap 'rm -f -- "$TMPFILE" "$TMPDIR_JSON/stdin"; rmdir "$TMPDIR_JSON"' EXIT
  if [[ ${#FILES[@]} -eq 0 ]]; then
    cat >"$TMPDIR_JSON/stdin" || exit 1
    FILES=("$TMPDIR_JSON/stdin")
  fi
  FAILED=0
  for FILE in "${FILES[@]}"; do
    if jq . <"$FILE" >"$TMPFILE"; then
      if [[ "$CHECK" -eq 1 ]]; then
        if ! cmp -s "$FILE" "$TMPFILE"; then
          echo "$(basename "$0"): $FILE: needs formatting" >&2
          FAILED=1
        fi
      elif cat "$TMPFILE" >"$FILE"; then
        echo "$(basename "$0"): $FILE: formatted" >&2
      else
        echo "$(basename "$0"): $FILE: could not write formatted JSON" >&2
        FAILED=1
      fi
    else
      echo "$(basename "$0"): $FILE: failed to format" >&2
      FAILED=1
    fi
  done
  exit $FAILED
fi
