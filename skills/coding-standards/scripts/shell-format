#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "shfmt-py==4.2.0",
#     "shellcheck-py==0.11.0.1",
# ]
# ///

# Tests: skills/coding-standards/tests/test-shell-format

from __future__ import annotations

import os
import subprocess
import sys
import tempfile
from pathlib import Path

# shfmt and shellcheck versions enforced across the repo. Both are native
# binaries (Go and Haskell); the PyPI wrappers in the PEP 723 metadata above
# only repackage the official upstream releases so that uv can fetch and cache
# them on any machine. The wrapper versions are pinned exactly, so bumping
# either tool is always a deliberate, reviewed change. Note that shfmt-py's
# version does not track shfmt's: 4.2.0 bundles shfmt v3.14.1.
SHFMT = ["shfmt", "-i", "2", "-ci"]
SHELLCHECK = ["shellcheck"]

SCRIPT_NAME = os.path.basename(sys.argv[0])


def usage() -> None:
    print(
        f"""Usage: {SCRIPT_NAME} [OPTION] [PATH...]

Format and lint shell scripts using shfmt and shellcheck.

When PATHs are provided, formats and lints files in place. If a directory is
provided, recursively processes all shell files in it (files ending in .sh or
.bash, or files with a shell shebang).
When no PATH is provided, reads from standard input and writes to standard output.

Arguments:
  PATH...           Paths to shell files or directories to format/lint (optional)

Options:
  --check           Check for lint errors and formatting without making changes
  --help            Display this help message and exit

Examples:

# Format and lint a file in place
  {SCRIPT_NAME} script.sh

# Format and lint in a directory recursively
  {SCRIPT_NAME} bin/

# Check a file for issues without modifying it
  {SCRIPT_NAME} --check script.sh

# Format reading from stdin
  {SCRIPT_NAME} < script.sh"""
    )


def is_shell_script(path: Path) -> bool:
    if not path.is_file():
        return False
    if path.suffix in (".sh", ".bash"):
        return True
    try:
        with path.open("rb") as f:
            first_line = f.readline().decode("utf-8", errors="replace").rstrip("\r\n")
    except OSError:
        return False
    for prefix in ("bin/", "env "):
        for shell in ("sh", "bash", "dash", "ksh"):
            token = f"{prefix}{shell}"
            if first_line.endswith(token) or f"{token} " in first_line:
                return True
    return False


def has_shebang(path: Path) -> bool:
    try:
        return any(line.startswith(b"#!") for line in path.read_bytes().splitlines())
    except OSError:
        return False


def process_file(path: Path, *, check_mode: bool) -> bool:
    file_str = str(path)
    sc_extra = [] if has_shebang(path) else ["-s", "bash"]
    if check_mode:
        failed = False
        if (
            subprocess.run(
                [*SHFMT, "-d", file_str], stdout=sys.stderr, check=False
            ).returncode
            != 0
        ):
            print(f"{SCRIPT_NAME}: {file_str}: needs formatting", file=sys.stderr)
            failed = True
        if (
            subprocess.run(
                [*SHELLCHECK, *sc_extra, file_str], stdout=sys.stderr, check=False
            ).returncode
            != 0
        ):
            failed = True
        return not failed

    if subprocess.run([*SHFMT, "-w", file_str], check=False).returncode != 0:
        print(f"{SCRIPT_NAME}: {file_str}: failed to format", file=sys.stderr)
        return False
    sc_extra = [] if has_shebang(path) else ["-s", "bash"]
    return (
        subprocess.run([*SHELLCHECK, *sc_extra, file_str], check=False).returncode == 0
    )


def process_dir(directory: Path, *, check_mode: bool) -> bool:
    failed = False
    for root, _, filenames in os.walk(directory):
        for name in filenames:
            filepath = Path(root) / name
            if is_shell_script(filepath) and not process_file(
                filepath, check_mode=check_mode
            ):
                failed = True
    return not failed


def main() -> int:
    check_mode = False
    paths: list[str] = []

    for arg in sys.argv[1:]:
        if arg in ("--help", "-h"):
            usage()
            return 0
        if arg == "--check":
            check_mode = True
        elif arg.startswith("-"):
            print(f"{SCRIPT_NAME}: unknown option: {arg}", file=sys.stderr)
            return 1
        else:
            paths.append(arg)

    if not paths:
        if sys.stdin.isatty():
            usage()
            return 1

        with tempfile.TemporaryDirectory() as tmpdir:
            tmpfile = Path(tmpdir) / "shell-format.sh"
            tmpfile.write_bytes(sys.stdin.buffer.read())
            sc_extra = [] if has_shebang(tmpfile) else ["-s", "bash"]

            if check_mode:
                if (
                    subprocess.run(
                        [*SHFMT, "-d", str(tmpfile)], stdout=sys.stderr, check=False
                    ).returncode
                    != 0
                ):
                    return 1
                return subprocess.run(
                    [*SHELLCHECK, *sc_extra, str(tmpfile)],
                    stdout=sys.stderr,
                    check=False,
                ).returncode

            formatted_file = Path(tmpdir) / "shell-format.formatted.sh"
            with formatted_file.open("wb") as out_f:
                if (
                    subprocess.run(
                        [*SHFMT, str(tmpfile)], stdout=out_f, check=False
                    ).returncode
                    != 0
                ):
                    return 1
            if (
                subprocess.run(
                    [*SHELLCHECK, *sc_extra, str(formatted_file)],
                    stdout=sys.stderr,
                    check=False,
                ).returncode
                != 0
            ):
                return 1
            sys.stdout.buffer.write(formatted_file.read_bytes())
            return 0

    for p in paths:
        if not os.path.exists(p):
            print(f"{SCRIPT_NAME}: {p}: No such file or directory", file=sys.stderr)
            return 1

    failed = 0
    for p in paths:
        path = Path(p)
        if path.is_dir():
            if not process_dir(path, check_mode=check_mode):
                failed = 1
        elif path.is_file():
            if is_shell_script(path):
                if not process_file(path, check_mode=check_mode):
                    failed = 1
            else:
                print(
                    f"{SCRIPT_NAME}: {p}: Not a recognized shell script",
                    file=sys.stderr,
                )
                failed = 1
    return failed


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        try:
            sys.stderr.write("\n")
            sys.stderr.flush()
        except Exception:
            pass
        sys.exit(130)
