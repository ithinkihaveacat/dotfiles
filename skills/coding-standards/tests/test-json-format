#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$DIR/../scripts/json-format"
if ! command -v jq >/dev/null 2>&1; then
  echo '1..0 # SKIP jq not available'
  exit 0
fi
ROOT=$(mktemp -d)
trap 'rm -rf -- "$ROOT"' EXIT
FILE="$ROOT/input.json"

echo '1..14'
check() {
  local n="$1" label="$2"
  shift 2
  if "$@"; then
    echo "ok $n - $label"
  else
    echo "not ok $n - $label"
  fi
}

printf '{"a":1}\n' >"$FILE"
BEFORE=$(cat "$FILE")
if ! "$BIN" --check "$FILE" >/dev/null 2>&1 &&
  [[ "$(cat "$FILE")" == "$BEFORE" ]]; then
  echo 'ok 1 - Check reports drift without writing'
else
  echo 'not ok 1 - Check reports drift without writing'
fi
check 2 'Default formats files' "$BIN" "$FILE"
check 3 'Formatted file passes check' "$BIN" --check "$FILE"
OUT=$("$BIN" <"$FILE")
check 4 'Stdin formatting matches file formatting' test "$OUT" = "$(cat "$FILE")"
check 5 'Formatted stdin passes check' "$BIN" --check <"$FILE"
if ! "$BIN" --check <<<'{"a":1}' >/dev/null 2>&1; then
  echo 'ok 6 - Unformatted stdin fails check'
else
  echo 'not ok 6 - Unformatted stdin fails check'
fi
printf '{"a":1}\n' >"$FILE"
for ARGS in before after; do
  if [[ "$ARGS" == before ]]; then
    CMD=("$BIN" --bogus "$FILE")
    N=7
  else
    CMD=("$BIN" "$FILE" --bogus)
    N=8
  fi
  if ! "${CMD[@]}" >/dev/null 2>&1 &&
    [[ "$(cat "$FILE")" == "$BEFORE" ]]; then
    echo "ok $N - Unknown option $ARGS file fails before writing"
  else
    echo "not ok $N - Unknown option $ARGS file fails before writing"
  fi
done
printf '{invalid\n' >"$ROOT/bad.json"
if ! "$BIN" "$ROOT/bad.json" >/dev/null 2>&1 &&
  [[ "$(cat "$ROOT/bad.json")" == '{invalid' ]]; then
  echo 'ok 9 - Invalid JSON is not overwritten'
else
  echo 'not ok 9 - Invalid JSON is not overwritten'
fi
if ! "$BIN" "$FILE" "$ROOT/missing.json" >/dev/null 2>&1 &&
  [[ "$(cat "$FILE")" == "$BEFORE" ]]; then
  echo 'ok 10 - Missing file fails before writing other files'
else
  echo 'not ok 10 - Missing file fails before writing other files'
fi
printf '{"a":1}\n' >"$ROOT/-input.json"
if (cd "$ROOT" && "$BIN" -- -input.json >/dev/null 2>&1); then
  echo 'ok 11 - End-of-options accepts hyphenated filenames'
else
  echo 'not ok 11 - End-of-options accepts hyphenated filenames'
fi
if OUT=$("$BIN" --bogus "$FILE" --help) &&
  [[ "$OUT" == *"--check"* ]] &&
  [[ "$(cat "$FILE")" == "$BEFORE" ]]; then
  echo 'ok 12 - Help takes precedence without writing'
else
  echo 'not ok 12 - Help takes precedence without writing'
fi

TREE="$ROOT/tree"
mkdir -p "$TREE/nested" "$TREE/node_modules/pkg" "$TREE/.git"
printf '{"k":2}\n' >"$TREE/nested/config.json"
printf '{broken\n' >"$TREE/node_modules/pkg/bad.json"
printf '{broken\n' >"$TREE/.git/bad.json"
if ! "$BIN" --check "$TREE" >/dev/null 2>&1 &&
  [[ "$(cat "$TREE/nested/config.json")" == '{"k":2}' ]]; then
  echo 'ok 13 - Directory --check detects drift and skips node_modules/.git'
else
  echo 'not ok 13 - Directory --check detects drift and skips node_modules/.git'
fi
if "$BIN" "$TREE" >/dev/null 2>&1 &&
  "$BIN" --check "$TREE" >/dev/null 2>&1; then
  echo 'ok 14 - Directory formatting formats nested JSON files recursively'
else
  echo 'not ok 14 - Directory formatting formats nested JSON files recursively'
fi
