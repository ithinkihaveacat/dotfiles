#!/usr/bin/env bash
# Tests: skills/coding-standards/tests/test-kotlin-format
# shellcheck disable=SC2015
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$DIR/../scripts/kotlin-format"

ROOT=$(mktemp -d)
trap 'rm -rf -- "$ROOT"' EXIT
STUB_DIR="$ROOT/bin"
FAKE_DATA="$ROOT/xdg"
mkdir -p "$STUB_DIR" "$FAKE_DATA/ktfmt" "$ROOT/empty"
: >"$FAKE_DATA/ktfmt/ktfmt-0.54-with-dependencies.jar"

cat >"$STUB_DIR/java" <<'EOF'
#!/usr/bin/env bash
dry=0; files=()
for a in "$@"; do [[ "$a" == "--dry-run" ]] && dry=1; [[ "$a" != -* && "$a" != *.jar || "$a" == "-" ]] && files+=("$a"); done
canon=$'fun main() {\n    println(1)\n}'; rc=0
for f in "${files[@]}"; do
  [[ "$f" == "-" ]] && in=$(cat) || in=$(cat "$f")
  if [[ "$dry" -eq 1 ]]; then [[ "$in" == "$canon" ]] || { echo "$f"; rc=1; };
  elif [[ "$f" == "-" ]]; then printf '%s\n' "$canon"; else printf '%s\n' "$canon" >"$f"; fi
done
exit "$rc"
EOF
chmod +x "$STUB_DIR/java"

run_kt() { PATH="$STUB_DIR:$PATH" XDG_DATA_HOME="$FAKE_DATA" "$BIN" "$@"; }
ok() { echo "ok $1 - $2"; }
fail() { echo "not ok $1 - $2"; }

echo "1..6"
FILE="$ROOT/Main.kt"
printf 'fun main(){println(1)}\n' >"$FILE"

! run_kt --bogus "$FILE" 2>/dev/null && ! run_kt "$ROOT/Missing.kt" 2>/dev/null && ok 1 "Unknown flag and missing file" || fail 1 "Unknown flag and missing file"
! PATH="$STUB_DIR:$PATH" XDG_DATA_HOME="$ROOT/empty" AGENT_OFFLINE=1 "$BIN" "$FILE" 2>/dev/null && ok 2 "AGENT_OFFLINE=1 uncached jar" || fail 2 "AGENT_OFFLINE=1 uncached jar"
! run_kt --check "$FILE" 2>/dev/null && [[ "$(cat "$FILE")" == "fun main(){println(1)}" ]] && ok 3 "--check detects drift" || fail 3 "--check detects drift"
run_kt "$FILE" >/dev/null && run_kt --check "$FILE" && ok 4 "In-place format and --check" || fail 4 "In-place format and --check"
[[ "$(printf 'fun main(){println(1)}\n' | run_kt)" == "$(cat "$FILE")" ]] && run_kt --check <"$FILE" && ! (printf 'fun main(){}\n' | run_kt --check 2>/dev/null) && ok 5 "Stdin format and --check" || fail 5 "Stdin format and --check"

mkdir -p "$ROOT/tree/src" "$ROOT/tree/node_modules"
printf 'fun main(){println(1)}\n' >"$ROOT/tree/src/App.kt"
printf 'fun main(){println(1)}\n' >"$ROOT/tree/node_modules/Ignored.kt"
! run_kt --check "$ROOT/tree" 2>/dev/null && run_kt "$ROOT/tree" >/dev/null && run_kt --check "$ROOT/tree" && [[ "$(cat "$ROOT/tree/node_modules/Ignored.kt")" == "fun main(){println(1)}" ]] && ok 6 "Recursive directory scan" || fail 6 "Recursive directory scan"
