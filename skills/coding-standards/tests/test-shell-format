#!/usr/bin/env bash

# Tests: skills/coding-standards/tests/test-shell-format

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/shell-format"

if ! command -v uv >/dev/null 2>&1; then
  echo "1..0 # SKIP uv not available"
  exit 0
fi

echo "1..10"

# Setup temporary input file
TEST_ROOT=$(mktemp -d)
INPUT="$TEST_ROOT/input.sh"
trap 'rm -rf -- "$TEST_ROOT"' EXIT

# Test 1: Basic formatting (smoke test)
cat >"$INPUT" <<'EOF'
#!/bin/bash
if [ "$1" = "foo" ]; then
echo "foo"
fi
EOF

if "$BIN" "$INPUT" >/dev/null 2>&1; then
  # Check if formatting actually applied (should have 2 spaces indent)
  if grep -q "  echo \"foo\"" "$INPUT"; then
    echo "ok 1 - Script ran successfully and formatted file in place"
  else
    echo "not ok 1 - Script did not format file correctly"
    sed 's/^/# /' "$INPUT"
  fi
else
  echo "not ok 1 - Script failed on simple file"
fi

# Test 2: Lint checking with --check (should fail on unformatted/bad lint)
cat >"$INPUT" <<'EOF'
#!/bin/bash
if [ "$1" = "foo" ];then
echo "foo"
fi
EOF
SC_INPUT="$TEST_ROOT/sc.sh"
cat >"$SC_INPUT" <<'EOF'
#!/bin/bash
UNUSED_VAR="bar"
EOF

if ! "$BIN" --check "$INPUT" >/dev/null 2>&1 &&
  ! "$BIN" --check "$SC_INPUT" >/dev/null 2>&1; then
  echo "ok 2 - --check mode exited non-zero on unformatted and shellcheck-dirty files"
else
  echo "not ok 2 - --check mode exited zero on unformatted or shellcheck-dirty file"
fi
rm -f "$SC_INPUT"

# Test 3: Formatting stdin (smoke test)
cat >"$INPUT" <<'EOF'
#!/bin/bash
if [ "$1" = "foo" ]; then
echo "foo"
fi
EOF

if OUTPUT=$("$BIN" <"$INPUT" 2>/dev/null) && [[ "$OUTPUT" == *"  echo \"foo\""* ]]; then
  echo "ok 3 - Formatted stdin successfully to stdout"
else
  echo "not ok 3 - Stdin formatting did not produce expected output"
  echo "# Output was: $OUTPUT"
fi

# Test 4: --check option on clean file (should succeed)
# Let's first format the file in place
"$BIN" "$INPUT" >/dev/null 2>&1

if "$BIN" --check "$INPUT" >/dev/null 2>&1; then
  echo "ok 4 - --check mode exited zero on already formatted/clean file"
else
  echo "not ok 4 - --check mode failed on formatted/clean file"
fi

# Test 5: Help option behavior
if { cmd_out=$("$BIN" --help) && [[ "$cmd_out" == *"Usage: shell-format"* ]]; }; then
  echo "ok 5 - --help displays correct usage text"
else
  echo "not ok 5 - --help did not display correct usage text"
fi

# Fish is optional, but when present it must use fish_indent, not shfmt.
if ! command -v fish_indent >/dev/null 2>&1; then
  for N in 6 7 8 9 10; do
    echo "ok $N - Fish formatting # SKIP fish_indent not available"
  done
  exit 0
fi

FISH="$TEST_ROOT/input.fish"
printf 'if true\necho hello\nend\n' >"$FISH"
BEFORE=$(cat "$FISH")
if ! "$BIN" --check "$FISH" >/dev/null 2>&1 &&
  [[ "$(cat "$FISH")" == "$BEFORE" ]]; then
  echo 'ok 6 - Fish check reports drift without writing'
else
  echo 'not ok 6 - Fish check reports drift without writing'
fi
if "$BIN" "$FISH" >/dev/null 2>&1 &&
  [[ "$(cat "$FISH")" == *'    echo hello'* ]]; then
  echo 'ok 7 - Fish files format in place'
else
  echo 'not ok 7 - Fish files format in place'
fi
if "$BIN" --check "$FISH" >/dev/null 2>&1; then
  echo 'ok 8 - Formatted Fish passes check mode'
else
  echo 'not ok 8 - Formatted Fish passes check mode'
fi
printf '#!/usr/bin/env fish\nif true\necho hello\nend\n' >"$TEST_ROOT/fish-script"
if "$BIN" "$TEST_ROOT/fish-script" >/dev/null 2>&1 &&
  [[ "$(cat "$TEST_ROOT/fish-script")" == *'    echo hello'* ]]; then
  echo 'ok 9 - Extensionless Fish shebang selects fish_indent'
else
  echo 'not ok 9 - Extensionless Fish shebang selects fish_indent'
fi
printf 'if true\necho hello\nend\n' >"$FISH"
if "$BIN" "$TEST_ROOT" >/dev/null 2>&1 &&
  "$BIN" --check "$TEST_ROOT" >/dev/null 2>&1; then
  echo 'ok 10 - Recursive formatting includes Fish and Bash'
else
  echo 'not ok 10 - Recursive formatting includes Fish and Bash'
fi
