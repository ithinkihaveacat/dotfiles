#!/usr/bin/env bash

# Tests: skills/coding-standards/tests/test-markdown-format

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/markdown-format"

if ! command -v uv >/dev/null 2>&1; then
  echo "1..0 # SKIP uv not available"
  exit 0
fi

echo "1..8"

WORK=$(mktemp -d)
INPUT="$WORK/sample.md"
trap 'rm -rf -- "$WORK"' EXIT

# Batch formatting across T1-T5 in a single markdown-format invocation.
T1="$WORK/t1.md"
T2="$WORK/t2.md"
T3="$WORK/t3.md"
T4="$WORK/t4.md"
T5="$WORK/t5.md"

cat >"$T1" <<'EOF'
# Title
Content with  spaces.
EOF

cat >"$T2" <<'EOF'
---
name: test
---
# Title
EOF

cat >"$T3" <<'EOF'
---
description: >
  This is a very long line in the frontmatter that should be wrapped by the formatter but currently isn't because mdformat doesn't support it natively or we need a plugin.
---
# Title
EOF

cat >"$T4" <<'EOF'
---
description: |
  This is a very long line in the frontmatter that should NOT be wrapped by the formatter because it is a literal scalar.
---
# Title
EOF

cat >"$T5" <<'EOF'
---
url: https://www.example.com/this/is/a/very/long/url/that/should/not/be/broken/randomly/even/if/it/exceeds/eighty/characters/limit
---
# Title
EOF

fmt_rc=0
"$BIN" "$T1" "$T2" "$T3" "$T4" "$T5" >/dev/null 2>&1 || fmt_rc=$?

# Test 1: Basic formatting (smoke test)
if [ "$fmt_rc" -eq 0 ] && grep -q "Content with spaces." "$T1"; then
  echo "ok 1 - Script ran successfully on simple file"
else
  echo "not ok 1 - Script failed on simple file"
fi

# Test 2: Frontmatter preservation
if [ "$fmt_rc" -eq 0 ] && grep -q "name: test" "$T2"; then
  echo "ok 2 - Frontmatter preserved"
else
  echo "not ok 2 - Frontmatter lost or mangled"
  sed 's/^/# /' "$T2"
fi

# Test 3: Frontmatter wrapping
if [ "$fmt_rc" -eq 0 ] && grep -q "wrapped by the formatter$" "$T3" && grep -q "or we need a plugin.$" "$T3"; then
  echo "ok 3 - Frontmatter lines wrapped correctly"
else
  echo "not ok 3 - Frontmatter lines not wrapped as expected"
  sed 's/^/# /' "$T3"
fi

# Test 4: Literal scalar preservation (should NOT wrap)
if [ "$fmt_rc" -eq 0 ] && grep -q "should NOT be wrapped by the formatter because it is a literal scalar." "$T4"; then
  echo "ok 4 - Literal scalar preserved without wrapping"
else
  echo "not ok 4 - Literal scalar was wrapped or mangled"
  sed 's/^/# /' "$T4"
fi

# Test 5: Long word handling
if [ "$fmt_rc" -eq 0 ] && grep -q "https://www.example.com/this/is/a/very/long/url/that/should/not/be/broken/randomly/even/if/it/exceeds/eighty/characters/limit" "$T5"; then
  echo "ok 5 - Long word handled without breaking"
else
  echo "not ok 5 - Long word was broken or mangled"
  sed 's/^/# /' "$T5"
fi

# Test 6: Check option on clean file (should succeed)
if [ "$fmt_rc" -eq 0 ] && "$BIN" --check "$T5" >/dev/null 2>&1; then
  echo "ok 6 - --check mode exited zero on clean file"
else
  echo "not ok 6 - --check mode failed on clean file"
fi

# Test 7: Check option on dirty file (should fail)
cat >"$INPUT" <<'EOF'
# Title
Content with  spaces.
EOF
if ! "$BIN" --check "$INPUT" >/dev/null 2>&1; then
  echo "ok 7 - --check mode exited non-zero on dirty file"
else
  echo "not ok 7 - --check mode exited zero on dirty file"
fi

# Test 8: Recursive directory formatting and --check (skipping node_modules/.git)
TREE="$WORK/tree"
mkdir -p "$TREE/docs" "$TREE/node_modules/pkg" "$TREE/.git"
printf '# Guide\nExtra   spaces.\n' >"$TREE/docs/guide.md"
printf '# Unformatted\nExtra   spaces.\n' >"$TREE/node_modules/pkg/README.md"
if ! "$BIN" --check "$TREE" >/dev/null 2>&1 &&
  "$BIN" "$TREE" >/dev/null 2>&1 &&
  "$BIN" --check "$TREE" >/dev/null 2>&1 &&
  grep -q "Extra   spaces" "$TREE/node_modules/pkg/README.md"; then
  echo "ok 8 - Directory formatting formats .md recursively and skips ignored dirs"
else
  echo "not ok 8 - Directory formatting failed or touched ignored dirs"
fi
