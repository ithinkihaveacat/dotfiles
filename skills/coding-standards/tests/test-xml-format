#!/usr/bin/env bash
# Tests: skills/coding-standards/tests/test-xml-format
# shellcheck disable=SC2015
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$DIR/../scripts/xml-format"
if ! command -v xmllint >/dev/null 2>&1; then
  echo '1..0 # SKIP xmllint not available'
  exit 0
fi

ROOT=$(mktemp -d)
trap 'rm -rf -- "$ROOT"' EXIT
FILE="$ROOT/input.xml"

echo '1..6'
ok() { echo "ok $1 - $2"; }
fail() { echo "not ok $1 - $2"; }

printf '<root><item>1</item></root>\n' >"$FILE"
BEFORE=$(cat "$FILE")

! "$BIN" --check "$FILE" 2>/dev/null && [[ "$(cat "$FILE")" == "$BEFORE" ]] && ok 1 'Check reports drift without writing' || fail 1 'Check reports drift without writing'
"$BIN" "$FILE" 2>/dev/null && "$BIN" --check "$FILE" && ok 2 'Default formats in place and passes --check' || fail 2 'Default formats in place and passes --check'
[[ "$("$BIN" <"$FILE")" == "$(cat "$FILE")" ]] && "$BIN" --check <"$FILE" && ! "$BIN" --check <<<'<root><a/></root>' 2>/dev/null && ok 3 'Stdin formatting and --check' || fail 3 'Stdin formatting and --check'

printf '<unclosed>\n' >"$ROOT/bad.xml"
! "$BIN" "$ROOT/bad.xml" 2>/dev/null && [[ "$(cat "$ROOT/bad.xml")" == '<unclosed>' ]] && ! "$BIN" --bogus "$FILE" 2>/dev/null && ! "$BIN" "$ROOT/missing.xml" 2>/dev/null && ok 4 'Invalid XML, unknown option, and missing file' || fail 4 'Invalid XML, unknown option, and missing file'

HELP_OUT=$("$BIN" --help)
[[ "$HELP_OUT" == *"--check"* && "$HELP_OUT" != *"<https://"* ]] && ok 5 'Help output omits angle-bracket URLs' || fail 5 'Help output omits angle-bracket URLs'

mkdir -p "$ROOT/tree/res" "$ROOT/tree/node_modules"
printf '<resources><string name="a">b</string></resources>\n' >"$ROOT/tree/res/strings.xml"
printf '<broken\n' >"$ROOT/tree/node_modules/bad.xml"
! "$BIN" --check "$ROOT/tree" 2>/dev/null && "$BIN" "$ROOT/tree" 2>/dev/null && "$BIN" --check "$ROOT/tree" && ok 6 'Recursive directory formatting skips ignored dirs' || fail 6 'Recursive directory formatting skips ignored dirs'
