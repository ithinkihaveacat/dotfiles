#!/usr/bin/env bash

# Tests: skills/coding-standards/tests/test-xml-format

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$DIR/../scripts/xml-format"
if ! command -v xmllint >/dev/null 2>&1; then
  echo '1..0 # SKIP xmllint not available'
  exit 0
fi

ROOT=$(mktemp -d)
trap 'rm -rf -- "$ROOT"' EXIT
FILE="$ROOT/input.xml"

echo '1..14'
check() {
  local n="$1" label="$2"
  shift 2
  if "$@"; then
    echo "ok $n - $label"
  else
    echo "not ok $n - $label"
  fi
}

printf '<root><item>1</item></root>\n' >"$FILE"
BEFORE=$(cat "$FILE")

if ! "$BIN" --check "$FILE" >/dev/null 2>&1 &&
  [[ "$(cat "$FILE")" == "$BEFORE" ]]; then
  echo 'ok 1 - Check reports drift without writing'
else
  echo 'not ok 1 - Check reports drift without writing'
fi

check 2 'Default formats files' "$BIN" "$FILE"
check 3 'Formatted file passes check' "$BIN" --check "$FILE"
OUT=$("$BIN" <"$FILE")
check 4 'Stdin formatting matches file formatting' test "$OUT" = "$(cat "$FILE")"
check 5 'Formatted stdin passes check' "$BIN" --check <"$FILE"

if ! "$BIN" --check <<<'<root><item>1</item></root>' >"$ROOT/stdout" 2>/dev/null &&
  [[ ! -s "$ROOT/stdout" ]]; then
  echo 'ok 6 - Unformatted stdin fails check without stdout XML'
else
  echo 'not ok 6 - Unformatted stdin fails check without stdout XML'
fi

printf '<root><item>1</item></root>\n' >"$FILE"
for ARGS in before after; do
  if [[ "$ARGS" == before ]]; then
    CMD=("$BIN" --bogus "$FILE")
    N=7
  else
    CMD=("$BIN" "$FILE" --bogus)
    N=8
  fi
  if ! "${CMD[@]}" >/dev/null 2>&1 &&
    [[ "$(cat "$FILE")" == "$BEFORE" ]]; then
    echo "ok $N - Unknown option $ARGS file fails before writing"
  else
    echo "not ok $N - Unknown option $ARGS file fails before writing"
  fi
done

printf '<unclosed>\n' >"$ROOT/bad.xml"
if ! "$BIN" "$ROOT/bad.xml" >/dev/null 2>&1 &&
  [[ "$(cat "$ROOT/bad.xml")" == '<unclosed>' ]]; then
  echo 'ok 9 - Invalid XML is not overwritten'
else
  echo 'not ok 9 - Invalid XML is not overwritten'
fi

if ! "$BIN" "$FILE" "$ROOT/missing.xml" >/dev/null 2>&1 &&
  [[ "$(cat "$FILE")" == "$BEFORE" ]]; then
  echo 'ok 10 - Missing file fails before writing other files'
else
  echo 'not ok 10 - Missing file fails before writing other files'
fi

printf '<root><item>1</item></root>\n' >"$ROOT/-input.xml"
if (cd "$ROOT" && "$BIN" -- -input.xml >/dev/null 2>&1) &&
  (cd "$ROOT" && "$BIN" --check -- -input.xml >/dev/null 2>&1); then
  echo 'ok 11 - End-of-options accepts hyphenated filenames'
else
  echo 'not ok 11 - End-of-options accepts hyphenated filenames'
fi

if OUT=$("$BIN" --bogus "$FILE" --help) &&
  [[ "$OUT" == *"--check"* ]] &&
  [[ "$OUT" != *"<https://"* ]] &&
  [[ "$(cat "$FILE")" == "$BEFORE" ]]; then
  echo 'ok 12 - Help takes precedence without writing and avoids <https://> corruption'
else
  echo 'not ok 12 - Help takes precedence without writing and avoids <https://> corruption'
fi

TREE="$ROOT/tree"
mkdir -p "$TREE/res/values" "$TREE/node_modules/pkg" "$TREE/.git"
printf '<resources><string name="a">b</string></resources>\n' >"$TREE/res/values/strings.xml"
printf '<broken\n' >"$TREE/node_modules/pkg/bad.xml"
printf '<broken\n' >"$TREE/.git/bad.xml"
if ! "$BIN" --check "$TREE" >/dev/null 2>&1 &&
  "$BIN" "$TREE" >/dev/null 2>&1 &&
  "$BIN" --check "$TREE" >/dev/null 2>&1; then
  echo 'ok 13 - Recursive directory formatting handles .xml and skips ignored dirs'
else
  echo 'not ok 13 - Recursive directory formatting handles .xml and skips ignored dirs'
fi

NOCURL="$ROOT/nocurl"
mkdir -p "$NOCURL"
for tool in bash basename cat cmp dirname find mktemp rm rmdir sort xmllint; do
  if p=$(command -v "$tool" 2>/dev/null); then
    ln -sf "$p" "$NOCURL/$tool"
  fi
done
if PATH="$NOCURL" "$BIN" --check "$TREE/res/values/strings.xml" >/dev/null 2>&1; then
  echo 'ok 14 - Runs without curl on PATH'
else
  echo 'not ok 14 - Runs without curl on PATH'
fi
