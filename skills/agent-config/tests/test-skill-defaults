#!/usr/bin/env bash
#
# User-scope declarative defaults ('etc/skill/defaults', 'add --prune',
# 'install.sh --apply --only skills') and fish agent wrappers (with
# _agent_preflight and agy.fish retired).

set -euo pipefail

# shellcheck source=skills/agent-config/tests/common.sh disable=SC1091
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
skill_test_init

echo "1..11"

REPO_DIR="${TMPDIR}/repo"
mkdir -p "$REPO_DIR" "${HOME}/.codex" "${HOME}/.gemini/config"
git -C "$REPO_DIR" init -q
cd "$REPO_DIR"

list_field() {
  json_get "$1" "next((s['$3'] for s in d if s['name'] == '$2'), '<missing>')"
}

# Test 1: user scope links baseline skills across ~/.claude/skills,
# ~/.agents/skills, and ~/.gemini/config/skills
if "${SCRIPT}" --scope user add --quiet coding-standards test-skill &&
  [ "$(readlink "${HOME}/.claude/skills/coding-standards")" = "${SKILL_SOURCE_DIRS}/coding-standards" ] &&
  [ "$(readlink "${HOME}/.agents/skills/test-skill")" = "${SKILL_SOURCE_DIRS}/test-skill" ] &&
  [ "$(readlink "${HOME}/.gemini/config/skills/coding-standards")" = "${SKILL_SOURCE_DIRS}/coding-standards" ] &&
  out=$("${SCRIPT}" --scope user list --json 2>/dev/null) &&
  [ "$(json_get "$out" 'sorted(s["name"] for s in d)')" = "coding-standards test-skill" ] &&
  [ "$(list_field "$out" coding-standards scope)" = "user" ]; then
  echo "ok 1 - [User] --scope user add links directly into ~/.claude, ~/.agents, and ~/.gemini/config/skills"
else
  echo "not ok 1 - [User] user scope add or list failed: ${out:-}"
fi

# Test 2: --scope user add --prune declaratively removes unlisted links,
# preserves synced/ and foreign directories, handles spec->basename aliases, and
# warns rather than deleting unreachable external mount symlinks.
EXT_UNMOUNTED="/nonexistent-mount-$$/depot/ext-skill"
ALIAS_SRC="${TMPDIR}/sources/using_askill"
mkdir -p "$ALIAS_SRC" "${HOME}/.claude/skills/synced" "${HOME}/.claude/skills/foreign-dir"
printf -- '---\nname: using-askill\n---\nbody\n' >"${ALIAS_SRC}/SKILL.md"
printf 'foreign\n' >"${HOME}/.claude/skills/foreign-dir/SKILL.md"
cat <<EOF >"${XDG_CONFIG_HOME}/skill/plugins/99_alias.py"
def register(api):
    api.register_skill("ext:using-askill", {"path": "${ALIAS_SRC}"})
EOF
ln -s "$EXT_UNMOUNTED" "${HOME}/.gemini/config/skills/ext-skill"
prune_sync_err=$(printf 'coding-standards\nusing-askill\n' | "${SCRIPT}" --scope user add --prune --quiet - 2>&1)
out=$("${SCRIPT}" --scope user list --json 2>/dev/null)
if [ ! -e "${HOME}/.claude/skills/test-skill" ] &&
  [ ! -e "${HOME}/.agents/skills/test-skill" ] &&
  [ -L "${HOME}/.gemini/config/skills/using_askill" ] &&
  [ -d "${HOME}/.claude/skills/synced" ] &&
  [ -f "${HOME}/.claude/skills/foreign-dir/SKILL.md" ] &&
  [ -L "${HOME}/.gemini/config/skills/ext-skill" ] &&
  [[ "$prune_sync_err" == *"kept unlisted link"* ]] &&
  [ "$(json_get "$out" 'sorted(s["name"] for s in d)')" = "coding-standards using_askill" ]; then
  echo "ok 2 - [User] add --prune removes unlisted links, keeps synced/ and unreachable mounts"
else
  echo "not ok 2 - [User] add --prune reconciliation failed: $prune_sync_err / $out"
fi
rm -f "${XDG_CONFIG_HOME}/skill/plugins/99_alias.py" "${HOME}/.gemini/config/skills/ext-skill"
rm -rf "${HOME}/.claude/skills/foreign-dir"

# Test 3: removed --defaults flag, --scope defaults, and 'prune' subcommand fail cleanly
def_flag_rc=0
"${SCRIPT}" -C "$REPO_DIR" add --defaults >/dev/null 2>&1 || def_flag_rc=$?
def_scope_rc=0
"${SCRIPT}" --scope defaults list >/dev/null 2>&1 || def_scope_rc=$?
prune_cmd_rc=0
"${SCRIPT}" -C "$REPO_DIR" prune >/dev/null 2>&1 || prune_cmd_rc=$?
if [ "$def_flag_rc" -eq 2 ] && [ "$def_scope_rc" -eq 2 ] && [ "$prune_cmd_rc" -eq 1 ]; then
  echo "ok 3 - [CLI] removed --defaults, --scope defaults, and prune subcommand are rejected"
else
  echo "not ok 3 - [CLI] unexpected exit codes (flag=$def_flag_rc scope=$def_scope_rc prune=$prune_cmd_rc)"
fi

# Test 4: in the home directory, workspace list points at --scope user
list_rc=0
list_err=$(cd "$HOME" && "${SCRIPT}" list 2>&1) || list_rc=$?
if [ "$list_rc" -eq 1 ] && [[ "$list_err" == *"--scope user"* ]]; then
  echo "ok 4 - [Home] workspace list in HOME points at --scope user"
else
  echo "not ok 4 - [Home] home directory handling wrong (list=$list_rc): $list_err"
fi

# Test 5: add --prune skips unmounted optional plugin skills cleanly without failing
mkdir -p "${XDG_CONFIG_HOME}/skill/plugins"
cat <<EOF >"${XDG_CONFIG_HOME}/skill/plugins/99_optional_mount.py"
def register(api):
    api.register_skill(
        "optmount:unmounted-skill",
        {"path": "${TMPDIR}/unmounted_netfs/unmounted-skill", "resolve": False, "optional": True},
    )
EOF
ln -s "${TMPDIR}/unmounted_netfs/unmounted-skill" "${HOME}/.claude/skills/unmounted-skill"
opt_rc=0
printf 'coding-standards\nunmounted-skill\n' |
  "${SCRIPT}" --scope user add --prune --quiet - 2>/dev/null || opt_rc=$?
if [ "$opt_rc" -eq 0 ] &&
  [ -L "${HOME}/.claude/skills/coding-standards" ] &&
  [ -L "${HOME}/.claude/skills/unmounted-skill" ]; then
  echo "ok 5 - [Defaults] add --prune skips unmounted optional skills without failing or pruning"
else
  echo "not ok 5 - [Defaults] unmounted optional skill failed add --prune (rc=$opt_rc)"
fi
rm -f "${XDG_CONFIG_HOME}/skill/plugins/99_optional_mount.py" "${HOME}/.claude/skills/unmounted-skill"

# Test 6: install.sh --apply --only skills declaratively reconciles union of
# etc/skill/defaults across ~/.dotfiles, overlays, and ~/.config/skill/defaults
# (honoring -name exclusions), prunes unlisted links, and runs doctor.
FAKE_DST="${TMPDIR}/fake-dst"
mkdir -p "${FAKE_DST}/.dotfiles/bin" \
  "${FAKE_DST}/.dotfiles/config/skill/plugins" \
  "${FAKE_DST}/.dotfiles/etc/skill" \
  "${FAKE_DST}/.private/etc/skill" \
  "${FAKE_DST}/.config/skill" \
  "${FAKE_DST}/.claude/skills"
cp "${REPO_ROOT}/install.sh" "${FAKE_DST}/.dotfiles/install.sh"
cp "${REPO_ROOT}/config/skill/plugins/05_local.py" "${FAKE_DST}/.dotfiles/config/skill/plugins/05_local.py"
ln -s "$SCRIPT" "${FAKE_DST}/.dotfiles/bin/skill"
printf '# base defaults\ncoding-standards\ntest-skill\n' >"${FAKE_DST}/.dotfiles/etc/skill/defaults"
printf '# overlay defaults\nemumanager\n' >"${FAKE_DST}/.private/etc/skill/defaults"
printf '# machine override drops test-skill\n-test-skill\n' >"${FAKE_DST}/.config/skill/defaults"
ln -s "${SKILL_SOURCE_DIRS}/test-skill" "${FAKE_DST}/.claude/skills/stale-link"
inst_out=$(
  HOME="$FAKE_DST" \
    XDG_CONFIG_HOME="${FAKE_DST}/.config" \
    XDG_CACHE_HOME="${FAKE_DST}/.cache" \
    XDG_STATE_HOME="${FAKE_DST}/.local/state" \
    AGENT_OFFLINE=1 \
    bash "${FAKE_DST}/.dotfiles/install.sh" --apply --only skills 2>&1
)
if [ -f "${REPO_ROOT}/etc/skill/defaults" ] &&
  [ ! -e "${REPO_ROOT}/etc/skill/defaults.sh" ] &&
  [ -L "${FAKE_DST}/.claude/skills/coding-standards" ] &&
  [ -L "${FAKE_DST}/.claude/skills/emumanager" ] &&
  [ ! -e "${FAKE_DST}/.claude/skills/test-skill" ] &&
  [ ! -e "${FAKE_DST}/.claude/skills/stale-link" ] &&
  [[ "$inst_out" == *"[PASS] Workspace: User skill directories"* ]]; then
  echo "ok 6 - [Install] install.sh --only skills reconciles layered defaults, prunes stale links, and runs doctor"
else
  echo "not ok 6 - [Install] install.sh --only skills failed: $inst_out"
fi

# Test 7: _agent_preflight.fish and agy.fish are retired
if [ ! -e "${REPO_ROOT}/fish/functions/_agent_preflight.fish" ] &&
  [ ! -e "${REPO_ROOT}/fish/functions/agy.fish" ]; then
  echo "ok 7 - [Wrapper] _agent_preflight.fish and agy.fish are retired"
else
  echo "not ok 7 - [Wrapper] _agent_preflight.fish or agy.fish still exists"
fi

# ==============================================================================
# fish wrappers (skipped without fish)
# ==============================================================================
if ! command -v fish >/dev/null 2>&1; then
  echo "ok 8 - [Wrapper] codex applies git hooks cleanly without skill preflight # skip fish not available"
  echo "ok 9 - [Wrapper] claude prepares session .claude/skills and leaves workspace clean # skip fish not available"
  echo "ok 10 - [Wrapper] opencode launches directly without preflight # skip fish not available"
  echo "ok 11 - [Wrapper] claude runs without arguments # skip fish not available"
  exit 0
fi

WRAP_BIN="${TMPDIR}/wrap-bin"
mkdir -p "$WRAP_BIN"
ln -s "$SCRIPT" "${WRAP_BIN}/skill"
ln -s "${REPO_ROOT}/skills/workspace-tools/scripts/hook" "${WRAP_BIN}/hook"
cat >"${WRAP_BIN}/claude" <<'EOF'
#!/usr/bin/env bash
test -d "$AGENT_SESSION_DIR/.claude/skills" && echo "session_skills_dir=ok"
echo "id=$AGENT_SESSION_ID outer=${CLAUDE_CODE_SESSION_ID:-}"
EOF
cat >"${WRAP_BIN}/codex" <<'EOF'
#!/usr/bin/env bash
echo "codex_launched=ok"
EOF
cat >"${WRAP_BIN}/opencode" <<'EOF'
#!/usr/bin/env bash
echo "opencode_launched=ok"
EOF
chmod +x "${WRAP_BIN}/claude" "${WRAP_BIN}/codex" "${WRAP_BIN}/opencode"
FISH_FUNCS="${REPO_ROOT}/fish/functions"
wrap() {
  PATH="${WRAP_BIN}:$PATH" fish --no-config -c \
    "set fish_function_path '${FISH_FUNCS}' \$fish_function_path; $1"
}

# Test 8: codex wrapper applies git hooks cleanly (even with a broken active venv)
WRAP_REPO="${TMPDIR}/wrap-repo"
mkdir -p "$WRAP_REPO/.venv/bin" "$WRAP_REPO/.agents/skills/unmanaged-local"
git -C "$WRAP_REPO" init -q
ln -s "${TMPDIR}/no-such-python" "$WRAP_REPO/.venv/bin/python"
printf 'home = %s\n' "$TMPDIR" >"$WRAP_REPO/.venv/pyvenv.cfg"
cd "$WRAP_REPO"
codex_rc=0
codex_out=$(VIRTUAL_ENV="$WRAP_REPO/.venv" wrap "codex --help" 2>&1) || codex_rc=$?
if [ "$codex_rc" -eq 0 ] &&
  [[ "$codex_out" == *"codex_launched=ok"* ]] &&
  [ -x .git/hooks/commit-msg.d/10-agent ]; then
  echo "ok 8 - [Wrapper] codex applies git hooks cleanly without skill preflight"
else
  echo "not ok 8 - [Wrapper] codex wrapper failed (rc=$codex_rc): $codex_out"
fi
cd "$TMPDIR"

# Test 9: claude wrapper prepares an empty session .claude/skills dir and
# leaves the workspace untouched
CLAUDE_REPO="${TMPDIR}/claude-repo"
mkdir -p "$CLAUDE_REPO"
git -C "$CLAUDE_REPO" init -q
cd "$CLAUDE_REPO"
claude_rc=0
claude_out=$(CLAUDE_CODE_SESSION_ID=outer-session wrap "claude -p hi" 2>&1) || claude_rc=$?
if [ "$claude_rc" -eq 0 ] && [[ "$claude_out" == *"session_skills_dir=ok"* ]] &&
  [[ "$claude_out" == *"outer=outer-session"* ]] &&
  [[ "$claude_out" =~ id=[0-9a-f-]{36} ]] &&
  [ ! -e .claude ] && [ ! -e .agents ]; then
  echo "ok 9 - [Wrapper] claude prepares session .claude/skills and leaves workspace clean"
else
  echo "not ok 9 - [Wrapper] claude wrapper failed (rc=$claude_rc): $claude_out"
fi
cd "$TMPDIR"

# Test 10: opencode wrapper launches directly without preflight
oc_rc=0
oc_out=$(cd "$WRAP_REPO" && wrap "opencode --version" 2>&1) || oc_rc=$?
if [ "$oc_rc" -eq 0 ] && [[ "$oc_out" == *"opencode_launched=ok"* ]]; then
  echo "ok 10 - [Wrapper] opencode launches directly without preflight"
else
  echo "not ok 10 - [Wrapper] opencode wrapper failed (rc=$oc_rc): $oc_out"
fi

# Test 11: claude without arguments parses no options cleanly
noarg_rc=0
noarg_out=$(cd "$CLAUDE_REPO" && wrap "claude" 2>&1) || noarg_rc=$?
if [ "$noarg_rc" -eq 0 ] && [[ "$noarg_out" != *"array indices"* ]] &&
  [[ "$noarg_out" =~ id=[0-9a-f-]{36} ]]; then
  echo "ok 11 - [Wrapper] claude runs without arguments"
else
  echo "not ok 11 - [Wrapper] claude failed with no arguments (rc=$noarg_rc): $noarg_out"
fi
