#!/usr/bin/env bash
# Tests: etc/agents/opencode/plugins/ensure-commit-hooks.ts
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO="$(cd "$DIR/../../.." && pwd)"
NODE_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/node"

probe_ts_node() {
  [[ -x "$1" ]] && "$1" --input-type=module -e 'import "node:test"; process.exit(process.features.typescript ? 0 : 1)' >/dev/null 2>&1
}

NODE_BIN=""
if sys_node=$(command -v node 2>/dev/null) && probe_ts_node "$sys_node"; then
  NODE_BIN="$sys_node"
elif probe_ts_node "$NODE_DATA/default/bin/node"; then
  NODE_BIN="$NODE_DATA/default/bin/node"
elif [[ -d "$NODE_DATA/versions" ]]; then
  while IFS= read -r cand; do
    if probe_ts_node "$cand"; then
      NODE_BIN="$cand"
      break
    fi
  done < <(compgen -G "$NODE_DATA/versions/node-v*/bin/node" | sort -V -r || true)
fi

if [[ -z "$NODE_BIN" ]]; then
  echo "1..0 # SKIP Node.js >=22.18 with native TypeScript test support is not installed"
  exit 0
fi
if ! command -v git >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  echo "1..0 # SKIP git and jq are required"
  exit 0
fi

# Probe for a Node.js binary with native TypeScript stripping (official builds
# >=23.6; Debian's +dfsg package strips Amaro even on Node 24+).
ts_probe() {
  local bin="$1" tmp
  [[ -x "$bin" ]] || return 1
  tmp=$(mktemp "${TMPDIR:-/tmp}/node-ts-probe.XXXXXX.ts")
  printf 'const ok: number = 1;\nif (ok !== 1) process.exit(1);\n' >"$tmp"
  if "$bin" "$tmp" >/dev/null 2>&1; then
    rm -f -- "$tmp"
    return 0
  fi
  rm -f -- "$tmp"
  return 1
}

NODE_BIN=""
if p=$(command -v node 2>/dev/null) && ts_probe "$p"; then
  NODE_BIN="$p"
else
  DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
  if ts_probe "$DATA_HOME/node/default/bin/node"; then
    NODE_BIN="$DATA_HOME/node/default/bin/node"
  elif [[ -d "$DATA_HOME/node/versions" ]]; then
    while IFS= read -r cand; do
      if ts_probe "$cand/bin/node"; then
        NODE_BIN="$cand/bin/node"
      fi
    done < <(find "$DATA_HOME/node/versions" -maxdepth 1 -name 'node-v*' -type d | sort -V)
  fi
fi

if [[ -z "$NODE_BIN" ]]; then
  echo "1..0 # SKIP Node.js with native TypeScript support is required"
  exit 0
fi

# The adapter runs the shared hook, which resolves 'hook' from PATH (or from
# its own checkout). Put the checkout's bin/ first so the test is hermetic.
NODE_DIR=$(dirname "$NODE_BIN")
PATH="$REPO/bin:$NODE_DIR:$PATH" exec "$NODE_BIN" --test --test-reporter=tap \
  "$REPO/etc/agents/opencode/tests/ensure-commit-hooks.test.ts"
