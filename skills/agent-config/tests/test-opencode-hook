#!/usr/bin/env bash
# Tests: etc/agents/opencode/plugins/ensure-commit-hooks.ts
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO="$(cd "$DIR/../../.." && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "1..0 # SKIP Node.js >=26.4 is not installed"
  exit 0
fi
if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 26 || (major === 26 && minor >= 4) ? 0 : 1)'; then
  echo "1..0 # SKIP Node.js >=26.4 is required"
  exit 0
fi
if ! command -v git >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  echo "1..0 # SKIP git and jq are required"
  exit 0
fi

# The adapter runs the shared hook, which resolves 'hook' from PATH (or from
# its own checkout). Put the checkout's bin/ first so the test is hermetic.
PATH="$REPO/bin:$PATH" exec node --test --test-reporter=tap \
  "$REPO/etc/agents/opencode/tests/ensure-commit-hooks.test.ts"
