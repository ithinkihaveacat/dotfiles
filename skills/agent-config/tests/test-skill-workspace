#!/usr/bin/env bash
#
# Workspace detection and the core add/list/remove/clean/update lifecycle for `skill`.
#
# Covers the three workspace backends (unmanaged directory, git repository,
# plugin-registered detector), directory copies with metadata.source in
# SKILL.md frontmatter (and cache exclusions), the git info/exclude managed
# block, the repo-root anchor walk from a subdirectory, and conflict-safe
# add/remove/clean/update respecting tracked and hand-authored skills.

set -euo pipefail

# shellcheck source=skills/agent-config/tests/common.sh disable=SC1091
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
skill_test_init

echo "1..26"

copy_source_of() {
  run_module "
from pathlib import Path
p = m.read_copy_source(Path('$1'))
print(p if p else '')
"
}

# Populate ignored cache directories in coding-standards source to verify
# copy_skill_dir excludes them.
mkdir -p "${SKILL_SOURCE_DIRS}/coding-standards/.git" \
  "${SKILL_SOURCE_DIRS}/coding-standards/__pycache__" \
  "${SKILL_SOURCE_DIRS}/coding-standards/.ruff_cache" \
  "${SKILL_SOURCE_DIRS}/coding-standards/.pytest_cache" \
  "${SKILL_SOURCE_DIRS}/coding-standards/scripts"
printf 'ref\n' >"${SKILL_SOURCE_DIRS}/coding-standards/.git/HEAD"
printf 'pyc\n' >"${SKILL_SOURCE_DIRS}/coding-standards/__pycache__/mod.pyc"
printf 'ruff\n' >"${SKILL_SOURCE_DIRS}/coding-standards/.ruff_cache/CACHEDIR.TAG"
printf 'pytest\n' >"${SKILL_SOURCE_DIRS}/coding-standards/.pytest_cache/README.md"
printf '#!/bin/sh\necho ok\n' >"${SKILL_SOURCE_DIRS}/coding-standards/scripts/check"
chmod +x "${SKILL_SOURCE_DIRS}/coding-standards/scripts/check"

# ==============================================================================
# Unmanaged (default) workspace mode
# ==============================================================================
UNMANAGED_DIR="${TMPDIR}/unmanaged"
mkdir -p "$UNMANAGED_DIR"
cd "$UNMANAGED_DIR"

# Test 1: catalog runs
if "${SCRIPT}" catalog >/dev/null 2>&1; then
  echo "ok 1 - [Unmanaged] catalog runs"
else
  echo "not ok 1 - [Unmanaged] catalog failed"
fi

# Test 2: add multiple skills creates real copies (excluding caches) with metadata.source
if "${SCRIPT}" add coding-standards emumanager >/dev/null 2>&1 &&
  [ -d .claude/skills/coding-standards ] && [ ! -L .claude/skills/coding-standards ] &&
  [ -d .agents/skills/emumanager ] && [ ! -L .agents/skills/emumanager ] &&
  [ -x .claude/skills/coding-standards/scripts/check ] &&
  [ ! -e .claude/skills/coding-standards/.git ] &&
  [ ! -e .claude/skills/coding-standards/__pycache__ ] &&
  [ ! -e .claude/skills/coding-standards/.ruff_cache ] &&
  [ ! -e .claude/skills/coding-standards/.pytest_cache ] &&
  [ "$(copy_source_of "$PWD/.claude/skills/coding-standards")" = "${SKILL_SOURCE_DIRS}/coding-standards" ]; then
  echo "ok 2 - [Unmanaged] add copies skills (excluding caches) and stamps metadata.source"
else
  echo "not ok 2 - [Unmanaged] add did not create clean copies with metadata.source"
fi

# Test 3: list --json returns members with resolved canonical source paths
if out=$("${SCRIPT}" list --json 2>/dev/null) &&
  [ "$(json_get "$out" '[s["name"] for s in d if s["name"]=="coding-standards"]')" = "coding-standards" ] &&
  [ "$(json_get "$out" 'next(s["path"] for s in d if s["name"]=="coding-standards")')" = "${SKILL_SOURCE_DIRS}/coding-standards" ]; then
  echo "ok 3 - [Unmanaged] list --json returns members and canonical source paths"
else
  echo "not ok 3 - [Unmanaged] list --json failed: ${out:-}"
fi

# Test 4: state file .skills-managed NOT created (stateless model)
if [ ! -f .skills-managed ]; then
  echo "ok 4 - [Unmanaged] state file not created (stateless model)"
else
  echo "not ok 4 - [Unmanaged] state file was created unexpectedly"
fi

# Test 5: clean removes copies and does not leave state file
if "${SCRIPT}" clean >/dev/null 2>&1 &&
  [ ! -d .claude ] && [ ! -d .agents ] && [ ! -f .skills-managed ]; then
  echo "ok 5 - [Unmanaged] clean removes copies successfully"
else
  echo "not ok 5 - [Unmanaged] clean left files"
fi

# ==============================================================================
# Git workspace mode
# ==============================================================================
GIT_DIR="${TMPDIR}/git_repo"
mkdir -p "$GIT_DIR"
cd "$GIT_DIR"
git init -q
mkdir -p .claude/skills .agents/skills

# Test 6: add multiple skills creates copies with metadata.source
if "${SCRIPT}" add coding-standards emumanager >/dev/null 2>&1 &&
  [ -d .claude/skills/coding-standards ] && [ ! -L .claude/skills/coding-standards ] &&
  [ -d .agents/skills/emumanager ] && [ ! -L .agents/skills/emumanager ] &&
  [ "$(copy_source_of "$PWD/.agents/skills/emumanager")" = "${SKILL_SOURCE_DIRS}/emumanager" ]; then
  echo "ok 6 - [Git] add multiple skills as copies"
else
  echo "not ok 6 - [Git] add did not create skill copies"
fi

# Test 7: authoritative state file .git/info/skills NOT created (stateless model)
if [ ! -f .git/info/skills ]; then
  echo "ok 7 - [Git] state file .git/info/skills not created"
else
  echo "not ok 7 - [Git] state file .git/info/skills was created unexpectedly"
fi

# Test 8: info/exclude contains regenerated managed block and git status is clean
if [ -f .git/info/exclude ] && grep -q "managed by 'skill'" .git/info/exclude &&
  grep -q '/.claude/skills/coding-standards' .git/info/exclude &&
  [ -z "$(git status --porcelain)" ]; then
  echo "ok 8 - [Git] info/exclude contains managed block and keeps git status clean"
else
  echo "not ok 8 - [Git] info/exclude missing managed entries or git status dirty"
fi

# Test 9: list --json emits names and canonical source paths
if out=$("${SCRIPT}" list --json 2>/dev/null) &&
  [ "$(json_get "$out" '[s["name"] for s in d if s["name"]=="coding-standards"]')" = "coding-standards" ] &&
  [ "$(json_get "$out" 'next(s["path"] for s in d if s["name"]=="coding-standards")')" = "${SKILL_SOURCE_DIRS}/coding-standards" ]; then
  echo "ok 9 - [Git] list --json emits names and canonical source paths"
else
  echo "not ok 9 - [Git] list --json failed: ${out:-}"
fi

# Test 10: exclude block is regenerable: corrupt it, doctor flags the drift as a
# Workspace Exclusions ERROR, and 'prune' rewrites it back to green.
sed '/skills/d' .git/info/exclude >.git/info/exclude.tmp && mv .git/info/exclude.tmp .git/info/exclude
before=$(doctor_json)
if [ "$(check_status "$before" "Workspace Exclusions")" = "ERROR" ] &&
  "${SCRIPT}" prune >/dev/null 2>&1 &&
  grep -q '/.claude/skills/coding-standards' .git/info/exclude; then
  after=$(doctor_json)
  if [ "$(check_status "$after" "Workspace Exclusions")" = "OK" ]; then
    echo "ok 10 - [Git] doctor flags exclude drift; prune rewrites it"
  else
    echo "not ok 10 - [Git] prune did not restore exclude block"
  fi
else
  echo "not ok 10 - [Git] doctor should flag exclude drift and prune should fix it"
fi

# Test 11: remove deletes copy directory and exclude entry
if "${SCRIPT}" remove emumanager >/dev/null 2>&1 &&
  [ ! -e .agents/skills/emumanager ] && ! grep -q "emumanager" .git/info/exclude &&
  [ ! -f .git/info/skills ]; then
  echo "ok 11 - [Git] remove deletes copy directory and exclude entry"
else
  echo "not ok 11 - [Git] remove left copy directory or exclude entry"
fi

# Test 12: clean removes copies and exclude block
if "${SCRIPT}" clean >/dev/null 2>&1 &&
  [ ! -e .claude/skills/coding-standards ] && [ ! -f .git/info/skills ] &&
  ! grep -q "coding-standards" .git/info/exclude; then
  echo "ok 12 - [Git] clean removes copies and exclude block"
else
  echo "not ok 12 - [Git] clean left copies or exclude block"
fi

# Test 13: from a subdirectory with no local skills dir, 'add' binds to the
# anchor an agent would discover (the repo root), installs there rather than
# scattering a skills dir into the subdirectory, and 'prune' run from the
# subdirectory agrees with that install.
mkdir -p sub
cd sub
if "${SCRIPT}" add coding-standards >/dev/null 2>&1 &&
  [ -d ../.claude/skills/coding-standards ] && [ ! -L ../.claude/skills/coding-standards ] &&
  [ -d ../.agents/skills/coding-standards ] && [ ! -L ../.agents/skills/coding-standards ] &&
  [ ! -e .claude/skills/coding-standards ] && [ ! -e .agents/skills/coding-standards ] &&
  grep -q "/.claude/skills/coding-standards" ../.git/info/exclude &&
  grep -q "/.agents/skills/coding-standards" ../.git/info/exclude &&
  "${SCRIPT}" prune --quiet >/dev/null 2>&1 &&
  [ ! -e .claude ] && [ ! -f ../.git/info/skills ]; then
  echo "ok 13 - [Git] subdirectory add binds to repo-root anchor; prune agrees"
else
  echo "not ok 13 - [Git] subdirectory anchor/exclude/prune mismatch"
fi
cd ..
"${SCRIPT}" clean >/dev/null 2>&1 || true

# ==============================================================================
# Workspace detector plugins
# ==============================================================================
cat <<'EOF' >"${XDG_CONFIG_HOME}/skill/plugins/testws.py"
from pathlib import Path


def register(api):
    class MarkerWorkspace(api.FileStateMixin, api.Workspace):
        def __init__(self, root):
            super().__init__(root)
            self.state_file = self.root / ".marker-skills"

        @classmethod
        def detect(cls):
            curr = Path.cwd().resolve()
            for parent in [curr] + list(curr.parents):
                if (parent / ".marker-ws").is_dir():
                    return cls(parent)
            return None

    api.register_workspace(MarkerWorkspace)
EOF

PLUGIN_DIR="${TMPDIR}/plugin_ws"
mkdir -p "${PLUGIN_DIR}/.marker-ws" "${PLUGIN_DIR}/sub"

# Test 14: plugin workspace detected from a subdirectory, copies at plugin root
cd "${PLUGIN_DIR}/sub"
if "${SCRIPT}" add coding-standards >/dev/null 2>&1 &&
  [ -d "${PLUGIN_DIR}/.claude/skills/coding-standards" ] &&
  [ ! -L "${PLUGIN_DIR}/.claude/skills/coding-standards" ] &&
  [ -f "${PLUGIN_DIR}/.marker-skills" ] && [ ! -d .claude ]; then
  echo "ok 14 - [Plugin] custom workspace detected, copies at plugin root"
else
  echo "not ok 14 - [Plugin] copies or state in wrong location"
fi

# Test 15: plugin detector takes precedence over git
GIT_IN_PLUGIN="${TMPDIR}/plugin_git"
mkdir -p "${GIT_IN_PLUGIN}/.marker-ws"
git -C "${GIT_IN_PLUGIN}" init -q
cd "${GIT_IN_PLUGIN}"
if "${SCRIPT}" add coding-standards >/dev/null 2>&1 &&
  [ -f .marker-skills ] && [ ! -f .git/info/skills ]; then
  echo "ok 15 - [Plugin] plugin detector takes precedence over git"
else
  echo "not ok 15 - [Plugin] git detector ran despite plugin match"
fi
rm -f "${XDG_CONFIG_HOME}/skill/plugins/testws.py"
cd "$TMPDIR"

# ==============================================================================
# Conflict-safe lifecycle
# ==============================================================================

# Test 16: 'add' refuses to overwrite a real file or a hand-authored untracked
# skill directory without metadata.source, and 'clean'/'remove' leave it intact.
CONFLICT_DIR="${TMPDIR}/conflict"
mkdir -p "$CONFLICT_DIR"
cd "$CONFLICT_DIR"
git init -q
mkdir -p .claude/skills .agents/skills .agents/skills/emumanager
printf 'real' >.claude/skills/coding-standards
printf -- '---\nname: emumanager\ndescription: Hand authored\n---\nhand body\n' >.agents/skills/emumanager/SKILL.md
conflict_rc=0
conflict_out=$("${SCRIPT}" add coding-standards 2>&1) || conflict_rc=$?
hand_rc=0
hand_out=$("${SCRIPT}" add emumanager 2>&1) || hand_rc=$?
"${SCRIPT}" remove emumanager >/dev/null 2>&1 || true
"${SCRIPT}" clean >/dev/null 2>&1 || true
if [ "$conflict_rc" -ne 0 ] && [ "$hand_rc" -ne 0 ] &&
  [[ "$conflict_out" == *'refusing to overwrite'* ]] &&
  [[ "$hand_out" == *'refusing to overwrite'* ]] &&
  [ "$(cat .claude/skills/coding-standards)" = "real" ] &&
  [ ! -e .agents/skills/coding-standards ] &&
  grep -q "hand body" .agents/skills/emumanager/SKILL.md; then
  echo "ok 16 - [Conflict] add, remove, and clean never overwrite or delete unmanaged files/skills"
else
  echo "not ok 16 - [Conflict] unmanaged file/skill mishandled (rc=$conflict_rc/$hand_rc): $conflict_out / $hand_out"
fi
cd "$TMPDIR"

# Test 17: tracked skill directories are never overwritten by add/update or
# deleted by remove/clean, even if their SKILL.md carries metadata.source.
TRACKED_DIR="${TMPDIR}/tracked-skill"
mkdir -p "$TRACKED_DIR"
cd "$TRACKED_DIR"
git init -q
mkdir -p .claude/skills .agents/skills .claude/skills/test-skill
printf -- '---\nname: test-skill\nmetadata:\n  source: "%s/test-skill"\n---\ncommitted body\n' "${SKILL_SOURCE_DIRS}" >.claude/skills/test-skill/SKILL.md
git add .claude/skills/test-skill/SKILL.md
add_tr_rc=0
"${SCRIPT}" add test-skill >/dev/null 2>&1 || add_tr_rc=$?
"${SCRIPT}" update test-skill >/dev/null 2>&1 || true
"${SCRIPT}" remove test-skill >/dev/null 2>&1 || true
"${SCRIPT}" clean >/dev/null 2>&1 || true
if [ "$add_tr_rc" -ne 0 ] &&
  grep -q "committed body" .claude/skills/test-skill/SKILL.md; then
  echo "ok 17 - [Conflict] add, update, remove, and clean never overwrite or delete tracked skills"
else
  echo "not ok 17 - [Conflict] tracked skill modified or deleted (add_rc=$add_tr_rc)"
fi
cd "$TMPDIR"

# Test 18: 'clean' removes broken dangling symlinks
CLEAN_DANGLING_DIR="${TMPDIR}/clean-dangling"
mkdir -p "$CLEAN_DANGLING_DIR"
cd "$CLEAN_DANGLING_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
ln -s /nonexistent/clean-broken .claude/skills/clean-broken
ln -s /nonexistent/clean-broken .agents/skills/clean-broken
if "${SCRIPT}" clean >/dev/null 2>&1 &&
  [ ! -e .claude/skills/clean-broken ] && [ ! -e .agents/skills/clean-broken ]; then
  echo "ok 18 - [Clean] clean removes broken dangling symlinks"
else
  echo "not ok 18 - [Clean] dangling symlink left behind after clean"
fi
cd "$TMPDIR"

# Test 19: 'remove' heals exclude block drift even if the entry was deleted
# out-of-band, leaving a stale exclude entry behind.
HEAL_EXCLUDE_DIR="${TMPDIR}/heal-exclude"
mkdir -p "$HEAL_EXCLUDE_DIR"
cd "$HEAL_EXCLUDE_DIR"
git init -q
mkdir -p .claude/skills .agents/skills .git/info
cat >.git/info/exclude <<'EOF'
# >>> skills >>>
# managed by 'skill'
/.claude/skills/orphaned-spec
/.agents/skills/orphaned-spec
# <<< skills <<<
EOF
if "${SCRIPT}" remove orphaned-spec >/dev/null 2>&1 &&
  ! grep -q "orphaned-spec" .git/info/exclude; then
  echo "ok 19 - [Remove] remove heals exclude block when entry is deleted out-of-band"
else
  echo "not ok 19 - [Remove] exclude block still contains orphaned entry"
fi
cd "$TMPDIR"

# Test 20: a mutating command run from a subdirectory announces the resolved
# workspace root and flags that the anchor sits above the current directory.
ROOT_NOTE_DIR="${TMPDIR}/root-note"
mkdir -p "${ROOT_NOTE_DIR}/nested"
git -C "${ROOT_NOTE_DIR}" init -q
cd "${ROOT_NOTE_DIR}/nested"
if root_note_out=$("${SCRIPT}" add coding-standards 2>&1) &&
  grep -q "workspace root: ${ROOT_NOTE_DIR}" <<<"$root_note_out" &&
  grep -q "anchor above current directory ${ROOT_NOTE_DIR}/nested" <<<"$root_note_out"; then
  echo "ok 20 - [Output] subdirectory mutation announces resolved root anchor"
else
  echo "not ok 20 - [Output] missing or wrong workspace-root announcement: ${root_note_out:-}"
fi
"${SCRIPT}" clean >/dev/null 2>&1 || true
cd "$TMPDIR"

# ==============================================================================
# -C / --directory, update, and removed options
# ==============================================================================

# Test 21: skill -C <git-subdir> binds to the repo anchor for add and clean
C_GIT_DIR="${TMPDIR}/c-git-repo"
mkdir -p "${C_GIT_DIR}/sub/deep" "${C_GIT_DIR}/.claude/skills" "${C_GIT_DIR}/.agents/skills"
git -C "$C_GIT_DIR" init -q
if "${SCRIPT}" -C "${C_GIT_DIR}/sub/deep" add coding-standards emumanager >/dev/null 2>&1 &&
  [ -d "${C_GIT_DIR}/.agents/skills/coding-standards" ] &&
  [ ! -L "${C_GIT_DIR}/.agents/skills/coding-standards" ] &&
  [ -d "${C_GIT_DIR}/.agents/skills/emumanager" ] &&
  "${SCRIPT}" -C "${C_GIT_DIR}/sub/deep" clean >/dev/null 2>&1 &&
  [ ! -e "${C_GIT_DIR}/.agents/skills/coding-standards" ] &&
  [ ! -e "${C_GIT_DIR}/.agents/skills/emumanager" ]; then
  echo "ok 21 - [-C Git] subdirectory -C binds to the repo anchor for add and clean"
else
  echo "not ok 21 - [-C Git] subdirectory -C add or clean failed"
fi

# Test 22: the removed --from option is a usage error, and apply and preflight
# are unknown commands
from_rc=0
"${SCRIPT}" --from=cli list >/dev/null 2>&1 || from_rc=$?
apply_rc=0
"${SCRIPT}" -C "$C_GIT_DIR" apply >/dev/null 2>&1 || apply_rc=$?
preflight_rc=0
"${SCRIPT}" -C "$C_GIT_DIR" preflight claude >/dev/null 2>&1 || preflight_rc=$?
if [ "$from_rc" -eq 2 ] && [ "$apply_rc" -eq 1 ] && [ "$preflight_rc" -eq 1 ]; then
  echo "ok 22 - [CLI] --from, apply and preflight are gone"
else
  echo "not ok 22 - [CLI] removed interface still accepted (from=$from_rc apply=$apply_rc preflight=$preflight_rc)"
fi

# Test 23: bundle -w bundles clean upstream source without local metadata.source
BUNDLE_OUT="${TMPDIR}/bundle-cli-out"
if "${SCRIPT}" -C "$C_GIT_DIR" add emumanager >/dev/null 2>&1 &&
  "${SCRIPT}" -C "$C_GIT_DIR" bundle -w -o "$BUNDLE_OUT" >/dev/null 2>&1 &&
  [ -f "${BUNDLE_OUT}/emumanager/SKILL.md" ] &&
  ! grep -q "source:" "${BUNDLE_OUT}/emumanager/SKILL.md" &&
  [ ! -e "${BUNDLE_OUT}/coding-standards" ]; then
  echo "ok 23 - [-C] bundle -w bundles clean canonical source skills"
else
  echo "not ok 23 - [-C] bundle -w failed"
fi

# Test 24: skill update refreshes workspace copies (including path-installed skills)
CUSTOM_SRC="${TMPDIR}/custom-path-skill"
mkdir -p "$CUSTOM_SRC"
printf -- '---\nname: custom-path-skill\n---\nv1 body\n' >"${CUSTOM_SRC}/SKILL.md"
"${SCRIPT}" -C "$C_GIT_DIR" add "$CUSTOM_SRC" >/dev/null 2>&1
printf -- '---\nname: custom-path-skill\n---\nv2 body\n' >"${CUSTOM_SRC}/SKILL.md"
if "${SCRIPT}" -C "$C_GIT_DIR" update custom-path-skill >/dev/null 2>&1 &&
  grep -q "v2 body" "${C_GIT_DIR}/.agents/skills/custom-path-skill/SKILL.md" &&
  grep -q "v2 body" "${C_GIT_DIR}/.claude/skills/custom-path-skill/SKILL.md"; then
  echo "ok 24 - [Update] skill update refreshes managed workspace copies from metadata.source"
else
  echo "not ok 24 - [Update] skill update did not refresh workspace copy"
fi

# Test 25: re-running skill add overwrites an existing managed copy or legacy symlink
rm -rf "${C_GIT_DIR}/.agents/skills/emumanager"
ln -s "${SKILL_SOURCE_DIRS}/emumanager" "${C_GIT_DIR}/.agents/skills/emumanager"
if "${SCRIPT}" -C "$C_GIT_DIR" add emumanager >/dev/null 2>&1 &&
  [ -d "${C_GIT_DIR}/.agents/skills/emumanager" ] &&
  [ ! -L "${C_GIT_DIR}/.agents/skills/emumanager" ]; then
  echo "ok 25 - [Upgrade] skill add replaces legacy workspace symlink with a copy"
else
  echo "not ok 25 - [Upgrade] skill add failed to replace legacy symlink"
fi

# Test 26: read-only (0444/0555) skill sources copy, update, and remove without PermissionError
RO_SRC="${TMPDIR}/ro-skill"
mkdir -p "${RO_SRC}/scripts" "${RO_SRC}/references"
printf -- '---\nname: ro-skill\ndescription: Read-only source\n---\nbody\n' >"${RO_SRC}/SKILL.md"
printf '#!/bin/sh\necho ok\n' >"${RO_SRC}/scripts/run"
printf 'ref\n' >"${RO_SRC}/references/doc.md"
chmod 0444 "${RO_SRC}/SKILL.md" "${RO_SRC}/references/doc.md"
chmod 0555 "${RO_SRC}/scripts/run" "${RO_SRC}/scripts" "${RO_SRC}/references" "${RO_SRC}"
ro_ok=false
if "${SCRIPT}" -C "$C_GIT_DIR" add "$RO_SRC" >/dev/null 2>&1 &&
  [ -w "${C_GIT_DIR}/.agents/skills/ro-skill/SKILL.md" ] &&
  [ -x "${C_GIT_DIR}/.agents/skills/ro-skill/scripts/run" ] &&
  "${SCRIPT}" -C "$C_GIT_DIR" update ro-skill >/dev/null 2>&1 &&
  "${SCRIPT}" -C "$C_GIT_DIR" remove ro-skill >/dev/null 2>&1 &&
  [ ! -e "${C_GIT_DIR}/.agents/skills/ro-skill" ]; then
  ro_ok=true
fi
chmod -R u+w "$RO_SRC" 2>/dev/null || true
if [ "$ro_ok" = true ]; then
  echo "ok 26 - [ReadOnly] 0444/0555 skill sources copy, update, and remove cleanly"
else
  echo "not ok 26 - [ReadOnly] read-only skill source copy/update/remove failed"
fi
cd "$TMPDIR"
