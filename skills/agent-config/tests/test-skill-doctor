#!/usr/bin/env bash
#
# `skill doctor` diagnostics, missing-source copy checks, `skill update`, and
# YAML metadata.source frontmatter normalization.

set -euo pipefail

# shellcheck source=skills/agent-config/tests/common.sh disable=SC1091
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
skill_test_init

echo "1..22"

# Test 1: doctor on a healthy workspace reports healthy JSON and renders the
# canonical [PASS] tag style.
UI_DIR="${TMPDIR}/ui"
mkdir -p "$UI_DIR"
cd "$UI_DIR"
git init -q
"${SCRIPT}" add coding-standards >/dev/null 2>&1
healthy_json=$(doctor_json)
if [ "$(json_get "$healthy_json" 'd["healthy"]')" = "true" ] &&
  [ "$(check_status "$healthy_json" "Installed Skills")" = "OK" ] &&
  [ "$(check_status "$healthy_json" "Symlink Health")" = "OK" ] &&
  human=$("${SCRIPT}" doctor 2>&1) &&
  [[ "$human" == *"[PASS] Workspace:"* ]] &&
  [[ "$human" == *"[PASS] Installed Skills: 1 skill(s) installed"* ]]; then
  echo "ok 1 - [Doctor] healthy workspace is healthy in JSON and renders [PASS] tags"
else
  echo "not ok 1 - [Doctor] healthy report wrong: $healthy_json"
fi

# Test 2: there is no expected set -- a workspace with no skills at all is
# healthy, and doctor takes no skill arguments.
cd "$TMPDIR"
EMPTY_DIR="${TMPDIR}/empty"
mkdir -p "$EMPTY_DIR"
cd "$EMPTY_DIR"
git init -q
ej=$(doctor_json)
args_rc=0
"${SCRIPT}" doctor coding-standards >/dev/null 2>&1 || args_rc=$?
if [ "$(json_get "$ej" 'd["healthy"]')" = "true" ] && [ "$args_rc" -eq 2 ]; then
  echo "ok 2 - [Doctor] an empty workspace is healthy; skill arguments are a usage error"
else
  echo "not ok 2 - [Doctor] empty workspace or argument handling wrong (rc=$args_rc): $ej"
fi
cd "$TMPDIR"

# Test 3: doctor flags broken links as WARNING with fix 'skill remove' and does
# not remove them (doctor is read-only).
DANGLING_DIR="${TMPDIR}/dangling"
mkdir -p "$DANGLING_DIR"
cd "$DANGLING_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
ln -s /nonexistent/target .claude/skills/broken
aj=$(doctor_json)
ah=$("${SCRIPT}" doctor 2>&1) || true
if [ "$(check_status "$aj" "Symlink Health")" = "WARNING" ] &&
  [ "$(json_get "$aj" 'd["healthy"]')" = "false" ] &&
  [ "$(json_get "$aj" '[l["path"] for l in d["links"] if l["broken"]]')" = ".claude/skills/broken" ] &&
  [[ "$ah" == *"skill remove broken"* ]] &&
  [ -L .claude/skills/broken ]; then
  echo "ok 3 - [Symlink Health] doctor flags broken links and leaves them in place"
else
  echo "not ok 3 - [Symlink Health] doctor missed or removed a broken link: $ah / $aj"
fi
cd "$TMPDIR"

# Test 4: doctor flags an unmanaged real file in a skills directory.
UNMANAGED_DIR="${TMPDIR}/unmanaged-file"
mkdir -p "$UNMANAGED_DIR"
cd "$UNMANAGED_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
printf 'x' >.claude/skills/stray.txt
uj=$(doctor_json)
if [ "$(check_status "$uj" "Directory Cleanliness")" = "ERROR" ] &&
  [ "$(json_get "$uj" 'd["unmanaged"]')" = ".claude/skills/stray.txt" ]; then
  echo "ok 4 - [Directory Cleanliness] doctor flags an unmanaged file"
else
  echo "not ok 4 - [Directory Cleanliness] doctor missed unmanaged file: $uj"
fi
cd "$TMPDIR"

# Test 5: doctor ignores a tracked real directory (a committed local skill): it
# is healthy and reports nothing unmanaged.
TRACKED_DIR="${TMPDIR}/tracked-skill"
mkdir -p "$TRACKED_DIR"
cd "$TRACKED_DIR"
git init -q
mkdir -p .claude/skills .agents/skills .claude/skills/local-skill
printf 'local' >.claude/skills/local-skill/SKILL.md
git add .claude/skills/local-skill/SKILL.md
tj=$(doctor_json)
if [ "$(json_get "$tj" 'd["healthy"]')" = "true" ] &&
  [ -z "$(json_get "$tj" 'd["unmanaged"]')" ]; then
  echo "ok 5 - [Directory Cleanliness] doctor ignores tracked skill directory"
else
  echo "not ok 5 - [Directory Cleanliness] doctor failed on tracked skill: $tj"
fi

# Test 6: doctor lists VCS-managed skills in its report.
lj=$(doctor_json)
if [ "$(check_status "$lj" "VCS-Managed Skills")" = "OK" ] &&
  [ "$(json_get "$lj" 'next((c["summary"] for c in d["checks"] if c["name"]=="VCS-Managed Skills"), "").startswith("Found 1 skill")')" = "true" ] &&
  [[ "$lj" == *"local-skill"* ]]; then
  echo "ok 6 - [Diagnostics] doctor lists VCS-managed skills"
else
  echo "not ok 6 - [Diagnostics] doctor failed to list VCS-managed skills: $lj"
fi
cd "$TMPDIR"

# Test 7: doctor flags orphaned skill directories.
ORPHANED_DIR="${TMPDIR}/orphaned-test"
mkdir -p "$ORPHANED_DIR"
cd "$ORPHANED_DIR"
git init -q
mkdir -p .claude/skills
mv "$MOCK_HOME/.claude" "$MOCK_HOME/.claude-backup"
oj=$(doctor_json)
oh=$("${SCRIPT}" doctor 2>&1) || true
mv "$MOCK_HOME/.claude-backup" "$MOCK_HOME/.claude"
if [ "$(check_status "$oj" "Orphaned Directories")" = "WARNING" ] &&
  [[ "$oh" == *"Orphaned Directories"* ]] &&
  [[ "$oh" == *".claude/skills (local folder exists, but ~/.claude config directory does not exist)"* ]]; then
  echo "ok 7 - [Orphaned] doctor flags orphaned local directories"
else
  echo "not ok 7 - [Orphaned] doctor did not report orphaned directories: $oh"
fi
cd "$TMPDIR"

# Test 8: doctor separates a VCS-tracked broken link from a stray one.
MIXED_DANGLING_DIR="${TMPDIR}/mixed-dangling"
mkdir -p "$MIXED_DANGLING_DIR"
cd "$MIXED_DANGLING_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
ln -s /nonexistent/stray-target .claude/skills/stray-broken
ln -s /nonexistent/tracked-target .claude/skills/tracked-broken
git add .claude/skills/tracked-broken
xj=$(doctor_json)
xh=$("${SCRIPT}" doctor 2>&1) || true
if [ "$(check_status "$xj" "Symlink Health")" = "ERROR" ] &&
  [ "$(json_get "$xj" '[l["name"] for l in d["links"] if l["broken"] and not l["tracked"]]')" = "stray-broken" ] &&
  [ "$(json_get "$xj" '[l["name"] for l in d["links"] if l["tracked"]]')" = "tracked-broken" ] &&
  [[ "$xh" == *"Broken links tracked by version control:"* ]] &&
  [[ "$xh" == *"'skill' never removes a tracked link"* ]]; then
  echo "ok 8 - [Symlink Health] doctor separates tracked from stray broken links"
else
  echo "not ok 8 - [Symlink Health] tracked/stray split wrong: $xh"
fi
cd "$TMPDIR"

# Test 9: a link live in one destination and broken in another is counted once
# as broken.
MIX_DIR="${TMPDIR}/mix-dest-test"
mkdir -p "${MIX_DIR}/real-skill"
printf -- '---\nname: mix-skill\n---\nbody\n' >"${MIX_DIR}/real-skill/SKILL.md"
cd "$MIX_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
ln -s "${MIX_DIR}/real-skill" .claude/skills/mix-skill
ln -s "${MIX_DIR}/deleted-skill" .agents/skills/mix-skill
dj=$(doctor_json)
if [ "$(json_get "$dj" 'len([l for l in d["links"] if l["broken"]])')" = "1" ] &&
  [ "$(json_get "$dj" 'd["healthy"]')" = "false" ]; then
  echo "ok 9 - [Symlink Health] cross-destination live and broken links are not double-counted"
else
  echo "not ok 9 - [Symlink Health] expected 1 broken link, got: $dj"
fi
cd "$TMPDIR"

# Test 10: doctor flags exclude-block drift, and any add or remove rewrites it.
DRIFT_DIR="${TMPDIR}/drift"
mkdir -p "$DRIFT_DIR"
cd "$DRIFT_DIR"
git init -q
"${SCRIPT}" add coding-standards >/dev/null 2>&1
printf '# unrelated\n' >.git/info/exclude
drift_json=$(doctor_json)
drift_h=$("${SCRIPT}" doctor 2>&1) || true
"${SCRIPT}" add emumanager >/dev/null 2>&1
fixed_json=$(doctor_json)
if [ "$(check_status "$drift_json" "Workspace Exclusions")" = "ERROR" ] &&
  [[ "$drift_h" == *"skill add"* ]] &&
  [ "$(json_get "$fixed_json" 'd["healthy"]')" = "true" ] &&
  [ -z "$(git status --porcelain)" ]; then
  echo "ok 10 - [Exclusions] doctor flags exclude drift; the next add rewrites it"
else
  echo "not ok 10 - [Exclusions] drift not flagged or not repaired: $drift_h"
fi
cd "$TMPDIR"

# Test 11: plugin-provided local path skill passes Catalog Cache check without
# requiring a stub in ~/.cache/skill/catalog.
PLUGIN_PATH_DIR="${TMPDIR}/plugin-path-test"
mkdir -p "${PLUGIN_PATH_DIR}/custom-plugin-skill"
printf -- '---\nname: custom-plugin-skill\ndescription: Plugin skill\n---\nbody\n' \
  >"${PLUGIN_PATH_DIR}/custom-plugin-skill/SKILL.md"

cat <<EOF >"${XDG_CONFIG_HOME}/skill/plugins/99_test_path.py"
def register(api):
    api.register_skill(
        "jetski:custom-plugin-skill",
        {"path": "${PLUGIN_PATH_DIR}/custom-plugin-skill"}
    )
EOF

cd "$PLUGIN_PATH_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
pj=$(doctor_json)
if [ "$(check_status "$pj" "Plugin Local Paths")" = "OK" ] &&
  [ "$(check_status "$pj" "Catalog Cache")" = "OK" ] &&
  [ "$(json_get "$pj" 'd["healthy"]')" = "true" ]; then
  echo "ok 11 - [Catalog Cache] plugin-provided local path skill does not require catalog stub"
else
  echo "not ok 11 - [Catalog Cache] plugin path skill reported catalog error: $pj"
fi
rm -f "${XDG_CONFIG_HOME}/skill/plugins/99_test_path.py"
cd "$TMPDIR"

# Test 12: Catalog Cache distinguishes missing remote stubs from missing plugin
# local paths.
REMOTE_PLUGIN_DIR="${TMPDIR}/catalog-remote-test"
mkdir -p "$REMOTE_PLUGIN_DIR"

cat <<EOF >"${XDG_CONFIG_HOME}/skill/plugins/99_test_catalog.py"
def register(api):
    api.register_skill(
        "remote:test-missing-stub",
        {"repo": "owner/missing-repo", "ref": "main"}
    )
    api.register_skill(
        "jetski:test-missing-path",
        {"path": "${REMOTE_PLUGIN_DIR}/nonexistent-path"}
    )
EOF

cd "$REMOTE_PLUGIN_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
rj=$(doctor_json)
if [ "$(check_status "$rj" "Catalog Cache")" = "ERROR" ] &&
  [ "$(check_status "$rj" "Plugin Local Paths")" = "ERROR" ]; then
  echo "ok 12 - [Catalog Cache] correctly separates remote catalog stubs from local plugin paths"
else
  echo "not ok 12 - [Catalog Cache] failed to distinguish remote stubs from local paths: $rj"
fi
rm -f "${XDG_CONFIG_HOME}/skill/plugins/99_test_catalog.py"
cd "$TMPDIR"

# Test 13: a virtual resolve: False skill keeps its literal path in both user
# symlinks and workspace copies (metadata.source) and is healthy.
VIRT_SNAP_DIR="${TMPDIR}/virt-snap-test"
mkdir -p "${VIRT_SNAP_DIR}/vfs/real/virt-skill"
ln -s "${VIRT_SNAP_DIR}/vfs/real" "${VIRT_SNAP_DIR}/vfs/head"
printf -- '---\nname: virt-skill\ndescription: Virtual Skill\n---\nbody\n' \
  >"${VIRT_SNAP_DIR}/vfs/real/virt-skill/SKILL.md"

cat <<EOF >"${XDG_CONFIG_HOME}/skill/plugins/99_test_virt_snap.py"
def register(api):
    api.register_skill(
        "virt:virt-skill",
        {"path": "${VIRT_SNAP_DIR}/vfs/head/virt-skill", "resolve": False}
    )
EOF

cd "$VIRT_SNAP_DIR"
git init -q
"${SCRIPT}" --scope user add virt-skill >/dev/null 2>&1
"${SCRIPT}" add virt-skill >/dev/null 2>&1
vj=$(doctor_json)
if [ "$(readlink "${HOME}/.claude/skills/virt-skill")" = "${VIRT_SNAP_DIR}/vfs/head/virt-skill" ] &&
  grep -q "source: \"${VIRT_SNAP_DIR}/vfs/head/virt-skill\"" .claude/skills/virt-skill/SKILL.md &&
  [ "$(json_get "$vj" 'd["healthy"]')" = "true" ]; then
  echo "ok 13 - [Plugins] a resolve: False skill keeps its literal path in links and copies"
else
  echo "not ok 13 - [Plugins] virtual target mishandled: $vj"
fi
"${SCRIPT}" --scope user clean >/dev/null 2>&1 || true
rm -f "${XDG_CONFIG_HOME}/skill/plugins/99_test_virt_snap.py"
cd "$TMPDIR"

# Test 14: a failing doctor names the failing check with a [FAIL] tag.
FAIL_DIR="${TMPDIR}/doctor-fail"
mkdir -p "$FAIL_DIR"
cd "$FAIL_DIR"
git init -q
mkdir -p .claude/skills
printf 'x' >.claude/skills/junk
if fout=$("${SCRIPT}" doctor 2>&1); then
  echo "not ok 14 - [Doctor UI] doctor succeeded unexpectedly in unhealthy workspace"
elif [[ "$fout" == *"[FAIL] Directory Cleanliness:"* ]] &&
  [[ "$fout" == *"To resolve:"* ]]; then
  echo "ok 14 - [Doctor UI] failure names the failing check and its fix"
else
  echo "not ok 14 - [Doctor UI] failure report wrong: $fout"
fi
cd "$TMPDIR"

# Test 15: Symlink Health flags a copy whose metadata.source directory has
# vanished, leaving the copy intact (read-only) and naming 'skill remove'.
GONE_SRC="${TMPDIR}/ephemeral-src/temp-skill"
GONE_WS="${TMPDIR}/copy-missing-src"
mkdir -p "$GONE_SRC" "$GONE_WS"
printf -- '---\nname: temp-skill\n---\nbody\n' >"${GONE_SRC}/SKILL.md"
cd "$GONE_WS"
git init -q
"${SCRIPT}" add "$GONE_SRC" >/dev/null 2>&1
rm -rf "${TMPDIR}/ephemeral-src"
gj=$(doctor_json)
gh=$("${SCRIPT}" doctor 2>&1) || true
if [ "$(check_status "$gj" "Symlink Health")" = "WARNING" ] &&
  [ "$(json_get "$gj" 'd["healthy"]')" = "false" ] &&
  [ "$(json_get "$gj" 'all(l["broken"] for l in d["links"])')" = "true" ] &&
  [[ "$gh" == *"skill remove temp-skill"* ]] &&
  [ -f .agents/skills/temp-skill/SKILL.md ]; then
  echo "ok 15 - [Symlink Health] doctor flags copies with missing metadata.source and keeps them"
else
  echo "not ok 15 - [Symlink Health] missing source check failed: $gh / $gj"
fi
cd "$TMPDIR"

# Test 16: inject_copy_source normalizes block and flow mappings to canonical
# block metadata without duplicate keys, and read_copy_source ignores URLs.
if yaml_out=$(run_module "
from pathlib import Path
src = '/tmp/my:skill #1/dir'
cases = [
    '# Plain body\n',
    '---\nname: a\ndescription: >-\n  hello\n---\nbody\n',
    '---\nname: b\nmetadata:\n  version: \"1\"\n  author: me\ncompatibility: py\n---\nbody\n',
    '---\nname: c\nmetadata:\n  source: \"/old\"\n  version: \"2\"\n---\nbody\n',
    '---\nname: d\nmetadata: {version: \'1\', author: \"x\"}\n---\nbody\n',
    '---\nname: e\nmetadata: {}\n---\nbody\n',
    '---\nname: f\nmetadata: {source: \"/old\", version: \"3\"}\n---\nbody\n',
    '---\nname: g\nmetadata: {\n  version: \"4\"\n}\n---\nbody\n',
    '---\nname: h\ndescription: |\n  line1\n  ---\n  ...\n  line2\nmetadata:\n  note: >-\n    multiline continuation\n  source: \"/old\"\n  version: \"5\"\n---\nbody\n',
    '---\nname: i\nmetadata: {\n  # leading comment\n  tpl: \"${HOME}\", # inline comment\n  tags: [a, b],\n  source: \"/old\"\n}\n---\nbody\n',
]
for idx, raw in enumerate(cases):
    out = m.inject_copy_source(raw, src)
    got = m.read_copy_source_from_content(out)
    assert got == src, f'case {idx} got {got!r} from:\n{out}'
    fm = out.split('\n---\n', 1)[0]
    meta_keys = [
        l for l in fm.splitlines()
        if not l.startswith((' ', '\t')) and l.lstrip().startswith('metadata:')
    ]
    assert len(meta_keys) == 1, f'case {idx} duplicate metadata keys:\n{out}'

body_trap = '---\nname: trap\n---\nmetadata:\n  source: \"/should/ignore\"\n'
assert m.read_copy_source_from_content(body_trap) is None

url_dir = Path('${TMPDIR}/url-meta-skill')
url_dir.mkdir(parents=True, exist_ok=True)
(url_dir / 'SKILL.md').write_text('---\nname: u\nmetadata:\n  source: \"https://example.com\"\n---\n')
assert m.read_copy_source(url_dir) is None
print('OK')
" 2>&1) && [ "$yaml_out" = "OK" ]; then
  echo "ok 16 - [YAML] metadata.source normalizes block/flow mappings cleanly and ignores non-paths"
else
  echo "not ok 16 - [YAML] metadata.source helper failed: ${yaml_out:-}"
fi

# Test 17: a VCS-tracked skill in .claude/skills/<name> (even with metadata.source)
# sharing a name with an untracked copy in .agents/skills/<name> is never flagged
# or overwritten by doctor / update.
MIXED_WS="${TMPDIR}/mixed-tracked-ws"
mkdir -p "${MIXED_WS}/.claude/skills/emumanager"
git -C "$MIXED_WS" init -q
git -C "$MIXED_WS" config user.email "t@e.st"
git -C "$MIXED_WS" config user.name "Test"
printf -- '---\nname: emumanager\nmetadata:\n  source: "/committed/origin"\n---\ncommitted body\n' \
  >"${MIXED_WS}/.claude/skills/emumanager/SKILL.md"
git -C "$MIXED_WS" add .claude/skills/emumanager/SKILL.md
git -C "$MIXED_WS" commit -q -m "commit claude skill"
mkdir -p "${MIXED_WS}/.agents/skills"
cp -r "${SKILL_SOURCE_DIRS}/emumanager" "${MIXED_WS}/.agents/skills/emumanager"
printf -- '---\nname: emumanager\nmetadata:\n  source: "%s"\n---\nstale copy\n' \
  "${SKILL_SOURCE_DIRS}/emumanager" >"${MIXED_WS}/.agents/skills/emumanager/SKILL.md"
"${SCRIPT}" -C "$MIXED_WS" update emumanager >/dev/null 2>&1
"${SCRIPT}" -C "$MIXED_WS" add coding-standards >/dev/null 2>&1
mixed_doc=$("${SCRIPT}" -C "$MIXED_WS" doctor --json 2>/dev/null || true)
if grep -q "committed body" "${MIXED_WS}/.claude/skills/emumanager/SKILL.md" &&
  ! grep -q "stale copy" "${MIXED_WS}/.agents/skills/emumanager/SKILL.md" &&
  [ "$(json_get "$mixed_doc" 'd["healthy"]')" = "true" ]; then
  echo "ok 17 - [Tracked] sibling VCS-tracked skill is preserved during doctor and update"
else
  echo "not ok 17 - [Tracked] sibling VCS-tracked skill was clobbered or flagged: $mixed_doc"
fi

# Test 18: subpath-aliased remote skills refresh by folder name and in
# '--scope user update --all', and path-installed copies sharing a catalog
# basename refresh from their own metadata.source without fetching remote.
ALIAS_UPSTREAM="${TMPDIR}/alias-upstream"
mkdir -p "${ALIAS_UPSTREAM}/skills/aliased-folder" "${TMPDIR}/adhoc-src/aliased-folder"
git -C "$ALIAS_UPSTREAM" init -q -b main
git -C "$ALIAS_UPSTREAM" config user.email "t@e.st"
git -C "$ALIAS_UPSTREAM" config user.name "Test"
printf -- '---\nname: aliased-folder\ndescription: v1\n---\nv1\n' \
  >"${ALIAS_UPSTREAM}/skills/aliased-folder/SKILL.md"
git -C "$ALIAS_UPSTREAM" add .
git -C "$ALIAS_UPSTREAM" commit -q -m "v1"
mkdir -p "${XDG_CONFIG_HOME}/skill/plugins" "${HOME}/.claude"
cat <<'EOF' >"${XDG_CONFIG_HOME}/skill/plugins/98_alias_remote.py"
def register(api):
    api.register_skill(
        "remote:pkg-key-name",
        {"repo": "owner/repo", "ref": "main", "subpath": "skills/aliased-folder"},
    )
    api.register_skill(
        "remote:aliased-folder",
        {"repo": "missing/offline-repo", "ref": "main"},
    )
EOF
ALIAS_WS="${TMPDIR}/alias-ws"
ADHOC_WS="${TMPDIR}/adhoc-ws"
REAL_CACHE="${TMPDIR}/real-cache-store"
SYM_CACHE="${TMPDIR}/sym-cache-link"
mkdir -p "$ALIAS_WS" "$ADHOC_WS" "$REAL_CACHE"
ln -s "$REAL_CACHE" "$SYM_CACHE"
git -C "$ALIAS_WS" init -q
git -C "$ADHOC_WS" init -q
SKILL_CACHE_DIR="$SYM_CACHE" _SKILL_TEST_REMOTE="$ALIAS_UPSTREAM" "${SCRIPT}" -C "$ALIAS_WS" add remote:pkg-key-name >/dev/null 2>&1
SKILL_CACHE_DIR="$SYM_CACHE" _SKILL_TEST_REMOTE="$ALIAS_UPSTREAM" "${SCRIPT}" --scope user add remote:pkg-key-name >/dev/null 2>&1
printf -- '---\nname: aliased-folder\ndescription: v2\n---\nv2\n' \
  >"${ALIAS_UPSTREAM}/skills/aliased-folder/SKILL.md"
git -C "$ALIAS_UPSTREAM" commit -q -am "v2"
SKILL_CACHE_DIR="$SYM_CACHE" _SKILL_TEST_REMOTE="$ALIAS_UPSTREAM" "${SCRIPT}" -C "$ALIAS_WS" update aliased-folder >/dev/null 2>&1
printf -- '---\nname: aliased-folder\ndescription: v3\n---\nv3\n' \
  >"${ALIAS_UPSTREAM}/skills/aliased-folder/SKILL.md"
git -C "$ALIAS_UPSTREAM" commit -q -am "v3"
rm -f "${XDG_CONFIG_HOME}/skill/plugins/98_alias_remote.py"
cat <<'EOF' >"${XDG_CONFIG_HOME}/skill/plugins/98_alias_remote.py"
def register(api):
    api.register_skill(
        "remote:pkg-key-name",
        {"repo": "owner/repo", "ref": "main", "subpath": "skills/aliased-folder"},
    )
EOF
SKILL_CACHE_DIR="$SYM_CACHE" _SKILL_TEST_REMOTE="$ALIAS_UPSTREAM" "${SCRIPT}" --scope user update --all >/dev/null 2>&1
printf -- '---\nname: aliased-folder\n---\nlocal-v1\n' >"${TMPDIR}/adhoc-src/aliased-folder/SKILL.md"
"${SCRIPT}" -C "$ADHOC_WS" add "${TMPDIR}/adhoc-src/aliased-folder" >/dev/null 2>&1
printf -- '---\nname: aliased-folder\n---\nlocal-v2\n' >"${TMPDIR}/adhoc-src/aliased-folder/SKILL.md"
cat <<'EOF' >>"${XDG_CONFIG_HOME}/skill/plugins/98_alias_remote.py"
    api.register_skill(
        "remote:aliased-folder",
        {"repo": "missing/offline-repo", "ref": "main"},
    )
EOF
AGENT_OFFLINE=1 "${SCRIPT}" -C "$ADHOC_WS" update aliased-folder >/dev/null 2>&1
if grep -q "^v2$" "${ALIAS_WS}/.agents/skills/aliased-folder/SKILL.md" &&
  grep -q "^v3$" "${HOME}/.claude/skills/aliased-folder/SKILL.md" &&
  grep -q "^local-v2$" "${ADHOC_WS}/.agents/skills/aliased-folder/SKILL.md"; then
  echo "ok 18 - [Update] refreshes aliased remote copies, user --all, and path copies colliding with catalog names"
else
  echo "not ok 18 - [Update] subpath-aliased, user --all, or path copy update failed"
fi

# Test 19: add --prune skips removals when a requested spec fails to resolve.
PRUNE_SAFE_WS="${TMPDIR}/prune-safe-ws"
mkdir -p "$PRUNE_SAFE_WS"
git -C "$PRUNE_SAFE_WS" init -q
"${SCRIPT}" -C "$PRUNE_SAFE_WS" add coding-standards emumanager >/dev/null 2>&1
prune_err_rc=0
"${SCRIPT}" -C "$PRUNE_SAFE_WS" add --prune coding-standards nonexistent-typo >/dev/null 2>&1 || prune_err_rc=$?
if [ "$prune_err_rc" -ne 0 ] &&
  [ -d "${PRUNE_SAFE_WS}/.agents/skills/emumanager" ]; then
