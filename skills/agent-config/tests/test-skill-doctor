#!/usr/bin/env bash
#
# `skill doctor` diagnostics and remediation output.
#
# doctor checks link health only: broken links, unmanaged files, and that the
# exclude block matches the links. There is no expected skill set to compare
# against. Detection assertions read the structured `skill doctor --json`
# surface; the remediation hints are a user-facing formatting contract, so they
# are checked against the human-readable report on purpose.

set -euo pipefail

# shellcheck source=skills/agent-config/tests/common.sh disable=SC1091
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
skill_test_init

echo "1..14"

# Test 1: doctor on a healthy workspace reports healthy JSON and renders the
# canonical [PASS] tag style (the tag format is a user-facing contract).
UI_DIR="${TMPDIR}/ui"
mkdir -p "$UI_DIR"
cd "$UI_DIR"
git init -q
"${SCRIPT}" add coding-standards >/dev/null 2>&1
healthy_json=$(doctor_json)
if [ "$(json_get "$healthy_json" 'd["healthy"]')" = "true" ] &&
  [ "$(check_status "$healthy_json" "Installed Skills")" = "OK" ] &&
  [ "$(json_get "$healthy_json" '[l["origin"] for l in d["links"]]')" = "added added" ] &&
  human=$("${SCRIPT}" doctor 2>&1) &&
  [[ "$human" == *"[PASS] Workspace:"* ]] &&
  [[ "$human" == *"[PASS] Installed Skills: 1 skill(s) linked (0 default, 1 added)"* ]]; then
  echo "ok 1 - [Doctor] healthy workspace is healthy in JSON and renders [PASS] tags"
else
  echo "not ok 1 - [Doctor] healthy report wrong: $healthy_json"
fi

# Test 2: there is no expected set -- a workspace with no skills at all is
# healthy, and doctor takes no skill arguments.
cd "$TMPDIR"
EMPTY_DIR="${TMPDIR}/empty"
mkdir -p "$EMPTY_DIR"
cd "$EMPTY_DIR"
git init -q
ej=$(doctor_json)
args_rc=0
"${SCRIPT}" doctor coding-standards >/dev/null 2>&1 || args_rc=$?
if [ "$(json_get "$ej" 'd["healthy"]')" = "true" ] && [ "$args_rc" -eq 2 ]; then
  echo "ok 2 - [Doctor] an empty workspace is healthy; skill arguments are a usage error"
else
  echo "not ok 2 - [Doctor] empty workspace or argument handling wrong (rc=$args_rc): $ej"
fi
cd "$TMPDIR"

# Test 3: doctor flags broken links and does not remove them (doctor is
# read-only). A broken link to a default is an error whose fix is 'add
# --defaults'; one added by name is a warning whose fix is 'skill remove', as
# its source may only be unreachable for now.
DANGLING_DIR="${TMPDIR}/dangling"
mkdir -p "$DANGLING_DIR"
cd "$DANGLING_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
ln -s /nonexistent/target .claude/skills/broken
aj=$(doctor_json)
ah=$("${SCRIPT}" doctor 2>&1) || true
ln -s "${XDG_STATE_HOME}/skill/defaults/demoted" .claude/skills/demoted
dj=$(doctor_json)
dh=$("${SCRIPT}" doctor 2>&1) || true
if [ "$(check_status "$aj" "Symlink Health")" = "WARNING" ] &&
  [ "$(json_get "$aj" 'd["healthy"]')" = "false" ] &&
  [[ "$ah" == *"skill remove broken"* ]] &&
  [ "$(check_status "$dj" "Symlink Health")" = "ERROR" ] &&
  [ "$(json_get "$dj" 'sorted(l["path"] for l in d["links"] if l["broken"])')" = ".claude/skills/broken .claude/skills/demoted" ] &&
  [[ "$dh" == *"skill add --defaults"* ]] &&
  [ -L .claude/skills/broken ] && [ -L .claude/skills/demoted ]; then
  echo "ok 3 - [Symlink Health] doctor flags broken links by origin and leaves them in place"
else
  echo "not ok 3 - [Symlink Health] doctor missed or removed a broken link: $ah / $dh"
fi
cd "$TMPDIR"

# Test 4: doctor flags an unmanaged real file in a skills directory.
UNMANAGED_DIR="${TMPDIR}/unmanaged-file"
mkdir -p "$UNMANAGED_DIR"
cd "$UNMANAGED_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
printf 'x' >.claude/skills/stray.txt
uj=$(doctor_json)
if [ "$(check_status "$uj" "Directory Cleanliness")" = "ERROR" ] &&
  [ "$(json_get "$uj" 'd["unmanaged"]')" = ".claude/skills/stray.txt" ]; then
  echo "ok 4 - [Directory Cleanliness] doctor flags an unmanaged file"
else
  echo "not ok 4 - [Directory Cleanliness] doctor missed unmanaged file: $uj"
fi
cd "$TMPDIR"

# Test 5: doctor ignores a tracked real directory (a committed local skill): it
# is healthy and reports nothing unmanaged.
TRACKED_DIR="${TMPDIR}/tracked-skill"
mkdir -p "$TRACKED_DIR"
cd "$TRACKED_DIR"
git init -q
mkdir -p .claude/skills .agents/skills .claude/skills/local-skill
printf 'local' >.claude/skills/local-skill/SKILL.md
git add .claude/skills/local-skill/SKILL.md
tj=$(doctor_json)
if [ "$(json_get "$tj" 'd["healthy"]')" = "true" ] &&
  [ -z "$(json_get "$tj" 'd["unmanaged"]')" ]; then
  echo "ok 5 - [Directory Cleanliness] doctor ignores tracked skill directory"
else
  echo "not ok 5 - [Directory Cleanliness] doctor failed on tracked skill: $tj"
fi

# Test 6: doctor lists VCS-managed skills in its report.
lj=$(doctor_json)
if [ "$(check_status "$lj" "VCS-Managed Skills")" = "OK" ] &&
  [ "$(json_get "$lj" 'next((c["summary"] for c in d["checks"] if c["name"]=="VCS-Managed Skills"), "").startswith("Found 1 skill")')" = "true" ] &&
  [[ "$lj" == *"local-skill"* ]]; then
  echo "ok 6 - [Diagnostics] doctor lists VCS-managed skills"
else
  echo "not ok 6 - [Diagnostics] doctor failed to list VCS-managed skills: $lj"
fi
cd "$TMPDIR"

# Test 7: doctor flags orphaned skill directories (a local skills folder whose
# agent config directory does not exist). The count and reason wording is a
# formatting contract, checked against the human report.
ORPHANED_DIR="${TMPDIR}/orphaned-test"
mkdir -p "$ORPHANED_DIR"
cd "$ORPHANED_DIR"
git init -q
mkdir -p .claude/skills
mv "$MOCK_HOME/.claude" "$MOCK_HOME/.claude-backup"
oj=$(doctor_json)
oh=$("${SCRIPT}" doctor 2>&1) || true
mv "$MOCK_HOME/.claude-backup" "$MOCK_HOME/.claude"
if [ "$(check_status "$oj" "Orphaned Directories")" = "WARNING" ] &&
  [[ "$oh" == *"Orphaned Directories"* ]] &&
  [[ "$oh" == *".claude/skills (local folder exists, but ~/.claude config directory does not exist)"* ]]; then
  echo "ok 7 - [Orphaned] doctor flags orphaned local directories"
else
  echo "not ok 7 - [Orphaned] doctor did not report orphaned directories: $oh"
fi
cd "$TMPDIR"

# Test 8: doctor separates a VCS-tracked broken link (never removed by 'skill')
# from a stray one, and tells the user to fix the tracked one in the repository.
MIXED_DANGLING_DIR="${TMPDIR}/mixed-dangling"
mkdir -p "$MIXED_DANGLING_DIR"
cd "$MIXED_DANGLING_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
ln -s /nonexistent/stray-target .claude/skills/stray-broken
ln -s /nonexistent/tracked-target .claude/skills/tracked-broken
git add .claude/skills/tracked-broken
xj=$(doctor_json)
xh=$("${SCRIPT}" doctor 2>&1) || true
if [ "$(json_get "$xj" '[l["name"] for l in d["links"] if l["broken"] and not l["tracked"]]')" = "stray-broken" ] &&
  [ "$(json_get "$xj" '[l["name"] for l in d["links"] if l["tracked"]]')" = "tracked-broken" ] &&
  [[ "$xh" == *"Broken links tracked by version control:"* ]] &&
  [[ "$xh" == *"'skill' never removes a tracked link"* ]]; then
  echo "ok 8 - [Symlink Health] doctor separates tracked from stray broken links"
else
  echo "not ok 8 - [Symlink Health] tracked/stray split wrong: $xh"
fi
cd "$TMPDIR"

# Test 9: a link live in one destination and broken in another is counted once
# as broken.
MIX_DIR="${TMPDIR}/mix-dest-test"
mkdir -p "${MIX_DIR}/real-skill"
printf -- '---\nname: mix-skill\n---\nbody\n' >"${MIX_DIR}/real-skill/SKILL.md"
cd "$MIX_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
ln -s "${MIX_DIR}/real-skill" .claude/skills/mix-skill
ln -s "${MIX_DIR}/deleted-skill" .agents/skills/mix-skill
dj=$(doctor_json)
if [ "$(json_get "$dj" 'len([l for l in d["links"] if l["broken"]])')" = "1" ] &&
  [ "$(json_get "$dj" 'd["healthy"]')" = "false" ]; then
  echo "ok 9 - [Symlink Health] cross-destination live and broken links are not double-counted"
else
  echo "not ok 9 - [Symlink Health] expected 1 broken link, got: $dj"
fi
cd "$TMPDIR"

# Test 10: doctor flags exclude-block drift, and any add or remove rewrites it.
DRIFT_DIR="${TMPDIR}/drift"
mkdir -p "$DRIFT_DIR"
cd "$DRIFT_DIR"
git init -q
"${SCRIPT}" add coding-standards >/dev/null 2>&1
printf '# unrelated\n' >.git/info/exclude
drift_json=$(doctor_json)
drift_h=$("${SCRIPT}" doctor 2>&1) || true
"${SCRIPT}" add emumanager >/dev/null 2>&1
fixed_json=$(doctor_json)
if [ "$(check_status "$drift_json" "Workspace Exclusions")" = "ERROR" ] &&
  [[ "$drift_h" == *"skill add --defaults"* ]] &&
  [ "$(json_get "$fixed_json" 'd["healthy"]')" = "true" ] &&
  [ -z "$(git status --porcelain)" ]; then
  echo "ok 10 - [Exclusions] doctor flags exclude drift; the next add rewrites it"
else
  echo "not ok 10 - [Exclusions] drift not flagged or not repaired: $drift_h"
fi
cd "$TMPDIR"

# Test 11: plugin-provided local path skill passes Catalog Cache check without
# requiring a stub in ~/.cache/skill/catalog.
PLUGIN_PATH_DIR="${TMPDIR}/plugin-path-test"
mkdir -p "${PLUGIN_PATH_DIR}/custom-plugin-skill"
printf -- '---\nname: custom-plugin-skill\ndescription: Plugin skill\n---\nbody\n' \
  >"${PLUGIN_PATH_DIR}/custom-plugin-skill/SKILL.md"

cat <<EOF >"${XDG_CONFIG_HOME}/skill/plugins/99_test_path.py"
def register(api):
    api.register_skill(
        "jetski:custom-plugin-skill",
        {"path": "${PLUGIN_PATH_DIR}/custom-plugin-skill"}
    )
EOF

cd "$PLUGIN_PATH_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
pj=$(doctor_json)
if [ "$(check_status "$pj" "Plugin Local Paths")" = "OK" ] &&
  [ "$(check_status "$pj" "Catalog Cache")" = "OK" ] &&
  [ "$(json_get "$pj" 'd["healthy"]')" = "true" ]; then
  echo "ok 11 - [Catalog Cache] plugin-provided local path skill does not require catalog stub"
else
  echo "not ok 11 - [Catalog Cache] plugin path skill reported catalog error: $pj"
fi
rm -f "${XDG_CONFIG_HOME}/skill/plugins/99_test_path.py"
cd "$TMPDIR"

# Test 12: Catalog Cache distinguishes missing remote stubs from missing plugin
# local paths.
REMOTE_PLUGIN_DIR="${TMPDIR}/catalog-remote-test"
mkdir -p "$REMOTE_PLUGIN_DIR"

cat <<EOF >"${XDG_CONFIG_HOME}/skill/plugins/99_test_catalog.py"
def register(api):
    api.register_skill(
        "remote:test-missing-stub",
        {"repo": "owner/missing-repo", "ref": "main"}
    )
    api.register_skill(
        "jetski:test-missing-path",
        {"path": "${REMOTE_PLUGIN_DIR}/nonexistent-path"}
    )
EOF

cd "$REMOTE_PLUGIN_DIR"
git init -q
mkdir -p .claude/skills .agents/skills
rj=$(doctor_json)
if [ "$(check_status "$rj" "Catalog Cache")" = "ERROR" ] &&
  [ "$(check_status "$rj" "Plugin Local Paths")" = "ERROR" ]; then
  echo "ok 12 - [Catalog Cache] correctly separates remote catalog stubs from local plugin paths"
else
  echo "not ok 12 - [Catalog Cache] failed to distinguish remote stubs from local paths: $rj"
fi
rm -f "${XDG_CONFIG_HOME}/skill/plugins/99_test_catalog.py"
cd "$TMPDIR"

# Test 13: a virtual resolve: False skill is linked to its literal path and is
# healthy (the link is never realpath'd).
VIRT_SNAP_DIR="${TMPDIR}/virt-snap-test"
mkdir -p "${VIRT_SNAP_DIR}/vfs/real/virt-skill"
ln -s "${VIRT_SNAP_DIR}/vfs/real" "${VIRT_SNAP_DIR}/vfs/head"
printf -- '---\nname: virt-skill\ndescription: Virtual Skill\n---\nbody\n' \
  >"${VIRT_SNAP_DIR}/vfs/real/virt-skill/SKILL.md"

cat <<EOF >"${XDG_CONFIG_HOME}/skill/plugins/99_test_virt_snap.py"
def register(api):
    api.register_skill(
        "virt:virt-skill",
        {"path": "${VIRT_SNAP_DIR}/vfs/head/virt-skill", "resolve": False}
    )
EOF

cd "$VIRT_SNAP_DIR"
git init -q
"${SCRIPT}" add virt-skill >/dev/null 2>&1
vj=$(doctor_json)
if [ "$(readlink .claude/skills/virt-skill)" = "${VIRT_SNAP_DIR}/vfs/head/virt-skill" ] &&
  [ "$(json_get "$vj" 'd["healthy"]')" = "true" ]; then
  echo "ok 13 - [Plugins] a resolve: False skill keeps its literal path and is healthy"
else
  echo "not ok 13 - [Plugins] virtual target mishandled: $vj"
fi
rm -f "${XDG_CONFIG_HOME}/skill/plugins/99_test_virt_snap.py"
cd "$TMPDIR"

# Test 14: a failing doctor names the failing check with a [FAIL] tag.
FAIL_DIR="${TMPDIR}/doctor-fail"
mkdir -p "$FAIL_DIR"
cd "$FAIL_DIR"
git init -q
mkdir -p .claude/skills
printf 'x' >.claude/skills/junk
if fout=$("${SCRIPT}" doctor 2>&1); then
  echo "not ok 14 - [Doctor UI] doctor succeeded unexpectedly in unhealthy workspace"
elif [[ "$fout" == *"[FAIL] Directory Cleanliness:"* ]] &&
  [[ "$fout" == *"To resolve:"* ]]; then
  echo "ok 14 - [Doctor UI] failure names the failing check and its fix"
else
  echo "not ok 14 - [Doctor UI] failure report wrong: $fout"
fi
cd "$TMPDIR"
