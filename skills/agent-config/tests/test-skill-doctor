yaml_ok=$(run_module "
raw1 = open('${FLOW_WS}/.agents/skills/tricky-skill/SKILL.md').read()
fm1 = raw1.split('---', 2)[1]
raw2 = open('${FLOW_WS}/.agents/skills/unclosed-skill/SKILL.md').read()
fm2 = raw2.split('---', 2)[1]
raw3 = open('${FLOW_WS}/.agents/skills/gog-like/SKILL.md').read()
fm3 = raw3.split('---', 2)[1]
raw4 = open('${FLOW_WS}/.agents/skills/scalar-meta/SKILL.md').read()
fm4 = raw4.split('---', 2)[1]
lines1 = set(fm1.splitlines())
ok = (
    '  \"app:id\": \"foo:bar\"' in lines1
    and '  \"@scope/pkg\": \"a  b\"' in lines1
    and '  \"k #1\": \"v\"' in lines1
    and '  \"true\": \"1\"' in lines1
    and 'description: keep-desc' in lines1
    and m.read_copy_source_from_content(raw1) == '${FLOW_TRICKY_SRC}'
    and 'description: survived-unclosed' in set(fm2.splitlines())
    and m.read_copy_source_from_content(raw2) == '${UNCLOSED_SRC}'
    and 'description: kept-after-indented-flow' in set(fm3.splitlines())
    and m.read_copy_source_from_content(raw3) == '${INDENTED_FLOW_SRC}'
    and 'description: kept-after-scalar' in set(fm4.splitlines())
    and m.read_copy_source_from_content(raw4) == '${SCALAR_META_SRC}'
)
try:
    import yaml
    d1 = yaml.safe_load(fm1)
    d2 = yaml.safe_load(fm2)
    d3 = yaml.safe_load(fm3)
    d4 = yaml.safe_load(fm4)
    md = d1['metadata']
    ok = ok and (
        md.get('app:id') == 'foo:bar'
        and md.get('@scope/pkg') == 'a  b'
        and md.get('k #1') == 'v'
        and md.get('true') == '1'
        and 'true' in md and True not in md
        and md.get('source') == '${FLOW_TRICKY_SRC}'
        and d1.get('description') == 'keep-desc'
        and d2.get('description') == 'survived-unclosed'
        and d3['metadata']['openclaw']['label'] == 'Install  gog'
        and d3['metadata']['source'] == '${INDENTED_FLOW_SRC}'
        and d4['metadata'] == {'source': '${SCALAR_META_SRC}'}
    )
except ImportError:
    pass
print(ok)
")
if [[ "$yaml_ok" == "True" ]] && [ "$vfs_kept_v1" -eq 1 ] && [ "$vfs_got_v2" -eq 1 ]; then
  echo "ok 22 - [YAML/Update] preserves quoted flow keys/colons/spaces, isolates unclosed braces, and tracks resolve: False paths generically"
else
  echo "not ok 22 - [YAML/Update] flow metadata or generic resolve: False check failed (yaml_ok=$yaml_ok v1=$vfs_kept_v1 v2=$vfs_got_v2)"
fi
