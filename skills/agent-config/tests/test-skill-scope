#!/usr/bin/env bash
#
# Install scopes for `skill` ('--scope user|workspace|session').
#
# Covers session copies under Claude (AGENT_SESSION_DIR, bound to the session
# ID) and under Antigravity/Jetski (brain/<id>, found from the directory or the
# conversation ID), the refusals for unbound and nested sessions, and user-scope
# symlinks.

set -euo pipefail

# shellcheck source=skills/agent-config/tests/common.sh disable=SC1091
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
skill_test_init

echo "1..18"

mkdir -p "${SKILL_SOURCE_DIRS}/coding-standards/scripts"
printf '#!/bin/sh\necho ok\n' >"${SKILL_SOURCE_DIRS}/coding-standards/scripts/lint"
chmod +x "${SKILL_SOURCE_DIRS}/coding-standards/scripts/lint"

# ==============================================================================
# Claude session scope (copies)
# ==============================================================================
SESSION_DIR="${TMPDIR}/claude-session"
REPO_DIR="${TMPDIR}/repo"
mkdir -p "$SESSION_DIR" "$REPO_DIR"
git -C "$REPO_DIR" init -q
cd "$REPO_DIR"
export AGENT_SESSION_DIR="$SESSION_DIR" AGENT_SESSION_ID=sess-1 \
  CLAUDE_CODE_SESSION_ID=sess-1

# Test 1: session add copies into $AGENT_SESSION_DIR/.claude/skills only
if "${SCRIPT}" --scope session add coding-standards emumanager >/dev/null 2>&1 &&
  [ -d "${SESSION_DIR}/.claude/skills/coding-standards" ] &&
  [ ! -L "${SESSION_DIR}/.claude/skills/coding-standards" ] &&
  [ -x "${SESSION_DIR}/.claude/skills/coding-standards/scripts/lint" ] &&
  [ -d "${SESSION_DIR}/.claude/skills/emumanager" ] &&
  [ ! -L "${SESSION_DIR}/.claude/skills/emumanager" ] &&
  [ ! -e "${SESSION_DIR}/.agents" ] &&
  [ ! -e "${REPO_DIR}/.claude" ] && [ ! -e "${REPO_DIR}/.agents" ]; then
  echo "ok 1 - [Session] add copies into the session's .claude/skills and nowhere else"
else
  echo "not ok 1 - [Session] add did not copy into the session directory only"
fi

# Test 2: session list --json and doctor see the session's copies
if out=$("${SKILL_CMD[@]}" --scope session list --json 2>/dev/null) &&
  [ "$(json_get "$out" 'sorted(s["name"] for s in d)')" = "coding-standards emumanager" ] &&
  dj=$("${SKILL_CMD[@]}" --scope session doctor --json 2>/dev/null) &&
  [ "$(json_gets "$dj" \
    'next(c["status"] for c in d["checks"] if c["name"]=="Workspace")' \
    'next(c["status"] for c in d["checks"] if c["name"]=="Installed Skills")' \
    'next(c["status"] for c in d["checks"] if c["name"]=="Symlink Health")')" = $'OK\nOK\nOK' ]; then
  echo "ok 2 - [Session] list and doctor report the session's copies"
else
  echo "not ok 2 - [Session] list or doctor disagreed: ${out:-}"
fi

# Test 3: without --scope, add still targets the workspace inside a session
if "${SKILL_CMD[@]}" add test-skill >/dev/null 2>&1 &&
  [ -d "${REPO_DIR}/.claude/skills/test-skill" ] &&
  [ ! -L "${REPO_DIR}/.claude/skills/test-skill" ] &&
  [ ! -e "${SESSION_DIR}/.claude/skills/test-skill" ]; then
  echo "ok 3 - [Session] a plain add targets the workspace, not the session"
else
  echo "not ok 3 - [Session] a plain add leaked into the session directory"
fi
"${SKILL_CMD[@]}" clean >/dev/null 2>&1 || true

# Test 4: session remove and clean only touch the session directory
if "${SKILL_CMD[@]}" --scope session remove emumanager >/dev/null 2>&1 &&
  [ ! -e "${SESSION_DIR}/.claude/skills/emumanager" ] &&
  [ -d "${SESSION_DIR}/.claude/skills/coding-standards" ] &&
  "${SKILL_CMD[@]}" --scope session clean >/dev/null 2>&1 &&
  [ ! -e "${SESSION_DIR}/.claude" ] && [ -d "$SESSION_DIR" ]; then
  echo "ok 4 - [Session] remove and clean empty the session directory"
else
  echo "not ok 4 - [Session] remove or clean failed"
fi

# Test 5: a nested agent with its own Claude session ID is refused
nested_rc=0
nested_err=$(CLAUDE_CODE_SESSION_ID=sess-2 "${SKILL_CMD[@]}" --scope session add emumanager 2>&1) || nested_rc=$?
if [ "$nested_rc" -eq 1 ] && [[ "$nested_err" == *AGENT_SESSION_DIR* ]] &&
  [ ! -e "${SESSION_DIR}/.claude/skills/emumanager" ]; then
  echo "ok 5 - [Session] a mismatched session ID is refused, naming AGENT_SESSION_DIR"
else
  echo "not ok 5 - [Session] mismatched session ID not refused (rc=$nested_rc): $nested_err"
fi

# Test 6: a nested Codex, which inherits CLAUDE_CODE_SESSION_ID, is refused
codex_rc=0
CODEX_SESSION_ID=codex-1 "${SKILL_CMD[@]}" --scope session list >/dev/null 2>&1 || codex_rc=$?
if [ "$codex_rc" -eq 1 ]; then
  echo "ok 6 - [Session] a nested Codex session is refused"
else
  echo "not ok 6 - [Session] nested Codex session not refused (rc=$codex_rc)"
fi

# Test 7: an unbound session directory (AGENT_SESSION_ID unset) is refused
unbound_rc=0
unbound_err=$(env -u AGENT_SESSION_ID "${SKILL_CMD[@]}" --scope session list 2>&1) || unbound_rc=$?
if [ "$unbound_rc" -eq 1 ] && [[ "$unbound_err" == *AGENT_SESSION_DIR* ]]; then
  echo "ok 7 - [Session] an unbound session directory is refused"
else
  echo "not ok 7 - [Session] unbound session not refused (rc=$unbound_rc): $unbound_err"
fi

# Test 8: outside any session, --scope session fails naming AGENT_SESSION_DIR
none_rc=0
none_err=$(env -u AGENT_SESSION_DIR "${SCRIPT}" --scope session list 2>&1) || none_rc=$?
if [ "$none_rc" -eq 1 ] && [[ "$none_err" == *AGENT_SESSION_DIR* ]]; then
  echo "ok 8 - [Session] no session directory is an error naming AGENT_SESSION_DIR"
else
  echo "not ok 8 - [Session] missing session not reported (rc=$none_rc): $none_err"
fi

# Test 9: --scope is validated, and only the scope-aware commands take it
bad_rc=0
apply_rc=0
"${SKILL_CMD[@]}" --scope galaxy list >/dev/null 2>&1 || bad_rc=$?
"${SKILL_CMD[@]}" --scope session catalog >/dev/null 2>&1 || apply_rc=$?
if [ "$bad_rc" -eq 2 ] && [ "$apply_rc" -eq 2 ]; then
  echo "ok 9 - [Scope] an unknown scope and 'catalog --scope session' are usage errors"
else
  echo "not ok 9 - [Scope] expected usage errors (bad=$bad_rc apply=$apply_rc)"
fi
unset AGENT_SESSION_DIR AGENT_SESSION_ID CLAUDE_CODE_SESSION_ID
cd "$TMPDIR"

# ==============================================================================
# Antigravity session scope (copies)
# ==============================================================================
BRAIN_DIR="${HOME}/.gemini/antigravity/brain/test-conv-123"
mkdir -p "${BRAIN_DIR}/.system_generated" "${BRAIN_DIR}/scratch"

# Test 10: --scope session -C <artifactDir> copies full skills into
# .agents/skills/<name>/ with metadata.source (no symlinks, no stubs, no skills.json)
add_hint=$("${SKILL_CMD[@]}" --scope session -C "$BRAIN_DIR" add coding-standards 2>&1)
if grep -q "to use it now, read ~/.gemini/antigravity/brain/test-conv-123/.agents/skills/coding-standards/SKILL.md" <<<"$add_hint" &&
  "${SKILL_CMD[@]}" --scope session -C "$BRAIN_DIR" add emumanager >/dev/null 2>&1 &&
  [ -f "${BRAIN_DIR}/.agents/skills/coding-standards/SKILL.md" ] &&
  [ -x "${BRAIN_DIR}/.agents/skills/coding-standards/scripts/lint" ] &&
  [ ! -L "${BRAIN_DIR}/.agents/skills/coding-standards" ] &&
  [ ! -L "${BRAIN_DIR}/.agents/skills/coding-standards/SKILL.md" ] &&
  grep -q "source: \"${SKILL_SOURCE_DIRS}/coding-standards\"" "${BRAIN_DIR}/.agents/skills/coding-standards/SKILL.md" &&
  grep -q "^body$" "${BRAIN_DIR}/.agents/skills/coding-standards/SKILL.md" &&
  [ -f "${BRAIN_DIR}/.agents/skills/emumanager/SKILL.md" ] &&
  [ ! -d "${BRAIN_DIR}/.claude" ] &&
  [ ! -f "${BRAIN_DIR}/.agents/skills.json" ] &&
  "${SKILL_CMD[@]}" --scope session -C "$BRAIN_DIR" remove emumanager >/dev/null 2>&1 &&
  [ ! -e "${BRAIN_DIR}/.agents/skills/emumanager" ] &&
  bdj=$("${SKILL_CMD[@]}" --scope session -C "$BRAIN_DIR" doctor --json 2>/dev/null) &&
  [ "$(json_get "$bdj" 'd["healthy"]')" = "true" ]; then
  echo "ok 10 - [Agy] --scope session -C <artifactDir> copies skills with metadata.source and passes doctor"
else
  echo "not ok 10 - [Agy] --scope session -C <artifactDir> setup or doctor failed: ${add_hint:-}"
fi

# Test 11: ANTIGRAVITY_CONVERSATION_ID finds brain/<id>, reports canonical path,
# and clean empties .agents while keeping scratch/
if out=$(ANTIGRAVITY_CONVERSATION_ID=test-conv-123 "${SKILL_CMD[@]}" --scope session list --json 2>/dev/null) &&
  [ "$(json_gets "$out" '[s["name"] for s in d]' '[s["path"] for s in d]')" = $'coding-standards\n'"${SKILL_SOURCE_DIRS}/coding-standards" ]; then
  if "${SKILL_CMD[@]}" -C "$BRAIN_DIR" --scope session list >/dev/null 2>&1 &&
    (cd "$BRAIN_DIR" && _SCOPE_TEST=1 "${SKILL_CMD[@]}" --scope session list >/dev/null 2>&1) &&
    ANTIGRAVITY_CONVERSATION_ID=test-conv-123 "${SKILL_CMD[@]}" --scope session clean >/dev/null 2>&1 &&
    [ ! -e "${BRAIN_DIR}/.agents" ] && [ -d "${BRAIN_DIR}/scratch" ]; then
    echo "ok 11 - [Agy] ANTIGRAVITY_CONVERSATION_ID finds brain/<id>, reports canonical path, and clean empties .agents"
  else
    echo "not ok 11 - [Agy] conversation-ID lookup or clean failed: ${out:-}"
  fi
else
  echo "not ok 11 - [Agy] conversation-ID lookup or clean failed: ${out:-}"
fi

# Test 12: workspace scope refuses an Antigravity session directory
agy_ws_rc=0
"${SKILL_CMD[@]}" -C "$BRAIN_DIR" add coding-standards >/dev/null 2>&1 || agy_ws_rc=$?
if [ "$agy_ws_rc" -eq 1 ] && [ ! -e "${BRAIN_DIR}/.claude" ] && [ ! -e "${BRAIN_DIR}/.agents" ]; then
  echo "ok 12 - [Agy] workspace scope refuses an Antigravity session directory"
else
  echo "not ok 12 - [Agy] workspace scope wrote into an Antigravity session directory (rc=$agy_ws_rc)"
fi

# Test 13: ANTIGRAVITY_APP_DATA_DIR locates brain/<id> outside ~/.gemini
APP_DATA="${TMPDIR}/agy-app-data"
mkdir -p "${APP_DATA}/brain/conv-app"
if ANTIGRAVITY_APP_DATA_DIR="$APP_DATA" ANTIGRAVITY_CONVERSATION_ID=conv-app \
  "${SKILL_CMD[@]}" --scope session add emumanager >/dev/null 2>&1 &&
  [ -f "${APP_DATA}/brain/conv-app/.agents/skills/emumanager/SKILL.md" ] &&
  [ ! -L "${APP_DATA}/brain/conv-app/.agents/skills/emumanager" ]; then
  echo "ok 13 - [Agy] ANTIGRAVITY_APP_DATA_DIR locates brain/<id>"
else
  echo "not ok 13 - [Agy] ANTIGRAVITY_APP_DATA_DIR was not used"
fi

# Test 14: agy started from a wrapped Claude inherits a matching Claude
# binding; its own conversation wins
mkdir -p "${TMPDIR}/outer-claude"
if AGENT_SESSION_DIR="${TMPDIR}/outer-claude" AGENT_SESSION_ID=outer \
  CLAUDE_CODE_SESSION_ID=outer ANTIGRAVITY_APP_DATA_DIR="$APP_DATA" \
  ANTIGRAVITY_CONVERSATION_ID=conv-app \
  "${SKILL_CMD[@]}" --scope session add coding-standards >/dev/null 2>&1 &&
  [ -f "${APP_DATA}/brain/conv-app/.agents/skills/coding-standards/SKILL.md" ] &&
  [ ! -e "${TMPDIR}/outer-claude/.claude" ]; then
  echo "ok 14 - [Agy] agy nested in a wrapped Claude uses its own session"
else
  echo "not ok 14 - [Agy] agy nested in Claude wrote into the Claude session"
fi

# ==============================================================================
# User scope (symlinks)
# ==============================================================================

# Test 15: user scope links symlinks into ~/.claude/skills, ~/.agents/skills,
# and ~/.gemini/config/skills (when ~/.gemini/config exists), leaving synced/
# and ~/.gemini/config intact on clean
mkdir -p "${HOME}/.claude/skills/synced" "${HOME}/.codex" "${HOME}/.gemini/config"
if "${SKILL_CMD[@]}" --scope user add coding-standards >/dev/null 2>&1 &&
  [ -L "${HOME}/.claude/skills/coding-standards" ] &&
  [ -L "${HOME}/.agents/skills/coding-standards" ] &&
  [ -L "${HOME}/.gemini/config/skills/coding-standards" ] &&
  udj=$("${SKILL_CMD[@]}" --scope user doctor --json 2>/dev/null) &&
  [ "$(check_status "$udj" "Directory Cleanliness")" = "OK" ] &&
  "${SKILL_CMD[@]}" --scope user clean >/dev/null 2>&1 &&
  [ ! -e "${HOME}/.claude/skills/coding-standards" ] &&
  [ ! -e "${HOME}/.gemini/config/skills" ] &&
  [ -d "${HOME}/.gemini/config" ] &&
  [ -d "${HOME}/.claude/skills/synced" ]; then
  echo "ok 15 - [User] user scope links ~/.claude, ~/.agents, and ~/.gemini/config/skills and ignores synced/"
else
  echo "not ok 15 - [User] user scope add, doctor or clean failed"
fi

# ==============================================================================
# Session add against user and workspace scopes
# ==============================================================================

# Test 16: a session add skips skills already active in user scope (symlinks) or
# workspace scope (copies), and says so, so a project's whole list can be piped
SKIP_REPO="${TMPDIR}/skip-repo"
mkdir -p "$SKIP_REPO"
git -C "$SKIP_REPO" init -q
cd "$SKIP_REPO"
export AGENT_SESSION_DIR="$SESSION_DIR" AGENT_SESSION_ID=sess-1 \
  CLAUDE_CODE_SESSION_ID=sess-1
if "${SKILL_CMD[@]}" --scope user add coding-standards >/dev/null 2>&1 &&
  "${SKILL_CMD[@]}" add test-skill >/dev/null 2>&1 &&
  skip_err=$(printf 'coding-standards\ntest-skill\nemumanager\n' | "${SKILL_CMD[@]}" --scope session add - 2>&1) &&
  grep -q "already active coding-standards" <<<"$skip_err" &&
  grep -q "already active test-skill" <<<"$skip_err" &&
  [ ! -e "${SESSION_DIR}/.claude/skills/coding-standards" ] &&
  [ ! -e "${SESSION_DIR}/.claude/skills/test-skill" ] &&
  [ -d "${SESSION_DIR}/.claude/skills/emumanager" ] &&
  [ ! -L "${SESSION_DIR}/.claude/skills/emumanager" ]; then
  echo "ok 16 - [Session] add skips skills already active in user or workspace scope"
else
  echo "not ok 16 - [Session] add did not skip user/workspace skill: ${skip_err:-}"
fi
"${SKILL_CMD[@]}" --scope session clean >/dev/null 2>&1 || true
"${SKILL_CMD[@]}" --scope user clean >/dev/null 2>&1 || true
"${SKILL_CMD[@]}" clean >/dev/null 2>&1 || true

# Test 17: in the user scope, a skill directory that something else installed
# (such as a cloud platform's own skill) is only a warning: add still succeeds,
# and the directory is left alone.
mkdir -p "${HOME}/.claude/skills/platform-skill"
printf 'platform' >"${HOME}/.claude/skills/platform-skill/SKILL.md"
if "${SKILL_CMD[@]}" --scope user add coding-standards >/dev/null 2>&1 &&
  udj=$("${SKILL_CMD[@]}" --scope user doctor --json 2>/dev/null || true) &&
  [ "$(check_status "$udj" "Directory Cleanliness")" = "WARNING" ] &&
  [ -f "${HOME}/.claude/skills/platform-skill/SKILL.md" ]; then
  echo "ok 17 - [User] a foreign skill directory in the user scope is a warning"
else
  echo "not ok 17 - [User] a foreign skill directory blocked user-scope add: $udj"
fi
"${SKILL_CMD[@]}" --scope user clean >/dev/null 2>&1 || true
rm -rf "${HOME}/.claude/skills/platform-skill"

# Test 18: under AgyBrainWorkspace, workspace copies and confined in-repo
# symlinks are skipped as 'already active', while a legacy workspace symlink
# escaping the workspace root is staged as a session copy.
AGY_CONF_REPO="${TMPDIR}/agy-conf-repo"
AGY_CONF_BRAIN="${TMPDIR}/agy-conf-app/brain/conv-conf"
mkdir -p "${AGY_CONF_REPO}/skills/in-repo-skill" "${AGY_CONF_REPO}/.agents/skills" "${AGY_CONF_BRAIN}"
git -C "$AGY_CONF_REPO" init -q
printf -- '---\nname: in-repo-skill\ndescription: Local skill\n---\nbody\n' >"${AGY_CONF_REPO}/skills/in-repo-skill/SKILL.md"
ln -s "${AGY_CONF_REPO}/skills/in-repo-skill" "${AGY_CONF_REPO}/.agents/skills/in-repo-skill"
ln -s "${TMPDIR}/sources/coding-standards" "${AGY_CONF_REPO}/.agents/skills/coding-standards"
(cd "$AGY_CONF_REPO" && "${SKILL_CMD[@]}" add test-skill >/dev/null 2>&1)
if agy_conf_out=$(
  cd "$AGY_CONF_REPO" &&
    ANTIGRAVITY_APP_DATA_DIR="${TMPDIR}/agy-conf-app" ANTIGRAVITY_CONVERSATION_ID=conv-conf \
      "${SKILL_CMD[@]}" --scope session add "${AGY_CONF_REPO}/skills/in-repo-skill" test-skill coding-standards 2>&1
) &&
  grep -q "already active in-repo-skill" <<<"$agy_conf_out" &&
  grep -q "already active test-skill" <<<"$agy_conf_out" &&
  [ ! -e "${AGY_CONF_BRAIN}/.agents/skills/in-repo-skill" ] &&
  [ ! -e "${AGY_CONF_BRAIN}/.agents/skills/test-skill" ] &&
  [ -f "${AGY_CONF_BRAIN}/.agents/skills/coding-standards/SKILL.md" ] &&
  [ ! -L "${AGY_CONF_BRAIN}/.agents/skills/coding-standards" ]; then
  echo "ok 18 - [Agy] session add skips workspace copies and stages escaping legacy links as copies"
else
  echo "not ok 18 - [Agy] workspace copy or escaping link mishandled: ${agy_conf_out:-}"
fi
