#!/usr/bin/env bash
# Tests: skills/agent-config/plugins/andon/opencode/
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
PLUGIN="$DIR/../plugins/andon/opencode"

if ! command -v node >/dev/null 2>&1; then
  echo "1..0 # SKIP Node.js >=26.4 is not installed"
  exit 0
fi
if ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 26 || (major === 26 && minor >= 4) ? 0 : 1)'; then
  echo "1..0 # SKIP Node.js >=26.4 is required"
  exit 0
fi
if [[ ! -d "$PLUGIN/node_modules/@opencode/plugin" ]]; then
  echo "1..0 # SKIP run npm ci in plugins/andon/opencode first"
  exit 0
fi

exec node --test --test-reporter=tap "$PLUGIN"/tests/*.test.ts
