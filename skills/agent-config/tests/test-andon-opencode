#!/usr/bin/env bash
# Tests: skills/agent-config/plugins/andon/opencode/
set -euo pipefail

# shellcheck source=skills/agent-config/tests/common.sh disable=SC1091
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)/common.sh"
require_node --ts

PLUGIN="$COMMON_SH_DIR/../plugins/andon/opencode"
if [[ -d "$PLUGIN/node_modules/@opencode/plugin" ]]; then
  exec "$NODE_BIN" --test --test-reporter=tap "$PLUGIN"/tests/*.test.ts
fi

tap_out=""
rc=0
tap_out=$("$NODE_BIN" --test --test-reporter=tap \
  "$PLUGIN/tests/rule-sensor.test.ts" "$PLUGIN/tests/cli.test.ts") || rc=$?

# Append explicit # SKIP lines for the three suites requiring @opencode/plugin
# so CI reports all skipped coverage rather than hiding it behind rule-sensor.
if [[ "$tap_out" =~ (^|$'\n')1\.\.([0-9]+)($|$'\n') ]]; then
  n="${BASH_REMATCH[2]}"
  skip_lines="ok $((n + 1)) - board.test.ts: OpenCode TUI board tests # SKIP node_modules/@opencode/plugin not installed
ok $((n + 2)) - plugin.test.ts: OpenCode plugin integration tests # SKIP node_modules/@opencode/plugin not installed
ok $((n + 3)) - host.test.ts: OpenCode host integration tests # SKIP node_modules/@opencode/plugin not installed
1..$((n + 3))"
  tap_out="${tap_out/$'\n'1..$n/$'\n'$skip_lines}"
fi
printf '%s\n' "$tap_out"
exit "$rc"
