"""Exercise the real stdio protocol and shared CLI against temporary stores."""
# unittest supplies the assertion API.
# ruff: noqa: PT009, PT027

import asyncio
import contextlib
import inspect
import json
import os
import selectors
import signal
import subprocess
import sys
import tempfile
import traceback
import unittest
from pathlib import Path

from mcp.client.session import ClientSession
from mcp.client.stdio import StdioServerParameters, stdio_client
from mcp.shared.exceptions import MCPError

SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "andon"
REPORT = {
    "color": "yellow",
    "kind": "stale_instruction",
    "summary": "A documented flag is missing",
    "details": "helper --fast: unknown option",
    "sources": ["skills/example/SKILL.md"],
    "resolution": "Used the documented default",
    "proposed_fix": "Remove --fast from the example",
}


class AndonMcpTests(unittest.TestCase):
    async def run_test(self, method):
        async with contextlib.AsyncExitStack() as self.stack:
            root = self.stack.enter_context(tempfile.TemporaryDirectory())
            self.state = Path(root) / "state"
            self.env = {
                **os.environ,
                "ANDON_STATE_DIR": str(self.state),
                "ANDON_LEVEL": "4",
            }
            self.stderr = self.stack.enter_context(tempfile.TemporaryFile(mode="w+"))  # noqa: SIM115 -- ExitStack owns cleanup
            streams = await self.stack.enter_async_context(
                stdio_client(
                    StdioServerParameters(
                        command=sys.executable,
                        args=[str(SCRIPT), "mcp", "--stdio"],
                        env=self.env,
                    ),
                    errlog=self.stderr,
                )
            )
            self.client = await self.stack.enter_async_context(
                ClientSession(
                    *streams,
                    read_timeout_seconds=10,
                )
            )
            self.initialized = await self.client.initialize()

            result = method()
            if inspect.isawaitable(result):
                await result

    def cli(self, *args, data=None):
        result = subprocess.run(
            [sys.executable, str(SCRIPT), *args],
            input=data,
            text=True,
            capture_output=True,
            env=self.env,
            timeout=10,
            check=True,
        )
        return result.stdout

    async def call(self, name, args=None):
        result = await self.client.call_tool(name, args)
        self.assertFalse(result.is_error, result.content)
        self.assertEqual(json.loads(result.content[0].text), result.structured_content)
        return result.structured_content

    async def test_discovery(self):
        tools = {tool.name: tool for tool in (await self.client.list_tools()).tools}
        self.assertEqual(self.initialized.server_info.name, "andon")
        self.assertIn("Do not retry", self.initialized.instructions)
        self.assertEqual(
            set(tools),
            {
                "board",
                "pull",
                "list",
                "show",
                "stats",
                "prompt",
                "resolve",
                "dismiss",
                "reopen",
            },
        )
        self.assertFalse(tools["pull"].annotations.read_only_hint)
        self.assertFalse(tools["pull"].annotations.idempotent_hint)
        self.assertFalse(tools["pull"].annotations.open_world_hint)
        self.assertTrue(tools["show"].annotations.read_only_hint)
        self.assertNotIn("conversation_id", tools["pull"].input_schema["properties"])
        self.assertFalse(self.state.exists())

    async def test_codex_hook_attributes_real_mcp_receipt(self):
        receipt = await self.call("pull", REPORT)
        hook = SCRIPT.parent.parent / "plugins/andon/chatgpt/hooks/codex-hook"
        event = {
            "hook_event_name": "PostToolUse",
            "session_id": "host-mcp-test",
            "cwd": "/fixture-workspace",
            "tool_use_id": "host-tool-call",
            "tool_name": "mcp__andon__pull",
            "tool_input": REPORT,
            "tool_response": {"structuredContent": receipt},
        }
        result = await asyncio.to_thread(
            subprocess.run,
            [sys.executable, str(hook)],
            input=json.dumps(event),
            text=True,
            capture_output=True,
            env={
                **self.env,
                "PATH": str(SCRIPT.parents[3] / "bin")
                + os.pathsep
                + os.environ.get("PATH", ""),
            },
            timeout=10,
            check=False,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        alert = await self.call("show", {"id": receipt["id"]})
        self.assertEqual(alert["harness"], "codex")
        self.assertEqual(alert["conversation_id"], "host-mcp-test")
        self.assertEqual(alert["tool_use_id"], "host-tool-call")
        self.assertEqual(alert["workspace_paths"], ["/fixture-workspace"])
        board = await self.call("board")
        self.assertEqual(len(board["alerts"]), 1)
        self.assertEqual(board["alerts"][0]["harness"], "codex")

    async def test_board_discovery_and_resource(self):
        tools = {tool.name: tool for tool in (await self.client.list_tools()).tools}
        board = tools["board"]
        self.assertTrue(board.annotations.read_only_hint)
        self.assertEqual(board.meta["ui"]["resourceUri"], "ui://andon/board")
        self.assertEqual(
            board.meta["openai/ui"]["entrypoints"],
            [{"type": "thread"}, {"type": "global"}],
        )
        for tool in tools.values():
            self.assertIn("app", tool.meta["ui"]["visibility"])
            if tool.name != "board":
                self.assertNotIn("resourceUri", tool.meta["ui"])
        resources = (await self.client.list_resources()).resources
        self.assertEqual([r.uri for r in resources], ["ui://andon/board"])
        contents = (await self.client.read_resource(resources[0].uri)).contents
        self.assertEqual(len(contents), 1)
        self.assertEqual(contents[0].mime_type, "text/html;profile=mcp-app")
        self.assertEqual(
            contents[0].text,
            (SCRIPT.parent.parent / "plugins/andon/chatgpt/board.html").read_text(),
        )
        self.assertEqual(contents[0].meta["ui"]["csp"]["connectDomains"], [])
        self.assertFalse(self.state.exists(), "Opening the UI must not write state")

    async def test_board_reads_shared_store_and_triage(self):
        empty = await self.call("board")
        self.assertEqual(empty["total"], 0)
        self.assertEqual(empty["stats"]["open"], 0)
        first = json.loads(self.cli("pull", "--json", "-", data=json.dumps(REPORT)))
        second = await self.call("pull", {**REPORT, "color": "red"})
        snapshot = await self.call("board")
        self.assertEqual(snapshot["total"], 2)
        self.assertEqual(snapshot["stats"]["open_red"], 1)
        self.assertEqual(
            {a["id"] for a in snapshot["alerts"]}, {first["id"], second["id"]}
        )
        self.assertTrue(all(a["recurrences"] == 2 for a in snapshot["alerts"]))
        before = (self.state / "events.jsonl").read_bytes()
        await self.call("board")
        self.assertEqual((self.state / "events.jsonl").read_bytes(), before)
        self.cli("resolve", first["id"])
        await self.call("dismiss", {"id": second["id"]})
        self.assertEqual((await self.call("board"))["total"], 0)
        await self.call("reopen", {"id": first["id"]})
        self.assertEqual((await self.call("board"))["alerts"][0]["id"], first["id"])

    async def test_unknown_resource_is_rejected(self):
        for uri in ("ui://andon/missing", SCRIPT.as_uri()):
            with self.subTest(uri=uri), self.assertRaises(MCPError):
                await self.client.read_resource(uri)
        self.assertEqual((await self.call("board"))["total"], 0)

    async def test_pull_and_show_match_cli(self):
        receipt = await self.call("pull", REPORT)
        alert = await self.call("show", {"id": receipt["id"]})
        self.assertEqual(alert, json.loads(self.cli("show", receipt["id"], "--json")))
        self.assertEqual(alert["harness"], "mcp")
        self.assertNotIn("conversation_id", alert)
        self.assertEqual(alert["proposed_fix"], REPORT["proposed_fix"])
        self.assertEqual(receipt["level"], 4)
        self.assertEqual(receipt["recurrences"], 1)

    async def test_cross_interface_recurrences(self):
        first = json.loads(self.cli("pull", "--json", "-", data=json.dumps(REPORT)))
        second = await self.call("pull", REPORT)
        self.assertNotEqual(first["id"], second["id"])
        self.assertEqual(first["fingerprint"], second["fingerprint"])
        self.assertEqual(second["recurrences"], 2)
        self.assertEqual(
            await self.call("stats"), json.loads(self.cli("stats", "--json"))
        )

    async def test_filters_and_pagination(self):
        for n in range(3):
            await self.call("pull", {**REPORT, "summary": f"Occurrence {n}"})
        red = json.loads(
            self.cli(
                "pull",
                "--json",
                "-",
                data=json.dumps({**REPORT, "color": "red", "level": 2}),
            )
        )
        first = await self.call("list", {"color": "yellow", "limit": 2})
        second = await self.call(
            "list", {"color": "yellow", "offset": first["next_offset"], "limit": 2}
        )
        self.assertEqual(first["total"], 3)
        self.assertEqual(
            [a["summary"] for a in first["alerts"] + second["alerts"]],
            [f"Occurrence {n}" for n in (2, 1, 0)],
        )
        self.assertIsNone(second["next_offset"])
        selected = await self.call("list", {"color": "red", "level": 2})
        self.assertEqual([a["id"] for a in selected["alerts"]], [red["id"]])
        self.assertIn("Stop", red["guidance"])

    async def test_invalid_arguments_do_not_write(self):
        for overrides in (
            {"color": "green"},
            {"kind": "invalid"},
            {"summary": " "},
            {"summary": "x" * 121},
            {"details": ""},
            {"sources": [7]},
            {"level": 2},
            {"conversation_id": "invented"},
            {"harness": "invented"},
        ):
            with self.subTest(overrides=overrides):
                result = await self.client.call_tool("pull", {**REPORT, **overrides})
                self.assertTrue(result.is_error, result)
        self.assertEqual((await self.call("stats"))["total"], 0)

    async def test_tool_errors_leave_server_usable(self):
        for name, args in (
            ("unknown", {}),
            ("pull", {}),
            ("show", {"id": "missing"}),
            ("resolve", {"id": "missing"}),
            ("list", {"limit": 0}),
            ("list", {"limit": 1001}),
            ("list", {"offset": -1}),
            ("list", {"status": "invalid"}),
            ("stats", {"extra": 1}),
            ("board", {"extra": 1}),
        ):
            with self.subTest(name=name, args=args):
                self.assertTrue((await self.client.call_tool(name, args)).is_error)
        self.assertEqual((await self.call("stats"))["total"], 0)

    async def test_triage_matching_groups(self):
        first = await self.call("pull", REPORT)
        second = await self.call("pull", REPORT)
        resolved = await self.call(
            "resolve",
            {
                "id": first["id"],
                "all_matching": True,
                "note": "Fixed the example",
            },
        )
        self.assertEqual(set(resolved["ids"]), {first["id"], second["id"]})
        self.assertEqual((await self.call("list"))["total"], 0)
        rows = json.loads(self.cli("list", "--status", "all", "--json"))
        self.assertTrue(
            all(
                a["status"] == "resolved"
                and a["resolution_note"] == "Fixed the example"
                for a in rows
            )
        )
        await self.call("reopen", {"id": second["id"], "all_matching": True})
        await self.call("dismiss", {"id": first["id"]})
        self.assertEqual((await self.call("list"))["total"], 1)
        self.assertEqual(
            (await self.call("show", {"id": first["id"]}))["status"], "dismissed"
        )

    async def test_prompt_is_read_only(self):
        receipt = await self.call("pull", REPORT)
        before = (self.state / "events.jsonl").read_bytes()
        prompt = await self.call("prompt", {"id": receipt["id"]})
        self.assertEqual(prompt["prompt"], self.cli("prompt", receipt["id"]))
        self.assertIn(f"andon resolve {receipt['id']}", prompt["prompt"])
        self.assertEqual((self.state / "events.jsonl").read_bytes(), before)

    async def test_parallel_cli_and_mcp_writes(self):
        async def cli_pull(n):
            process = await asyncio.create_subprocess_exec(
                sys.executable,
                str(SCRIPT),
                "pull",
                "--color",
                "yellow",
                "--kind",
                "other",
                "--summary",
                f"CLI occurrence {n}",
                "--details",
                "d",
                env=self.env,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.PIPE,
            )
            try:
                stdout, stderr = await asyncio.wait_for(process.communicate(), 10)
                self.assertEqual(process.returncode, 0, stderr)
                return stdout.decode().strip()
            finally:
                if process.returncode is None:
                    process.kill()
                    await process.wait()

        results = await asyncio.gather(
            *(cli_pull(n) for n in range(6)),
            *(
                self.call("pull", {**REPORT, "summary": f"MCP occurrence {n}"})
                for n in range(6)
            ),
        )
        self.assertEqual(
            len({r if isinstance(r, str) else r["id"] for r in results}), 12
        )
        self.assertEqual((await self.call("stats"))["total"], 12)
        self.assertEqual(
            len((self.state / "events.jsonl").read_text().splitlines()), 12
        )

    async def test_store_failure_is_tool_error(self):
        self.state.write_text("Not a directory")
        result = await self.client.call_tool("pull", REPORT)
        self.assertTrue(result.is_error)
        self.assertIn("set ANDON_STATE_DIR", result.content[0].text)
        self.state.unlink()
        self.assertEqual((await self.call("stats"))["total"], 0)

    def test_standard_library_cli_and_missing_sdk(self):
        result = subprocess.run(
            [sys.executable, "-S", str(SCRIPT), "stats", "--json"],
            env=self.env,
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(json.loads(result.stdout)["total"], 0)
        result = subprocess.run(
            [sys.executable, "-S", str(SCRIPT), "mcp", "--stdio"],
            env=self.env,
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        self.assertEqual(result.returncode, 1)
        self.assertEqual(result.stdout, "")
        self.assertIn("MCP dependencies unavailable", result.stderr)
        self.assertNotIn("Traceback", result.stderr)

    def test_stdio_eof_and_signals(self):
        for sig in (None, signal.SIGINT, signal.SIGTERM):
            with (
                self.subTest(signal=sig),
                subprocess.Popen(
                    [sys.executable, str(SCRIPT), "mcp"],
                    env=self.env,
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                ) as process,
            ):
                try:
                    message = {
                        "jsonrpc": "2.0",
                        "id": 1,
                        "method": "initialize",
                        "params": {
                            "protocolVersion": "2025-06-18",
                            "capabilities": {},
                            "clientInfo": {"name": "andon-test", "version": "1"},
                        },
                    }
                    process.stdin.write((json.dumps(message) + "\n").encode())
                    process.stdin.flush()
                    with selectors.DefaultSelector() as selector:
                        selector.register(process.stdout, selectors.EVENT_READ)
                        self.assertTrue(selector.select(10), "No initialization reply")
                    reply = json.loads(process.stdout.readline())
                    self.assertEqual(reply["result"]["serverInfo"]["name"], "andon")
                    if sig is not None:
                        # A server stops on a signal even while its client
                        # holds stdin open, and exits 0, as on end of input.
                        process.send_signal(sig)
                        process.wait(timeout=10)
                    stdout, stderr = process.communicate(timeout=10)
                    self.assertEqual(process.returncode, 0, stderr)
                    self.assertEqual(stdout, b"")
                    self.assertEqual(stderr.strip(), b"")
                finally:
                    if process.poll() is None:
                        process.kill()
                        process.wait()


if __name__ == "__main__":
    names = sorted(name for name in dir(AndonMcpTests) if name.startswith("test_"))
    print(f"1..{len(names)}", flush=True)
    failures = 0
    for number, name in enumerate(names, 1):
        case = AndonMcpTests()
        try:
            asyncio.run(case.run_test(getattr(case, name)))
        except Exception:
            failures += 1
            print(f"not ok {number} - {name}", flush=True)
            for line in traceback.format_exc().splitlines():
                print(f"# {line}")
        else:
            print(f"ok {number} - {name}", flush=True)
    sys.exit(1 if failures else 0)
