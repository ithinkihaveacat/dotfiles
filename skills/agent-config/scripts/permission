HELP_CLEAN = """Usage: permission clean [cmd|path]

Clear permission rules for detected agents. Clears both command and path
rules by default, or limits to 'cmd' or 'path' if specified.

Options:
  --agent NAME       Operate on a single agent backend
                     (agy, jetski, jetski-web, claude, codex)
  --help             Display this help message and exit"""

HELP_DOCTOR = """Usage: permission doctor

Compare each agent's current rules against what 'permission apply' would
configure, audit non-workspace access settings, and report anything missing
(read-only). Exits non-zero if problems are found.

Options:
  --agent NAME       Operate on a single agent backend
                     (agy, jetski, jetski-web, claude, codex)
  --help             Display this help message and exit"""

SUBCOMMAND_HELP = {
    "cmd": HELP_CMD,
    "command": HELP_CMD,
    "cmd add": HELP_CMD_ADD,
    "command add": HELP_CMD_ADD,
    "cmd remove": HELP_CMD_REMOVE,
    "command remove": HELP_CMD_REMOVE,
    "cmd rm": HELP_CMD_REMOVE,
    "command rm": HELP_CMD_REMOVE,
    "cmd list": HELP_CMD_LIST,
    "command list": HELP_CMD_LIST,
    "cmd ls": HELP_CMD_LIST,
    "command ls": HELP_CMD_LIST,
    "path": HELP_PATH,
    "dir": HELP_PATH,
    "path add": HELP_PATH_ADD,
    "dir add": HELP_PATH_ADD,
    "path remove": HELP_PATH_REMOVE,
    "dir remove": HELP_PATH_REMOVE,
    "path rm": HELP_PATH_REMOVE,
    "dir rm": HELP_PATH_REMOVE,
    "path list": HELP_PATH_LIST,
    "dir list": HELP_PATH_LIST,
    "path ls": HELP_PATH_LIST,
    "dir ls": HELP_PATH_LIST,
    "list": HELP_LIST,
    "ls": HELP_LIST,
    "apply": HELP_APPLY,
    "clean": HELP_CLEAN,
    "doctor": HELP_DOCTOR,
}


def usage_error(cmd, msg):
    prog = "permission" + (f" {cmd}" if cmd else "")
    print(f"permission: error: {msg}", file=sys.stderr)
    print(f"Try '{prog} --help' for more information.", file=sys.stderr)
    sys.exit(2)


def main():
    argv = sys.argv[1:]

    if "--plugin-template" in argv:
        print('''"""
Example Plugin for the permission script.
Save this file as ~/.config/permission/plugins/my_plugin.py

register() runs on every permission invocation. Keep it fast and
side-effect-free: no network calls, subprocesses, or filesystem writes.
"""

def register(api):
    """
    This function is automatically called by `permission` when the plugin is loaded.
    You can register custom workspace root markers here using the provided `PermissionAPI`.
    """

    # Register a directory or file name that identifies a workspace root.
    # When 'permission' walks up the directory tree, if it finds a directory
    # or file with this name, it will treat that directory as the workspace root.
    api.register_root_marker(".my-workspace-root")
''')
        sys.exit(0)

    # Help handling: bare invocation, 'help [cmd]', '--help'/'-h' anywhere.
    if not argv or argv[0] in ("--help", "-h", "help"):
        topic = " ".join(argv[1:]) if len(argv) > 1 else None
        print(SUBCOMMAND_HELP.get(topic, HELP_MAIN))
        sys.exit(0)

    ns = argv[0]
    rest = argv[1:]

    # Legacy usage errors
    if ns == "add":
        print(
            "permission: error: 'add' requires a namespace ('cmd' or 'path').\n"
            "  To manage executable commands:   permission cmd add <pattern...>\n"
            "  To manage filesystem paths:      permission path add <path...>",
            file=sys.stderr,
        )
        print("Try 'permission --help' for more information.", file=sys.stderr)
        sys.exit(1)
    if ns in ("remove", "rm"):
        print(
            "permission: error: 'remove' requires a namespace ('cmd' or 'path').\n"
            "  To remove executable commands:   permission cmd remove <pattern...>\n"
            "  To remove filesystem paths:      permission path remove <path...>",
            file=sys.stderr,
        )
        print("Try 'permission --help' for more information.", file=sys.stderr)
        sys.exit(1)

    # --- Namespace: cmd ---
    if ns in ("cmd", "command"):
        if not rest or rest[0] in ("--help", "-h", "help"):
            topic = f"{ns} {rest[1]}" if len(rest) > 1 else ns
            print(SUBCOMMAND_HELP.get(topic, HELP_CMD))
            sys.exit(0)
        action = rest[0]
        cmd_args = rest[1:]
        if "--help" in cmd_args or "-h" in cmd_args or "help" in cmd_args:
            print(SUBCOMMAND_HELP.get(f"{ns} {action}", HELP_CMD))
            sys.exit(0)
        if action not in ("add", "remove", "rm", "list", "ls"):
            usage_error(ns, f"unknown command '{action}'")

        mode = "allow"
        agent = None
        patterns = []
        i = 0
        while i < len(cmd_args):
            arg = cmd_args[i]
            if arg == "--deny" and action == "add":
                mode = "deny"
            elif arg == "--ask" and action == "add":
                mode = "ask"
            elif arg == "--agent":
                if i + 1 >= len(cmd_args):
                    usage_error(f"{ns} {action}", "--agent requires a value")
                agent = cmd_args[i + 1]
                i += 1
            elif arg.startswith("--agent="):
                agent = arg.split("=", 1)[1]
            elif arg.startswith("-") and arg != "-":
                usage_error(f"{ns} {action}", f"unrecognized option '{arg}'")
            else:
                patterns.append(arg)
            i += 1

        if action in ("list", "ls") and patterns:
            usage_error(f"{ns} {action}", f"unexpected argument '{patterns[0]}'")

        if action == "add":
            cmd_cmd_add(read_patterns(patterns), mode, agent)
        elif action in ("remove", "rm"):
            cmd_cmd_remove(read_patterns(patterns), agent)
        elif action in ("list", "ls"):
            cmd_cmd_list(agent)
        return

    # --- Namespace: path ---
    if ns in ("path", "dir"):
        if not rest or rest[0] in ("--help", "-h", "help"):
            topic = f"{ns} {rest[1]}" if len(rest) > 1 else ns
            print(SUBCOMMAND_HELP.get(topic, HELP_PATH))
            sys.exit(0)
        action = rest[0]
        path_args = rest[1:]
        if "--help" in path_args or "-h" in path_args or "help" in path_args:
            print(SUBCOMMAND_HELP.get(f"{ns} {action}", HELP_PATH))
            sys.exit(0)
        if action not in ("add", "remove", "rm", "list", "ls"):
            usage_error(ns, f"unknown command '{action}'")

        access = "all"
        scope = "user"
        agent = None
        raw_paths = []
        i = 0
        while i < len(path_args):
            arg = path_args[i]
            if arg in ("--ro", "--read-only") and action == "add":
                access = "read-only"
            elif arg in ("--rw", "--read-write") and action == "add":
                access = "all"
            elif arg in ("--workspace", "--local"):
                scope = "workspace"
            elif arg in ("--global", "--user"):
                scope = "user"
            elif arg == "--agent":
                if i + 1 >= len(path_args):
                    usage_error(f"{ns} {action}", "--agent requires a value")
                agent = path_args[i + 1]
                i += 1
            elif arg.startswith("--agent="):
                agent = arg.split("=", 1)[1]
            elif arg.startswith("-") and arg != "-":
                usage_error(f"{ns} {action}", f"unrecognized option '{arg}'")
            else:
                raw_paths.append(arg)
            i += 1

        if action in ("list", "ls") and raw_paths:
            usage_error(f"{ns} {action}", f"unexpected argument '{raw_paths[0]}'")

        if action == "add":
            cmd_path_add(read_patterns(raw_paths), access, scope, agent)
        elif action in ("remove", "rm"):
            cmd_path_remove(read_patterns(raw_paths), scope, agent)
        elif action in ("list", "ls"):
            cmd_path_list(agent)
        return

    # --- Top-level commands ---
    if ns not in ("list", "ls", "apply", "clean", "doctor"):
        usage_error(None, f"unknown command '{ns}'")

    if "--help" in rest or "-h" in rest or "help" in rest:
        print(SUBCOMMAND_HELP.get(ns, HELP_MAIN))
        sys.exit(0)

    agent = None
    kind = "all"
    positional = []
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg == "--agent":
            if i + 1 >= len(rest):
                usage_error(ns, "--agent requires a value")
            agent = rest[i + 1]
            i += 1
        elif arg.startswith("--agent="):
            agent = arg.split("=", 1)[1]
        elif arg.startswith("-") and arg != "-":
            usage_error(ns, f"unrecognized option '{arg}'")
        else:
            positional.append(arg)
        i += 1

    if ns in ("list", "ls", "apply", "doctor") and positional:
        usage_error(ns, f"unexpected argument '{positional[0]}'")

    if ns == "clean":
        if positional:
            if positional[0] in ("cmd", "path", "all"):
                kind = positional[0]
            else:
                usage_error(
                    "clean",
                    f"unknown clean target '{positional[0]}' (expected 'cmd' or 'path')",
                )
            if len(positional) > 1:
                usage_error("clean", f"unexpected argument '{positional[1]}'")
        cmd_clean(kind, agent)
    elif ns in ("list", "ls"):
        cmd_list(agent)
    elif ns == "apply":
        cmd_apply(agent)
    elif ns == "doctor":
        cmd_doctor(agent)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        try:
            sys.stderr.write("\n")
            sys.stderr.flush()
        except Exception:
            pass
        sys.exit(130)
