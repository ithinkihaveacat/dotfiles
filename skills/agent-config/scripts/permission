#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
# Tests: skills/agent-config/tests/test-permission

import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

SKILL_BIN = str(Path(__file__).resolve().parent / "skill")

# Per-agent configuration locations (overridable for testing)
AGY_CONFIG_DIR = Path(
    os.environ.get("AGY_CONFIG_DIR")
    or os.environ.get("AGY_CONFIG_HOME")
    or os.environ.get("AGENT_CONFIG_HOME")  # legacy name
    or Path.home() / ".gemini/antigravity-cli"
)
CLAUDE_CONFIG_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
CODEX_HOME = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")

MODES = ("allow", "deny", "ask")


def die(msg):
    print(f"permission: {msg}", file=sys.stderr)
    sys.exit(1)


def colorize(text: str, color_name: str, enabled: bool) -> str:
    if not enabled:
        return text
    codes = {
        "green": "\033[32m",
        "yellow": "\033[33m",
        "red": "\033[31m",
        "bold": "\033[1m",
        "reset": "\033[0m",
    }
    return f"{codes.get(color_name, '')}{text}{codes['reset']}"


def use_color_for(stream) -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    force = os.environ.get("FORCE_COLOR")
    if force and force != "0":
        return True
    return stream.isatty() if hasattr(stream, "isatty") else False


def clean_p(path: Path | str) -> str:
    """Formats a path for display, abbreviating $HOME as '~'."""
    try:
        p = Path(path).resolve()
        home = Path.home().resolve()
        try:
            rel = p.relative_to(home)
            return f"~/{rel}" if str(rel) != "." else "~"
        except ValueError:
            return str(p)
    except Exception:
        return str(path)


def workspace_permission_paths(workspace_root: Path) -> list[str]:
    """Return existing workspace-local permission files for Git exclusion."""
    candidates = (
        ("/.claude/settings.local.json", ".claude/settings.local.json"),
        ("/.codex/rules/permission.rules", ".codex/rules/permission.rules"),
    )
    return [
        display
        for display, relative in candidates
        if (workspace_root / relative).is_file()
    ]


def sync_git_exclude(workspace_root: Path) -> None:
    """Manages a '# >>> permission >>>' block in .git/info/exclude listing
    the workspace-local permission files that currently exist."""
    paths = workspace_permission_paths(workspace_root)
    try:
        res = subprocess.run(
            [
                "git",
                "-C",
                str(workspace_root),
                "rev-parse",
                "--git-path",
                "info/exclude",
            ],
            capture_output=True,
            text=True,
            check=True,
        )
        exclude_file = (workspace_root / res.stdout.strip()).resolve()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return

    mark_begin = "# >>> permission >>>"
    mark_end = "# <<< permission <<<"

    other_lines: list[str] = []
    if exclude_file.is_file():
        in_block = False
        with open(exclude_file, encoding="utf-8", errors="replace") as f:
            for line in f:
                stripped = line.strip()
                if stripped == mark_begin:
                    in_block = True
                    continue
                if stripped == mark_end:
                    in_block = False
                    continue
                if not in_block:
                    other_lines.append(line)

    exclude_file.parent.mkdir(parents=True, exist_ok=True)
    temp_fd, temp_path_str = tempfile.mkstemp(dir=str(exclude_file.parent))
    temp_path = Path(temp_path_str)
    try:
        with os.fdopen(temp_fd, "w", encoding="utf-8") as f:
            for line in other_lines:
                f.write(line)
            if other_lines and not other_lines[-1].endswith("\n"):
                f.write("\n")
            if paths:
                f.write(mark_begin + "\n")
                f.write("# managed by 'permission'\n")
                for p in sorted(paths):
                    f.write(p + "\n")
                f.write(mark_end + "\n")
        os.replace(temp_path, exclude_file)
    except Exception as e:
        temp_path.unlink(missing_ok=True)
        print(
            f"permission: warning: could not update info/exclude: {e}",
            file=sys.stderr,
        )


# ==============================================================================
# Plugins & Workspace Root Detection
# ==============================================================================


class PermissionAPI:
    """API surface passed to a plugin's register() function.

    Plugins live in $XDG_CONFIG_HOME/permission/plugins/*.py and may register
    additional workspace-root marker names (directories or files whose
    presence identifies the root of a workspace when walking up from the
    current directory).
    """

    def __init__(self):
        self.root_markers = [".git", ".hg", ".svn"]
        self.load_failures = []

    def register_root_marker(self, marker: str):
        self.root_markers.append(marker)


def load_plugins() -> PermissionAPI:
    import importlib.util

    api = PermissionAPI()
    plugins_dir = (
        Path(os.environ.get("XDG_CONFIG_HOME") or "~/.config").expanduser()
        / "permission"
        / "plugins"
    )
    if not plugins_dir.is_dir():
        return api
    for filepath in sorted(plugins_dir.glob("*.py")):
        module_name = f"permission_plugin_{filepath.stem}"
        try:
            spec = importlib.util.spec_from_file_location(module_name, filepath)
            if spec and spec.loader:
                module = importlib.util.module_from_spec(spec)
                sys.modules[module_name] = module
                spec.loader.exec_module(module)
                if hasattr(module, "register"):
                    module.register(api)
        except Exception as e:
            api.load_failures.append((filepath.name, str(e)))
            print(
                f"permission: warning: failed to load plugin {filepath}: {e}",
                file=sys.stderr,
            )
            if os.environ.get("PERMISSION_DEBUG") == "1":
                import traceback

                traceback.print_exc(file=sys.stderr)
    return api


def get_workspace_root() -> Path:
    markers = load_plugins().root_markers
    curr = Path.cwd().resolve()
    for parent in [curr, *list(curr.parents)]:
        # .git may be a file (worktrees), so check existence, not is_dir.
        if any((parent / m).exists() for m in markers):
            return parent
    return curr


# ==============================================================================
# Adapter Architecture
# ==============================================================================


class PermissionAdapter:
    """Interface for agent-specific permission configuration.

    Adapters store and translate rules; all CLI-facing input and output uses
    "clean patterns" (e.g. "git show", "packagename uninstall") and each
    adapter translates to and from its agent's native rule syntax.
    """

    name = "?"
    scope = "workspace"  # "workspace" or "user"
    # Mode used by 'apply' to guard unsafe subcommands: "ask" if the agent
    # supports prompt-anyway rules, otherwise "deny".
    guard_mode = "ask"

    def is_available(self, workspace_root: Path) -> bool:
        """True if this agent appears to be in use on this machine."""
        return False

    def is_initialized(self, workspace_root: Path) -> bool:
        return False

    def config_paths(self, workspace_root: Path) -> list[Path]:
        """Returns the configuration files managed by this adapter."""
        return []

    def add(self, workspace_root: Path, pattern: str, mode: str) -> bool:
        """Adds a rule; returns True if newly added, False if already present."""
        raise NotImplementedError

    def remove(self, workspace_root: Path, pattern: str) -> list[str]:
        """Removes a pattern from all lists; returns the modes it was found in."""
        raise NotImplementedError

    def rules(self, workspace_root: Path) -> dict[str, list[str]]:
        """Returns {mode: [clean patterns]} for the workspace."""
        return {}

    def rules_in(self, path: Path) -> dict[str, list[str]]:
        """Returns clean rules from one configuration file."""
        return {}

    def clean(self, workspace_root: Path, kind: str = "all") -> None:
        raise NotImplementedError

    def add_path(
        self,
        workspace_root: Path,
        target_path: Path,
        access: str = "all",
        scope: str = "user",
    ) -> bool:
        """Adds a filesystem path grant; returns True if newly added, False if already present."""
        return False

    def remove_path(
        self, workspace_root: Path, target_path: Path, scope: str = "user"
    ) -> bool:
        """Removes a filesystem path grant; returns True if removed, False if not present."""
        return False

    def paths(self, workspace_root: Path) -> list[dict]:
        """Returns list of [{"path": str, "access": "read, write"|"read-only", "scope": "user"|"workspace"}]."""
        return []

    def clean_paths(self, workspace_root: Path) -> None:
        """Clears all configured path rules."""


class AgySettingsAdapter(PermissionAdapter):
    """Antigravity / Jetski CLI & Web: user-wide permissions in
    ~/.gemini/jetski/cli/settings.json, ~/.gemini/config/config.json,
    or ~/.gemini/antigravity-cli/settings.json. Supports allow, deny, and ask lists."""

    name = "agy"
    scope = "user"
    guard_mode = "ask"
    NON_CMD_PREFIXES = (
        "read_file(",
        "write_file(",
        "mcp(",
        "read_url(",
        "execute_url(",
        "escalate_admin(",
    )

    def __init__(self, target_agent: str | None = None):
        self.target_agent = target_agent
        if target_agent:
            self.name = target_agent

    def _settings_paths(self) -> list[Path]:
        import shutil

        home = Path.home()
        paths: list[Path] = []
        target = self.target_agent

        if target == "jetski-web":
            return [home / ".gemini/config/config.json"]

        jetski_existing: list[Path] = []
        for p in (
            home / ".gemini/jetski/cli/settings.json",
            AGY_CONFIG_DIR / "jetski/cli/settings.json",
            home / ".gemini/config/config.json",
            AGY_CONFIG_DIR / "config/config.json",
        ):
            if p.is_file() and p not in jetski_existing:
                jetski_existing.append(p)

        agy_existing: list[Path] = []
        for p in (
            AGY_CONFIG_DIR / "antigravity-cli/settings.json",
            home / ".gemini/antigravity-cli/settings.json",
            AGY_CONFIG_DIR / "settings.json",
        ):
            if p.is_file() and p not in agy_existing:
                agy_existing.append(p)

        if target == "jetski":
            if jetski_existing:
                if (home / ".gemini/config").is_dir() and (
                    home / ".gemini/config/config.json"
                ) not in jetski_existing:
                    return [*jetski_existing, home / ".gemini/config/config.json"]
                return jetski_existing
            if (AGY_CONFIG_DIR / "jetski/cli").is_dir():
                return [AGY_CONFIG_DIR / "jetski/cli/settings.json"]
            return [home / ".gemini/jetski/cli/settings.json"]

        if target == "agy":
            if agy_existing:
                return agy_existing
            if (AGY_CONFIG_DIR / "antigravity-cli").is_dir() or AGY_CONFIG_DIR.name in (
                ".gemini",
                "gemini",
            ):
                return [AGY_CONFIG_DIR / "antigravity-cli" / "settings.json"]
            if (home / ".gemini/antigravity-cli").is_dir():
                return [home / ".gemini/antigravity-cli/settings.json"]
            return [AGY_CONFIG_DIR / "settings.json"]

        for p in jetski_existing:
            if p not in paths:
                paths.append(p)
        if (home / ".gemini/config").is_dir() and (
            home / ".gemini/config/config.json"
        ) not in paths:
            paths.append(home / ".gemini/config/config.json")
        for p in agy_existing:
            if p not in paths:
                paths.append(p)

        jetski_active = bool(
            jetski_existing
            or (home / ".gemini/jetski/cli").is_dir()
            or (home / ".gemini/jetski").is_dir()
            or (home / ".gemini/config").is_dir()
            or (AGY_CONFIG_DIR / "jetski/cli").is_dir()
            or (AGY_CONFIG_DIR / "jetski").is_dir()
            or shutil.which("jetski")
        )
        if jetski_active and not jetski_existing:
            if (AGY_CONFIG_DIR / "jetski/cli").is_dir():
                p = AGY_CONFIG_DIR / "jetski/cli/settings.json"
            else:
                p = home / ".gemini/jetski/cli/settings.json"
            if p not in paths:
                paths.append(p)

        agy_active = bool(
            agy_existing
            or (AGY_CONFIG_DIR / "antigravity-cli").is_dir()
            or (home / ".gemini/antigravity-cli").is_dir()
            or shutil.which("agy")
        )
        if agy_active and not agy_existing:
            if (AGY_CONFIG_DIR / "antigravity-cli").is_dir() or AGY_CONFIG_DIR.name in (
                ".gemini",
                "gemini",
            ):
                p = AGY_CONFIG_DIR / "antigravity-cli" / "settings.json"
            elif (home / ".gemini/antigravity-cli").is_dir():
                p = home / ".gemini/antigravity-cli/settings.json"
            else:
                p = AGY_CONFIG_DIR / "settings.json"
            if p not in paths:
                paths.append(p)

        if paths:
            return paths

        return [AGY_CONFIG_DIR / "settings.json"]

    def is_available(self, workspace_root: Path) -> bool:
        import shutil

        home = Path.home()
        has_agy = bool(
            shutil.which("agy")
            and (
                AGY_CONFIG_DIR.is_dir()
                or (AGY_CONFIG_DIR / "antigravity-cli").is_dir()
                or (home / ".gemini/antigravity-cli").is_dir()
            )
        )
        has_jetski = bool(
            shutil.which("jetski")
            and (
                (home / ".gemini/jetski").is_dir()
                or (home / ".gemini/jetski/cli").is_dir()
                or (home / ".gemini/config").is_dir()
                or (home / ".gemini").is_dir()
                or (AGY_CONFIG_DIR / "jetski").is_dir()
                or (AGY_CONFIG_DIR / "jetski/cli").is_dir()
                or AGY_CONFIG_DIR.is_dir()
            )
        )
        return has_agy or has_jetski or self.is_initialized(workspace_root)

    def is_initialized(self, workspace_root: Path) -> bool:
        return any(p.is_file() for p in self._settings_paths())

    def config_paths(self, workspace_root: Path) -> list[Path]:
        return self._settings_paths()

    def translate(self, pattern: str) -> str:
        p = pattern.strip()
        if not p:
            return ""
        if p.endswith(")") and p.startswith(self.NON_CMD_PREFIXES):
            return p
        if p.startswith("command(") and p.endswith(")"):
            p = p[len("command(") : -1].strip()
        if p.startswith("regex:"):
            return f"command({p})"
        tokens = p.split()
        cmd = tokens[0]
        args = tokens[1:]
        cmd_pattern = f"(?:.*/)?{cmd}" if "/" not in cmd else cmd
        args_suffix = f" {' '.join(args)}" if args else ""
        return f"command(regex:{cmd_pattern}{args_suffix})"

    def untranslate(self, rule: str) -> str:
        inner = rule.strip()
        if inner.endswith(")") and inner.startswith(self.NON_CMD_PREFIXES):
            return inner
        if inner.startswith("command(") and inner.endswith(")"):
            inner = inner[len("command(") : -1].strip()
        if inner.startswith("regex:"):
            inner = inner[len("regex:") :].strip()
        if inner.startswith("(?:.*/)?"):
            inner = inner[len("(?:.*/)?") :].strip()
        return inner

    def _load(self, settings_path: Path) -> dict:
        if not settings_path.is_file():
            return {}
        try:
            with open(settings_path, encoding="utf-8") as f:
                return json.load(f)
        except Exception as e:
            die(f"[{self.name}] error reading {settings_path}: {e}")

    def _save(self, settings_path: Path, data: dict) -> None:
        created = not settings_path.is_file()
        settings_path.parent.mkdir(parents=True, exist_ok=True)
        temp_fd, temp_path_str = tempfile.mkstemp(dir=str(settings_path.parent))
        temp_path = Path(temp_path_str)
        try:
            with os.fdopen(temp_fd, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
                f.write("\n")
            os.replace(temp_path, settings_path)
        except Exception as e:
            temp_path.unlink(missing_ok=True)
            die(f"[{self.name}] error writing {settings_path}: {e}")
        if created:
            print(
                f"[{self.name} ({self.scope})] initialized {settings_path}",
                file=sys.stderr,
            )

    @staticmethod
    def _perms(data: dict, settings_path: Path | None = None) -> dict:
        if settings_path is not None and settings_path.name == "config.json":
            user_settings = data.setdefault("userSettings", {})
            perms = user_settings.setdefault("globalPermissionGrants", {})
        else:
            perms = data.setdefault("permissions", {})
        for mode in MODES:
            if perms.get(mode) is None:
                perms[mode] = []
        return perms

    def add(self, workspace_root: Path, pattern: str, mode: str) -> bool:
        rule = self.translate(pattern)
        if not rule:
            return False
        clean_pat = pattern.strip()
        added_any = False
        for settings_path in self._settings_paths():
            data = self._load(settings_path)
            perms = self._perms(data, settings_path)
            target_list = perms[mode]
            if rule in target_list:
                continue
            legacy_rules = [
                r for r in target_list if r != rule and self.untranslate(r) == clean_pat
            ]
            for r in legacy_rules:
                target_list.remove(r)
            target_list.append(rule)
            self._save(settings_path, data)
            added_any = True
        return added_any

    def remove(self, workspace_root: Path, pattern: str) -> list[str]:
        if not self.is_initialized(workspace_root):
            return []
        rule = self.translate(pattern)
        clean_pat = pattern.strip()
        removed_modes: set[str] = set()
        for settings_path in self._settings_paths():
            if not settings_path.is_file():
                continue
            data = self._load(settings_path)
            perms = self._perms(data, settings_path)
            path_changed = False
            for mode in MODES:
                lst = perms.get(mode)
                if lst:
                    to_remove = [
                        r for r in lst if r == rule or self.untranslate(r) == clean_pat
                    ]
                    for r in to_remove:
                        lst.remove(r)
                        removed_modes.add(mode)
                        path_changed = True
            if path_changed:
                self._save(settings_path, data)
        return sorted(removed_modes)

    def rules(self, workspace_root: Path) -> dict[str, list[str]]:
        if not self.is_initialized(workspace_root):
            return {}
        result: dict[str, list[str]] = {mode: [] for mode in MODES}
        for settings_path in self._settings_paths():
            if not settings_path.is_file():
                continue
            data = self._load(settings_path)
            perms = self._perms(data, settings_path)
            for mode in MODES:
                for r in perms.get(mode) or []:
                    untranslated = self.untranslate(r)
                    if untranslated and untranslated not in result[mode]:
                        result[mode].append(untranslated)
        return result

    def rules_in(self, path: Path) -> dict[str, list[str]]:
        if not path.is_file():
            return {}
        data = self._load(path)
        perms = self._perms(data, path)
        return {
            mode: [self.untranslate(rule) for rule in perms.get(mode) or []]
            for mode in MODES
        }

    def clean(self, workspace_root: Path, kind: str = "all") -> None:
        if not self.is_initialized(workspace_root):
            return
        for settings_path in self._settings_paths():
            if not settings_path.is_file():
                continue
            data = self._load(settings_path)
            perms = self._perms(data, settings_path)
            for mode in MODES:
                lst = perms.get(mode) or []
                if kind == "cmd":
                    perms[mode] = [
                        r for r in lst if r.startswith(("read_file(", "write_file("))
                    ]
                elif kind == "path":
                    perms[mode] = [
                        r
                        for r in lst
                        if not r.startswith(("read_file(", "write_file("))
                    ]
                else:
                    perms[mode] = []
            self._save(settings_path, data)
        desc = (
            "command rules"
            if kind == "cmd"
            else ("path rules" if kind == "path" else "all permission rules")
        )
        print(
            f"[{self.name} ({self.scope})] cleared {desc}",
            file=sys.stderr,
        )

    def clean_paths(self, workspace_root: Path) -> None:
        self.clean(workspace_root, kind="path")

    def _ensure_gemini_settings_non_workspace(self) -> None:
        home = Path.home()
        candidates = [
            home / ".gemini/settings.json",
            AGY_CONFIG_DIR / "settings.json",
        ]
        for s_file in candidates:
            if s_file.is_file():
                try:
                    data = self._load(s_file)
                    if not data.get("allowNonWorkspaceAccess"):
                        data["allowNonWorkspaceAccess"] = True
                        self._save(s_file, data)
                except Exception:
                    pass

    def _prune_projects_json(self, target_str: str) -> None:
        home = Path.home()
        for base in (home / ".gemini", AGY_CONFIG_DIR):
            projects_dir = base / "config" / "projects"
            if not projects_dir.is_dir():
                continue
            prefix_read = f"read_file({target_str}/"
            prefix_write = f"write_file({target_str}/"
            for pfile in projects_dir.glob("*.json"):
                try:
                    data = self._load(pfile)
                    pg = data.setdefault("permissionGrants", {}).setdefault(
                        "permissionGrants", {}
                    )
                    allow = pg.get("allow")
                    if isinstance(allow, list):
                        pruned = [
                            r
                            for r in allow
                            if not r.startswith((prefix_read, prefix_write))
                        ]
                        if len(pruned) != len(allow):
                            pg["allow"] = pruned
                            self._save(pfile, data)
                except Exception:
                    pass

    def add_path(
        self,
        workspace_root: Path,
        target_path: Path,
        access: str = "all",
        scope: str = "user",
    ) -> bool:
        target_str = str(target_path).rstrip("/")
        read_rule = f"read_file({target_str})"
        write_rule = f"write_file({target_str})"
        rules_to_add = [read_rule]
        if access == "all":
            rules_to_add.append(write_rule)

        added_any = False
        prefix_read = f"read_file({target_str}/"
        prefix_write = f"write_file({target_str}/"

        for settings_path in self._settings_paths():
            data = self._load(settings_path)
            perms = self._perms(data, settings_path)
            allow_list = perms["allow"]

            # Prune existing single-file or subpath rules subsumed by this directory grant
            pruned = [
                r for r in allow_list if not r.startswith((prefix_read, prefix_write))
            ]
            if len(pruned) != len(allow_list):
                allow_list[:] = pruned
                added_any = True

            for r in rules_to_add:
                if r not in allow_list:
                    allow_list.append(r)
                    added_any = True

            if settings_path.name == "config.json":
                user_settings = data.setdefault("userSettings", {})
                if not user_settings.get("allowNonWorkspaceAccess"):
                    user_settings["allowNonWorkspaceAccess"] = True
                    added_any = True

            self._save(settings_path, data)

        self._ensure_gemini_settings_non_workspace()
        self._prune_projects_json(target_str)
        return added_any

    def remove_path(
        self, workspace_root: Path, target_path: Path, scope: str = "user"
    ) -> bool:
        target_str = str(target_path).rstrip("/")
        rules_to_remove = {
            f"read_file({target_str})",
            f"write_file({target_str})",
        }
        removed_any = False
        for settings_path in self._settings_paths():
            if not settings_path.is_file():
                continue
            data = self._load(settings_path)
            perms = self._perms(data, settings_path)
            changed = False
            for mode in MODES:
                lst = perms.get(mode)
                if lst:
                    before = len(lst)
                    lst[:] = [r for r in lst if r not in rules_to_remove]
                    if len(lst) != before:
                        changed = True
                        removed_any = True
            if changed:
                self._save(settings_path, data)
        return removed_any

    def paths(self, workspace_root: Path) -> list[dict]:
        path_map: dict[str, dict] = {}
        for settings_path in self._settings_paths():
            if not settings_path.is_file():
                continue
            data = self._load(settings_path)
            perms = self._perms(data, settings_path)
            for r in perms.get("allow") or []:
                if r.startswith("read_file(") and r.endswith(")"):
                    target = r[len("read_file(") : -1]
                    if target != "*":
                        info = path_map.setdefault(
                            target, {"read": False, "write": False}
                        )
                        info["read"] = True
                elif r.startswith("write_file(") and r.endswith(")"):
                    target = r[len("write_file(") : -1]
                    if target != "*":
                        info = path_map.setdefault(
                            target, {"read": False, "write": False}
                        )
                        info["write"] = True
        result = []
        for p_str, info in sorted(path_map.items()):
            access = (
                "read, write"
                if (info["write"] or (info["read"] and info["write"]))
                else "read-only"
            )
            result.append(
                {
                    "path": p_str,
                    "access": access,
                    "scope": self.scope,
                }
            )
        return result


class ClaudeSettingsAdapter(PermissionAdapter):
    """Claude Code: permissions.allow/deny/ask Bash() rules in the
    workspace's .claude/settings.local.json (personal, never tracked)."""

    name = "claude"
    scope = "workspace"
    guard_mode = "ask"

    def _settings_path(self, workspace_root: Path) -> Path:
        return workspace_root / ".claude" / "settings.local.json"

    def is_available(self, workspace_root: Path) -> bool:
        import shutil

        # Require the config dir alongside the CLI: a binary that has never
        # been run is not an active agent, and tests isolate detection by
        # pointing CLAUDE_CONFIG_DIR at a directory they control.
        return bool(
            (shutil.which("claude") and CLAUDE_CONFIG_DIR.is_dir())
            or self.is_initialized(workspace_root)
        )

    def is_initialized(self, workspace_root: Path) -> bool:
        return self._settings_path(workspace_root).is_file()

    def config_paths(self, workspace_root: Path) -> list[Path]:
        return [self._settings_path(workspace_root)]

    def translate(self, pattern: str) -> str:
        return f"Bash({pattern.strip()}:*)"

    def untranslate(self, rule: str) -> str:
        inner = rule
        if inner.startswith("Bash(") and inner.endswith(")"):
            inner = inner[len("Bash(") : -1]
        inner = inner.removesuffix(":*")
        return inner

    def _load(self, settings_path: Path) -> dict:
        if not settings_path.is_file():
            return {}
        try:
            with open(settings_path, encoding="utf-8") as f:
                return json.load(f)
        except Exception as e:
            die(f"[{self.name}] error reading {settings_path}: {e}")

    def _save(self, workspace_root: Path, data: dict) -> None:
        settings_path = self._settings_path(workspace_root)
        created = not settings_path.is_file()
        settings_path.parent.mkdir(parents=True, exist_ok=True)
        try:
            with open(settings_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
                f.write("\n")
        except Exception as e:
            die(f"[{self.name}] error writing {settings_path}: {e}")
        if created:
            print(
                f"[{self.name} ({self.scope})] initialized {settings_path}",
                file=sys.stderr,
            )
        sync_git_exclude(workspace_root)

    def add(self, workspace_root: Path, pattern: str, mode: str) -> bool:
        rule = self.translate(pattern)
        data = self._load(self._settings_path(workspace_root))
        perms = data.setdefault("permissions", {})
        target_list = perms.setdefault(mode, [])
        if rule in target_list:
            return False
        target_list.append(rule)
        self._save(workspace_root, data)
        return True

    def remove(self, workspace_root: Path, pattern: str) -> list[str]:
        settings_path = self._settings_path(workspace_root)
        if not settings_path.is_file():
            return []
        rule = self.translate(pattern)
        data = self._load(settings_path)
        perms = data.get("permissions", {})
        removed = []
        for mode in MODES:
            lst = perms.get(mode)
            if lst and rule in lst:
                lst.remove(rule)
                removed.append(mode)
        if removed:
            self._save(workspace_root, data)
        return removed

    def _user_settings_path(self) -> Path:
        return CLAUDE_CONFIG_DIR / "settings.json"

    def rules(self, workspace_root: Path) -> dict[str, list[str]]:
        settings_path = self._settings_path(workspace_root)
        if not settings_path.is_file():
            return {}
        data = self._load(settings_path)
        perms = data.get("permissions", {})
        return {
            mode: [
                self.untranslate(r)
                for r in perms.get(mode) or []
                if r.startswith("Bash(")
            ]
            for mode in MODES
        }

    def rules_in(self, path: Path) -> dict[str, list[str]]:
        if not path.is_file():
            return {}
        data = self._load(path)
        perms = data.get("permissions", {})
        return {
            mode: [
                self.untranslate(rule)
                for rule in perms.get(mode) or []
                if rule.startswith("Bash(")
            ]
            for mode in MODES
        }

    def add_path(
        self,
        workspace_root: Path,
        target_path: Path,
        access: str = "all",
        scope: str = "user",
    ) -> bool:
        target_str = str(target_path).rstrip("/")
        settings_path = (
            self._user_settings_path()
            if scope == "user"
            else self._settings_path(workspace_root)
        )
        data = self._load(settings_path)
        perms = data.setdefault("permissions", {})
        dirs = perms.setdefault("additionalDirectories", [])
        added_any = False
        if target_str not in dirs:
            dirs.append(target_str)
            added_any = True

        allow_list = perms.setdefault("allow", [])
        r_rule = f"Read({target_str}/**)"
        # Claude Code matches file paths only against Edit rules (which
        # cover Write too); drop the legacy Write rule older versions added.
        w_rule = f"Edit({target_str}/**)"
        legacy_w_rule = f"Write({target_str}/**)"
        if legacy_w_rule in allow_list:
            allow_list.remove(legacy_w_rule)
            added_any = True
        if r_rule not in allow_list:
            allow_list.append(r_rule)
            added_any = True
        if access == "all" and w_rule not in allow_list:
            allow_list.append(w_rule)
            added_any = True

        if added_any:
            settings_path.parent.mkdir(parents=True, exist_ok=True)
            with open(settings_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
                f.write("\n")
            if scope != "user":
                sync_git_exclude(workspace_root)
        return added_any

    def remove_path(
        self, workspace_root: Path, target_path: Path, scope: str = "user"
    ) -> bool:
        target_str = str(target_path).rstrip("/")
        rules_to_remove = {
            f"Read({target_str}/**)",
            f"Edit({target_str}/**)",
            f"Write({target_str}/**)",
        }
        removed_any = False
        for s_path in (
            self._user_settings_path(),
            self._settings_path(workspace_root),
        ):
            if not s_path.is_file():
                continue
            data = self._load(s_path)
            perms = data.get("permissions", {})
            changed = False
            dirs = perms.get("additionalDirectories")
            if dirs and target_str in dirs:
                dirs.remove(target_str)
                changed = True
                removed_any = True
            allow_list = perms.get("allow")
            if allow_list:
                before = len(allow_list)
                allow_list[:] = [r for r in allow_list if r not in rules_to_remove]
                if len(allow_list) != before:
                    changed = True
                    removed_any = True
            if changed:
                with open(s_path, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=2)
                    f.write("\n")
        return removed_any

    def paths(self, workspace_root: Path) -> list[dict]:
        path_map: dict[str, dict] = {}
        for s_path, scope in (
            (self._user_settings_path(), "user"),
            (self._settings_path(workspace_root), "workspace"),
        ):
            if not s_path.is_file():
                continue
            data = self._load(s_path)
            perms = data.get("permissions", {})
            for d in perms.get("additionalDirectories") or []:
                info = path_map.setdefault(
                    d, {"read": True, "write": True, "scope": scope}
                )
            for r in perms.get("allow") or []:
                if r.startswith("Read(") and r.endswith("/**)"):
                    p = r[len("Read(") : -len("/**)")]
                    path_map.setdefault(
                        p, {"read": True, "write": False, "scope": scope}
                    )["read"] = True
                elif r.startswith(("Edit(", "Write(")) and r.endswith("/**)"):
                    p = r[r.index("(") + 1 : -len("/**)")]
                    path_map.setdefault(
                        p, {"read": False, "write": True, "scope": scope}
                    )["write"] = True
        result = []
        for p_str, info in sorted(path_map.items()):
            access = "read, write" if info.get("write") else "read-only"
            result.append(
                {
                    "path": p_str,
                    "access": access,
                    "scope": info.get("scope", "user"),
                }
            )
        return result

    def clean(self, workspace_root: Path, kind: str = "all") -> None:
        settings_path = self._settings_path(workspace_root)
        if settings_path.is_file():
            data = self._load(settings_path)
            perms = data.get("permissions")
            if perms:
                if kind == "cmd":
                    for mode in MODES:
                        perms[mode] = [
                            r
                            for r in perms.get(mode) or []
                            if not r.startswith("Bash(")
                        ]
                elif kind == "path":
                    perms.pop("additionalDirectories", None)
                    for mode in MODES:
                        perms[mode] = [
                            r
                            for r in perms.get(mode) or []
                            if not r.startswith(("Read(", "Edit(", "Write("))
                        ]
                else:
                    perms.pop("additionalDirectories", None)
                    for mode in MODES:
                        perms[mode] = []
                self._save(workspace_root, data)

        if kind in ("path", "all"):
            user_s_path = self._user_settings_path()
            if user_s_path.is_file():
                u_data = self._load(user_s_path)
                u_perms = u_data.get("permissions")
                if u_perms:
                    u_perms.pop("additionalDirectories", None)
                    for mode in MODES:
                        u_perms[mode] = [
                            r
                            for r in u_perms.get(mode) or []
                            if not r.startswith(("Read(", "Edit(", "Write("))
                        ]
                    with open(user_s_path, "w", encoding="utf-8") as f:
                        json.dump(u_data, f, indent=2)
                        f.write("\n")

        desc = (
            "command rules"
            if kind == "cmd"
            else ("path rules" if kind == "path" else "all permission rules")
        )
        print(
            f"[{self.name} ({self.scope})] cleared {desc}",
            file=sys.stderr,
        )

    def clean_paths(self, workspace_root: Path) -> None:
        self.clean(workspace_root, kind="path")


class CodexRulesAdapter(PermissionAdapter):
    """Codex CLI: workspace execution-policy rules in .codex/rules."""

    name = "codex"
    scope = "workspace"
    guard_mode = "ask"
    RULE_RE = re.compile(
        r'^prefix_rule\(pattern=(\[.*\]), decision=("(?:[^"\\]|\\.)*")\)$'
    )

    def _rules_path(self, workspace_root: Path) -> Path:
        return workspace_root / ".codex" / "rules" / "permission.rules"

    def config_paths(self, workspace_root: Path) -> list[Path]:
        return [self._rules_path(workspace_root)]

    def workspace_trust(self, workspace_root: Path) -> tuple[bool, str | None]:
        import tomllib

        config_path = CODEX_HOME / "config.toml"
        if not config_path.is_file():
            return False, None
        try:
            with open(config_path, "rb") as f:
                config = tomllib.load(f)
        except (OSError, tomllib.TOMLDecodeError) as e:
            return False, str(e)
        # Like Codex, consult the workspace's own entry first, then (for a
        # linked worktree only) the main checkout's; the first entry found
        # decides. A submodule's Git directory lives under .git/modules rather
        # than .git/worktrees, so it inherits nothing from its superproject.
        trust_roots = [workspace_root.resolve()]
        try:
            result = subprocess.run(
                [
                    "git",
                    "-C",
                    str(workspace_root),
                    "rev-parse",
                    "--path-format=absolute",
                    "--git-dir",
                    "--git-common-dir",
                ],
                capture_output=True,
                text=True,
                check=True,
            )
            git_dir, common_dir = (
                Path(line).resolve() for line in result.stdout.splitlines()[:2]
            )
            if git_dir != common_dir and git_dir.parent.name == "worktrees":
                trust_roots.append(common_dir.parent)
        except (FileNotFoundError, subprocess.CalledProcessError, ValueError):
            pass
        projects = config.get("projects") or {}
        for root in trust_roots:
            project = projects.get(str(root))
            if isinstance(project, dict) and "trust_level" in project:
                return project["trust_level"] == "trusted", None
        return False, None

    def is_available(self, workspace_root: Path) -> bool:
        import shutil

        return bool(
            (shutil.which("codex") and CODEX_HOME.is_dir())
            or self.is_initialized(workspace_root)
        )

    def is_initialized(self, workspace_root: Path) -> bool:
        return self._rules_path(workspace_root).is_file()

    @staticmethod
    def _decision(mode: str) -> str:
        return {"allow": "allow", "ask": "prompt", "deny": "forbidden"}[mode]

    @staticmethod
    def _mode(decision: str) -> str:
        return {"allow": "allow", "prompt": "ask", "forbidden": "deny"}[decision]

    def _parse_rule_line(self, line: str) -> tuple[list[str], str]:
        match = self.RULE_RE.fullmatch(line)
        if not match:
            raise ValueError(f"unrecognized managed rule: {line}")
        tokens = json.loads(match.group(1))
        decision = json.loads(match.group(2))
        if (
            not isinstance(tokens, list)
            or not tokens
            or not all(isinstance(token, str) for token in tokens)
        ):
            raise ValueError("prefix_rule pattern must be a non-empty string list")
        return tokens, decision

    def _load_rules(self, path: Path) -> dict[str, list[str]]:
        result = {mode: [] for mode in MODES}
        if not path.is_file():
            return result
        try:
            for line in path.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                tokens, decision = self._parse_rule_line(line)
                mode = self._mode(decision)
                result[mode].append(shlex.join(tokens))
        except (OSError, ValueError, KeyError, TypeError) as e:
            die(f"[{self.name}] error reading {path}: {e}")
        return result

    def _save_rules(self, workspace_root: Path, rules: dict[str, list[str]]) -> None:
        path = self._rules_path(workspace_root)
        entries = [
            (mode, pattern)
            for mode in MODES
            for pattern in sorted(set(rules.get(mode) or []))
        ]
        path.parent.mkdir(parents=True, exist_ok=True)
        lines = ["# Managed by 'permission'. Edit rules with the permission command."]
        for mode, pattern in entries:
            tokens = shlex.split(pattern)
            lines.append(
                "prefix_rule(pattern="
                f"{json.dumps(tokens)}, decision={json.dumps(self._decision(mode))})"
            )
        fd, temp_path_str = tempfile.mkstemp(dir=str(path.parent))
        temp_path = Path(temp_path_str)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write("\n".join(lines) + "\n")
            os.replace(temp_path, path)
        except Exception:
            temp_path.unlink(missing_ok=True)
            raise
        sync_git_exclude(workspace_root)

    def _parse_pattern(self, pattern: str) -> tuple[list[str], str]:
        try:
            tokens = shlex.split(pattern.strip())
        except ValueError as e:
            die(f"[{self.name}] invalid command pattern {pattern!r}: {e}")
        return tokens, shlex.join(tokens)

    def add(self, workspace_root: Path, pattern: str, mode: str) -> bool:
        tokens, clean = self._parse_pattern(pattern)
        if not tokens:
            return False
        rules = self._load_rules(self._rules_path(workspace_root))
        if clean in rules[mode]:
            return False
        for other_mode in MODES:
            if clean in rules[other_mode]:
                rules[other_mode].remove(clean)
        rules[mode].append(clean)
        self._save_rules(workspace_root, rules)
        return True

    def remove(self, workspace_root: Path, pattern: str) -> list[str]:
        _, clean = self._parse_pattern(pattern)
        rules = self._load_rules(self._rules_path(workspace_root))
        removed = []
        for mode in MODES:
            if clean in rules[mode]:
                rules[mode].remove(clean)
                removed.append(mode)
        if removed:
            self._save_rules(workspace_root, rules)
        return removed

    def rules(self, workspace_root: Path) -> dict[str, list[str]]:
        return (
            self._load_rules(self._rules_path(workspace_root))
            if self.is_initialized(workspace_root)
            else {}
        )

    def rules_in(self, path: Path) -> dict[str, list[str]]:
        return self._load_rules(path) if path.is_file() else {}

    def _trusted_folders_path(self) -> Path:
        home = Path.home()
        if (AGY_CONFIG_DIR / "trustedFolders.json").is_file():
            return AGY_CONFIG_DIR / "trustedFolders.json"
        return home / ".gemini" / "trustedFolders.json"

    def add_path(
        self,
        workspace_root: Path,
        target_path: Path,
        access: str = "all",
        scope: str = "user",
    ) -> bool:
        target_str = str(target_path).rstrip("/")
        tf_path = self._trusted_folders_path()
        data = {}
        if tf_path.is_file():
            try:
                with open(tf_path, encoding="utf-8") as f:
                    data = json.load(f)
            except Exception:
                data = {}
        if data.get(target_str) == "TRUST_FOLDER":
            return False
        data[target_str] = "TRUST_FOLDER"
        tf_path.parent.mkdir(parents=True, exist_ok=True)
        temp_fd, temp_path_str = tempfile.mkstemp(dir=str(tf_path.parent))
        temp_path = Path(temp_path_str)
        try:
            with os.fdopen(temp_fd, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
                f.write("\n")
            os.replace(temp_path, tf_path)
        except Exception:
            temp_path.unlink(missing_ok=True)
            raise
        return True

    def remove_path(
        self, workspace_root: Path, target_path: Path, scope: str = "user"
    ) -> bool:
        target_str = str(target_path).rstrip("/")
        tf_path = self._trusted_folders_path()
        if not tf_path.is_file():
            return False
        try:
            with open(tf_path, encoding="utf-8") as f:
                data = json.load(f)
        except Exception:
            return False
        if target_str in data:
            del data[target_str]
            tf_path.parent.mkdir(parents=True, exist_ok=True)
            with open(tf_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
                f.write("\n")
            return True
        return False

    def paths(self, workspace_root: Path) -> list[dict]:
        tf_path = self._trusted_folders_path()
        if not tf_path.is_file():
            return []
        try:
            with open(tf_path, encoding="utf-8") as f:
                data = json.load(f)
        except Exception:
            return []
        return [
            {"path": p, "access": "read, write", "scope": "user"}
            for p, val in sorted(data.items())
            if val == "TRUST_FOLDER"
        ]

    def clean_paths(self, workspace_root: Path) -> None:
        tf_path = self._trusted_folders_path()
        if tf_path.is_file():
            try:
                tf_path.unlink()
            except OSError:
                pass

    def clean(self, workspace_root: Path, kind: str = "all") -> None:
        if kind in ("cmd", "all"):
            path = self._rules_path(workspace_root)
            if path.is_file():
                path.unlink()
                try:
                    path.parent.rmdir()
                except OSError:
                    pass
                sync_git_exclude(workspace_root)
        if kind in ("path", "all"):
            self.clean_paths(workspace_root)
        desc = (
            "command rules"
            if kind == "cmd"
            else ("path rules" if kind == "path" else "all permission rules")
        )
        print(
            f"[{self.name} ({self.scope})] cleared {desc}",
            file=sys.stderr,
        )


ADAPTERS: list[PermissionAdapter] = [
    AgySettingsAdapter(),
    ClaudeSettingsAdapter(),
    CodexRulesAdapter(),
]


def select_adapters(agent: str | None, workspace_root: Path) -> list[PermissionAdapter]:
    """Returns the adapters to operate on: the one named by --agent, or every
    adapter whose agent appears to be in use. May be empty; commands that
    cannot proceed without one should call require_adapters instead."""
    if agent:
        target = "agy" if agent in ("jetski", "jetski-web") else agent
        matches = [a for a in ADAPTERS if a.name == target]
        if not matches:
            names = ", ".join(
                sorted({a.name for a in ADAPTERS} | {"jetski", "jetski-web"})
            )
            die(f"unknown agent '{agent}' (expected one of: {names})")
        if target == "agy":
            return [AgySettingsAdapter(target_agent=agent)]
        return matches
    return [a for a in ADAPTERS if a.is_available(workspace_root)]


def require_adapters(
    agent: str | None, workspace_root: Path
) -> list[PermissionAdapter]:
    adapters = select_adapters(agent, workspace_root)
    if not adapters:
        die(
            "no supported agent configuration found "
            f"(looked for {AGY_CONFIG_DIR}, {CLAUDE_CONFIG_DIR}, and {CODEX_HOME}); "
            "use --agent to force one"
        )
    return adapters


# ==============================================================================
# Safe-command computation ('apply' / 'doctor')
# ==============================================================================


def parse_unsafe_file(skill_dir: Path) -> list[str]:
    unsafe_file = skill_dir / "permissions" / "unsafe"
    if not unsafe_file.is_file():
        return []
    lines = []
    with open(unsafe_file, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                lines.append(line)
    return lines


def compute_skill_rules(name: str, skill_dir: Path) -> tuple[list[str], list[str]]:
    """Returns (allow, guard) clean patterns for one skill.

    Every executable in the skill's scripts/ directory is pre-approved unless
    listed in the skill's permissions/unsafe file. Whole-script unsafe lines
    suppress the allow rule (the command prompts normally); subcommand lines
    keep the blanket allow but add a guard rule (ask or deny, per agent).
    """
    scripts_dir = skill_dir / "scripts"
    if not scripts_dir.is_dir():
        return [], []
    scripts = sorted(
        p.name
        for p in scripts_dir.iterdir()
        if p.is_file() and not p.name.startswith(".") and os.access(p, os.X_OK)
    )
    unsafe = parse_unsafe_file(skill_dir)

    unsafe_whole = {line for line in unsafe if " " not in line}
    for line in unsafe:
        base = line.split()[0]
        if base not in scripts:
            print(
                f"permission: warning: {name}: unsafe entry '{line}' does not "
                f"match any script in {scripts_dir}",
                file=sys.stderr,
            )

    allow = [s for s in scripts if s not in unsafe_whole]
    guard = [line for line in unsafe if " " in line]
    return allow, guard


def compute_workspace_rules() -> tuple[list[str], list[str]]:
    """Aggregates (allow, guard) patterns over all installed skills."""
    res = subprocess.run(
        [SKILL_BIN, "list", "--json"], capture_output=True, text=True, check=False
    )
    if res.returncode != 0:
        print(res.stderr, file=sys.stderr, end="")
        die("'skill list' failed")
    try:
        entries = json.loads(res.stdout or "[]")
    except json.JSONDecodeError as e:
        die(f"could not parse 'skill list --json' output: {e}")

    allow: list[str] = []
    guard: list[str] = []
    for entry in entries:
        name = entry.get("name")
        path = entry.get("path")
        if not path:
            print(
                f"permission: warning: skipping {name}: not linked "
                "(run 'skill add --defaults' to clear broken links)",
                file=sys.stderr,
            )
            continue
        a, g = compute_skill_rules(name, Path(path))
        allow.extend(a)
        guard.extend(g)
    return sorted(set(allow)), sorted(set(guard))


def parse_paths_file(skill_dir: Path) -> list[str]:
    paths_file = skill_dir / "permissions" / "paths"
    if not paths_file.is_file():
        return []
    lines = []
    with open(paths_file, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                lines.append(line)
    return lines


def compute_workspace_paths() -> list[str]:
    """Aggregates declared paths over all installed skills."""
    res = subprocess.run(
        [SKILL_BIN, "list", "--json"], capture_output=True, text=True, check=False
    )
    if res.returncode != 0:
        return []
    try:
        entries = json.loads(res.stdout or "[]")
    except json.JSONDecodeError:
        return []
    paths: list[str] = []
    for entry in entries:
        p = entry.get("path")
        if p:
            paths.extend(parse_paths_file(Path(p)))
    return sorted(set(paths))


def cmd_apply(agent: str | None):
    ws = get_workspace_root()
    adapters = select_adapters(agent, ws)
    if not adapters:
        print("apply: no supported agents detected; nothing to do", file=sys.stderr)
        return
    allow, guard = compute_workspace_rules()
    declared_paths = compute_workspace_paths()
    if not allow and not guard and not declared_paths:
        print(
            "apply: no installed skills declare any commands or paths "
            "(run 'skill add --defaults' to install skills first)",
            file=sys.stderr,
        )
        return

    for adapter in adapters:
        added_allow = sum(adapter.add(ws, p, "allow") for p in allow)
        added_guard = sum(adapter.add(ws, p, adapter.guard_mode) for p in guard)
        added_paths = 0
        for dp in declared_paths:
            exp = Path(os.path.expanduser(os.path.expandvars(dp))).resolve()
            if adapter.add_path(ws, exp, access="all", scope="user"):
                added_paths += 1

        msg = (
            f"[{adapter.name} ({adapter.scope})] allow: {added_allow} added, "
            f"{len(allow) - added_allow} already present; "
            f"{adapter.guard_mode}: {added_guard} added"
        )
        if declared_paths:
            msg += (
                f"; paths: {added_paths} added, "
                f"{len(declared_paths) - added_paths} already present"
            )
        print(msg, file=sys.stderr)


def cmd_doctor(agent: str | None, stream=sys.stdout):
    ws = get_workspace_root()
    use_color = use_color_for(stream)

    def format_status(status: str) -> str:
        if status == "OK":
            return colorize("[PASS]", "green", use_color)
        if status == "WARN":
            return colorize("[WARN]", "yellow", use_color)
        return colorize("[FAIL]", "red", use_color)

    checks = []

    # 1. Workspace
    is_git = (ws / ".git").exists()
    ws_type = "Git repository" if is_git else "Non-VCS directory"
    checks.append(
        {
            "name": "Workspace",
            "status": "OK",
            "summary": ws_type,
            "details": [f"Root: {clean_p(ws)}"],
        }
    )

    # 2. Plugin Loading
    load_failures = load_plugins().load_failures
    if load_failures:
        checks.append(
            {
                "name": "Plugin Loading",
                "status": "FAIL",
                "summary": f"Found {len(load_failures)} plugin(s) that failed to load",
                "details": [
                    f"Failed to load {name}: {err}" for name, err in load_failures
                ]
                + ["To resolve: fix or remove the failing plugin file(s)"],
            }
        )
    else:
        checks.append(
            {
                "name": "Plugin Loading",
                "status": "OK",
                "summary": "All plugins loaded successfully",
                "details": [],
            }
        )

    # 3. Agent Detection & Selection
    adapters = select_adapters(agent, ws)
    if not adapters:
        checks.append(
            {
                "name": "Agent Configuration",
                "status": "WARN",
                "summary": "No supported agent configuration found",
                "details": [
                    f"Looked for: {clean_p(AGY_CONFIG_DIR)}, {clean_p(CLAUDE_CONFIG_DIR)}, and {clean_p(CODEX_HOME)}",
                    "To resolve: install an agent CLI or use '--agent NAME' to force one",
                ],
            }
        )
    else:
        agent_names = ", ".join(f"{a.name} ({a.scope})" for a in adapters)
        checks.append(
            {
                "name": "Agent Configuration",
                "status": "OK",
                "summary": f"Active backend(s): {agent_names}",
                "details": [],
            }
        )

    # 4. Installed Skills & Declared Rules
    allow, guard = compute_workspace_rules()
    total_declared = len(allow) + len(guard)
    checks.append(
        {
            "name": "Installed Skills",
            "status": "OK",
            "summary": f"Found {total_declared} declared command(s) across installed skills",
            "details": [f"Declared: {len(allow)} allow, {len(guard)} guard (ask)"],
        }
    )

    # 5. Check permissions for each adapter
    for adapter in adapters:
        settings_paths = adapter.config_paths(ws)

        is_init = adapter.is_initialized(ws)
        if not is_init and (allow or guard):
            target_path = clean_p(settings_paths[0]) if settings_paths else "settings"
            checks.append(
                {
                    "name": f"Permissions ({adapter.name})",
                    "status": "FAIL",
                    "summary": f"Not initialized in {target_path}",
                    "details": [
                        f"Resolved: {clean_p(p)} (missing)" for p in settings_paths
                    ]
                    + [f"missing allow: {p}" for p in allow]
                    + [f"missing {adapter.guard_mode}: {p}" for p in guard]
                    + ["To resolve: run 'permission apply'"],
                }
            )
            continue

        for p in settings_paths:
            p_display = clean_p(p)
            if not p.is_file():
                if allow or guard:
                    checks.append(
                        {
                            "name": f"Permissions ({adapter.name})",
                            "status": "FAIL",
                            "summary": f"Settings file not created: {p_display}",
                            "details": [
                                f"Resolved: {p_display} (missing)",
                                "To resolve: run 'permission apply'",
                            ],
                        }
                    )
                continue

            perms = adapter.rules_in(p)
            p_allow = set(perms.get("allow") or [])
            p_guarded = set((perms.get("deny") or []) + (perms.get("ask") or []))
            p_missing_allow = [x for x in allow if x not in p_allow]
            p_missing_guard = [x for x in guard if x not in p_guarded]

            a_count = len(perms.get("allow") or [])
            ask_count = len(perms.get("ask") or [])
            deny_count = len(perms.get("deny") or [])

            if p_missing_allow or p_missing_guard:
                checks.append(
                    {
                        "name": f"Permissions ({adapter.name})",
                        "status": "FAIL",
                        "summary": f"Missing {len(p_missing_allow) + len(p_missing_guard)} rule(s) in {p_display}",
                        "details": [
                            f"Settings: {p_display} ({a_count} allow, {ask_count} ask, {deny_count} deny)"
                        ]
                        + [f"missing allow: {x}" for x in p_missing_allow]
                        + [
                            f"missing {adapter.guard_mode}: {x}"
                            for x in p_missing_guard
                        ]
                        + ["To resolve: run 'permission apply'"],
                    }
                )
            else:
                checks.append(
                    {
                        "name": f"Permissions ({adapter.name})",
                        "status": "OK",
                        "summary": f"All {total_declared} expected rules configured in {p_display}",
                        "details": [
                            f"Settings: {p_display} ({a_count} allow, {ask_count} ask, {deny_count} deny)"
                        ],
                    }
                )

        # 6. Syntax check for Agy/Jetski: legacy literal rules vs regex
        if isinstance(adapter, AgySettingsAdapter):
            declared_set = set(allow) | set(guard)
            for p in settings_paths:
                if not p.is_file():
                    continue
                data = adapter._load(p)
                declared_legacy = []
                other_legacy = []
                for mode in MODES:
                    for r in adapter._perms(data, p).get(mode) or []:
                        if r.startswith("command(") and not r.startswith(
                            "command(regex:"
                        ):
                            untranslated = adapter.untranslate(r)
                            if untranslated in declared_set:
                                declared_legacy.append(r)
                            else:
                                other_legacy.append(r)

                p_display = clean_p(p)
                if declared_legacy:
                    checks.append(
                        {
                            "name": f"Rule Syntax ({adapter.name})",
                            "status": "WARN",
                            "summary": f"Found {len(declared_legacy)} declared rule(s) using legacy literal syntax in {p_display}",
                            "details": [f"Legacy: {r}" for r in declared_legacy[:5]]
                            + (
                                [f"... and {len(declared_legacy) - 5} more"]
                                if len(declared_legacy) > 5
                                else []
                            )
                            + [
                                "To resolve: run 'permission apply' to upgrade rules to regex format"
                            ],
                        }
                    )
                else:
                    details = (
                        [
                            f"External rules: {len(other_legacy)} non-workspace rule(s) using literal syntax in {p_display}"
                        ]
                        if other_legacy
                        else []
                    )
                    checks.append(
                        {
                            "name": f"Rule Syntax ({adapter.name})",
                            "status": "OK",
                            "summary": f"All declared rules use path-independent regex format in {p_display}",
                            "details": details,
                        }
                    )

        # 7. Codex only loads project rules for trusted workspaces.
        if isinstance(adapter, CodexRulesAdapter) and is_init:
            trusted, trust_error = adapter.workspace_trust(ws)
            if trusted:
                checks.append(
                    {
                        "name": "Workspace Trust (codex)",
                        "status": "OK",
                        "summary": "Workspace is trusted",
                        "details": [],
                    }
                )
            else:
                details = []
                if trust_error:
                    details.append(
                        f"Could not read {clean_p(CODEX_HOME / 'config.toml')}: {trust_error}"
                    )
                details.append("To resolve: trust this project in Codex")
                checks.append(
                    {
                        "name": "Workspace Trust (codex)",
                        "status": "WARN",
                        "summary": "Workspace rules will not load until the project is trusted",
                        "details": details,
                    }
                )

        # 8. Workspace exclusions check for workspace-local adapters
        if isinstance(adapter, (ClaudeSettingsAdapter, CodexRulesAdapter)) and is_init:
            relative_path = (
                ".claude/settings.local.json"
                if isinstance(adapter, ClaudeSettingsAdapter)
                else ".codex/rules/permission.rules"
            )
            is_ignored = False
            try:
                res = subprocess.run(
                    [
                        "git",
                        "-C",
                        str(ws),
                        "check-ignore",
                        "-q",
                        relative_path,
                    ],
                    capture_output=True,
                    check=False,
                )
                is_ignored = res.returncode == 0
            except Exception:
                pass
            if is_ignored:
                checks.append(
                    {
                        "name": "Workspace Exclusions",
                        "status": "OK",
                        "summary": f"{relative_path} is git-ignored",
                        "details": [],
                    }
                )
            else:
                checks.append(
                    {
                        "name": "Workspace Exclusions",
                        "status": "WARN",
                        "summary": f"{relative_path} is not git-ignored",
                        "details": [
                            "To resolve: run 'permission apply' to update .git/info/exclude"
                        ],
                    }
                )

    fail = any(c["status"] == "FAIL" for c in checks)
    warn = any(c["status"] == "WARN" for c in checks)

    for check in checks:
        print(
            f"{format_status(check['status'])} {check['name']}: {check['summary']}",
            file=stream,
        )
        for line in check["details"]:
            print(f"    {line}", file=stream)

    print(file=stream)
    if fail:
        print(
            f"{format_status('FAIL')}  Workspace permissions have issues. Run 'permission apply' to synchronize.",
            file=stream,
        )
        sys.exit(1)
    elif warn:
        print(
            f"{format_status('WARN')}  Workspace permissions have warnings. Run 'permission apply' to synchronize.",
            file=stream,
        )
        sys.exit(1)
    else:
        print(
            f"{format_status('OK')}  Workspace permissions are healthy and fully synchronized.",
            file=stream,
        )


# ==============================================================================
# CLI
# ==============================================================================


def read_patterns(args: list[str]) -> list[str]:
    if args == ["-"]:
        return [line.strip() for line in sys.stdin if line.strip()]
    return args


def cmd_cmd_add(patterns: list[str], mode: str, agent: str | None):
    if not patterns:
        print("permission cmd add: pattern required", file=sys.stderr)
        print("Try 'permission cmd add --help' for more information.", file=sys.stderr)
        sys.exit(1)
    ws = get_workspace_root()
    for adapter in require_adapters(agent, ws):
        for pattern in patterns:
            if adapter.add(ws, pattern, mode):
                print(
                    f"[{adapter.name} ({adapter.scope})] added to {mode}: {pattern}",
                    file=sys.stderr,
                )
            else:
                print(
                    f"[{adapter.name} ({adapter.scope})] already in {mode} (or unsupported): {pattern}",
                    file=sys.stderr,
                )


def cmd_cmd_remove(patterns: list[str], agent: str | None):
    if not patterns:
        print("permission cmd remove: pattern required", file=sys.stderr)
        print(
            "Try 'permission cmd remove --help' for more information.", file=sys.stderr
        )
        sys.exit(1)
    ws = get_workspace_root()
    for adapter in require_adapters(agent, ws):
        if not adapter.is_initialized(ws):
            continue
        for pattern in patterns:
            removed = adapter.remove(ws, pattern)
            for mode in removed:
                print(
                    f"[{adapter.name} ({adapter.scope})] removed from {mode}: {pattern}",
                    file=sys.stderr,
                )
            if not removed:
                print(
                    f"[{adapter.name} ({adapter.scope})] not found: {pattern}",
                    file=sys.stderr,
                )


def cmd_cmd_list(agent: str | None):
    ws = get_workspace_root()
    has_any = False
    for adapter in select_adapters(agent, ws):
        if not adapter.is_initialized(ws):
            continue
        rules = adapter.rules(ws)
        if not any(rules.get(m) for m in MODES):
            continue
        print(f"[{adapter.name} ({adapter.scope})]")
        for mode in MODES:
            patterns = rules.get(mode)
            if patterns:
                print(f"  {mode}:")
                for p in patterns:
                    print(f"    {p}")
        has_any = True
    if not has_any:
        print("No command permission rules configured.", file=sys.stderr)


def cmd_path_add(raw_paths: list[str], access: str, scope: str, agent: str | None):
    if not raw_paths:
        print("permission path add: path required", file=sys.stderr)
        print("Try 'permission path add --help' for more information.", file=sys.stderr)
        sys.exit(1)
    ws = get_workspace_root()
    adapters = require_adapters(agent, ws)
    for p in raw_paths:
        expanded = Path(os.path.expanduser(os.path.expandvars(p))).resolve()
        for adapter in adapters:
            if adapter.add_path(ws, expanded, access=access, scope=scope):
                print(
                    f"[{adapter.name} ({scope})] granted {access}: {clean_p(expanded)}",
                    file=sys.stderr,
                )
            else:
                print(
                    f"[{adapter.name} ({scope})] already granted: {clean_p(expanded)}",
                    file=sys.stderr,
                )


def cmd_path_remove(raw_paths: list[str], scope: str, agent: str | None):
    if not raw_paths:
        print("permission path remove: path required", file=sys.stderr)
        print(
            "Try 'permission path remove --help' for more information.", file=sys.stderr
        )
        sys.exit(1)
    ws = get_workspace_root()
    adapters = require_adapters(agent, ws)
    for p in raw_paths:
        expanded = Path(os.path.expanduser(os.path.expandvars(p))).resolve()
        for adapter in adapters:
            if adapter.remove_path(ws, expanded, scope=scope):
                print(
                    f"[{adapter.name} ({scope})] removed path: {clean_p(expanded)}",
                    file=sys.stderr,
                )
            else:
                print(
                    f"[{adapter.name} ({scope})] path not found: {clean_p(expanded)}",
                    file=sys.stderr,
                )


def cmd_path_list(agent: str | None):
    ws = get_workspace_root()
    has_any = False
    for adapter in select_adapters(agent, ws):
        p_list = adapter.paths(ws)
        if not p_list:
            continue
        print(f"[{adapter.name} ({adapter.scope})]")
        print("  paths:")
        for item in p_list:
            print(f"    {clean_p(item['path'])} ({item['access']}) [{item['scope']}]")
        has_any = True
    if not has_any:
        print("No path permission rules configured.", file=sys.stderr)


def cmd_list(agent: str | None):
    ws = get_workspace_root()
    has_any = False
    for adapter in select_adapters(agent, ws):
        rules = adapter.rules(ws) if adapter.is_initialized(ws) else {}
        p_list = adapter.paths(ws)
        has_rules = any(rules.get(m) for m in MODES)
        if not has_rules and not p_list:
            continue
        print(f"[{adapter.name} ({adapter.scope})]")
        if has_rules:
            for mode in MODES:
                patterns = rules.get(mode)
                if patterns:
                    print(f"  {mode}:")
                    for p in patterns:
                        print(f"    {p}")
        if p_list:
            print("  paths:")
            for item in p_list:
                print(
                    f"    {clean_p(item['path'])} ({item['access']}) [{item['scope']}]"
                )
        has_any = True
    if not has_any:
        print("No permission rules configured.", file=sys.stderr)


def cmd_clean(kind: str, agent: str | None):
    ws = get_workspace_root()
    cleaned = False
    for adapter in select_adapters(agent, ws):
        adapter.clean(ws, kind=kind)
        cleaned = True
    if not cleaned:
        print("clean: nothing to do", file=sys.stderr)


HELP_MAIN = """Usage: permission <command> [arguments]

Manage agent tool and filesystem permissions across all detected local
agents (Jetski CLI & Web, Antigravity, Claude Code, and Codex).

Namespaces:
  cmd add PATTERN...       Add command patterns to allowlist (--deny / --ask)
  cmd remove PATTERN...    Remove command patterns (alias: rm)
  cmd list                 List command rules per agent (alias: ls)

  path add PATH...         Grant access to filesystem directories (--ro for read-only)
  path remove PATH...      Revoke filesystem directory access (alias: rm)
  path list                List granted paths per agent (alias: ls)

Commands:
  list                     List all permission rules (commands and paths; alias: ls)
  apply                    Pre-approve safe commands and paths from installed skills
  clean [cmd|path]         Clear configured permission rules (default: all)
  doctor                   Report missing or drifted rules across commands and paths

Options:
  --agent NAME             Operate on a single agent backend
                           (agy, jetski, jetski-web, claude, codex)
  --help                   Display this help message and exit
  --plugin-template        Output a template/documentation for creating a Permission plugin

Agents:
  agy, jetski,       Antigravity / Jetski CLI & Web. User-wide: rules live in
  jetski-web         ~/.gemini/antigravity-cli/settings.json (agy),
                     ~/.gemini/jetski/cli/settings.json (jetski CLI), and
                     ~/.gemini/config/config.json (jetski-web; also synced by
                     jetski when ~/.gemini/config exists) and apply to every
                     workspace. Command patterns become command(regex:...)
                     rules; native resource grants (e.g. read_file(*)) are
                     preserved verbatim. Path grants become read_file/write_file
                     grants and enable allowNonWorkspaceAccess.
  claude             Claude Code. Workspace-local for commands (.claude/settings.local.json);
                     path grants update additionalDirectories and Read/Write rules
                     (workspace-local or user-wide via --global in ~/.claude/settings.json).
                     Patterns become Bash(PATTERN:*) prefix rules; deny beats ask
                     beats allow. 'allow' only skips the approval prompt and
                     leaves Claude Code's sandbox settings unchanged.
  codex              Codex CLI. Workspace-local: rules live in the untracked
                     .codex/rules/permission.rules, which Codex loads only for
                     trusted projects. Path grants update
                     ~/.gemini/trustedFolders.json. Patterns become prefix_rule()
                     token prefixes; ask and deny map to Codex's prompt and
                     forbidden, and the most restrictive match wins. 'allow'
                     also runs the command outside the Codex sandbox without
                     prompting, a stronger grant than the other agents give."""

