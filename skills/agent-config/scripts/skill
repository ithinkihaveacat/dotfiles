def die(msg):
    print(f"skill: {msg}", file=sys.stderr)
    sys.exit(1)


def cmderr(cmd, msg, code=1):
    print(f"skill {cmd}: {msg}", file=sys.stderr)
    sys.exit(code)


def clean_p(p):
    home = str(Path.home())
    s = str(p)
    if s.startswith(home):
        return "~" + s[len(home) :]
    return s


def age_human(path: Path) -> str:
    """How long ago PATH was last written, for qualifying a cached answer."""
    try:
        age = time.time() - path.stat().st_mtime
    except OSError:
        return "unknown age"
    for limit, unit, size in (
        (3600, "minute", 60),
        (86400, "hour", 3600),
        (None, "day", 86400),
    ):
        if limit is None or age < limit:
            n = int(age // size)
            if n < 1 and unit == "minute":
                return "just now"
            return f"{n} {unit} ago" if n == 1 else f"{n} {unit}s ago"
    return "unknown age"


_SCOPE: str = "workspace"


def prune_dirs(dest_dirs):
    user_claude = Path.home() / ".claude"
    for d in dest_dirs:
        try:
            if d.is_dir() and not any(d.iterdir()):
                d.rmdir()
            parent = d.parent
            if (
                parent != user_claude
                and parent.name in (".agents", ".claude")
                and parent.is_dir()
                and not any(parent.iterdir())
            ):
                parent.rmdir()
        except Exception:
            pass


def print_workspace_root(ws, stream=sys.stderr) -> None:
    """Announce the resolved workspace root before a mutating operation.

    The skill-anchor walk (see find_skill_anchor) can bind the workspace to an
    ancestor of the current directory, so symlinks created by 'add' (and removed
    by 'remove'/'clean') may land somewhere other than where the command was
    run. Print that resolved location to stderr (it is status, not data) and
    flag the redirect explicitly when the anchor sits above the current
    directory.
    """
    root = ws.root
    if ws.scope != "workspace":
        print(f"skill: {ws.scope} root: {clean_p(root)}", file=stream)
        return
    cwd = Path.cwd().resolve()
    if root == cwd:
        print(f"skill: workspace root: {clean_p(root)}", file=stream)
    else:
        print(
            f"skill: workspace root: {clean_p(root)} "
            f"(anchor above current directory {clean_p(cwd)})",
            file=stream,
        )


def anchor_subdirs() -> list[str]:
    """The skill destination subpaths that mark a directory as a workspace anchor."""
    if "SKILL_DEST_DIRS" in os.environ:
        return [d for d in os.environ["SKILL_DEST_DIRS"].split(":") if d]
    return list(Workspace.get_supported_configs().keys())


def find_skill_anchor(start: Path, boundary: Path) -> Path:
    """Resolve the workspace anchor the way an agent discovers project skills.

    Agents (Claude, Codex) load skills from the starting directory and every
    parent directory up to the repository root. To keep 'skill' aligned with
    that behavior, we walk from 'start' up to and including 'boundary' (the repo
    root) and bind to the nearest ancestor that already contains a skills
    directory. If none exists yet, we fall back to 'boundary' so a fresh 'add'
    installs once at the repo root, where an agent launched anywhere below will
    discover it.
    """
    subdirs = anchor_subdirs()
    chain = [start]
    cur = start
    while cur != boundary and boundary in cur.parents:
        cur = cur.parent
        chain.append(cur)
    for d in chain:  # nearest first
        if any((d / sd).is_dir() for sd in subdirs):
            return d
    return boundary


# ==============================================================================
# Workspace Abstractions
# ==============================================================================


COPY_IGNORE_PATTERNS = (
    ".git",
    "__pycache__",
    ".ruff_cache",
    ".pytest_cache",
    ".DS_Store",
    ".SKILL.md.tmp-*",
)


def _unquote_scalar(raw: str) -> str:
    val = raw.strip()
    if len(val) >= 2 and val[0] == '"' and val[-1] == '"':
        try:
            res = json.loads(val)
            if isinstance(res, str):
                return res
        except Exception:
            return val[1:-1]
    if len(val) >= 2 and val[0] == "'" and val[-1] == "'":
        return val[1:-1].replace("''", "'")
    for i, ch in enumerate(val):
        if ch == "#" and (i == 0 or val[i - 1] in (" ", "\t")):
            return val[:i].rstrip()
    return val


def read_copy_source_from_content(content: str) -> str | None:
    """Return metadata.source from a managed copy's SKILL.md frontmatter."""
    lines = content.splitlines()
    if not lines or lines[0].strip() != "---":
        return None
    end = next(
        (
            i
            for i in range(1, len(lines))
            if not lines[i].startswith((" ", "\t"))
            and lines[i].strip() in ("---", "...")
        ),
        None,
    )
    if end is None:
        return None
    fm = lines[1:end]
    for i, line in enumerate(fm):
        s = line.strip()
        if (
            not s
            or s.startswith("#")
            or line.startswith((" ", "\t"))
            or ":" not in line
        ):
            continue
        if _unquote_scalar(line.split(":", 1)[0]) != "metadata":
            continue
        child_indent: str | None = None
        for b in fm[i + 1 :]:
            bs = b.strip()
            if not bs or bs.startswith("#"):
                continue
            if not b.startswith((" ", "\t")):
                break
            ind = b[: len(b) - len(b.lstrip(" \t"))]
            if child_indent is None:
                child_indent = ind
            if ind == child_indent and ":" in bs:
                ck, cv = bs.split(":", 1)
                if _unquote_scalar(ck) == "source":
                    res = _unquote_scalar(cv)
                    if res and res not in (">", "|", ">-", "|-", ">+", "|+"):
                        return res
        return None
    return None


def inject_copy_source(content: str, source: str) -> str:
    """Stamp metadata.source into SKILL.md frontmatter in canonical block form."""
    src_json = json.dumps(source, ensure_ascii=False)
    eol = "\r\n" if content.startswith("---\r\n") else "\n"
    raw_lines = content.splitlines(keepends=True)
    end = None
    if raw_lines and raw_lines[0].rstrip("\r\n").strip() == "---":
        for i in range(1, len(raw_lines)):
            ln = raw_lines[i].rstrip("\r\n")
            if not ln.startswith((" ", "\t")) and ln.strip() in ("---", "..."):
                end = i
                break
    if end is None:
        body = content.lstrip("\r\n") if not content.strip() else content
        return f"---\nmetadata:\n  source: {src_json}\n---\n" + body

    fm = [ln.rstrip("\r\n") for ln in raw_lines[1:end]]
    fence = raw_lines[end].rstrip("\r\n").strip()
    rest = "".join(raw_lines[end + 1 :])

    meta_idx = next(
        (
            i
            for i, ln in enumerate(fm)
            if ln.strip()
            and not ln.strip().startswith("#")
            and not ln.startswith((" ", "\t"))
            and ":" in ln
            and _unquote_scalar(ln.split(":", 1)[0]) == "metadata"
        ),
        None,
    )
    if meta_idx is None:
        fm.extend(["metadata:", f"  source: {src_json}"])
    else:
        v_part = fm[meta_idx].split(":", 1)[1].strip()
        block_end = meta_idx + 1
        if v_part.startswith("{"):
            while block_end < len(fm) and "}" not in fm[block_end - 1]:
                block_end += 1
            flow_raw = " ".join(
                [v_part, *(ln.strip() for ln in fm[meta_idx + 1 : block_end])]
            )
            inner = flow_raw[flow_raw.find("{") + 1 : flow_raw.rfind("}")]
            kept = [
                f"  {_unquote_scalar(m.group(1))}: {m.group(2).strip()}"
                for m in re.finditer(
                    r"""(?:^|,)\s*(['"]?[\w.-]+['"]?)\s*:\s*("(?:\\.|[^"])*"|'(?:''|[^'])*'|[^,#}]+)""",
                    inner,
                )
                if _unquote_scalar(m.group(1)) != "source"
            ]
            fm[meta_idx:block_end] = ["metadata:", *kept, f"  source: {src_json}"]
        else:
            while block_end < len(fm) and (
                not fm[block_end].strip()
                or fm[block_end].strip().startswith("#")
                or fm[block_end].startswith((" ", "\t"))
            ):
                block_end += 1
            while block_end > meta_idx + 1 and not fm[block_end - 1].strip():
                block_end -= 1
            kept_block: list[str] = []
            child_indent: str | None = None
            b_i = meta_idx + 1
            while b_i < block_end:
                bl = fm[b_i]
                bs = bl.strip()
                if bs and not bs.startswith("#"):
                    ind = bl[: len(bl) - len(bl.lstrip(" \t"))]
                    if child_indent is None:
                        child_indent = ind
                    if (
                        ind == child_indent
                        and ":" in bs
                        and _unquote_scalar(bs.split(":", 1)[0]) == "source"
                    ):
                        b_i += 1
                        while b_i < block_end and (
                            not fm[b_i].strip()
                            or len(fm[b_i]) - len(fm[b_i].lstrip(" \t"))
                            > len(child_indent)
                        ):
                            b_i += 1
                        continue
                kept_block.append(bl)
                b_i += 1
            eff_indent = child_indent if child_indent is not None else "  "
            fm[meta_idx:block_end] = [
                "metadata:",
                *kept_block,
                f"{eff_indent}source: {src_json}",
            ]
    return eol.join(["---", *fm, fence]) + eol + rest


def read_copy_source(entry_dir: Path) -> Path | None:
    """Return the canonical skill directory for a managed skill copy, or None."""
    if entry_dir.is_symlink() or not entry_dir.is_dir():
        return None
    skill_md = entry_dir / "SKILL.md"
    if skill_md.is_symlink() or not skill_md.is_file():
        return None
    try:
        with open(skill_md, encoding="utf-8", errors="replace") as f:
            raw = read_copy_source_from_content(f.read(65536))
    except OSError:
        return None
    if not raw or not raw.startswith(("/", "~/")):
        return None
    return Path(raw).expanduser()


def copy_source_exists(target: Path) -> bool:
    """Whether a managed copy's canonical skill directory exists."""
    scan_path = get_api().scan_paths.get(os.path.normpath(target))
    check_dir = Path(scan_path) if scan_path else target
    try:
        return check_dir.is_dir()
    except OSError:
        return False


def copy_skill_dir(dest_skill_dir: Path, src: Path) -> None:
    """Atomically copy skill directory src to dest_skill_dir with metadata.source."""
    read_dir = Path(get_api().scan_paths.get(os.path.normpath(src)) or src)
    if not read_dir.is_dir():
        raise FileNotFoundError(f"skill source directory does not exist: {src}")
    dest_skill_dir.parent.mkdir(parents=True, exist_ok=True)
    tmp_dir = dest_skill_dir.with_name(f".{dest_skill_dir.name}.tmp-{os.getpid()}")
    shutil.rmtree(tmp_dir, ignore_errors=True)
    old_dir: Path | None = None
    try:
        shutil.copytree(
            read_dir,
            tmp_dir,
            symlinks=False,
            ignore=shutil.ignore_patterns(*COPY_IGNORE_PATTERNS),
        )
        for root_s, _dirs, files in os.walk(tmp_dir):
            os.chmod(root_s, os.stat(root_s).st_mode | 0o200)
            for fn in files:
                fp = os.path.join(root_s, fn)
                os.chmod(fp, os.stat(fp).st_mode | 0o600)
        src_md = tmp_dir / "SKILL.md"
        if src_md.is_file():
            raw_md = src_md.read_text(encoding="utf-8", errors="replace")
            stamped = inject_copy_source(raw_md, str(src))
        else:
            stamped = (
                f"---\nname: {json.dumps(src.name, ensure_ascii=False)}\n"
                f"metadata:\n  source: {json.dumps(str(src), ensure_ascii=False)}\n---\n"
            )
        src_md.write_text(stamped, encoding="utf-8")
        if dest_skill_dir.is_symlink() or dest_skill_dir.is_file():
            dest_skill_dir.unlink()
            os.replace(tmp_dir, dest_skill_dir)
        elif dest_skill_dir.is_dir():
            old_dir = dest_skill_dir.with_name(
                f".{dest_skill_dir.name}.old-{os.getpid()}"
            )
            shutil.rmtree(old_dir, ignore_errors=True)
            os.replace(dest_skill_dir, old_dir)
            os.replace(tmp_dir, dest_skill_dir)
            shutil.rmtree(old_dir, ignore_errors=True)
        else:
            os.replace(tmp_dir, dest_skill_dir)
    except Exception:
        shutil.rmtree(tmp_dir, ignore_errors=True)
        if old_dir is not None and old_dir.exists() and not dest_skill_dir.exists():
            os.replace(old_dir, dest_skill_dir)
        raise


def remove_skill_entry(path: Path, uses_copies: bool = True) -> None:
    """Remove a managed symlink or managed skill copy directory."""
    if path.is_symlink():
        path.unlink(missing_ok=True)
    elif uses_copies and read_copy_source(path) is not None:
        shutil.rmtree(path, ignore_errors=True)


class Workspace:
    """Base class defining the workspace interface."""

    # The install scope this class serves ('--scope'), and entry names in its
    # destination directories that belong to the agent itself, not to 'skill'.
    scope = "workspace"
    uses_copies = True
    reserved_names: frozenset[str] = frozenset()

    def __init__(self, root):
        self.root = root

    @classmethod
    def get_supported_configs(cls) -> dict[str, list[Path]]:
        """Returns a mapping of local destination folders to their global config directories."""
        home = Path.home()
        xdg_config = Path(os.environ.get("XDG_CONFIG_HOME") or (home / ".config"))
        return {
            ".claude/skills": [home / ".claude"],
            ".agents/skills": [
                home / ".codex",
                xdg_config / "opencode",
                home / ".opencode",
                home / ".gemini/config",
                home / ".gemini/antigravity-cli",
                home / ".gemini/antigravity",
                home / ".gemini/jetski",
                home / ".gemini/jetski/cli",
            ],
        }

    def get_dest_dirs(self) -> list[Path]:
        if "SKILL_DEST_DIRS" in os.environ:
            return [
                self.root / d for d in os.environ["SKILL_DEST_DIRS"].split(":") if d
            ]

        dest_dirs = []
        configs = self.get_supported_configs()

        for dest, sources in configs.items():
            if any(src.is_dir() for src in sources) or (self.root / dest).is_dir():
                dest_dirs.append(dest)

        if not dest_dirs:
            home = Path.home()
            all_sources = []
            for sources in configs.values():
                for src in sources:
                    formatted = (
                        f"~/{src.relative_to(home)}"
                        if src.is_relative_to(home)
                        else str(src)
                    )
                    if formatted not in all_sources:
                        all_sources.append(formatted)

            raise RuntimeError(
                f"No supported agent configuration directory ({', '.join(all_sources)}) detected, "
                f"and no existing skill directories found in the workspace."
            )

        return [self.root / d for d in dest_dirs]

    def get_tracked_skills(self) -> list[Path]:
        """Returns a list of VCS-tracked skill paths in the destination directories."""
        tracked = []
        try:
            dest_dirs = self.get_dest_dirs()
        except RuntimeError:
            return []
        for d in dest_dirs:
            if not d.is_dir():
                continue
            for item in d.iterdir():
                if item.name.startswith("."):
                    continue
                if not item.is_symlink() and self.is_tracked(item):
                    tracked.append(item)
        return sorted(tracked, key=lambda p: p.name)

    def get_actual_skills(self) -> tuple[set[str], list[Path], list[Path]]:
        """Scans destination directories and returns:
        (actual_skills_set, unmanaged_artifacts, dangling_symlinks)
        """
        actual = set()
        unmanaged = []
        dangling = []
        try:
            dest_dirs = self.get_dest_dirs()
        except RuntimeError:
            return actual, unmanaged, dangling

        for d in dest_dirs:
            if not d.is_dir():
                continue
            for item in d.iterdir():
                if item.name.startswith(".") or item.name in self.reserved_names:
                    continue
                if item.is_symlink():
                    try:
                        target_exists = link_target_exists(item)
                    except OSError:
                        target_exists = False
                    if target_exists:
                        actual.add(item.name)
                    else:
                        dangling.append(item)
                elif self.is_tracked(item):
                    continue
                elif self.uses_copies:
                    copy_src = read_copy_source(item)
                    if copy_src is not None:
                        if copy_source_exists(copy_src):
                            actual.add(item.name)
                        else:
                            dangling.append(item)
                    else:
                        unmanaged.append(item)
                else:
                    unmanaged.append(item)
        return actual, unmanaged, dangling

    def recorded_names(self) -> set[str]:
        """Entry names the scope's records list: every managed entry, broken or
        not, so a broken entry stays out of 'git status'."""
        live, _, dangling = self.get_actual_skills()
        return live | {p.name for p in dangling}

    def check_conflict(self, relpath: Path) -> str | None:
        """Returns an error message if there is a conflict, else None."""
        if self.is_tracked(relpath):
            return f"repo already tracks {rel_to(self.root, relpath)}; refusing to shadow it"
        if relpath.is_symlink() or not relpath.exists():
            return None
        if self.uses_copies and read_copy_source(relpath) is not None:
            return None
        kind_desc = "managed skill copy" if self.uses_copies else "symlink"
        return f"{relpath} exists and is not a {kind_desc}; refusing to overwrite"

    def is_tracked(self, path: Path) -> bool:
        """Returns True if the path is tracked by the VCS."""
        return False

    def get_analyze_dir(self) -> Path:
        return self.root

    def doctor_issues(self) -> list[str]:
        """Returns backend-specific findings (read-only)."""
        return []


class GitWorkspace(Workspace):
    """Git repositories.

    VCS Cleanliness (CL safety):
    1. Symlinks & Local State: The symlinks in '.claude/skills' or '.agents/skills'
       are automatically appended to '.git/info/exclude'. This is a local-only
       ignore file (not tracked by Git), keeping your 'git status' perfectly clean
       without polluting the repository's shared '.gitignore' file.
    """

    def __init__(self, root, git_root, exclude_file):
        super().__init__(root)
        self.git_root = git_root
        self.exclude_file = exclude_file
        self.mark_begin = "# >>> skills >>>"
        self.mark_end = "# <<< skills <<<"

    @classmethod
    def detect(cls):
        try:
            res = subprocess.run(
                ["git", "rev-parse", "--show-toplevel"],
                capture_output=True,
                text=True,
                check=True,
            )
            git_root = Path(res.stdout.strip()).resolve()
            # Bind to the anchor an agent would discover (cwd up to the repo
            # root), not cwd itself, so every command agrees no matter which
            # depth it is invoked from.
            root = find_skill_anchor(Path.cwd().resolve(), git_root)

            def git_path(rel):
                r = subprocess.run(
                    ["git", "rev-parse", "--git-path", rel],
                    capture_output=True,
                    text=True,
                    check=True,
                )
                return Path(r.stdout.strip()).resolve()

            return cls(root, git_root, git_path("info/exclude"))
        except (subprocess.CalledProcessError, FileNotFoundError):
            return None

    def _read_block(self, begin_mark, end_mark):
        if not self.exclude_file.is_file():
            return None
        managed = []
        in_block = False
        with open(self.exclude_file, encoding="utf-8", errors="replace") as f:
            for line in f:
                line_stripped = line.strip()
                if line_stripped == begin_mark:
                    in_block = True
                    continue
                if line_stripped == end_mark:
                    in_block = False
                    continue
                if in_block and line_stripped and not line_stripped.startswith("#"):
                    managed.append(line_stripped)
        return managed if (in_block or managed) else None

    def _names_from_exclude_lines(self, lines):
        # Exclude lines look like "/.agents/skills/name". Extract the name.
        skills = set()
        dest_dirs = self.get_dest_dirs()
        for line in lines:
            rel = line.lstrip("/")
            for d in dest_dirs:
                try:
                    rel_d = d.relative_to(self.git_root)
                    if rel.startswith(str(rel_d) + "/"):
                        skills.add(rel[len(str(rel_d)) + 1 :])
                except ValueError:
                    # d is not relative to git_root
                    pass
        return sorted(skills)

    def _expected_exclude_lines(self, skills):
        lines = set()
        for name in skills:
            for d in self.get_dest_dirs():
                try:
                    lines.add(f"/{d.relative_to(self.git_root)}/{name}")
                except ValueError:
                    # Fallback if dest_dirs are not relative to git_root
                    lines.add(f"/{d.name}/{name}")
        return sorted(lines)

    def _write_exclude_block(self, skills):
        self.exclude_file.parent.mkdir(parents=True, exist_ok=True)
        other_lines = []
        existing_block_lines = []
        if self.exclude_file.is_file():
            in_block = False
            with open(self.exclude_file, encoding="utf-8", errors="replace") as f:
                for line in f:
                    line_stripped = line.strip()
                    if line_stripped == self.mark_begin:
                        in_block = True
                        continue
                    if line_stripped == self.mark_end:
                        in_block = False
                        continue
                    if in_block:
                        if line_stripped and not line_stripped.startswith("#"):
                            existing_block_lines.append(line_stripped)
                    else:
                        other_lines.append(line)

        # Separate existing block lines into ours vs others
        our_rel_dest_dirs = []
        for d in self.get_dest_dirs():
            try:
                our_rel_dest_dirs.append(str(d.relative_to(self.git_root)))
            except ValueError:
                our_rel_dest_dirs.append(d.name)

        preserved_block_lines = []
        for line in existing_block_lines:
            rel = line.lstrip("/")
            is_ours = False
            for rdd in our_rel_dest_dirs:
                if rel.startswith(rdd + "/"):
                    is_ours = True
                    break
            if not is_ours:
                preserved_block_lines.append(line)

        # Generate new lines and combine with preserved lines
        new_lines = self._expected_exclude_lines(skills)
        combined_lines = sorted(set(preserved_block_lines + new_lines))

        # Write to temp file in same directory for atomic replace (concurrency safety)
        temp_fd, temp_path_str = tempfile.mkstemp(dir=str(self.exclude_file.parent))
        temp_path = Path(temp_path_str)
        try:
            with os.fdopen(temp_fd, "w", encoding="utf-8") as f:
                for line in other_lines:
                    f.write(line)
                if other_lines and not other_lines[-1].endswith("\n"):
                    f.write("\n")
                if combined_lines:  # Only write block if there are active lines
                    f.write(self.mark_begin + "\n")
                    f.write("# managed by 'skill'\n")
                    for line in combined_lines:
                        f.write(line + "\n")
                    f.write(self.mark_end + "\n")

            os.replace(temp_path, self.exclude_file)
        except Exception:
            temp_path.unlink(missing_ok=True)
            raise

    def save_exclude_block(self, skills):
        self._write_exclude_block(skills)

    def is_tracked(self, path: Path) -> bool:
        """Returns True if the path is tracked by Git (or contains tracked files)."""
        try:
            rel_to_root = path.relative_to(self.root)
            res = subprocess.run(
                ["git", "ls-files", "--error-unmatch", "--", str(rel_to_root)],
                cwd=self.root,
                capture_output=True,
                text=True,
                check=False,
            )
            return res.returncode == 0
        except Exception:
            return False

    def doctor_issues(self):
        issues = []
        actual_skills = self.recorded_names()

        # Read the block
        block_lines = self._read_block(self.mark_begin, self.mark_end) or []

        # Filter the block lines to only include those belonging to our workspace
        our_rel_dest_dirs = []
        for d in self.get_dest_dirs():
            try:
                our_rel_dest_dirs.append(str(d.relative_to(self.git_root)))
            except ValueError:
                our_rel_dest_dirs.append(d.name)

        our_actual_exclude = []
        for line in block_lines:
            rel = line.lstrip("/")
            for rdd in our_rel_dest_dirs:
                if rel.startswith(rdd + "/"):
                    our_actual_exclude.append(line)
                    break

        if sorted(set(our_actual_exclude)) != self._expected_exclude_lines(
            actual_skills
        ):
            issues.append(
                f"{clean_p(self.exclude_file)} managed block does not match the skill links"
            )
        return issues


class AgyBrainWorkspace(Workspace):
    """Antigravity (Agy) session artifact directory (.../brain/<id>).

    Copies skill directories under '.agents/skills/<name>/' with
    'metadata.source' in SKILL.md frontmatter so non-global symlink confinement
    never drops external skills and no 'skills.json' manifest is needed.
    """

    scope = "session"

    def __init__(self, root: Path):
        super().__init__(root)
        self.dest_dir = self.root / ".agents" / "skills"

    @classmethod
    def detect(cls):
        curr = Path.cwd().resolve()
        for p in (curr, *curr.parents):
            if (p / ".system_generated").is_dir():
                return cls(p)
            if p.parent.name == "brain" and (
                p.parent.parent.name
                in ("antigravity", "antigravity-cli", "agy", "jetski")
                or (p.parent.parent / "cli").is_dir()
            ):
                return cls(p)
        return None

    @classmethod
    def get_supported_configs(cls) -> dict[str, list[Path]]:
        return {}

    def get_dest_dirs(self) -> list[Path]:
        if "SKILL_DEST_DIRS" in os.environ:
            return [
                self.root / d for d in os.environ["SKILL_DEST_DIRS"].split(":") if d
            ]
        return [self.dest_dir]

    @classmethod
    def from_conversation_env(cls):
        """Find brain/<id> from the conversation ID Antigravity exports.

        The agent's shell carries ANTIGRAVITY_CONVERSATION_ID and the app's data
        directory (ANTIGRAVITY_APP_DATA_DIR, e.g. ~/.gemini/antigravity-cli);
        without the latter, the known app directories are tried.
        """
        app_data = os.environ.get("ANTIGRAVITY_APP_DATA_DIR", "") or os.environ.get(
            "AGY_APP_DATA_DIR", ""
        )
        gemini = Path.home() / ".gemini"
        bases = (
            [Path(app_data)]
            if app_data
            else [gemini / app for app in ("antigravity-cli", "antigravity", "jetski")]
        )
        for var in ("ANTIGRAVITY_CONVERSATION_ID", "JETSKI_CONVERSATION_ID"):
            conv_id = os.environ.get(var, "").strip()
            if not conv_id or "/" in conv_id or conv_id in (".", ".."):
                continue
            for base in bases:
                brain = base / "brain" / conv_id
                if brain.is_dir():
                    return cls(brain.resolve())
        return None


class ClaudeSessionWorkspace(Workspace):
    """Claude Code session directory ($AGENT_SESSION_DIR).

    The claude wrapper passes the directory to 'claude --add-dir', and Claude
    loads skills from '.claude/skills' in any added directory, picking up new
    links within the same turn. Nothing else reads it, so it gets no
    '.agents/skills' and needs no exclude block.
    """

    scope = "session"

    @classmethod
    def get_supported_configs(cls) -> dict[str, list[Path]]:
        return {".claude/skills": [Path.home() / ".claude"]}

    def get_dest_dirs(self) -> list[Path]:
        return [self.root / ".claude" / "skills"]


class UserWorkspace(Workspace):
    """User-level skill directories (~/.claude/skills, ~/.agents/skills, ~/.gemini/config/skills)."""

    scope = "user"
    uses_copies = False
    # Claude's own claude.ai skill sync lives in ~/.claude/skills/synced.
    reserved_names = frozenset({"synced"})

    @classmethod
    def get_supported_configs(cls) -> dict[str, list[Path]]:
        home = Path.home()
        xdg_config = Path(os.environ.get("XDG_CONFIG_HOME") or (home / ".config"))
        return {
            ".claude/skills": [home / ".claude"],
            ".agents/skills": [
                home / ".codex",
                xdg_config / "opencode",
                home / ".opencode",
            ],
            ".gemini/config/skills": [
                home / ".gemini/config",
                home / ".gemini/antigravity-cli",
                home / ".gemini/antigravity",
                home / ".gemini/jetski",
                home / ".gemini/jetski/cli",
            ],
        }


class DefaultWorkspace(Workspace):
    """Fallback for non-VCS directories."""


# ==============================================================================
# Plugins & Auto-Detection
# ==============================================================================


# --- Catalog Caching & Registry Settings ---
CATALOG_TTL = 7 * 24 * 3600  # 7 days
PROVISION_TTL = 8 * 3600  # 8 hours


def is_offline() -> bool:
    """Whether remote fetches are forbidden in this environment."""
    value = os.environ.get("AGENT_OFFLINE", "")
    return value.strip().lower() in ("1", "true", "yes", "on")


def offline_desc() -> str:
    return f"AGENT_OFFLINE={os.environ.get('AGENT_OFFLINE', '')}"


def get_cache_dir() -> Path:
    """This tool's cache directory (SKILL_CACHE_DIR names it outright)."""
    override = os.environ.get("SKILL_CACHE_DIR")
    if override:
        return Path(override).expanduser()
    base = Path(os.environ.get("XDG_CACHE_HOME") or "~/.cache").expanduser()
    return base / "skill"


def get_cache_base() -> Path:
    return get_cache_dir() / "remotes"


def get_catalog_dir() -> Path:
    return get_cache_dir() / "catalog"


def remote_cache_dir(repo: str, ref: str, subpath: str | None) -> Path:
    """Where fetch_github() keeps a remote skill's downloaded content."""
    owner, reponame = repo.split("/", 1)
    dest_base = get_cache_base() / owner / reponame / ref
    return dest_base / subpath if subpath else dest_base


def cached_remote_dir(entry: dict) -> Path | None:
    """The already-downloaded directory for a remote catalog entry, if any.

    Purely a disk lookup: it answers whether the content is in hand without
    fetching anything, so a catalog listing stays offline-safe.
    """
    try:
        target = remote_cache_dir(entry["repo"], entry["ref"], entry.get("subpath"))
    except (KeyError, ValueError):
        return None
    return target if target.is_dir() else None


def parse_github_url(url: str) -> tuple[str, str, str | None]:
    parsed = urlparse(url)
    if parsed.netloc != "github.com":
        raise ValueError(
            f"registry: unsupported URL (only github.com is supported): {url}"
        )
    parts = parsed.path.strip("/").split("/")
    if len(parts) < 4 or parts[2] != "tree":
        raise ValueError(f"registry: cannot parse GitHub URL: {url}")
    owner, repo, _, ref = parts[:4]
    subpath = "/".join(parts[4:]) or None
    return f"{owner}/{repo}", ref, subpath


def fetch_github(
    name: str, repo: str, ref: str, subpath: str | None, force: bool = False
) -> str:
    target_dir = remote_cache_dir(repo, ref, subpath)
    meta_file = get_catalog_dir() / ".meta" / name

    # Checked before the TTL shortcut below, not after: in the warm-then-freeze
    # workflow the cache is usually younger than PROVISION_TTL, so testing this
    # second would take the silent path in exactly the common case and skip the
    # staleness signal every offline answer owes its caller.
    #
    # Offline, a previously downloaded copy is the only copy obtainable: serve
    # it at any age (and regardless of --force, which cannot be honoured
    # without network), but say how old it is.
    if is_offline():
        if target_dir.is_dir():
            stamp = meta_file if meta_file.is_file() else target_dir
            print(
                f"skill: offline ({offline_desc()}): using cached '{name}' "
                f"(downloaded {age_human(stamp)})",
                file=sys.stderr,
            )
            return str(target_dir)
        die(
            f"offline ({offline_desc()}) and remote skill '{name}' has never been "
            f"downloaded to {clean_p(target_dir)}; fetch it from a "
            f"network-enabled environment first with 'skill add {name}'"
        )

    if (
        not force
        and target_dir.is_dir()
        and meta_file.is_file()
        and (time.time() - meta_file.stat().st_mtime) < PROVISION_TTL
    ):
        return str(target_dir)

    # A shallow, blobless, sparse fetch transfers only the commit, its trees,
    # and the blobs under subpath -- not the whole tree a tarball carries
    # (hundreds of MB for a monorepo hosting one small skill). Fetching the ref
    # directly (rather than 'clone --branch') also accepts commit SHAs.
    url = os.environ.get("_SKILL_TEST_REMOTE") or f"https://github.com/{repo}.git"
    print(f"skill: downloading remote skill '{name}' from GitHub...", file=sys.stderr)

    with tempfile.TemporaryDirectory() as tmpdir:
        src_folder = Path(tmpdir) / "repo"

        def git(*args: str, timeout: int = 30) -> None:
            # --template= and core.hooksPath keep the user's git templates and
            # hooks (which may run arbitrary tooling) out of this scratch repo.
            cmd = ["git", "-c", "core.hooksPath=/dev/null", "-C", str(src_folder)]
            try:
                res = subprocess.run(
                    [*cmd, *args],
                    capture_output=True,
                    text=True,
                    timeout=timeout,
                    check=False,
                )
            except FileNotFoundError:
                print("skill: git not found", file=sys.stderr)
                sys.exit(127)
            except subprocess.TimeoutExpired:
                die(f"timed out running 'git {args[0]}' for {url}")
            if res.returncode != 0:
                detail = res.stderr.strip().splitlines()
                die(
                    f"failed to download {url} ({ref}): "
                    f"{detail[-1] if detail else f'git {args[0]} failed'}"
                )

        src_folder.mkdir()
        git("init", "--quiet", "--template=")
        git("remote", "add", "origin", url)
        if subpath:
            git("sparse-checkout", "set", "--no-cone", f"/{subpath}/")
        git(
            "fetch",
            "--quiet",
            "--depth=1",
            "--filter=blob:none",
            "origin",
            ref,
            timeout=120,
        )
        git("-c", "advice.detachedHead=false", "checkout", "--quiet", "FETCH_HEAD")
        shutil.rmtree(src_folder / ".git")

        if subpath and not (src_folder / subpath).is_dir():
            die(f"path '{subpath}' not found in {repo} at {ref}")

        # Replace only this skill's directory: other skills from the same repo
        # and ref share its parent, and a sparse fetch does not carry them.
        target_dir.parent.mkdir(parents=True, exist_ok=True)
        if target_dir.exists():
            shutil.rmtree(target_dir)

        shutil.move(src_folder / subpath if subpath else src_folder, target_dir)

    meta_file.parent.mkdir(parents=True, exist_ok=True)
    with open(meta_file, "w", encoding="utf-8") as f:
        f.write(str(time.time()))

    src_skill_md = target_dir / "SKILL.md"
    if src_skill_md.is_file():
        catalog_skill_dir = get_catalog_dir() / name
        catalog_skill_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy(src_skill_md, catalog_skill_dir / "SKILL.md")

    return str(target_dir)


def fetch_skill_md(
    name: str, repo: str, ref: str, subpath: str | None, force: bool = False
) -> None:
    catalog_skill_dir = get_catalog_dir() / name
    stub_md = catalog_skill_dir / "SKILL.md"
    meta_file = get_catalog_dir() / ".meta" / name

    # Checked before the TTL shortcut below, not after: in the warm-then-freeze
    # workflow the cache is usually younger than CATALOG_TTL, so testing this
    # second would take the silent path in exactly the common case and skip the
    # staleness signal every offline answer owes its caller.
    #
    # Catalog metadata is a nicety (descriptions in listings), so a miss here
    # degrades to whatever is on disk rather than failing the command.
    if is_offline():
        if stub_md.is_file():
            stamp = meta_file if meta_file.is_file() else stub_md
            print(
                f"skill: offline ({offline_desc()}): using cached metadata for "
                f"'{name}' (downloaded {age_human(stamp)})",
                file=sys.stderr,
            )
        else:
            print(
                f"skill: offline ({offline_desc()}): no cached metadata for '{name}'",
                file=sys.stderr,
            )
        return

    if (
        not force
        and stub_md.is_file()
        and meta_file.is_file()
        and (time.time() - meta_file.stat().st_mtime) < CATALOG_TTL
    ):
        return

    sub_part = f"/{subpath}" if subpath else ""
    url = f"https://raw.githubusercontent.com/{repo}/{ref}{sub_part}/SKILL.md"
    catalog_skill_dir.mkdir(parents=True, exist_ok=True)
    meta_file.parent.mkdir(parents=True, exist_ok=True)

    try:
        req = urllib.request.Request(
            url, headers={"User-Agent": "Antigravity-Skill-Manager/1.0"}
        )
        with urllib.request.urlopen(req, timeout=15) as response:
            content = response.read().decode("utf-8")
        with open(stub_md, "w", encoding="utf-8") as f:
            f.write(content)
        with open(meta_file, "w", encoding="utf-8") as f:
            f.write(str(time.time()))
    except Exception as e:
        print(
            f"skill: warning: failed to fetch metadata for '{name}': {e}",
            file=sys.stderr,
        )


def load_skill_md_frontmatter(content: str) -> dict:
    """Parses a simple YAML frontmatter block from a SKILL.md file string."""
    meta: dict[str, str] = {}
    lines = content.strip().splitlines()
    if not lines or lines[0].strip() != "---":
        return meta

    key: str | None = None
    parts: list[str] = []
    for line in [*lines[1:], "---"]:
        stripped = line.strip()
        if stripped == "---":
            if key is not None:
                meta[key] = " ".join(parts).strip()
            break
        if not line.startswith((" ", "\t")):
            if not stripped or stripped.startswith("#"):
                continue
            if key is not None:
                meta[key] = " ".join(parts).strip()
                key, parts = None, []
            if ":" in line:
                k, val = line.split(":", 1)
                key, val = k.strip(), val.strip()
                parts = (
                    []
                    if val in (">", "|", ">-", "|-", ">+", "|+")
                    else [val.strip("'\"")]
                )
        elif key is not None and stripped and not stripped.startswith("#"):
            parts.append(stripped)
    return meta


def get_skill_metadata(skill_dir: Path, default_name: str) -> dict:
    """Reads SKILL.md in the given directory and returns its frontmatter metadata."""
    skill_md = skill_dir / "SKILL.md"
    if not skill_md.is_file():
        return {"name": default_name, "description": ""}
    try:
        with open(skill_md, encoding="utf-8", errors="replace") as f:
            content = f.read()
        meta = load_skill_md_frontmatter(content)
        return {
            "name": meta.get("name") or default_name,
            "description": meta.get("description") or "",
        }
    except Exception:
        return {"name": default_name, "description": ""}


def ensure_catalog_stub(name: str, entry: dict, force: bool = False) -> None:
    if name.startswith("local:"):
        return
    if "repo" in entry and "ref" in entry:
        fetch_skill_md(name, entry["repo"], entry["ref"], entry["subpath"], force=force)
    elif "path" in entry:
        catalog_dir = get_catalog_dir()
        stub_dir = catalog_dir / name
        stub_md = stub_dir / "SKILL.md"
        src_path = Path(entry["path"]).expanduser()
        src_md = src_path / "SKILL.md"
        # Compare the link text, never its dereferenced target: resolving a
        # link into a network-backed mount costs a remote round trip per path
        # component, on every invocation. The link is written from str(src_md),
        # so a lexical match is exact, and any mismatch is simply rewritten.
        if not force and stub_md.is_symlink():
            try:
                if os.readlink(stub_md) == str(src_md):
                    return
            except OSError:
                pass
        if src_md.is_file():
            if not stub_dir.is_dir():
                stub_dir.mkdir(parents=True, exist_ok=True)
            # A regular file here (not a link) is left alone unless forced.
            if force or stub_md.is_symlink() or not stub_md.exists():
                stub_md.unlink(missing_ok=True)
                try:
                    stub_md.symlink_to(src_md)
                except Exception:
                    pass


def ensure_catalog_index(plugin_catalog, force: bool = False) -> None:
    """Ensures all plugin catalog stubs are downloaded and cached."""
    for name, entry in plugin_catalog.items():
        ensure_catalog_stub(name, entry, force=force)


class SkillAPI:
    """Unified API surface passed to a plugin's register() function."""

    Workspace = Workspace

    def __init__(self):
        self.workspace_classes = []
        self.plugin_catalog = {}
        self.all_registrations = []
        self.load_failures = []
        # normpath(path) -> scan_path, for probing existence cheaply
        self.scan_paths: dict[str, str] = {}

    def register_workspace(self, cls):
        self.workspace_classes.append(cls)

    def register_skill(self, name, spec):
        if isinstance(spec, str):
            if spec.startswith(("https://github.com/", "http://github.com/")):
                repo, ref, subpath = parse_github_url(spec)
                spec = {"repo": repo, "ref": ref, "subpath": subpath}
            else:
                raise ValueError(
                    f"Skill '{name}': string spec must be a GitHub URL, got '{spec}'"
                )

        if not isinstance(spec, dict):
            raise TypeError(
                f"Skill '{name}': spec must be a dictionary or a GitHub URL string, got {type(spec).__name__}"
            )

        spec = dict(spec)

        if "path" in spec:
            if any(k in spec for k in ("repo", "ref", "subpath")):
                raise ValueError(
                    f"Skill '{name}': 'path' cannot be mixed with GitHub parameters."
                )
            spec["path"] = os.path.expanduser(spec["path"])
            if spec.get("scan_path"):
                spec["scan_path"] = os.path.expanduser(spec["scan_path"])
                self.scan_paths[os.path.normpath(spec["path"])] = spec["scan_path"]
        elif "repo" in spec and "ref" in spec:
            spec.setdefault("subpath", None)
        else:
            raise ValueError(
                f"Skill '{name}': spec must contain either 'path' or both 'repo' and 'ref'."
            )

        if getattr(self, "current_plugin_file", None):
            spec["plugin_file"] = self.current_plugin_file
        self.plugin_catalog[name] = spec
        self.all_registrations.append((name, spec))


_LOADED_API = None


def get_api() -> SkillAPI:
    global _LOADED_API
    if _LOADED_API is None:
        _LOADED_API = load_plugins()
    return _LOADED_API


def link_target_exists(link: Path) -> bool:
    """Whether a skill symlink's target exists, without always following it.

    A link to a registered skill path that has a scan_path is checked through
    the scan_path: the same content via a cheaper view (following the link
    itself may cost a remote round trip per path component). Any other link
    is followed as usual. Raises OSError if the link cannot be read.
    """
    target = os.readlink(link)
    if not os.path.isabs(target):
        target = os.path.join(link.parent, target)
    scan_path = get_api().scan_paths.get(os.path.normpath(target))
    return Path(scan_path).is_dir() if scan_path else link.exists()


def load_plugins() -> SkillAPI:
    import importlib.util

    api = SkillAPI()
    plugins_dir = (
        Path(os.environ.get("XDG_CONFIG_HOME") or "~/.config").expanduser()
        / "skill"
        / "plugins"
    )
    if not plugins_dir.is_dir():
        return api

    for filepath in sorted(plugins_dir.glob("*.py")):
        module_name = f"skill_plugin_{filepath.stem}"
        try:
            spec = importlib.util.spec_from_file_location(module_name, filepath)
            if spec and spec.loader:
                module = importlib.util.module_from_spec(spec)
                sys.modules[module_name] = module
                spec.loader.exec_module(module)
                if hasattr(module, "register"):
                    api.current_plugin_file = filepath.name
                    module.register(api)
                    api.current_plugin_file = None
        except Exception as e:
            api.load_failures.append((filepath.name, str(e)))
            print(
                f"skill: warning: failed to load plugin {filepath}: {e}",
                file=sys.stderr,
            )
            if os.environ.get("SKILL_DEBUG") == "1":
                import traceback

                traceback.print_exc(file=sys.stderr)
    return api


# Session-ID variables set by agents with no session directory of their own.
# When one is present alongside a Claude binding, the caller is a nested agent
# (e.g. 'codex exec' inside Claude), which inherits CLAUDE_CODE_SESSION_ID
# unchanged.
FOREIGN_SESSION_VARS = ("CODEX_SESSION_ID",)


def get_session_workspace() -> Workspace:
    """Resolve the calling agent's own session directory, or exit 1.

    Antigravity's brain/<id> is found from the current directory (as with
    '-C <artifactDir>') or its conversation ID. A Claude session directory is
    AGENT_SESSION_DIR, honored only when AGENT_SESSION_ID matches the agent's
    own CLAUDE_CODE_SESSION_ID, so a nested agent that inherits the variables
    cannot write into its parent's session.

    Every agent passes the others' variables through to its children, so the
    environment cannot say which agent is innermost. Antigravity's variables
    are checked first: agy started by Claude (the common nesting) inherits a
    matching Claude binding, while Claude started by agy is rare.
    """
    ws = AgyBrainWorkspace.detect() or AgyBrainWorkspace.from_conversation_env()
    if ws:
        return ws

    session_dir = os.environ.get("AGENT_SESSION_DIR", "")
    if session_dir:
        bound_id = os.environ.get("AGENT_SESSION_ID", "")
        own_id = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        foreign = [v for v in FOREIGN_SESSION_VARS if os.environ.get(v)]
        # The one caller with no session ID of its own is the claude wrapper,
        # seeding the directory before Claude starts: every process Claude
        # runs inherits CLAUDE_CODE_SESSION_ID.
        launcher = not own_id and not foreign
        if not bound_id and not launcher:
            die(
                "--scope session: AGENT_SESSION_DIR is not bound to a session "
                "(AGENT_SESSION_ID is not set)"
            )
        if not launcher and (bound_id != own_id or foreign):
            die(
                f"--scope session: AGENT_SESSION_DIR belongs to session {bound_id}, "
                "not this agent's (nested agent?)"
            )
        if not Path(session_dir).is_dir():
            die(f"--scope session: AGENT_SESSION_DIR {session_dir} is not a directory")
        return ClaudeSessionWorkspace(Path(session_dir).resolve())

    die(
        "--scope session: no session directory: AGENT_SESSION_DIR is not set "
        "and no Antigravity conversation was found (start Claude through the "
        "claude wrapper; under Antigravity, pass -C <artifactDir>)"
    )


def detect_project_workspace() -> Workspace | None:
    """The workspace scope of the current directory, or None; never exits.

    What 'skill add' (workspace scope) would operate on from here, for a
    session-scope add to see which skills are active already.
    """
    if is_home_workspace() or AgyBrainWorkspace.detect():
        return None
    api = get_api()
    for cls in [*api.workspace_classes, GitWorkspace]:
        try:
            ws = cls.detect()
        except Exception as e:
            print(
                f"skill: warning: workspace detector {cls.__name__} failed: {e}",
                file=sys.stderr,
            )
            continue
        if ws:
            return ws
    return DefaultWorkspace(Path.cwd())


def get_workspace() -> Workspace:
    if _SCOPE == "session":
        return get_session_workspace()
    if _SCOPE == "user":
        return UserWorkspace(Path.home())
    if is_home_workspace():
        die(
            "the home directory's skill folders are the user scope; "
            "use 'skill --scope user' to manage them"
        )
    if AgyBrainWorkspace.detect():
        die(
            "this is an Antigravity session directory; "
            "use 'skill --scope session' to manage its skills"
        )
    api = get_api()
    for cls in [*api.workspace_classes, GitWorkspace]:
        try:
            ws = cls.detect()
        except Exception as e:
            print(
                f"skill: warning: workspace detector {cls.__name__} failed: {e}",
                file=sys.stderr,
            )
            continue
        if ws:
            return ws
    return DefaultWorkspace(Path.cwd())


# ==============================================================================
# CLI Command Implementations
# ==============================================================================


def resolve_skill_spec(spec: str) -> tuple[Path, str]:
    """Resolves a skill spec/name to its (absolute_source_path, skill_name)."""
    explicit_path = spec == "~" or spec.startswith(("/", "./", "../", "~/"))
    if explicit_path or ("/" in spec and ":" not in spec):
        p = Path(spec).expanduser()
        if (p / "SKILL.md").is_file():
            resolved = Path(os.path.realpath(p))
            return resolved, resolved.name
        if explicit_path:
            raise ValueError(f"cannot resolve skill path '{spec}' (no SKILL.md found)")

    api = get_api()

    # 1. Parse the requested spec for namespace
    req_ns = None
    req_name = spec
    if ":" in spec:
        req_ns, req_name = spec.split(":", 1)

    # We will gather all candidates as dicts: {"path": Path, "namespace": str, "name": str, "full_spec": str}
    candidates = []

    # Scan registered plugins (api.plugin_catalog)
    for key, entry in api.plugin_catalog.items():
        # Parse registered key
        ns = "local"
        short_name = key
        if ":" in key:
            ns, short_name = key.split(":", 1)

        # Check if the short name matches
        if short_name.lower() == req_name.lower():
            if "path" in entry:
                target_path = Path(entry["path"]).expanduser()
                # Probe through scan_path when registered (same content, a
                # cheaper view); the candidate path is always 'path'.
                if Path(entry.get("scan_path") or target_path).is_dir():
                    should_resolve = entry.get("resolve", True)
                    resolved_path = (
                        Path(os.path.realpath(target_path))
                        if should_resolve
                        else target_path
                    )
                    candidates.append(
                        {
                            "path": resolved_path,
                            "namespace": ns,
                            "name": short_name,
                            "full_spec": key,
                            "is_remote": False,
                        }
                    )
            elif "repo" in entry and "ref" in entry:
                candidates.append(
                    {
                        "entry": entry,
                        "namespace": ns,
                        "name": short_name,
                        "full_spec": key,
                        "is_remote": True,
                    }
                )

    # Filter candidates by namespace if one was requested
    if req_ns:
        filtered = [c for c in candidates if c["namespace"].lower() == req_ns.lower()]
        if not filtered:
            raise ValueError(
                f"cannot resolve skill '{spec}': no match in namespace '{req_ns}'"
            )
        candidates = filtered

    # No namespace requested
    if not candidates:
        raise ValueError(f"cannot resolve skill '{spec}'")

    if len(candidates) > 1:
        non_remote = [c for c in candidates if not c.get("is_remote", False)]
        if non_remote:
            candidates = non_remote

    # Now resolve paths for remaining candidates
    unique_candidates = []
    seen_paths = set()
    for c in candidates:
        if c.get("is_remote", False):
            entry = c["entry"]
            try:
                target_dir_str = fetch_github(
                    c["full_spec"], entry["repo"], entry["ref"], entry.get("subpath")
                )
                target_path = Path(target_dir_str)
                if target_path.is_dir():
                    path_obj = Path(os.path.realpath(target_path))
                    if path_obj not in seen_paths:
                        seen_paths.add(path_obj)
                        c["path"] = path_obj
                        unique_candidates.append(c)
            except (Exception, SystemExit):
                # fetch_github() reports fatal errors (network failure, repo
                # not found) via die(), which raises SystemExit rather than a
                # normal exception. Catching only Exception would let that
                # propagate out of resolve_skill_spec() and kill the whole
                # process (including 'skill doctor', which must keep
                # rendering the rest of its checks). die() already printed
                # the underlying error to stderr; treat this candidate as
                # simply unavailable and let resolution fall through to the
                # ordinary "cannot resolve skill" error below.
                pass
        else:
            if c["path"] not in seen_paths:
                seen_paths.add(c["path"])
                unique_candidates.append(c)

    if not unique_candidates:
        raise ValueError(f"cannot resolve skill '{spec}'")

    if len(unique_candidates) == 1:
        return unique_candidates[0]["path"], unique_candidates[0]["name"]

    # Multiple matches found - raise ambiguity error!
    options = ", ".join(c["full_spec"] for c in unique_candidates)
    raise ValueError(
        f"Ambiguous skill spec '{spec}'. Multiple matches found: {options}. "
        f"Please specify the namespace (e.g. {unique_candidates[0]['full_spec']}) to disambiguate."
    )


def rel_to(root: Path, p: Path):
    """Best-effort path relative to root, falling back to the absolute path."""
    try:
        return p.relative_to(root)
    except ValueError:
        return p


class DiskEntry:
    """A managed skill entry (symlink or metadata.source-stamped copy)."""

    def __init__(self, dest, link_name, path, kind, target, tracked):
        self.dest = dest
        self.link_name = link_name
        self.path = path
        self.kind = kind  # "live" (source exists) or "dangling" (source missing)
        self.target = target
        self.tracked = tracked

    @property
    def source(self) -> Path | None:
        return self.target


def absolute_target(link: Path) -> Path:
    """The link's target as an absolute path, without resolving it further."""
    target = Path(os.readlink(link))
    return target if target.is_absolute() else link.parent / target


def _entry_target(p: Path, uses_copies: bool) -> Path | None:
    if p.is_symlink():
        try:
            return absolute_target(p)
        except OSError:
            return None
    if uses_copies:
        return read_copy_source(p)
    return None


def scan_links(ws) -> tuple[list[DiskEntry], list[Path]]:
    """Every managed skill entry in the scope's destination directories, plus
    any untracked unmanaged items found there."""
    live, unmanaged, dangling = ws.get_actual_skills()
    try:
        dest_dirs = ws.get_dest_dirs()
    except RuntimeError:
        dest_dirs = []
    entries = []
    for name in sorted(live):
        for d in dest_dirs:
            p = d / name
            if p in dangling or (not p.exists() and not p.is_symlink()):
                continue
            if not p.is_symlink() and ws.is_tracked(p):
                continue
            target = _entry_target(p, ws.uses_copies)
            if target is None and not p.is_symlink():
                continue
            entries.append(DiskEntry(d, name, p, "live", target, False))
    for p in dangling:
        target = _entry_target(p, ws.uses_copies)
        entries.append(
            DiskEntry(p.parent, p.name, p, "dangling", target, ws.is_tracked(p))
        )
    return entries, unmanaged


def sync_records(ws) -> None:
    """Rewrite the scope's exclude records from disk."""
    if hasattr(ws, "save_exclude_block"):
        ws.save_exclude_block(ws.recorded_names())


def _expected_names_for_spec(spec: str) -> set[str]:
    """Candidate installed directory names for SPEC when resolution fails."""
    short = spec.split(":", 1)[-1]
    names = {short, os.path.basename(spec.rstrip("/"))}
    req_ns = spec.split(":", 1)[0].lower() if ":" in spec else None
    for key, entry in get_api().plugin_catalog.items():
        ns, sname = key.split(":", 1) if ":" in key else ("local", key)
        if req_ns and ns.lower() != req_ns:
            continue
        if sname.lower() == short.lower():
            if "path" in entry:
                names.add(Path(entry["path"]).name)
            elif entry.get("subpath"):
                names.add(Path(entry["subpath"]).name)
            elif "repo" in entry:
                names.add(entry["repo"].split("/", 1)[-1])
    return {n for n in names if n and "/" not in n and n not in (".", "..")}


def _is_unavailable_optional_spec(spec: str) -> bool:
    """True when SPEC matches only optional catalog skills whose backing paths are absent."""
    if spec == "~" or spec.startswith(("/", "./", "../", "~/")):
        return False
    req_ns = spec.split(":", 1)[0].lower() if ":" in spec else None
    short = spec.split(":", 1)[-1].lower()
    matched = []
    for key, entry in get_api().plugin_catalog.items():
        ns, sname = key.split(":", 1) if ":" in key else ("local", key)
        if req_ns and ns.lower() != req_ns:
            continue
        if sname.lower() == short:
            matched.append(entry)
    return bool(matched) and all(e.get("optional") for e in matched)


def cmd_add(specs):
    quiet = any(a in ("-q", "--quiet") for a in specs)
    prune = any(a in ("-p", "--prune") for a in specs)
    specs = [a for a in specs if a not in ("-q", "--quiet", "-p", "--prune")]
    if "--defaults" in specs:
        cmderr(
            "add",
            "--defaults has been removed; default skills live in the user scope ('skill --scope user add ...')",
            code=2,
        )
    log = (lambda *a, **k: None) if quiet else print
    if not specs:
        cmderr("add", "skill name required")
    if len(specs) == 1 and specs[0] == "-":
        specs = sys.stdin.read().split()
        if not specs and not prune:
            return

    ws = get_workspace()
    try:
        dest_dirs = ws.get_dest_dirs()
    except RuntimeError as e:
        cmderr("add", str(e))

    if not quiet:
        print_workspace_root(ws)

    resolved_skills = []
    desired_link_names: set[str] = set()
    has_errors = False
    for spec in specs:
        try:
            src_path, name = resolve_skill_spec(spec)
            resolved_skills.append((src_path, name, spec))
            desired_link_names.add(src_path.name)
        except Exception as e:
            desired_link_names |= _expected_names_for_spec(spec)
            if prune and _is_unavailable_optional_spec(spec):
                log(
                    f"skipped optional skill '{spec}' (source is not available on this host)",
                    file=sys.stderr,
                )
                continue
            print(f"skill: error: failed to resolve '{spec}': {e}", file=sys.stderr)
            has_errors = True
            continue

    # Atomicity: Detect basename collisions and deduplicate identical targets BEFORE mutating disk
    link_map: dict = {}
    deduped_skills = []
    for src, name, spec in resolved_skills:
        link_name = src.name
        if link_name in link_map:
            prev_src, prev_spec = link_map[link_name]
            if prev_src != src:
                cmderr(
                    "add",
                    f"conflict: '{spec}' and '{prev_spec}' both target skill basename '{link_name}' but resolve to different source paths",
                )
            continue
        link_map[link_name] = (src, spec)
        deduped_skills.append((src, name))
    resolved_skills = deduped_skills

    # A session add names a project's skills without working out which ones
    # the user scope or workspace already provides, so skip those: the harness
    # already loads them. Exception: Antigravity/Jetski workspace discovery
    # drops legacy .agents/skills/ symlinks whose resolved target escapes the
    # workspace root, so those must still be staged into the session directory.
    if ws.scope == "session":
        home = Path.home()
        user_dirs = (
            [home / ".gemini" / "config" / "skills"]
            if isinstance(ws, AgyBrainWorkspace)
            else [home / ".claude" / "skills"]
        )
        project_ws = detect_project_workspace()
        try:
            active_dirs = project_ws.get_dest_dirs() if project_ws else []
        except RuntimeError:
            active_dirs = []
        if isinstance(ws, AgyBrainWorkspace):
            active_dirs = [
                d
                for d in active_dirs
                if d.name == "skills" and d.parent.name == ".agents"
            ] or active_dirs
        kept = []
        for src, name in resolved_skills:
            src_real = os.path.realpath(src)
            user_link = next(
                (d / src.name for d in user_dirs if (d / src.name).is_symlink()),
                None,
            )
            if user_link is not None and os.path.realpath(user_link) == src_real:
                log(
                    f"already active {name} (user {clean_p(user_link)})",
                    file=sys.stderr,
                )
                continue

            ws_match: Path | None = None
            for d in active_dirs:
                cand = d / src.name
                if cand.is_symlink():
                    if os.path.realpath(cand) == src_real and (
                        not isinstance(ws, AgyBrainWorkspace)
                        or project_ws is None
                        or Path(cand)
                        .resolve()
                        .is_relative_to(project_ws.root.resolve())
                    ):
                        ws_match = cand
                        break
                elif cand.is_dir():
                    copy_src = read_copy_source(cand)
                    if copy_src is not None and os.path.realpath(copy_src) == src_real:
                        ws_match = cand
                        break
                    if os.path.realpath(cand) == src_real:
                        ws_match = cand
                        break
            if ws_match is not None:
                log(
                    f"already active {name} (workspace {clean_p(ws_match)})",
                    file=sys.stderr,
                )
                continue
            kept.append((src, name))
        resolved_skills = kept

    # Check for conflicts across all destinations first
    for src, _name in resolved_skills:
        for d in dest_dirs:
            relpath = d / src.name
            conflict = ws.check_conflict(relpath)
            if conflict:
                cmderr("add", conflict)

    for src, name in resolved_skills:
        for d in dest_dirs:
            relpath = d / src.name
            d.mkdir(parents=True, exist_ok=True)
            if ws.uses_copies:
                copy_skill_dir(relpath, src)
            else:
                tmp_link = relpath.with_name(f".{relpath.name}.tmp-{os.getpid()}")
                tmp_link.unlink(missing_ok=True)
                try:
                    tmp_link.symlink_to(src)
                    os.replace(tmp_link, relpath)
                except Exception:
                    tmp_link.unlink(missing_ok=True)
                    raise
        log(f"added {name} -> {src}", file=sys.stderr)

    if prune:
        if has_errors or get_api().load_failures:
            print(
                "skill: warning: skipping --prune due to resolution or plugin load errors",
                file=sys.stderr,
            )
        else:
            entries, _ = scan_links(ws)
            home_dir = Path.home()
            home_real = home_dir.resolve()
            pruned_names: set[str] = set()
            for e in entries:
                if e.link_name in desired_link_names or ws.is_tracked(e.path):
                    continue
                if (
                    e.path.is_symlink()
                    and e.kind == "dangling"
                    and e.target is not None
                ):
                    in_home = e.target.is_relative_to(
                        home_dir
                    ) or e.target.is_relative_to(home_real)
                    if not in_home:
                        try:
                            parent_ok = e.target.parent.is_dir()
                        except OSError:
                            parent_ok = False
                        if not parent_ok:
                            print(
                                f"skill: warning: kept unlisted link {clean_p(e.path)} "
                                f"(source mount {clean_p(e.target.parent)} is unreachable)",
                                file=sys.stderr,
                            )
                            continue
                remove_skill_entry(e.path, ws.uses_copies)
                pruned_names.add(e.link_name)
            for pname in sorted(pruned_names):
                log(f"removed {pname}", file=sys.stderr)
            prune_dirs(dest_dirs)

    sync_records(ws)

    if resolved_skills and isinstance(ws, AgyBrainWorkspace):
        paths = [
            clean_p(ws.dest_dir / src.name / "SKILL.md") for src, _ in resolved_skills
        ]
        if len(paths) == 1:
            log(
                "session skills are in <skills> from the next turn; to use it "
                f"now, read {paths[0]}",
                file=sys.stderr,
            )
        else:
            joined = ", ".join(paths)
            log(
                "session skills are in <skills> from the next turn; to use one "
                f"now, read its SKILL.md directly ({joined})",
                file=sys.stderr,
            )

    if has_errors:
        sys.exit(1)


def is_home_workspace() -> bool:
    """Whether the workspace scope would land in the home directory itself."""
    home = Path.home().resolve()
    cwd = Path.cwd().resolve()
    if cwd != home:
        return False
    git_root = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    )
    return git_root.returncode != 0


def cmd_remove(names):
    quiet = any(a in ("-q", "--quiet") for a in names)
    names = [a for a in names if a not in ("-q", "--quiet")]
    if not names:
        cmderr("remove", "skill name required")

    ws = get_workspace()
    try:
        ws.get_dest_dirs()
    except RuntimeError as e:
        cmderr("remove", str(e))

    if not quiet:
        print_workspace_root(ws)
    entries, _ = scan_links(ws)

    removed = []
    removed_names: set[str] = set()
    for arg in names:
        candidates = {
            arg,
            arg.split(":", 1)[-1],
            os.path.basename(arg.rstrip("/")),
        }
        if not any(e.link_name in candidates for e in entries):
            # Only a name with no link of its own is looked up in the catalog:
            # resolving a remote spec may download it.
            try:
                src, name = resolve_skill_spec(arg)
                candidates |= {name, src.name}
            except Exception:
                pass
        matched = [e for e in entries if e.link_name in candidates and e not in removed]
        for e in matched:
            if ws.is_tracked(e.path):
                print(
                    f"skill remove: {rel_to(ws.root, e.path)} is tracked by "
                    "version control; leaving it in place",
                    file=sys.stderr,
                )
                continue
            remove_skill_entry(e.path, ws.uses_copies)
            removed.append(e)
            removed_names.add(e.link_name)
        if not matched and not quiet:
            print(f"skill remove: {arg} not present", file=sys.stderr)

    if not quiet:
        for name in sorted(removed_names):
            print(f"removed {name}", file=sys.stderr)

    sync_records(ws)
    prune_dirs(ws.get_dest_dirs())


def cmd_list(args):
    as_json = "--json" in args
    ws = get_workspace()
    entries, _ = scan_links(ws)

    # One row per link name (a skill is linked into each destination).
    rows = {}
    for e in entries:
        if e.kind == "live" and e.link_name not in rows:
            rows[e.link_name] = e
    rows = [rows[name] for name in sorted(rows)]

    if as_json:
        print(
            json.dumps(
                [
                    {
                        "name": e.link_name,
                        "scope": ws.scope,
                        "path": str(e.source) if e.source else None,
                    }
                    for e in rows
                ]
            )
        )
        return

    if rows:
        max_len = max(len(e.link_name) for e in rows)
        for e in rows:
            print(
                f"{e.link_name.ljust(max_len)}  {ws.scope:<9}  -> "
                f"{clean_p(e.source) if e.source else '?'}"
            )


def cmd_clean():
    ws = get_workspace()
    try:
        dest_dirs = ws.get_dest_dirs()
    except RuntimeError as e:
        cmderr("clean", str(e))

    print_workspace_root(ws)

    entries, unmanaged = scan_links(ws)
    if not entries and not any(d.is_dir() for d in dest_dirs):
        print("clean: nothing to do", file=sys.stderr)
        return

    removed = 0
    for e in entries:
        if ws.is_tracked(e.path):
            continue
        remove_skill_entry(e.path, ws.uses_copies)
        removed += 1
        print(f"removed {rel_to(ws.root, e.path)}", file=sys.stderr)
    kind_desc = "managed skill" if ws.uses_copies else "symlink"
    for p in unmanaged:
        print(
            f"clean: {rel_to(ws.root, p)} is not a {kind_desc}; leaving it in place",
            file=sys.stderr,
        )

    sync_records(ws)
    prune_dirs(dest_dirs)
    cleared = "; cleared git excludes" if isinstance(ws, GitWorkspace) else ""
    print(f"clean: removed {removed} entry/entries{cleared}", file=sys.stderr)
    if unmanaged:
        print(
            f"clean: {len(unmanaged)} path(s) left in place (unmanaged)",
            file=sys.stderr,
        )


def cmd_bundle(args: list[str]) -> None:
    output_path_str = None
    format_override = None
    use_workspace = False
    specs = []
    read_stdin = False

    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg in ("-h", "--help"):
            usage()
        elif arg in ("-w", "--workspace"):
            use_workspace = True
            idx += 1
        elif arg == "-o":
            idx += 1
            if idx >= len(args):
                cmderr("bundle", "-o requires a path argument")
            output_path_str = args[idx]
            idx += 1
        elif arg.startswith("-o="):
            output_path_str = arg[3:]
            idx += 1
        elif arg == "--output":
            idx += 1
            if idx >= len(args):
                cmderr("bundle", "--output requires a path argument")
            output_path_str = args[idx]
            idx += 1
        elif arg.startswith("--output="):
            output_path_str = arg[9:]
            idx += 1
        elif arg == "--format":
            idx += 1
            if idx >= len(args):
                cmderr(
                    "bundle",
                    "--format requires a type argument ('zip', 'tar.gz', 'dir')",
                )
            format_override = args[idx].lower()
            idx += 1
        elif arg.startswith("--format="):
            format_override = arg[9:].lower()
            idx += 1
        elif arg == "-":
            read_stdin = True
            idx += 1
        elif arg.startswith("-"):
            cmderr("bundle", f"unknown option '{arg}'")
        else:
            specs.append(arg)
            idx += 1

    if read_stdin:
        stdin_content = sys.stdin.read()
        specs.extend(stdin_content.split())

    # The workspace's linked skills are bundled from their sources directly:
    # a skill added by path has no catalog name to resolve.
    workspace_skills: list[tuple[Path, str, str]] = []
    if use_workspace:
        ws = get_workspace()
        entries, _ = scan_links(ws)
        seen = set()
        for e in entries:
            if e.kind == "live" and e.link_name not in seen:
                seen.add(e.link_name)
                src_candidate = (
                    e.source
                    if e.source is not None and copy_source_exists(e.source)
                    else e.path
                )
                src = Path(os.path.realpath(src_candidate))
                workspace_skills.append((src, e.link_name, e.link_name))
        if not workspace_skills and not specs:
            cmderr("bundle", f"no skills linked in {clean_p(ws.root)}")

    if not specs and not workspace_skills:
        cmderr("bundle", "skill name or --workspace required")

    if format_override:
        if format_override in ("tgz", "tar.gz"):
            fmt = "tar.gz"
        elif format_override in ("zip", "dir"):
            fmt = format_override
        else:
            cmderr(
                "bundle",
                f"unsupported format '{format_override}'; expected 'zip', 'tar.gz', or 'dir'",
            )
    elif output_path_str:
        p_name = output_path_str.lower()
        if p_name.endswith(".zip"):
            fmt = "zip"
        elif p_name.endswith((".tar.gz", ".tgz")):
            fmt = "tar.gz"
        else:
            fmt = "dir"
    else:
        fmt = "dir" if sys.stdout.isatty() else "tar.gz"

    resolved_skills: list[tuple[Path, str, str]] = []
    seen_srcs = set()
    for src_path, skill_name, spec in workspace_skills:
        if src_path not in seen_srcs:
            seen_srcs.add(src_path)
            resolved_skills.append((src_path, skill_name, spec))
    for spec in specs:
        try:
            src_path, skill_name = resolve_skill_spec(spec)
            if src_path not in seen_srcs:
                seen_srcs.add(src_path)
                resolved_skills.append((src_path, skill_name, spec))
        except Exception as e:
            cmderr("bundle", f"failed to resolve '{spec}': {e}")

    if not resolved_skills:
        cmderr("bundle", "no valid skills resolved to bundle")

    link_map: dict[str, tuple[Path, str]] = {}
    for src_path, _skill_name, spec in resolved_skills:
        folder_name = src_path.name
        if folder_name in link_map:
            prev_src, prev_spec = link_map[folder_name]
            if prev_src != src_path:
                cmderr(
                    "bundle",
                    f"conflict: '{spec}' and '{prev_spec}' both target folder name '{folder_name}' but resolve to different source paths",
                )
        link_map[folder_name] = (src_path, spec)

    if fmt == "dir":
        if output_path_str:
            out_dir = Path(output_path_str).expanduser().resolve()
            out_dir.mkdir(parents=True, exist_ok=True)
            for src_path, _, _ in resolved_skills:
                target_skill_dir = out_dir / src_path.name
                if target_skill_dir.exists():
                    shutil.rmtree(target_skill_dir)
                shutil.copytree(src_path, target_skill_dir)
            print(
                f"skill: bundled {len(resolved_skills)} skill(s) to {clean_p(out_dir)}",
                file=sys.stderr,
            )
        else:
            tmpdir = Path(tempfile.mkdtemp(prefix="skill-bundle-"))
            for src_path, _, _ in resolved_skills:
                target_skill_dir = tmpdir / src_path.name
                shutil.copytree(src_path, target_skill_dir)
            print(
                f"skill: bundled {len(resolved_skills)} skill(s) to temporary directory",
                file=sys.stderr,
            )
            print(str(tmpdir))

    elif fmt == "zip":

        def write_zip(dest_zip_path: Path | str) -> None:
            with zipfile.ZipFile(
                dest_zip_path, "w", compression=zipfile.ZIP_DEFLATED
            ) as zf:
                for src_path, _, _ in resolved_skills:
                    skill_folder_name = src_path.name
                    for root, dirs, files in os.walk(src_path):
                        dirs.sort()
                        rel_dir = Path(root).relative_to(src_path)
                        for d in dirs:
                            dir_path = Path(root) / d
                            arcname = str(Path(skill_folder_name) / rel_dir / d) + "/"
                            zf.write(dir_path, arcname=arcname)
                        for f in sorted(files):
                            file_path = Path(root) / f
                            arcname = str(Path(skill_folder_name) / rel_dir / f)
                            zf.write(file_path, arcname=arcname)

        if output_path_str:
            out_file = Path(output_path_str).expanduser().resolve()
            out_file.parent.mkdir(parents=True, exist_ok=True)
            write_zip(out_file)
            print(
                f"skill: bundled {len(resolved_skills)} skill(s) to {clean_p(out_file)}",
                file=sys.stderr,
            )
        else:
            fd, temp_zip_path = tempfile.mkstemp(prefix="skill-bundle-", suffix=".zip")
            os.close(fd)
            write_zip(temp_zip_path)
            print(
                f"skill: bundled {len(resolved_skills)} skill(s) to temporary zip archive",
                file=sys.stderr,
            )
            print(temp_zip_path)

    elif fmt == "tar.gz":

        def add_to_tar(tar_obj: tarfile.TarFile) -> None:
            for src_path, _, _ in resolved_skills:
                tar_obj.add(src_path, arcname=src_path.name)

        if output_path_str:
            out_file = Path(output_path_str).expanduser().resolve()
            out_file.parent.mkdir(parents=True, exist_ok=True)
            with tarfile.open(out_file, "w:gz") as tar:
                add_to_tar(tar)
            print(
                f"skill: bundled {len(resolved_skills)} skill(s) to {clean_p(out_file)}",
                file=sys.stderr,
            )
        else:
            if sys.stdout.isatty():
                fd, temp_tar_path = tempfile.mkstemp(
                    prefix="skill-bundle-", suffix=".tar.gz"
                )
                os.close(fd)
                with tarfile.open(temp_tar_path, "w:gz") as tar:
                    add_to_tar(tar)
                print(
                    f"skill: bundled {len(resolved_skills)} skill(s) to temporary tarball",
                    file=sys.stderr,
                )
                print(temp_tar_path)
            else:
                with tarfile.open(fileobj=sys.stdout.buffer, mode="w|gz") as tar:
                    add_to_tar(tar)
                sys.stdout.buffer.flush()


def cmd_update(names):
    if not names:
        cmderr("update", "skill name, --all, or --catalog required")

    api = get_api()

    def update_catalog_entry(name, entry, quiet_local: bool = False):
        if "repo" in entry:
            fetch_github(
                name, entry["repo"], entry["ref"], entry["subpath"], force=True
            )
        elif entry.get("generated"):
            ensure_catalog_stub(name, entry, force=True)
            print(
                f"skill update: '{name}' is generated; refreshed by plugin loader",
                file=sys.stderr,
            )
        else:
            ensure_catalog_stub(name, entry, force=True)
            if not quiet_local:
                print(
                    f"skill update: '{name}' is a local skill; nothing to update",
                    file=sys.stderr,
                )

    def refresh_copies(entries_to_refresh: list[DiskEntry]) -> None:
        reported: set[str] = set()
        for e in entries_to_refresh:
            if e.source is None or e.path.is_symlink() or e.tracked:
                continue
            if not copy_source_exists(e.source):
                print(
                    f"skill update: source missing for '{e.link_name}' "
                    f"({clean_p(e.source)}); skipping",
                    file=sys.stderr,
                )
                continue
            copy_skill_dir(e.path, e.source)
            if e.link_name not in reported:
                reported.add(e.link_name)
                print(f"updated {e.link_name} -> {e.source}", file=sys.stderr)

    if len(names) == 1 and names[0] == "--catalog":
        if _SCOPE != "workspace":
            cmderr("update", "--catalog does not take --scope", code=2)
        print("skill: refreshing catalog metadata index...", file=sys.stderr)
        ensure_catalog_index(api.plugin_catalog, force=True)
        print("catalog: metadata index updated", file=sys.stderr)
        return

    ws = None
    if _SCOPE != "workspace" or (
        not is_home_workspace() and not AgyBrainWorkspace.detect()
    ):
        ws_cand = get_workspace()
        if type(ws_cand) is not DefaultWorkspace or any(
            (ws_cand.root / sd).is_dir() for sd in anchor_subdirs()
        ):
            ws = ws_cand

    if len(names) == 1 and names[0] == "--all":
        if _SCOPE != "session":
            for cname, centry in api.plugin_catalog.items():
                update_catalog_entry(cname, centry, quiet_local=(_SCOPE == "user"))
        if ws is not None and ws.uses_copies:
            refresh_copies(scan_links(ws)[0])
        return

    def entry_source_norms(v: dict) -> set[str]:
        if "path" in v:
            p = Path(v["path"]).expanduser()
            return {os.path.normpath(p), os.path.realpath(p)}
        if "repo" in v and "ref" in v:
            rc = remote_cache_dir(v["repo"], v["ref"], v.get("subpath"))
            return {os.path.normpath(rc), os.path.realpath(rc)}
        return set()

    ws_entries = scan_links(ws)[0] if (ws is not None and ws.uses_copies) else []
    for name in names:
        cat_matches = (
            [(name, api.plugin_catalog[name])]
            if name in api.plugin_catalog
            else (
                [
                    (k, v)
                    for k, v in api.plugin_catalog.items()
                    if k.lower() == name.lower()
                ]
                if ":" in name
                else [
                    (k, v)
                    for k, v in api.plugin_catalog.items()
                    if (k.split(":", 1)[-1] if ":" in k else k).lower() == name.lower()
                ]
            )
        )
        if len(cat_matches) > 1:
            local_only = [m for m in cat_matches if "repo" not in m[1]]
            if local_only:
                cat_matches = local_only
        copy_names = {name, name.split(":", 1)[-1]} | _expected_names_for_spec(name)
        copies = [
            e
            for e in ws_entries
            if not e.path.is_symlink()
            and not e.tracked
            and e.source is not None
            and e.link_name in copy_names
        ]
        # An installed copy named directly by basename refreshes from its own
        # metadata.source even if a remote catalog skill shares that name.
        if copies and ":" not in name and any(e.link_name == name for e in copies):
            copy_src_norms = {
                s
                for e in copies
                if e.source
                for s in (os.path.normpath(e.source), os.path.realpath(e.source))
            }
            cat_matches = [
                (k, v)
                for k, v in api.plugin_catalog.items()
                if entry_source_norms(v) & copy_src_norms
            ]
        if not cat_matches and not copies:
            print(f"skill update: unknown skill '{name}'", file=sys.stderr)
            continue
        for cname, centry in cat_matches:
            update_catalog_entry(cname, centry, quiet_local=bool(copies))
        if cat_matches:
            matched_norms = {
                s for _, centry in cat_matches for s in entry_source_norms(centry)
            }
            copies = [
                e
                for e in copies
                if e.source
                and {os.path.normpath(e.source), os.path.realpath(e.source)}
                & matched_norms
            ]
        refresh_copies(copies)


def cmd_resolve(name):
    try:
        src_path, _ = resolve_skill_spec(name)
        print(src_path)
    except Exception as e:
        die(str(e))


# Top-level subdirectories whose presence tells a caller what kind of capability
# a skill is: executable automation (scripts/), reference material
# (references/), or a tested tool (tests/). Reported by name in the catalog's
# JSON so an agent can triage every candidate skill in one call.
COMPONENT_DIRS = ("scripts", "references", "tests")


def collect_skill_stats(skill_dir: Path) -> dict:
    """Measure a skill directory: total files/bytes, broken down per subdirectory.

    Returns {"file_count", "size_bytes", "dirs"}, where "dirs" maps each
    top-level subdirectory name (plus "(root)" for loose files) to a
    (file_count, size_bytes) pair. Dotfiles and __pycache__ are ignored, and an
    unreadable entry is skipped rather than failing the walk.

    Shared by 'info' (the human breakdown) and 'catalog --json' (the structural
    profile), so both report the same footprint for the same skill.
    """
    dir_stats: dict[str, tuple[int, int]] = {}
    root_files = 0
    root_size = 0

    try:
        entries = list(skill_dir.iterdir())
    except OSError:
        return {"file_count": 0, "size_bytes": 0, "dirs": {}}

    for item in entries:
        if item.name.startswith(".") or item.name == "__pycache__":
            continue
        if item.is_file():
            try:
                sz = item.stat().st_size
            except OSError:
                continue
            root_files += 1
            root_size += sz
        elif item.is_dir():
            files_count = 0
            dir_size = 0
            for root, dirs, files in os.walk(item):
                dirs[:] = [
                    d for d in dirs if not d.startswith(".") and d != "__pycache__"
                ]
                for f in files:
                    if f.startswith("."):
                        continue
                    try:
                        sz = (Path(root) / f).stat().st_size
                    except OSError:
                        continue
                    files_count += 1
                    dir_size += sz
            if files_count > 0:
                dir_stats[item.name] = (files_count, dir_size)

    total_files = root_files + sum(c for c, _ in dir_stats.values())
    total_size = root_size + sum(b for _, b in dir_stats.values())
    if root_files > 0:
        dir_stats["(root)"] = (root_files, root_size)

    return {"file_count": total_files, "size_bytes": total_size, "dirs": dir_stats}


def structure_fields(stats: dict | None) -> dict:
    """The JSON structural profile for a skill, as flat keys.

    stats is None for a skill whose content is not on disk (a remote entry that
    has never been downloaded). Every key is still emitted, with null standing
    for "not measured" so a consumer can tell it apart from a measured zero.
    """
    if stats is None:
        fields = {"file_count": None, "size_bytes": None}
        fields.update(dict.fromkeys(COMPONENT_DIRS))
        return fields
    fields = {"file_count": stats["file_count"], "size_bytes": stats["size_bytes"]}
    for d in COMPONENT_DIRS:
        fields[d] = stats["dirs"].get(d, (0, 0))[0]
    return fields


def format_size(size_bytes: int) -> str:
    if size_bytes < 1024:
        return f"{size_bytes} B"
    elif size_bytes < 1024 * 1024:
        return f"{size_bytes / 1024:.1f} KB"
    else:
        return f"{size_bytes / (1024 * 1024):.1f} MB"


def cmd_info(name):
    try:
        src_path, actual_name = resolve_skill_spec(name)
    except Exception as e:
        die(str(e))

    if not src_path.is_dir():
        die(f"resolved path '{src_path}' is not a directory")

    # Get description from metadata helper
    metadata = get_skill_metadata(src_path, actual_name)
    description = (
        metadata.get("description") or "No description found in SKILL.md frontmatter."
    )

    stats = collect_skill_stats(src_path)
    dir_stats = stats["dirs"]

    print(f"Skill: {actual_name}")
    print(f"Path:  {clean_p(src_path)}")
    print()
    print("Description:")
    import textwrap

    wrapped_desc = textwrap.fill(
        description, width=80, initial_indent="  ", subsequent_indent="  "
    )
    print(wrapped_desc)
    print()
    print("Metadata:")
    print(
        f"  Total Size:  {format_size(stats['size_bytes'])} "
        f"({stats['file_count']} files)"
    )
    if dir_stats:
        print("  Structure:")
        sorted_dirs = sorted([d for d in dir_stats if d != "(root)"])
        if "(root)" in dir_stats:
            sorted_dirs.insert(0, "(root)")
        for d in sorted_dirs:
            count, size = dir_stats[d]
            d_label = d if d == "(root)" else f"{d}/"
            print(f"    {d_label:<15} : {count:>2} files ({format_size(size)})")


def print_catalog(skills_info: list[dict], term_width: int) -> None:
    if not skills_info:
        return

    namespaces: dict[str, list[dict]] = {}
    for s in sorted(skills_info, key=lambda x: x["name"]):
        ns = s.get("namespace") or (
            s["name"].split(":")[0] if ":" in s["name"] else "default"
        )
        namespaces.setdefault(ns, []).append(s)

    def ns_order(ns: str) -> tuple[int, str]:
        if ns == "local":
            return (0, ns)
        elif ns == "remote":
            return (2, ns)
        else:
            return (1, ns)

    sorted_ns = sorted(namespaces.keys(), key=ns_order)

    for idx, ns in enumerate(sorted_ns):
        skills = namespaces[ns]
        plugin_files = sorted({s["plugin"] for s in skills if s.get("plugin")})
        plugin_str = f"via {', '.join(plugin_files)}" if plugin_files else ""
        info_str = f" ({plugin_str})" if plugin_str else ""

        if idx > 0:
            print()
        print(f"{ns}{info_str}:" if ns else f"default{info_str}:")
        indent = "  "

        rows = [(s["name"], s["source"]) for s in skills]

        fit_names = [
            name
            for name, disp_src in rows
            if len(indent) + len(name) + 4 + len(disp_src) <= term_width
            and len(name) <= 45
        ]
        if fit_names:
            max_len = max(len(name) for name in fit_names)
        else:
            max_len = max(len(name) for name, _ in rows)

        for name, disp_src in rows:
            total_w = len(indent) + max_len + 4 + len(disp_src)
            if len(name) <= max_len and total_w <= term_width:
                print(f"{indent}{name.ljust(max_len)} -> {disp_src}")
            else:
                print(f"{indent}{name}")
                if len(indent) + max_len + 4 + len(disp_src) <= term_width:
                    arrow_indent = max_len
                else:
                    arrow_indent = 2
                print(f"{indent}{''.ljust(arrow_indent)} -> {disp_src}")


def cmd_catalog(as_json=False):
    api = get_api()
    ensure_catalog_index(api.plugin_catalog)

    skills_info = []

    # Scan all registered plugin skills. Structural stats are measured from
    # whatever content is already on disk -- a local source directory, or a
    # remote repository previously downloaded into the cache. A remote skill
    # that has never been downloaded is reported from its cached SKILL.md
    # frontmatter alone and marked "remote": listing a catalog must never pull
    # a repository over the network. Only the JSON form reports metadata and
    # structure, so the human listing skips those reads entirely.
    for name, entry in api.all_registrations:
        ns = name.split(":")[0] if ":" in name else "default"
        if "path" in entry:
            if as_json:
                # A plugin may name a faster, read-only view of the same
                # content (scan_path); it is only ever read here, while the
                # reported source -- like every link target -- stays 'path'.
                src_dir = Path(entry.get("scan_path") or entry["path"]).expanduser()
                on_disk = src_dir.is_dir()
                meta = get_skill_metadata(src_dir, name)
                obj = {
                    "name": name,
                    "description": meta["description"],
                    "source": clean_p(entry["path"]),
                    "namespace": ns,
                    "status": "local" if on_disk else "missing",
                }
                obj.update(
                    structure_fields(collect_skill_stats(src_dir) if on_disk else None)
                )
            else:
                obj = {
                    "name": name,
                    "source": clean_p(entry["path"]),
                    "namespace": ns,
                }
            if entry.get("plugin_file"):
                obj["plugin"] = entry["plugin_file"]
            skills_info.append(obj)
        elif "repo" in entry:
            stub_dir = get_catalog_dir() / name
            subpath = entry.get("subpath")
            if subpath:
                src_str = (
                    f"https://github.com/{entry['repo']}/tree/{entry['ref']}/{subpath}"
                )
            elif entry.get("ref") not in ("main", "master"):
                src_str = f"https://github.com/{entry['repo']}/tree/{entry['ref']}"
            else:
                src_str = f"https://github.com/{entry['repo']}"
            if as_json:
                meta = get_skill_metadata(stub_dir, name)
                cached_dir = cached_remote_dir(entry)
                obj = {
                    "name": name,
                    "description": meta["description"],
                    "source": src_str,
                    "namespace": ns,
                    "status": "cached" if cached_dir else "remote",
                }
                obj.update(
                    structure_fields(
                        collect_skill_stats(cached_dir) if cached_dir else None
                    )
                )
            else:
                obj = {
                    "name": name,
                    "source": src_str,
                    "namespace": ns,
                }
            if entry.get("plugin_file"):
                obj["plugin"] = entry["plugin_file"]
            skills_info.append(obj)

    # Deduplicate identical target paths within the same group/type
    deduped_info = []
    seen_group_sources = set()
    for s in skills_info:
        key = (s["namespace"], s["source"])
        if key in seen_group_sources:
            continue
        seen_group_sources.add(key)
        deduped_info.append(s)
    skills_info = deduped_info

    # Detect naming conflicts (same name across distinct targets)
    name_counts = {}
    for s in skills_info:
        name_counts[s["name"]] = name_counts.get(s["name"], 0) + 1
    for s in skills_info:
        if name_counts[s["name"]] > 1 and "(! CONFLICT)" not in s["name"]:
            s["name"] = f"{s['name']} (! CONFLICT)"

    if as_json:
        for s in sorted(skills_info, key=lambda x: x["name"]):
            print(json.dumps(s))
    else:
        term_width = shutil.get_terminal_size((80, 24)).columns
        print_catalog(skills_info, term_width)


def colorize(text: str, color_name: str, enabled: bool = True) -> str:
    """Applies ANSI terminal styling to text if enabled."""
    if not enabled:
        return text
    codes = {
        "green": "\033[32m",
        "yellow": "\033[33m",
        "red": "\033[31m",
        "bold": "\033[1m",
        "reset": "\033[0m",
    }
    return f"{codes.get(color_name, '')}{text}{codes['reset']}"


def cmd_doctor(
    verbose: bool = False,
    check_catalog: bool = False,
    stream=sys.stderr,
    as_json: bool = False,
    ws=None,
) -> bool:
    """Checks the health of the scope's links, copies, and skill catalog."""
    if ws is None:
        ws = get_workspace()
    # Styling is an enhancement only: disabled when NO_COLOR is set
    # (https://no-color.org), forced by FORCE_COLOR, otherwise on only when
    # the destination stream is attached to a terminal.
    if os.environ.get("NO_COLOR"):
        use_color = False
    else:
        force = os.environ.get("FORCE_COLOR")
        if force and force != "0":
            use_color = True
        else:
            use_color = stream.isatty() if hasattr(stream, "isatty") else False

    entries, unmanaged = scan_links(ws)

    def rel(p):
        try:
            return p.relative_to(ws.root)
        except ValueError:
            return p

    dest_dirs = []
    dest_err = None
    try:
        dest_dirs = ws.get_dest_dirs()
    except RuntimeError as e:
        dest_err = str(e)

    scope_opt = "" if ws.scope == "workspace" else f"--scope {ws.scope} "
    checks = []

    # Check 1: Workspace Detection
    # The workspace root is the most critical path in the report: every skill
    # symlink and exclude entry is relative to it, and the anchor walk can
    # resolve it above the current directory. Lead with it and label it plainly.
    if isinstance(ws, AgyBrainWorkspace):
        ws_type = "Antigravity session directory"
    elif isinstance(ws, ClaudeSessionWorkspace):
        ws_type = "Claude session directory"
    elif isinstance(ws, UserWorkspace):
        ws_type = "User skill directories"
    elif isinstance(ws, GitWorkspace):
        ws_type = "Git repository"
    else:
        ws_type = "Non-VCS directory"
    cwd = Path.cwd().resolve()
    ws_details = [f"Root: {clean_p(ws.root)}"]
    if ws.scope == "workspace" and ws.root != cwd:
        ws_details.append(f"Anchor resolved above current directory {clean_p(cwd)}")
    checks.append(
        {
            "name": "Workspace",
            "status": "OK",
            "summary": ws_type,
            "details": ws_details,
        }
    )

    # Check 1b: Plugin Load Failures
    # A plugin that raises during import/register() currently drops out
    # silently: get_api() only prints a one-line stderr warning, so a
    # "healthy" catalog can be silently missing that plugin's skills. Surface
    # the failures here so they show up as drift instead of scrolling past.
    load_failures = get_api().load_failures
    if load_failures:
        checks.append(
            {
                "name": "Plugin Loading",
                "status": "ERROR",
                "summary": f"Found {len(load_failures)} plugin(s) that failed to load",
                "details": ["Failed to load:"]
                + [f"  - {name}: {error}" for name, error in load_failures],
            }
        )
    else:
        checks.append(
            {
                "name": "Plugin Loading",
                "status": "OK",
                "summary": "All plugins loaded successfully",
                "details": [],
            }
        )

    # Check 2: Agent Configuration
    if dest_err:
        checks.append(
            {
                "name": "Agent Configuration",
                "status": "ERROR",
                "summary": "No active agent configuration detected",
                "details": [dest_err],
            }
        )
    else:
        dest_desc = ", ".join(clean_p(d) for d in dest_dirs)
        checks.append(
            {
                "name": "Agent Configuration",
                "status": "OK",
                "summary": f"Found active destination(s): {dest_desc}",
                "details": [],
            }
        )

    # Check 3: Installed Skills (informational).
    live_names = sorted({e.link_name for e in entries if e.kind == "live"})
    installed_details = []
    if live_names:
        import textwrap

        wrapped = textwrap.wrap(
            ", ".join(live_names),
            width=72,
            break_long_words=False,
            break_on_hyphens=False,
        )
        installed_details = ["Skills:", *[f"  {line}" for line in wrapped]]
    installed_verb = "installed" if ws.uses_copies else "linked"
    checks.append(
        {
            "name": "Installed Skills",
            "status": "OK",
            "summary": f"{len(live_names)} skill(s) {installed_verb}",
            "details": installed_details,
        }
    )

    # Check 3b: Skill Conflicts (advisory)
    api = get_api()
    local_name_paths = {}
    for name, spec in api.all_registrations:
        if name.startswith("local:") and "path" in spec:
            sname = name.split(":", 1)[1]
            realpath = Path(os.path.realpath(spec["path"]))
            local_name_paths.setdefault(sname, set()).add(realpath)

    conflict_details = []
    for sname, paths in sorted(local_name_paths.items()):
        if len(paths) > 1:
            path_strs = ", ".join(clean_p(p) for p in sorted(paths))
            conflict_details.append(
                f"  - '{sname}' found in multiple distinct paths: {path_strs}"
            )

    if conflict_details:
        checks.append(
            {
                "name": "Skill Conflicts",
                "status": "WARNING",
                "summary": f"Found {len(conflict_details)} local skill name conflict(s)",
                "details": [
                    "Conflicting skill names across SKILL_SOURCE_DIRS:",
                    *conflict_details,
                ],
            }
        )
    else:
        checks.append(
            {
                "name": "Skill Conflicts",
                "status": "OK",
                "summary": "No conflicting skill names across SKILL_SOURCE_DIRS",
                "details": [],
            }
        )

    # Check 4: Symlink Health (broken symlinks and copies with missing sources)
    added_dangling = [e for e in entries if e.kind == "dangling" and not e.tracked]
    tracked_dangling = [e for e in entries if e.kind == "dangling" and e.tracked]
    if tracked_dangling or added_dangling:
        dangling_details = []
        if added_dangling:
            dangling_details.append("Entries whose source is missing:")
            dangling_details += [f"  - {rel(e.path)}" for e in added_dangling]
        if tracked_dangling:
            dangling_details.append("Broken links tracked by version control:")
            dangling_details += [f"  - {rel(e.path)}" for e in tracked_dangling]
        total = len(tracked_dangling) + len(added_dangling)
        checks.append(
            {
                "name": "Symlink Health",
                "status": "ERROR" if tracked_dangling else "WARNING",
                "summary": f"Found {total} broken link(s)",
                "details": dangling_details,
            }
        )
    else:
        checks.append(
            {
                "name": "Symlink Health",
                "status": "OK",
                "summary": "No broken links",
                "details": [],
            }
        )

    # Check 5: Directory Cleanliness. The user scope's directories are shared
    # with whatever else installs skills there (a cloud platform's own, for
    # one), so a stray entry there is a warning, not a failure that would
    # stop 'skill --scope user add' in a setup script.
    if unmanaged:
        checks.append(
            {
                "name": "Directory Cleanliness",
                "status": "WARNING" if ws.scope == "user" else "ERROR",
                "summary": f"Found {len(unmanaged)} unmanaged item(s) in skill folders",
                "details": ["Unmanaged artifacts (should be moved or deleted):"]
                + [f"  - {rel(item)}" for item in unmanaged],
            }
        )
    else:
        checks.append(
            {
                "name": "Directory Cleanliness",
                "status": "OK",
                "summary": "No unmanaged files or directories in skill folders",
                "details": [],
            }
        )

    # Check 5b: VCS-Managed Skills (Informational)
    tracked_skills = ws.get_tracked_skills()
    if tracked_skills:
        checks.append(
            {
                "name": "VCS-Managed Skills",
                "status": "OK",
                "summary": f"Found {len(tracked_skills)} skill(s) committed to the repository",
                "details": [f"  - {rel(item)}" for item in tracked_skills],
            }
        )

    # Check 6: Orphaned Directories
    home = Path.home()
    orphaned = []
    configs = ws.get_supported_configs()

    for dest, sources in configs.items():
        if (ws.root / dest).is_dir() and not any(src.is_dir() for src in sources):
            formatted_sources = [
                f"~/{src.relative_to(home)}" if src.is_relative_to(home) else str(src)
                for src in sources
            ]
            if len(formatted_sources) == 1:
                msg = f"local folder exists, but {formatted_sources[0]} config directory does not exist"
            else:
                msg = f"local folder exists, but none of the config directories ({', '.join(formatted_sources)}) exist"
            orphaned.append((dest, msg))

    if orphaned:
        checks.append(
            {
                "name": "Orphaned Directories",
                "status": "WARNING",
                "summary": f"Found {len(orphaned)} orphaned skill directory/directories",
                "details": ["Orphaned folders:"]
                + [f"  - {path} ({reason})" for path, reason in orphaned],
            }
        )
    else:
        checks.append(
            {
                "name": "Orphaned Directories",
                "status": "OK",
                "summary": "No orphaned skill directories detected",
                "details": [],
            }
        )

    # Check 7: Workspace Exclusions (git excludes, Antigravity's skills.json)
    backend_issues = ws.doctor_issues()
    if backend_issues:
        checks.append(
            {
                "name": "Workspace Exclusions",
                "status": "ERROR",
                "summary": "Exclude configuration drift detected",
                "details": ["Exclude drift issues:"]
                + [f"  - {issue}" for issue in backend_issues],
            }
        )
    elif isinstance(ws, GitWorkspace):
        checks.append(
            {
                "name": "Workspace Exclusions",
                "status": "OK",
                "summary": f"{clean_p(ws.exclude_file)} is fully synchronized",
                "details": [],
            }
        )

    # Catalog-specific checks
    unresolvable_local = False
    catalog_index_issues = []
    catalog_stale_issues = []
    plugin_path_issues = []

    if check_catalog:
        api = get_api()
        catalog_dir = get_catalog_dir()
        meta_dir = catalog_dir / ".meta"

        for name, entry in api.plugin_catalog.items():
            if name.startswith("local:"):
                continue
            stub_md = catalog_dir / name / "SKILL.md"
            meta = meta_dir / name

            if "path" in entry:
                target_path = Path(entry["path"]).expanduser()
                if (
                    not entry.get("optional")
                    and not Path(entry.get("scan_path") or target_path).is_dir()
                ):
                    plugin_path_issues.append(
                        f"  - {name} (path does not exist: {clean_p(target_path)})"
                    )
                    unresolvable_local = True
                continue

            if not stub_md.is_file():
                catalog_index_issues.append(f"  - {name} (missing {clean_p(stub_md)})")
            elif meta.is_file() and (time.time() - meta.stat().st_mtime) > CATALOG_TTL:
                catalog_stale_issues.append(
                    f"  - {name} (stale metadata {clean_p(meta)})"
                )

        # Check 8: Plugin Local Paths
        if plugin_path_issues:
            checks.append(
                {
                    "name": "Plugin Local Paths",
                    "status": "ERROR",
                    "summary": f"Found {len(plugin_path_issues)} missing plugin-defined local path(s)",
                    "details": ["Missing plugin paths:", *plugin_path_issues],
                }
            )
        else:
            checks.append(
                {
                    "name": "Plugin Local Paths",
                    "status": "OK",
                    "summary": "All plugin-defined local paths exist",
                    "details": [],
                }
            )

        # Check 9: Catalog Cache
        catalog_details = []
        if catalog_index_issues:
            catalog_details.append("Missing from catalog index:")
            for issue in catalog_index_issues:
                catalog_details.append(f"  {issue}")
        if catalog_stale_issues:
            catalog_details.append("Stale catalog indexes:")
            for issue in catalog_stale_issues:
                catalog_details.append(f"  {issue}")

        if catalog_index_issues or catalog_stale_issues:
            status = "WARNING" if is_offline() or not catalog_index_issues else "ERROR"
            checks.append(
                {
                    "name": "Catalog Cache",
                    "status": status,
                    "summary": f"Catalog cache issues detected in {clean_p(catalog_dir)} ({len(catalog_index_issues)} missing, {len(catalog_stale_issues)} stale)",
                    "details": catalog_details,
                }
            )
        else:
            checks.append(
                {
                    "name": "Catalog Cache",
                    "status": "OK",
                    "summary": f"All remote catalog stubs are indexed and fresh in {clean_p(catalog_dir)}",
                    "details": [],
                }
            )

    # Check 10: Offline Mode
    #
    # Reported rather than judged: being offline is a legitimate configuration,
    # not a fault, so this is always OK and never fails an agent launch. It is
    # here because an answer served from cache and one fetched live are
    # different things, and a caller debugging a stale remote skill needs to
    # see which mode was in force and how old the cache is before anything else
    # makes sense (caching.md, "Include Provenance").
    cache_dir = get_cache_dir()
    if is_offline():
        offline_summary = (
            f"Offline ({offline_desc()}): remote skills served from cache at any age"
        )
    else:
        offline_summary = (
            "Online: remote skills are fetched and the cache written through"
        )
    offline_details = [f"Cache: {clean_p(cache_dir)}"]

    # Dated from the newest .meta stamp rather than the mtime of cache/remotes
    # itself: that directory is touched only when a top-level owner entry is
    # added, so refreshing an existing <owner>/<repo>/<ref> underneath leaves it
    # alone and the reported age drifts arbitrarily far behind the real
    # downloads. fetch_github writes a .meta file on every successful fetch,
    # which is exactly the event being dated.
    meta_dir = get_catalog_dir() / ".meta"
    newest = None
    if meta_dir.is_dir():
        stamps = [p for p in meta_dir.iterdir() if p.is_file()]
        if stamps:
            newest = max(stamps, key=lambda p: p.stat().st_mtime)
    if newest is not None:
        offline_details.append(f"Remote skills last downloaded {age_human(newest)}")
    else:
        offline_details.append("No remote skills have been downloaded yet")
    checks.append(
        {
            "name": "Offline Mode",
            "status": "OK",
            "summary": offline_summary,
            "details": offline_details,
        }
    )

    # Render checks. Every non-OK check (WARNING or ERROR) is a finding and
    # makes 'doctor' exit non-zero.
    def is_visible(check):
        return verbose or check["status"] != "OK"

    fail = any(c["status"] != "OK" for c in checks)

    def format_status(status):
        if status == "OK":
            tag, color_name = "[PASS]", "green"
        elif status == "WARNING":
            tag, color_name = "[WARN]", "yellow"
        else:
            tag, color_name = "[FAIL]", "red"
        return colorize(tag, color_name, use_color)

    # Per-finding remediation, attached to the check it belongs to so fixes
    # never scroll away from the finding that prompted them.
    for check in checks:
        if check["status"] == "OK":
            continue
        name = check["name"]
        if name == "Symlink Health":
            if added_dangling:
                check["details"].append(
                    "To resolve: restore the missing sources (e.g. remount or "
                    "'skill update NAME'), or remove the entries:"
                )
                check["details"].append(
                    f"  skill {scope_opt}remove "
                    + " ".join(sorted({e.link_name for e in added_dangling}))
                )
            if tracked_dangling:
                check["details"].append(
                    "To resolve: 'skill' never removes a tracked link -- fix "
                    "its target or delete it from the repository:"
                )
                check["details"].append(
                    "  rm "
                    + " ".join(str(rel(e.path)) for e in tracked_dangling)
                    + "   # then 'git rm --cached' if already staged/committed"
                )
        elif name == "Workspace Exclusions":
            check["details"].append(
                "To repair: run 'skill add <name>' or 'skill remove <name>' "
                "to rewrite the exclude block."
            )
        elif name == "Directory Cleanliness":
            check["details"].append(
                "To resolve: manually delete or move the unmanaged files/directories out of the skill folders."
            )
        elif name == "Orphaned Directories":
            rm_cmds = " && ".join(
                f"rm -rf {clean_p(ws.root / path) if ws.scope == 'user' else path}"
                for path, _ in orphaned
            )
            check["details"].append(
                "To resolve: delete the orphaned directory/directories if you no longer use those agents:"
            )
            check["details"].append(f"  {rm_cmds}")
        elif name == "Plugin Loading":
            check["details"].append(
                "To resolve: fix or remove the failing plugin file(s) listed above "
                "(rerun with SKILL_DEBUG=1 for a full traceback)."
            )
        elif name == "Plugin Local Paths":
            check["details"].append(
                "To resolve: fix the missing local paths for your plugins in your configuration."
            )
        elif name == "Catalog Cache" and not unresolvable_local:
            has_missing = any(
                "Missing from catalog index:" in line for line in check["details"]
            )
            if has_missing:
                check["details"].append(
                    "To resolve: run 'skill update --all' (or 'skill update <name>') to repair the skill cache."
                )
            else:
                check["details"].append(
                    "To resolve: run 'skill update --catalog' to refresh the catalog metadata index."
                )

    # Machine-readable surface: emit the full check list (status/summary/details
    # complete, including remediation) plus the links found, so tests and tools
    # assert against structured data instead of parsing the report. The exit
    # status is unchanged; only the rendering differs.
    if as_json:
        print(
            json.dumps(
                {
                    "healthy": not fail,
                    "checks": checks,
                    "links": [
                        {
                            "name": e.link_name,
                            "path": str(rel(e.path)),
                            "broken": e.kind == "dangling",
                            "tracked": e.tracked,
                        }
                        for e in entries
                    ],
                    "unmanaged": [str(rel(p)) for p in unmanaged],
                }
            )
        )
        return not fail

    for check in checks:
        if is_visible(check):
            print(
                f"{format_status(check['status'])} {check['name']}: {check['summary']}",
                file=stream,
            )
            if check["details"]:
                for line in check["details"]:
                    print(f"    {line}", file=stream)

    if fail:
        return False

    if verbose:
        print(
            f"\n{colorize('[PASS]', 'green', use_color)}  All skill links are healthy.",
            file=stream,
        )
    return True


def cmd_doctor_all(as_json: bool = False):
    """Canonical entrypoint for the 'skill doctor' command.

    Runs both local and catalog diagnostics, printing to stdout with verbose reporting.
    """
    healthy = cmd_doctor(
        verbose=True, check_catalog=True, stream=sys.stdout, as_json=as_json
    )
    sys.exit(0 if healthy else 1)


def skill_root() -> Path:
    """The directory holding this skill's SKILL.md, found by sentinel rather
    than depth so that a symlink or a move within the tree still works.
    SKILL_MCP_SKILL_DIR names it when the script has been copied elsewhere."""
    override = os.environ.get("SKILL_MCP_SKILL_DIR")
    if override:
        return Path(override).expanduser().resolve()
    for parent in Path(__file__).resolve().parents:
        if (parent / "SKILL.md").is_file():
            return parent
    cmderr("mcp", "cannot find SKILL.md above this script; set SKILL_MCP_SKILL_DIR")


def cmd_mcp(args: list[str]) -> None:
    """Hand over to the MCP server, which carries its own dependencies so that
    every other command stays free of them."""
    server = skill_root() / "scripts" / "skill-mcp"
    if not server.is_file():
        cmderr("mcp", f"{server} not found; set SKILL_MCP_SKILL_DIR")
    uv = shutil.which("uv")
    if uv is None:
        cmderr("mcp", "uv not found", code=127)
    try:
        os.execv(uv, [uv, "run", "--quiet", "--script", str(server), *args])
    except OSError as e:
        cmderr("mcp", f"cannot run {server}: {e.strerror or e}")


def usage():
    print(
        """Usage: skill [-C DIR] [--scope SCOPE] <command> [skill...]

Manage agent skills in the directories each installed agent reads for the
chosen scope:
  user       symlinks in ~/.claude/skills (Claude), ~/.agents/skills (Codex,
             OpenCode) and ~/.gemini/config/skills (Antigravity, Jetski) --
             holds baseline default skills reconciled by install.sh
  workspace  copies (with metadata.source in SKILL.md) in .claude/skills and
             .agents/skills at the repository's skill anchor, plus a block in
             .git/info/exclude (the default)
  session    copies (with metadata.source in SKILL.md) in the calling agent's
             own session: $AGENT_SESSION_DIR/.claude/skills (Claude) or
             brain/<id>/.agents/skills (Antigravity, Jetski); only launchers
             that give a session its own directory support it (see the
             agent-config skill, references/model.md)

Commands:
  add [-q] [-p|--prune] SPEC...
                       Install a skill from 'skill catalog' (NAME or
                       NAMESPACE:NAME) or a local skill directory path;
                       --prune removes unlisted managed entries in the scope
  add [-q] [-p|--prune] -
                       Read skill names from stdin
  remove [-q] NAME...  Remove a skill's entries and exclude records (alias: rm)
  list [--json]        List installed skills in the scope
  clean                Remove all managed skill entries in the scope
  doctor [--json]      Check the scope's links, copies and catalog (read-only)
  bundle [SPEC...]     Package skills into an archive or directory
  update SPEC...       Refresh workspace/session copies from their source and
                       re-fetch plugin-provided catalog entries; --all for all,
                       --catalog to refresh the whole metadata index
  catalog [--json]     List plugin-provided skills and sources; --json outputs
                       NDJSON (one JSON object per line) with description and
                       structural profile (scripts/, references/, tests/ counts)
  resolve SPEC         Print the source path 'add SPEC' would resolve to
  show/info SPEC       Show details and metadata of a skill
  mcp [SCOPE]          Serve skills over MCP, to agents that cannot read them
                       from disk; see 'skill mcp --help'

Options:
  -C, --directory DIR  Run as if started in DIR instead of the current directory
  --scope SCOPE        'user', 'workspace' (default) or 'session'; only add,
                       remove, list, doctor, clean and update take a scope
                       other than 'workspace'
  --offline            Never fetch remote skills or metadata over the network
                       (same as AGENT_OFFLINE=1)
  --help, -h           Display this help message and exit
  --plugin-template    Output a template/documentation for creating a Workspace plugin

Environment:
  AGENT_OFFLINE      Set to 1 to never fetch remote skills, serving whatever
                     has already been downloaded (at any age) instead. A skill
                     that has never been fetched is an error, not a guess.
  AGENT_SESSION_DIR  Session directory for --scope session under Claude; set
                     with AGENT_SESSION_ID by the claude wrapper, and honored
                     only while AGENT_SESSION_ID matches CLAUDE_CODE_SESSION_ID
  SKILL_CACHE_DIR    Cache directory for remote skills and catalog metadata
                     (default: ${XDG_CACHE_HOME:-$HOME/.cache}/skill)

Examples:
  skill add adb
  skill --scope session add jetpack
  skill --scope user add workspace-tools
  printf '%s\\n' adb jetpack | skill --scope session add -
  skill list --json"""
    )
    sys.exit(0)


def main():
    global _SCOPE

    if "--plugin-template" in sys.argv:
        print('''"""
Example Plugin for the skill script.
Save this file as ~/.config/skill/plugins/my_plugin.py

register() runs on every skill invocation. Keep it fast and
side-effect-free: no network calls, subprocesses, or filesystem writes.

If the plugin encounters a fatal environment error (e.g., missing corporate
credentials/mounts) and must abort execution immediately, print a clean
error message to stderr and call sys.exit(1).
"""

def register(api):
    """
    This function is automatically called by `skill` when the plugin is loaded.
    You must register your custom Workspace classes here using the provided `SkillAPI`.
    """

    class MyCustomWorkspace(api.Workspace):
        """Custom workspace implementation."""

        @classmethod
        def detect(cls):
            """Detect if the current directory is of this workspace type.

            Return an instance of MyCustomWorkspace if detected, else None.
            """
            return None

    api.register_workspace(MyCustomWorkspace)

    # Skills can be added to the catalog as a GitHub tree URL, or as a dict:
    #   path       Directory holding SKILL.md; installed links point here.
    #   resolve    False keeps 'path' literal (no realpath), for virtual
    #              mounts whose resolved form changes over time.
    #   scan_path  Optional read-only view of the same content that is cheaper
    #              to read (e.g. a pinned snapshot of a moving mount). Used to
    #              check the skill exists and to read metadata and structure;
    #              never a link target or compared against links, so it may
    #              change between runs.
    # api.register_skill("example:my-skill", {"path": "~/src/skills/my-skill"})
''')
        sys.exit(0)

    target_dir_str = None
    explicit_scope = None
    filtered_argv = []
    raw_argv = sys.argv[1:]
    idx = 0
    after_double_dash = False

    while idx < len(raw_argv):
        arg = raw_argv[idx]
        if after_double_dash:
            filtered_argv.append(arg)
            idx += 1
            continue
        if arg == "--":
            after_double_dash = True
            filtered_argv.append(arg)
            idx += 1
        elif arg in ("-C", "--directory"):
            idx += 1
            if idx >= len(raw_argv):
                print(f"skill: option '{arg}' requires an argument", file=sys.stderr)
                sys.exit(2)
            target_dir_str = raw_argv[idx]
            idx += 1
        elif arg.startswith("-C="):
            target_dir_str = arg[3:]
            idx += 1
        elif arg.startswith("--directory="):
            target_dir_str = arg[len("--directory=") :]
            idx += 1
        elif arg == "--scope":
            idx += 1
            if idx >= len(raw_argv):
                print(
                    "skill: option '--scope' requires an argument "
                    "('user', 'workspace' or 'session')",
                    file=sys.stderr,
                )
                sys.exit(2)
            explicit_scope = raw_argv[idx].lower()
            idx += 1
        elif arg.startswith("--scope="):
            explicit_scope = arg[len("--scope=") :].lower()
            idx += 1
        elif arg == "--offline":
            os.environ["AGENT_OFFLINE"] = "1"
            idx += 1
        else:
            filtered_argv.append(arg)
            idx += 1

    if filtered_argv and filtered_argv[0] == "mcp":
        if explicit_scope is not None:
            print("skill: 'mcp' does not take --scope", file=sys.stderr)
            sys.exit(2)
        if target_dir_str is not None:
            try:
                os.chdir(Path(target_dir_str).expanduser())
            except OSError as e:
                die(f"cannot change directory to '{target_dir_str}': {e.strerror or e}")
        cmd_mcp(filtered_argv[1:])

    if (
        not filtered_argv
        or filtered_argv[0] in ("--help", "-h", "help")
        or "--help" in filtered_argv
        or "-h" in filtered_argv
    ):
        usage()

    cmd = filtered_argv[0]
    if cmd.startswith("-"):
        print(f"skill: unknown option '{cmd}'", file=sys.stderr)
        print("Try 'skill --help' for more information.", file=sys.stderr)
        sys.exit(2)
    if explicit_scope is not None:
        if explicit_scope not in ("user", "workspace", "session"):
            print(
                f"skill: invalid --scope value '{explicit_scope}'; "
                "expected 'user', 'workspace' or 'session'",
                file=sys.stderr,
            )
            sys.exit(2)
        _SCOPE = explicit_scope
    if _SCOPE != "workspace" and cmd not in (
        "add",
        "remove",
        "rm",
        "list",
        "doctor",
        "clean",
        "update",
    ):
        print(f"skill: '{cmd}' does not take --scope {_SCOPE}", file=sys.stderr)
        sys.exit(2)

    if target_dir_str is not None:
        target_dir = Path(target_dir_str).expanduser()
        try:
            os.chdir(target_dir)
        except OSError as e:
            die(f"cannot change directory to '{target_dir_str}': {e.strerror or e}")

    args = filtered_argv[1:]

    if cmd == "doctor":
        unknown = [a for a in args if a != "--json"]
        if unknown:
            cmderr("doctor", f"unexpected argument '{unknown[0]}'", code=2)
        cmd_doctor_all(as_json="--json" in args)
    elif cmd == "catalog":
        as_json = "--json" in args
        cmd_catalog(as_json=as_json)
    elif cmd == "resolve":
        if not args:
            cmderr("resolve", "skill name required")
        cmd_resolve(args[0])
    elif cmd in ("info", "show"):
        if not args:
            cmderr(cmd, "skill name required")
        cmd_info(args[0])
    elif cmd == "update":
        cmd_update(args)
    elif cmd == "add":
        cmd_add(args)
    elif cmd in ("remove", "rm"):
        cmd_remove(args)
    elif cmd == "list":
        cmd_list(args)
    elif cmd == "clean":
        cmd_clean()
    elif cmd == "bundle":
        cmd_bundle(args)
    else:
        print(f"skill: unknown command '{cmd}'", file=sys.stderr)
        print("Try 'skill --help' for more information.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    try:
        try:
            main()
        finally:
            # Flush inside the guard. Buffered output would otherwise fail at
            # interpreter shutdown, past every handler here, and CPython would
            # print "Exception ignored ... BrokenPipeError" and exit 120.
            try:
                sys.stdout.flush()
            except BrokenPipeError:
                raise
            except Exception:
                pass
    except KeyboardInterrupt:
        try:
            sys.stderr.write("\n")
            sys.stderr.flush()
        except Exception:
            pass
        sys.exit(130)
    except BrokenPipeError:
        # Python flushes standard streams on exit; redirect remaining output
        # to devnull to avoid another BrokenPipeError at shutdown
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(141)
    except Exception as e:
        if os.environ.get("SKILL_DEBUG") == "1":
            import traceback

            traceback.print_exc(file=sys.stderr)
        else:
            print(f"skill: error: {e}", file=sys.stderr)
        sys.exit(1)
