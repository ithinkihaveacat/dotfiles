#!/usr/bin/env bash
set -euo pipefail

cmd=$(basename "$0")

usage() {
  cat <<EOF
Usage: $cmd COMMAND [NAME...] [OPTIONS]

Install, update and check the coding agent CLIs on this machine.

Commands:
  list [NAME...]      Table of agents: installed or not, version, path
  install NAME...     Install agents with their vendors' installers
  update [NAME...]    Run each installed agent's own updater
  doctor [NAME...]    Check each installed agent: where it is, and (on Linux)
                      no process still running an executable that an update
                      replaced; non-zero on warnings or failures

Names:
  claude              Claude Code
  codex               OpenAI Codex CLI
  opencode            OpenCode
  agy                 Antigravity CLI
  browse              browse, the browser-control MCP server, for OpenCode

Options:
  --quiet             doctor: print only warnings and failures, with their
                      fixes; print nothing when every check passes
  -h, --help          Display this help message and exit

Examples:
  $cmd list
  $cmd install opencode
  $cmd update claude
  $cmd doctor
  $cmd doctor --quiet

Configuration (shared context, hooks, plugins) is install.sh's job, not this
command's: run install.sh --only agents after installing. install runs each
vendor's own installer (downloaded first, then run) with the switches it
offers to leave shell startup files alone and skip prompts; installers may
still edit shell startup files, so install says so after each one. Agents
mostly update themselves; update runs their updaters now. install and update
need the network: install refuses, and update skips, when AGENT_OFFLINE is
set. Nothing here restarts a running agent: doctor says which processes need
a restart and how.
EOF
  exit 0
}

die() {
  printf '%s: %s\n' "$cmd" "$*" >&2
  exit 1
}

die_sub() {
  printf '%s %s: %s\n' "$cmd" "$command" "$*" >&2
  exit 1
}

for arg in "$@"; do
  case $arg in
    -h | --help) usage ;;
  esac
done

if [ $# -eq 0 ]; then
  cat <<EOF >&2
Usage: $cmd COMMAND [NAME...] [OPTIONS]

Install, update, configure and check the coding agent CLIs on this machine.

Example:
  $cmd doctor

Try '$cmd --help' for more information.
EOF
  exit 1
fi

ALL_NAMES="claude codex opencode agy browse"

command=$1
shift
quiet=0
names=()
for arg in "$@"; do
  case $arg in
    --quiet) quiet=1 ;;
    claude | codex | opencode | agy | browse) names+=("$arg") ;;
    -*) die "unknown option '$arg' (try '$cmd --help')" ;;
    *) die "unknown name '$arg' (expected claude, codex, opencode, agy or browse)" ;;
  esac
done
explicit=${#names[@]}
if [ "$explicit" -eq 0 ]; then
  read -r -a names <<<"$ALL_NAMES"
fi
if [ "$quiet" -eq 1 ] && [ "$command" != doctor ]; then
  die "--quiet applies to doctor only"
fi

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

# The vendors' installers put agents in ~/.local/bin, which a non-login shell
# may not have on PATH. Append it, so callers' own PATH entries still win.
CALLER_PATH=$PATH
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$PATH:$HOME/.local/bin" ;;
esac

is_offline() {
  case $(printf '%s' "${AGENT_OFFLINE:-}" | tr '[:upper:]' '[:lower:]') in
    1 | true | yes | on) return 0 ;;
  esac
  return 1
}

# ---------------------------------------------------------------------------
# source roots: the dotfiles checkout holding this script, then its overlays

script=${BASH_SOURCE[0]}
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case $target in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
SRCDIR=$(cd -P "$(dirname "$script")/../../.." && pwd)
tilde() { # path -> path with $HOME shown as ~
  # shellcheck disable=SC2088 # a literal ~ for display
  case $1 in
    "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# ---------------------------------------------------------------------------
# what each agent is

agent_bin() { # name -> installed executable, or nothing
  local path
  case $1 in
    codex)
      # /usr/bin/codex is a file viewer, not the agent.
      path=$(type -P codex 2>/dev/null || true)
      case $path in /usr/bin/codex | /bin/codex) path= ;; esac
      ;;
    opencode)
      path=$(type -P opencode 2>/dev/null || true)
      if [ -z "$path" ] && [ -x "$HOME/.opencode/bin/opencode" ]; then
        path="$HOME/.opencode/bin/opencode"
      fi
      ;;
    browse)
      path=$(type -P browse 2>/dev/null || true)
      if [ -z "$path" ] && [ -x "${XDG_BIN_HOME:-$HOME/.local/bin}/browse" ]; then
        path="${XDG_BIN_HOME:-$HOME/.local/bin}/browse"
      fi
      ;;
    *) path=$(type -P "$1" 2>/dev/null || true) ;;
  esac
  printf '%s' "$path"
}

# The first word of the first line that looks like a version: agents print
# "2.1.330 (Claude Code)", "opencode v2.3.2", "codex-cli 0.171.0" or "1.5.14".
agent_version() { # name bin -> version string, or "-"
  local line word
  line=$("$2" --version 2>/dev/null | head -1 || true)
  for word in $line; do
    case $word in
      [0-9]* | v[0-9]*)
        printf '%s' "$word"
        return
        ;;
    esac
  done
  printf '%s' "-"
}

# ---------------------------------------------------------------------------
# install

# Each vendor's own installer, as its site gives it ('curl URL | bash'), plus
# the switches it supports for a smoother install: leave shell startup files
# alone, skip prompts, and install into ~/.local/bin. Where an installer offers
# no such switch, let it do what it does, and doctor reports the result.
installer() { # name -> "ENV<TAB>INTERPRETER<TAB>URL<TAB>ARGS" ("-" for none)
  case $1 in
    # No switches: 'claude install' takes only a version; it installs into
    # ~/.local/bin.
    claude) printf -- '-\tbash\thttps://claude.ai/install.sh\t-\n' ;;
    # No PATH switch: it adds a PATH block to .bashrc or .zshrc unless
    # ~/.local/bin is already on PATH.
    codex)
      printf 'CODEX_NON_INTERACTIVE=1 CODEX_INSTALL_DIR=%s\tsh\thttps://chatgpt.com/codex/install.sh\t-\n' \
        "$HOME/.local/bin"
      ;;
    # No location switch: it installs into ~/.opencode/bin.
    opencode) printf -- '-\tbash\thttps://opencode.ai/v2/install\t--no-modify-path\n' ;;
    # 'agy install' has --skip-path, but this script does not pass it on.
    agy) printf -- '-\tbash\thttps://antigravity.google/cli/install.sh\t-\n' ;;
    # -a opencode keeps it from adding its MCP server to every agent it finds;
    # --no-open and --no-wait keep it from opening a browser or waiting for
    # the extension. With no local browser to pair, open the relay to others.
    browse)
      printf -- '-\tbash\thttps://opencode.ai/browse/install\t%s--no-open --no-wait --no-modify-path -y -a opencode\n' \
        "$(browse_remote && printf -- '--remote ')"
      ;;
  esac
}

# True on a headless Linux machine with no local VNC desktop and no explicit
# loopback browse configuration, as install.sh's browse feature decides.
browse_remote() {
  [ "$(uname -s)" = Linux ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] &&
    [ ! -f "$XDG_CONFIG_HOME/tigervnc/passwd" ] &&
    ! { command -v jq >/dev/null 2>&1 &&
      [ "$(jq -r '.hostname // empty' "$XDG_CONFIG_HOME/browse/config.json" 2>/dev/null)" = "127.0.0.1" ]; }
}

sign_in() { # name -> how to finish setting the agent up
  case $1 in
    claude) printf 'run claude once to sign in' ;;
    codex) printf 'run codex login' ;;
    opencode) printf 'run opencode auth login, or opencode to pick a provider' ;;
    agy) printf 'run agy once to sign in' ;;
    browse) printf 'pair a browser with browse pair (browse extension says where to get it)' ;;
  esac
}

do_install() {
  local name bin vars interpreter url args script status ran failed=0
  if [ "$explicit" -eq 0 ]; then
    die_sub "NAME required (claude, codex, opencode, agy or browse); e.g. '$cmd install opencode'"
  fi
  if is_offline; then
    die_sub "needs the network, and AGENT_OFFLINE is set"
  fi
  command -v curl >/dev/null 2>&1 || {
    printf '%s: curl not found\n' "$cmd" >&2
    exit 127
  }
  for name in "${names[@]}"; do
    bin=$(agent_bin "$name")
    if [ -n "$bin" ]; then
      printf '%s install: %s is already installed at %s; %s update %s updates it\n' \
        "$cmd" "$name" "$(tilde "$bin")" "$cmd" "$name"
      continue
    fi
    if [ "$name" = browse ] && [ -z "$(agent_bin opencode)" ]; then
      printf '%s install: browse is set up for OpenCode, which is not installed; first: %s install opencode\n' \
        "$cmd" "$cmd" >&2
      failed=1
      continue
    fi
    IFS=$'\t' read -r vars interpreter url args <<<"$(installer "$name")"
    [ "$vars" != - ] || vars=
    [ "$args" != - ] || args=
    printf '%s install: %s from %s\n' "$cmd" "$name" "$url"
    script=$(mktemp)
    status=0
    ran=0
    # Download first: a dropped connection must not run half a script.
    if curl --connect-timeout 15 --max-time 300 -fsSL -o "$script" "$url"; then
      ran=1
      # shellcheck disable=SC2086 # vars and args are word lists
      env $vars "$interpreter" "$script" $args || status=$?
    else
      printf '%s install: failed to download %s\n' "$cmd" "$url" >&2
      status=1
    fi
    rm -f "$script"
    if [ "$ran" -eq 1 ]; then
      # Some installers edit shell startup files, switches or not; say so.
      printf '%s install: note: the %s installer may have changed shell startup files (such as ~/.bashrc, ~/.bash_profile, ~/.profile, ~/.zshrc or fish config); check them if that matters\n' \
        "$cmd" "$name" >&2
    fi
    if [ "$status" -ne 0 ]; then
      printf '%s install: %s installer failed (exit %d)\n' "$cmd" "$name" "$status" >&2
      failed=1
      continue
    fi
    if [ -z "$(agent_bin "$name")" ]; then
      # The installer may have put it somewhere only a new shell finds.
      printf '%s install: %s installed, but not found from this shell; open a new shell\n' \
        "$cmd" "$name"
      continue
    fi
    printf '%s install: installed %s; next, %s\n' "$cmd" "$name" "$(sign_in "$name")"
    if [ "$name" != browse ]; then
      printf '%s install: then link its context and hooks: %s\n' "$cmd" "$(tilde "$SRCDIR")/install.sh --only agents"
    fi
  done
  return "$failed"
}

# ---------------------------------------------------------------------------
# update

do_update() {
  local name bin status failed=0
  if is_offline; then
    printf '%s update: skipped (AGENT_OFFLINE is set)\n' "$cmd" >&2
    return 0
  fi
  for name in "${names[@]}"; do
    bin=$(agent_bin "$name")
    [ -n "$bin" ] || continue
    if [ "$name" = browse ]; then
      # 'browse update' reruns its full installer, which may reconfigure
      # agents; OpenCode's MCP entry has it update itself instead.
      printf '%s update: browse updates itself while OpenCode runs\n' "$cmd"
      continue
    fi
    printf '%s update: %s\n' "$cmd" "$name"
    status=0
    case $name in
      # opencode upgrade keeps the installed channel and reuses its installer.
      opencode) "$bin" upgrade || status=$? ;;
      *) "$bin" update || status=$? ;;
    esac
    if [ "$status" -ne 0 ]; then
      printf '%s update: %s update failed (exit %d)\n' "$cmd" "$name" "$status" >&2
      failed=1
    fi
  done
  return "$failed"
}

# ---------------------------------------------------------------------------
# doctor

passes=0
warnings=0
failures=0

tag() { # WORD TEXT
  local code
  case $1 in
    PASS) code=32 ;;
    INFO) code=36 ;;
    WARN) code=33 ;;
    FAIL) code=31 ;;
  esac
  if [ -z "${NO_COLOR+x}" ] && [ -t 1 ]; then
    printf '\033[%sm[%s]\033[0m  %s\n' "$code" "$1" "$2"
  else
    printf '[%s]  %s\n' "$1" "$2"
  fi
}
pass() {
  tag PASS "$1"
  passes=$((passes + 1))
}
info() { tag INFO "$1"; }
warn() {
  tag WARN "$1"
  warnings=$((warnings + 1))
}
fail() {
  tag FAIL "$1"
  failures=$((failures + 1))
}
hint() { printf '        %s\n' "$1"; }

# Linux keeps a running process's executable after an update replaces it on
# disk, so an agent that updated itself (or was updated by 'agent update')
# keeps running the old version until restarted. Only the installed path
# itself (replaced in place) or, for versioned installs such as Claude's
# versions/2.1.330, a sibling version file counts; other programs are ignored.
# Processes are grouped by the systemd unit that holds them, so a service with
# many sessions gives one line and one restart.
check_processes() { # name bin
  local name=$1 current proc exe target unit line stale total old pids hint_text
  [ -d /proc/self ] || return 0
  current=$(readlink -f "$2" 2>/dev/null) || return 0
  [ -x "$current" ] || return 0
  # One line per matching process: unit, stale (0/1), pid, executable name.
  for proc in "${AGENT_PROC:-/proc}"/[0-9]*; do
    [ -O "$proc" ] || continue
    exe=$(readlink "$proc/exe" 2>/dev/null) || continue
    target=${exe% (deleted)}
    if [ "$target" != "$current" ]; then
      [ "${target%/*}" = "${current%/*}" ] || continue
      [[ "${target##*/}" == [0-9]* && "${current##*/}" == [0-9]* ]] || continue
    fi
    unit=$(sed -n '$s|.*/||p' "$proc/cgroup" 2>/dev/null || true)
    if [ "$proc/exe" -ef "$current" ]; then
      printf '%s\t0\t%s\t%s\n' "${unit:-"-"}" "${proc##*/}" "${target##*/}"
    else
      printf '%s\t1\t%s\t%s\n' "${unit:-"-"}" "${proc##*/}" "${target##*/}"
    fi
  done >"$TMP/procs"
  [ -s "$TMP/procs" ] || return 0
  if ! grep -q $'\t1\t' "$TMP/procs"; then
    pass "$(wc -l <"$TMP/procs" | tr -d ' ') $name process(es) run the installed executable"
    return
  fi
  # Per unit with stale processes: unit, stale count, total, an old name, pids.
  awk -F'\t' '
    { total[$1]++ }
    $2 == 1 { stale[$1]++; old[$1] = $4; pids[$1] = pids[$1] (pids[$1] ? " " : "") $3 }
    END { for (u in stale) printf "%s\t%d\t%d\t%s\t%s\n", u, stale[u], total[u], old[u], pids[u] }
  ' "$TMP/procs" | sort >"$TMP/stale"
  while IFS=$'\t' read -r unit stale total old pids; do
    if [ "$old" = "${current##*/}" ]; then
      line="run an executable replaced on disk"
    else
      line="run $old; ${current##*/} is installed"
    fi
    case $unit in
      *.service)
        warn "$stale of $total $name process(es) in $unit $line"
        hint_text="restart $unit (systemctl --user restart $unit); this ends the sessions it runs"
        ;;
      *)
        warn "$stale of $total $name process(es) in ${unit/#-/no unit} $line"
        hint_text="exit and relaunch them (pid $pids)"
        ;;
    esac
    hint "$hint_text"
  done <"$TMP/stale"
}

doctor_agent() { # name
  local name=$1 bin
  bin=$(agent_bin "$name")
  if [ -z "$bin" ]; then
    info "$name: not installed"
    printf '\n'
    return
  fi
  printf '%s\n' "$name"
  pass "installed: $(tilde "$bin") ($(agent_version "$name" "$bin"))"
  case ":$CALLER_PATH:" in
    *":${bin%/*}:"*) ;;
    *)
      info "$(tilde "${bin%/*}") is not on this shell's PATH, so '$name' alone may not run here"
      hint "its installer may have added it to a shell startup file; a new shell picks that up"
      ;;
  esac
  check_processes "$name" "$bin"
  printf '\n'
}

do_doctor() {
  local name rc report
  if [ "$quiet" -eq 1 ]; then
    # Run the full report, then keep each WARN or FAIL line, the hints under
    # it, and the name of the agent it belongs to.
    rc=0
    report=$(NO_COLOR=1 "$0" doctor "${names[@]}") || rc=$?
    printf '%s\n' "$report" | awk '
      !NF { head = ""; keep = 0; next }
      /\[(WARN|FAIL)\]/ { if (head != "") print head; head = ""; print; keep = 1; next }
      /^        / { if (keep) print; next }
      /^[a-z]/ { head = $0; keep = 0; next }
      { keep = 0 }'
    return "$rc"
  fi
  TMP=$(mktemp -d)
  # shellcheck disable=SC2064 # expand the path now
  trap "rm -rf '$TMP'" EXIT
  for name in "${names[@]}"; do
    doctor_agent "$name"
  done
  printf '%d passed, %d warnings, %d failed\n' "$passes" "$warnings" "$failures"
  [ $((warnings + failures)) -eq 0 ]
}

# ---------------------------------------------------------------------------
# list

do_list() {
  local name bin
  printf '%-10s %-14s %-12s %s\n' AGENT STATE VERSION PATH
  for name in "${names[@]}"; do
    bin=$(agent_bin "$name")
    if [ -n "$bin" ]; then
      printf '%-10s %-14s %-12s %s\n' "$name" installed \
        "$(agent_version "$name" "$bin")" "$(tilde "$bin")"
    else
      printf '%-10s %-14s %-12s %s\n' "$name" "not installed" - -
    fi
  done
}

case $command in
  list) do_list ;;
  install) do_install ;;
  update) do_update ;;
  doctor) do_doctor ;;
  *) die "unknown command '$command' (try '$cmd --help')" ;;
esac
