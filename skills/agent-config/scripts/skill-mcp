PROG = "skill mcp"
VERSION = "1"
EXTENSION = "io.modelcontextprotocol/skills"
DEFAULT_CONFIG = "~/.private/config/skill/mcp.toml"
DEFAULT_PORT = 8790
# load_skill returns every text file of a skill up to this total size, and
# only SKILL.md plus an index beyond it.
WHOLE_SKILL_BYTES = 32 * 1024
SEARCH_MAX_MATCHES = 200
LIST_TTL_MS = 60_000
SCOPE_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
LOOPBACK = ("127.0.0.1", "localhost", "::1")
ACCESS_HEADER = "cf-access-jwt-assertion"
CERTS_TTL = 3600
LOG_ENV = "SKILL_MCP_LOG"
# Arguments a request's record keeps: those that name what a call is about,
# never text, content or edits. A search pattern is kept as a hash.
LOG_ARGS = ("name", "uri", "skill", "ignore_case", "replace_all")
LOG_HASHED = ("pattern",)


class SkillError(Exception):
    """A request that cannot be served, reported to the caller as is. REASON,
    when given, is what the request log records instead of the message."""

    def __init__(self, message: str, reason: str | None = None):
        super().__init__(message)
        self.reason = reason


def die(msg: str, code: int = 1) -> NoReturn:
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(code)


def default_log() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "skill" / "mcp.jsonl"


# --- Skills ------------------------------------------------------------------


def git_blob(data: bytes) -> str:
    """The SHA-1 git gives DATA as a blob, so edits can name what they replace."""
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def run_git(cwd: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(cwd), *args],
        capture_output=True,
        text=True,
        check=False,
    )


def parse_frontmatter(text: str) -> dict[str, Any]:
    """SKILL.md's YAML frontmatter as JSON-safe values, or {} if it has none."""
    import yaml

    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}
    end = next((i for i, line in enumerate(lines[1:], 1) if line.strip() == "---"), 0)
    if not end:
        return {}
    data = yaml.safe_load("\n".join(lines[1:end])) or {}
    if not isinstance(data, dict):
        return {}
    # YAML dates and the like have no JSON form; the listing carries text.
    return json.loads(json.dumps(data, default=str))


def is_text(data: bytes) -> bool:
    if b"\0" in data:
        return False
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        return False
    return True


def mime_type(rel: str) -> str:
    suffix = Path(rel).suffix.lower()
    return {
        ".md": "text/markdown",
        ".json": "application/json",
        ".jsonl": "application/jsonl",
        ".toml": "application/toml",
        ".yaml": "application/yaml",
        ".yml": "application/yaml",
        ".py": "text/x-python",
        ".sh": "text/x-shellscript",
        ".fish": "text/x-fish",
        ".png": "image/png",
        ".jpg": "image/jpeg",
        ".jpeg": "image/jpeg",
        ".svg": "image/svg+xml",
        ".pdf": "application/pdf",
    }.get(suffix, "text/plain")


@dataclass
class Skill:
    name: str
    root: Path
    description: str = ""
    # The git work tree holding the skill, or None if it is not in one.
    repo: Path | None = None

    def uri(self, rel: str = "SKILL.md") -> str:
        return f"skill://{self.name}/{rel}" if rel else f"skill://{self.name}"

    def files(self) -> list[str]:
        """The skill's files, relative and '/'-separated: in a git work tree,
        those git tracks (so caches and ignored data are never served);
        otherwise every file outside a dot-directory or __pycache__.
        Symbolic links are never served, since they can point anywhere."""
        if self.repo is not None:
            proc = run_git(self.root, "ls-files", "-z", "--", ".")
            if proc.returncode == 0:
                found = [p for p in proc.stdout.split("\0") if p]
                return sorted(p for p in found if self.servable(p))
        found = []
        for dirpath, dirnames, filenames in os.walk(self.root):
            dirnames[:] = sorted(
                d for d in dirnames if not d.startswith(".") and d != "__pycache__"
            )
            base = Path(dirpath).relative_to(self.root)
            for f in filenames:
                rel = (base / f).as_posix()
                if not f.startswith(".") and self.servable(rel):
                    found.append(rel)
        return sorted(found)

    def servable(self, rel: str) -> bool:
        """Whether REL is a regular file that stays inside the skill."""
        path = self.root / rel
        if path.is_symlink() or not path.is_file():
            return False
        real = path.resolve()
        return under(real, self.root) and not forbidden(real)

    def read(self, rel: str) -> bytes:
        if not self.servable(rel):
            raise SkillError(f"{self.uri(rel)} is not a file this skill serves")
        return (self.root / rel).read_bytes()

    def entry(self) -> dict[str, Any]:
        """The skill's SEP-2640 entry: URI, verbatim frontmatter, and every
        file with its digest and size."""
        resources = []
        for rel in self.files():
            data = self.read(rel)
            resources.append(
                {
                    "uri": self.uri(rel),
                    "digest": "sha256:" + hashlib.sha256(data).hexdigest(),
                    "size": len(data),
                }
            )
        frontmatter = parse_frontmatter(self.read("SKILL.md").decode("utf-8"))
        return {"uri": self.uri(), "frontmatter": frontmatter, "resources": resources}


def under(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
    except ValueError:
        return False
    return True


def forbidden(path: Path) -> bool:
    """Employer content is never served, wherever a link points from."""
    corp = Path("~/.corp").expanduser()
    return ".corp" in path.parts or under(path, corp.resolve())


def load_skill_dir(name: str, sources: list[Path]) -> Skill:
    for src in sources:
        candidate = src / name
        if not (candidate / "SKILL.md").is_file():
            continue
        root = candidate.resolve()
        if forbidden(root):
            raise SkillError(
                f"skill '{name}' resolves to {root}, which is never served"
            )
        skill = Skill(name, root)
        # Its description is published before any file is read, so SKILL.md
        # must pass the same test as every file the skill serves.
        if not skill.servable("SKILL.md"):
            raise SkillError(
                f"{root}/SKILL.md is a symbolic link or leaves the skill, "
                "so it is never served"
            )
        meta = parse_frontmatter(skill.read("SKILL.md").decode("utf-8"))
        if meta.get("name") != name:
            raise SkillError(
                f"{root}/SKILL.md names itself '{meta.get('name')}', not '{name}'"
            )
        top = run_git(root, "rev-parse", "--show-toplevel")
        skill.repo = Path(top.stdout.strip()) if top.returncode == 0 else None
        skill.description = str(meta.get("description") or "")
        return skill
    raise SkillError(f"skill '{name}' not found in {', '.join(map(str, sources))}")


@dataclass
class Config:
    path: Path
    sources: list[Path]
    scopes: dict[str, list[str]]


def load_config(path: Path) -> Config:
    try:
        with path.open("rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        raise SkillError(f"no configuration at {path}") from None
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise SkillError(f"cannot read {path}: {e}") from None
    sources = data.get("sources")
    scopes = data.get("scopes")
    if not isinstance(sources, list) or not all(isinstance(s, str) for s in sources):
        raise SkillError(f"{path}: 'sources' must be a list of directories")
    if not isinstance(scopes, dict) or not scopes:
        raise SkillError(f"{path}: '[scopes]' must map each scope to skill names")
    dirs = []
    for s in sources:
        d = Path(s).expanduser()
        if not d.is_absolute():
            d = path.parent / d
        if forbidden(d.resolve()):
            raise SkillError(f"{path}: source {s} is never served")
        dirs.append(d)
    for scope, names in scopes.items():
        if not SCOPE_RE.match(scope):
            raise SkillError(
                f"{path}: scope '{scope}' must be lowercase letters, digits and dashes"
            )
        if not isinstance(names, list) or not all(
            isinstance(n, str) and NAME_RE.match(n) for n in names
        ):
            raise SkillError(f"{path}: scope '{scope}' must list skill names")
    return Config(path, dirs, {k: list(v) for k, v in scopes.items()})


@dataclass
class Catalog:
    """The skills one scope serves, by name."""

    scope: str
    skills: dict[str, Skill] = field(default_factory=dict)
    push: bool = False

    @classmethod
    def build(cls, cfg: Config, scope: str, push: bool = False) -> Catalog:
        if scope not in cfg.scopes:
            raise SkillError(
                f"no scope '{scope}' in {cfg.path} (scopes: {', '.join(sorted(cfg.scopes))})"
            )
        cat = cls(scope, push=push)
        for name in cfg.scopes[scope]:
            cat.skills[name] = load_skill_dir(name, cfg.sources)
        return cat

    def skill(self, name: str) -> Skill:
        skill = self.skills.get(name)
        if skill is None:
            raise SkillError(
                f"no skill '{name}' here (skills: {', '.join(sorted(self.skills)) or 'none'})"
            )
        return skill

    def locate(self, ref: str) -> tuple[Skill, str]:
        """A file reference, as skill://NAME/PATH or NAME/PATH, as the skill
        and the file's relative path. Only files the skill serves resolve."""
        rest = ref.removeprefix("skill://").strip("/")
        name, _, rel = rest.partition("/")
        skill = self.skill(name)
        rel = rel or "SKILL.md"
        if rel not in skill.files():
            raise SkillError(f"no file {skill.uri(rel)}")
        return skill, rel

    def directory(self, ref: str) -> tuple[Skill, str]:
        rest = ref.removeprefix("skill://").strip("/")
        name, _, rel = rest.partition("/")
        skill = self.skill(name)
        if rel and not any(f.startswith(rel + "/") for f in skill.files()):
            raise SkillError(f"no directory {skill.uri(rel)}")
        return skill, rel


# --- Tool layer -----------------------------------------------------------------

DOB_WORDS = re.compile(r"\b(born|birth|dob|d\.o\.b)", re.IGNORECASE)
PASSPORT_WORDS = re.compile(r"\bpassport", re.IGNORECASE)
PASSPORT_NUMBER = re.compile(r"\b[A-Z]{0,2}\d{6,9}\b")
MONTH = r"(jan|feb|mar|apr|may|jun|jul|aug|sep|sept|oct|nov|dec)[a-z]*\.?"
FULL_DATE = re.compile(
    r"\b\d{4}-\d{1,2}-\d{1,2}\b"
    r"|\b\d{1,2}[/.-]\d{1,2}[/.-]\d{2,4}\b"
    rf"|\b\d{{1,2}}(st|nd|rd|th)?\s+(of\s+)?{MONTH}\s+\d{{4}}\b"
    rf"|\b{MONTH}\s+\d{{1,2}}(st|nd|rd|th)?,?\s+\d{{4}}\b",
    re.IGNORECASE,
)


def privacy_refusal(old: str, new: str) -> str | None:
    """Why NEW may not be written, if a line it adds looks like a passport
    number or expiry date, or a full date of birth."""
    before = set(old.splitlines())
    for line in new.splitlines():
        if line in before:
            continue
        if PASSPORT_WORDS.search(line) and (
            PASSPORT_NUMBER.search(line) or FULL_DATE.search(line)
        ):
            return "it looks like a passport number or expiry date"
        if DOB_WORDS.search(line) and FULL_DATE.search(line):
            return "it looks like a full date of birth (record the month and year only)"
    return None


def file_index(skill: Skill) -> str:
    lines = []
    for rel in skill.files():
        data = skill.read(rel)
        lines.append(f"- {skill.uri(rel)} ({len(data)} bytes, blob {git_blob(data)})")
    return "\n".join(lines)


def tool_load_skill(cat: Catalog, args: dict[str, Any]) -> str:
    skill = cat.skill(str(args.get("name", "")))
    files = skill.files()
    texts = {}
    for rel in files:
        data = skill.read(rel)
        if is_text(data):
            texts[rel] = data
    whole = sum(len(d) for d in texts.values()) <= WHOLE_SKILL_BYTES
    out = [
        f"# Skill {skill.name} ({skill.uri()})",
        "",
        (
            "Follow the instructions below. Relative paths in them resolve "
            f"against {skill.uri('')}/; read those files with read_file."
        ),
        "",
        f"## {skill.uri()}",
        "",
        skill.read("SKILL.md").decode("utf-8"),
        "",
        "## Files",
        "",
        file_index(skill),
    ]
    if whole:
        for rel in files:
            if rel == "SKILL.md" or rel not in texts:
                continue
            out += ["", f"## {skill.uri(rel)}", "", texts[rel].decode("utf-8")]
    return "\n".join(out)


def tool_read_file(cat: Catalog, args: dict[str, Any]) -> str:
    ref = str(args.get("uri", "")).strip()
    if "/" not in ref.removeprefix("skill://").strip("/"):
        # A bare skill name reads as loading the skill.
        return tool_load_skill(cat, {"name": ref.removeprefix("skill://").strip("/")})
    skill, rel = cat.locate(ref)
    data = skill.read(rel)
    if not is_text(data):
        raise SkillError(f"{skill.uri(rel)} is binary; read it as a resource")
    return f"{skill.uri(rel)} (blob {git_blob(data)})\n\n{data.decode('utf-8')}"


def tool_search(cat: Catalog, args: dict[str, Any]) -> str:
    pattern = str(args.get("pattern", ""))
    if not pattern:
        raise SkillError("pattern is required")
    flags = re.IGNORECASE if args.get("ignore_case", True) else 0
    try:
        regex = re.compile(pattern, flags)
    except re.error as e:
        # The message can quote the pattern, which the log must not keep.
        raise SkillError(f"invalid pattern: {e}", "invalid pattern") from None
    names = [args["skill"]] if args.get("skill") else sorted(cat.skills)
    matches = []
    for name in names:
        skill = cat.skill(name)
        for rel in skill.files():
            data = skill.read(rel)
            if not is_text(data):
                continue
            for n, line in enumerate(data.decode("utf-8").splitlines(), 1):
                if regex.search(line):
                    matches.append(f"{skill.uri(rel)}:{n}: {line}")
                    if len(matches) >= SEARCH_MAX_MATCHES:
                        return "\n".join(matches) + (
                            f"\n\nShowing the first {SEARCH_MAX_MATCHES} matches; "
                            "narrow the pattern or name a skill to see the rest."
                        )
    return "\n".join(matches) if matches else "no matches"


def tool_edit_file(cat: Catalog, args: dict[str, Any]) -> str:
    skill, rel = cat.locate(str(args.get("uri", "")))
    old = args.get("old_string")
    new = args.get("new_string")
    expected = str(args.get("expected_blob", ""))
    if not isinstance(old, str) or not old or not isinstance(new, str):
        raise SkillError("old_string (non-empty) and new_string are required")
    if old == new:
        raise SkillError("old_string and new_string are the same")
    if skill.repo is None:
        raise SkillError(
            f"{skill.uri()} is not in a git work tree, so it cannot be edited"
        )
    path = skill.root / rel
    data = path.read_bytes()
    blob = git_blob(data)
    if blob != expected:
        raise SkillError(
            f"{skill.uri(rel)} is now blob {blob}, not {expected or '(none given)'}; "
            "read it again and retry"
        )
    if run_git(skill.root, "diff", "--quiet", "HEAD", "--", rel).returncode != 0:
        raise SkillError(f"{skill.uri(rel)} has uncommitted changes on the server")
    text = data.decode("utf-8")
    count = text.count(old)
    if count == 0:
        raise SkillError(f"old_string not found in {skill.uri(rel)}")
    if count > 1 and not args.get("replace_all"):
        raise SkillError(
            f"old_string occurs {count} times in {skill.uri(rel)}; "
            "add context to make it unique, or pass replace_all"
        )
    reason = privacy_refusal(old, new)
    if reason:
        raise SkillError(
            f"refused: {reason}. These skills must not store passport numbers or "
            "expiry dates, or exact dates of birth."
        )
    updated = (
        text.replace(old, new) if args.get("replace_all") else text.replace(old, new, 1)
    )
    # Write beside the file and rename over it, keeping its mode: an
    # executable script must stay executable.
    mode = stat.S_IMODE(path.stat().st_mode)
    tmp = path.with_name(f".{path.name}.skill-mcp.{os.getpid()}")
    try:
        tmp.write_text(updated, encoding="utf-8")
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)
    subject = f"docs({skill.name}): update {rel}"
    if len(subject) > 50:
        subject = f"docs({skill.name}): update {Path(rel).name}"
    if len(subject) > 50:
        subject = f"docs({skill.name}): update a file"
    message = subject
    summary = str(args.get("summary") or "").strip()
    if summary:
        message += "\n\n" + textwrap.fill(summary, 72)
    commit = run_git(skill.root, "commit", "--quiet", "-m", message, "--", rel)
    if commit.returncode != 0:
        path.write_bytes(data)
        raise SkillError(
            f"git commit failed, so the edit was undone: {(commit.stderr or commit.stdout).strip()}"
        )
    sha = run_git(skill.root, "rev-parse", "--short", "HEAD").stdout.strip()
    event = EVENT.get()
    if event is not None:
        event.commit = sha
    note = ""
    if cat.push:
        push = run_git(skill.root, "push", "--quiet")
        note = (
            "; pushed"
            if push.returncode == 0
            else f"; push failed: {push.stderr.strip()}"
        )
        if event is not None:
            event.extra["push"] = "ok" if push.returncode == 0 else "failed"
    new_blob = git_blob(path.read_bytes())
    return f"Edited {skill.uri(rel)} in commit {sha}{note}; it is now blob {new_blob}."


TOOLS: dict[str, Any] = {
    "load_skill": tool_load_skill,
    "read_file": tool_read_file,
    "search": tool_search,
    "edit_file": tool_edit_file,
}


def skill_lines(cat: Catalog) -> str:
    return "\n".join(
        f"- {s.name} ({s.uri()}): {s.description}" for s in cat.skills.values()
    )


def instructions(cat: Catalog) -> str:
    return (
        "This server holds Agent Skills: the user's own instructions and "
        "reference material for agents. When a request touches one of the "
        "skills below, call load_skill with its name before answering, and "
        "follow what it says. Read further files with read_file. When you "
        "learn a lasting fact that belongs in a skill (a preference, a "
        "correction), record it there with edit_file rather than in notes "
        "elsewhere.\n\nSkills:\n" + skill_lines(cat)
    )


def tool_listing(cat: Catalog) -> list[dict[str, Any]]:
    uri_prop = {
        "type": "string",
        "description": "A file, as skill://SKILL/PATH (or SKILL/PATH).",
    }
    return [
        {
            "name": "load_skill",
            "description": (
                "Load a skill: its SKILL.md instructions and an index of its "
                "files (the whole skill when it is small). Call this first "
                "whenever a request touches one of these skills:\n" + skill_lines(cat)
            ),
            "inputSchema": {
                "type": "object",
                "properties": {
                    "name": {"type": "string", "enum": sorted(cat.skills)},
                },
                "required": ["name"],
                "additionalProperties": False,
            },
            "annotations": {"readOnlyHint": True, "openWorldHint": False},
        },
        {
            "name": "read_file",
            "description": (
                "Read one file of a skill, such as a reference that SKILL.md "
                "points to. The reply starts with the file's blob, which "
                "edit_file needs."
            ),
            "inputSchema": {
                "type": "object",
                "properties": {"uri": uri_prop},
                "required": ["uri"],
                "additionalProperties": False,
            },
            "annotations": {"readOnlyHint": True, "openWorldHint": False},
        },
        {
            "name": "search",
            "description": (
                "Search the skills' text files with a regular expression "
                "(case-insensitive by default). Returns skill:// URIs with "
                "line numbers."
            ),
            "inputSchema": {
                "type": "object",
                "properties": {
                    "pattern": {"type": "string"},
                    "skill": {"type": "string", "enum": sorted(cat.skills)},
                    "ignore_case": {"type": "boolean", "default": True},
                },
                "required": ["pattern"],
                "additionalProperties": False,
            },
            "annotations": {"readOnlyHint": True, "openWorldHint": False},
        },
        {
            "name": "edit_file",
            "description": (
                "Replace exact text in a skill file and commit the change. "
                "expected_blob is the blob read_file or load_skill reported; "
                "the edit is refused if the file has changed since. Never "
                "store passport numbers or expiry dates, or exact dates of "
                "birth."
            ),
            "inputSchema": {
                "type": "object",
                "properties": {
                    "uri": uri_prop,
                    "old_string": {"type": "string"},
                    "new_string": {"type": "string"},
                    "expected_blob": {"type": "string"},
                    "replace_all": {"type": "boolean", "default": False},
                    "summary": {
                        "type": "string",
                        "description": "Why the change was made, for the commit message.",
                    },
                },
                "required": ["uri", "old_string", "new_string", "expected_blob"],
                "additionalProperties": False,
            },
            "annotations": {
                "readOnlyHint": False,
                "destructiveHint": False,
                "idempotentHint": False,
                "openWorldHint": False,
            },
        },
    ]


# --- Request log ---------------------------------------------------------------
# skill-mcp and pinboard-mcp carry this block verbatim (a test compares them);
# skills/coding-standards/references/request-logs.md is the contract. Each
# defines PROG, VERSION, LOG_ARGS and LOG_HASHED outside it.

LOG_ROTATE_BYTES = 8 * 1024 * 1024
LOG_ROTATED = 4  # FILE.1 (newest) to FILE.4
LOG_RING = 500  # records an HTTP server keeps for its log page
LOGS_PATH = "/logs"
LOGS_DATA_PATH = "/logs/records"
MAX_REQUEST_BYTES = 1024 * 1024
CALLER_CLAIMS = ("sub", "email", "client_id", "azp")
LOG_QUOTED = re.compile(r"'(?:[^'\\]|\\.)*'|\"(?:[^\"\\]|\\.)*\"")
RPC_ERRORS = {
    -32700: "parse error",
    -32600: "invalid request",
    -32601: "method not found",
    -32602: "invalid params",
    -32603: "internal error",
}


def log_text(value: Any, limit: int = 80) -> str | None:
    if value is None:
        return None
    text = str(value)
    return text if len(text) <= limit else text[: limit - 1] + "…"


def log_value(value: Any) -> str:
    """VALUE for a stderr line: bare if a plain token, else quoted as JSON, so
    client text can neither break nor forge a line."""
    text = str(value)
    plain = re.fullmatch(r"[\w./:@+-]+", text, re.ASCII)
    return text if plain else json.dumps(text, ensure_ascii=False)


def log_reason(message: str) -> str:
    """An error's first line, with quoted values elided: they can quote content."""
    return LOG_QUOTED.sub("'…'", str(message).split("\n", 1)[0])


def caller_key(*parts: Any) -> str:
    joined = "\0".join("" if p is None else str(p) for p in parts)
    return hashlib.sha256(joined.encode()).hexdigest()[:10]


def log_args(args: dict[str, Any]) -> dict[str, str]:
    """The LOG_ARGS in ARGS, shortened, and the LOG_HASHED as hashes; no others."""
    out: dict[str, str] = {}
    for k, v in args.items():
        if k in LOG_ARGS and isinstance(v, (str, int, float, bool, list)):
            v = " ".join(str(x) for x in v) if isinstance(v, list) else v
            out[k] = log_text(" ".join(str(v).split()), 60) or ""
        elif k in LOG_HASHED and v not in (None, "", []):
            text = json.dumps(v, ensure_ascii=False, sort_keys=True)
            out[k] = "#" + hashlib.sha256(text.encode()).hexdigest()[:12]
    return out


@dataclass
class Event:
    """What one request, or one job the server started, came to: never its
    content. EXTRA holds the tool's own fields."""

    transport: str
    started: float = field(default_factory=time.monotonic)
    at: float = field(default_factory=time.time)
    event: str | None = None
    http: str | None = None
    method: Any = None
    tool: Any = None
    args: dict[str, str] | None = None
    outcome: str = "ok"
    status: int | None = None
    size: int | None = None
    reason: str | None = None
    agent: str | None = None
    caller: str | None = None
    commit: str | None = None
    extra: dict[str, Any] = field(default_factory=dict)

    def fail(self, outcome: str, reason: str) -> None:
        self.outcome, self.reason = outcome, reason

    def record(self) -> dict[str, Any]:
        stamp = datetime.datetime.fromtimestamp(self.at, datetime.UTC)
        rec = {
            "ts": stamp.isoformat(timespec="milliseconds").replace("+00:00", "Z"),
            "transport": self.transport,
            "event": self.event,
            "http": self.http,
            "method": log_text(self.method),
            "tool": log_text(self.tool),
            "args": self.args or None,
            "outcome": self.outcome,
            "status": self.status,
            "ms": int((time.monotonic() - self.started) * 1000),
            "bytes": self.size,
            "reason": log_text(self.reason, 200),
            "agent": log_text(self.agent),
            "caller": self.caller,
            "commit": self.commit,
            **self.extra,
            "version": VERSION,
        }
        return {k: v for k, v in rec.items() if v is not None}


# The request being served: set by the HTTP gate, or by the middleware.
EVENT: contextvars.ContextVar[Event | None] = contextvars.ContextVar(
    "EVENT", default=None
)


def log_files(path: Path) -> list[Path]:
    """PATH and its rotated files that exist, oldest first."""
    rotated = [Path(f"{path}.{i}") for i in range(LOG_ROTATED, 0, -1)]
    return [f for f in [*rotated, path] if f.is_file()]


def log_records(f: Path, since: float = 0) -> list[dict[str, Any]]:
    """The records in F from SINCE on, skipping lines that are not records
    (a write cut short leaves a partial line)."""
    records = []
    with open(f, encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            try:
                rec = json.loads(raw)
                at = datetime.datetime.fromisoformat(rec["ts"]).timestamp()
            except (ValueError, TypeError, KeyError):
                continue
            if at >= since:
                records.append(rec)
    return records


class RequestLog:
    """Each record goes to stderr, the log file and, for the log page, the
    latest KEEP in memory. Logging never fails a request: a record the file
    cannot take is dropped there, with one warning. Servers may share the
    file; each append and rotation holds an exclusive lock on it."""

    def __init__(self, path: Path | None, keep: int = 0):
        import collections
        import secrets

        self.path = path
        self.recent: collections.deque[dict[str, Any]] = collections.deque(maxlen=keep)
        self.seq = 0  # records emitted; the page's cursor
        self.instance = secrets.token_hex(4)  # this process's run of records
        self.warned = False
        self.lock = threading.Lock()

    def emit(self, event: Event) -> None:
        rec = event.record()
        line = " ".join(
            f"{k}={log_value(v)}"
            for k, v in rec.items()
            if k not in ("ts", "args", "version")
        )
        print(f"{PROG}: request {line}", file=sys.stderr, flush=True)
        with self.lock:
            self.seq += 1
            self.recent.append(rec)
            if self.path is None:
                return
            try:
                self.append(json.dumps(rec, ensure_ascii=False) + "\n")
            except OSError as e:
                if not self.warned:
                    self.warned = True
                    print(
                        f"{PROG}: cannot use the request log {self.path}: {e}",
                        file=sys.stderr,
                    )

    def append(self, line: str) -> None:
        import fcntl

        assert self.path is not None
        self.path.parent.mkdir(parents=True, exist_ok=True)
        # Another server may rotate the file between the open and the lock;
        # then the lock is on a rotated file, so open the new one.
        for _ in range(3):
            with open(self.path, "a", encoding="utf-8") as fh:
                fcntl.flock(fh, fcntl.LOCK_EX)
                st = os.fstat(fh.fileno())
                with contextlib.suppress(FileNotFoundError):
                    if os.stat(self.path).st_ino != st.st_ino:
                        continue
                if st.st_size and st.st_size + len(line) > LOG_ROTATE_BYTES:
                    for i in range(LOG_ROTATED - 1, 0, -1):
                        if Path(f"{self.path}.{i}").exists():
                            os.replace(f"{self.path}.{i}", f"{self.path}.{i + 1}")
                    os.replace(self.path, f"{self.path}.1")
                    with open(self.path, "a", encoding="utf-8") as fresh:
                        fresh.write(line)
                else:
                    fh.write(line)
                return
        raise OSError(f"{self.path} kept being rotated")

    def since(self, cursor: int) -> list[dict[str, Any]]:
        with self.lock:
            kept = list(self.recent)
            return kept[max(0, len(kept) - (self.seq - cursor)) :]


def percentile(values: list[int], pct: int) -> int | None:
    ordered = sorted(values)
    return ordered[max(0, -(-len(ordered) * pct // 100) - 1)] if ordered else None


def print_requests(path: Path, days: float, as_json: bool) -> int:
    """Prints requests and failures, with latency, per client and per tool."""
    if not days > 0:
        print(f"{PROG}: --days must be more than 0, not {days:g}", file=sys.stderr)
        return 1
    if not log_files(path):
        print(f"{PROG}: no request log at {path}", file=sys.stderr)
        return 1
    since = time.time() - days * 86400
    try:
        records = [rec for f in log_files(path) for rec in log_records(f, since)]
    except OSError as e:
        print(f"{PROG}: cannot read {path}: {e}", file=sys.stderr)
        return 1
    outcomes: dict[str, int] = {}
    for rec in records:
        outcomes[rec.get("outcome", "")] = outcomes.get(rec.get("outcome", ""), 0) + 1
    groups: dict[str, list[dict[str, Any]]] = {}
    for key in ("agent", "tool"):
        rows: dict[str, list[dict[str, Any]]] = {}
        for rec in records:
            name = rec.get(key) or (rec["transport"] if key == "agent" else None)
            if name:
                rows.setdefault(str(name), []).append(rec)
        groups[key] = [
            {
                key: name,
                "requests": len(recs),
                "failed": sum(r.get("outcome") != "ok" for r in recs),
                "p50_ms": percentile([r.get("ms", 0) for r in recs], 50),
                "p95_ms": percentile([r.get("ms", 0) for r in recs], 95),
            }
            for name, recs in sorted(rows.items(), key=lambda kv: -len(kv[1]))
        ]
    if as_json:
        stats = {"log": str(path), "days": days, "requests": len(records)}
        stats |= {"outcomes": outcomes, "agents": groups["agent"]}
        print(json.dumps(stats | {"tools": groups["tool"]}, indent=2))
        return 0
    print(f"Log: {path} (last {days:g} days)\nRequests: {len(records)}")
    print("Outcomes: " + (", ".join(f"{k} {v}" for k, v in outcomes.items()) or "-"))
    for key, title in (("agent", "Client"), ("tool", "Tool")):
        if groups[key]:
            width = max(len(title), *(len(log_text(r[key], 30)) for r in groups[key]))
            print(f"\n{title:<{width}}  Requests  Failed  p50 ms  p95 ms")
            for r in groups[key]:
                print(
                    f"{log_text(r[key], 30):<{width}}  {r['requests']:>8}  "
                    f"{r['failed']:>6}  {r['p50_ms']:>6}  {r['p95_ms']:>6}"
                )
    return 0


def source_commit() -> str | None:
    """The commit this script was checked out at, if it runs from Git."""
    import subprocess

    with contextlib.suppress(OSError, subprocess.TimeoutExpired):
        here = str(Path(__file__).resolve().parent)
        proc = subprocess.run(
            ["git", "-C", here, "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        return proc.stdout.strip()[:12] if proc.returncode == 0 else None
    return None


def request_logging(log: RequestLog) -> Any:
    """SDK middleware for every message: over HTTP it fills in the gate's
    event, which the gate logs; over stdio it makes and logs its own."""
    from mcp.shared.exceptions import MCPError

    stdio_caller = caller_key("stdio", os.getpid(), time.time())

    async def logged(ctx: Any, call_next: Any) -> Any:
        event = EVENT.get()
        own = event is None
        if own:
            event = Event("stdio", caller=stdio_caller)
        event.method = ctx.method
        token = EVENT.set(event)
        try:
            return await call_next(ctx)
        except MCPError as e:
            event.fail("rpc-error", RPC_ERRORS.get(e.code, f"error {e.code}"))
            raise
        except Exception:
            # The SDK reports malformed params as a pydantic ValidationError.
            event.fail("rpc-error", RPC_ERRORS[-32602])
            raise
        finally:
            EVENT.reset(token)
            if own:
                log.emit(event)

    return logged


# The log page: static, with every value inserted as text, polling
# LOGS_DATA_PATH (a buffering proxy holds a stream back). The script is pinned
# by its hash in the page's CSP.
LOGS_SCRIPT = """
const KEYS = ["method", "tool", "outcome", "status", "ms", "reason"];
const state = { server: "", next: 0 };
const rows = document.getElementById("rows");
const status = document.getElementById("status");

function row(rec) {
  const tr = document.createElement("tr");
  if (rec.outcome !== "ok") tr.className = "fail";
  const rest = { ...rec.args };
  for (const [k, v] of Object.entries(rec))
    if (![...KEYS, "ts", "args", "transport", "agent", "http", "version"].includes(k)) rest[k] = v;
  const cells = [new Date(rec.ts).toLocaleTimeString([], { hour12: false }),
    (rec.agent || rec.transport).slice(0, 24), rec.method || rec.event, rec.tool,
    Object.entries(rest).map(([k, v]) => `${k}=${v}`).join(" "),
    rec.outcome, rec.status, rec.ms, rec.reason];
  for (const c of cells) tr.insertCell().textContent = c == null ? "" : String(c);
  return tr;
}

async function poll() {
  let delay = 1000;
  try {
    const q = `?after=${state.next}&server=${encodeURIComponent(state.server)}`;
    const reply = await fetch("@DATA@" + q, { cache: "no-store" });
    if (!reply.ok) throw new Error(`HTTP ${reply.status}`);
    const data = await reply.json();
    if (data.server !== state.server) rows.replaceChildren();
    Object.assign(state, { server: data.server, next: data.next });
    for (const rec of data.records) rows.prepend(row(rec));
    while (rows.children.length > @RING@) rows.lastElementChild.remove();
    status.textContent = `live \\u00b7 server ${data.version}`;
  } catch (e) {
    status.textContent = `disconnected (${e.message}); reload to sign in again`;
    delay = 5000;
  }
  setTimeout(poll, delay);
}

poll();
""".replace("@DATA@", LOGS_DATA_PATH).replace("@RING@", str(LOG_RING))
LOGS_CSP = (
    "default-src 'none'; style-src 'unsafe-inline'; img-src data:; "
    "connect-src 'self'; script-src 'sha256-"
    + base64.b64encode(hashlib.sha256(LOGS_SCRIPT.encode()).digest()).decode()
    + "'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
)
LOGS_PAGE = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{PROG} requests</title><link rel="icon" href="data:,">
<style>
:root {{ color-scheme: light dark; --line: #8884; --fail: #d334; }}
body {{ margin: 0; padding: 16px; font: 14px/1.4 system-ui, sans-serif; }}
h1 {{ font-size: 18px; margin: 0 0 12px; }} #status {{ font-weight: normal; opacity: .7; }}
div {{ overflow-x: auto; }}
table {{ border-collapse: collapse; width: 100%; font: 12px/1.4 ui-monospace, monospace; }}
td {{ padding: 3px 8px 3px 0; border-bottom: 1px solid var(--line); vertical-align: top; }}
thead td {{ font-weight: 600; }} tr.fail td {{ background: var(--fail); }}
</style></head><body>
<h1>{PROG} requests <span id="status">connecting</span></h1>
<div><table><thead><tr><td>Time</td><td>Client</td><td>Method</td><td>Tool</td>
<td>Arguments</td><td>Outcome</td><td>Status</td><td>ms</td><td>Reason</td></tr></thead>
<tbody id="rows"></tbody></table></div>
<script>{LOGS_SCRIPT}</script></body></html>
"""


async def http_reply(
    send: Any, status: int, text: str, ctype: str = "text/plain", extra: Any = ()
) -> None:
    data = text.encode()
    headers = [(b"content-type", f"{ctype}; charset=utf-8".encode())]
    headers += [(b"content-length", str(len(data)).encode())]
    headers += [(k.encode(), v.encode()) for k, v in extra]
    await send({"type": "http.response.start", "status": status, "headers": headers})
    await send({"type": "http.response.body", "body": data})


class LoggingGate:
    """ASGI, in front of the SDK's app: the health check, the log page, the
    Access check, and one record for each request but the page's polls."""

    def __init__(self, app: Any, verifier: Any, log: RequestLog, hosts: list[str]):
        self.app, self.verifier, self.log = app, verifier, log
        names = [h.lower().rsplit(":", 1)[0] if "]" not in h else h for h in hosts]
        self.hosts = {"127.0.0.1", "localhost", "[::1]", *names}
        health = {"status": "ok", "version": VERSION, "commit": source_commit()}
        self.health = json.dumps(health)

    async def __call__(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        if scope["type"] != "http":  # lifespan
            await self.app(scope, receive, send)
            return
        headers = {
            k.decode("latin-1").lower(): v.decode("latin-1")
            for k, v in scope["headers"]
        }
        path, method = scope["path"], scope["method"]
        if path == "/up" and method in ("GET", "HEAD"):
            # Polled by the proxy, so open to all, and not logged.
            await http_reply(send, 200, self.health, "application/json")
            return
        event = Event("http", http=method, agent=headers.get("user-agent"))
        token = EVENT.set(event)
        refusal = self.refusal(headers, event)
        page = path in (LOGS_PATH, LOGS_DATA_PATH)
        if refusal is None and method != ("GET" if page else "POST"):
            # No server-initiated stream (GET), and no sessions to delete.
            refusal = 405, "method not allowed", ()
        if refusal is None and page:
            await self.logs(scope, send)
            EVENT.reset(token)
            return

        async def sending(message: dict[str, Any]) -> None:
            if message["type"] == "http.response.start":
                event.status = message["status"]
                if event.status >= 400 and event.outcome == "ok":
                    # The SDK answers a message it cannot parse with a
                    # JSON-RPC error and 400; other statuses are refusals.
                    bad = event.status == 400
                    event.fail(
                        "rpc-error" if bad else "refused", f"HTTP {event.status}"
                    )
            await send(message)

        try:
            if refusal:
                event.fail("refused", refusal[1])
                await http_reply(sending, refusal[0], refusal[1], extra=refusal[2])
            else:
                await self.app(scope, receive, sending)
        except BaseException as e:
            event.fail("error", type(e).__name__)
            raise
        finally:
            EVENT.reset(token)
            self.log.emit(event)

    def refusal(self, headers: dict[str, str], event: Event) -> tuple | None:
        """(status, reason, headers) if the request may not proceed. A token
        gives the request its caller key, from its claims."""
        if self.verifier is None:
            # The SDK checks the Host header of MCP requests; check the log
            # page's here, against DNS rebinding.
            host = headers.get("host", "").lower()
            name = host if host.endswith("]") else host.rsplit(":", 1)[0]
            return None if name in self.hosts else (421, "host not allowed", ())
        token = headers.get("cf-access-jwt-assertion")
        if not token:
            bearer = (("www-authenticate", "Bearer"),)
            return 401, "Cloudflare Access token required", bearer
        try:
            claims = self.verifier.verify(token)
        except AccessError as e:
            return 403, str(e), ()
        event.caller = caller_key(*(claims.get(k) for k in CALLER_CLAIMS))
        return None

    async def logs(self, scope: dict[str, Any], send: Any) -> None:
        """The page, or the records after the page's cursor; not logged."""
        from urllib.parse import parse_qs

        private = (("cache-control", "no-store"), ("x-content-type-options", "nosniff"))
        if scope["path"] == LOGS_PATH:
            csp = (("content-security-policy", LOGS_CSP),)
            await http_reply(send, 200, LOGS_PAGE, "text/html", (*private, *csp))
            return
        query = parse_qs(scope.get("query_string", b"").decode("latin-1"))
        after = query.get("after", ["0"])[0]
        same = query.get("server", [""])[0] == self.log.instance
        cursor = int(after) if after.isdigit() and same else 0
        payload = {"server": self.log.instance, "version": VERSION}
        payload |= {"next": self.log.seq, "records": self.log.since(cursor)}
        await http_reply(send, 200, json.dumps(payload), "application/json", private)


# --- End of request log --------------------------------------------------------


# --- MCP server ---------------------------------------------------------------


# Held by each request while it runs, and by a stdio server stopping.
REQUEST_LOCK = threading.Lock()


def current_event(cat: Catalog, **args: Any) -> Event:
    """The request being served, with the scope it was made to and ARGS."""
    event = EVENT.get() or Event("none")
    event.extra["scope"] = cat.scope
    if args:
        event.args = log_args(args)
    return event


def sdk_server(cat: Catalog, log: RequestLog) -> Any:
    import anyio
    import mcp_types as types
    from mcp.server.lowlevel import Server
    from mcp.shared.exceptions import MCPError

    def invalid(e: Exception) -> MCPError:
        return MCPError(code=types.INVALID_PARAMS, message=str(e))

    def locked(fn: Any, *args: Any) -> Any:
        with REQUEST_LOCK:
            return fn(*args)

    async def run(fn: Any, *args: Any) -> Any:
        # Keep file and git work off the event loop, one request at a time.
        return await anyio.to_thread.run_sync(locked, fn, *args)

    async def list_tools(ctx: Any, params: Any) -> Any:
        return types.ListToolsResult(
            tools=[types.Tool.model_validate(t) for t in tool_listing(cat)]
        )

    async def call_tool(ctx: Any, params: Any) -> Any:
        event = current_event(cat, **(params.arguments or {}))
        event.tool = params.name
        fn = TOOLS.get(params.name)
        if fn is None:
            raise MCPError(
                code=types.INVALID_PARAMS, message=f"unknown tool: {params.name}"
            )
        try:
            text = await run(fn, cat, params.arguments or {})
        except (SkillError, OSError, UnicodeDecodeError) as e:
            event.fail("tool-error", getattr(e, "reason", None) or log_reason(str(e)))
            return types.CallToolResult(
                content=[types.TextContent(type="text", text=str(e))], is_error=True
            )
        event.size = len(text.encode())
        return types.CallToolResult(content=[types.TextContent(type="text", text=text)])

    def resource(skill: Skill, rel: str) -> types.Resource:
        data = skill.read(rel)
        if rel == "SKILL.md":
            return types.Resource(
                uri=skill.uri(rel),
                name=skill.name,
                description=skill.description,
                mime_type="text/markdown",
                size=len(data),
            )
        return types.Resource(
            uri=skill.uri(rel), name=rel, mime_type=mime_type(rel), size=len(data)
        )

    def all_resources() -> list[types.Resource]:
        return [
            resource(skill, rel)
            for skill in cat.skills.values()
            for rel in skill.files()
        ]

    async def list_resources(ctx: Any, params: Any) -> Any:
        current_event(cat)
        return types.ListResourcesResult(resources=await run(all_resources))

    def read(uri: str) -> types.ReadResourceResult:
        import base64

        skill, rel = cat.locate(uri)
        data = skill.read(rel)
        if is_text(data):
            contents = types.TextResourceContents(
                uri=uri, mime_type=mime_type(rel), text=data.decode("utf-8")
            )
        else:
            contents = types.BlobResourceContents(
                uri=uri, mime_type=mime_type(rel), blob=base64.b64encode(data).decode()
            )
        return types.ReadResourceResult(contents=[contents])

    async def read_resource(ctx: Any, params: Any) -> Any:
        current_event(cat, uri=str(params.uri))
        try:
            return await run(read, str(params.uri))
        except SkillError as e:
            raise invalid(e) from None

    class SkillsGetParams(types.RequestParams):
        uri: str

    class DirectoryReadParams(types.PaginatedRequestParams):
        uri: str

    def list_entries() -> dict[str, Any]:
        return {
            "skills": [s.entry() for s in cat.skills.values()],
            "ttlMs": LIST_TTL_MS,
            "cacheScope": "private",
        }

    def get_entry(uri: str) -> dict[str, Any]:
        rest = uri.removeprefix("skill://")
        name, _, rel = rest.partition("/")
        if (
            not uri.startswith("skill://")
            or rel != "SKILL.md"
            or name not in cat.skills
        ):
            raise SkillError(f"not a skill this server serves: {uri}")
        return {"skill": cat.skills[name].entry()}

    def directory(uri: str) -> dict[str, Any]:
        skill, rel = cat.directory(uri)
        prefix = rel + "/" if rel else ""
        children: dict[str, dict[str, Any]] = {}
        for f in skill.files():
            if not f.startswith(prefix):
                continue
            head, sep, _ = f[len(prefix) :].partition("/")
            if sep:
                children.setdefault(
                    head,
                    {
                        "uri": skill.uri(prefix + head),
                        "name": head,
                        "mimeType": "inode/directory",
                    },
                )
            else:
                children[head] = resource(skill, f).model_dump(
                    by_alias=True, mode="json", exclude_none=True
                )
        return {"resources": [children[k] for k in sorted(children)]}

    async def skills_list(ctx: Any, params: Any) -> Any:
        current_event(cat)
        # A skill changed on disk since startup (SKILL.md now a link, say)
        # fails the listing with its reason rather than an opaque error.
        try:
            return await run(list_entries)
        except (SkillError, OSError, UnicodeDecodeError) as e:
            raise MCPError(code=types.INTERNAL_ERROR, message=str(e)) from None

    async def skills_get(ctx: Any, params: Any) -> Any:
        current_event(cat, uri=params.uri)
        try:
            return await run(get_entry, params.uri)
        except SkillError as e:
            raise invalid(e) from None

    async def directory_read(ctx: Any, params: Any) -> Any:
        current_event(cat, uri=params.uri)
        try:
            return await run(directory, params.uri)
        except SkillError as e:
            raise invalid(e) from None

    class SkillServer(Server):
        """Also advertises the extension under 'experimental': before
        2026-07-28 the capabilities have no 'extensions' field, and the SDK
        drops it from the handshake."""

        def get_capabilities(
            self,
            notification_options: Any = None,
            experimental_capabilities: Any = None,
            extensions: Any = None,
            *,
            protocol_version: str | None = None,
        ) -> Any:
            return super().get_capabilities(
                notification_options,
                experimental_capabilities or dict(self.extensions),
                extensions,
                protocol_version=protocol_version,
            )

    sdk = SkillServer(
        "skill",
        version=VERSION,
        title=f"Skills ({cat.scope})",
        instructions=instructions(cat),
        on_list_tools=list_tools,
        on_call_tool=call_tool,
        on_list_resources=list_resources,
        on_read_resource=read_resource,
    )
    sdk.add_request_handler("skills/list", types.PaginatedRequestParams, skills_list)
    sdk.add_request_handler("skills/get", SkillsGetParams, skills_get)
    sdk.add_request_handler(
        "resources/directory/read", DirectoryReadParams, directory_read
    )
    sdk.extensions = {EXTENSION: {"directoryRead": True}}
    sdk.middleware.append(request_logging(log))
    return sdk


def serve_stdio(cat: Catalog, log: RequestLog) -> None:
    import anyio
    from mcp.server.stdio import stdio_server

    def stop(signum: int, frame: Any) -> None:
        """The SDK reads stdin in a thread that nothing can interrupt, so a
        clean shutdown would wait for the client to close stdin; instead,
        exit 0 once no request is running, so that no edit or commit is cut
        off."""
        REQUEST_LOCK.acquire()  # Held until exit: no request starts after this.
        os._exit(0)

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, stop)

    async def serve() -> None:
        sdk = sdk_server(cat, log)
        async with stdio_server() as (read, write):
            await sdk.run(read, write, sdk.create_initialization_options())

    anyio.run(serve)


# --- HTTP --------------------------------------------------------------------


class AccessError(Exception):
    """A request without a usable Cloudflare Access token."""


class AccessVerifier:
    """Checks Cloudflare Access JWTs (Cf-Access-Jwt-Assertion): RS256
    signature against the team's certificates, issuer, audience, and expiry."""

    def __init__(self, team: str, audience: str, certs_url: str | None = None):
        import jwt  # Only the HTTP server with Access needs it.

        self.jwt = jwt
        self.team, self.audience = team, audience
        self.jwks = jwt.PyJWKClient(
            certs_url or f"https://{team}/cdn-cgi/access/certs",
            cache_keys=True,
            lifespan=CERTS_TTL,
            # Cloudflare refuses urllib's default user agent.
            headers={"User-Agent": f"skill-mcp/{VERSION}"},
            timeout=10,
        )

    def verify(self, token: str) -> dict[str, Any]:
        jwt = self.jwt
        try:
            key = self.jwks.get_signing_key_from_jwt(token)
            return jwt.decode(
                token,
                key.key,
                algorithms=["RS256"],
                audience=self.audience,
                issuer=f"https://{self.team}",
                leeway=60,
                options={"require": ["exp", "iss", "aud"]},
            )
        except jwt.ExpiredSignatureError:
            raise AccessError("Access token expired") from None
        except jwt.InvalidAudienceError:
            raise AccessError("Access token for another application") from None
        except jwt.InvalidIssuerError:
            raise AccessError("Access token from another team") from None
        except jwt.PyJWKClientError as e:
            raise AccessError(f"Access token key not usable: {e}") from None
        except jwt.PyJWTError as e:
            raise AccessError(f"Access token refused: {e}") from None


def serve_http(
    cats: list[Catalog],
    host: str,
    port: int,
    allow_hosts: list[str],
    verifier: AccessVerifier | None,
    log: RequestLog,
) -> None:
    import uvicorn
    from mcp.server.transport_security import TransportSecuritySettings
    from starlette.applications import Starlette

    hosts = ["127.0.0.1:*", "localhost:*", "[::1]:*"]
    hosts += [h if ":" in h else f"{h}:*" for h in allow_hosts] + allow_hosts
    security = TransportSecuritySettings(
        enable_dns_rebinding_protection=True,
        allowed_hosts=hosts,
        allowed_origins=["http://127.0.0.1:*", "http://localhost:*", "http://[::1]:*"],
    )
    servers = [sdk_server(cat, log) for cat in cats]
    routes = []
    for cat, sdk in zip(cats, servers, strict=True):
        app = sdk.streamable_http_app(
            streamable_http_path=f"/mcp/{cat.scope}",
            stateless_http=True,
            json_response=True,
            max_request_body_size=MAX_REQUEST_BYTES,
            transport_security=security,
        )
        routes += app.routes

    @contextlib.asynccontextmanager
    async def lifespan(app: Any) -> Any:
        async with contextlib.AsyncExitStack() as stack:
            for sdk in servers:
                await stack.enter_async_context(sdk.session_manager.run())
            yield

    auth = f"Access {verifier.team}" if verifier else "no authentication"
    print(
        f"{PROG}: serving {', '.join(f'/mcp/{c.scope}' for c in cats)} "
        f"on http://{host}:{port} ({auth}); request log {log.path}, page {LOGS_PATH}",
        file=sys.stderr,
    )
    app = Starlette(routes=routes, lifespan=lifespan)
    uvicorn.run(
        LoggingGate(app, verifier, log, allow_hosts),
        host=host,
        port=port,
        log_level="warning",
        access_log=False,
        server_header=False,
    )


# --- Command line -------------------------------------------------------------

EPILOG = f"""\
Configuration:
  A TOML file names the directories skills are found in and the skills each
  scope serves. Nothing under ~/.corp is ever served.

    sources = ["~/.private/skills", "~/.dotfiles/skills"]

    [scopes]
    profile = ["personal-profile"]
    all = ["personal-profile", "personal-network", "travel"]

Environment:
  SKILL_MCP_CONFIG           Configuration file (default: {DEFAULT_CONFIG})
  SKILL_MCP_ACCESS_TEAM      Cloudflare Access team domain
  SKILL_MCP_ACCESS_AUD       Cloudflare Access application audience tag
  SKILL_MCP_ACCESS_CERTS_URL Team certificate URL, for testing (default:
                             https://TEAM/cdn-cgi/access/certs)
  SKILL_MCP_LOG              Request log (default:
                             $XDG_STATE_HOME/skill/mcp.jsonl, else
                             ~/.local/state/skill/mcp.jsonl)

Examples:
  skill mcp --list
  skill mcp profile
  skill mcp --http --allow-host skills.example.com
  skill mcp --http --allow-host skills.example.com \\
    --access-team example.cloudflareaccess.com --access-aud AUD
  claude mcp add skills -- skill mcp all
  skill mcp --requests --days 1

Each scope is one MCP server: over stdio, the SCOPE argument; over HTTP, every
scope at /mcp/SCOPE. Its tools (load_skill, read_file, search, edit_file) work
with any client; it also implements the MCP Skills Extension (SEP-2640:
skills/list, skills/get, resources/directory/read, and a skill:// resource for
every file). A skill in a git work tree serves the files git tracks; symbolic
links are never served. edit_file commits each edit in that work tree.

Every request is appended to the request log as a JSON record (rotated at 8
MiB, four old files kept) and printed to stderr: its method, tool, the
arguments that name what it is about (a skill, a URI; a search pattern only as
a hash), outcome, duration, the commit an edit made, and the scope. Never file
contents or edits. --requests summarises the log; over HTTP, GET /logs shows
the latest records, behind the same authentication as /mcp.

The HTTP server serves GET /up without a token for a proxy's health check,
answering with its version and source commit.
Without --access-team and --access-aud it listens on loopback only and does no
authentication of its own. With both, it may bind another --host and requires
the Cf-Access-Jwt-Assertion header on every other request, checking the token
against the team's certificates, issuer, audience, and expiry. --allow-host
admits the proxy's hostname; requests from browser pages are still accepted
only from loopback origins, so clients must connect from a server, as hosted
connectors do."""


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Serve agent skills over MCP, as tools and as SEP-2640 skills.",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "scope",
        nargs="?",
        metavar="SCOPE",
        help="scope to serve over stdio (default: all)",
    )
    parser.add_argument(
        "--http",
        action="store_true",
        help="serve every scope over streamable HTTP at /mcp/SCOPE",
    )
    parser.add_argument(
        "--host", default="127.0.0.1", help="HTTP address (default: 127.0.0.1)"
    )
    parser.add_argument(
        "--port",
        type=int,
        default=DEFAULT_PORT,
        help=f"HTTP port (default: {DEFAULT_PORT})",
    )
    parser.add_argument(
        "--allow-host",
        action="append",
        default=[],
        metavar="HOST",
        help="also accept requests addressed to HOST, such as a tunnel's hostname",
    )
    parser.add_argument(
        "--access-team",
        metavar="HOST",
        help="Cloudflare Access team domain (default: SKILL_MCP_ACCESS_TEAM)",
    )
    parser.add_argument(
        "--access-aud",
        metavar="AUD",
        help="Cloudflare Access application audience tag "
        "(default: SKILL_MCP_ACCESS_AUD)",
    )
    parser.add_argument("--config", metavar="FILE", help="configuration file")
    parser.add_argument(
        "--push", action="store_true", help="push after each edit's commit"
    )
    parser.add_argument(
        "--list", action="store_true", help="print each scope's skills and exit"
    )
    parser.add_argument(
        "--log", metavar="FILE", help=f"request log (default: ${LOG_ENV})"
    )
    parser.add_argument(
        "--requests",
        action="store_true",
        help="summarise the request log and exit",
    )
    parser.add_argument(
        "--days",
        type=float,
        default=7,
        metavar="N",
        help="with --requests, the days to summarise (default: 7)",
    )
    parser.add_argument(
        "--json", action="store_true", help="with --requests, print JSON"
    )
    return parser


def main() -> int:
    args = build_parser().parse_args()
    log_path = Path(args.log or os.environ.get(LOG_ENV) or default_log()).expanduser()
    if args.requests:
        return print_requests(log_path, args.days, args.json)
    if args.json or args.days != 7:
        die("--days and --json apply only to --requests")
    cfg_path = Path(
        args.config or os.environ.get("SKILL_MCP_CONFIG") or DEFAULT_CONFIG
    ).expanduser()
    try:
        cfg = load_config(cfg_path)
        if args.list:
            for scope in sorted(cfg.scopes):
                cat = Catalog.build(cfg, scope)
                for skill in cat.skills.values():
                    print(f"{scope}\t{skill.name}\t{skill.root}")
            return 0
        if args.http and args.scope is not None:
            die("--http serves every scope; drop the SCOPE argument")
        team = args.access_team or os.environ.get("SKILL_MCP_ACCESS_TEAM")
        audience = args.access_aud or os.environ.get("SKILL_MCP_ACCESS_AUD")
        if bool(team) != bool(audience):
            die(
                "Access needs both --access-team and --access-aud "
                "(or SKILL_MCP_ACCESS_TEAM and SKILL_MCP_ACCESS_AUD)"
            )
        if args.http:
            verifier = None
            if team:
                verifier = AccessVerifier(
                    team,
                    audience,
                    os.environ.get("SKILL_MCP_ACCESS_CERTS_URL") or None,
                )
            elif args.host not in LOOPBACK:
                die(f"--http without Access serves loopback only, not {args.host}")
            cats = [Catalog.build(cfg, s, args.push) for s in sorted(cfg.scopes)]
            log = RequestLog(log_path, LOG_RING)
            serve_http(cats, args.host, args.port, args.allow_host, verifier, log)
        else:
            if team:
                die("--access-team and --access-aud apply only to --http")
            serve_stdio(
                Catalog.build(cfg, args.scope or "all", args.push), RequestLog(log_path)
            )
    except SkillError as e:
        die(str(e))
    return 0


def sigterm_handler(signum: int, frame: Any) -> NoReturn:
    raise KeyboardInterrupt


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, sigterm_handler)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # A server stops on a signal as asked, so it exits 0, not 130.
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        sys.exit(0)
