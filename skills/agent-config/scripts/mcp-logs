#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
# Tests: skills/agent-config/tests/test-mcp-logs
"""The 'mcp logs' reader, run by 'mcp logs'. The record format it reads is
skills/agent-config/references/mcp-logs.md."""

import argparse
import datetime
import json
import os
import re
import signal
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, NoReturn

PROG = "mcp logs"
LOG_NAME = "mcp.jsonl"
LOG_ROTATED = 4  # FILE.1 (newest) to FILE.4, as the servers rotate them
DEFAULT_TAIL = 10
# Tool calls by one caller this many seconds apart or less form one chain.
DEFAULT_GAP = 120.0
SUMMARY_TOP = 10  # commonest call sequences a summary lists
CLIENT_MAX = 20  # longest client name a summary's columns show
FOLLOW_POLL = 0.5  # seconds between looks at the files with --follow
SINCE_RE = re.compile(r"^(\d+(?:\.\d+)?)([smhdw])$")
SINCE_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 7 * 86400}
# Shown in their own columns, or not at all, in a plain line.
LINE_OWN = ("ts", "method", "event", "tool", "outcome", "ms", "args", "version")


def die(msg: str, code: int = 1) -> NoReturn:
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(code)


def state_dir() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or "~/.local/state"
    return Path(state).expanduser()


@dataclass
class Log:
    """One server's log: FILE and its rotated files. The server is named by
    the directory the file is in."""

    server: str
    path: Path

    def files(self) -> list[Path]:
        """The file and its rotated files that exist, oldest first."""
        rotated = [Path(f"{self.path}.{i}") for i in range(LOG_ROTATED, 0, -1)]
        return [f for f in [*rotated, self.path] if f.is_file()]


def logs_in(directory: Path) -> list[Log]:
    """The logs under DIRECTORY: its own mcp.jsonl, else each subdirectory's
    (a state directory, or a volume holding several servers' directories)."""
    own = directory / LOG_NAME
    if own.exists() or Path(f"{own}.1").exists():
        return [Log(directory.resolve().name, own)]
    found = []
    for sub in sorted(p for p in directory.iterdir() if p.is_dir()):
        log = sub / LOG_NAME
        if log.exists() or Path(f"{log}.1").exists():
            found.append(Log(sub.name, log))
    return found


def find_logs(paths: list[str], servers: list[str]) -> list[Log]:
    """The logs PATHS name (files or directories), by default every one in
    the state directory, kept to SERVERS if any are given."""
    logs: list[Log] = []
    for arg in paths or [str(state_dir())]:
        path = Path(arg).expanduser()
        if path.is_dir():
            found = logs_in(path)
            if paths and not found:
                die(f"no {LOG_NAME} in {path} or its subdirectories")
            logs += found
        elif path.is_file() or Path(f"{path}.1").is_file():
            logs.append(Log(path.resolve().parent.name, path))
        else:
            die(f"{path}: no such file or directory")
    if servers:
        unknown = sorted(set(servers) - {log.server for log in logs})
        if unknown:
            known = ", ".join(sorted({log.server for log in logs})) or "none"
            die(f"no request log for server {', '.join(unknown)} (found: {known})")
        logs = [log for log in logs if log.server in servers]
    if not logs:
        die(f"no request logs in {state_dir()}; name a file or directory")
    return logs


def parse_record(raw: str, server: str) -> dict[str, Any] | None:
    """The record on line RAW, with its server first and its time as 'at';
    None for a line that is not a record (a write cut short leaves a partial
    line)."""
    try:
        rec = json.loads(raw)
        at = datetime.datetime.fromisoformat(rec["ts"]).timestamp()
    except (ValueError, TypeError, KeyError, AttributeError):
        return None
    if not isinstance(rec, dict):
        return None
    return {"server": server, **rec, "at": at}


def read_records(
    logs: list[Log], since: float, cursors: dict[Path, "Cursor"]
) -> list[dict[str, Any]]:
    """Every record in LOGS from SINCE on, oldest first, noting in CURSORS
    where each current file was read to. Records with the same time keep
    their order within a file."""
    records = []
    for log in logs:
        for f in log.files():
            try:
                with open(f, "rb") as fh:
                    st = os.fstat(fh.fileno())
                    data = fh.read()
            except OSError as e:
                die(f"cannot read {f}: {e.strerror or e}")
            whole = data[: data.rfind(b"\n") + 1]
            if f == log.path:
                cursors[f] = Cursor(st.st_ino, len(whole))
            for raw in whole.decode("utf-8", errors="replace").splitlines():
                rec = parse_record(raw, log.server)
                if rec is not None and rec["at"] >= since:
                    records.append(rec)
    records.sort(key=lambda r: r["at"])
    return records


def parse_since(text: str, now: float) -> float:
    """The time SINCE names: an age such as 90s, 30m, 1h, 2d or 1w, or an ISO
    8601 date or time (local time unless it gives a zone)."""
    m = SINCE_RE.match(text)
    if m:
        return now - float(m[1]) * SINCE_UNITS[m[2]]
    try:
        when = datetime.datetime.fromisoformat(text)
    except ValueError:
        die(f"--since: expected an age (30m, 1h, 2d) or a time, not '{text}'")
    if when.tzinfo is None:
        when = when.astimezone()
    return when.timestamp()


def parse_tail(text: str) -> int | None:
    """None for all, else the count."""
    if text == "all":
        return None
    if not text.isdigit():
        die(f"--tail: expected a number or 'all', not '{text}'")
    return int(text)


def line_value(value: Any) -> str:
    """VALUE bare if a plain token, else quoted as JSON, so that client text
    can neither break nor forge a line."""
    text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
    plain = re.fullmatch(r"[\w./:@+#-]+", text, re.ASCII)
    return text if plain else json.dumps(text, ensure_ascii=False)


def line(rec: dict[str, Any], width: int) -> str:
    """REC as one line: time, server, method or job, tool, outcome and
    duration, then its arguments and other fields as KEY=VALUE."""
    rest = dict(rec.get("args") or {})
    rest |= {
        k: v
        for k, v in rec.items()
        if k not in (*LINE_OWN, "server", "at") and k not in rest
    }
    ms = rec.get("ms")
    cols = [
        rec.get("ts", ""),
        f"{rec['server']:<{width}}",
        line_value(rec.get("method") or rec.get("event") or "-"),
        line_value(rec.get("tool") or "-"),
        line_value(rec.get("outcome", "-")),
        f"{ms}ms" if isinstance(ms, int) else "-",
        *(f"{k}={line_value(v)}" for k, v in rest.items()),
    ]
    return " ".join(cols)


def output(rec: dict[str, Any], as_json: bool, width: int) -> str:
    if as_json:
        return json.dumps({k: v for k, v in rec.items() if k != "at"})
    return line(rec, width)


def percentile(values: list[int], pct: int) -> int | None:
    """The nearest-rank PCT percentile of VALUES."""
    if not values:
        return None
    ordered = sorted(values)
    return ordered[max(0, -(-len(ordered) * pct // 100) - 1)]


def client(rec: dict[str, Any]) -> str:
    """The client a record came from: its User-Agent, else its transport."""
    return str(rec.get("agent") or rec.get("transport") or "-")


def group(records: list[dict[str, Any]], *keys: str) -> list[dict[str, Any]]:
    """Requests, failures, latency and result size per value of KEYS, most
    requests first. A record without a value for the last key is left out."""
    rows: dict[tuple[str, ...], list[dict[str, Any]]] = {}
    for rec in records:
        name = tuple(client(rec) if k == "agent" else rec.get(k) for k in keys)
        if name[-1] is not None:
            rows.setdefault(tuple(str(n) for n in name), []).append(rec)
    out = []
    for name, recs in rows.items():
        ms = [r["ms"] for r in recs if isinstance(r.get("ms"), int)]
        sizes = [r["bytes"] for r in recs if isinstance(r.get("bytes"), int)]
        out.append(
            dict(zip(keys, name, strict=True))
            | {
                "requests": len(recs),
                "failed": sum(r.get("outcome") != "ok" for r in recs),
                "p50_ms": percentile(ms, 50),
                "p95_ms": percentile(ms, 95),
                "p50_bytes": percentile(sizes, 50),
            }
        )
    return sorted(out, key=lambda row: (-row["requests"], *(row[k] for k in keys)))


def sequences(
    records: list[dict[str, Any]], gap: float, top: int
) -> tuple[int, list[dict[str, Any]]]:
    """The number of chains in RECORDS, and the commonest runs of two or three
    tool calls within them, by server and client. A chain is one caller's tool
    calls to one server, each GAP seconds or less after the one before."""
    chains: list[tuple[str, str, list[str]]] = []
    open_chains: dict[tuple[Any, ...], tuple[float, list[str]]] = {}
    for rec in records:
        # Without a caller key (HTTP with no authentication), calls from
        # different clients cannot be told apart, so they form no chain.
        if (
            rec.get("method") != "tools/call"
            or rec.get("tool") is None
            or rec.get("caller") is None
        ):
            continue
        key = (rec["server"], rec.get("transport"), rec["caller"], rec.get("agent"))
        last = open_chains.get(key)
        if last is None or rec["at"] - last[0] > gap:
            calls: list[str] = []
            chains.append((rec["server"], client(rec), calls))
        else:
            calls = last[1]
        calls.append(str(rec["tool"]))
        open_chains[key] = (rec["at"], calls)
    runs: dict[tuple[str, str, tuple[str, ...]], int] = {}
    for server, agent, calls in chains:
        for size in (2, 3):
            for i in range(len(calls) - size + 1):
                run = (server, agent, tuple(calls[i : i + size]))
                runs[run] = runs.get(run, 0) + 1
    common = [
        {"server": server, "agent": agent, "calls": list(calls), "count": count}
        for (server, agent, calls), count in sorted(
            runs.items(), key=lambda kv: (-kv[1], -len(kv[0][2]), kv[0])
        )
        if count > 1
    ]
    return len(chains), common[:top]


def summary(records: list[dict[str, Any]], gap: float) -> dict[str, Any]:
    """Descriptive statistics over RECORDS, oldest first."""
    outcomes: dict[str, int] = {}
    for rec in records:
        outcome = str(rec.get("outcome"))
        outcomes[outcome] = outcomes.get(outcome, 0) + 1
    chains, common = sequences(records, gap, SUMMARY_TOP)
    return {
        "requests": len(records),
        "first": records[0]["ts"] if records else None,
        "last": records[-1]["ts"] if records else None,
        "outcomes": dict(sorted(outcomes.items(), key=lambda kv: (-kv[1], kv[0]))),
        "servers": group(records, "server"),
        "agents": group(records, "agent"),
        "tools": group(records, "server", "tool"),
        "gap": gap,
        "chains": chains,
        "sequences": common,
    }


def clip(text: str, limit: int = CLIENT_MAX) -> str:
    """TEXT cut for its column; --json has all of it."""
    return text if len(text) <= limit else text[: limit - 1] + "…"


def print_table(rows: list[dict[str, Any]], keys: list[tuple[str, str]]) -> None:
    """ROWS from group() as a table, with KEYS (field, title) first."""
    if not rows:
        return
    cells = [[clip(str(r[k])) for k, _ in keys] for r in rows]
    widths = [
        max(len(title), *(len(c[i]) for c in cells))
        for i, (_, title) in enumerate(keys)
    ]
    head = "  ".join(f"{t:<{w}}" for (_, t), w in zip(keys, widths, strict=True))
    print(f"\n{head}  Requests  Failed  p50 ms  p95 ms  p50 bytes")
    for row, cell in zip(rows, cells, strict=True):
        names = "  ".join(f"{c:<{w}}" for c, w in zip(cell, widths, strict=True))
        nums = [row["p50_ms"], row["p95_ms"], row["p50_bytes"]]
        nums = ["-" if n is None else str(n) for n in nums]
        print(
            f"{names}  {row['requests']:>8}  {row['failed']:>6}  "
            f"{nums[0]:>6}  {nums[1]:>6}  {nums[2]:>9}"
        )


def print_summary(stats: dict[str, Any]) -> None:
    if not stats["requests"]:
        print("Requests: none")
        return
    print(f"Requests: {stats['requests']}, {stats['first']} to {stats['last']}")
    print("Outcomes: " + ", ".join(f"{k} {v}" for k, v in stats["outcomes"].items()))
    print_table(stats["servers"], [("server", "Server")])
    print_table(stats["agents"], [("agent", "Client")])
    print_table(stats["tools"], [("server", "Server"), ("tool", "Tool")])
    print(f"\nChains: {stats['chains']} (tool calls {stats['gap']:g} s apart or less)")
    common = stats["sequences"]
    if common:
        sw = max(len("Server"), *(len(q["server"]) for q in common))
        cw = max(len("Client"), *(len(clip(q["agent"])) for q in common))
        print(f"\nCount  {'Server':<{sw}}  {'Client':<{cw}}  Sequence")
        for q in common:
            print(
                f"{q['count']:>5}  {q['server']:<{sw}}  {clip(q['agent']):<{cw}}  "
                + " > ".join(q["calls"])
            )


@dataclass
class Cursor:
    """Where --follow has read a log file to: its inode and offset, so that
    a rotation (a new inode) or truncation (a shorter file) is noticed."""

    inode: int
    offset: int
    partial: str = ""


def follow(
    logs: list[Log],
    cursors: dict[Path, Cursor],
    paths: list[str],
    servers: list[str],
    as_json: bool,
    width: int,
) -> NoReturn:
    """Prints records as they are appended to LOGS after CURSORS. A rotated
    file is read to its end before the new one is read from its start; a
    server whose log appears later is picked up when no PATHS were named."""
    while True:
        time.sleep(FOLLOW_POLL)
        if not paths:
            for log in logs_in(state_dir()):
                if log.path not in {lg.path for lg in logs} and (
                    not servers or log.server in servers
                ):
                    logs.append(log)
                    width = max(width, len(log.server))
        batch: list[dict[str, Any]] = []
        for log in logs:
            batch += read_new(log, cursors)
        batch.sort(key=lambda r: r["at"])
        for rec in batch:
            print(output(rec, as_json, width), flush=True)


def read_from(f: Path, cursor: Cursor) -> str:
    """The text of F after CURSOR, up to its last complete line; the rest is
    kept for the next read."""
    with open(f, "rb") as fh:
        fh.seek(cursor.offset)
        data = fh.read()
    cursor.offset += len(data)
    text = cursor.partial + data.decode("utf-8", errors="replace")
    text, _, cursor.partial = text.rpartition("\n")
    return text + "\n" if text else ""


def read_new(log: Log, cursors: dict[Path, Cursor]) -> list[dict[str, Any]]:
    """The records appended to LOG since its cursor."""
    text = ""
    try:
        st = os.stat(log.path)
    except FileNotFoundError:
        return []  # between a rotation's two renames
    cursor = cursors.get(log.path)
    try:
        if cursor is not None and st.st_ino != cursor.inode:
            # Rotated: finish the old file, wherever it went.
            for f in log.files():
                if f != log.path and os.stat(f).st_ino == cursor.inode:
                    text += read_from(f, cursor)
                    break
            cursor = None
        if cursor is None:
            cursor = cursors[log.path] = Cursor(st.st_ino, 0)
        elif st.st_size < cursor.offset:
            cursor.offset, cursor.partial = 0, ""  # truncated
        text += read_from(log.path, cursor)
    except OSError as e:
        print(f"{PROG}: cannot read {log.path}: {e.strerror or e}", file=sys.stderr)
        return []
    records = (parse_record(raw, log.server) for raw in text.splitlines())
    return [rec for rec in records if rec is not None]


USAGE = f"{PROG} [OPTIONS] [PATH...]"
DESCRIPTION = """\
Print the request records of this repository's MCP servers, merged from any
number of logs, oldest first."""
EPILOG = f"""\
Examples:
  # The last ten requests to any server on this machine
  mcp logs

  # Every pinboard request of the last day, as JSON, failures only
  mcp logs --server pinboard --since 1d --json | jq 'select(.outcome != "ok")'

  # Watch requests arrive, from servers whose logs share a volume
  mcp logs -f /srv/mcp-logs

  # A week's statistics, and taskgo's commonest call sequences
  mcp logs --summary --since 7d
  mcp logs --summary --json --server taskgo | jq '.sequences[:3]'

  # Requests per tool since a date
  mcp logs -n all --since 2026-11-01 --json | jq -r .tool | sort | uniq -c

Each server writes its own log (taskgo mcp, skill mcp, pinboard mcp, andon
mcp): $XDG_STATE_HOME/<server>/{LOG_NAME} by default, rotated to {LOG_NAME}.1
to .{LOG_ROTATED}. With no PATH, every such log in $XDG_STATE_HOME (else
~/.local/state) is read. A PATH may be a log file, a directory holding
{LOG_NAME}, or a directory of server directories. A server is named by its
log's directory.

A line gives the record's time (UTC), server, method (or a background job's
name), tool, outcome and duration, then its arguments and other fields as
KEY=VALUE. --json prints each record as the server wrote it, with "server"
added. Records never hold content; see agent-config's references/mcp-logs.md
for the format.

--summary describes the records instead of printing them: requests and
outcomes; requests, failures, p50 and p95 latency and median result size per
server, per client (User-Agent, else transport) and per tool; and the
commonest runs of two or three tool calls in one caller's chains, by server
and client. A chain is one caller's tool calls to one server, each no more
than --gap seconds after the one before; records with no caller key (HTTP
without authentication) form no chains. It reads every record unless --tail
or --since limits them."""


class Parser(argparse.ArgumentParser):
    """The house help layout, and usage errors exit 1."""

    def error(self, message: str) -> NoReturn:
        print(f"{PROG}: {message}", file=sys.stderr)
        print(f"Try '{PROG} --help' for more information.", file=sys.stderr)
        sys.exit(1)

    def format_help(self) -> str:
        return (
            super()
            .format_help()
            .replace("usage:", "Usage:", 1)
            .replace(
                "show this help message and exit",
                "Display this help message and exit",
                1,
            )
        )


def build_parser() -> argparse.ArgumentParser:
    parser = Parser(
        prog=PROG,
        usage=USAGE,
        description=DESCRIPTION,
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser._positionals.title = "Arguments"
    parser._optionals.title = "Options"
    parser.add_argument(
        "paths",
        nargs="*",
        metavar="PATH",
        help="A log file, or a directory of logs (default: $XDG_STATE_HOME)",
    )
    parser.add_argument(
        "-n",
        "--tail",
        metavar="N",
        help=f"Print the last N records, or 'all' (default: {DEFAULT_TAIL}; "
        "all with --since or --summary)",
    )
    parser.add_argument(
        "--since",
        metavar="WHEN",
        help="Only records from WHEN on: an age (30m, 1h, 2d, 1w) or a date or "
        "time (2026-11-01, 2026-11-01T09:00)",
    )
    parser.add_argument(
        "--server",
        action="append",
        default=[],
        metavar="NAME",
        help="Only this server's records (taskgo, skill, ...); repeatable",
    )
    parser.add_argument(
        "-f",
        "--follow",
        action="store_true",
        help="Keep printing records as they are written, across rotations",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Print each record as a JSON line, or the summary as JSON",
    )
    parser.add_argument(
        "--summary",
        action="store_true",
        help="Print statistics over the records instead of the records",
    )
    parser.add_argument(
        "--gap",
        type=float,
        metavar="SECS",
        help=f"With --summary, the longest pause within a chain "
        f"(default: {DEFAULT_GAP:g})",
    )
    return parser


def main() -> int:
    args = build_parser().parse_args()
    now = time.time()
    since = parse_since(args.since, now) if args.since else 0.0
    tail = parse_tail(args.tail) if args.tail else None
    if args.tail is None and not args.since and not args.summary:
        tail = DEFAULT_TAIL
    if args.summary and args.follow:
        die("--summary and --follow cannot be combined")
    if args.gap is not None and not args.summary:
        die("--gap applies only to --summary")
    gap = DEFAULT_GAP if args.gap is None else args.gap
    if not gap >= 0:
        die(f"--gap must be 0 or more seconds, not {gap:g}")
    logs = find_logs(args.paths, args.server)
    cursors: dict[Path, Cursor] = {}
    records = read_records(logs, since, cursors)
    if tail is not None:
        records = records[len(records) - tail :] if tail else []
    if args.summary:
        stats = summary(records, gap)
        if args.json:
            print(json.dumps(stats, indent=2))
        else:
            print_summary(stats)
        return 0
    width = max(len(log.server) for log in logs)
    for rec in records:
        print(output(rec, args.json, width))
    if args.follow:
        sys.stdout.flush()
        follow(logs, cursors, args.paths, args.server, args.json, width)
    return 0


def sigterm_handler(signum: int, frame: Any) -> NoReturn:
    raise KeyboardInterrupt


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, sigterm_handler)
    try:
        sys.exit(main())
    except BrokenPipeError:
        # A reader such as head stopped early: not an error.
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(0)
    except KeyboardInterrupt:
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        try:
            sys.stderr.write("\n")
            sys.stderr.flush()
        except OSError:
            pass
        sys.exit(130)
