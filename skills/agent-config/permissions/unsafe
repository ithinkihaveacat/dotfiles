# Commands that 'permission apply' must not pre-approve.
# An agent must never be able to edit its own allowlist unprompted.
permission cmd add
permission cmd remove
permission cmd rm
permission path add
permission path remove
permission path rm
permission clean
# andon clear-resolved deletes every closed alert from the shared store.
andon clear-resolved
# mcp add and remove change which servers, and so which tools, an agent has.
mcp add
mcp remove
mcp rm
# skill mcp serves skills to other agents and commits their edits.
skill mcp
# The server is an implementation detail of 'skill mcp', run only by it.
skill-mcp
