{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/codex-hook\"",
            "timeout": 10,
            "statusMessage": "Andon: load reporting instructions"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/codex-hook\"",
            "timeout": 10,
            "statusMessage": "Andon: refresh reporting instructions"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/codex-hook\"",
            "timeout": 10,
            "statusMessage": "Andon: check tool failures and attribute reports"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/hooks/codex-hook\"",
            "timeout": 10,
            "statusMessage": "Andon: load reporting instructions for subagent"
          }
        ]
      }
    ]
  },
  "description": "Automatic Andon reporting for defects in agent instructions, skills and tools."
}
