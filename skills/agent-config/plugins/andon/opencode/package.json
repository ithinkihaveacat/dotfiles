{
  "name": "opencode-andon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx"
  },
  "scripts": {
    "test": "node --test --test-reporter=tap tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '*.ts' '*.tsx' 'src/**/*.{ts,tsx}' 'tests/*.ts'",
    "format:check": "prettier --check '*.ts' '*.tsx' 'src/**/*.{ts,tsx}' 'tests/*.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "solid-js": "1.9.17",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.32"
  },
  "peerDependencies": {
    "@opencode/theme": "2.0.32",
    "@opentui/core": "^0.5.17",
    "@opentui/solid": "^0.5.17",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "node": ">=26.4"
  },
  "overrides": {
    "solid-js": "$solid-js"
  }
}
