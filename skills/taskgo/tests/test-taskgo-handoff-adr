#!/usr/bin/env bash
set -euo pipefail

# Color styling is asserted explicitly per test; isolate from inherited
# NO_COLOR/FORCE_COLOR.
unset NO_COLOR FORCE_COLOR

# Isolate test suite from ambient agent runtime variables.
unset AI_AGENT INVOKER_INFO_NAME
unset JETSKI_CONVERSATION_ID ANTIGRAVITY_CONVERSATION_ID ANTIGRAVITY_SESSION
unset CLAUDE_CODE_SESSION_ID CLAUDE_CODE_REMOTE_SESSION_ID CLAUDE_SESSION_ID CLAUDE_PROJECT_ID
unset OPENCODE_SESSION_ID CODEX_SESSION_ID
unset INVOKER_INFO_ROOT_SESSION_ID CONVERSATION_ID

export GIT_AUTHOR_NAME="Taskgo Test"
export GIT_AUTHOR_EMAIL="taskgo@example.com"
export GIT_COMMITTER_NAME="Taskgo Test"
export GIT_COMMITTER_EMAIL="taskgo@example.com"

TEST_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$TEST_DIR/../scripts/taskgo"
# shellcheck disable=SC2034
MARKDOWN_FORMAT="$TEST_DIR/../../coding-standards/scripts/markdown-format"
TEST_ROOT="$(mktemp -d)"
trap 'rm -rf -- "$TEST_ROOT"' EXIT
export TASKGO_MCP_LOG="$TEST_ROOT/mcp-requests.jsonl"

echo "1..25"

init_base_repo() {
  local target="${1:-$TEST_ROOT/repo}"
  mkdir -p "$target/example/tasks"
  git -C "$target" init -q
  printf '%s
' '# Agent instructions' '' 'This repository follows taskgo:' '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' >"$target/AGENTS.md"
  printf '# Inbox
' >"$target/INBOX.md"
  printf '# Example project
' >"$target/example/PROJECT.md"
  printf '# Plan
' >"$target/example/PLAN.md"
  printf '%s
' '---' 'id: TASK-A1B2C' 'status: todo' '---' '' '# Confirm generated status formatting' >"$target/example/tasks/TASK-A1B2C-confirm-status.md"
}

REPO="$TEST_ROOT/repo"
init_base_repo "$REPO"

MCP_PY=$(uv sync -q --script "$BIN" </dev/null && uv python find --script "$BIN")
# shellcheck disable=SC2034
APPLY_PY="$MCP_PY"

# Test 105: Claude Code env vars map to canonical claude scheme without annotations
AGENT_REPO="$TEST_ROOT/agent-repo"
mkdir -p "$AGENT_REPO/proj/tasks"
git -C "$AGENT_REPO" init -q
printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  '' \
  '<!-- taskgo:allow-local-commits -->' \
  >"$AGENT_REPO/AGENTS.md"
printf '# Inbox\n' >"$AGENT_REPO/INBOX.md"
printf '# Proj\n' >"$AGENT_REPO/proj/README.md"
cat <<'EOF' >"$AGENT_REPO/proj/tasks/TASK-A6E01-agent-task.md"
---
id: TASK-A6E01
status: todo
---

# Agent Task
EOF
("$BIN" --root "$AGENT_REPO" sync proj)
git -C "$AGENT_REPO" add .
git -C "$AGENT_REPO" commit -q -m "initial agent task"
printf '\nNew content\n' >>"$AGENT_REPO/proj/tasks/TASK-A6E01-agent-task.md"
(AI_AGENT="claude-code_2-1-267_agent" CLAUDE_CODE_SESSION_ID="11112222-3333-4444-5555-666677778888" "$BIN" --root "$AGENT_REPO" checkpoint TASK-A6E01 "chore(proj): diagnose runner timeouts" --all)
AGENT_FM="$(cat "$AGENT_REPO/proj/tasks/TASK-A6E01-agent-task.md")"
AGENT_LOG="$(git -C "$AGENT_REPO" log -1 --pretty=%B)"
if echo "$AGENT_FM" | grep -q 'claude://11112222-3333-4444-5555-666677778888' &&
  ! echo "$AGENT_FM" | grep -q '(' &&
  ! echo "$AGENT_FM" | grep -q 'claude-code' &&
  echo "$AGENT_LOG" | grep -q "Conversation: claude://11112222-3333-4444-5555-666677778888"; then
  echo 'ok 1 - Claude Code env vars map to canonical claude scheme without annotations'
else
  echo 'not ok 1 - Claude Code env vars map to canonical claude scheme without annotations'
fi

# Test 106: aborted checkpoint does not mutate task file frontmatter
BEFORE_FM="$(cat "$AGENT_REPO/proj/tasks/TASK-A6E01-agent-task.md")"
printf '\nUnlisted file\n' >"$AGENT_REPO/proj/unlisted.txt"
set +e
(AI_AGENT="jetski" JETSKI_CONVERSATION_ID="77778888-9999-0000-1111-222233334444" "$BIN" --root "$AGENT_REPO" checkpoint TASK-A6E01 "chore(proj): will abort" 2>/dev/null)
CP_EXIT=$?
set -e
AFTER_FM="$(cat "$AGENT_REPO/proj/tasks/TASK-A6E01-agent-task.md")"
rm -f "$AGENT_REPO/proj/unlisted.txt"
if [ "$CP_EXIT" -ne 0 ] && [ "$BEFORE_FM" = "$AFTER_FM" ]; then
  echo 'ok 2 - aborted checkpoint does not mutate task file frontmatter'
else
  echo 'not ok 2 - aborted checkpoint does not mutate task file frontmatter'
fi

# Test 107: legacy conversation upgrades to agent scheme, web URLs accepted, non-blocking INFO on malformed
TOL_REPO="$TEST_ROOT/tol-repo"
mkdir -p "$TOL_REPO/proj/tasks"
git -C "$TOL_REPO" init -q
printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  '' \
  '<!-- taskgo:allow-local-commits -->' \
  >"$TOL_REPO/AGENTS.md"
printf '# Inbox\n' >"$TOL_REPO/INBOX.md"
printf '# Proj\n' >"$TOL_REPO/proj/README.md"
cat <<'EOF' >"$TOL_REPO/proj/tasks/TASK-A1B2C-tol-task.md"
---
id: TASK-A1B2C
status: todo
conversations:
  - conversation://afb6245a-b957-464c-934e-9d09ee099e97
  - https://claude.ai/code/session_1234567890abcdef
  - invalid-short
---

# Tol Task
EOF
("$BIN" --root "$TOL_REPO" sync proj)
set +e
TOL_DR_OUT="$("$BIN" --root "$TOL_REPO" doctor proj 2>&1)"
TOL_EXIT=$?
set -e

# Update TASK-A1B2C with active claude session matching the legacy session ID
(AI_AGENT=claude "$BIN" --root "$TOL_REPO" update TASK-A1B2C --status in-progress --conv "afb6245a-b957-464c-934e-9d09ee099e97" >/dev/null)
UPGRADED_FM="$(cat "$TOL_REPO/proj/tasks/TASK-A1B2C-tol-task.md")"

if [ "$TOL_EXIT" -eq 0 ] &&
  echo "$TOL_DR_OUT" | grep -q '\[INFO\]  proj/tasks/TASK-A1B2C-tol-task.md: unparseable conversation entry' &&
  ! echo "$TOL_DR_OUT" | grep -q 'claude.ai' &&
  echo "$UPGRADED_FM" | grep -q 'claude://afb6245a-b957-464c-934e-9d09ee099e97' &&
  ! echo "$UPGRADED_FM" | grep -q 'conversation://afb6245a-b957-464c-934e-9d09ee099e97'; then
  echo 'ok 3 - legacy conversation upgrades to agent scheme, web URLs accepted, non-blocking INFO on malformed'
else
  echo 'not ok 3 - legacy conversation upgrades to agent scheme, web URLs accepted, non-blocking INFO on malformed'
fi

# Test 108: remainder validation rejects short/malformed URIs, and render_task_file quotes YAML cleanly
VAL_REPO="$TEST_ROOT/val-repo"
mkdir -p "$VAL_REPO/proj/tasks"
git -C "$VAL_REPO" init -q
printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  '' \
  '<!-- taskgo:allow-local-commits -->' \
  >"$VAL_REPO/AGENTS.md"
printf '# Inbox\n' >"$VAL_REPO/INBOX.md"
printf '# Proj\n' >"$VAL_REPO/proj/README.md"

set +e
SHORT_URI_OUT="$("$BIN" --root "$VAL_REPO" create proj "Short URI" --conv "x://b" 2>&1)"
SHORT_URI_EXIT=$?
MALFORMED_URI_OUT="$("$BIN" --root "$VAL_REPO" create proj "Malformed URI" --conv "claude://aaaabbbbcccc1111 (a: b: c)" 2>&1)"
MALFORMED_URI_EXIT=$?
set -e

# Create a task with a valid URI through create (which uses render_task_file)
("$BIN" --root "$VAL_REPO" create proj "Valid Task" --conv "claude://c4fed3a6-83c5-57b2-9588-bcc651cbba58" >/dev/null)
("$BIN" --root "$VAL_REPO" sync proj)

set +e
DR_VAL_OUT="$("$BIN" --root "$VAL_REPO" doctor proj 2>&1)"
DR_VAL_EXIT=$?
set -e

if [ "$SHORT_URI_EXIT" -ne 0 ] &&
  echo "$SHORT_URI_OUT" | grep -q "invalid conversation ID 'x://b'" &&
  [ "$MALFORMED_URI_EXIT" -ne 0 ] &&
  echo "$MALFORMED_URI_OUT" | grep -q "invalid conversation ID 'claude://aaaabbbbcccc1111 (a: b: c)'" &&
  [ "$DR_VAL_EXIT" -eq 0 ] &&
  ! echo "$DR_VAL_OUT" | grep -q "invalid YAML"; then
  echo 'ok 4 - remainder validation rejects short/malformed URIs, and render_task_file quotes YAML cleanly'
else
  echo 'not ok 4 - remainder validation rejects short/malformed URIs, and render_task_file quotes YAML cleanly'
fi

# --- handoff ---------------------------------------------------------------

HANDOFF_REPO="$TEST_ROOT/handoff-repo"
mkdir -p "$HANDOFF_REPO/proj/tasks"
git -C "$HANDOFF_REPO" init -q
printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  >"$HANDOFF_REPO/AGENTS.md"
printf '# Inbox\n' >"$HANDOFF_REPO/INBOX.md"
printf '# Proj\n' >"$HANDOFF_REPO/proj/README.md"
printf '# Status\n' >"$HANDOFF_REPO/proj/STATUS.md"
printf '%s\n' \
  '---' \
  'id: TASK-11111' \
  'status: todo' \
  '---' \
  '' \
  '# Replace the manifest loader with the streaming parser' \
  '' \
  '**Problem:** The loader buffers the whole manifest.' \
  '' \
  '**Goal:** Cold start stops scaling with manifest size.' \
  '' \
  '**Criteria:** Cold start is flat across manifest sizes.' \
  >"$HANDOFF_REPO/proj/tasks/TASK-11111-manifest-loader.md"
printf '%s\n' \
  '---' \
  'id: TASK-22222' \
  'status: done' \
  '---' \
  '' \
  '# Land the schema' \
  >"$HANDOFF_REPO/proj/tasks/TASK-22222-schema.md"
printf '%s\n' \
  '---' \
  'id: TASK-33333' \
  'status: todo' \
  'blocked_by: [TASK-44444]' \
  '---' \
  '' \
  '# Wire the export pipeline' \
  '' \
  '**Goal:** Exports run end to end.' \
  >"$HANDOFF_REPO/proj/tasks/TASK-33333-export.md"
printf '%s\n' \
  '---' \
  'id: TASK-44444' \
  'status: todo' \
  '---' \
  '' \
  '# Freeze the schema' \
  >"$HANDOFF_REPO/proj/tasks/TASK-44444-freeze.md"
printf '%s\n' \
  '---' \
  'id: TASK-55555' \
  'status: blocked' \
  '---' \
  '' \
  '# Wait for an external release' \
  '' \
  '**Goal:** Adopt the release after it ships.' \
  >"$HANDOFF_REPO/proj/tasks/TASK-55555-blocked.md"
printf '%s\n' \
  '---' \
  'id: TASK-66666' \
  '---' \
  '' \
  '# Classify the task' \
  '' \
  '**Goal:** Give the task a valid state.' \
  >"$HANDOFF_REPO/proj/tasks/TASK-66666-missing-status.md"
("$BIN" --root "$HANDOFF_REPO" sync proj >/dev/null)
git -C "$HANDOFF_REPO" add -A
git -C "$HANDOFF_REPO" commit -qm 'init handoff fixture'

# Test 109: the note projects committed tracker state and asserts nothing else
HANDOFF_RESOLVED_REPO="$(cd "$HANDOFF_REPO" && pwd -P)"
HANDOFF_OUT="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-11111 2>/dev/null)"
# Compare against a single-line rendering: the note is hard-wrapped for pasting.
HANDOFF_FLAT="$(printf '%s' "$HANDOFF_OUT" | tr '\n' ' ' | tr -s ' ')"
if [[ "$HANDOFF_FLAT" == *"Next is taskgo TASK-11111 (proj): Replace the manifest loader with the streaming parser."* ]] &&
  [[ "$HANDOFF_FLAT" == *"Cold start stops scaling with manifest size."* ]] &&
  [[ "$HANDOFF_FLAT" == *"$HANDOFF_RESOLVED_REPO/proj/STATUS.md"* ]] &&
  [[ "$HANDOFF_FLAT" == *"$HANDOFF_RESOLVED_REPO/proj/tasks/TASK-11111-manifest-loader.md"* ]] &&
  [[ "$HANDOFF_FLAT" == *"form your own view of the approach."* ]] &&
  [[ "$HANDOFF_FLAT" != *"buffers the whole manifest"* ]] &&
  [[ "$HANDOFF_FLAT" != *"Criteria"* ]]; then
  echo 'ok 5 - handoff emits ID, project, title, and Goal without other task prose'
else
  echo 'not ok 5 - handoff emits ID, project, title, and Goal without other task prose'
fi

# Test 110: file references survive wrapping unbroken
HANDOFF_LONG="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-11111 2>/dev/null)"
if [[ "$HANDOFF_LONG" == *"($HANDOFF_RESOLVED_REPO/proj/tasks/TASK-11111-manifest-loader.md)"* ]]; then
  echo 'ok 6 - handoff never wraps a path mid-token'
else
  echo 'not ok 6 - handoff never wraps a path mid-token'
fi

# Test 111: handing off finished work is refused
set +e
HANDOFF_DONE_OUT="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-22222 2>&1)"
HANDOFF_DONE_EXIT=$?
set -e
if [ "$HANDOFF_DONE_EXIT" -ne 0 ] &&
  [[ "$HANDOFF_DONE_OUT" == *"taskgo handoff: TASK-22222 is done"* ]] &&
  [[ "$HANDOFF_DONE_OUT" == *"--state ready"* ]]; then
  echo 'ok 7 - handoff refuses a done task and points at the ready frontier'
else
  echo 'not ok 7 - handoff refuses a done task and points at the ready frontier'
fi

# Test 112: unresolved blockers warn on stderr but still emit a note
set +e
HANDOFF_BLOCKED_ERR="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-33333 2>&1 >/dev/null)"
HANDOFF_BLOCKED_EXIT=$?
set -e
HANDOFF_BLOCKED_OUT="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-33333 2>/dev/null)"
if [ "$HANDOFF_BLOCKED_EXIT" -eq 0 ] &&
  [[ "$HANDOFF_BLOCKED_ERR" == *"[WARN]"* ]] &&
  [[ "$HANDOFF_BLOCKED_ERR" == *"still blocked by TASK-44444"* ]] &&
  [[ "$HANDOFF_BLOCKED_OUT" == *"Next is taskgo TASK-33333"* ]]; then
  echo 'ok 8 - handoff warns on unresolved blockers without failing'
else
  echo 'not ok 8 - handoff warns on unresolved blockers without failing'
fi

# Test 113: a missing Goal is reported rather than silently producing a thin note
set +e
HANDOFF_NO_GOAL_ERR="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-44444 2>&1 >/dev/null)"
set -e
if [[ "$HANDOFF_NO_GOAL_ERR" == *"[WARN]"* ]] && [[ "$HANDOFF_NO_GOAL_ERR" == *"has no '**Goal:**'"* ]]; then
  echo 'ok 9 - handoff warns when the task states no Goal'
else
  echo 'not ok 9 - handoff warns when the task states no Goal'
fi

# Test 114: uncommitted project state is reported (handoff-ready precondition)
printf 'scratch\n' >>"$HANDOFF_REPO/proj/STATUS.md"
set +e
HANDOFF_DIRTY_ERR="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-11111 2>&1 >/dev/null)"
HANDOFF_DIRTY_EXIT=$?
set -e
git -C "$HANDOFF_REPO" checkout -q -- proj/STATUS.md
if [ "$HANDOFF_DIRTY_EXIT" -eq 0 ] &&
  [[ "$HANDOFF_DIRTY_ERR" == *"[WARN]"* ]] &&
  [[ "$HANDOFF_DIRTY_ERR" == *"uncommitted changes"* ]]; then
  echo 'ok 10 - handoff warns when the project has uncommitted changes'
else
  echo 'not ok 10 - handoff warns when the project has uncommitted changes'
fi

# Test 115: warnings never contaminate the paste-ready note on stdout
HANDOFF_CLEAN="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-33333 2>/dev/null)"
if [[ "$HANDOFF_CLEAN" != *"[WARN]"* ]] && [[ "$HANDOFF_CLEAN" != *"blocked by"* ]]; then
  echo 'ok 11 - handoff keeps diagnostics off stdout'
else
  echo 'not ok 11 - handoff keeps diagnostics off stdout'
fi

# Test 116: the note reads the working tree, and --at reads a commit
sed -i.bak 's/Cold start stops scaling with manifest size/Use a replacement goal from the working tree/' \
  "$HANDOFF_REPO/proj/tasks/TASK-11111-manifest-loader.md"
set +e
HANDOFF_DIRTY_TASK_ERR="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-11111 2>&1 >/dev/null)"
HANDOFF_DIRTY_TASK_EXIT=$?
set -e
HANDOFF_DIRTY_TASK_OUT="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-11111 2>/dev/null)"
HANDOFF_AT_HEAD_OUT="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-11111 --at HEAD 2>/dev/null)"
git -C "$HANDOFF_REPO" checkout -q -- proj/tasks/TASK-11111-manifest-loader.md
rm -f "$HANDOFF_REPO/proj/tasks/TASK-11111-manifest-loader.md.bak"
if [ "$HANDOFF_DIRTY_TASK_EXIT" -eq 0 ] &&
  [[ "$HANDOFF_DIRTY_TASK_ERR" == *"uncommitted changes"* ]] &&
  [[ "$HANDOFF_DIRTY_TASK_OUT" == *"replacement goal from the working tree"* ]] &&
  [[ "$HANDOFF_AT_HEAD_OUT" == *"Cold start stops scaling with manifest size."* ]] &&
  [[ "$HANDOFF_AT_HEAD_OUT" != *"replacement goal"* ]]; then
  echo 'ok 12 - handoff reads the working tree, and --at HEAD the committed prose'
else
  echo 'not ok 12 - handoff reads the working tree, and --at HEAD the committed prose'
fi

# Test 117: explicit blocked state warns even without a blocked_by edge
HANDOFF_STATUS_BLOCKED_ERR="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-55555 2>&1 >/dev/null)"
if [[ "$HANDOFF_STATUS_BLOCKED_ERR" == *"status is blocked but no blocked_by edges"* ]]; then
  echo 'ok 13 - handoff reports explicit blocked status through the shared audit'
else
  echo 'not ok 13 - handoff reports explicit blocked status through the shared audit'
fi

# Test 118: missing task status is reported through the shared audit
HANDOFF_MISSING_STATUS_ERR="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-66666 2>&1 >/dev/null)"
if [[ "$HANDOFF_MISSING_STATUS_ERR" == *"non-standard status ''"* ]]; then
  echo 'ok 14 - handoff reports a missing status through the shared audit'
else
  echo 'not ok 14 - handoff reports a missing status through the shared audit'
fi

# Test 119: an uncommitted task is handed off with a warning, but is not at HEAD
printf '%s\n' \
  '---' \
  'id: TASK-77777' \
  'status: todo' \
  '---' \
  '' \
  '# Handoff an uncommitted task' \
  '' \
  '**Goal:** Keep the note reproducible.' \
  >"$HANDOFF_REPO/proj/tasks/TASK-77777-uncommitted.md"
set +e
HANDOFF_UNCOMMITTED_OUT="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-77777 2>&1)"
HANDOFF_UNCOMMITTED_EXIT=$?
HANDOFF_UNCOMMITTED_AT_OUT="$("$BIN" --root "$HANDOFF_REPO" handoff TASK-77777 --at HEAD 2>&1)"
HANDOFF_UNCOMMITTED_AT_EXIT=$?
set -e
if [ "$HANDOFF_UNCOMMITTED_EXIT" -eq 0 ] &&
  [[ "$HANDOFF_UNCOMMITTED_OUT" == *"Next is taskgo TASK-77777"* ]] &&
  [[ "$HANDOFF_UNCOMMITTED_OUT" == *"uncommitted changes"* ]] &&
  [ "$HANDOFF_UNCOMMITTED_AT_EXIT" -ne 0 ] &&
  [[ "$HANDOFF_UNCOMMITTED_AT_OUT" == *"TASK-77777 is not in commit"* ]]; then
  echo 'ok 15 - handoff warns on an uncommitted task, and --at HEAD lacks it'
else
  echo 'not ok 15 - handoff warns on an uncommitted task, and --at HEAD lacks it'
fi

# ===========================================================================
# ADR supersedes edges, active projection, and stale-reference pruning
# ===========================================================================

ADR_REPO="$TEST_ROOT/adr-repo"
mkdir -p "$ADR_REPO/proj/tasks" "$ADR_REPO/proj/decisions" "$ADR_REPO/proj/src"
git -C "$ADR_REPO" init -q
git -C "$ADR_REPO" config user.name 'Taskgo Test'
git -C "$ADR_REPO" config user.email 'taskgo@example.invalid'

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  >"$ADR_REPO/AGENTS.md"
printf '# Inbox\n' >"$ADR_REPO/INBOX.md"
printf '# Project\n' >"$ADR_REPO/proj/README.md"
printf 'print("ok")\n' >"$ADR_REPO/proj/src/live.py"

cat <<'EOF' >"$ADR_REPO/proj/decisions/001-initial-arch.md"
# 001: Initial Architecture

## Status

Accepted

## Context

Initial design relies on [live module](src/live.py).

## Decision

Use the initial module.

## Consequences

Simple baseline.
EOF

# Test 121: sync projects active ADRs under ### Decisions in STATUS.md
("$BIN" --root "$ADR_REPO" sync proj) >/dev/null
if grep -q '^### Decisions$' "$ADR_REPO/proj/STATUS.md" &&
  grep -q '001-initial-arch.md.*001: Initial Architecture' "$ADR_REPO/proj/STATUS.md" &&
  ("$BIN" --root "$ADR_REPO" doctor proj) >/dev/null 2>&1; then
  echo 'ok 16 - sync projects active ADRs in STATUS.md and doctor passes'
else
  echo 'not ok 16 - sync projects active ADRs in STATUS.md and doctor passes'
fi

# Test 122: supersedes on newer ADR retires older ADR without editing the older file
cat <<'EOF' >"$ADR_REPO/proj/decisions/002-new-arch.md"
---
supersedes:
  - 001-initial-arch.md
---

# 002: New Architecture

## Status

Accepted

## Context

Replaces 001-initial-arch.md with a streaming pipeline.

## Decision

Adopt the streaming pipeline.

## Consequences

Higher throughput.
EOF

("$BIN" --root "$ADR_REPO" sync proj) >/dev/null
if grep -q '002-new-arch.md.*002: New Architecture' "$ADR_REPO/proj/STATUS.md" &&
  ! grep -q '001-initial-arch.md' "$ADR_REPO/proj/STATUS.md" &&
  grep -q '^Accepted$' "$ADR_REPO/proj/decisions/001-initial-arch.md" &&
  ("$BIN" --root "$ADR_REPO" doctor proj) >/dev/null 2>&1; then
  echo 'ok 17 - supersedes edge retires older ADR from STATUS.md without modifying older file'
else
  echo 'not ok 17 - supersedes edge retires older ADR from STATUS.md without modifying older file'
fi

# Test 123: doctor warns when supersedes names an unknown ADR
cat <<'EOF' >"$ADR_REPO/proj/decisions/003-unknown-target.md"
---
supersedes:
  - 999-missing.md
---

# 003: Unknown Target

## Status

Accepted

## Context

Tests unknown supersedes target detection.

## Decision

None.

## Consequences

Doctor warns.
EOF

("$BIN" --root "$ADR_REPO" sync proj) >/dev/null
set +e
ADR_UNKNOWN_OUT="$("$BIN" --root "$ADR_REPO" doctor proj 2>&1)"
ADR_UNKNOWN_EXIT=$?
set -e
rm -f "$ADR_REPO/proj/decisions/003-unknown-target.md"
if [ "$ADR_UNKNOWN_EXIT" -ne 0 ] &&
  [[ "$ADR_UNKNOWN_OUT" == *"supersedes names unknown ADR(s): 999-missing.md"* ]]; then
  echo 'ok 18 - doctor warns when supersedes names an unknown ADR target'
else
  echo 'not ok 18 - doctor warns when supersedes names an unknown ADR target'
fi

# Test 124: doctor warns on ADR supersedes cycles
cat <<'EOF' >"$ADR_REPO/proj/decisions/001-initial-arch.md"
---
supersedes:
  - 002-new-arch.md
---

# 001: Initial Architecture

## Status

Accepted

## Context

Cycle test.

## Decision

Cycle.

## Consequences

Doctor warns.
