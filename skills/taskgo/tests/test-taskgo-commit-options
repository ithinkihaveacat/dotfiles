#!/usr/bin/env bash
set -euo pipefail

# Tests the managed AGENTS.md block, record formatting on commit, update's
# list options, and the grouped top-level help.

# shellcheck source=skills/taskgo/tests/common.sh disable=SC1091
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
taskgo_test_init

echo "1..14"

REPO="$TEST_ROOT/repo"
init_base_repo "$REPO"
tg --root "$REPO" --offline sync example >/dev/null
git -C "$REPO" add -A
git -C "$REPO" commit -qm 'chore: init'

# 1: fix keeps local policy outside the block byte for byte
tg --root "$REPO" --offline fix >/dev/null 2>&1
printf '\n## Local policy\n\n*  Keep   this   exactly.\n' >>"$REPO/AGENTS.md"
LOCAL_TAIL="$(sed -n '/<!-- taskgo:end -->/,$p' "$REPO/AGENTS.md")"
sed -i.bak 's/^- Start with/- Begin with/' "$REPO/AGENTS.md" && rm -f "$REPO/AGENTS.md.bak"
git -C "$REPO" commit -qam 'docs: local policy'
if DOC_OUT=$(tg --root "$REPO" --offline doctor 2>&1) &&
  grep -q '^\[INFO\]  AGENTS.md: taskgo block differs' <<<"$DOC_OUT" &&
  (tg --root "$REPO" --offline fix) >/dev/null 2>&1 &&
  grep -q '^- Start with' "$REPO/AGENTS.md" &&
  [[ "$(sed -n '/<!-- taskgo:end -->/,$p' "$REPO/AGENTS.md")" == "$LOCAL_TAIL" ]] &&
  [[ "$(tg --root "$REPO" --offline doctor 2>&1)" != *'AGENTS.md'* ]]; then
  echo 'ok 1 - fix rewrites only the AGENTS.md block and keeps local policy'
else
  echo 'not ok 1 - fix rewrites only the AGENTS.md block and keeps local policy'
  printf '# doctor=%s\n' "${DOC_OUT:-}"
fi

# 2: an older canonical AGENTS.md is replaced by the managed block
LEGACY_REPO="$TEST_ROOT/legacy"
init_base_repo "$LEGACY_REPO"
cat >"$LEGACY_REPO/AGENTS.md" <<'EOF'
# Agent Instructions

This repository follows taskgo:
<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.

## Standing Rules

- **Project and task onboarding:** When work touches a `taskgo` project or task
  (`<project>` or `TASK-XXXXX`), run `taskgo handoff <project|TASK-ID>`, read
  the files it names, and activate the project's declared skills with
  `taskgo skills <project> | skill --scope session add -`. When work extends to
  other repositories or technology stacks not covered by active skills, discover
  and add session skills via `skill catalog --json`.
- **Declaring skills:** A project's required skills are declared in the
  `skills:` list in `<project>/README.md` YAML frontmatter (`taskgo doctor`
  validates the names) and activated per session (`skill --scope session add`),
  rather than added to the control repository's workspace skills.
- **Environments and constraints:** Before running build, test, or operational
  commands, check `<project>/README.md` (including `**Target Environment:**`,
  scope, map, and standing constraints) and the root `README.md` (when present)
  for environment rules.
- **Session continuity:** In this control repository, always cite the active
  globally unique conversation/session ID without abbreviation as
  `[<conversation-id>](<agent>://<conversation-id>)` (or
  `conversation://<conversation-id>`) in `STATUS.md` `## Summary` and task
  records. Pass `--conv <conversation-id>` to task- and commit-recording
  subcommands (`taskgo create`, `taskgo update`, `taskgo checkpoint`,
  `taskgo commit`) to record it in frontmatter and commit trailers; subcommands
  like `taskgo sync`, `taskgo status`, `taskgo check`, and `taskgo doctor` do
  not take `--conv`.
- **Data segregation and paths:** Keep private tracker notes, `Conversation:`
  trailers, and session links strictly inside this control repository—never in
  commits, PRs, or files of external artifact repositories. Within tracker
  files, use relative Markdown links (no `file://`) and `$HOME`-relative paths
  (`~/...`) for local checkouts.
EOF
tg --root "$LEGACY_REPO" --offline sync >/dev/null 2>&1
if LEG_OUT=$(tg --root "$LEGACY_REPO" --offline doctor 2>&1) &&
  grep -q '^\[INFO\]  AGENTS.md: older taskgo template' <<<"$LEG_OUT" &&
  (tg --root "$LEGACY_REPO" --offline fix --no-commit) >/dev/null 2>&1 &&
  ! grep -q 'Standing Rules\|Target Environment' "$LEGACY_REPO/AGENTS.md" &&
  [[ "$(head -1 "$LEGACY_REPO/AGENTS.md")" == '# Agent Instructions' ]] &&
  [[ "$(tail -1 "$LEGACY_REPO/AGENTS.md")" == '<!-- taskgo:end -->' ]]; then
  echo 'ok 2 - an older canonical AGENTS.md is replaced by the managed block'
else
  echo 'not ok 2 - an older canonical AGENTS.md is replaced by the managed block'
  printf '# doctor=%s\n' "${LEG_OUT:-}"
fi

# 3: the managed block stays short
BLOCK_BYTES=$(sed -n '/<!-- taskgo:begin -->/,/<!-- taskgo:end -->/p' "$REPO/AGENTS.md" | wc -c)
if ((BLOCK_BYTES < 1100)); then
  echo 'ok 3 - the managed AGENTS.md block is under about 1 KB'
else
  echo "not ok 3 - the managed AGENTS.md block is $BLOCK_BYTES bytes"
fi

# 4: checkpoint formats the records it commits
TASK_FILE="$REPO/example/tasks/TASK-A1B2C-confirm-status.md"
printf '\n**Findings:**   one    two\nthree\n' >>"$TASK_FILE"
if tg --root "$REPO" --offline checkpoint TASK-A1B2C 'docs(example): findings' \
  >/dev/null 2>&1 &&
  "$MARKDOWN_FORMAT" --check "$TASK_FILE" >/dev/null 2>&1 &&
  [[ -z "$(git -C "$REPO" status --porcelain)" ]]; then
  echo 'ok 4 - checkpoint formats the task record it commits'
else
  echo 'not ok 4 - checkpoint formats the task record it commits'
  git -C "$REPO" status --porcelain | sed 's/^/# /'
fi

# 5: commit formats a staged record, re-stages it, and leaves non-records
printf '\nSome   *plan*   text\n' >>"$REPO/example/PLAN.md"
printf '\n**Constraints:**   keep    it\nsimple\n' >>"$TASK_FILE"
git -C "$REPO" add example/PLAN.md "$TASK_FILE"
if tg --root "$REPO" --offline commit 'docs(example): constraints' >/dev/null 2>&1 &&
  "$MARKDOWN_FORMAT" --check "$TASK_FILE" >/dev/null 2>&1 &&
  grep -q 'Some   \*plan\*   text' "$REPO/example/PLAN.md" &&
  [[ -z "$(git -C "$REPO" status --porcelain)" ]]; then
  echo 'ok 5 - commit formats staged records only'
else
  echo 'not ok 5 - commit formats staged records only'
  git -C "$REPO" status --porcelain | sed 's/^/# /'
fi

# 6: commit leaves a staged record with unstaged changes unformatted
printf '\n**Cost:**   slow    builds\n' >>"$TASK_FILE"
git -C "$REPO" add "$TASK_FILE"
printf '\nUnstaged line.\n' >>"$TASK_FILE"
if tg --root "$REPO" --offline commit 'docs(example): cost' >/dev/null 2>&1 &&
  { shown=$(git -C "$REPO" show HEAD:example/tasks/TASK-A1B2C-confirm-status.md) &&
    [[ "$shown" == *'**Cost:**   slow    builds'* && "$shown" != *'Unstaged line.'* ]]; } &&
  grep -q 'Unstaged line.' "$TASK_FILE"; then
  echo 'ok 6 - commit does not re-stage a record with unstaged changes'
else
  echo 'not ok 6 - commit does not re-stage a record with unstaged changes'
fi
git -C "$REPO" checkout -q -- example

# 7: update --set-wait-for replaces the list; --wait-for still works hidden
tg --root "$REPO" --offline update TASK-A1B2C --add-wait-for 2030-01-01 \
  --add-wait-for gh:octo/repo#7 >/dev/null 2>&1
HELP="$(tg update --help)"
if tg --root "$REPO" --offline update TASK-A1B2C --set-wait-for 2031-02-03 >/dev/null 2>&1 &&
  { fm=$(sed -n '/^wait_for:/,/^[a-z_]*:/p' "$TASK_FILE") &&
    [[ "$fm" == *2031-02-03* && "$fm" != *2030-01-01* && "$fm" != *octo* ]]; } &&
  tg --root "$REPO" --offline update TASK-A1B2C --wait-for 2032-04-05 >/dev/null 2>&1 &&
  { fm=$(sed -n '/^wait_for:/,/^[a-z_]*:/p' "$TASK_FILE") &&
    [[ "$fm" == *2032-04-05* && "$fm" != *2031-02-03* ]]; } &&
  [[ "$HELP" == *'--set-wait-for GATE'*'Replace the whole wait_for list'* ]] &&
  [[ "$HELP" != *'  --wait-for'* ]] &&
  [[ "$HELP" == *'--status done --outcome'* ]]; then
  echo 'ok 7 - update --set-wait-for replaces the list and --wait-for is a hidden alias'
else
  echo 'not ok 7 - update --set-wait-for replaces the list and --wait-for is a hidden alias'
fi
git -C "$REPO" checkout -q -- example

# 8: top-level help groups every command
TOP="$(tg --help)"
missing=""
for c in id root create update apply edit list info skills status handoff sync \
  check doctor fix history read search checkpoint commit schema mcp; do
  grep -q "^  $c\b" <<<"$TOP" || missing="$missing $c"
done
if [[ -z "$missing" && "$TOP" == *$'\nTasks:\n'* && "$TOP" == *$'\nHealth:\n'* &&
  "$TOP" != *personal* ]]; then
  echo 'ok 8 - top-level help groups every command under headings'
else
  echo "not ok 8 - top-level help is missing:$missing"
fi

# 9: commit and checkpoint reject -m / --message with a positional SUBJECT hint
if [[ "$(tg --root "$REPO" --offline commit -m "docs: msg" 2>&1 || true)" == *'use positional SUBJECT (and --body TEXT), not -m:'*'taskgo commit "type(scope): subject"'* ]] &&
  [[ "$(tg --root "$REPO" --offline commit --message="docs: msg" 2>&1 || true)" == *'use positional SUBJECT (and --body TEXT), not --message:'* ]] &&
  [[ "$(tg --root "$REPO" --offline checkpoint TASK-A1B2C -m "docs: msg" 2>&1 || true)" == *'use positional SUBJECT (and --body TEXT), not -m:'*'taskgo checkpoint TASK_ID "type(scope): subject"'* ]] &&
  [[ "$(tg checkpoint --help)" == *'pushed to the upstream remote unless --offline'* ]] &&
  [[ "$(tg commit --help)" == *'pushed to the upstream remote unless --offline'* ]] &&
  grep -q "no \`-m\`" "$REPO/AGENTS.md"; then
  echo 'ok 9 - commit and checkpoint reject -m/--message with positional SUBJECT hint and document push'
else
  echo 'not ok 9 - commit and checkpoint reject -m/--message with positional SUBJECT hint and document push'
fi

# 10: checkpoint --path stages directories cleanly, and staging errors emit actionable hints
mkdir -p "$REPO/example/references/sub"
printf '# Ref A\n' >"$REPO/example/references/a.md"
printf '# Ref B\n' >"$REPO/example/references/sub/b.md"
printf 'dirty sibling\n' >"$REPO/example/sibling.txt"
UNLISTED_ERR=$(tg --root "$REPO" --offline checkpoint TASK-A1B2C 'docs(example): add refs' \
  --path example/references/ 2>&1 || true)
rm -f "$REPO/example/sibling.txt"
printf '\nstaged line\n' >>"$REPO/example/PLAN.md"
git -C "$REPO" add example/PLAN.md
NONEMPTY_IDX_ERR=$(tg --root "$REPO" --offline checkpoint TASK-A1B2C 'docs(example): idx' 2>&1 || true)
git -C "$REPO" reset -q -- example/PLAN.md
git -C "$REPO" checkout -q -- example/PLAN.md
if [[ "$UNLISTED_ERR" == *'unlisted project change: example/sibling.txt'* ]] &&
  [[ "$UNLISTED_ERR" != *'example/references/a.md'* ]] &&
  [[ "$UNLISTED_ERR" == *'git add <paths> && taskgo commit "<subject>"'* ]] &&
  [[ "$NONEMPTY_IDX_ERR" == *'checkpoint: index is not empty'*'taskgo commit "<subject>"'*'git reset'* ]] &&
  tg --root "$REPO" --offline checkpoint TASK-A1B2C 'docs(example): add refs' \
    --path example/references/ -C 1234567890abcdef1234 >/dev/null 2>&1 &&
  [[ -z "$(git -C "$REPO" status --porcelain)" ]] &&
  git -C "$REPO" ls-files --error-unmatch example/references/a.md example/references/sub/b.md >/dev/null 2>&1; then
  echo 'ok 10 - checkpoint --path stages directories and emits clear staging hints'
else
  echo 'not ok 10 - checkpoint --path stages directories and emits clear staging hints'
fi

# 11: list-valued run-in fields render on a separate block across create and update,
# and commit stages working-tree STATUS.md updates
LIST_OUT=$(tg --root "$REPO" --offline create example 'List run-in fields' \
  --slug list-runins --problem '- First issue' --criteria $'1. Bullet one\n2. Bullet two' --no-commit)
LIST_ID="${LIST_OUT%%$'\t'*}"
LIST_REL="${LIST_OUT#*$'\t'}"
tg --root "$REPO" --offline update "$LIST_ID" --goal $'- Updated goal one\n- Updated goal two' >/dev/null
LIST_TEXT="$(cat "$REPO/$LIST_REL")"
git -C "$REPO" add "$LIST_REL"
if [[ "$LIST_TEXT" == *$'**Problem:**\n\n- First issue'* ]] &&
  [[ "$LIST_TEXT" == *$'**Goal:**\n\n- Updated goal one\n- Updated goal two'* ]] &&
  [[ "$LIST_TEXT" == *$'**Criteria:**\n\n1. Bullet one\n'* ]] &&
  tg --root "$REPO" --offline commit 'feat(example): add list task' >/dev/null 2>&1 &&
  [[ -z "$(git -C "$REPO" status --porcelain)" ]]; then
  echo 'ok 11 - list-valued run-ins render as blocks and commit stages updated STATUS.md'
else
  echo 'not ok 11 - list-valued run-ins render as blocks and commit stages updated STATUS.md'
fi

# 12: doctor markdown_finding suggests 'taskgo fix --no-commit' and includes static PLAN wording
printf '\n*   untidy   item\n' >>"$REPO/example/PROJECT.md"
MD_DOC_OUT="$(tg --root "$REPO" --offline doctor example 2>&1 || true)"
git -C "$REPO" checkout -q -- example/PROJECT.md
if [[ "$MD_DOC_OUT" == *"example/PROJECT.md: markdown formatting needed (run 'taskgo fix --no-commit')"* ]] &&
  [[ "$MD_DOC_OUT" == *'PLAN (when present) reflects current direction;'* ]]; then
  echo 'ok 12 - doctor markdown formatting finding suggests taskgo fix --no-commit'
else
  echo 'not ok 12 - doctor markdown formatting finding suggests taskgo fix --no-commit'
  printf '# %s\n' "$MD_DOC_OUT"
fi

# 13: CWD inside an isolated control-repo clone auto-detects that clone before ~/.projects
CLONE_REPO="$TEST_ROOT/isolated-clone"
git clone -q "$REPO" "$CLONE_REPO"
NON_CONTROL_GIT="$TEST_ROOT/ordinary-git"
git init -q "$NON_CONTROL_GIT"
printf '# Ordinary Repo\n' >"$NON_CONTROL_GIT/AGENTS.md"
CLONE_RESOLVED="$(cd "$CLONE_REPO" && pwd -P)"
if [[ "$(cd "$CLONE_REPO/example/tasks" && tg root)" == "$CLONE_RESOLVED" ]] &&
  [[ "$(cd "$CLONE_REPO/example" && tg --offline doctor example 2>&1)" == *"Root: $CLONE_RESOLVED"*'Source: cwd'* ]] &&
  [[ "$(cd "$NON_CONTROL_GIT" && tg --help)" == *'Root: ~/.projects'*'Source: default'* ]]; then
  echo 'ok 13 - CWD inside a cloned control repo resolves to that clone instead of ~/.projects'
else
  echo 'not ok 13 - CWD inside a cloned control repo resolves to that clone instead of ~/.projects'
fi

# 14: top-level -C hints -R/--root, and trailing --offline works across subcommands
if [[ "$(tg -C "$REPO" list 2>&1 || true)" == *'use -R / --root DIR instead of -C'* ]] &&
  tg --root "$CLONE_REPO" list example --offline >/dev/null &&
  tg --root "$CLONE_REPO" doctor example --offline >/dev/null &&
  tg --root "$CLONE_REPO" search 'First issue' --offline >/dev/null; then
  echo 'ok 14 - top-level -C hints -R/--root and trailing --offline works across subcommands'
else
  echo 'not ok 14 - top-level -C hints -R/--root and trailing --offline works across subcommands'
fi
