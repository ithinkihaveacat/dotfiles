); then
  echo 'ok 4 - apply regenerates only affected and dependent projects'
else
  echo 'not ok 4 - apply regenerates only affected and dependent projects'
  printf '# %s\n' "${APPLY_DEP//$'\n'/$'\n'# }"
fi
git -C "$APPLY_REPO" checkout -q -- .

if APPLY_WF=$(
  "$APPLY_PY" - "$BIN" "$APPLY_REPO" 2>&1 <<'PY'
import runpy, subprocess, sys
g = runpy.run_path(sys.argv[2] + "/../apply-lib.py")
tg, apply, refused, repo = g["tg"], g["apply"], g["refused"], g["repo"]


