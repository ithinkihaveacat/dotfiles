    return subprocess.run(["git", "hash-object", rel], cwd=repo, text=True,
                          capture_output=True, check=True).stdout.strip()


def write(path, content, expected=None):
    return {"op": "write_file", "path": path, "content": content,
            "expected_blob": expected}


assert tg.git_blob_sha((repo / "alpha/PLAN.md").read_bytes()) == blob("alpha/PLAN.md")
cs = apply(
    write("alpha/PLAN.md", "# Plan\n\n\n\nReformatted   plan.\n", blob("alpha/PLAN.md")),
    write("alpha/references/new.md", "# New\n"),
    write("alpha/data.txt", "plain\n"),
    {"op": "delete_file", "path": "INBOX.md", "expected_blob": blob("INBOX.md")},
)
assert cs.snap.read_text("alpha/PLAN.md") == "# Plan\n\nReformatted plan.\n"
assert cs.snap.read_text("alpha/references/new.md") == "# New\n"
