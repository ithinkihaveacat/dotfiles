#!/usr/bin/env bash
set -euo pipefail

# Builds a synthetic control repository for exercising 'taskgo mcp': two
# projects, every scheduling field, ADRs with supersedes, a cross-project edge,
# a slug rename, and several status transitions in history. Contains no real
# tracker content.
#
# Usage: make-synthetic DIR

if [ "$#" -ne 1 ]; then
  echo "usage: make-synthetic DIR" >&2
  exit 2
fi
DIR="$1"
if [ -e "$DIR" ]; then
  echo "make-synthetic: $DIR already exists" >&2
  exit 1
fi

BIN="$(cd "$(dirname "$0")/../scripts" && pwd)/taskgo"
if [ -z "${TASKGO_PY:-}" ]; then
  TASKGO_PY=$(uv sync -q --script "$BIN" </dev/null && uv python find --script "$BIN")
fi
export GIT_AUTHOR_NAME="Taskgo Synthetic" GIT_AUTHOR_EMAIL="taskgo@example.com"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
export TASKGO_TODAY=2026-10-11
unset CLAUDE_CODE_SESSION_ID CLAUDE_CODE_REMOTE_SESSION_ID CODEX_SESSION_ID AI_AGENT

commit() { git -C "$DIR" add -A && git -C "$DIR" commit -q -m "$1"; }

mkdir -p "$DIR/alpha/tasks" "$DIR/beta/tasks" "$DIR/beta/decisions" "$DIR/alpha/results"
git -C "$DIR" init -q -b main

cat >"$DIR/README.md" <<'MD'
---
timezone: Europe/London
---

# Synthetic tracker
MD
cat >"$DIR/AGENTS.md" <<'MD'
# AGENTS.md

This repository follows taskgo:
<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.
MD
printf '# Inbox\n' >"$DIR/INBOX.md"
cat >"$DIR/alpha/README.md" <<'MD'
---
skills:
  - example-skill
---

# Alpha

A synthetic project.
MD
printf '# Plan\n\n- Ship the widget.\n' >"$DIR/alpha/PLAN.md"
printf 'n,value\n1,2\n' >"$DIR/alpha/results/data.csv"
printf '# Beta\n\nAnother synthetic project.\n' >"$DIR/beta/README.md"
commit "chore: start the synthetic tracker"

"$TASKGO_PY" - "$BIN" "$DIR" <<'PY'
import contextlib
import importlib.machinery
import importlib.util
import io
import subprocess
import sys

bin_path, root_dir = sys.argv[1], sys.argv[2]
loader = importlib.machinery.SourceFileLoader("taskgo_cli_synth", bin_path)
spec = importlib.util.spec_from_loader(loader.name, loader)
assert spec is not None
tg = importlib.util.module_from_spec(spec)
sys.modules[loader.name] = tg
loader.exec_module(tg)


def run_tg(*args: str) -> str:
    tg._REPO_ROOT_CACHE = None
    tg._EXPLICIT_ROOT = None
    tg._ACTIVE_COMMAND = None
    tg._OFFLINE_FLAG = False
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            tg.main(["--root", root_dir, *args])
        except SystemExit as exc:
            if exc.code not in (None, 0):
                raise RuntimeError(f"taskgo {args} failed: {err.getvalue()}") from exc
    return out.getvalue()


def create_id(*args: str) -> str:
    return run_tg("create", *args).splitlines()[0].split("\t", 1)[0]


def commit(msg: str) -> None:
    subprocess.run(["git", "-C", root_dir, "add", "-A"], check=True)
    subprocess.run(["git", "-C", root_dir, "commit", "-q", "-m", msg], check=True)


build = create_id(
    "alpha",
    "Build the widget",
    "--no-commit",
    "--problem",
    "There is no widget.",
    "--goal",
    "A widget exists.",
    "--criteria",
    "The widget turns.",
    "--sketch",
    "Start with the gears.",
)
paint = create_id("alpha", "Paint the widget", "--no-commit", "--goal", "The widget is blue.")
create_id(
    "alpha",
    "Wait for the paint supplier",
    "--no-commit",
    "--goal",
    "Paint has arrived.",
    "--add-wait-for",
    "issue/123456",
    "--add-wait-for",
    "2026-12-01",
)
polish = create_id(
    "alpha", "Polish the widget", "--no-commit", "--goal", "It shines.", "--due", "2026-10-13"
)
measure = create_id(
    "beta",
    "Measure the widget",
    "--no-commit",
    "--goal",
    "Dimensions are known.",
    "--stale-after",
    "2026-11-01",
)

with open(f"{root_dir}/beta/decisions/001-use-gears.md", "w") as fh:
    fh.write(
        "# 1. Use gears\n\n## Status\n\nAccepted\n\n## Context\n\nWidgets turn.\n\n"
        "## Decision\n\nUse gears.\n\n## Consequences\n\nGears wear out.\n"
    )
with open(f"{root_dir}/beta/decisions/002-use-belts.md", "w") as fh:
    fh.write(
        "---\nsupersedes: [001-use-gears]\n---\n\n# 2. Use belts\n\n## Status\n\n"
        "Accepted\n\n## Context\n\nGears wore out.\n\n## Decision\n\nUse belts.\n\n"
        "## Consequences\n\nBelts stretch.\n"
    )
run_tg("sync")
commit("chore: plan the widget")

run_tg("update", paint, "--add-blocked-by", build)
run_tg("update", measure, "--add-blocked-by", polish)
run_tg(
    "update",
    build,
    "--status",
    "in-progress",
    "--add-conversation",
    "claude://00000000-0000-0000-0000-000000000001",
)
run_tg("sync")
commit("chore: start building the widget")

run_tg(
    "update",
    build,
    "--status",
    "done",
    "--outcome",
    "The widget turns.",
    "--findings",
    "Gears were noisy.",
)
run_tg("update", polish, "--slug", "shine-widget")
run_tg("sync")
commit("chore: finish building the widget")

run_tg("update", paint, "--status", "in-progress")
run_tg("sync")
commit("chore: start painting")
PY
