#!/usr/bin/env bash
set -euo pipefail

# Builds a synthetic control repository for exercising 'taskgo mcp': two
# projects, every scheduling field, ADRs with supersedes, a cross-project edge,
# a slug rename, and several status transitions in history. Contains no real
# tracker content.
#
# Usage: make-synthetic DIR

if [ "$#" -ne 1 ]; then
  echo "usage: make-synthetic DIR" >&2
  exit 2
fi
DIR="$1"
if [ -e "$DIR" ]; then
  echo "make-synthetic: $DIR already exists" >&2
  exit 1
fi

BIN="$(cd "$(dirname "$0")/../scripts" && pwd)/taskgo"
export GIT_AUTHOR_NAME="Taskgo Synthetic" GIT_AUTHOR_EMAIL="taskgo@example.com"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
export TASKGO_TODAY=2026-10-11
unset CLAUDE_CODE_SESSION_ID CLAUDE_CODE_REMOTE_SESSION_ID CODEX_SESSION_ID AI_AGENT

tg() { "$BIN" --root "$DIR" "$@" >/dev/null; }
commit() { git -C "$DIR" add -A && git -C "$DIR" commit -q -m "$1"; }

mkdir -p "$DIR/alpha/tasks" "$DIR/beta/tasks" "$DIR/beta/decisions" "$DIR/alpha/results"
git -C "$DIR" init -q -b main

cat >"$DIR/README.md" <<'MD'
---
timezone: Europe/London
---

# Synthetic tracker
MD
cat >"$DIR/AGENTS.md" <<'MD'
# AGENTS.md

This repository follows taskgo:
<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.
MD
printf '# Inbox\n' >"$DIR/INBOX.md"
cat >"$DIR/alpha/README.md" <<'MD'
---
skills:
  - example-skill
---

# Alpha

A synthetic project.
MD
printf '# Plan\n\n- Ship the widget.\n' >"$DIR/alpha/PLAN.md"
printf 'n,value\n1,2\n' >"$DIR/alpha/results/data.csv"
printf '# Beta\n\nAnother synthetic project.\n' >"$DIR/beta/README.md"
commit "chore: start the synthetic tracker"

tg create alpha "Build the widget" --no-commit \
  --problem "There is no widget." --goal "A widget exists." \
  --criteria "The widget turns." --sketch "Start with the gears."
tg create alpha "Paint the widget" --no-commit --goal "The widget is blue."
tg create alpha "Wait for the paint supplier" --no-commit \
  --goal "Paint has arrived." --add-wait-for b/123456 --add-wait-for 2026-12-01
tg create alpha "Polish the widget" --no-commit --goal "It shines." --due 2026-10-13
tg create beta "Measure the widget" --no-commit --goal "Dimensions are known." \
  --stale-after 2026-11-01
cat >"$DIR/beta/decisions/001-use-gears.md" <<'MD'
# 1. Use gears

## Status

Accepted

## Context

Widgets turn.

## Decision

Use gears.

## Consequences

Gears wear out.
MD
cat >"$DIR/beta/decisions/002-use-belts.md" <<'MD'
---
supersedes: [001-use-gears]
---

# 2. Use belts

## Status

Accepted

## Context

Gears wore out.

## Decision

Use belts.

## Consequences

Belts stretch.
MD
tg sync
commit "chore: plan the widget"

id_of() { "$BIN" --root "$DIR" list --json | python3 -c "import json,sys; print(next(r['id'] for r in json.load(sys.stdin) if r['title']==sys.argv[1]))" "$1"; }
BUILD=$(id_of "Build the widget")
PAINT=$(id_of "Paint the widget")
POLISH=$(id_of "Polish the widget")
MEASURE=$(id_of "Measure the widget")

tg update "$PAINT" --add-blocked-by "$BUILD"
tg update "$MEASURE" --add-blocked-by "$POLISH"
tg update "$BUILD" --status in-progress --add-conversation claude://00000000-0000-0000-0000-000000000001
tg sync
commit "chore: start building the widget"

tg update "$BUILD" --status "done" --outcome "The widget turns." --findings "Gears were noisy."
tg update "$POLISH" --slug shine-widget
tg sync
commit "chore: finish building the widget"

tg update "$PAINT" --status in-progress
tg sync
commit "chore: start painting"
