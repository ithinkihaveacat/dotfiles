#!/usr/bin/env bash
set -euo pipefail

# Color styling is asserted explicitly per test; isolate from inherited
# NO_COLOR/FORCE_COLOR.
unset NO_COLOR FORCE_COLOR

# Isolate test suite from ambient agent runtime variables.
unset AI_AGENT INVOKER_INFO_NAME
unset JETSKI_CONVERSATION_ID ANTIGRAVITY_CONVERSATION_ID ANTIGRAVITY_SESSION
unset CLAUDE_CODE_SESSION_ID CLAUDE_CODE_REMOTE_SESSION_ID CLAUDE_SESSION_ID CLAUDE_PROJECT_ID
unset OPENCODE_SESSION_ID CODEX_SESSION_ID
unset INVOKER_INFO_ROOT_SESSION_ID CONVERSATION_ID

export GIT_AUTHOR_NAME="Taskgo Test"
export GIT_AUTHOR_EMAIL="taskgo@example.com"
export GIT_COMMITTER_NAME="Taskgo Test"
export GIT_COMMITTER_EMAIL="taskgo@example.com"

TEST_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$TEST_DIR/../scripts/taskgo"
# shellcheck disable=SC2034
MARKDOWN_FORMAT="$TEST_DIR/../../coding-standards/scripts/markdown-format"
TEST_ROOT="$(mktemp -d)"
trap 'rm -rf -- "$TEST_ROOT"' EXIT
export TASKGO_MCP_LOG="$TEST_ROOT/mcp-requests.jsonl"

echo "1..14"

init_base_repo() {
  local target="${1:-$TEST_ROOT/repo}"
  mkdir -p "$target/example/tasks"
  git -C "$target" init -q
  printf '%s
' '# Agent instructions' '' 'This repository follows taskgo:' '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' >"$target/AGENTS.md"
  printf '# Inbox
' >"$target/INBOX.md"
  printf '# Example project
' >"$target/example/PROJECT.md"
  printf '# Plan
' >"$target/example/PLAN.md"
  printf '%s
' '---' 'id: TASK-A1B2C' 'status: todo' '---' '' '# Confirm generated status formatting' >"$target/example/tasks/TASK-A1B2C-confirm-status.md"
}

REPO="$TEST_ROOT/repo"
init_base_repo "$REPO"

MCP_PY=$(uv sync -q --script "$BIN" </dev/null && uv python find --script "$BIN")
# shellcheck disable=SC2034
APPLY_PY="$MCP_PY"

# --- blocked_by dependency edges -------------------------------------------

DEP_REPO="$TEST_ROOT/depends"
mkdir -p "$DEP_REPO/example/tasks"
git -C "$DEP_REPO" init -q

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  >"$DEP_REPO/AGENTS.md"
printf '# Inbox\n' >"$DEP_REPO/INBOX.md"
printf '# Example project\n' >"$DEP_REPO/example/PROJECT.md"

write_dep_task() {
  # write_dep_task ID STATUS TITLE [BLOCKED_BY_YAML]
  local id="$1" status="$2" title="$3" deps="${4:-}"
  {
    printf -- '---\n'
    printf 'id: %s\n' "$id"
    printf 'status: %s\n' "$status"
    [ -n "$deps" ] && printf 'blocked_by: %s\n' "$deps"
    printf -- '---\n\n'
    printf '# %s\n' "$title"
  } >"$DEP_REPO/example/tasks/$id-dep.md"
}

write_dep_task TASK-11111 'done' "Finished blocker"
write_dep_task TASK-22222 todo "Open blocker"
write_dep_task TASK-33333 todo "Held by an open task" '[TASK-22222]'
write_dep_task TASK-44444 todo "Held by a finished task" '[TASK-11111]'
write_dep_task TASK-55555 todo "Held by a deleted task" '[TASK-99999]'
write_dep_task TASK-66666 blocked "Declared blocked with no edges"
write_dep_task TASK-77777 todo "Cycle member one" '[TASK-88888]'
write_dep_task TASK-88888 todo "Cycle member two" '[TASK-77777]'
write_dep_task TASK-AAAAA cancelled "Cancelled blocker"
write_dep_task TASK-BBBBB todo "Held by a cancelled task" '[TASK-AAAAA]'
write_dep_task TASK-CCCCC in-progress "In-progress task held by finished task" '[TASK-11111]'
write_dep_task TASK-DDDDD 'done' "Historical done task" '[TASK-11111]'
write_dep_task TASK-EEEEE 'cancelled' "Historical cancelled task" '[TASK-11111]'

READY=$("$BIN" --root "$DEP_REPO" list example --state ready 2>/dev/null | tail -n +2 | cut -f2 | sort | tr '\n' ' ')

# Test 91: an unresolved edge keeps a todo task off the frontier
if [ "${READY#*TASK-33333}" = "$READY" ]; then
  echo 'ok 1 - unresolved blocked_by excludes a task from --state ready'
else
  echo 'not ok 1 - unresolved blocked_by excludes a task from --state ready'
  echo "# ready=$READY"
fi

# Test 92: an edge to a done task does not hold the dependent back
if [ "${READY#*TASK-44444}" != "$READY" ]; then
  echo 'ok 2 - resolved blocked_by leaves a task ready'
else
  echo 'not ok 2 - resolved blocked_by leaves a task ready'
  echo "# ready=$READY"
fi

# Test 93: an unknown blocker degrades open rather than freezing the task
if [ "${READY#*TASK-55555}" != "$READY" ]; then
  echo 'ok 3 - unknown blocked_by ID does not block readiness'
else
  echo 'not ok 3 - unknown blocked_by ID does not block readiness'
  echo "# ready=$READY"
fi

"$BIN" --root "$DEP_REPO" sync example >/dev/null 2>&1 || true

# Test 94: the snapshot projects derived blocks and names the blocker
if grep -q 'TASK-33333.*blocked by.*TASK-22222' "$DEP_REPO/example/STATUS.md"; then
  echo 'ok 4 - STATUS.md Blocked section names the unresolved blocker'
else
  echo 'not ok 4 - STATUS.md Blocked section names the unresolved blocker'
  echo "# $(sed -n '/### Blocked/,/^Todo:/p' "$DEP_REPO/example/STATUS.md" | tr '\n' '|')"
fi

# Test 95: sync is a projection and must not rewrite task frontmatter
if grep -q '^status: todo$' "$DEP_REPO/example/tasks/TASK-33333-dep.md" &&
  grep -q '^blocked_by: \[TASK-22222\]$' "$DEP_REPO/example/tasks/TASK-33333-dep.md"; then
  echo 'ok 5 - sync leaves task frontmatter untouched'
else
  echo 'not ok 5 - sync leaves task frontmatter untouched'
  echo "# $(head -6 "$DEP_REPO/example/tasks/TASK-33333-dep.md" | tr '\n' '|')"
fi

DEP_DR=$("$BIN" --root "$DEP_REPO" doctor example 2>&1) || true

# Test 96: an edge naming a task that does not exist is reported
if printf '%s\n' "$DEP_DR" | grep -q '^\[WARN\].*TASK-55555.*blocked_by names unknown task(s): TASK-99999'; then
  echo 'ok 6 - doctor reports an unknown blocked_by target'
else
  echo 'not ok 6 - doctor reports an unknown blocked_by target'
  echo "# $(printf '%s\n' "$DEP_DR" | grep -c '^\[WARN\]') warnings"
fi

# Test 97: a hand-set blocked status with nothing holding it is stale
if printf '%s\n' "$DEP_DR" | grep -q '^\[WARN\].*TASK-66666.*status is blocked but no blocked_by edges'; then
  echo 'ok 7 - doctor reports a stale declared blocked status'
else
  echo 'not ok 7 - doctor reports a stale declared blocked status'
fi

# Test 98: a dependency cycle is reported rather than silently looping
if printf '%s\n' "$DEP_DR" | grep -q '^\[WARN\]  blocked_by cycle:.*TASK-77777.*TASK-88888'; then
  echo 'ok 8 - doctor reports a blocked_by cycle'
else
  echo 'not ok 8 - doctor reports a blocked_by cycle'
fi

# Test 99: open tasks with done blockers warn to remove the edge
if printf '%s\n' "$DEP_DR" | grep -q '^\[WARN\].*TASK-44444.*blocked_by names resolved task(s): TASK-11111 (done); remove the edge' &&
  printf '%s\n' "$DEP_DR" | grep -q '^\[WARN\].*TASK-CCCCC.*blocked_by names resolved task(s): TASK-11111 (done); remove the edge'; then
  echo 'ok 9 - doctor reports open tasks with done blockers'
else
  echo 'not ok 9 - doctor reports open tasks with done blockers'
  echo "# DEP_DR=$DEP_DR"
fi

# Test 100: open tasks with cancelled blockers warn with a distinct re-plan message
if printf '%s\n' "$DEP_DR" | grep -q '^\[WARN\].*TASK-BBBBB.*blocked_by names resolved task(s): TASK-AAAAA (cancelled); re-plan or remove the edge'; then
  echo 'ok 10 - doctor reports open tasks with cancelled blockers'
else
  echo 'not ok 10 - doctor reports open tasks with cancelled blockers'
  echo "# DEP_DR=$DEP_DR"
fi

# Test 101: resolved tasks and unresolved edges do not trigger resolved blocked_by warnings
if ! printf '%s\n' "$DEP_DR" | grep -q 'TASK-DDDDD.*blocked_by names resolved task(s)' &&
  ! printf '%s\n' "$DEP_DR" | grep -q 'TASK-EEEEE.*blocked_by names resolved task(s)' &&
  ! printf '%s\n' "$DEP_DR" | grep -q 'TASK-33333.*blocked_by names resolved task(s)' &&
  ! printf '%s\n' "$DEP_DR" | grep -q 'TASK-55555.*blocked_by names resolved task(s)'; then
  echo 'ok 11 - doctor exempts resolved tasks from stale blocked_by warnings'
else
  echo 'not ok 11 - doctor exempts resolved tasks from stale blocked_by warnings'
  echo "# DEP_DR=$DEP_DR"
fi

# Test 102: project scoping restricts doctor dependency findings to the target project
mkdir -p "$DEP_REPO/scoped/tasks"
printf '# Scoped project\n' >"$DEP_REPO/scoped/PROJECT.md"
{
  printf -- '---\nid: TASK-F0001\nstatus: todo\nblocked_by: [TASK-11111]\n---\n\n# Scoped other task\n'
} >"$DEP_REPO/scoped/tasks/TASK-F0001-dep.md"

SCOPED_EX_DR=$("$BIN" --root "$DEP_REPO" doctor example 2>&1) || true
SCOPED_SC_DR=$("$BIN" --root "$DEP_REPO" doctor scoped 2>&1) || true
if printf '%s\n' "$SCOPED_EX_DR" | grep -q 'TASK-44444.*blocked_by names resolved task(s)' &&
  ! printf '%s\n' "$SCOPED_EX_DR" | grep -q 'TASK-F0001' &&
  printf '%s\n' "$SCOPED_SC_DR" | grep -q 'TASK-F0001.*blocked_by names resolved task(s): TASK-11111 (done); remove the edge' &&
  ! printf '%s\n' "$SCOPED_SC_DR" | grep -q 'TASK-44444'; then
  echo 'ok 12 - doctor scopes resolved blocked_by checks to target project'
else
  echo 'not ok 12 - doctor scopes resolved blocked_by checks to target project'
  echo "# SCOPED_EX_DR=$SCOPED_EX_DR"
  echo "# SCOPED_SC_DR=$SCOPED_SC_DR"
fi

# Test 103: fix never invents, removes, or rewrites dependency edges
git -C "$DEP_REPO" add -A >/dev/null 2>&1
git -C "$DEP_REPO" commit -qm 'seed dependency fixtures' >/dev/null 2>&1
"$BIN" --root "$DEP_REPO" fix example --no-commit >/dev/null 2>&1 || true
DEP_AFTER=$(grep -h '^blocked_by:' "$DEP_REPO"/example/tasks/*-dep.md | sort | tr '\n' ' ')
if [ "$DEP_AFTER" = "blocked_by: [TASK-11111] blocked_by: [TASK-11111] blocked_by: [TASK-11111] blocked_by: [TASK-11111] blocked_by: [TASK-22222] blocked_by: [TASK-77777] blocked_by: [TASK-88888] blocked_by: [TASK-99999] blocked_by: [TASK-AAAAA] " ]; then
  echo 'ok 13 - fix leaves blocked_by edges exactly as authored'
else
  echo 'not ok 13 - fix leaves blocked_by edges exactly as authored'
  echo "# after=$DEP_AFTER"
fi

# Test 104: doctor reports [FAIL] and exits non-zero on invalid YAML frontmatter syntax
BAD_YAML_REPO="$TEST_ROOT/bad-yaml-repo"
mkdir -p "$BAD_YAML_REPO/proj/tasks"
git -C "$BAD_YAML_REPO" init -q
printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  >"$BAD_YAML_REPO/AGENTS.md"
printf '# Inbox\n' >"$BAD_YAML_REPO/INBOX.md"
printf '# Proj\n' >"$BAD_YAML_REPO/proj/README.md"
cat <<'EOF' >"$BAD_YAML_REPO/proj/tasks/TASK-B4D01-broken-yaml.md"
---
id: TASK-B4D01
status: [unclosed list
---

# Broken YAML Task
EOF
("$BIN" --root "$BAD_YAML_REPO" sync proj >/dev/null 2>&1 || true)
BAD_DR_OUT="$("$BIN" --root "$BAD_YAML_REPO" doctor proj 2>&1 || true)"
if echo "$BAD_DR_OUT" | grep -q '\[FAIL\]  proj/tasks/TASK-B4D01-broken-yaml.md: invalid YAML frontmatter:'; then
  echo 'ok 14 - doctor reports [FAIL] and exits non-zero on invalid YAML frontmatter syntax'
else
  echo 'not ok 14 - doctor reports [FAIL] and exits non-zero on invalid YAML frontmatter syntax'
fi
