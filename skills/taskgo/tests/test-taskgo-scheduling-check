def run_tg(*argv: str, today: str | None = None) -> tuple[int, str, str]:
    tg._REPO_ROOT_CACHE = None
    tg._EXPLICIT_ROOT = None
    tg._ACTIVE_COMMAND = None
    tg._OFFLINE_FLAG = False
    prev = os.environ.get("TASKGO_TODAY")
    if today is not None:
        os.environ["TASKGO_TODAY"] = today
    out, err = io.StringIO(), io.StringIO()
    rc = 0
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            try:
                tg.main(list(argv))
            except SystemExit as exc:
                rc = exc.code if isinstance(exc.code, int) else (1 if exc.code else 0)
    finally:
        if today is not None:
            if prev is None:
                os.environ.pop("TASKGO_TODAY", None)
            else:
                os.environ["TASKGO_TODAY"] = prev
    return rc, out.getvalue(), err.getvalue()


def report(num: int, desc: str, ok: bool, detail: str = "") -> None:
    print(f"{'ok' if ok else 'not ok'} {num} - {desc}", flush=True)
    if not ok and detail:
        for line in detail.splitlines():
            print(f"# {line}", flush=True)


