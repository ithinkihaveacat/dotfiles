fi

# Test 21: a WORD/ID gate is a valid typed gate that check never polls: it
# reports nothing for it and prints nothing about it.
(tg --root "$CHK_REPO" create alpha 'Wait for a ticket' --slug ticket \
  --wait-for ticket/7 --no-commit) >/dev/null 2>&1
if CHK_T21_OUT=$(AGENT_OFFLINE=0 PATH="$MOCK_BIN:$PATH" TASKGO_TODAY=2026-10-06 \
  tg --root "$CHK_REPO" check alpha 2>&1) &&
  [[ -z "$CHK_T21_OUT" ]] &&
  [[ "$(cat "$CHK_REPO"/alpha/tasks/*-ticket.md)" == *ticket/7* ]]; then
  echo 'ok 21 - a WORD/ID gate is accepted and left unpolled'
else
  echo 'not ok 21 - a WORD/ID gate is accepted and left unpolled'
  printf '# %s\n' "$CHK_T21_OUT"
fi

# ===========================================================================
# OKF-aligned reference checks (triage stale_after, doctor frontmatter/deprecated,
# and checkpoint large-Findings [INFO] hint)
# ===========================================================================

REF_REPO="$TEST_ROOT/ref-repo"
create_taskgo_repo "$REF_REPO" alpha
mkdir -p "$REF_REPO/alpha/references"
printf '%s\n' '---' 'status: draft' 'stale_after: 2026-10-01' '---' '' '# Price guide' \
  >"$REF_REPO/alpha/references/prices.md"
printf '%s\n' '---' 'status: deprecated' 'superseded_by: prices.md' 'stale_after: 2026-09-01' '---' '' '# Old guide' \
  >"$REF_REPO/alpha/references/old-guide.md"
printf '%s\n' '# Plain note' '' 'No frontmatter at all.' \
  >"$REF_REPO/alpha/references/plain.md"
git -C "$REF_REPO" add -A >/dev/null 2>&1
git -C "$REF_REPO" commit -qm 'chore(alpha): seed reference files'

# Test 22: triage surfaces stale reference files and skips deprecated references
REF_TRI_TXT=$(AGENT_OFFLINE=1 TASKGO_TODAY=2026-10-06 tg --root "$REF_REPO" triage alpha)
REF_TRI_JSON=$(AGENT_OFFLINE=1 TASKGO_TODAY=2026-10-06 tg --root "$REF_REPO" triage alpha --json)
if [[ "$REF_TRI_TXT" == *"Stale"* ]] &&
  [[ "$REF_TRI_TXT" == *"alpha/references/prices.md"* ]] &&
  [[ "$REF_TRI_TXT" != *"old-guide.md"* ]] &&
  [[ "$REF_TRI_TXT" != *"plain.md"* ]] &&
  [[ "$REF_TRI_JSON" == *'"kind": "reference"'* ]]; then
  echo 'ok 22 - triage surfaces stale references and skips deprecated or plain references'
else
  echo 'not ok 22 - triage surfaces stale references and skips deprecated or plain references'
  printf '# txt=%s\n# json=%s\n' "$REF_TRI_TXT" "$REF_TRI_JSON"
fi

# Test 23: doctor warns on malformed YAML frontmatter in references/ while allowing plain files
printf '%s\n' '---' 'status: [unclosed' '---' '' '# Broken' \
  >"$REF_REPO/alpha/references/broken.md"
set +e
REF_DOC_BAD=$(AGENT_OFFLINE=1 TASKGO_TODAY=2026-10-06 tg --root "$REF_REPO" doctor alpha 2>&1)
REF_DOC_BAD_RC=$?
set -e
rm -f "$REF_REPO/alpha/references/broken.md"
if [[ $REF_DOC_BAD_RC -ne 0 ]] &&
  [[ "$REF_DOC_BAD" == *"[WARN]  alpha/references/broken.md: invalid YAML frontmatter"* ]] &&
  [[ "$REF_DOC_BAD" != *"plain.md"* ]]; then
  echo 'ok 23 - doctor warns on malformed reference frontmatter and accepts plain files'
else
  echo 'not ok 23 - doctor warns on malformed reference frontmatter and accepts plain files'
  printf '# rc=%s out=%s\n' "$REF_DOC_BAD_RC" "$REF_DOC_BAD"
fi

# Test 24: doctor warns when README or an open task links to a deprecated reference
printf '\nSee [old guide](references/old-guide.md).\n' >>"$REF_REPO/alpha/README.md"
set +e
REF_DOC_DEP=$(AGENT_OFFLINE=1 TASKGO_TODAY=2026-10-06 tg --root "$REF_REPO" doctor alpha 2>&1)
REF_DOC_DEP_RC=$?
set -e
git -C "$REF_REPO" checkout -q -- alpha/README.md
if [[ $REF_DOC_DEP_RC -ne 0 ]] &&
  [[ "$REF_DOC_DEP" == *"[WARN]  alpha/README.md: links to deprecated reference 'alpha/references/old-guide.md' (superseded by prices.md)"* ]]; then
  echo 'ok 24 - doctor warns on links to deprecated reference files'
else
  echo 'not ok 24 - doctor warns on links to deprecated reference files'
  printf '# rc=%s out=%s\n' "$REF_DOC_DEP_RC" "$REF_DOC_DEP"
fi

# Test 25: checkpoint emits non-blocking [INFO] hint when closing a task with >=50 lines of unfolded Findings
BIG_FINDINGS=$(printf -- '- Finding line %s.\n' {1..55})
BIG_OUT=$(AGENT_OFFLINE=1 tg --root "$REF_REPO" create alpha 'Big findings task' --slug big-findings --goal 'Test hint' --no-commit)
BIG_ID="${BIG_OUT%%$'\t'*}"
AGENT_OFFLINE=1 tg --root "$REF_REPO" update "$BIG_ID" --status 'done' --outcome 'Done.' --findings "$BIG_FINDINGS" >/dev/null
if BIG_CP_ERR=$(AGENT_OFFLINE=1 tg --root "$REF_REPO" checkpoint "$BIG_ID" 'feat(alpha): close big findings task' 2>&1) &&
  [[ "$BIG_CP_ERR" == *"[INFO]"*"## Findings has 55 lines with no link to references/, decisions/, or --ref"* ]]; then
  echo 'ok 25 - checkpoint emits non-blocking [INFO] hint for large unfolded Findings on close'
else
  echo 'not ok 25 - checkpoint emits non-blocking [INFO] hint for large unfolded Findings on close'
  printf '# %s\n' "$BIG_CP_ERR"
fi
