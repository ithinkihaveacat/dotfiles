mkdir -p "$MOCK_BIN"

cat >"$MOCK_BIN/gh" <<'EOF'
#!/usr/bin/env bash
num="$3"
if [ "$num" = "77" ]; then
  printf '{"state":"CLOSED","updatedAt":"2026-10-01T09:00:00Z"}\n'
elif [ "$num" = "88" ]; then
  printf '{"state":"OPEN","updatedAt":"2026-10-05T15:00:00Z"}\n'
else
  exit 1
fi
EOF
chmod +x "$MOCK_BIN/gh"

