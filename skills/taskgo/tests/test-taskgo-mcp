import os
import shutil
import subprocess
import sys
from pathlib import Path

bin_ = Path(sys.argv[1]).resolve()
mcp_bin = Path(sys.argv[2]).resolve()
skill_dir = bin_.parent.parent
tmp = Path(sys.argv[3])
bin_dir = tmp / "bin"
bin_dir.mkdir(parents=True)

def run(exe: Path, *args: str, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    merged = {k: v for k, v in os.environ.items() if k != "TASKGO_SKILL_DIR"}
    if env:
        merged.update(env)
    return subprocess.run(
        [str(exe), *args],
        capture_output=True,
        text=True,
        env=merged,
        timeout=60,
        check=False,
    )

cli_link = bin_dir / "taskgo"
cli_link.symlink_to(bin_)
skill_link = tmp / "linked-skill"
skill_link.symlink_to(skill_dir)
for exe in (cli_link, skill_link / "scripts" / "taskgo"):
    res = run(exe, "mcp", "--help")
    assert res.returncode == 0 and "--fetch-ttl" in res.stdout, (exe, res.returncode, res.stderr)

srv_link = bin_dir / "taskgo-mcp"
srv_link.symlink_to(mcp_bin)
res = run(srv_link, "--help")
assert res.returncode == 0 and "--fetch-ttl" in res.stdout, (res.returncode, res.stderr)

copies = tmp / "copies"
copies.mkdir()
for src, name, args in ((bin_, "taskgo", ("mcp", "--help")), (mcp_bin, "taskgo-mcp", ("--help",))):
    copy = copies / name
    shutil.copy2(src, copy)
    res_bad = run(copy, *args)
