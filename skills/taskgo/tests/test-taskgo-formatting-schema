def t13() -> None:
    (sch_repo / "example/tasks/TASK-5C009-off-schema.md").write_text(
        "---\nid: TASK-5C009\nstatus: todo\nwait_for: [gh:owner/repo]\ncreated: 2026-10-01\n---\n\n# Off-schema task\n"
