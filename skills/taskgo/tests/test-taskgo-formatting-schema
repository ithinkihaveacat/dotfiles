# Machine and repository zones 26 hours apart are always on different days, so
# a wait_for date of the repository's today shows which zone decided.
TZ_REPO="$TEST_ROOT/tz-repo"
mkdir -p "$TZ_REPO/proj/tasks"
git -C "$TZ_REPO" init -q
cp "$REPO/AGENTS.md" "$TZ_REPO/AGENTS.md"
printf '# Inbox\n' >"$TZ_REPO/INBOX.md"
printf '# Project\n' >"$TZ_REPO/proj/README.md"
TZ_FAR_DAY=$(TZ=Pacific/Kiritimati date +%F)
TZ_NEAR_DAY=$(TZ=Etc/GMT+12 date +%F)
printf '%s\n' '---' 'id: TASK-7E101' 'status: todo' 'wait_for:' "  - $TZ_FAR_DAY" '---' '' \
  '# Wait for the far day' >"$TZ_REPO/proj/tasks/TASK-7E101-far-day.md"
tz_ready() {
  TZ=Etc/GMT+12 tg --root "$TZ_REPO" list proj --state ready | awk 'NR>1 {print $2}'
}
TZ_LOCAL=$(tz_ready)
printf '%s\n' '---' 'timezone: Pacific/Kiritimati' '---' '' '# Control repository' \
  >"$TZ_REPO/README.md"
TZ_REPO_ZONE=$(tz_ready)
TZ_OVERRIDE=$(TASKGO_TODAY="$TZ_NEAR_DAY" tz_ready)
if [[ -z $TZ_LOCAL && $TZ_REPO_ZONE == TASK-7E101 && -z $TZ_OVERRIDE ]]; then
  echo 'ok 16 - the repository timezone, not the machine, decides today'
else
  echo 'not ok 16 - the repository timezone, not the machine, decides today'
  printf '# local=%s repo=%s override=%s\n' "$TZ_LOCAL" "$TZ_REPO_ZONE" "$TZ_OVERRIDE"
fi

printf '%s\n' '---' 'timezone: Europe/Nowhere' '---' '' '# Control repository' \
  >"$TZ_REPO/README.md"
TZ_BAD_DR=$(TZ=Etc/GMT+12 tg --root "$TZ_REPO" doctor 2>&1) && TZ_BAD_RC=0 || TZ_BAD_RC=$?
if [[ $TZ_BAD_RC -ne 0 && $TZ_BAD_DR == *"unknown timezone 'Europe/Nowhere'"* && -z $(tz_ready) ]]; then
  echo 'ok 17 - doctor reports an unknown timezone and today falls back to local'
else
  echo 'not ok 17 - doctor reports an unknown timezone and today falls back to local'
  printf '# %s\n' "$TZ_BAD_DR"
fi

# An ignored nested checkout under a project belongs to another repository:
# the Markdown sweep skips it. Free-form documents (SWEPT.md) are the
# owner's to format; untracked records Git would add (README.md) are swept.
IGN_REPO="$TEST_ROOT/ignored-repo"
mkdir -p "$IGN_REPO/proj/tasks" "$IGN_REPO/proj/vendor/checkout"
git -C "$IGN_REPO" init -q
cp "$REPO/AGENTS.md" "$IGN_REPO/AGENTS.md"
printf '# Inbox\n' >"$IGN_REPO/INBOX.md"
printf '# Project\n\nTrailing   \n* item\n' >"$IGN_REPO/proj/README.md"
printf 'vendor/\n' >"$IGN_REPO/proj/.gitignore"
printf '# Ignored\n\nTrailing   \n* item\n' >"$IGN_REPO/proj/vendor/checkout/IGNORED.md"
printf '# Swept\n\nTrailing   \n* item\n' >"$IGN_REPO/proj/SWEPT.md"
tg --root "$IGN_REPO" sync proj >/dev/null 2>&1 || true
IGN_DR=$(tg --root "$IGN_REPO" doctor proj 2>&1) || true
IGN_FIX=$(tg --root "$IGN_REPO" fix proj --dry-run 2>&1) || true
if [[ $IGN_DR != *IGNORED.md* && $IGN_FIX != *IGNORED.md* &&
  $IGN_DR != *SWEPT.md* && $IGN_FIX != *SWEPT.md* &&
  $IGN_DR == *proj/README.md* && $IGN_FIX == *proj/README.md* ]]; then
  echo 'ok 18 - the Markdown sweep covers records, not ignored or free-form files'
else
  echo 'not ok 18 - the Markdown sweep covers records, not ignored or free-form files'
  printf '# doctor: %s\n# fix: %s\n' "$IGN_DR" "$IGN_FIX"
fi

# A done task keeps its contract sections and says how it met them in an
# Outcome; doctor notes done tasks whose Outcome is missing or empty.
oc_task() {
  printf '%s\n' '---' "id: $1" "status: $2" '---' '' "# Task $1" '' \
    '**Goal:** A goal.' '' '**Criteria:** A criterion.' "${@:3}" \
    >"$IGN_REPO/proj/tasks/$1-t.md"
}
oc_task TASK-0C001 "done" '' '## Outcome' '' 'Criterion met.'
oc_task TASK-0C002 "done" '' '## Outcome' '' '## Findings' '' 'Some.'
oc_task TASK-0C003 "done" '' '## Outcome & Commit' '' 'Shipped.'
oc_task TASK-0C004 todo
oc_task TASK-0C005 "done" '' '**Outcome:** Run-in.' '' '### Outcome' '' 'Subheading.'
tg --root "$IGN_REPO" sync proj >/dev/null 2>&1 || true
OC_DR=$(tg --root "$IGN_REPO" doctor proj 2>&1) || true
if [[ $OC_DR == *"TASK-0C002-t.md: done task has no ## Outcome text"* &&
  $OC_DR == *"TASK-0C003-t.md: done task has no ## Outcome text (similar: ## Outcome & Commit)"* &&
  $OC_DR == *"TASK-0C005-t.md: done task has no ## Outcome text (similar: **Outcome:**, ### Outcome)"* &&
  $OC_DR != *"TASK-0C001-t.md: done"* && $OC_DR != *"TASK-0C004-t.md: done"* &&
  $OC_DR != *"[WARN]"*"Outcome"* ]]; then
  echo 'ok 19 - doctor notes done tasks without Outcome text'
else
  echo 'not ok 19 - doctor notes done tasks without Outcome text'
  printf '# %s\n' "$OC_DR"
fi

# 'taskgo mcp' reads the committed tree only: the uncommitted status edit to
# TASK-7E001 above must not show.

# wait_for takes free text where no typed gate fits, kept whole, while a list
# of typed gates still splits and a malformed typed gate is refused.
GATE_REPO="$TEST_ROOT/gate-repo"
mkdir -p "$GATE_REPO/example/tasks"
git -C "$GATE_REPO" init -q
cp "$REPO/AGENTS.md" "$GATE_REPO/AGENTS.md"
printf '# Inbox\n' >"$GATE_REPO/INBOX.md"
printf '# Example\n' >"$GATE_REPO/example/README.md"
printf '%s\n' '---' 'id: TASK-6A001' 'status: todo' '---' '' '# Gate task' \
  >"$GATE_REPO/example/tasks/TASK-6A001-gate.md"
printf '%s\n' '---' 'id: TASK-6A002' 'status: todo' 'wait_for:' '  - 2026-13-01 or so' '---' '' '# Bad gate' \
  >"$GATE_REPO/example/tasks/TASK-6A002-bad.md"
printf '%s\n' '---' 'id: TASK-6A003' 'status: todo' 'wait_for:' "  - \"He said 'ok'\"" "  - '\"ship it\"'" \
  '---' '' '# Quoted gates' >"$GATE_REPO/example/tasks/TASK-6A003-quoted.md"
if GATE_ERR=$(
  "$TASKGO_PY" - "$BIN" "$GATE_REPO" 2>&1 <<'PY'
import contextlib
import importlib.machinery
import importlib.util
import io
import json
from pathlib import Path
import sys

loader = importlib.machinery.SourceFileLoader("taskgo_under_test", sys.argv[1])
tg = importlib.util.module_from_spec(
    importlib.util.spec_from_loader(loader.name, loader)
)
loader.exec_module(tg)
gate_repo = Path(sys.argv[2])
gate_task = gate_repo / "example/tasks/TASK-6A001-gate.md"
quoted_task = gate_repo / "example/tasks/TASK-6A003-quoted.md"


def run_tg(*argv: str) -> tuple[int, str, str]:
    tg._REPO_ROOT_CACHE = None
    tg._EXPLICIT_ROOT = None
    tg._ACTIVE_COMMAND = None
    tg._OFFLINE_FLAG = False
    out, err = io.StringIO(), io.StringIO()
    rc = 0
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            tg.main(list(argv))
        except SystemExit as exc:
            rc = exc.code if isinstance(exc.code, int) else (1 if exc.code else 0)
    return rc, out.getvalue(), err.getvalue()


rc, _, err = run_tg(
    "--root", str(gate_repo), "update", "TASK-6A001",
    "--add-wait-for", "ShellCheck release with SC2337, in shellcheck-py",
    "--add-wait-for", "issue/7,2026-01-02",
)
assert rc == 0, err
assert (
    "wait_for:\n  - ShellCheck release with SC2337, in shellcheck-py\n  - issue/7\n  - 2026-01-02\n"
    in gate_task.read_text()
), gate_task.read_text()

rc, out, err = run_tg(
    "--root", str(gate_repo), "update", "TASK-6A001", "--add-wait-for", "gh:owner/repo 82"
)
assert rc != 0 and "'gh:owner/repo' looks like a typed gate but is malformed" in (out + err)

rc, out, err = run_tg(
    "--root", str(gate_repo), "update", "TASK-6A001", "--add-wait-for", "TASK-6A002"
)
assert rc != 0 and "TASK-6A002 is a task; put it in blocked_by" in (out + err)

for gate, expected_err in (
    ("issue/7, gh:owner/repo 82", "'gh:owner/repo' looks like a typed gate"),
    (
        "gh:owner/repo#7 fixed upstream",
        "'gh:owner/repo#7' is a gate taskgo check resolves; give it as its own gate",
    ),
    ("   ", None),
    (".", None),
):
    rc, out, err = run_tg(
        "--root", str(gate_repo), "update", "TASK-6A001", "--add-wait-for", gate
    )
    assert rc != 0, f"accepted bad gate: {gate!r}"
    if expected_err is not None:
        assert expected_err in (out + err), (gate, out + err)

rc, _, err = run_tg(
    "--root", str(gate_repo), "update", "TASK-6A001",
    "--add-wait-for", "2026-11 release train",
    "--add-wait-for", 'He said "ship it"',
    "--add-wait-for", "@vendor engineer visit",
)
assert rc == 0, err
assert (
    "  - 2026-11 release train\n  - He said \"ship it\"\n  - '@vendor engineer visit'\n"
    in gate_task.read_text()
), gate_task.read_text()

rc, list_out, err = run_tg("--root", str(gate_repo), "list", "example", "--json")
assert rc == 0, err
rows = json.loads(list_out)
quoted_row = next(r for r in rows if r["id"] == "TASK-6A003")
assert quoted_row["wait_for"] == ["He said 'ok'", '"ship it"'], quoted_row

rc, _, err = run_tg(
    "--root", str(gate_repo), "update", "TASK-6A003", "--add-wait-for", "'agent quoted this'"
)
assert rc == 0, err
assert "  - agent quoted this\n" in quoted_task.read_text(), quoted_task.read_text()

rc, ready_out, err = run_tg("--root", str(gate_repo), "list", "example", "--state", "ready")
assert rc == 0 and "TASK-6A001" not in ready_out, (ready_out, err)

rc, dr_out, dr_err = run_tg("--root", str(gate_repo), "doctor", "example")
dr = dr_out + dr_err
assert "TASK-6A002-bad.md: invalid wait_for '2026-13-01 or so' ('2026-13-01' looks like a typed gate" in dr, dr
assert "TASK-6A001-gate.md: invalid wait_for" not in dr, dr
assert "TASK-6A003-quoted.md: invalid wait_for" not in dr, dr
PY
); then
  echo 'ok 20 - wait_for keeps free text whole and refuses malformed typed gates'
else
  echo 'not ok 20 - wait_for keeps free text whole and refuses malformed typed gates'
  printf '# %s\n' "$GATE_ERR"
fi
