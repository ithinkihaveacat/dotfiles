for num, desc, fn in (
    (3, "update replaces a reflowed run-in and keeps the next one", t3),
    (4, "update matches section headings exactly and reports similar ones", t4),
    (5, "update refuses an ambiguous run-in", t5),
    (6, "schema --json describes kinds, set fields, and value types", t6),
    (7, "update --expect-status refuses a mismatch and accepts aliases", t7),
