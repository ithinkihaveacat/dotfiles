#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=skills/taskgo/tests/common.sh disable=SC1091
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
taskgo_test_init

echo "1..20"

REPO="$TEST_ROOT/repo"
init_base_repo "$REPO"

# Test 148: Markdown formatting findings are not hidden when the control
# repository itself lives under a dot-directory (such as ~/.projects).
FMT_REPO="$TEST_ROOT/.hidden/fmtrepo"
mkdir -p "$FMT_REPO/alpha/tasks" "$FMT_REPO/beta"
git -C "$FMT_REPO" init -q
cp "$REPO/AGENTS.md" "$FMT_REPO/AGENTS.md"
printf '# Inbox\n' >"$FMT_REPO/INBOX.md"
printf '# Alpha\n\n* untidy   bullet\n' >"$FMT_REPO/alpha/README.md"
printf '# Beta\n' >"$FMT_REPO/beta/README.md"
printf '# Notes\n\n* untidy   bullet\n' >"$FMT_REPO/alpha/NOTES.md"
printf '# Notes\n\n* untidy   bullet\n' >"$FMT_REPO/beta/NOTES.md"
(tg --root "$FMT_REPO" sync) >/dev/null 2>&1
git -C "$FMT_REPO" add -A >/dev/null 2>&1
git -C "$FMT_REPO" commit -qm 'seed'
FMT_DOCTOR=$(tg --root "$FMT_REPO" doctor 2>&1 || true)
FMT_DRY=$(tg --root "$FMT_REPO" fix --dry-run 2>/dev/null || true)
# Only records are swept: NOTES.md is a free-form document, left alone.
if grep -q 'alpha/README.md: markdown formatting needed' <<<"$FMT_DOCTOR" &&
  grep -qx 'alpha/README.md' <<<"$FMT_DRY" &&
  [[ $FMT_DOCTOR != *NOTES.md* && $FMT_DRY != *NOTES.md* ]]; then
  echo 'ok 1 - doctor and fix agree on formatting under a dot-directory root'
else
  echo 'not ok 1 - doctor and fix agree on formatting under a dot-directory root'
  printf '# doctor: %s\n# fix: %s\n' "$FMT_DOCTOR" "$FMT_DRY"
fi

# Test 149: Writes format the files they touch and leave others unchanged.
(tg --root "$FMT_REPO" create alpha 'Format   on write' \
  --slug fmt --goal 'A   goal that is * written untidily' --no-commit) >/dev/null 2>&1
FMT_TASK=$(ls "$FMT_REPO"/alpha/tasks/TASK-*-fmt.md)
(tg --root "$FMT_REPO" update "$(basename "$FMT_TASK" | cut -c1-10)" \
  --criteria 'Untidy   criteria   text') >/dev/null 2>&1
(tg --root "$FMT_REPO" create gamma 'New project task' --no-commit) >/dev/null 2>&1
FMT_CHANGED=$(git -C "$FMT_REPO" status --porcelain | awk '{print $2}' | sort | tr '\n' ' ')
FMT_OK=1
mdfmt --check "$FMT_TASK" "$FMT_REPO"/alpha/STATUS.md \
  "$FMT_REPO"/gamma/*.md "$FMT_REPO"/gamma/tasks/*.md >/dev/null 2>&1 || FMT_OK=0
if [ "$FMT_OK" = 1 ] &&
  [ "$FMT_CHANGED" = "alpha/STATUS.md alpha/tasks/ gamma/ " ] &&
  git -C "$FMT_REPO" diff --quiet -- alpha/NOTES.md beta/NOTES.md; then
  echo 'ok 2 - writes format touched files only'
else
  echo "not ok 2 - writes format touched files only ($FMT_CHANGED)"
fi

# Tests 151-154: run-in and section edits change only the addressed field.
MATCH_REPO="$TEST_ROOT/match-repo"
mkdir -p "$MATCH_REPO/example/tasks"
git -C "$MATCH_REPO" init -q
printf '# Example\n' >"$MATCH_REPO/example/README.md"
printf '%s\n' \
  '---' 'id: TASK-0A001' 'status: todo' '---' '' '# Reflowed run-ins' '' \
  '**Problem:** Old problem. **Cost:** Old cost. **Goal:** Old goal.' \
  '**Criteria:** Old criteria.' \
  >"$MATCH_REPO/example/tasks/TASK-0A001-reflowed.md"
printf '%s\n' \
  '---' 'id: TASK-0A002' 'status: done' '---' '' '# Similar heading' '' \
  '## Outcome & Commit' '' '- **Cost:** Kept list item.' '' \
  '## Findings' '' 'Kept findings.' \
  >"$MATCH_REPO/example/tasks/TASK-0A002-similar.md"
printf '%s\n' \
  '---' 'id: TASK-0A003' 'status: todo' '---' '' '# Duplicate goal' '' \
  '**Goal:** First.' '' '**Goal:** Second.' \
  >"$MATCH_REPO/example/tasks/TASK-0A003-duplicate.md"
SCH_REPO="$TEST_ROOT/schema-repo"
create_taskgo_repo "$SCH_REPO" example
for n in 1 2 3; do
  printf '%s\n' '---' "id: TASK-5C00$n" 'status: todo' '---' '' "# Schema task $n" \
    >"$SCH_REPO/example/tasks/TASK-5C00$n-schema-$n.md"
done
tg --root "$SCH_REPO" sync example >/dev/null 2>&1
git -C "$SCH_REPO" add -A >/dev/null 2>&1
git -C "$SCH_REPO" commit -qm 'seed schema fixtures'

"$TASKGO_PY" - "$BIN" "$MATCH_REPO" "$SCH_REPO" <<'PY'
import contextlib
import importlib.machinery
import importlib.util
import io
from pathlib import Path
import re
import sys

loader = importlib.machinery.SourceFileLoader("taskgo_under_test", sys.argv[1])
tg = importlib.util.module_from_spec(
    importlib.util.spec_from_loader(loader.name, loader)
)
loader.exec_module(tg)
match_repo = Path(sys.argv[2])
sch_repo = Path(sys.argv[3])


def run_tg(*argv: str) -> tuple[int, str, str]:
    tg._REPO_ROOT_CACHE = None
    tg._EXPLICIT_ROOT = None
    tg._ACTIVE_COMMAND = None
    tg._OFFLINE_FLAG = False
    out, err = io.StringIO(), io.StringIO()
    rc = 0
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            tg.main(list(argv))
        except SystemExit as exc:
            rc = exc.code if isinstance(exc.code, int) else (1 if exc.code else 0)
    return rc, out.getvalue(), err.getvalue()


def run_step(num: int, desc: str, fn) -> None:
    try:
        fn()
        print(f"ok {num} - {desc}", flush=True)
    except Exception as exc:
        print(f"not ok {num} - {desc}", flush=True)
        for line in f"{type(exc).__name__}: {exc}".splitlines():
            print(f"# {line}", flush=True)


match_a = match_repo / "example/tasks/TASK-0A001-reflowed.md"
match_b = match_repo / "example/tasks/TASK-0A002-similar.md"
match_c = match_repo / "example/tasks/TASK-0A003-duplicate.md"


def t3() -> None:
    rc, _, err = run_tg(
        "--root", str(match_repo), "update",
        "example/tasks/TASK-0A001-reflowed.md", "--goal", "New goal.",
    )
    txt = match_a.read_text()
    assert rc == 0, err
    assert "**Problem:** Old problem. **Cost:** Old cost." in txt
    assert "\n\n**Goal:** New goal.\n\n**Criteria:** Old criteria." in txt
    assert "Old goal" not in txt


def t4() -> None:
    rc, _, err = run_tg(
        "--root", str(match_repo), "update",
        "example/tasks/TASK-0A002-similar.md", "--outcome", "New outcome.",
    )
    txt = match_b.read_text()
    assert rc == 0, err
    assert "## Outcome & Commit\n\n- **Cost:** Kept list item." in txt
    assert "## Outcome\n\nNew outcome." in txt
    assert "similar: ## Outcome & Commit" in err, err


def t5() -> None:
    before = match_c.read_text()
    rc, out, err = run_tg(
        "--root", str(match_repo), "update",
        "example/tasks/TASK-0A003-duplicate.md", "--goal", "Third.",
    )
    assert rc != 0 and "appears 2 times" in (out + err), (rc, out, err)
    assert match_c.read_text() == before


sch_1 = sch_repo / "example/tasks/TASK-5C001-schema-1.md"
sch_2 = sch_repo / "example/tasks/TASK-5C002-schema-2.md"


def t6() -> None:
    rc, out, err = run_tg("schema", "--json")
    assert rc == 0, err
    kinds = re.findall(r'"kind": "[a-z]*"', out)
    assert kinds == ['"kind": "task"', '"kind": "decision"', '"kind": "status"'], kinds
    set_names = re.findall(r'"name": "([a-z_]*)",\s*"shape": "set"', out)
    assert set_names == ["blocked_by", "wait_for", "conversations", "supersedes"], set_names
    assert '"in-progress"' in out


def t7() -> None:
    before = sch_1.read_text()
    rc, out, err = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C001",
        "--expect-status", "done", "--status", "cancelled",
    )
    assert rc != 0 and "status is 'todo', expected 'done'; nothing changed" in (out + err)
    assert sch_1.read_text() == before
    rc2, _, err2 = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C001",
        "--expect-status", "open", "--status", "wip",
    )
    assert rc2 == 0, err2
    assert "\nstatus: in-progress\n" in sch_1.read_text()


def t8() -> None:
    before = sch_1.read_text()
    rc, out, err = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C001", "--status", "finished"
    )
    assert rc != 0 and "unknown status for --status: finished" in (out + err)
    assert sch_1.read_text() == before


def t9() -> None:
    rc, _, err = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C001",
        "--add-blocked-by", "TASK-5C002", "--add-blocked-by", "task-5c003",
    )
    assert rc == 0, err
    lines = sch_1.read_text().splitlines()
    assert lines[3] == "blocked_by: [TASK-5C002, TASK-5C003]", lines
    rc2, _, err2 = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C001",
        "--add-blocked-by", "TASK-5C002", "--remove-blocked-by", "TASK-5C003",
    )
    assert rc2 == 0, err2
    assert "\nblocked_by: [TASK-5C002]\n" in sch_1.read_text()
    rc3, _, err3 = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C001",
        "--remove-blocked-by", "TASK-5C002",
    )
    assert rc3 == 0, err3
    assert "blocked_by" not in sch_1.read_text()


def t10() -> None:
    rc, _, err = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C001",
        "--add-blocked-by", "TASK-5C002",
    )
    assert rc == 0, err
    before = sch_2.read_text()
    rc1, out1, err1 = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C002",
        "--add-blocked-by", "TASK-5C001",
    )
    assert rc1 != 0 and "blocked_by would form a cycle" in (out1 + err1)
    for bad in ("TASK-FFFFF", "TASK-5C002", "not-a-task"):
        rc_b, _, _ = run_tg(
            "--root", str(sch_repo), "update", "TASK-5C002", "--add-blocked-by", bad
        )
        assert rc_b != 0, bad
    assert sch_2.read_text() == before


def t11() -> None:
    rc1, _, err1 = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C002",
        "--add-wait-for", "2026-10-13", "--add-wait-for", "issue/123",
        "--add-conversation", "claude://0123456789abcdef0123",
        "--add-conversation", "codex://fedcba9876543210fedc",
    )
    assert rc1 == 0, err1
    rc2, _, err2 = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C002",
        "--remove-wait-for", "2026-10-13",
        "--remove-conversation", "claude://0123456789abcdef0123",
    )
    assert rc2 == 0, err2
    txt = sch_2.read_text()
    assert "wait_for:\n  - issue/123\n" in txt
    assert "conversations:\n  - codex://fedcba9876543210fedc\n" in txt
    assert "2026-10-13" not in txt and "claude://" not in txt
    rc3, _, _ = run_tg(
        "--root", str(sch_repo), "update", "TASK-5C002",
        "--add-wait-for", "gh:owner/repo 82",
