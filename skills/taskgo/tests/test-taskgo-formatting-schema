    assert rc3 != 0


def t12() -> None:
    rc1, out1, err1 = run_tg(
        "--root", str(sch_repo), "create", "example", "Blocked at birth",
        "--slug", "born-blocked", "--add-blocked-by", "TASK-5C001",
        "--add-wait-for", "@someone",
        "--add-conversation", "claude://0123456789abcdef0123", "--no-commit",
    )
    assert rc1 == 0, err1
