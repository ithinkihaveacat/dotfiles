def run_tg(*argv: str, env_over: dict[str, str] | None = None) -> tuple[int, str, str]:
    tg._REPO_ROOT_CACHE = None
    tg._EXPLICIT_ROOT = None
    tg._ACTIVE_COMMAND = None
    tg._OFFLINE_FLAG = False
    saved = {}
    if env_over:
        for k, v in env_over.items():
            saved[k] = os.environ.get(k)
            os.environ[k] = v
    out, err = io.StringIO(), io.StringIO()
    rc = 0
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            try:
                tg.main(list(argv))
            except SystemExit as exc:
                rc = exc.code if isinstance(exc.code, int) else (1 if exc.code else 0)
    finally:
        for k, prev in saved.items():
            if prev is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = prev
    return rc, out.getvalue(), err.getvalue()


def run_cli(*args: str) -> subprocess.CompletedProcess[str]:
