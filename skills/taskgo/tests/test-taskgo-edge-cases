#!/bin/sh
trap 'exit 143' TERM
trap 'exit 130' INT
sleep 30
EOF
chmod +x "$TEST_ROOT/mock-bin/git"

python3 -c '
import sys, os, signal, subprocess, time
repo, bin_path, mock_bin = sys.argv[1:4]
env = os.environ.copy()
env["PATH"] = mock_bin + ":" + env.get("PATH", "")

def run_test(sig, expected, test_num, desc):
    p = subprocess.Popen([bin_path, "--root", repo, "create", "proj", f"Slow task {test_num}"], cwd=repo, env=env, stderr=subprocess.PIPE, text=True, start_new_session=True)
    time.sleep(0.8)
    os.killpg(os.getpgid(p.pid), sig)
    _, err = p.communicate(timeout=5)
    if p.returncode == expected and "TimeoutExpired" not in err and "Traceback" not in err:
        print(f"ok {test_num} - {desc}")
    else:
        print(f"not ok {test_num} - {desc} (exit code {p.returncode})")
        if err:
            for line in err.splitlines():
                print(f"# {line}")

run_test(signal.SIGTERM, 143, 1, "SIGTERM gracefully terminates subprocesses with exit code 143 and no traceback")
run_test(signal.SIGINT, 130, 2, "SIGINT exits with code 130 and no traceback")
