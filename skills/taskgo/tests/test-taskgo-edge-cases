import sys, os, signal, subprocess, time
repo, bin_path, mock_bin = sys.argv[1:4]
env = os.environ.copy()
env["PATH"] = mock_bin + ":" + env.get("PATH", "")
marker = os.path.join(mock_bin, "started")

def run_test(sig, expected, test_num, desc):
    try:
        os.unlink(marker)
    except FileNotFoundError:
        pass
    env["MOCK_GIT_MARKER"] = marker
    p = subprocess.Popen([sys.executable, bin_path, "--root", repo, "create", "proj", f"Slow task {test_num}"], cwd=repo, env=env, stderr=subprocess.PIPE, text=True, start_new_session=True)
    # Signal only once the process is past argument parsing and has installed
    # its handlers: its first Git call writes the marker. A fixed sleep is not
    # enough when several test files share the machine.
    deadline = time.monotonic() + 10
    while not os.path.exists(marker) and p.poll() is None and time.monotonic() < deadline:
        time.sleep(0.02)
    os.killpg(os.getpgid(p.pid), sig)
    _, err = p.communicate(timeout=5)
    if p.returncode == expected and "TimeoutExpired" not in err and "Traceback" not in err:
        print(f"ok {test_num} - {desc}")
    else:
        print(f"not ok {test_num} - {desc} (exit code {p.returncode})")
        if err:
            for line in err.splitlines():
                print(f"# {line}")

run_test(signal.SIGTERM, 143, 1, "SIGTERM gracefully terminates subprocesses with exit code 143 and no traceback")
run_test(signal.SIGINT, 130, 2, "SIGINT exits with code 130 and no traceback")
