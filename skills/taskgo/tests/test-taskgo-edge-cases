def run_tg(*argv: str, cwd: Path | None = None) -> tuple[int, str, str]:
    tg._REPO_ROOT_CACHE = None
    tg._EXPLICIT_ROOT = None
    tg._ACTIVE_COMMAND = None
    tg._OFFLINE_FLAG = False
    prev_cwd = Path.cwd()
    out, err = io.StringIO(), io.StringIO()
    rc = 0
    try:
        if cwd is not None:
            os.chdir(cwd)
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            try:
                tg.main(list(argv))
            except SystemExit as exc:
                rc = exc.code if isinstance(exc.code, int) else (1 if exc.code else 0)
    finally:
        if cwd is not None:
            os.chdir(prev_cwd)
    return rc, out.getvalue(), err.getvalue()


def run_cli(*args: str, env_over: dict[str, str] | None = None, cwd: Path | None = None, direct_bin: bool = False) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    if env_over:
        env.update(env_over)
    cmd = [bin_path, *args] if direct_bin else [sys.executable, bin_path, *args]
    return subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True, check=False)


def git(target: Path, *args: str) -> str:
    return subprocess.run(
        ["git", "-C", str(target), *args], capture_output=True, text=True, check=True
    ).stdout


def make_repo(name: str, *projects: str, files: dict[str, str] | None = None, commit_msg: str | None = None) -> Path:
    p = test_root / name
    p.mkdir(parents=True, exist_ok=True)
    git(p, "init", "-q", "-b", "main")
    (p / "AGENTS.md").write_text(AGENTS)
    (p / "INBOX.md").write_text("# Inbox\n")
    for proj in projects:
        (p / proj / "tasks").mkdir(parents=True, exist_ok=True)
        (p / proj / "README.md").write_text(f"# {proj}\n")
    if files:
        for rel, txt in files.items():
            full = p / rel
            full.parent.mkdir(parents=True, exist_ok=True)
            full.write_text(txt)
    if commit_msg:
        git(p, "add", "-A")
        git(p, "commit", "-qm", commit_msg)
    return p


