#!/usr/bin/env bash
set -euo pipefail

# Color styling is asserted explicitly per test; isolate from inherited
# NO_COLOR/FORCE_COLOR.
unset NO_COLOR FORCE_COLOR

# Isolate test suite from ambient agent runtime variables.
unset AI_AGENT INVOKER_INFO_NAME
unset JETSKI_CONVERSATION_ID ANTIGRAVITY_CONVERSATION_ID ANTIGRAVITY_SESSION
unset CLAUDE_CODE_SESSION_ID CLAUDE_CODE_REMOTE_SESSION_ID CLAUDE_SESSION_ID CLAUDE_PROJECT_ID
unset OPENCODE_SESSION_ID CODEX_SESSION_ID
unset INVOKER_INFO_ROOT_SESSION_ID CONVERSATION_ID

export GIT_AUTHOR_NAME="Taskgo Test"
export GIT_AUTHOR_EMAIL="taskgo@example.com"
export GIT_COMMITTER_NAME="Taskgo Test"
export GIT_COMMITTER_EMAIL="taskgo@example.com"

TEST_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$TEST_DIR/../scripts/taskgo"
# shellcheck disable=SC2034
MARKDOWN_FORMAT="$TEST_DIR/../../coding-standards/scripts/markdown-format"
TEST_ROOT="$(mktemp -d)"
trap 'rm -rf -- "$TEST_ROOT"' EXIT
export TASKGO_MCP_LOG="$TEST_ROOT/mcp-requests.jsonl"

echo "1..23"

init_base_repo() {
  local target="${1:-$TEST_ROOT/repo}"
  mkdir -p "$target/example/tasks"
  git -C "$target" init -q
  printf '%s
' '# Agent instructions' '' 'This repository follows taskgo:' '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' >"$target/AGENTS.md"
  printf '# Inbox
' >"$target/INBOX.md"
  printf '# Example project
' >"$target/example/PROJECT.md"
  printf '# Plan
' >"$target/example/PLAN.md"
  printf '%s
' '---' 'id: TASK-A1B2C' 'status: todo' '---' '' '# Confirm generated status formatting' >"$target/example/tasks/TASK-A1B2C-confirm-status.md"
}

REPO="$TEST_ROOT/repo"
init_base_repo "$REPO"

MCP_PY=$(uv sync -q --script "$BIN" </dev/null && uv python find --script "$BIN")
# shellcheck disable=SC2034
APPLY_PY="$MCP_PY"

REPO="$TEST_ROOT/repo"
mkdir -p "$REPO/example/tasks"
git -C "$REPO" init -q

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  >"$REPO/AGENTS.md"
printf '# Inbox\n' >"$REPO/INBOX.md"
printf '# Example project\n' >"$REPO/example/PROJECT.md"
printf '# Plan\n' >"$REPO/example/PLAN.md"
printf '%s\n' \
  '---' \
  'id: TASK-A1B2C' \
  'status: todo' \
  '---' \
  '' \
  '# Confirm generated status formatting' \
  >"$REPO/example/tasks/TASK-A1B2C-confirm-status.md"

if ("$BIN" --root "$REPO" sync example) &&
  "$MARKDOWN_FORMAT" --check "$REPO/example/STATUS.md" >/dev/null; then
  echo 'ok 1 - sync emits canonical Markdown'
else
  echo 'not ok 1 - sync output needs Markdown formatting'
fi

if ("$BIN" --root "$REPO" doctor example) >/dev/null 2>&1; then
  echo 'ok 2 - doctor accepts canonical generated status'
else
  echo 'not ok 2 - doctor rejects canonical generated status'
fi

sed -i.bak '/taskgo/d' "$REPO/AGENTS.md"
if ! declaration_out=$("$BIN" --root "$REPO" doctor example 2>&1) &&
  printf '%s\n' "$declaration_out" |
  grep -q '^\[WARN\]  AGENTS.md: must state'; then
  echo 'ok 3 - doctor requires a taskgo declaration'
else
  echo 'not ok 3 - doctor accepts a missing taskgo declaration'
fi

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo.' \
  >"$REPO/AGENTS.md"
if ! url_out=$("$BIN" --root "$REPO" doctor example 2>&1) &&
  printf '%s\n' "$url_out" |
  grep -q '^\[WARN\]  AGENTS.md: missing canonical taskgo URL:'; then
  echo 'ok 4 - doctor requires the canonical taskgo URL'
else
  echo 'not ok 4 - doctor accepts a missing canonical taskgo URL'
fi

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  >"$REPO/AGENTS.md"
sed -i.bak 's/status: todo/status: in-progress/' \
  "$REPO/example/tasks/TASK-A1B2C-confirm-status.md"
("$BIN" --root "$REPO" sync example) >/dev/null
awk '
  { print }
  $0 == "## Summary" {
    print ""
    print "There is no task currently in progress."
  }
' "$REPO/example/STATUS.md" >"$REPO/example/STATUS.md.tmp"
mv "$REPO/example/STATUS.md.tmp" "$REPO/example/STATUS.md"
if ! contradiction_out=$("$BIN" --root "$REPO" doctor example 2>&1) &&
  printf '%s\n' "$contradiction_out" |
  grep -q '^\[WARN\]  example: STATUS prose says no task is in progress'; then
  echo 'ok 5 - doctor detects contradictory STATUS prose'
else
  echo 'not ok 5 - doctor accepts contradictory STATUS prose'
fi

sed -i.bak '/There is no task currently in progress\./d' \
  "$REPO/example/STATUS.md"
sed -i.bak 's/status: in-progress/status: done/' \
  "$REPO/example/tasks/TASK-A1B2C-confirm-status.md"
if ! ("$BIN" --root "$REPO" doctor example) >/dev/null 2>&1; then
  echo 'ok 6 - doctor still detects task snapshot drift'
else
  echo 'not ok 6 - doctor missed task snapshot drift'
fi

CHECKPOINT_REPO="$TEST_ROOT/checkpoint-repo"
mkdir -p "$CHECKPOINT_REPO/example/tasks"
git -C "$CHECKPOINT_REPO" init -q
git -C "$CHECKPOINT_REPO" config user.name 'Taskgo Test'
git -C "$CHECKPOINT_REPO" config user.email 'taskgo@example.invalid'

printf '# Agent instructions\n' >"$CHECKPOINT_REPO/AGENTS.md"
printf '# Inbox\n' >"$CHECKPOINT_REPO/INBOX.md"
printf '# Example project\n' >"$CHECKPOINT_REPO/example/PROJECT.md"
printf '# Plan\n' >"$CHECKPOINT_REPO/example/PLAN.md"
printf '%s\n' \
  '---' \
  'id: TASK-B2C3D' \
  'status: todo' \
  '---' \
  '' \
  '# Exercise guarded checkpoints' \
  >"$CHECKPOINT_REPO/example/tasks/TASK-B2C3D-checkpoints.md"
("$BIN" --root "$CHECKPOINT_REPO" sync example) >/dev/null
git -C "$CHECKPOINT_REPO" add .
git -C "$CHECKPOINT_REPO" commit -qm 'test: initialize tracker'

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  >"$CHECKPOINT_REPO/AGENTS.md"

CHECKPOINT_TASK="$CHECKPOINT_REPO/example/tasks/TASK-B2C3D-checkpoints.md"
start_checkpoint() {
  sed 's/status: todo/status: in-progress/' "$CHECKPOINT_TASK" \
    >"$CHECKPOINT_TASK.tmp"
  mv "$CHECKPOINT_TASK.tmp" "$CHECKPOINT_TASK"
}

start_checkpoint
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test') >/dev/null 2>&1; then
  echo 'ok 7 - checkpoint requires committed authorization'
else
  echo 'not ok 7 - checkpoint accepts missing authorization'
fi
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md

("$BIN" --root "$CHECKPOINT_REPO" fix --no-commit) >/dev/null 2>&1
git -C "$CHECKPOINT_REPO" add AGENTS.md
git -C "$CHECKPOINT_REPO" commit -qm 'test: authorize checkpoints'

start_checkpoint
git -C "$CHECKPOINT_REPO" add example/tasks/TASK-B2C3D-checkpoints.md
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test') >/dev/null 2>&1; then
  echo 'ok 8 - checkpoint refuses a non-empty index'
else
  echo 'not ok 8 - checkpoint accepts a non-empty index'
fi
git -C "$CHECKPOINT_REPO" restore --staged example/tasks/TASK-B2C3D-checkpoints.md
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md

start_checkpoint
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test' \
  --path INBOX.md) >/dev/null 2>&1; then
  echo 'ok 9 - checkpoint rejects paths outside the task project'
else
  echo 'not ok 9 - checkpoint accepts a path outside the task project'
fi
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md

start_checkpoint
printf '\nStart with a guarded checkpoint.\n' \
  >>"$CHECKPOINT_REPO/example/PLAN.md"
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test') >/dev/null 2>&1; then
  echo 'ok 10 - checkpoint refuses unlisted project changes'
else
  echo 'not ok 10 - checkpoint accepts unlisted project changes'
fi
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md
git -C "$CHECKPOINT_REPO" restore example/PLAN.md

start_checkpoint
printf '\nStart with a guarded checkpoint.\n' \
  >>"$CHECKPOINT_REPO/example/PLAN.md"
printf '\nUnrelated root note.\n' >>"$CHECKPOINT_REPO/INBOX.md"
if ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test' \
  --path example/PLAN.md --ref artifact@abc123) >/dev/null 2>&1 &&
  git -C "$CHECKPOINT_REPO" diff --quiet -- example &&
  ! git -C "$CHECKPOINT_REPO" diff --quiet -- INBOX.md &&
  [[ "$(git -C "$CHECKPOINT_REPO" log -1 --format=%s)" == 'chore(example): start checkpoint test' ]] &&
  git -C "$CHECKPOINT_REPO" log -1 --format=%B | grep -q '^Ref: artifact@abc123$' &&
  grep -q 'TASK-B2C3D.*Exercise guarded checkpoints' \
    "$CHECKPOINT_REPO/example/STATUS.md" &&
  ("$BIN" --root "$CHECKPOINT_REPO" history TASK-B2C3D) |
  grep -q 'todo -> in-progress'; then
  echo 'ok 11 - checkpoint commits only the validated project transition'
else
  echo 'not ok 11 - checkpoint did not preserve its safety boundary'
fi

if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint example/tasks/TASK-B2C3D-checkpoints.md \
  'example: reject path target') >/dev/null 2>&1; then
  echo 'ok 12 - checkpoint requires a task ID target'
else
  echo 'not ok 12 - checkpoint accepts a path target'
fi

sed '/taskgo/d' "$CHECKPOINT_REPO/AGENTS.md" \
  >"$CHECKPOINT_REPO/AGENTS.md.tmp"
mv "$CHECKPOINT_REPO/AGENTS.md.tmp" "$CHECKPOINT_REPO/AGENTS.md"
sed 's/status: done/status: todo/' "$CHECKPOINT_TASK" \
  >"$CHECKPOINT_TASK.tmp"
mv "$CHECKPOINT_TASK.tmp" "$CHECKPOINT_TASK"
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: revoked checkpoint') >/dev/null 2>&1; then
  echo 'ok 13 - an uncommitted declaration removal revokes authorization'
else
  echo 'not ok 13 - checkpoint ignores a working-tree revocation'
fi

# ===========================================================================
# Default remote sync (fetch/rebase/push, autostash rollback, and --offline)
# ===========================================================================

# The remote is a local bare repository, so these cases need no network. They
# enable sync even when CI exports AGENT_OFFLINE=1; case 19 sets it per command.
export AGENT_OFFLINE=0

SYNC_REMOTE="$TEST_ROOT/sync-remote.git"
SYNC_PEER="$TEST_ROOT/sync-peer"
SYNC_LOCAL="$TEST_ROOT/sync-local"
git init -q --bare "$SYNC_REMOTE"
init_base_repo "$SYNC_PEER"
git -C "$SYNC_PEER" config user.name 'Taskgo Test'
git -C "$SYNC_PEER" config user.email 'taskgo@example.com'
("$BIN" --root "$SYNC_PEER" sync example) >/dev/null
git -C "$SYNC_PEER" branch -M main
git -C "$SYNC_PEER" remote add origin "$SYNC_REMOTE"
git -C "$SYNC_PEER" add .
git -C "$SYNC_PEER" commit -qm 'chore: seed remote'
git -C "$SYNC_PEER" push -q -u origin main
git --git-dir="$SYNC_REMOTE" symbolic-ref HEAD refs/heads/main

git clone -q "$SYNC_REMOTE" "$SYNC_LOCAL"
git -C "$SYNC_LOCAL" config user.name 'Taskgo Test'
git -C "$SYNC_LOCAL" config user.email 'taskgo@example.com'

# 14: CLI read (list/status) fetches and fast-forwards when remote advances
PEER_CREATED=$("$BIN" --root "$SYNC_PEER" create example 'Remote task from peer' --slug peer-task)
PEER_ID="${PEER_CREATED%%$'\t'*}"
if ("$BIN" --root "$SYNC_LOCAL" list example) | grep -q "$PEER_ID" &&
  [[ "$(git -C "$SYNC_LOCAL" rev-parse HEAD)" == "$(git --git-dir="$SYNC_REMOTE" rev-parse main)" ]]; then
  echo 'ok 14 - CLI read fetches and fast-forwards when remote advances'
else
  echo 'not ok 14 - CLI read did not pull remote commit'
fi

# 15: Pre-sync preserves non-conflicting dirty working-tree edits across rebase (ahead > 0)
printf '\nLocal committed note.\n' >>"$SYNC_LOCAL/INBOX.md"
git -C "$SYNC_LOCAL" add INBOX.md
git -C "$SYNC_LOCAL" commit -qm 'docs: local ahead commit'
printf '\nLocal draft note.\n' >>"$SYNC_LOCAL/example/PLAN.md"
PEER_CREATED2=$("$BIN" --root "$SYNC_PEER" create example 'Second remote task' --slug peer-two)
PEER_ID2="${PEER_CREATED2%%$'\t'*}"
if ("$BIN" --root "$SYNC_LOCAL" status example) >/dev/null &&
  ("$BIN" --root "$SYNC_LOCAL" --offline list example) | grep -q "$PEER_ID2" &&
  grep -q 'Local draft note.' "$SYNC_LOCAL/example/PLAN.md" &&
  grep -q 'Local committed note.' "$SYNC_LOCAL/INBOX.md"; then
  echo 'ok 15 - pre-sync preserves non-conflicting dirty working-tree edits'
else
  echo 'not ok 15 - pre-sync lost dirty working-tree edits or failed to pull'
fi
git -C "$SYNC_LOCAL" checkout -q -- example/PLAN.md
git -C "$SYNC_LOCAL" push -q origin main
git -C "$SYNC_PEER" pull -q --rebase origin main

# 16: Phase 2 autostash pop conflict restores exact pre-sync working tree without conflict markers
printf '# Plan\n\nLocal conflicting line.\n' >"$SYNC_LOCAL/example/PLAN.md"
printf '# Plan\n\nUpstream conflicting line.\n' >"$SYNC_PEER/example/PLAN.md"
git -C "$SYNC_PEER" add example/PLAN.md
git -C "$SYNC_PEER" commit -qm 'docs(example): update plan upstream'
git -C "$SYNC_PEER" push -q origin main
PRE_CONFLICT_HEAD=$(git -C "$SYNC_LOCAL" rev-parse HEAD)
if ! CONFLICT_ERR=$("$BIN" --root "$SYNC_LOCAL" list example 2>&1) &&
  [[ "$CONFLICT_ERR" == *"conflict"* ]] &&
  [[ "$(git -C "$SYNC_LOCAL" rev-parse HEAD)" == "$PRE_CONFLICT_HEAD" ]] &&
  [[ -z "$(git -C "$SYNC_LOCAL" ls-files -u)" ]] &&
  ! grep -q '<<<<<<<' "$SYNC_LOCAL/example/PLAN.md" &&
  grep -q 'Local conflicting line.' "$SYNC_LOCAL/example/PLAN.md"; then
  echo 'ok 16 - autostash conflict rolls back to exact pre-sync working tree'
else
  echo 'not ok 16 - autostash conflict left markers or moved HEAD'
  printf '# err=%s\n' "$CONFLICT_ERR"
fi
git -C "$SYNC_LOCAL" checkout -q -- example/PLAN.md
("$BIN" --root "$SYNC_LOCAL" status example) >/dev/null

# 17: Phase 1 commit rebase conflict aborts rebase cleanly and restores HEAD
printf '# Plan\n\nLocal committed conflict.\n' >"$SYNC_LOCAL/example/PLAN.md"
git -C "$SYNC_LOCAL" add example/PLAN.md
git -C "$SYNC_LOCAL" commit -qm 'docs(example): local plan commit'
LOCAL_COMMIT_HEAD=$(git -C "$SYNC_LOCAL" rev-parse HEAD)
printf '# Plan\n\nPeer committed conflict.\n' >"$SYNC_PEER/example/PLAN.md"
git -C "$SYNC_PEER" add example/PLAN.md
git -C "$SYNC_PEER" commit -qm 'docs(example): peer plan commit'
git -C "$SYNC_PEER" push -q origin main
if ! RB_ERR=$("$BIN" --root "$SYNC_LOCAL" status example 2>&1) &&
  [[ "$RB_ERR" == *"rebase aborted"* ]] &&
  [[ ! -d "$SYNC_LOCAL/.git/rebase-merge" ]] &&
  [[ ! -d "$SYNC_LOCAL/.git/rebase-apply" ]] &&
  [[ "$(git -C "$SYNC_LOCAL" rev-parse HEAD)" == "$LOCAL_COMMIT_HEAD" ]]; then
  echo 'ok 17 - commit rebase conflict aborts cleanly and restores HEAD'
else
  echo 'not ok 17 - commit rebase conflict did not abort cleanly'
  printf '# err=%s\n' "$RB_ERR"
fi
git -C "$SYNC_LOCAL" reset -q --hard origin/main

# 18: Committing CLI commands push to remote and retry on non-fast-forward race
("$BIN" --root "$SYNC_LOCAL" update TASK-A1B2C --status in-progress --offline) >/dev/null
printf '\nPeer note.\n' >>"$SYNC_PEER/INBOX.md"
git -C "$SYNC_PEER" add INBOX.md
git -C "$SYNC_PEER" commit -qm 'docs: peer inbox note'
git -C "$SYNC_PEER" push -q origin main
if ("$BIN" --root "$SYNC_LOCAL" checkpoint TASK-A1B2C 'example: start task') >/dev/null 2>&1 &&
  [[ "$(git -C "$SYNC_LOCAL" rev-parse HEAD)" == "$(git --git-dir="$SYNC_REMOTE" rev-parse main)" ]] &&
  grep -q 'Peer note.' "$SYNC_LOCAL/INBOX.md"; then
  echo 'ok 18 - checkpoint reconciles with advanced remote and pushes commit'
else
  echo 'not ok 18 - checkpoint did not reconcile and push to remote'
fi

# 19: --offline and AGENT_OFFLINE=1 skip remote fetch and push
git -C "$SYNC_PEER" pull -q --rebase origin main
printf '\nAnother peer note.\n' >>"$SYNC_PEER/INBOX.md"
git -C "$SYNC_PEER" add INBOX.md
git -C "$SYNC_PEER" commit -qm 'docs: second peer inbox note'
git -C "$SYNC_PEER" push -q origin main
REMOTE_HEAD_BEFORE=$(git --git-dir="$SYNC_REMOTE" rev-parse main)
OFFLINE_CREATED=$(AGENT_OFFLINE=1 "$BIN" --root "$SYNC_LOCAL" create example 'Offline task' --slug offline-task)
OFFLINE_ID="${OFFLINE_CREATED%%$'\t'*}"
if [[ -n "$OFFLINE_ID" ]] &&
  [[ "$(git --git-dir="$SYNC_REMOTE" rev-parse main)" == "$REMOTE_HEAD_BEFORE" ]] &&
  ! grep -q 'Another peer note.' "$SYNC_LOCAL/INBOX.md" &&
  ("$BIN" --root "$SYNC_LOCAL" --offline list example) | grep -q "$OFFLINE_ID"; then
  echo 'ok 19 - --offline and AGENT_OFFLINE=1 skip remote fetch and push'
else
  echo 'not ok 19 - offline mode did not skip remote fetch and push'
fi
git -C "$SYNC_LOCAL" reset -q --hard origin/main

# 20: Untracked file collision with upstream refuses cleanly without wiping dirty tracked edits
printf '\nPrecious uncommitted edit.\n' >>"$SYNC_LOCAL/example/PLAN.md"
printf 'Local untracked content.\n' >"$SYNC_LOCAL/example/untracked-collision.md"
git -C "$SYNC_PEER" pull -q --rebase origin main
printf 'Upstream tracked content.\n' >"$SYNC_PEER/example/untracked-collision.md"
git -C "$SYNC_PEER" add example/untracked-collision.md
git -C "$SYNC_PEER" commit -qm 'docs(example): add collision file upstream'
git -C "$SYNC_PEER" push -q origin main
if ! UNTRACKED_ERR=$("$BIN" --root "$SYNC_LOCAL" status example 2>&1) &&
  [[ "$UNTRACKED_ERR" == *"untracked working tree file(s) would be overwritten"* ]] &&
  grep -q 'Precious uncommitted edit.' "$SYNC_LOCAL/example/PLAN.md" &&
  grep -q 'Local untracked content.' "$SYNC_LOCAL/example/untracked-collision.md"; then
  echo 'ok 20 - untracked collision refuses cleanly without wiping dirty tracked edits'
else
  echo 'not ok 20 - untracked collision wiped dirty tracked edits or did not fail'
  printf '# err=%s\n' "$UNTRACKED_ERR"
fi
rm -f "$SYNC_LOCAL/example/untracked-collision.md"
git -C "$SYNC_LOCAL" checkout -q -- example/PLAN.md
("$BIN" --root "$SYNC_LOCAL" status example) >/dev/null

# 21: Unstaged STATUS.md generated block from local update reconciles cleanly with peer task commit in same project
("$BIN" --root "$SYNC_LOCAL" update TASK-A1B2C --status todo --offline) >/dev/null
git -C "$SYNC_PEER" pull -q --rebase origin main
PEER_SAME_PROJ=$("$BIN" --root "$SYNC_PEER" create example 'Concurrent peer task in same project' --slug concurrent-peer)
PEER_SAME_ID="${PEER_SAME_PROJ%%$'\t'*}"
if CP_ERR=$("$BIN" --root "$SYNC_LOCAL" checkpoint TASK-A1B2C 'example: return task to todo' 2>&1) &&
  ("$BIN" --root "$SYNC_LOCAL" --offline list example) | grep -q "$PEER_SAME_ID" &&
  [[ "$(git -C "$SYNC_LOCAL" rev-parse HEAD)" == "$(git --git-dir="$SYNC_REMOTE" rev-parse main)" ]]; then
  echo 'ok 21 - unstaged STATUS.md snapshot reconciles cleanly with peer task commit in same project'
else
  echo 'not ok 21 - unstaged STATUS.md snapshot conflicted against peer task commit'
  printf '# err=%s\n' "$CP_ERR"
fi

# 22: Committing create refuses when staged changes exist in the index
printf '\nStaged unrelated edit.\n' >>"$SYNC_LOCAL/INBOX.md"
git -C "$SYNC_LOCAL" add INBOX.md
if ! STAGED_CREATE_ERR=$("$BIN" --root "$SYNC_LOCAL" create example 'Should refuse staged index' --slug refuse-staged 2>&1) &&
  [[ "$STAGED_CREATE_ERR" == *"git index contains staged changes"* ]]; then
  echo 'ok 22 - committing create refuses when git index contains staged changes'
else
  echo 'not ok 22 - committing create allowed dirty git index'
  printf '# err=%s\n' "$STAGED_CREATE_ERR"
fi
git -C "$SYNC_LOCAL" reset -q --hard origin/main

# 23: Unscoped doctor reports [INFO] on AGENTS.md template drift and fix writes canonical template
if DRIFT_OUT=$("$BIN" --root "$SYNC_LOCAL" --offline doctor 2>&1) &&
  grep -q '^\[INFO\]  AGENTS.md: differs from canonical taskgo template (run fix)' <<<"$DRIFT_OUT" &&
  ("$BIN" --root "$SYNC_LOCAL" --offline fix) >/dev/null 2>&1 &&
  grep -q '^## Standing Rules$' "$SYNC_LOCAL/AGENTS.md" &&
  ! ("$BIN" --root "$SYNC_LOCAL" --offline doctor 2>&1 | grep -q 'differs from canonical taskgo template'); then
  echo 'ok 23 - doctor reports [INFO] on AGENTS.md template drift and fix writes canonical template'
else
  echo 'not ok 23 - doctor and fix did not synchronize AGENTS.md to canonical template'
  printf '# drift=%s\n' "$DRIFT_OUT"
fi
