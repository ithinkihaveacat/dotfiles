#!/usr/bin/env bash
set -euo pipefail

# Color styling is asserted explicitly per test; isolate from inherited
# NO_COLOR/FORCE_COLOR.
unset NO_COLOR FORCE_COLOR

# Isolate test suite from ambient agent runtime variables.
unset AI_AGENT INVOKER_INFO_NAME
unset JETSKI_CONVERSATION_ID ANTIGRAVITY_CONVERSATION_ID ANTIGRAVITY_SESSION
unset CLAUDE_CODE_SESSION_ID CLAUDE_CODE_REMOTE_SESSION_ID CLAUDE_SESSION_ID CLAUDE_PROJECT_ID
unset OPENCODE_SESSION_ID CODEX_SESSION_ID
unset INVOKER_INFO_ROOT_SESSION_ID CONVERSATION_ID

export GIT_AUTHOR_NAME="Taskgo Test"
export GIT_AUTHOR_EMAIL="taskgo@example.com"
export GIT_COMMITTER_NAME="Taskgo Test"
export GIT_COMMITTER_EMAIL="taskgo@example.com"

TEST_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ ! -f "$TEST_DIR/../scripts/taskgo" ]]; then
  TEST_DIR="/usr/local/google/home/stillers/.dotfiles/skills/taskgo/tests"
fi
BIN="$TEST_DIR/../scripts/taskgo"
# shellcheck disable=SC2034
MARKDOWN_FORMAT="$TEST_DIR/../../coding-standards/scripts/markdown-format"
TEST_ROOT="$(mktemp -d)"
trap 'rm -rf -- "$TEST_ROOT"' EXIT
export TASKGO_MCP_LOG="$TEST_ROOT/mcp-requests.jsonl"

echo "1..13"

init_base_repo() {
  local target="${1:-$TEST_ROOT/repo}"
  mkdir -p "$target/example/tasks"
  git -C "$target" init -q
  printf '%s
' '# Agent instructions' '' 'This repository follows taskgo:' '<https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo>.' >"$target/AGENTS.md"
  printf '# Inbox
' >"$target/INBOX.md"
  printf '# Example project
' >"$target/example/PROJECT.md"
  printf '# Plan
' >"$target/example/PLAN.md"
  printf '%s
' '---' 'id: TASK-A1B2C' 'status: todo' '---' '' '# Confirm generated status formatting' >"$target/example/tasks/TASK-A1B2C-confirm-status.md"
}

REPO="$TEST_ROOT/repo"
init_base_repo "$REPO"

MCP_PY=$(uv sync -q --script "$BIN" </dev/null && uv python find --script "$BIN")
# shellcheck disable=SC2034
APPLY_PY="$MCP_PY"

REPO="$TEST_ROOT/repo"
mkdir -p "$REPO/example/tasks"
git -C "$REPO" init -q

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo>.' \
  >"$REPO/AGENTS.md"
printf '# Inbox\n' >"$REPO/INBOX.md"
printf '# Example project\n' >"$REPO/example/PROJECT.md"
printf '# Plan\n' >"$REPO/example/PLAN.md"
printf '%s\n' \
  '---' \
  'id: TASK-A1B2C' \
  'status: todo' \
  '---' \
  '' \
  '# Confirm generated status formatting' \
  >"$REPO/example/tasks/TASK-A1B2C-confirm-status.md"

if ("$BIN" --root "$REPO" sync example) &&
  "$MARKDOWN_FORMAT" --check "$REPO/example/STATUS.md" >/dev/null; then
  echo 'ok 1 - sync emits canonical Markdown'
else
  echo 'not ok 1 - sync output needs Markdown formatting'
fi

if ("$BIN" --root "$REPO" doctor example) >/dev/null 2>&1; then
  echo 'ok 2 - doctor accepts canonical generated status'
else
  echo 'not ok 2 - doctor rejects canonical generated status'
fi

sed -i.bak '/taskgo/d' "$REPO/AGENTS.md"
if ! declaration_out=$("$BIN" --root "$REPO" doctor example 2>&1) &&
  printf '%s\n' "$declaration_out" |
  grep -q '^\[WARN\]  AGENTS.md: must state'; then
  echo 'ok 3 - doctor requires a taskgo declaration'
else
  echo 'not ok 3 - doctor accepts a missing taskgo declaration'
fi

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo.' \
  >"$REPO/AGENTS.md"
if ! url_out=$("$BIN" --root "$REPO" doctor example 2>&1) &&
  printf '%s\n' "$url_out" |
  grep -q '^\[WARN\]  AGENTS.md: missing canonical taskgo URL:'; then
  echo 'ok 4 - doctor requires the canonical taskgo URL'
else
  echo 'not ok 4 - doctor accepts a missing canonical taskgo URL'
fi

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo>.' \
  >"$REPO/AGENTS.md"
sed -i.bak 's/status: todo/status: in-progress/' \
  "$REPO/example/tasks/TASK-A1B2C-confirm-status.md"
("$BIN" --root "$REPO" sync example) >/dev/null
awk '
  { print }
  $0 == "## Summary" {
    print ""
    print "There is no task currently in progress."
  }
' "$REPO/example/STATUS.md" >"$REPO/example/STATUS.md.tmp"
mv "$REPO/example/STATUS.md.tmp" "$REPO/example/STATUS.md"
if ! contradiction_out=$("$BIN" --root "$REPO" doctor example 2>&1) &&
  printf '%s\n' "$contradiction_out" |
  grep -q '^\[WARN\]  example: STATUS prose says no task is in progress'; then
  echo 'ok 5 - doctor detects contradictory STATUS prose'
else
  echo 'not ok 5 - doctor accepts contradictory STATUS prose'
fi

sed -i.bak '/There is no task currently in progress\./d' \
  "$REPO/example/STATUS.md"
sed -i.bak 's/status: in-progress/status: done/' \
  "$REPO/example/tasks/TASK-A1B2C-confirm-status.md"
if ! ("$BIN" --root "$REPO" doctor example) >/dev/null 2>&1; then
  echo 'ok 6 - doctor still detects task snapshot drift'
else
  echo 'not ok 6 - doctor missed task snapshot drift'
fi

CHECKPOINT_REPO="$TEST_ROOT/checkpoint-repo"
mkdir -p "$CHECKPOINT_REPO/example/tasks"
git -C "$CHECKPOINT_REPO" init -q
git -C "$CHECKPOINT_REPO" config user.name 'Taskgo Test'
git -C "$CHECKPOINT_REPO" config user.email 'taskgo@example.invalid'

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo>.' \
  >"$CHECKPOINT_REPO/AGENTS.md"
printf '# Inbox\n' >"$CHECKPOINT_REPO/INBOX.md"
printf '# Example project\n' >"$CHECKPOINT_REPO/example/PROJECT.md"
printf '# Plan\n' >"$CHECKPOINT_REPO/example/PLAN.md"
printf '%s\n' \
  '---' \
  'id: TASK-B2C3D' \
  'status: todo' \
  '---' \
  '' \
  '# Exercise guarded checkpoints' \
  >"$CHECKPOINT_REPO/example/tasks/TASK-B2C3D-checkpoints.md"
("$BIN" --root "$CHECKPOINT_REPO" sync example) >/dev/null
git -C "$CHECKPOINT_REPO" add .
git -C "$CHECKPOINT_REPO" commit -qm 'test: initialize tracker'

CHECKPOINT_TASK="$CHECKPOINT_REPO/example/tasks/TASK-B2C3D-checkpoints.md"
start_checkpoint() {
  sed 's/status: todo/status: in-progress/' "$CHECKPOINT_TASK" \
    >"$CHECKPOINT_TASK.tmp"
  mv "$CHECKPOINT_TASK.tmp" "$CHECKPOINT_TASK"
}

start_checkpoint
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test') >/dev/null 2>&1; then
  echo 'ok 7 - checkpoint requires committed authorization'
else
  echo 'not ok 7 - checkpoint accepts missing authorization'
fi
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md

printf '\n%s\n' '<!-- taskgo:allow-local-commits -->' \
  >>"$CHECKPOINT_REPO/AGENTS.md"
git -C "$CHECKPOINT_REPO" add AGENTS.md
git -C "$CHECKPOINT_REPO" commit -qm 'test: authorize checkpoints'

start_checkpoint
git -C "$CHECKPOINT_REPO" add example/tasks/TASK-B2C3D-checkpoints.md
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test') >/dev/null 2>&1; then
  echo 'ok 8 - checkpoint refuses a non-empty index'
else
  echo 'not ok 8 - checkpoint accepts a non-empty index'
fi
git -C "$CHECKPOINT_REPO" restore --staged example/tasks/TASK-B2C3D-checkpoints.md
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md

start_checkpoint
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test' \
  --path INBOX.md) >/dev/null 2>&1; then
  echo 'ok 9 - checkpoint rejects paths outside the task project'
else
  echo 'not ok 9 - checkpoint accepts a path outside the task project'
fi
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md

start_checkpoint
printf '\nStart with a guarded checkpoint.\n' \
  >>"$CHECKPOINT_REPO/example/PLAN.md"
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test') >/dev/null 2>&1; then
  echo 'ok 10 - checkpoint refuses unlisted project changes'
else
  echo 'not ok 10 - checkpoint accepts unlisted project changes'
fi
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md
git -C "$CHECKPOINT_REPO" restore example/PLAN.md

start_checkpoint
printf '\nStart with a guarded checkpoint.\n' \
  >>"$CHECKPOINT_REPO/example/PLAN.md"
printf '\nUnrelated root note.\n' >>"$CHECKPOINT_REPO/INBOX.md"
if ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test' \
  --path example/PLAN.md --ref artifact@abc123) >/dev/null 2>&1 &&
  git -C "$CHECKPOINT_REPO" diff --quiet -- example &&
  ! git -C "$CHECKPOINT_REPO" diff --quiet -- INBOX.md &&
  [[ "$(git -C "$CHECKPOINT_REPO" log -1 --format=%s)" == 'chore(example): start checkpoint test' ]] &&
  git -C "$CHECKPOINT_REPO" log -1 --format=%B | grep -q '^Ref: artifact@abc123$' &&
  grep -q 'TASK-B2C3D.*Exercise guarded checkpoints' \
    "$CHECKPOINT_REPO/example/STATUS.md" &&
  ("$BIN" --root "$CHECKPOINT_REPO" history TASK-B2C3D) |
  grep -q 'todo -> in-progress'; then
  echo 'ok 11 - checkpoint commits only the validated project transition'
else
  echo 'not ok 11 - checkpoint did not preserve its safety boundary'
fi

if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint example/tasks/TASK-B2C3D-checkpoints.md \
  'example: reject path target') >/dev/null 2>&1; then
  echo 'ok 12 - checkpoint requires a task ID target'
else
  echo 'not ok 12 - checkpoint accepts a path target'
fi

sed '/taskgo:allow-local-commits/d' "$CHECKPOINT_REPO/AGENTS.md" \
  >"$CHECKPOINT_REPO/AGENTS.md.tmp"
mv "$CHECKPOINT_REPO/AGENTS.md.tmp" "$CHECKPOINT_REPO/AGENTS.md"
sed 's/status: done/status: todo/' "$CHECKPOINT_TASK" \
  >"$CHECKPOINT_TASK.tmp"
mv "$CHECKPOINT_TASK.tmp" "$CHECKPOINT_TASK"
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: revoked checkpoint') >/dev/null 2>&1; then
  echo 'ok 13 - an uncommitted marker removal revokes authorization'
else
  echo 'not ok 13 - checkpoint ignores a working-tree revocation'
fi
