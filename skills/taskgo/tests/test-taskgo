#!/usr/bin/env bash
set -euo pipefail

export GIT_AUTHOR_NAME="Taskgo Test"
export GIT_AUTHOR_EMAIL="taskgo@example.com"
export GIT_COMMITTER_NAME="Taskgo Test"
export GIT_COMMITTER_EMAIL="taskgo@example.com"

TEST_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$TEST_DIR/../scripts/taskgo"
MARKDOWN_FORMAT="$TEST_DIR/../../coding-standards/scripts/markdown-format"
TEST_ROOT="$(mktemp -d)"
trap 'rm -rf -- "$TEST_ROOT"' EXIT

REPO="$TEST_ROOT/repo"
mkdir -p "$REPO/example/tasks"
git -C "$REPO" init -q

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo>.' \
  >"$REPO/AGENTS.md"
printf '# Inbox\n' >"$REPO/INBOX.md"
printf '# Example project\n' >"$REPO/example/PROJECT.md"
printf '# Plan\n' >"$REPO/example/PLAN.md"
printf '%s\n' \
  '---' \
  'id: TASK-A1B2C' \
  'status: todo' \
  '---' \
  '' \
  '# Confirm generated status formatting' \
  >"$REPO/example/tasks/TASK-A1B2C-confirm-status.md"

echo '1..69'

if ("$BIN" --root "$REPO" sync example) &&
  "$MARKDOWN_FORMAT" --check "$REPO/example/STATUS.md" >/dev/null; then
  echo 'ok 1 - sync emits canonical Markdown'
else
  echo 'not ok 1 - sync output needs Markdown formatting'
fi

if ("$BIN" --root "$REPO" doctor example) >/dev/null 2>&1; then
  echo 'ok 2 - doctor accepts canonical generated status'
else
  echo 'not ok 2 - doctor rejects canonical generated status'
fi

sed -i.bak '/taskgo/d' "$REPO/AGENTS.md"
if ! declaration_out=$("$BIN" --root "$REPO" doctor example 2>&1) &&
  printf '%s\n' "$declaration_out" |
  grep -q '^\[WARN\]  AGENTS.md: must state'; then
  echo 'ok 3 - doctor requires a taskgo declaration'
else
  echo 'not ok 3 - doctor accepts a missing taskgo declaration'
fi

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo.' \
  >"$REPO/AGENTS.md"
if ! url_out=$("$BIN" --root "$REPO" doctor example 2>&1) &&
  printf '%s\n' "$url_out" |
  grep -q '^\[WARN\]  AGENTS.md: missing canonical taskgo URL:'; then
  echo 'ok 4 - doctor requires the canonical taskgo URL'
else
  echo 'not ok 4 - doctor accepts a missing canonical taskgo URL'
fi

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo>.' \
  >"$REPO/AGENTS.md"
sed -i.bak 's/status: todo/status: in-progress/' \
  "$REPO/example/tasks/TASK-A1B2C-confirm-status.md"
("$BIN" --root "$REPO" sync example) >/dev/null
awk '
  { print }
  $0 == "## Summary" {
    print ""
    print "There is no task currently in progress."
  }
' "$REPO/example/STATUS.md" >"$REPO/example/STATUS.md.tmp"
mv "$REPO/example/STATUS.md.tmp" "$REPO/example/STATUS.md"
if ! contradiction_out=$("$BIN" --root "$REPO" doctor example 2>&1) &&
  printf '%s\n' "$contradiction_out" |
  grep -q '^\[WARN\]  example: STATUS prose says no task is in progress'; then
  echo 'ok 5 - doctor detects contradictory STATUS prose'
else
  echo 'not ok 5 - doctor accepts contradictory STATUS prose'
fi

sed -i.bak '/There is no task currently in progress\./d' \
  "$REPO/example/STATUS.md"
sed -i.bak 's/status: in-progress/status: done/' \
  "$REPO/example/tasks/TASK-A1B2C-confirm-status.md"
if ! ("$BIN" --root "$REPO" doctor example) >/dev/null 2>&1; then
  echo 'ok 6 - doctor still detects task snapshot drift'
else
  echo 'not ok 6 - doctor missed task snapshot drift'
fi

CHECKPOINT_REPO="$TEST_ROOT/checkpoint-repo"
mkdir -p "$CHECKPOINT_REPO/example/tasks"
git -C "$CHECKPOINT_REPO" init -q
git -C "$CHECKPOINT_REPO" config user.name 'Taskgo Test'
git -C "$CHECKPOINT_REPO" config user.email 'taskgo@example.invalid'

printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo>.' \
  >"$CHECKPOINT_REPO/AGENTS.md"
printf '# Inbox\n' >"$CHECKPOINT_REPO/INBOX.md"
printf '# Example project\n' >"$CHECKPOINT_REPO/example/PROJECT.md"
printf '# Plan\n' >"$CHECKPOINT_REPO/example/PLAN.md"
printf '%s\n' \
  '---' \
  'id: TASK-B2C3D' \
  'status: todo' \
  '---' \
  '' \
  '# Exercise guarded checkpoints' \
  >"$CHECKPOINT_REPO/example/tasks/TASK-B2C3D-checkpoints.md"
("$BIN" --root "$CHECKPOINT_REPO" sync example) >/dev/null
git -C "$CHECKPOINT_REPO" add .
git -C "$CHECKPOINT_REPO" commit -qm 'test: initialize tracker'

CHECKPOINT_TASK="$CHECKPOINT_REPO/example/tasks/TASK-B2C3D-checkpoints.md"
start_checkpoint() {
  sed 's/status: todo/status: in-progress/' "$CHECKPOINT_TASK" \
    >"$CHECKPOINT_TASK.tmp"
  mv "$CHECKPOINT_TASK.tmp" "$CHECKPOINT_TASK"
}

start_checkpoint
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test') >/dev/null 2>&1; then
  echo 'ok 7 - checkpoint requires committed authorization'
else
  echo 'not ok 7 - checkpoint accepts missing authorization'
fi
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md

printf '\n%s\n' '<!-- taskgo:allow-local-commits -->' \
  >>"$CHECKPOINT_REPO/AGENTS.md"
git -C "$CHECKPOINT_REPO" add AGENTS.md
git -C "$CHECKPOINT_REPO" commit -qm 'test: authorize checkpoints'

start_checkpoint
git -C "$CHECKPOINT_REPO" add example/tasks/TASK-B2C3D-checkpoints.md
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test') >/dev/null 2>&1; then
  echo 'ok 8 - checkpoint refuses a non-empty index'
else
  echo 'not ok 8 - checkpoint accepts a non-empty index'
fi
git -C "$CHECKPOINT_REPO" restore --staged example/tasks/TASK-B2C3D-checkpoints.md
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md

start_checkpoint
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test' \
  --path INBOX.md) >/dev/null 2>&1; then
  echo 'ok 9 - checkpoint rejects paths outside the task project'
else
  echo 'not ok 9 - checkpoint accepts a path outside the task project'
fi
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md

start_checkpoint
printf '\nStart with a guarded checkpoint.\n' \
  >>"$CHECKPOINT_REPO/example/PLAN.md"
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test') >/dev/null 2>&1; then
  echo 'ok 10 - checkpoint refuses unlisted project changes'
else
  echo 'not ok 10 - checkpoint accepts unlisted project changes'
fi
git -C "$CHECKPOINT_REPO" restore example/tasks/TASK-B2C3D-checkpoints.md
git -C "$CHECKPOINT_REPO" restore example/PLAN.md

start_checkpoint
printf '\nStart with a guarded checkpoint.\n' \
  >>"$CHECKPOINT_REPO/example/PLAN.md"
printf '\nUnrelated root note.\n' >>"$CHECKPOINT_REPO/INBOX.md"
if ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: start checkpoint test' \
  --path example/PLAN.md --ref artifact@abc123) >/dev/null 2>&1 &&
  git -C "$CHECKPOINT_REPO" diff --quiet -- example &&
  ! git -C "$CHECKPOINT_REPO" diff --quiet -- INBOX.md &&
  [[ "$(git -C "$CHECKPOINT_REPO" log -1 --format=%s)" == 'example: start checkpoint test' ]] &&
  git -C "$CHECKPOINT_REPO" log -1 --format=%B | grep -q '^Ref: artifact@abc123$' &&
  grep -q 'TASK-B2C3D.*Exercise guarded checkpoints' \
    "$CHECKPOINT_REPO/example/STATUS.md" &&
  ("$BIN" --root "$CHECKPOINT_REPO" history TASK-B2C3D) |
  grep -q 'todo -> in-progress'; then
  echo 'ok 11 - checkpoint commits only the validated project transition'
else
  echo 'not ok 11 - checkpoint did not preserve its safety boundary'
fi

sed 's/status: in-progress/status: done/' "$CHECKPOINT_TASK" \
  >"$CHECKPOINT_TASK.tmp"
mv "$CHECKPOINT_TASK.tmp" "$CHECKPOINT_TASK"
if checkpoint_out=$("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: finish checkpoint test' 2>&1) &&
  [[ "$(git -C "$CHECKPOINT_REPO" log -1 --format=%s)" == 'example: finish checkpoint test' ]] &&
  ("$BIN" --root "$CHECKPOINT_REPO" history TASK-B2C3D) |
  grep -q 'in-progress -> done'; then
  echo 'ok 12 - checkpoint accepts an empty optional reference list'
else
  echo 'not ok 12 - checkpoint fails without an optional reference'
  printf '# %s\n' "$checkpoint_out"
fi

if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint example/tasks/TASK-B2C3D-checkpoints.md \
  'example: reject path target') >/dev/null 2>&1; then
  echo 'ok 13 - checkpoint requires a task ID target'
else
  echo 'not ok 13 - checkpoint accepts a path target'
fi

sed '/taskgo:allow-local-commits/d' "$CHECKPOINT_REPO/AGENTS.md" \
  >"$CHECKPOINT_REPO/AGENTS.md.tmp"
mv "$CHECKPOINT_REPO/AGENTS.md.tmp" "$CHECKPOINT_REPO/AGENTS.md"
sed 's/status: done/status: todo/' "$CHECKPOINT_TASK" \
  >"$CHECKPOINT_TASK.tmp"
mv "$CHECKPOINT_TASK.tmp" "$CHECKPOINT_TASK"
if ! ("$BIN" --root "$CHECKPOINT_REPO" checkpoint TASK-B2C3D 'example: revoked checkpoint') >/dev/null 2>&1; then
  echo 'ok 14 - an uncommitted marker removal revokes authorization'
else
  echo 'not ok 14 - checkpoint ignores a working-tree revocation'
fi

# Test 15 & 16: README.md recognition and optional PLAN.md
README_REPO="$TEST_ROOT/readme-repo"
mkdir -p "$README_REPO/proj1/tasks"
git -C "$README_REPO" init -q
printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo>.' \
  '' \
  '<!-- taskgo:allow-local-commits -->' \
  >"$README_REPO/AGENTS.md"
printf '# Inbox\n' >"$README_REPO/INBOX.md"
printf '# Proj1 README\n' >"$README_REPO/proj1/README.md"
printf '%s\n' \
  '---' \
  'id: TASK-C3D4E' \
  'status: todo' \
  '---' \
  '' \
  '# Task in README repo' \
  >"$README_REPO/proj1/tasks/TASK-C3D4E-task.md"

("$BIN" --root "$README_REPO" sync proj1) >/dev/null
if ("$BIN" --root "$README_REPO" doctor proj1) >/dev/null 2>&1; then
  echo 'ok 15 - doctor recognizes project via README.md with optional PLAN.md'
else
  echo 'not ok 15 - doctor failed to recognize README.md project'
fi

# Test 17: fix command auto-heals missing ID/status and auto-commits
printf '# Unformatted Task\n' >"$README_REPO/proj1/tasks/bare-task.md"
git -C "$README_REPO" config user.name 'Taskgo Test'
git -C "$README_REPO" config user.email 'taskgo@example.invalid'
git -C "$README_REPO" add .
git -C "$README_REPO" commit -qm 'init'

printf '# Unformatted Task with no id\n' >"$README_REPO/proj1/tasks/bare-task.md"
fix_out=$("$BIN" --root "$README_REPO" fix proj1 2>&1)
if printf '%s\n' "$fix_out" | grep -q 'COMMIT_SHA:' &&
  ("$BIN" --root "$README_REPO" doctor proj1) >/dev/null 2>&1; then
  echo 'ok 16 - fix auto-heals missing IDs and auto-commits with metadata'
else
  echo 'not ok 16 - fix failed to auto-heal or auto-commit'
  printf '# %s\n' "$fix_out"
fi

# Test 17: fix --dry-run
printf '# Another bare task\n' >"$README_REPO/proj1/tasks/another-task.md"
fix_dry_out=$("$BIN" --root "$README_REPO" fix proj1 --dry-run 2>&1)
if [[ -f "$README_REPO/proj1/tasks/another-task.md" ]] &&
  ! git -C "$README_REPO" status --porcelain | grep -q 'TASK-' &&
  printf '%s\n' "$fix_dry_out" | grep -q 'Dry run:'; then
  echo 'ok 17 - fix --dry-run reports actions without modifying working tree'
else
  echo 'not ok 17 - fix --dry-run mutated working tree or failed'
  printf '# %s\n' "$fix_dry_out"
fi
rm -f "$README_REPO/proj1/tasks/another-task.md"

# Test 18: create command auto-commits and updates STATUS.md
pre_create_sha=$(git -C "$README_REPO" rev-parse HEAD)
created_id=$("$BIN" --root "$README_REPO" create proj1 'New created task' | cut -f1)
post_create_sha=$(git -C "$README_REPO" rev-parse HEAD)
if [[ -n "$created_id" ]] &&
  [[ "$pre_create_sha" != "$post_create_sha" ]] &&
  ("$BIN" --root "$README_REPO" list proj1) | grep -q "$created_id" &&
  grep -q "TASK-.*New created task" "$README_REPO/proj1/STATUS.md" 2>/dev/null || grep -q "Todo: " "$README_REPO/proj1/STATUS.md"; then
  echo 'ok 18 - create and list commands function cleanly'
else
  echo 'not ok 18 - create or list command failed'
fi

# Test 19: fix does NOT stage unrelated untracked files
printf 'unrelated secret data\n' >"$README_REPO/unrelated_secret.txt"
printf '# Bad Task\n' >"$README_REPO/proj1/tasks/bad-task.md"
("$BIN" --root "$README_REPO" fix proj1 >/dev/null 2>&1)
if git -C "$README_REPO" status --porcelain | grep -Fq '?? unrelated_secret.txt'; then
  echo 'ok 19 - fix does not stage unrelated untracked files'
else
  echo 'not ok 19 - fix overreached and staged unrelated untracked files'
  git -C "$README_REPO" status --porcelain
fi

# Test 20: sync without arguments synchronizes all projects
printf '%s\n' \
  '---' \
  'id: TASK-E5F6A' \
  'status: in-progress' \
  '---' \
  '' \
  '# Multi-sync task' \
  >"$README_REPO/proj1/tasks/TASK-E5F6A-multisync.md"
("$BIN" --root "$README_REPO" sync >/dev/null 2>&1)
if ("$BIN" --root "$README_REPO" doctor proj1) >/dev/null 2>&1; then
  echo 'ok 20 - sync without arguments synchronizes workspace'
else
  echo 'not ok 20 - sync without arguments failed to synchronize'
fi

# Test 21: create normalizes status aliases
wip_id=$("$BIN" --root "$README_REPO" create proj1 'WIP task' --status wip | cut -f1)
wip_file=$("$BIN" --root "$README_REPO" list proj1 | grep "$wip_id" | cut -f5)
if grep -q '^status: in-progress$' "$README_REPO/$wip_file"; then
  echo 'ok 21 - create normalizes status aliases'
else
  echo 'not ok 21 - create failed to normalize status alias'
  cat "$README_REPO/$wip_file"
fi

# Test 22: create auto-scaffolds a new project directory
newproj_id=$("$BIN" --root "$README_REPO" create brandnew 'First task in new project' | cut -f1)
if [[ -n "$newproj_id" ]] &&
  [[ -f "$README_REPO/brandnew/README.md" ]] &&
  [[ -f "$README_REPO/brandnew/STATUS.md" ]] &&
  ("$BIN" --root "$README_REPO" doctor brandnew) >/dev/null 2>&1; then
  echo 'ok 22 - create auto-scaffolds new project'
else
  echo 'not ok 22 - create failed to auto-scaffold new project'
fi

# Test 23: checkpoint succeeds on project file changes without modifying task file directly
printf '# Updated plan\n' >"$README_REPO/brandnew/PLAN.md"
cp_out=$("$BIN" --root "$README_REPO" checkpoint "$newproj_id" "brandnew: update plan" --path brandnew/PLAN.md 2>&1)
if ! git -C "$README_REPO" status --porcelain | grep -q 'brandnew' &&
  ("$BIN" --root "$README_REPO" doctor brandnew) >/dev/null 2>&1; then
  echo 'ok 23 - checkpoint succeeds with only --path project changes'
else
  echo 'not ok 23 - checkpoint failed when task file was unchanged'
  printf '# %s\n' "$cp_out"
  git -C "$README_REPO" status --porcelain
fi

# Test 24: list --json and status --json output valid JSON
list_json=$("$BIN" --root "$README_REPO" list --json)
status_json=$("$BIN" --root "$README_REPO" status --json)
if python3 -c "import json, sys; json.loads(sys.argv[1]); json.loads(sys.argv[2])" "$list_json" "$status_json" >/dev/null 2>&1; then
  echo 'ok 24 - list --json and status --json emit valid JSON'
else
  echo 'not ok 24 - JSON output formatting failed'
fi

# Test 25: list handles flexible flag ordering and status alias filtering
alias_list=$("$BIN" --root "$README_REPO" list --json --state inprogress proj1)
if python3 -c "import json, sys; d = json.loads(sys.argv[1]); sys.exit(0 if len(d) >= 1 and d[0]['status'] == 'in-progress' else 1)" "$alias_list" >/dev/null 2>&1; then
  echo 'ok 25 - list handles flexible flag ordering and alias filtering'
else
  echo 'not ok 25 - list failed with flexible flag order or alias filter'
fi

# Test 26: checkpoint handles staging deleted files via --path
rm "$README_REPO/brandnew/PLAN.md"
del_cp_out=$("$BIN" --root "$README_REPO" checkpoint "$newproj_id" "brandnew: remove plan" --path brandnew/PLAN.md 2>&1)
if ! git -C "$README_REPO" status --porcelain | grep -q 'brandnew' &&
  ("$BIN" --root "$README_REPO" doctor brandnew) >/dev/null 2>&1; then
  echo 'ok 26 - checkpoint stages deleted project files via --path'
else
  echo 'not ok 26 - checkpoint failed to stage deleted file'
  printf '# %s\n' "$del_cp_out"
  git -C "$README_REPO" status --porcelain
fi

# Test 27: create --dry-run previews allocation without writing files
dry_out=$("$BIN" --root "$README_REPO" create brandnew 'Dry run task' --dry-run)
dry_path=$(printf '%s\n' "$dry_out" | cut -f2)
if [[ -n "$dry_path" ]] && [[ ! -e "$README_REPO/$dry_path" ]]; then
  echo 'ok 27 - create --dry-run previews path without writing files'
else
  echo 'not ok 27 - create --dry-run wrote files or returned empty'
fi

# Test 28: fix --no-commit applies repairs on disk without committing
printf '# Bad Task No Commit\n' >"$README_REPO/brandnew/tasks/bad-uncommitted.md"
head_before=$(git -C "$README_REPO" rev-parse HEAD)
fix_nc_out=$("$BIN" --root "$README_REPO" fix brandnew --no-commit 2>&1)
head_after=$(git -C "$README_REPO" rev-parse HEAD)
if [[ "$head_before" == "$head_after" ]] &&
  git -C "$README_REPO" status --porcelain | grep -q 'brandnew' &&
  ("$BIN" --root "$README_REPO" doctor brandnew) >/dev/null 2>&1; then
  echo 'ok 28 - fix --no-commit applies repairs without committing'
else
  echo 'not ok 28 - fix --no-commit failed or unexpectedly committed'
  printf '# %s\n' "$fix_nc_out"
fi

# Test 29: fix preserves custom frontmatter fields
printf '%s\n' \
  '---' \
  'id: TASK-OLD01' \
  'status: wip' \
  'priority: high' \
  'owner: alice' \
  '---' \
  '' \
  '# Custom fields task' \
  >"$README_REPO/brandnew/tasks/TASK-OLD01-custom.md"
("$BIN" --root "$README_REPO" fix brandnew >/dev/null 2>&1)
remediated_file=$("$BIN" --root "$README_REPO" list brandnew | grep 'Custom fields task' | cut -f5)
if grep -q '^priority: high$' "$README_REPO/$remediated_file" &&
  grep -q '^owner: alice$' "$README_REPO/$remediated_file" &&
  grep -q '^status: in-progress$' "$README_REPO/$remediated_file"; then
  echo 'ok 29 - fix preserves custom frontmatter keys'
else
  echo 'not ok 29 - fix stripped custom frontmatter fields'
  cat "$README_REPO/$remediated_file"
fi

# Test 30: create handles flags preceding positional arguments
flag_first_out=$("$BIN" --root "$README_REPO" create --dry-run --status wip brandnew 'Flag first task')
if printf '%s\n' "$flag_first_out" | grep -q 'brandnew/tasks/TASK-'; then
  echo 'ok 30 - create handles flags placed before positional arguments'
else
  echo 'not ok 30 - create failed with flags before positional arguments'
  printf '# %s\n' "$flag_first_out"
fi

# Test 31: get_task_files ignores non-project directories with tasks subfolder
mkdir -p "$README_REPO/nonproject_dir/tasks"
printf '# Fake task\n' >"$README_REPO/nonproject_dir/tasks/TASK-FAKE1-fake.md"
all_tasks=$("$BIN" --root "$README_REPO" list)
rm -rf "$README_REPO/nonproject_dir"
if ! printf '%s\n' "$all_tasks" | grep -q 'nonproject_dir'; then
  echo 'ok 31 - list ignores non-project directories lacking README.md'
else
  echo 'not ok 31 - list included tasks from non-project directory'
fi

# Test 32: doctor treats unformatted Markdown as INFO (exit 0)
printf '\nExtra unformatted trailing text   \n' >>"$README_REPO/proj1/tasks/TASK-C3D4E-task.md"
if ("$BIN" --root "$README_REPO" doctor proj1) >/dev/null 2>&1; then
  echo 'ok 32 - doctor treats cosmetic markdown formatting as INFO (exit 0)'
else
  echo 'not ok 32 - doctor failed on cosmetic markdown formatting'
fi

# Test 33: fix commits modified STATUS.md along with task repairs
("$BIN" --root "$README_REPO" sync proj1) >/dev/null 2>&1
("$BIN" --root "$README_REPO" fix proj1) >/dev/null 2>&1
if ! git -C "$README_REPO" status --porcelain | grep -q 'STATUS.md'; then
  echo 'ok 33 - fix commits modified STATUS.md along with task repairs'
else
  echo 'not ok 33 - fix left STATUS.md unstaged or dirty'
  git -C "$README_REPO" status --porcelain
fi

# Test 34: hooks are bypassed via --no-verify on internal commits
("$BIN" --root "$README_REPO" fix proj1) >/dev/null 2>&1
git -C "$README_REPO" add -A && git -C "$README_REPO" commit -qm 'clean' || true
mkdir -p "$README_REPO/.git/hooks"
cat <<'EOF' >"$README_REPO/.git/hooks/commit-msg"
#!/bin/sh
echo "Rejecting all commits via test hook" >&2
exit 1
EOF
chmod +x "$README_REPO/.git/hooks/commit-msg"

hook_task_id=$("$BIN" --root "$README_REPO" create proj1 'Hook bypass task' | cut -f1)
if [[ -n "$hook_task_id" ]]; then
  sed -i.bak 's/status: todo/status: in-progress/' "$README_REPO/proj1/tasks/$hook_task_id-"*.md
  rm -f "$README_REPO/proj1/tasks/$hook_task_id-"*.bak
fi
if [[ -n "$hook_task_id" ]] &&
  ("$BIN" --root "$README_REPO" checkpoint "$hook_task_id" "proj1: test hook bypass") >/dev/null 2>&1; then
  echo 'ok 34 - taskgo commits bypass hooks via --no-verify'
else
  echo 'not ok 34 - hook blocked taskgo commit'
fi
rm -f "$README_REPO/.git/hooks/commit-msg"

# Test 35 & 36: SIGTERM and SIGINT signal teardown
SIG_REPO="$TEST_ROOT/sig-repo"
mkdir -p "$SIG_REPO/proj/tasks" "$TEST_ROOT/mock-bin"
git -C "$SIG_REPO" init -q
printf '%s\n' \
  '# Agent instructions' \
  '' \
  'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo>.' \
  '' \
  '<!-- taskgo:allow-local-commits -->' \
  >"$SIG_REPO/AGENTS.md"
printf '# Inbox\n' >"$SIG_REPO/INBOX.md"
printf '# Proj\n' >"$SIG_REPO/proj/README.md"
printf '# Status\n' >"$SIG_REPO/proj/STATUS.md"

