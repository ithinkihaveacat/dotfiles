#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Calls one MCP tool on a taskgo server and prints its structured result.

Usage: mcp-call URL TOOL [JSON_ARGS]

Sends initialize and then tools/call. Set CF_ACCESS_TOKEN to send an Access
token (as the cf-access-token header) to a server behind Cloudflare Access.
"""

import json
import os
import sys
import urllib.request


def post(url: str, msg: dict) -> dict:
    headers = {
        "content-type": "application/json",
        "accept": "application/json, text/event-stream",
        # Cloudflare blocks urllib's default user agent.
        "user-agent": "taskgo-mcp-call/0.1",
    }
    if os.environ.get("CF_ACCESS_TOKEN"):
        headers["cf-access-token"] = os.environ["CF_ACCESS_TOKEN"]
    req = urllib.request.Request(url, json.dumps(msg).encode(), headers)
    with urllib.request.urlopen(req, timeout=120) as resp:
        return json.load(resp)


def main() -> None:
    if len(sys.argv) not in (3, 4):
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        sys.exit(2)
    url, tool = sys.argv[1], sys.argv[2]
    args = json.loads(sys.argv[3]) if len(sys.argv) == 4 else {}
    post(
        url,
        {
            "jsonrpc": "2.0",
            "id": 0,
            "method": "initialize",
            "params": {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {"name": "mcp-call", "version": "0.1"},
            },
        },
    )
    if tool == "tools/list":
        print(
            json.dumps(
                post(url, {"jsonrpc": "2.0", "id": 1, "method": "tools/list"}), indent=1
            )
        )
        return
    reply = post(
        url,
        {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {"name": tool, "arguments": args},
        },
    )
    result = reply.get("result", reply)
    if result.get("isError"):
        print(result["content"][0]["text"], file=sys.stderr)
        sys.exit(1)
    print(json.dumps(result["structuredContent"], indent=2))


if __name__ == "__main__":
    main()
