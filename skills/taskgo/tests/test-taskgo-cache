class Tap:
    def __init__(self) -> None:
        self.results: list[tuple[int, str, bool, str]] = []
        self.failed = 0

    def record(self, num: int, desc: str, ok: bool, detail: str = "") -> None:
        if not ok:
            self.failed += 1
        self.results.append((num, desc, ok, detail))

    def run(self, num: int, desc: str, fn) -> None:
        try:
            fn()
            self.record(num, desc, True)
        except Exception as exc:
            self.record(num, desc, False, f"{type(exc).__name__}: {exc}")

    def emit(self) -> None:
        print(f"1..{len(self.results)}", flush=True)
        for num, desc, ok, detail in sorted(self.results):
            print(f"{'ok' if ok else 'not ok'} {num} - {desc}", flush=True)
            if not ok and detail:
                for line in detail.splitlines():
                    print(f"# {line}", flush=True)


def make_repo(path: Path, tracker_md: str, tasks: dict[str, str]) -> Path:
    (path / "alpha/tasks").mkdir(parents=True)
    subprocess.run(["git", "-C", str(path), "init", "-q", "-b", "main"], check=True)
    (path / "README.md").write_text(tracker_md, encoding="utf-8")
    (path / "AGENTS.md").write_text(AGENTS, encoding="utf-8")
    (path / "INBOX.md").write_text("# Inbox\n", encoding="utf-8")
    (path / "alpha/README.md").write_text("# Alpha\n", encoding="utf-8")
    for rel, content in tasks.items():
        (path / rel).write_text(content, encoding="utf-8")
    subprocess.run(["git", "-C", str(path), "add", "-A"], check=True)
    subprocess.run(["git", "-C", str(path), "commit", "-qm", "fixture"], check=True)
    return path


