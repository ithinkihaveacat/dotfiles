def with_counted_parse(fn):
    calls = 0

    def counted(*args, **kwargs):
        nonlocal calls
        calls += 1
        return orig_parse_fm(*args, **kwargs)

    tg.parse_frontmatter = counted
    try:
        return fn(lambda: calls)
    finally:
        tg.parse_frontmatter = orig_parse_fm


def t1(get_calls) -> None:
    rows = tg.get_task_rows(snap1)
    assert get_calls() == 3, get_calls()
    tg.get_task_rows(snap1)
    assert get_calls() == 3, get_calls()
    fresh = [
        tg.task_row_from_text(r.rel_path, snap1.read_text(r.rel_path)) for r in rows
    ]
    assert rows == fresh, (rows, fresh)


