#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=skills/taskgo/tests/common.sh disable=SC1091
source "$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
taskgo_test_init

make_repo() {
  local repo="$1"
  mkdir -p "$repo/alpha/tasks"
  git -C "$repo" init -q -b main
  printf '%s\n' '---' 'timezone: Europe/London' '---' '' '# Tracker' >"$repo/README.md"
  printf '%s\n' \
    '# Agent instructions' \
    '' \
    'This repository follows taskgo:' \
    '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
    >"$repo/AGENTS.md"
  printf '# Inbox\n' >"$repo/INBOX.md"
  printf '# Alpha\n' >"$repo/alpha/README.md"
  printf '%s\n' '---' 'id: TASK-AA001' 'status: todo' '---' '' '# First' \
    '' '**Goal:** One.' >"$repo/alpha/tasks/TASK-AA001-first.md"
  printf '%s\n' '---' 'id: TASK-AA002' 'status: todo' '---' '' '#Second' \
    '' '**Goal:** Two.' >"$repo/alpha/tasks/TASK-AA002-second.md"
  printf '%s\n' '---' 'id: TASK-AA003' 'status: todo' '---' '' '# Third' \
    '' '**Goal:** Three.' >"$repo/alpha/tasks/TASK-AA003-third.md"
  git -C "$repo" add -A
  git -C "$repo" commit -qm fixture
}

REPO="$TEST_ROOT/repo"
make_repo "$REPO"

echo "1..12"

# 1-4: the row cache, on one repository, in one process.
if OUT=$(
  "$TASKGO_PY" - "$BIN" "$REPO" 2>&1 <<'PY'
import importlib.machinery
import importlib.util
import sys
from pathlib import Path

loader = importlib.machinery.SourceFileLoader("taskgo_under_test", sys.argv[1])
tg = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(tg)
repo = Path(sys.argv[2])
snap = tg.WorktreeSnapshot(repo, tg.resolve_commit(repo, "HEAD"))

calls = 0
original = tg.parse_frontmatter


def counted(*args, **kwargs):
    global calls
    calls += 1
    return original(*args, **kwargs)


tg.parse_frontmatter = counted

# 1. One parse per task, then none; rows equal a fresh parse.
rows = tg.get_task_rows(snap)
assert calls == 3, (calls, seen)
tg.get_task_rows(snap)
assert calls == 3, (calls, seen)
fresh = [tg.task_row_from_text(r.rel_path, snap.read_text(r.rel_path)) for r in rows]
assert rows == fresh, (rows, fresh)

# 4a. Reading one blob of a commit does not load the whole tree.
sha = tg.resolve_commit(repo, "HEAD")
git = tg.GitTreeSnapshot(repo, sha)
assert git.read_text("README.md").startswith("---\ntimezone:")
assert set(git.texts) == {"README.md"}, set(git.texts)
# ...and its rows are the working tree's, from the same cache, without reads.
assert tg.get_task_rows(git) == tg.get_task_rows(snap)
assert set(git.texts) == {"README.md"}, set(git.texts)

# 2. Changed content is re-parsed, and only that file.
task = repo / "alpha/tasks/TASK-AA002-second.md"
changed = task.read_text().replace("status: todo", "status: done")
task.write_text(changed + "\n## Outcome\n\nMet.\n")
calls = 0
rows = tg.get_task_rows(snap)
by_id = {r.task_id: r for r in rows}
assert by_id["TASK-AA002"].status == "done", by_id["TASK-AA002"]
assert calls == 1, calls

# 3. A rename keeps the content but is a new cache entry and path.
task.rename(repo / "alpha/tasks/TASK-AA002-renamed.md")
calls = 0
rows = tg.get_task_rows(snap)
renamed = {r.task_id: r for r in rows}["TASK-AA002"]
assert renamed.rel_path == "alpha/tasks/TASK-AA002-renamed.md", renamed.rel_path
assert calls == 1, calls
PY
); then
  echo 'ok 1 - a task row is parsed once and reused'
  echo 'ok 2 - changed content is re-parsed'
  echo 'ok 3 - a rename is a new cache entry'
  echo 'ok 4 - one blob read does not load the whole tree'
else
  echo 'not ok 1 - a task row is parsed once and reused'
  echo 'not ok 2 - changed content is re-parsed'
  echo 'not ok 3 - a rename is a new cache entry'
  echo 'not ok 4 - one blob read does not load the whole tree'
  printf '# %s\n' "$OUT"
fi

# 5-7: find_record, duplicates, and format verdicts on a second repository.
REPO2="$TEST_ROOT/repo2"
mkdir -p "$REPO2/alpha/tasks"
git -C "$REPO2" init -q -b main
printf '%s\n' '# Tracker' >"$REPO2/README.md"
printf '%s\n' \
  '# Agent instructions' '' 'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  >"$REPO2/AGENTS.md"
printf '# Inbox\n' >"$REPO2/INBOX.md"
printf '# Alpha\n' >"$REPO2/alpha/README.md"
printf '%s\n' '---' 'id: TASK-BB001' 'status: todo' '---' '' '# First' \
  >"$REPO2/alpha/tasks/TASK-BB001-first.md"
printf '%s\n' '---' 'id: TASK-BB002' 'status: todo' '---' '' '# Second' \
  '' '* untidy   bullet' >"$REPO2/alpha/tasks/TASK-BB002-second.md"
printf '%s\n' '---' 'id: TASK-BB005' 'status: todo' '---' '' '# Liar' \
  >"$REPO2/alpha/tasks/TASK-BB004-liar.md"
git -C "$REPO2" add -A
git -C "$REPO2" commit -qm fixture

if OUT=$(
  "$TASKGO_PY" - "$BIN" "$REPO2" 2>&1 <<'PY'
import importlib.machinery
import importlib.util
import sys
from pathlib import Path

loader = importlib.machinery.SourceFileLoader("taskgo_under_test", sys.argv[1])
tg = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(tg)
repo = Path(sys.argv[2])
snap = tg.FsSnapshot(repo)


def apply(*changes):
    return tg.apply_change_set(snap, {"changes": list(changes)})


def set_status(task_id):
    return apply(
        {"op": "set", "record": task_id, "field": "status", "value": "in-progress"}
    )


# 5. An ID resolves through the frontmatter, not the filename.
cs = set_status("TASK-BB001")
assert "alpha/tasks/TASK-BB001-first.md" in cs.snap.changes, cs.snap.changes
# A file whose name lies still resolves by its frontmatter ID.
cs = set_status("TASK-BB005")
assert "alpha/tasks/TASK-BB004-liar.md" in cs.snap.changes, cs.snap.changes
assert "alpha/tasks/TASK-BB005-liar.md" not in cs.snap.changes, cs.snap.changes
try:
    set_status("TASK-BB004")
except tg.ChangeSetError as e:
    assert "no task TASK-BB004" in str(e), e
else:
    raise AssertionError("accepted a filename that does not name the task")

# 6. Duplicate IDs are still refused, whichever file holds the matching name.
(repo / "alpha/tasks/TASK-BB001-copy.md").write_text(
    "---\nid: TASK-BB001\nstatus: todo\n---\n\n# Copy\n"
)
try:
    set_status("TASK-BB001")
except tg.ChangeSetError as e:
    assert "names 2 records" in str(e), e
else:
    raise AssertionError("accepted a duplicate ID")

# 7. A format verdict follows the content: unformatted, formatted, unformatted.
rel = "alpha/tasks/TASK-BB002-second.md"
assert tg.markdown_finding(snap, rel) is not None
snap.write_text(rel, tg.format_markdown(snap.read_text(rel)))
assert tg.markdown_finding(snap, rel) is None
snap.write_text(rel, snap.read_text(rel).replace("- untidy bullet", "* tidy   bullet"))
assert tg.markdown_finding(snap, rel) is not None
PY
); then
  echo 'ok 5 - find_record resolves the frontmatter ID, not the filename'
  echo 'ok 6 - duplicate task IDs are still refused'
  echo 'ok 7 - a format verdict follows the content'
else
  echo 'not ok 5 - find_record resolves the frontmatter ID, not the filename'
  echo 'not ok 6 - duplicate task IDs are still refused'
  echo 'not ok 7 - a format verdict follows the content'
  printf '# %s\n' "$OUT"
fi

# 8-10: key from the bytes parsed, non-Markdown files, no cached failures.
REPO3="$TEST_ROOT/repo3"
mkdir -p "$REPO3/alpha/tasks"
git -C "$REPO3" init -q -b main
printf '%s\n' '# Tracker' >"$REPO3/README.md"
printf '%s\n' \
  '# Agent instructions' '' 'This repository follows taskgo:' \
  '<https://github.com/ithinkihaveacat/dotfiles/tree/main/skills/taskgo>.' \
  >"$REPO3/AGENTS.md"
printf '# Inbox\n' >"$REPO3/INBOX.md"
printf '# Alpha\n' >"$REPO3/alpha/README.md"
printf '%s\n' '---' 'id: TASK-DD001' 'status: todo' '---' '' '# Race' \
  >"$REPO3/alpha/tasks/TASK-DD001-race.md"
printf '%s\n' '---' 'id: TASK-CC001' 'status: todo' '---' '' '# Not a task' \
  >"$REPO3/alpha/tasks/TASK-CC001-backup.txt"
git -C "$REPO3" add -A
git -C "$REPO3" commit -qm fixture

if OUT=$(
  "$TASKGO_PY" - "$BIN" "$REPO3" 2>&1 <<'PY'
import importlib.machinery
import importlib.util
import sys
from pathlib import Path

loader = importlib.machinery.SourceFileLoader("taskgo_under_test", sys.argv[1])
tg = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(tg)
repo = Path(sys.argv[2])
task = repo / "alpha/tasks/TASK-DD001-race.md"


class StaleIds(tg.FsSnapshot):
    """A working tree whose content_id lies, as one does across a write."""

    def content_id(self, rel):
        return "0" * 40


# 8. The key comes from the bytes parsed, not from an earlier hash.
snap = StaleIds(repo)
row = next(r for r in tg.get_task_rows(snap) if r.rel_path == task.relative_to(repo).as_posix())
assert row.status == "todo", row
task.write_text(
    task.read_text().replace("status: todo", "status: done")
    + "\n## Outcome\n\nMet.\n"
)
row = next(r for r in tg.get_task_rows(snap) if r.rel_path == task.relative_to(repo).as_posix())
assert row.status == "done", row

# ...and so does a format verdict.
readme = repo / "alpha/README.md"
readme.write_text("# Alpha\n\n* untidy   bullet\n")
assert tg.markdown_finding(snap, "alpha/README.md") is not None
readme.write_text("# Alpha\n\n- tidy bullet\n")
assert tg.markdown_finding(snap, "alpha/README.md") is None

# 9. A non-Markdown file is not a task.
try:
    tg.apply_change_set(
        tg.FsSnapshot(repo),
        {"changes": [{"op": "set", "record": "TASK-CC001", "field": "status",
                      "value": "done"}]},
    )
except tg.ChangeSetError as e:
    assert "no task TASK-CC001" in str(e), e
else:
    raise AssertionError("accepted a task file that is not Markdown")


# 10. A read failure is not cached, so a recovered read is judged afresh.
class Flaky(tg.FsSnapshot):
    def __init__(self, root):
        super().__init__(root)
        self.fail = True

    def content_id(self, rel):
        return "1" * 40

    def read_text(self, rel):
        if self.fail:
            raise OSError("transient read failure")
        return super().read_text(rel)


snap = Flaky(repo)
first = tg.markdown_finding(snap, "alpha/README.md")
assert first is not None and first.severity == "WARN", first
snap.fail = False
assert tg.markdown_finding(snap, "alpha/README.md") is None
PY
); then
  echo 'ok 8 - the cache key comes from the bytes parsed'
  echo 'ok 9 - a non-Markdown file is not a task'
  echo 'ok 10 - a read failure is not cached'
else
  echo 'not ok 8 - the cache key comes from the bytes parsed'
  echo 'not ok 9 - a non-Markdown file is not a task'
  echo 'not ok 10 - a read failure is not cached'
  printf '# %s\n' "$OUT"
fi

# 11: one operation parses unchanged tasks once; only the written task is re-read.
if OUT=$(
  "$TASKGO_PY" - "$BIN" "$REPO" 2>&1 <<'PY'
import importlib.machinery
import importlib.util
import sys
from pathlib import Path

loader = importlib.machinery.SourceFileLoader("taskgo_under_test", sys.argv[1])
tg = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(tg)
repo = Path(sys.argv[2])

calls = 0
seen = []
original = tg.task_row_from_text


def counted(rel_path, content):
    global calls
    calls += 1
    seen.append(rel_path)
    return original(rel_path, content)


tg.task_row_from_text = counted
tg.apply_change_set(
    tg.FsSnapshot(repo),
    {"changes": [{"op": "set", "record": "TASK-AA001", "field": "status",
                  "value": "in-progress"}]},
)
from collections import Counter

counts = Counter(seen)
changed = "alpha/tasks/TASK-AA001-first.md"
assert len(counts) == 3, counts
assert counts[changed] == 2, counts
assert all(v == 1 for rel, v in counts.items() if rel != changed), counts
PY
); then
  echo 'ok 11 - a write parses unchanged tasks once'
else
  echo 'not ok 11 - a write parses unchanged tasks once'
  printf '# %s\n' "$OUT"
fi

# 12: task_ids_in_history memory/disk cache, incremental advance, rewind fallback, and corrupt cache recovery.
HIST_REPO="$TEST_ROOT/hist-repo"
make_repo "$HIST_REPO"
if OUT=$(
  "$TASKGO_PY" - "$BIN" "$HIST_REPO" 2>&1 <<'PY'
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
from pathlib import Path

loader = importlib.machinery.SourceFileLoader("taskgo_under_test", sys.argv[1])
tg = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(tg)
repo = Path(sys.argv[2])

log_calls = []
orig_run_git = tg.run_git


def traced_run_git(args, **kwargs):
    if args and args[0] == "log":
        log_calls.append(list(args))
    return orig_run_git(args, **kwargs)


tg.run_git = traced_run_git
tg._HISTORY_CACHE.clear()
common_dir, _ = tg._repo_history_tips(repo)
cache_file = tg._history_cache_file(common_dir)
assert cache_file is not None
cache_file.unlink(missing_ok=True)

base_ids = {"TASK-AA001", "TASK-AA002", "TASK-AA003"}

# Cold scan populates memory and disk caches.
got = tg.task_ids_in_history(repo)
assert got == base_ids, got
assert len(log_calls) == 1 and "--all" in log_calls[0], log_calls
assert cache_file.is_file()

# 12a. In-memory _HISTORY_CACHE hit runs no git log.
log_calls.clear()
assert tg.task_ids_in_history(repo) == base_ids
assert log_calls == [], log_calls

# 12b. XDG disk cache hit after _HISTORY_CACHE.clear() runs no git log.
tg._HISTORY_CACHE.clear()
log_calls.clear()
assert tg.task_ids_in_history(repo) == base_ids
assert log_calls == [], log_calls
assert str(common_dir) in tg._HISTORY_CACHE

# 12c. Incremental ref advance scans only old_tip..new_tip via --stdin.
new_task = repo / "alpha/tasks/TASK-AA004-fourth.md"
new_task.write_text("---\nid: TASK-AA004\nstatus: todo\n---\n\n# Fourth\n")
subprocess.run(["git", "-C", str(repo), "add", "-A"], check=True)
subprocess.run(["git", "-C", str(repo), "commit", "-qm", "add fourth"], check=True)
log_calls.clear()
got = tg.task_ids_in_history(repo)
assert got == base_ids | {"TASK-AA004"}, got
assert len(log_calls) == 1 and "--stdin" in log_calls[0] and "--all" not in log_calls[0], log_calls

# 12d. Rewound branch (cached tip no longer an ancestor) falls back to full scan.
subprocess.run(["git", "-C", str(repo), "reset", "--hard", "-q", "HEAD~1"], check=True)
log_calls.clear()
got = tg.task_ids_in_history(repo)
assert got == base_ids, got
assert len(log_calls) == 1 and "--all" in log_calls[0], log_calls

# 12e. Corrupt JSON and "v": 0 in the disk cache file recover gracefully via full scan.
tg._HISTORY_CACHE.clear()
cache_file.write_text("{corrupt json", encoding="utf-8")
log_calls.clear()
assert tg.task_ids_in_history(repo) == base_ids
assert len(log_calls) == 1 and "--all" in log_calls[0], log_calls
assert json.loads(cache_file.read_text(encoding="utf-8"))["v"] == tg._HISTORY_CACHE_VERSION

tg._HISTORY_CACHE.clear()
stale_payload = json.loads(cache_file.read_text(encoding="utf-8"))
stale_payload["v"] = 0
stale_payload["ids"] = ["TASK-FFFFF"]
cache_file.write_text(json.dumps(stale_payload), encoding="utf-8")
log_calls.clear()
assert tg.task_ids_in_history(repo) == base_ids
assert len(log_calls) == 1 and "--all" in log_calls[0], log_calls
assert json.loads(cache_file.read_text(encoding="utf-8"))["v"] == tg._HISTORY_CACHE_VERSION
PY
); then
  echo 'ok 12 - task_ids_in_history hits memory/disk caches, advances incrementally, and recovers on rewind or corrupt cache'
else
  echo 'not ok 12 - task_ids_in_history hits memory/disk caches, advances incrementally, and recovers on rewind or corrupt cache'
  printf '# %s\n' "$OUT"
fi
