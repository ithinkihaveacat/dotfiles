#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Checks the write tools of 'taskgo mcp' against a local bare remote.

Usage: write-check [--fetch-ttl SECS]

Builds a throwaway control repository with three projects, pushes it to a
bare repository, and serves a clone of it. Concurrent clients write through
the HTTP server; faults (a head that moves before each push, a push whose
reply is lost, a remote that cannot be read) are injected into an in-process
server, whose methods are the same. Checks that every write is one linear
commit or nothing, that retries are recorded once, also by a new server that
finds them by their trailers, that a stale CLI checkout recovers by rebase
without losing a server commit, that reads outlive an unreadable remote as
stale, and that a --local server (in process, and over --stdio) writes to a
checkout's branch and working tree. --fetch-ttl is passed to the servers
under test (default: the server's own); the checks of the cached head itself
pick their own. Prints TAP.
"""

import concurrent.futures
import importlib.machinery
import importlib.util
import json
import os
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

CLI = Path(__file__).resolve().parent.parent / "scripts" / "taskgo"
AGENTS = """\
