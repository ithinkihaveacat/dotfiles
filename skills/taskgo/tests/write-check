    "alpha/tasks/TASK-AA001-one.md": ("todo", [], "One"),
    "alpha/tasks/TASK-AA002-two.md": ("todo", [], "Two"),
    "alpha/tasks/TASK-AA003-three.md": ("in-progress", [], "Three"),
    "alpha/tasks/TASK-AA004-four.md": ("todo", [], "Four"),
    "alpha/tasks/TASK-AA005-five.md": ("todo", [], "Five"),
    "beta/tasks/TASK-BB001-held.md": ("todo", ["TASK-AA003"], "Held"),
    "beta/tasks/TASK-BB002-free.md": ("todo", [], "Free"),
