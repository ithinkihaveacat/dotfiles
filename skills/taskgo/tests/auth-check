#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "cryptography==50.0.2",
#     "cffi==2.1.1",
#     "pycparser==3.0",
# ]
# ///
"""Checks the Access JWT validation of 'taskgo mcp' against locally signed
tokens.

Usage: auth-check

Serves a JWKS with a throwaway RSA key on a loopback port and starts
'taskgo mcp' on a throwaway repository, trusting that JWKS (team
'test.invalid', audience 'test-aud'). Then sends a valid token, bad ones, and
none, and checks each status code and the request's log line (with the
refusal's reason, and never the token), and that the health check needs no
token. A write with an expired token is refused too. Then checks that '--auth
none' refuses a request addressed to another host, and that every other
outcome (a tool call, a tool error, an RPC error, a notification, a parse
error, an unknown path) logs one line. Last, checks that the server will not
start without Access settings. Prints TAP.
"""

import base64
import http.server
import json
import os
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric import padding, rsa

CLI = Path(__file__).resolve().parent.parent / "scripts" / "taskgo"
TEAM, AUD = "test.invalid", "test-aud"


def bypass_proxy_for_loopback() -> None:
    """Keeps loopback requests away from any proxy in the environment.

    A proxy set for the session (an agent sandbox sets one) would otherwise
    receive the requests meant for the servers this script starts on
    127.0.0.1, including the server's own JWKS fetch, and answer them itself.
    """
    for var in ("no_proxy", "NO_PROXY"):
        hosts = [h for h in os.environ.get(var, "").split(",") if h]
        hosts += [h for h in ("127.0.0.1", "localhost") if h not in hosts]
        os.environ[var] = ",".join(hosts)


def b64(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def jwk(key, kid: str) -> dict:
    n = key.public_key().public_numbers()
    return {
        "kid": kid,
        "kty": "RSA",
        "alg": "RS256",
        "use": "sig",
        "n": b64(n.n.to_bytes((n.n.bit_length() + 7) // 8, "big")),
        "e": b64(n.e.to_bytes(3, "big")),
    }


def token(key, kid: str, alg: str = "RS256", **claims) -> str:
    now = int(time.time())
    body = {
        "iss": f"https://{TEAM}",
        "aud": [AUD],
        "email": "test@example.com",
        "iat": now,
        "nbf": now,
        "exp": now + 300,
        **claims,
    }
    head = b64(json.dumps({"alg": alg, "kid": kid, "typ": "JWT"}).encode())
    payload = b64(json.dumps(body).encode())
    if alg == "none":
        return f"{head}.{payload}."
    sig = key.sign(f"{head}.{payload}".encode(), padding.PKCS1v15(), hashes.SHA256())
    return f"{head}.{payload}.{b64(sig)}"


def status(
    url: str,
    tok: str | None,
    host: str | None = None,
    msg: dict | None = None,
    body: bytes | None = None,
) -> int:
    msg = msg or {"jsonrpc": "2.0", "id": 1, "method": "ping"}
    headers = {"content-type": "application/json"}
    if tok:
        headers["cf-access-jwt-assertion"] = tok
    if host:
        headers["host"] = host
    req = urllib.request.Request(url, body or json.dumps(msg).encode(), headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status
    except urllib.error.HTTPError as e:
        return e.code


def get_status(url: str) -> int:
    try:
        with urllib.request.urlopen(url, timeout=30) as resp:
            return resp.status
    except urllib.error.HTTPError as e:
        return e.code


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def logged(log: Path, count: int) -> str:
    """The COUNT-th request line in LOG, waiting for the server to write it,
    or "" if it never does."""
    for _ in range(100):
        lines = [
            line
            for line in log.read_text().splitlines()
            if line.startswith("taskgo mcp: request ")
        ]
        if len(lines) >= count:
            return lines[count - 1]
        time.sleep(0.05)
    return ""


def serve(repo: Path, port: int, log: Path, *args: str, env: dict | None = None):
    proc = subprocess.Popen(
        [
            str(CLI),
            "--root",
            str(repo),
            "mcp",
            "--no-fetch",
            "--port",
            str(port),
            *args,
        ],
        stdout=subprocess.DEVNULL,
        stderr=log.open("w"),
        env=env,
    )
    url = f"http://127.0.0.1:{port}/mcp"
    for _ in range(300):
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=1):
                return proc, url
        except OSError:
            if proc.poll() is not None:
                break
            time.sleep(0.1)
    proc.kill()
    sys.exit(f"auth-check: taskgo mcp did not start on port {port}")


def main() -> None:
    bypass_proxy_for_loopback()
    key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    other = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    jwks = json.dumps({"keys": [jwk(key, "k1")]}).encode()

    class Certs(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            self.send_response(200)
            self.send_header("content-type", "application/json")
            self.end_headers()
            self.wfile.write(jwks)

        def log_message(self, *args):
            pass

    httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Certs)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    certs = f"http://127.0.0.1:{httpd.server_address[1]}/certs"

    now = int(time.time())
    # Name, token, status, and what the log line says of it.
    cases = [
        ("valid token", token(key, "k1"), 200, "outcome=ok"),
        (
            "audience in a list of several",
            token(key, "k1", aud=["x", AUD]),
            200,
            "outcome=ok",
        ),
        ("no token", None, 401, 'reason="no Access token"'),
        ("malformed token", "not.a.jwt", 403, "outcome=refused"),
        ("unsigned token", token(key, "k1", alg="none"), 403, "outcome=refused"),
        ("wrong audience", token(key, "k1", aud=["other"]), 403, "another application"),
        ("expired", token(key, "k1", exp=now - 600), 403, "expired"),
        ("not yet valid", token(key, "k1", nbf=now + 600), 403, "outcome=refused"),
        ("no expiry", token(key, "k1", exp=None), 403, "outcome=refused"),
        (
            "wrong issuer",
            token(key, "k1", iss="https://evil.invalid"),
            403,
            "another team",
        ),
        ("forged signature", token(other, "k1"), 403, "Signature"),
        ("unknown key", token(key, "k2"), 403, "outcome=refused"),
    ]
    # Over --auth none: name, path, body, status, and the log line's fields.
    call = {"jsonrpc": "2.0", "id": 3, "method": "tools/call"}
    outcomes = [
        (
            "a tool call",
            "/mcp",
            {**call, "params": {"name": "list_projects"}},
            200,
            ("tool=list_projects outcome=ok", "commit="),
        ),
        (
            "an unknown tool",
            "/mcp",
            {**call, "params": {"name": "no such tool"}},
            200,
            ('tool="no such tool" outcome=tool-error', 'reason="unknown tool"'),
        ),
        (
            "an unknown method",
            "/mcp",
            {"jsonrpc": "2.0", "id": 4, "method": "bogus/method"},
            200,
            ("method=bogus/method outcome=rpc-error", "not found"),
        ),
        (
            "a notification",
            "/mcp",
            {"jsonrpc": "2.0", "method": "notifications/initialized"},
            202,
            ("outcome=ok status=202",),
        ),
        ("a parse error", "/mcp", b"{", 400, ("outcome=rpc-error", "parse error")),
        ("an unknown path", "/other", None, 404, ("outcome=refused", "/other")),
    ]
    print(f"1..{len(cases) + len(outcomes) + 7}")
    failed = 0
    with tempfile.TemporaryDirectory() as tmp:
        repo = Path(tmp)
        subprocess.run(["git", "init", "-q", "-b", "main", str(repo)], check=True)
        subprocess.run(
            [
                "git",
                "-C",
                str(repo),
                "-c",
                "user.name=Taskgo Test",
                "-c",
                "user.email=taskgo@example.com",
                "commit",
                "-q",
                "--allow-empty",
                "-m",
                "chore: start",
            ],
            check=True,
        )
        env = dict(os.environ, TASKGO_MCP_ACCESS_CERTS_URL=certs)
        log = Path(tmp) / "access.log"
        proc, url = serve(
            repo,
            free_port(),
            log,
            "--access-team",
            TEAM,
            "--access-aud",
            AUD,
            env=env,
        )
        try:
            for n, (name, tok, want, says) in enumerate(cases, 1):
                got = status(url, tok)
                line = logged(log, n)
                ok = (
                    got == want
                    and says in line
                    and f"status={want}" in line
                    # A refused request's body is never read.
                    and (
                        "transport=http http=POST "
                        + ("method=ping " if want == 200 else "outcome")
                    )
                    in line
                )
                failed += not ok
                print(f"{'ok' if ok else 'not ok'} {n} - {name}: {got} (want {want})")
                if not ok:
                    print(f"# {line}")
            # A write is refused at the door like any other request.
            write = {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "tools/call",
                "params": {
                    "name": "create",
                    "arguments": {"project": "x", "title": "x", "request_id": "x"},
                },
            }
            n += 1
            got = status(url, token(key, "k1", exp=now - 600), msg=write)
            ok = got == 403 and "outcome=refused" in logged(log, n)
            failed += not ok
            print(
                f"{'ok' if ok else 'not ok'} {n} - expired token on a write: {got} "
                "(want 403)"
            )
            base = url.removesuffix("/mcp")
            for path, want, name in (
                ("/up", 200, "health check needs no token"),
                ("/mcp", 401, "GET on the endpoint needs a token"),
            ):
                n += 1
                got = get_status(base + path)
                ok = got == want
                failed += not ok
                print(f"{'ok' if ok else 'not ok'} {n} - {name}: {got} (want {want})")
        finally:
            proc.terminate()
            proc.wait()
        n += 1
        text = log.read_text()
        lines = [x for x in text.splitlines() if x.startswith("taskgo mcp: request ")]
        # The health check is not logged; the GET on the endpoint is.
        ok = len(lines) == len(cases) + 2 and not any(
            tok and tok in text for _, tok, _, _ in cases
        )
        failed += not ok
        print(f"{'ok' if ok else 'not ok'} {n} - one line per request, no tokens")

        log = Path(tmp) / "none.log"
        proc, url = serve(repo, free_port(), log, "--auth", "none")
        try:
            for host, want, name in (
                (None, 200, "auth none serves loopback"),
                ("tracker.example.com", 403, "auth none refuses another host"),
            ):
                n += 1
                got = status(url, None, host)
                ok = got == want and (want == 200 or "loopback" in logged(log, 2))
                failed += not ok
                print(f"{'ok' if ok else 'not ok'} {n} - {name}: {got} (want {want})")
            base = url.removesuffix("/mcp")
            for k, (name, path, msg, want, says) in enumerate(outcomes, 3):
                n += 1
                if isinstance(msg, bytes):
                    got = status(base + path, None, body=msg)
                else:
                    got = status(base + path, None, msg=msg)
                line = logged(log, k)
                ok = got == want and all(x in line for x in says) and " ms=" in line
                failed += not ok
                print(f"{'ok' if ok else 'not ok'} {n} - logs {name}: {got}")
                if not ok:
                    print(f"# {line}")
        finally:
            proc.terminate()
            proc.wait()

        n += 1
        res = subprocess.run(
            [str(CLI), "--root", str(repo), "mcp", "--no-fetch", "--host", "0.0.0.0"],
            capture_output=True,
            text=True,
            env={k: v for k, v in os.environ.items() if not k.startswith("TASKGO_MCP")},
            timeout=60,
            check=False,
        )
        ok = res.returncode != 0 and "Access needs" in res.stderr
        failed += not ok
        print(f"{'ok' if ok else 'not ok'} {n} - refuses to start without Access")
    httpd.shutdown()
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
