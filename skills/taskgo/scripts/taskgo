class McpGate:
    """ASGI, in front of the SDK's app: the health check, the log page, the
    endpoint's path, Access or the loopback guard, the size limit, and one
    log record for each request. The SDK sees only requests that pass, and
    never a token check."""

    def __init__(
        self, app: Any, verifier: "AccessVerifier | None", path: str, log: McpLog
    ):
        self.app = app
        self.verifier = verifier
        self.path = path
        self.log = log
        self.claim_sets: set[frozenset[str]] = set()

    async def __call__(self, scope: dict, receive: Callable, send: Callable) -> None:
        if scope["type"] != "http":  # lifespan
            await self.app(scope, receive, send)
            return
        headers: dict[str, str] = {}
        for k, v in scope["headers"]:
            headers.setdefault(k.decode("latin-1").lower(), v.decode("latin-1"))
        if scope["path"] == MCP_HEALTH_PATH and scope["method"] == "GET":
            # Polled by the proxy, so not logged.
            await mcp_asgi_reply(send, 200, "ok")
            return
        if scope["method"] == "GET" and MCP_ICON_PATHS.fullmatch(scope["path"]):
            await mcp_asgi_reply(send, 404, "not found")
            return
        event = McpEvent(
            "http",
            time.monotonic(),
            http=scope["method"],
            agent=headers.get("user-agent"),
        )
        token = MCP_EVENT.set(event)
        quiet = False
        try:
            if scope["path"] in (MCP_LOGS_PATH, MCP_LOGS_DATA_PATH):
                quiet = await self.logs(scope, send, headers, event)
            else:
                await self.serve(scope, receive, send, headers, event)
        except BaseException as e:
            event.fail("error", type(e).__name__)
            quiet = False
            raise
        finally:
            MCP_EVENT.reset(token)
            if not quiet:
                self.log.emit(event)

    async def logs(
        self, scope: dict, send: Callable, headers: dict[str, str], event: McpEvent
    ) -> bool:
        """Serves the log page, or the records after the page's cursor with
        stats over those kept. True if it did: the page polls every second,
        so only refusals are logged."""
        from urllib.parse import parse_qs

        refusal = self.refusal(headers, event)
        if refusal is None and scope["method"] != "GET":
            refusal = 405, "method not allowed", "method not allowed"
        if refusal:
            status, reason, text = refusal
            event.fail("refused", reason)
            event.status = status
            allow = "GET" if status == 405 else None
            await mcp_asgi_reply(send, status, text, allow=allow)
            return False
        private = (("cache-control", "no-store"), ("x-content-type-options", "nosniff"))
        if scope["path"] == MCP_LOGS_PATH:
            await mcp_asgi_reply(
                send,
                200,
                MCP_LOGS_PAGE,
                content_type="text/html; charset=utf-8",
                extra=(*private, ("content-security-policy", MCP_LOGS_CSP)),
            )
            return True
        query = parse_qs(scope.get("query_string", b"").decode("latin-1"))
        try:
            after = int(query.get("after", ["0"])[0])
        except ValueError:
            after = 0
        if query.get("server", [""])[0] != self.log.instance:
            # Another process's cursor, as after a restart: start over.
            after = 0
        payload = {
            "server": self.log.instance,
            "version": MCP_SERVER_VERSION,
            "next": self.log.seq,
            "records": self.log.since(after),
            "stats": mcp_log_stats([rec for _, rec in self.log.recent]),
        }
        await mcp_asgi_reply(
            send,
            200,
            json.dumps(payload, separators=(",", ":")),
            content_type="application/json",
            extra=private,
        )
        return True

    async def serve(
        self,
        scope: dict,
        receive: Callable,
        send: Callable,
        headers: dict[str, str],
        event: McpEvent,
    ) -> None:
        async def sending(message: dict) -> None:
            if message["type"] == "http.response.start":
                event.status = message["status"]
            elif message["type"] == "http.response.body" and event.outcome == "ok":
                try:
                    reply = json.loads(message.get("body") or b"null")
                except ValueError:
                    reply = None
                if isinstance(reply, dict) and isinstance(reply.get("error"), dict):
                    event.fail("rpc-error", mcp_rpc_reason(reply["error"].get("code")))
            await send(message)

        if scope["path"] != self.path:
            refusal = 404, f"not found: {scope['path']}", "not found"
        else:
            refusal = self.refusal(headers, event)
        if refusal:
            status, reason, text = refusal
            event.fail("refused", reason)
            await mcp_asgi_reply(sending, status, text)
            return
        if scope["method"] != "POST":
            # No server-initiated stream, and no sessions to delete.
            event.fail("refused", "method not allowed")
            await mcp_asgi_reply(sending, 405, "method not allowed", allow="POST")
            return
        body = await self.body(receive, headers)
        if body is None:
            event.fail("refused", "request too large")
            await mcp_asgi_reply(sending, 413, "request too large")
            return
        if body is False:
            # Gone before the body arrived: nothing to answer.
            event.fail("error", "client disconnected")
            return
        try:
            msg = json.loads(body)
        except ValueError:
            msg = None
        if isinstance(msg, dict):
            event.method = msg.get("method")

        delivered = False

        async def replay() -> dict:
            nonlocal delivered
            if delivered:
                return await receive()
            delivered = True
            return {"type": "http.request", "body": body, "more_body": False}

        await self.app(scope, replay, sending)

    def refusal(
        self, headers: dict[str, str], event: McpEvent
    ) -> tuple[int, str, str] | None:
        """(status, reason, text) when the request may not proceed. A request
        with an Access token gets its caller key from the token's claims."""
        from urllib.parse import urlsplit

        if self.verifier is None:
            # Unauthenticated mode serves only requests addressed to a
            # loopback name, from a page on one if from a browser at all.
            origin = headers.get("origin")
            if not mcp_is_loopback(headers.get("host")):
                return 403, "not addressed to a loopback name", "forbidden"
            if origin and not mcp_is_loopback(urlsplit(origin).netloc):
                return 403, "from a page not on a loopback name", "forbidden"
            return None
        token = headers.get("cf-access-jwt-assertion")
        if not token:
            return 401, "no Access token", "Cloudflare Access token required"
        try:
            claims = self.verifier.verify(token)
        except McpAuthError as e:
            return 403, str(e), str(e)
        event.caller = mcp_caller(*(claims.get(k) for k in MCP_CALLER_CLAIMS))
        names = frozenset(claims)
        if names not in self.claim_sets:
            # Names only, once for each kind of token (a browser's, a
            # client's): what a caller key could be built from.
            self.claim_sets.add(names)
            mcp_log("Access token claims: " + " ".join(sorted(names)))
        return None

    @staticmethod
    async def body(
        receive: Callable, headers: dict[str, str]
    ) -> bytes | Literal[False] | None:
        """The request body, None if it is larger than the limit, or False if
        the client disconnected before sending all of it."""
        try:
            length = int(headers.get("content-length") or 0)
        except ValueError:
            length = -1
        if length < 0 or length > MCP_MAX_REQUEST_BYTES:
            return None
        body = b""
        more = True
        while more:
            message = await receive()
            if message["type"] == "http.disconnect":
                return False
            body += message.get("body", b"")
            if len(body) > MCP_MAX_REQUEST_BYTES:
                return None
            more = message.get("more_body", False)
        return body


def mcp_serve_http(
    server: McpServer, cfg: McpConfig, host: str, port: int, path: str
) -> None:
    import uvicorn
    from mcp.server.transport_security import TransportSecuritySettings

    verifier = (
        AccessVerifier(cfg.team or "", cfg.audience or "", cfg.certs_url)
        if cfg.auth == "access"
        else None
    )
    app = mcp_sdk_server(server).streamable_http_app(
        streamable_http_path=path,
        stateless_http=True,
        json_response=True,
        max_request_body_size=MCP_MAX_REQUEST_BYTES,
        # McpGate checks the Host and Origin headers, or the Access JWT.
        transport_security=TransportSecuritySettings(
            enable_dns_rebinding_protection=False
        ),
    )
    print(
        f"taskgo mcp: serving {display_path(cfg.repo)} on http://{host}:{port}{path} "
        f"(auth {cfg.auth}); request log {server.log.path}, page {MCP_LOGS_PATH}",
        file=sys.stderr,
    )
    uvicorn.run(
        McpGate(app, verifier, path, server.log),
        host=host,
        port=port,
        log_level="warning",
        access_log=False,
        server_header=False,
    )


def cmd_mcp(
    host: str = "127.0.0.1",
    port: int = 8789,
    path: str = "/mcp",
    remote: str = "origin",
    branch: str = "main",
    no_fetch: bool = False,
    local: bool = False,
    auth: str = "access",
    team: str | None = None,
    audience: str | None = None,
    stdio: bool = False,
    fetch_ttl: float = MCP_FETCH_TTL,
    log: str | None = None,
) -> None:
    """Serve the control repository over MCP: committed state, and writes."""
    root = get_repo_root()
    if not fetch_ttl >= 0:
        die_scoped(f"--fetch-ttl must be 0 or more seconds, not {fetch_ttl}")
    team = team or os.environ.get("TASKGO_MCP_ACCESS_TEAM")
    audience = audience or os.environ.get("TASKGO_MCP_ACCESS_AUD")
    if stdio:
        auth = "none"
    if auth == "access" and not (team and audience):
        die_scoped(
            "Access needs --access-team and --access-aud (or TASKGO_MCP_ACCESS_TEAM "
            "and TASKGO_MCP_ACCESS_AUD); --auth none serves loopback only"
        )
    if auth == "none" and not stdio and not mcp_is_loopback(host):
        die_scoped(f"--auth none serves loopback only, not {host}")
    if (
        not (no_fetch or local)
        and run_git(["remote", "get-url", remote], check=False).returncode
    ):
        die_scoped(
            f"no remote '{remote}' to fetch from; pass --no-fetch to read {branch}, "
            "or --local to read and write it"
        )
    cfg = McpConfig(
        repo=root,
        remote=None if (no_fetch or local) else remote,
        branch=branch,
        auth="access" if auth == "access" else "none",
        team=team,
        audience=audience,
        certs_url=os.environ.get("TASKGO_MCP_ACCESS_CERTS_URL") or None,
        fetch_ttl=fetch_ttl,
        local=local,
    )
    log_path = Path(log or os.environ.get(MCP_LOG_ENV) or mcp_log_default())
    # Only the HTTP server has a page to keep records in memory for.
    server = McpServer(cfg, McpLog(log_path.expanduser(), 0 if stdio else MCP_LOG_RING))
    if stdio:
        mcp_serve_stdio(server)
    else:
        mcp_serve_http(server, cfg, host, port, path)


def cmd_requests(
    log: str | None = None,
    days: float = 7,
    gap: float = MCP_CHAIN_GAP,
    as_json: bool = False,
) -> None:
    """Summarise the MCP server's request log."""
    if not days > 0:
        die_scoped(f"--days must be more than 0, not {days:g}")
    if not gap >= 0:
        die_scoped(f"--gap must be 0 or more seconds, not {gap:g}")
    path = Path(log or os.environ.get(MCP_LOG_ENV) or mcp_log_default()).expanduser()
    if not mcp_log_files(path):
        die_scoped(f"no request log at {path}")
    try:
        records = mcp_log_read(path, time.time() - days * 86400)
    except OSError as e:
        die_scoped(f"cannot read {path}: {e}")
    stats = mcp_log_stats(records, gap)
    if as_json:
        print(json.dumps({"log": str(path), "days": days, **stats}, indent=2))
        return

    def ms(value: int | None) -> str:
        return "-" if value is None else str(value)

    print(f"Log: {path} (last {days:g} days)")
    if not records:
        print("Requests: none")
        return
    print(f"Requests: {stats['requests']}, {stats['first']} to {stats['last']}")
    print("Outcomes: " + ", ".join(f"{k} {v}" for k, v in stats["outcomes"].items()))

    def clip(name: str) -> str:
        """A client's name, cut for its column; --json has all of it."""
        if len(name) <= MCP_CLIENT_MAX:
            return name
        return name[: MCP_CLIENT_MAX - 1] + "\u2026"

    for rows in (stats["agents"], stats["sequences"]):
        for row in rows:
            row["agent"] = clip(row["agent"])
    for key, title in (("agent", "Client"), ("tool", "Tool")):
        rows = stats[f"{key}s"]
        if not rows:
            continue
        width = max(len(title), *(len(r[key]) for r in rows))
        print(f"\n{title:<{width}}  Requests  Failed  p50 ms  p95 ms  p50 bytes")
        for r in rows:
            print(
                f"{r[key]:<{width}}  {r['requests']:>8}  {r['failed']:>6}  "
                f"{ms(r['p50_ms']):>6}  {ms(r['p95_ms']):>6}  {ms(r['p50_bytes']):>9}"
            )
    print(f"\nChains: {stats['chains']} (tool calls {gap:g} s apart or less)")
    if stats["sequences"]:
        width = max(len("Client"), *(len(q["agent"]) for q in stats["sequences"]))
        print(f"\nCount  {'Client':<{width}}  Sequence")
        for q in stats["sequences"]:
            print(f"{q['count']:>5}  {q['agent']:<{width}}  " + " > ".join(q["calls"]))


class HouseStyleHelpFormatter(argparse.RawDescriptionHelpFormatter):
    """Capitalizes argparse's fixed help headings to match the CLI house style."""

    def format_help(self) -> str:
        rendered = super().format_help()
        return (
            rendered.replace("usage:", "Usage:", 1)
            .replace("positional arguments:", "Arguments:", 1)
            .replace("options:", "Options:", 1)
            .replace(
                "show this help message and exit",
                "Display this help message and exit",
                1,
            )
        )


def help_text() -> str:
    """Renders top-level help, including the resolved control repository root."""
    root_dir, source = resolve_root_candidate()
    return f"""Usage: taskgo COMMAND [OPTIONS]

Maintain a private Git-backed personal project/task control repo.

Commands:
  id                               Allocate a unique task ID
  root                             Print the active control repository root
  create PROJECT TITLE [OPTIONS]   Create a new task (--slug, --problem, etc.)
  update TASK_ID [OPTIONS]         Update task fields, status, or headings
  apply CHANGES.json [--dry-run]   Apply a change set to the working tree
  edit PATH [OPTIONS]              Replace exact text in a file (--old, --new)
  list [PROJECT] [OPTIONS]         List tasks (--state ready for the frontier)
  info PROJECT [--json]            Show project metadata from README.md frontmatter
  skills PROJECT [--json]          Print the skills a project declares
  status [PROJECT|TASK_ID]         Show a task's or project's status
  handoff PROJECT|TASK_ID          Print agent instructions for a project or task
  sync [PROJECT]                   Update STATUS.md snapshot
  check [PROJECT] [--json]         Sweep wait_for gates and date horizons
  doctor [PROJECT]                 Run mechanical checks (read-only)
  fix [PROJECT] [OPTIONS]          Auto-heal IDs, statuses, and snapshots
  history PATH_OR_TASK_ID [FIELD]  Show frontmatter history
  read PATH [OPTIONS]              Print lines of a file (--start-line, --end-line)
  search [OPTIONS] GREP_ARGS...    Search file contents with git grep (--at, --json)
  checkpoint TASK_ID SUBJECT [...] Commit an authorized tracker checkpoint (--all)
  commit SUBJECT [OPTIONS]         Commit a logical transition
  schema [--json]                  Show the task, decision, and STATUS schema
  mcp [OPTIONS]                    Serve the tracker to MCP clients

Options:
  -R, --root DIR  Operate on the control repository at DIR instead of the
                  default (~/.projects); overrides TASKGO_ROOT. Must appear
                  before COMMAND.
  --help, -h      Display this help message and exit

Environment:
  Root: {display_path(root_dir)}
  Source: {source}

Examples:
  taskgo id
  taskgo create my-project "Diagnose intermittent disconnects" --slug disconnects
  taskgo create my-project "Add cache layer" --slug cache-layer --problem "High latency"
  taskgo update TASK-3A91F --status in-progress --sketch "Use in-memory dict"
  taskgo handoff TASK-3A91F
  taskgo sync my-project
  taskgo fix my-project
  taskgo checkpoint TASK-3A91F "project: start diagnosis" --all"""


def add_set_field_options(parser: argparse.ArgumentParser, removable: bool) -> None:
    """Adds --add-FIELD (and --remove-FIELD) options for the task set fields."""
    for spec in TASK_SCHEMA.set_fields():
        if spec.option is None:
            continue
        vt = VALUE_TYPES[spec.value]
        parser.add_argument(
            f"--add-{spec.option}",
            dest=f"add_{spec.name}",
            action="append",
            default=None,
            metavar=vt.metavar,
            help=f"Add to {spec.name} (repeatable; repeats are no-ops)",
        )
        if removable:
            parser.add_argument(
                f"--remove-{spec.option}",
                dest=f"remove_{spec.name}",
                action="append",
                default=None,
                metavar=vt.metavar,
                help=f"Remove from {spec.name} (repeatable; absent values are no-ops)",
            )


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="taskgo",
        description="Maintain a private Git-backed personal project/task control repo.",
        formatter_class=HouseStyleHelpFormatter,
        add_help=False,
    )
    parser.add_argument(
        "--help",
        "-h",
        action="store_true",
        help="Display this help message and exit",
    )
    parser.add_argument(
        "--root",
        "-R",
        metavar="DIR",
        default=None,
        help=(
            "Control repository to operate on (default: ~/.projects, "
            "overridden by TASKGO_ROOT); must appear before COMMAND"
        ),
    )

    subparsers = parser.add_subparsers(dest="command", metavar="COMMAND")

    # id
    subparsers.add_parser(
        "id",
        help="Allocate a unique task ID",
        description="Allocate a unique task ID.",
        formatter_class=HouseStyleHelpFormatter,
    )

    # root
    subparsers.add_parser(
        "root",
        help="Print the active control repository root",
        description=(
            "Print the resolved control repository root (the directory all "
            "commands operate on), after validation."
        ),
        formatter_class=HouseStyleHelpFormatter,
    )

    # create
    p_create = subparsers.add_parser(
        "create",
        help="Create a new task in PROJECT",
        description="Create a new task in PROJECT.",
        formatter_class=HouseStyleHelpFormatter,
        epilog="""Examples:
  taskgo create my-project "Diagnose intermittent disconnects" --slug disconnects
  taskgo create my-project "Add a read-through cache layer in front of the resolver" \\
    --slug cache-layer --problem "High latency" --goal "Sub-10ms"
  taskgo create --status in-progress my-project "Initial implementation" --slug initial-impl

TITLE is prose for humans (it becomes the H1 and appears in STATUS.md); SLUG is
the filename mnemonic. A slug derived from a long TITLE keeps the leading words,
which are rarely the distinguishing ones, so pass --slug whenever TITLE is longer
than a few words.""",
    )
    p_create.add_argument("project_name", metavar="PROJECT", help="Project identifier")
    p_create.add_argument("title", metavar="TITLE", help="Task title")
    p_create.add_argument(
        "--slug",
        default=None,
        metavar="SLUG",
        help=f"Filename mnemonic, max {SLUG_MAX_LEN} chars (default: derived from TITLE)",
    )
    p_create.add_argument(
        "--status",
        "-s",
        default="todo",
        help="Initial task state (default: todo)",
    )
    p_create.add_argument("--problem", "-p", default=None, help="Problem description")
    p_create.add_argument(
        "--cost", default=None, help="Consequences of leaving the task undone"
    )
    p_create.add_argument("--goal", "-g", default=None, help="Goal description")
    p_create.add_argument(
        "--criteria", "-c", default=None, help="Observable end condition"
    )
    p_create.add_argument("--sketch", default=None, help="Implementation sketch")
    p_create.add_argument("--constraints", default=None, help="Constraints")
    p_create.add_argument("--outcome", default=None, help="Outcome description")
    p_create.add_argument("--findings", default=None, help="Findings")
    p_create.add_argument("--next", dest="next_steps", default=None, help="Next steps")
    p_create.add_argument(
        "--conv",
        "-C",
        "--conversation",
        dest="conv",
        default=None,
        help="Active conversation or session ID",
    )
    p_create.add_argument(
