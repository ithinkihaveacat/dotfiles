# Keep track of active child processes for clean teardown on signal
_active_subprocesses: set[subprocess.Popen] = set()
_received_sigterm: bool = False


def reap_subprocesses(signaled_by_parent: bool = True) -> None:
    """Gracefully tear down active subprocesses in compliance with POSIX standards."""
    for proc in list(_active_subprocesses):
        if proc.poll() is not None:
            _active_subprocesses.discard(proc)
            continue

        try:
            proc.terminate()
        except ProcessLookupError:
            pass

        try:
            proc.wait(timeout=1.5)
        except subprocess.TimeoutExpired:
            try:
                proc.kill()
            except ProcessLookupError:
                pass
            try:
                proc.wait(timeout=1.0)
            except (subprocess.TimeoutExpired, ProcessLookupError):
                pass

        _active_subprocesses.discard(proc)


def handle_signal_exit(signum: int) -> None:
    # Protect teardown logic from re-entrant signals
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

    reap_subprocesses(signaled_by_parent=(signum == signal.SIGTERM))
    try:
        sys.stderr.write("\n")
        sys.stderr.flush()
    except OSError:
        pass
    sys.exit(128 + signum)


def sigterm_handler(signum, frame):
    handle_signal_exit(signal.SIGTERM)


def sigint_handler(signum, frame):
    handle_signal_exit(signal.SIGINT)


def die(msg: str, exit_code: int = 1) -> None:
    print(f"taskgo: {msg}", file=sys.stderr)
    sys.exit(exit_code)


_ACTIVE_COMMAND: str | None = None


def die_scoped(msg: str, exit_code: int = 1) -> None:
    """Dies with a git-style subcommand-scoped message (taskgo list: ...)."""
    if _ACTIVE_COMMAND:
        print(f"taskgo {_ACTIVE_COMMAND}: {msg}", file=sys.stderr)
        sys.exit(exit_code)
    die(msg, exit_code)


_REPO_ROOT_CACHE: Path | None = None
_EXPLICIT_ROOT: Path | None = None
DEFAULT_ROOT = "~/.projects"


def set_explicit_root(value: str | None) -> None:
    """Records an explicitly selected control repository root (--root option)."""
    global _EXPLICIT_ROOT
    if value:
        _EXPLICIT_ROOT = Path(value).expanduser()


def resolve_root_candidate() -> tuple[Path, str]:
    """Returns the configured root path and its source for error messages."""
    if _EXPLICIT_ROOT is not None:
        return _EXPLICIT_ROOT, "--root"
    env_root = os.environ.get("TASKGO_ROOT")
    if env_root:
        return Path(env_root).expanduser(), "TASKGO_ROOT"
    return Path(DEFAULT_ROOT).expanduser(), "default"


def display_path(path: Path) -> str:
    """Renders a path with a ~ prefix when anchored under $HOME.

    Keeps help and doctor output identical across machines (and under the
    sandboxed HOME used by command-index-format), matching bin/skill's
    clean_p() convention.
    """
    home = str(Path.home())
    s = str(path)
    if s.startswith(home):
        return "~" + s[len(home) :]
    return s


def get_repo_root() -> Path:
    global _REPO_ROOT_CACHE
    if _REPO_ROOT_CACHE is not None:
        return _REPO_ROOT_CACHE

    root_dir, source = resolve_root_candidate()
    shown = DEFAULT_ROOT if source == "default" else f"'{root_dir}'"
    if not root_dir.is_dir():
        hint = ""
        if source == "default":
            hint = (
                " (initialize it with: mkdir -p ~/.projects && git -C ~/.projects init)"
            )
        die_scoped(f"control repository {shown} does not exist{hint}")
    if not (root_dir / ".git").exists():
        die_scoped(f"control repository {shown} is not a Git repository (missing .git)")
    _REPO_ROOT_CACHE = root_dir.resolve()
    return _REPO_ROOT_CACHE


def run_git(
    args: list[str],
    cwd: Path | None = None,
    check: bool = True,
    capture_output: bool = True,
    text: bool = True,
    input_data: str | bytes | None = None,
) -> subprocess.CompletedProcess:
    if cwd is None:
        cwd = get_repo_root()
    cmd = ["git", *args]
    proc = subprocess.Popen(
        cmd,
        cwd=cwd,
        stdin=subprocess.PIPE if input_data is not None else None,
        stdout=subprocess.PIPE if capture_output else None,
        stderr=subprocess.PIPE if capture_output else None,
        text=text,
    )
    _active_subprocesses.add(proc)
    try:
        stdout, stderr = proc.communicate(input=input_data)
    finally:
        _active_subprocesses.discard(proc)

    empty = "" if text else b""
    ret = subprocess.CompletedProcess(
        cmd, proc.returncode, stdout or empty, stderr or empty
    )
    if check and ret.returncode != 0:
        if ret.stderr:
            sys.stderr.write(
                ret.stderr if text else ret.stderr.decode("utf-8", "replace")
            )
        die(f"git {' '.join(args)} failed (exit {ret.returncode})")
    return ret


def atomic_write(path: Path, content: str) -> None:
    """Atomically writes content to path using a PID-tagged temp file and os.replace."""
    tmp = path.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(content, encoding="utf-8")
    os.replace(tmp, path)


def write_markdown(path: Path, content: str) -> None:
    """Formats Markdown content and writes it atomically.

    Every CLI writer goes through here so touched files are always formatted
    and untouched files are never rewritten.
    """
    atomic_write(path, format_markdown(content))


# ===========================================================================
# Snapshots: the core's only access to repository files
# ===========================================================================


class ReadOnlySnapshotError(Exception):
    """Raised when a write reaches a snapshot that cannot be written."""


def path_key(rel: str) -> list[str]:
    """Sort key ordering relative paths component by component, as Path does."""
    return rel.split("/")


def join_rel(*parts: str) -> str:
    """Joins relative path parts, skipping empty ones ('' is the root)."""
    return "/".join(p for p in parts if p)


class Snapshot:
    """Files of a control repository, addressed by relative POSIX path.

    Parsing, validation, rendering, audit, and edit operations read and write
    only through this interface, so the same code runs over a working tree
    (FsSnapshot) or a Git commit (GitTreeSnapshot). '' names the root.
    """

    def read_text(self, rel: str) -> str:
        """Returns the file's UTF-8 text; raises OSError when it is absent."""
        raise NotImplementedError

    def is_file(self, rel: str) -> bool:
        raise NotImplementedError

    def is_dir(self, rel: str) -> bool:
        raise NotImplementedError

    def list_dir(self, rel: str) -> list[str]:
        """Sorted entry names of directory REL; empty when it is not one."""
        raise NotImplementedError

    def write_text(self, rel: str, text: str) -> None:
        """Writes TEXT to REL, creating parent directories."""
        raise ReadOnlySnapshotError(f"cannot write {rel}: snapshot is read-only")

    def rename(self, src: str, dst: str) -> None:
        raise ReadOnlySnapshotError(f"cannot rename {src}: snapshot is read-only")

    def exists(self, rel: str) -> bool:
        return self.is_file(rel) or self.is_dir(rel)

    def write_markdown(self, rel: str, content: str) -> None:
        """Formats Markdown content and writes it.

        Every writer goes through here so touched files are always formatted
        and untouched files are never rewritten.
        """
        self.write_text(rel, format_markdown(content))

    def glob_md(self, rel_dir: str) -> list[str]:
        """Relative paths of the *.md files directly in REL_DIR."""
        return [
            join_rel(rel_dir, name)
            for name in self.list_dir(rel_dir)
            if name.endswith(".md") and self.is_file(join_rel(rel_dir, name))
        ]

    def walk_md(self, rel_dir: str) -> list[str]:
        """Relative paths of every *.md file under REL_DIR, in path order."""
        out: list[str] = []
        for name in self.list_dir(rel_dir):
            rel = join_rel(rel_dir, name)
            if self.is_dir(rel):
                out.extend(self.walk_md(rel))
            elif name.endswith(".md") and self.is_file(rel):
                out.append(rel)
        return sorted(out, key=path_key)


class FsSnapshot(Snapshot):
    """A working tree on disk. Reads and writes go straight to the files."""

    def __init__(self, root: Path):
        self.root = root

    def path(self, rel: str) -> Path:
        return self.root / rel if rel else self.root

    def read_text(self, rel: str) -> str:
        return self.path(rel).read_text(encoding="utf-8")

    def is_file(self, rel: str) -> bool:
        return self.path(rel).is_file()

    def is_dir(self, rel: str) -> bool:
        return self.path(rel).is_dir()

    def list_dir(self, rel: str) -> list[str]:
        p = self.path(rel)
        return sorted(c.name for c in p.iterdir()) if p.is_dir() else []

    def write_text(self, rel: str, text: str) -> None:
        p = self.path(rel)
        p.parent.mkdir(parents=True, exist_ok=True)
        atomic_write(p, text)

    def rename(self, src: str, dst: str) -> None:
        self.path(src).rename(self.path(dst))

    def walk_md(self, rel_dir: str) -> list[str]:
        # Only files Git would track: ignored paths (such as a nested external
        # checkout) are someone else's files.
        listed = run_git(
            [
                "ls-files",
                "-z",
                "--cached",
                "--others",
                "--exclude-standard",
                "--",
                rel_dir or ".",
            ],
            cwd=self.root,
            check=False,
        )
        if listed.returncode == 0:
            return sorted(
                {
                    rel
                    for rel in listed.stdout.split("\0")
                    if rel.endswith(".md") and self.is_file(rel)
                },
                key=path_key,
            )
        # Not a work tree. rglob does not descend into symlinked directories;
        # keep that.
        return sorted(
            (
                p.relative_to(self.root).as_posix()
                for p in self.path(rel_dir).rglob("*.md")
                if p.is_file()
            ),
            key=path_key,
        )


class GitTreeSnapshot(Snapshot):
    """The tree of one Git commit, read without a checkout. Read-only.

    Lists the tree once and reads Markdown blobs in a single batch on first
    use, so a whole-repository render costs two Git processes.
    """

    def __init__(self, repo: Path, rev: str):
        self.repo = repo
        resolved = run_git(["rev-parse", "--verify", f"{rev}^{{commit}}"], cwd=repo)
        self.rev = resolved.stdout.strip()
        self.blobs: dict[str, str] = {}
        self.modes: dict[str, str] = {}
        self.children: dict[str, set[str]] = {"": set()}
        out = run_git(["ls-tree", "-r", "-z", "--full-tree", self.rev], cwd=repo)
        for entry in filter(None, out.stdout.split("\0")):
            meta, rel = entry.split("\t", 1)
            mode, kind, sha = meta.split()
            if kind != "blob" or mode not in ("100644", "100755"):
                continue
            self.blobs[rel] = sha
            self.modes[rel] = mode
            parts = rel.split("/")
            for i in range(len(parts)):
                parent = "/".join(parts[:i])
                self.children.setdefault(parent, set()).add(parts[i])
        self.texts: dict[str, str] | None = None

    def _load(self) -> dict[str, str]:
        if self.texts is None:
            md = [rel for rel in self.blobs if rel.endswith(".md")]
            self.texts = self._cat(md)
        return self.texts

    def _cat(self, rels: list[str]) -> dict[str, str]:
        if not rels:
            return {}
        shas = "".join(f"{self.blobs[rel]}\n" for rel in rels)
        raw = run_git(
            ["cat-file", "--batch"],
            cwd=self.repo,
            text=False,
            input_data=shas.encode(),
        ).stdout
        texts: dict[str, str] = {}
        pos = 0
        for rel in rels:
            nl = raw.index(b"\n", pos)
            size = int(raw[pos:nl].split()[2])
            texts[rel] = raw[nl + 1 : nl + 1 + size].decode("utf-8")
            pos = nl + 1 + size + 1
        return texts

    def read_text(self, rel: str) -> str:
        if rel not in self.blobs:
            raise FileNotFoundError(f"{rel} is not in {self.rev[:12]}")
        texts = self._load()
        if rel not in texts:
            texts.update(self._cat([rel]))
        return texts[rel]

    def is_file(self, rel: str) -> bool:
        return rel in self.blobs

    def is_dir(self, rel: str) -> bool:
        return rel in self.children

    def list_dir(self, rel: str) -> list[str]:
        return sorted(self.children.get(rel, ()))


def is_project(snap: Snapshot, name: str) -> bool:
    if name.startswith(".") or not snap.is_dir(name):
        return False
    return snap.is_file(f"{name}/README.md") or snap.is_file(f"{name}/PROJECT.md")


def list_projects(snap: Snapshot) -> list[str]:
    return [name for name in snap.list_dir("") if is_project(snap, name)]


def check_project_name(project_name: str) -> None:
    if (
        "/" in project_name
        or "\\" in project_name
        or ".." in project_name
        or not project_name
        or project_name.startswith(".")
    ):
        die(
            f"invalid project name (must be a top-level directory and cannot start with a dot): {project_name}"
        )


def require_project(snap: Snapshot, project_name: str) -> str:
    """Validates PROJECT_NAME and dies unless it names a directory."""
    check_project_name(project_name)
    if snap.is_file(project_name):
        die(
            f"invalid project name (a file with this name already exists): {project_name}"
        )
    if not snap.is_dir(project_name):
        die(f"unknown project: {project_name}")
    return project_name


def parse_frontmatter(content: str) -> tuple[dict[str, Any], str]:
    """Tolerant frontmatter parser using ruamel.yaml. Returns (dict_of_fields, body_without_fm)."""
    match = re.search(r"^---\n(.*?)\n---(?:\n|$)", content, re.DOTALL)
    if not match:
        return {}, content

    frontmatter_str = match.group(1)
    body = content[match.end() :]

    yaml = YAML()
    try:
        data = yaml.load(frontmatter_str)
        if not isinstance(data, dict):
            data = {}
    except Exception:
        data = {}

    return {str(k).lower(): v for k, v in data.items()}, body


def parse_frontmatter_for_edit(content: str) -> tuple[Any, str]:
    """Loads frontmatter preserving raw ruamel.yaml CommentedMap and body."""
    match = re.search(r"^---\n(.*?)\n---(?:\n|$)", content, re.DOTALL)
    if not match:
        yaml = YAML()
        return yaml.load("{}"), content

    frontmatter_str = match.group(1)
    body = content[match.end() :]

    yaml = YAML()
    try:
        data = yaml.load(frontmatter_str)
        if not isinstance(data, dict):
            die("frontmatter must be a YAML mapping")
    except Exception as e:
        die(f"cannot parse YAML frontmatter: {e}")

    return data, body


def dump_frontmatter(data: Any) -> str:
    """Serializes frontmatter mapping to YAML string using ruamel.yaml."""
    yaml = YAML()
    yaml.width = WRAP_WIDTH
    yaml.preserve_quotes = True
    yaml.default_flow_style = False
    yaml.indent(mapping=2, sequence=4, offset=2)
    buf = io.StringIO()
    yaml.dump(data, buf)
    return f"---\n{buf.getvalue()}---\n"


def extract_frontmatter_field(content: str, key: str) -> str:
    fm, _ = parse_frontmatter(content)
    val = fm.get(key.lower(), "")
    if not val:
        m = re.search(
            rf"^{re.escape(key)}:\s*(.+)$", content, re.MULTILINE | re.IGNORECASE
        )
        if m:
            val = m.group(1).strip().strip("'\"")
    if isinstance(val, datetime):
        return val.date().isoformat()
    if isinstance(val, date):
        return val.isoformat()
    if isinstance(val, (list, dict)):
        return json.dumps(_to_jsonable(val))
    return str(val)


def extract_body(content: str) -> str:
    match = re.search(r"^---\n(.*?)\n---(?:\n|$)", content, re.DOTALL)
    return content[match.end() :] if match else content


def extract_title_from_body(body: str) -> str:
    """Extracts H1 title from task body (ATX-style '# Title' headings only; Setext not supported)."""
    body_no_code = re.sub(r"```.*?```", "", body, flags=re.DOTALL)
    for line in body_no_code.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return ""


def extract_title(content: str) -> str:
    """Extracts H1 title from task body (ATX-style '# Title' headings only; Setext not supported)."""
    body = extract_body(content)
    return extract_title_from_body(body)


def fenced_spans(body: str) -> list[tuple[int, int]]:
    """Character ranges of the fenced code blocks in BODY."""
    spans: list[tuple[int, int]] = []
    fence = None
    start = pos = 0
    for line in body.splitlines(keepends=True):
        m = re.match(r" {0,3}(`{3,}|~{3,})", line)
        if fence is None and m:
            fence, start = m.group(1), pos
        elif (
            fence is not None
            and m
            and m.group(1)[0] == fence[0]
            and len(m.group(1)) >= len(fence)
            and not line[m.end() :].strip()
        ):
            spans.append((start, pos + len(line)))
            fence = None
        pos += len(line)
    if fence is not None:
        spans.append((start, pos))
    return spans


def find_runins(body: str, label: str) -> list[tuple[int, int]]:
    """Spans of each bold run-in LABEL in BODY, from the label to its text's end.

    A run-in is '**Label:**' outside fenced code, in a paragraph that starts
    with a template run-in label: at the paragraph start, or after whitespace
    later in it (mdformat reflows adjacent run-ins into one paragraph). Bold
    labels elsewhere, such as '- **Cost:**' in an Outcome list, are not
    run-ins. Its text ends at a blank line followed by another bold label or a
    heading, at the whitespace before the next run-in in the same paragraph, or
    at the end of BODY.
    """
    fences = fenced_spans(body)
    labels = "|".join(re.escape(lbl) for lbl in RUNIN_LABELS)
    para_start = re.compile(rf"\*\*(?:{labels}):\*\*")

    def is_runin(i: int) -> bool:
        if any(a <= i < b for a, b in fences):
            return False
        p = body.rfind("\n\n", 0, i)
        p = 0 if p < 0 else p + 2
        return bool(para_start.match(body, p))

    stop = re.compile(rf"\n\n(?=\*\*|#)|\s+(?=\*\*(?:{labels}):\*\*)")
    spans = []
    for m in re.finditer(rf"(?<!\S)\*\*{re.escape(label)}:\*\*", body):
        if not is_runin(m.start()):
            continue
        end = len(body)
        for e in stop.finditer(body, m.end()):
            if any(a <= e.start() < b for a, b in fences):
                continue
            if e.group().startswith("\n\n") or is_runin(e.end()):
                end = e.start()
                break
        spans.append((m.start(), end))
    return spans


def find_sections(body: str, heading: str) -> tuple[list[tuple[int, int]], list[str]]:
    """Spans of each '## HEADING' section in BODY, and similar headings.

    The heading text must equal HEADING exactly. A section ends before the
    blank lines preceding the next level-1 or level-2 heading, or at the end of
    BODY. Headings inside fenced code are ignored. The second value lists
    level-2 headings that start with HEADING but are not equal to it (such as
    '## Outcome & Commit'), so callers can report them.
    """
    fences = fenced_spans(body)
    spans: list[tuple[int, int]] = []
    similar: list[str] = []
    start = None
    pos = 0
    for line in body.splitlines(keepends=True):
        if not any(a <= pos < b for a, b in fences):
            h = re.match(r"(#{1,2})[ \t]+(.*?)[ \t#]*$", line.rstrip("\n"))
            if h:
                if start is not None:
                    spans.append((start, len(body[:pos].rstrip())))
                    start = None
                if len(h.group(1)) == 2:
                    if h.group(2) == heading:
                        start = pos
                    elif re.match(rf"{re.escape(heading)}\b", h.group(2)):
                        similar.append(line.strip())
        pos += len(line)
    if start is not None:
        spans.append((start, len(body.rstrip())))
    return spans, similar


def extract_runin(content: str, label: str) -> str:
    """Extracts the text of a bold run-in label (e.g. '**Goal:** ...') from a task body.

    Returns the first such label's prose with internal newlines collapsed, or
    '' when the label is absent. Mirrors the run-in layout written by
    'create'/'update'.
    """
    body = extract_body(content)
    spans = find_runins(body, label)
    if not spans:
        return ""
    start, end = spans[0]
    return " ".join(body[start + len(f"**{label}:**") : end].split())


def section_hash(text: str) -> str:
    """The precondition hash of a section's exact text."""
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]


def record_sections(content: str, schema: "RecordSchema") -> list[dict[str, str]]:
    """The schema sections present in CONTENT, in schema order, with hashes.

    Each entry is {name, text, hash}: the title is its '# ' line, a run-in runs
    from its bold label to its text's end, a heading section from its '## '
    line to before the next level-1 or level-2 heading (or the generated
    block), and the generated section from BEGIN to END. A section that occurs
    more than once is listed once per occurrence.
    """
    body = extract_body(content)
    fences = fenced_spans(body)
    begin = body.find(BEGIN)
    out: list[dict[str, str]] = []
    for spec in schema.sections:
        spans: list[tuple[int, int]] = []
        if spec.form == "title":
            for m in re.finditer(r"^# .*$", body, re.MULTILINE):
                if not any(a <= m.start() < b for a, b in fences):
                    spans.append((m.start(), m.end()))
                    break
        elif spec.form == "run-in":
            spans = find_runins(body, spec.name)
        elif spec.form == "heading":
            found, _ = find_sections(body, spec.name)
            for a, b in found:
                if a < begin < b:
                    b = len(body[:begin].rstrip())
                spans.append((a, b))
        elif spec.form == "generated":
            end = body.find(END)
            if begin >= 0 and end > begin:
                spans.append((begin, end + len(END)))
        for a, b in spans:
            text = body[a:b]
            out.append({"name": spec.name, "text": text, "hash": section_hash(text)})
    return out


def normalize_slug(value: str) -> str:
    """Normalizes VALUE into slug form (lowercase, hyphen-separated, no truncation)."""
    s = value.lower()
    s = re.sub(r"[^a-z0-9]+", "-", s)
    s = re.sub(r"-+", "-", s)
    return s.strip("-")


def slugify(title: str, max_len: int = SLUG_MAX_LEN) -> str:
    """Derives a filename slug from TITLE, truncated at word boundaries."""
    s = normalize_slug(title)
    if len(s) <= max_len:
        return s
    words = s.split("-")
    kept: list[str] = []
    length = 0
    for word in words:
        extra = len(word) if not kept else len(word) + 1
        if length + extra > max_len:
            break
        kept.append(word)
        length += extra
    if not kept:
        # A single leading word exceeds the budget; hard-cut it rather than
        # return nothing.
        return words[0][:max_len]
    return "-".join(kept)


def filename_slug(name: str) -> str:
    """Extracts the slug of an already taskgo-named file (empty when not one)."""
    m = re.match(r"^TASK-[0-9A-F]{5}-(.+)$", name.removesuffix(".md"))
    return normalize_slug(m.group(1)) if m else ""


def normalize_status(raw_status: str) -> str:
    clean = raw_status.strip().lower().replace(" ", "-")
    return STATE_ALIASES.get(clean, clean if clean in STANDARD_STATES else "todo")


def get_task_files(snap: Snapshot, project_name: str | None = None) -> list[str]:
    """Relative paths of the task files in PROJECT_NAME, or in every project."""
    if project_name:
        projects = [require_project(snap, project_name)]
    else:
        projects = list_projects(snap)
    files = [f for p in projects for f in snap.glob_md(f"{p}/tasks")]
    return sorted(files, key=path_key)


ISO_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
DUE_SOON_DAYS = 7


def parse_iso_date(value: Any) -> date | None:
    """Parses a YYYY-MM-DD string or date object into a datetime.date, or None."""
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, datetime):
        return value.date()
    if isinstance(value, date):
        return value
    s = str(value).strip().strip("'\"")
    if not ISO_DATE_RE.match(s):
        return None
    try:
        return date.fromisoformat(s)
    except ValueError:
        return None


def repo_timezone_name(snap: Snapshot) -> str | None:
    """The timezone named in the root README.md frontmatter, if any."""
    try:
        fm, _ = parse_frontmatter(snap.read_text("README.md"))
    except OSError:
        return None
    name = str(fm.get("timezone") or "").strip()
    return name or None


def load_zone(name: str) -> ZoneInfo | None:
    """The ZoneInfo for IANA zone NAME, or None when it is not a known zone."""
    try:
        return ZoneInfo(name)
    except (ZoneInfoNotFoundError, ValueError):
        return None


def get_today(snap: Snapshot) -> date:
    """Returns today's calendar date for the repository.

    Stored dates are floating calendar days; the timezone only decides which
    day it is now. TASKGO_TODAY=YYYY-MM-DD wins, then the root README.md
    `timezone`, then the machine's local date (also when the zone is unknown,
    which doctor reports).
    """
    env_today = os.environ.get("TASKGO_TODAY")
    if env_today:
        parsed = parse_iso_date(env_today)
        if parsed is not None:
            return parsed
    name = repo_timezone_name(snap)
    zone = load_zone(name) if name else None
    if zone is not None:
        return datetime.now(zone).date()
    return datetime.now().astimezone().date()


def parse_blocked_by(fm: dict[str, Any]) -> tuple[str, ...]:
    """Reads the optional blocked_by edge list, tolerating a bare scalar."""
    return read_field(fm, TASK_SCHEMA.field("blocked_by"))


def parse_wait_for(fm: dict[str, Any]) -> tuple[str, ...]:
    """Reads the optional wait_for gate list, tolerating scalars and dates."""
    return read_field(fm, TASK_SCHEMA.field("wait_for"))


def parse_date_field(fm: dict[str, Any], key: str) -> str | None:
    """Reads an optional scalar date field (due, stale_after) as YYYY-MM-DD string."""
    values = read_field(fm, TASK_SCHEMA.field(key))
    return values[0] if values else None


def normalize_wait_for_args(raw_list: list[str]) -> list[str]:
    """Normalizes CLI --wait-for values into deduplicated gate tokens."""
    tokens: list[str] = []
    for entry in raw_list:
        for sub in re.split(r"[,\s]+", str(entry)):
            cleaned = sub.strip().strip("'\"")
            if cleaned:
                tokens.append(cleaned)
    return list(dict.fromkeys(tokens))


# Record schema. One declarative description per controlled record kind:
# frontmatter fields (scalar or set, value type, mutability), and body
# sections. Validation in create/update, the doctor field checks, and the
# create/update set options read it; `taskgo schema --json` publishes it as a
# conformance artifact for other implementations (such as an MCP server).
SCHEMA_VERSION = 1

GATE_PATTERN = (
    r"^(?:\d{4}-\d{2}-\d{2}|b/\d+|cl/\d+"
    r"|gh:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#\d+|@[A-Za-z0-9_.-]+|https?://\S+)$"
)


@dataclass(slots=True, frozen=True)
class ValueType:
    description: str
    check: Callable[[Any], bool]
    pattern: str | None = None
    values: tuple[str, ...] = ()
    metavar: str = "VALUE"


def _is_gate(value: Any) -> bool:
    token = str(value)
    if ISO_DATE_RE.match(token):
        return parse_iso_date(token) is not None
    return bool(re.match(GATE_PATTERN, token))


VALUE_TYPES: dict[str, ValueType] = {
    "task-id": ValueType(
        "Task ID: TASK- and five uppercase hex digits",
        lambda v: bool(ID_PATTERN.match(str(v))),
        ID_PATTERN.pattern,
        metavar="TASK_ID",
    ),
    "status": ValueType(
        "Task state",
        lambda v: str(v) in STANDARD_STATES,
        values=tuple(s.value for s in TaskStatus),
    ),
    "date": ValueType(
        "Calendar date, YYYY-MM-DD",
        lambda v: parse_iso_date(v) is not None,
        ISO_DATE_RE.pattern,
    ),
    "gate": ValueType(
        "External or temporal gate: YYYY-MM-DD, b/N, cl/N, "
        "gh:owner/repo#N, @handle, or an http(s) URL",
        _is_gate,
        GATE_PATTERN,
        metavar="GATE",
    ),
    "conversation": ValueType(
        "Conversation URI, <agent>://<id> (id of 16 or more characters)",
        lambda v: parse_conversation_entry(v) is not None,
        metavar="URI",
    ),
    "adr-ref": ValueType(
        "ADR filename, stem, or number in the same decisions/ directory",
        lambda v: bool(str(v).strip()),
    ),
    "text": ValueType("Free text", lambda v: True),
}


@dataclass(slots=True, frozen=True)
class FieldSpec:
    name: str
    shape: Literal["scalar", "set"]
    value: str
    required: bool = False
    mutable: bool = True
    invalid: Literal["INFO", "WARN", "FAIL"] = "WARN"
    aliases: tuple[str, ...] = ()
    option: str | None = None


@dataclass(slots=True, frozen=True)
class SectionSpec:
    name: str
    form: Literal["title", "run-in", "heading", "generated"]
    required: bool = False
    writable: bool = True


@dataclass(slots=True, frozen=True)
class RecordSchema:
    kind: str
    path: str
    fields: tuple[FieldSpec, ...]
    sections: tuple[SectionSpec, ...]

    def field(self, name: str) -> FieldSpec:
        return next(f for f in self.fields if f.name == name)

    def set_fields(self) -> tuple[FieldSpec, ...]:
        return tuple(f for f in self.fields if f.shape == "set")


TASK_SCHEMA = RecordSchema(
    kind="task",
    path="<project>/tasks/TASK-XXXXX-<slug>.md",
    fields=(
        FieldSpec("id", "scalar", "task-id", required=True, mutable=False),
        FieldSpec("status", "scalar", "status", required=True),
        FieldSpec("blocked_by", "set", "task-id", option="blocked-by"),
        FieldSpec("wait_for", "set", "gate", option="wait-for"),
        FieldSpec("due", "scalar", "date", invalid="FAIL"),
        FieldSpec("stale_after", "scalar", "date", invalid="FAIL"),
        FieldSpec(
            "conversations",
            "set",
            "conversation",
            invalid="INFO",
            aliases=("conversation",),
            option="conversation",
        ),
    ),
    sections=(
        SectionSpec("title", "title", required=True),
        SectionSpec("Problem", "run-in"),
        SectionSpec("Cost", "run-in"),
        SectionSpec("Goal", "run-in"),
        SectionSpec("Criteria", "run-in"),
        SectionSpec("Sketch", "run-in"),
        SectionSpec("Constraints", "run-in"),
        SectionSpec("Outcome", "heading"),
        SectionSpec("Findings", "heading"),
        SectionSpec("Next", "heading"),
    ),
)

DECISION_SCHEMA = RecordSchema(
    kind="decision",
    path="<project>/decisions/<NNN>-<slug>.md",
    fields=(
        FieldSpec("status", "scalar", "text"),
        FieldSpec("supersedes", "set", "adr-ref"),
    ),
    sections=(
        SectionSpec("title", "title", required=True),
        SectionSpec("Status", "heading", required=True),
        SectionSpec("Context", "heading", required=True),
        SectionSpec("Decision", "heading", required=True),
        SectionSpec("Consequences", "heading", required=True),
    ),
)

STATUS_SCHEMA = RecordSchema(
    kind="status",
    path="<project>/STATUS.md",
    fields=(),
    sections=(
        SectionSpec("title", "title", required=True),
        SectionSpec("Summary", "heading", required=True),
        SectionSpec("snapshot", "generated", required=True, writable=False),
        SectionSpec("Next", "heading", required=True),
    ),
)

SCHEMAS = (TASK_SCHEMA, DECISION_SCHEMA, STATUS_SCHEMA)

RUNIN_LABELS = tuple(s.name for s in TASK_SCHEMA.sections if s.form == "run-in")


def read_field(fm: dict[str, Any], spec: FieldSpec) -> tuple[str, ...]:
    """Reads a field from lowercased frontmatter as normalized string values.

    Set fields tolerate a bare scalar and comma- or space-separated entries;
    dates become YYYY-MM-DD; task IDs are uppercased; repeats are dropped.
    """
    raw = next(
        (fm[k] for k in (spec.name, *spec.aliases) if fm.get(k) not in (None, "")),
        None,
    )
    if raw is None:
        return ()
    items = raw if spec.shape == "set" and isinstance(raw, list) else [raw]
    values: list[str] = []
    for item in items:
        if isinstance(item, datetime):
            values.append(item.date().isoformat())
        elif isinstance(item, date):
            values.append(item.isoformat())
        elif spec.shape == "scalar" or spec.value == "conversation":
            values.append(str(item).strip().strip("'\""))
        else:
            values.extend(split_field_values([str(item)], spec))
    if spec.value == "task-id":
        values = [v.upper() for v in values]
    return tuple(dict.fromkeys(v for v in values if v))


def split_field_values(raw_list: list[str], spec: FieldSpec) -> list[str]:
    """Splits CLI or frontmatter entries for a set field into distinct values."""
    values: list[str] = []
    for entry in raw_list:
        for sub in re.split(r"[,\s]+", str(entry)):
            cleaned = sub.strip().strip("'\"")
            if cleaned:
                values.append(cleaned.upper() if spec.value == "task-id" else cleaned)
    return list(dict.fromkeys(values))


def field_is_valid(spec: FieldSpec, value: Any) -> bool:
    return VALUE_TYPES[spec.value].check(value)


def invalid_field_values(
    fm: dict[str, Any], schema: RecordSchema
) -> list[tuple[FieldSpec, str]]:
    """Returns each (field, value) in FM whose value fails its schema type."""
    return [
        (spec, value)
        for spec in schema.fields
        for value in read_field(fm, spec)
        if not field_is_valid(spec, value)
    ]


def unknown_fields(fm: dict[str, Any], schema: RecordSchema) -> list[str]:
    """Returns frontmatter keys that SCHEMA does not declare."""
    known = {n for f in schema.fields for n in (f.name, *f.aliases)}
    return [k for k in fm if k not in known]


def describe_invalid(spec: FieldSpec, value: str) -> str:
    if spec.value == "date":
        return f"invalid ISO date in {spec.name} '{value}' (expected YYYY-MM-DD)"
    if spec.value == "conversation":
        return f"unparseable conversation entry '{value}'"
    return (
        f"invalid {spec.name} '{value}' "
        f"(expected {VALUE_TYPES[spec.value].description})"
    )


def schema_headings(schema: RecordSchema, required: bool = False) -> list[str]:
    return [
        s.name
        for s in schema.sections
        if s.form == "heading" and (s.required or not required)
    ]


def canonical_status(raw: Any) -> str | None:
    """Maps a state or alias to its standard state, or None when unknown."""
    clean = str(raw or "").strip().lower().replace(" ", "-")
    state = STATE_ALIASES.get(clean)
    return state.value if state else None


def require_status(raw: str, option: str) -> str:
    """Returns the standard state for RAW, or exits naming the valid states."""
    state = canonical_status(raw)
    if state is None:
        die_scoped(
            f"unknown status for {option}: {raw} "
            f"(expected one of: {', '.join(VALUE_TYPES['status'].values)})"
        )
    return str(state)


def require_field_values(spec: FieldSpec, values: list[str], option: str) -> None:
    for value in values:
        if not field_is_valid(spec, value):
            die_scoped(
                f"invalid {option} value '{value}' "
                f"(expected {VALUE_TYPES[spec.value].description})"
            )


def edit_set_field(
    data: Any, spec: FieldSpec, add: list[str], remove: list[str]
) -> bool:
    """Adds and removes values of a set field in editable frontmatter.

    Repeats are no-ops. An existing list keeps its flow or block style, a new
    blocked_by list uses flow style, and a field left empty is removed.
    Returns True if DATA changed.
    """
    names = (spec.name, *spec.aliases)
    key = next((k for k in data if str(k).lower() in names), None)
    current = list(read_field({spec.name: data[key]} if key else {}, spec))
    updated = [v for v in current if v not in remove]
    updated += [v for v in add if v not in updated]
    if updated == current:
        return False
    if not updated:
        data.pop(key, None)
        return True
    values: list[Any] = (
        [parse_iso_date(v) or v for v in updated] if spec.value == "gate" else updated
    )
    existing = data.get(key) if key is not None else None
    if isinstance(existing, list):
        del existing[:]
        existing.extend(values)
        return True
    seq = CommentedSeq(values)
    if spec.value == "task-id":
        seq.fa.set_flow_style()
    if key is not None:
        data[key] = seq
        return True
    order = [f.name for f in TASK_SCHEMA.fields]
    earlier = set(order[: order.index(spec.name)])
    pos = max(
        (i + 1 for i, k in enumerate(data) if str(k).lower() in earlier),
        default=len(data),
    )
    data.insert(pos, spec.name, seq)
    return True


def remove_task_conversation(data: Any, conv_id: str) -> bool:
    """Removes entries for CONV_ID from frontmatter conversations."""
    changed = False
    for key in [k for k in data if str(k).lower() in ("conversations", "conversation")]:
        raw = data[key]
        items = raw if isinstance(raw, list) else [raw]
        keep = [
            i
            for i in items
            if (parse_conversation_entry(i) or ("", str(i).strip()))[1] != conv_id
        ]
        if len(keep) == len(items):
            continue
        changed = True
        if not keep:
            data.pop(key, None)
        elif isinstance(raw, list):
            del raw[:]
            raw.extend(keep)
    return changed


def check_new_blockers(
    snap: Snapshot, task_id: str | None, adds: list[str], deps: tuple[str, ...]
) -> None:
    """Refuses unknown or self-referencing added blockers, and cycles."""
    rows = get_task_rows(snap)
    known = {r.task_id for r in rows if r.task_id}
    for dep in adds:
        if dep == task_id:
            die_scoped(f"{dep} cannot be blocked by itself")
        if dep not in known:
            die_scoped(f"unknown task for --add-blocked-by: {dep}")
    if not task_id:
        return
    rows = [replace(r, blocked_by=deps) if r.task_id == task_id else r for r in rows]
    for cycle in find_dependency_cycles(rows):
        if task_id in cycle:
            chain = " -> ".join([*cycle, cycle[0]])
            die_scoped(f"blocked_by would form a cycle: {chain}")


@dataclass(slots=True, frozen=True)
class TaskRow:
    project: str
    task_id: str
    status: str
    title: str
    rel_path: str
    blocked_by: tuple[str, ...] = ()
    wait_for: tuple[str, ...] = ()
    due: str | None = None
    stale_after: str | None = None


def get_task_rows(snap: Snapshot, project_name: str | None = None) -> list[TaskRow]:
    files = get_task_files(snap, project_name)
    rows: list[TaskRow] = []
    for rel_path in files:
        try:
            content = snap.read_text(rel_path)
        except OSError:
            continue
        fm, body = parse_frontmatter(content)
        task_id = str(fm.get("id", ""))
        if not task_id:
            m = re.search(r"^id:\s*(.+)$", content, re.MULTILINE | re.IGNORECASE)
            if m:
                task_id = m.group(1).strip().strip("'\"")
        status = str(fm.get("status", ""))
        if not status:
            m = re.search(r"^status:\s*(.+)$", content, re.MULTILINE | re.IGNORECASE)
            if m:
                status = m.group(1).strip().strip("'\"")
        title = extract_title_from_body(body)
        project = rel_path.split("/")[0]
        rows.append(
            TaskRow(
                project,
                task_id,
                status,
                title,
                rel_path,
                parse_blocked_by(fm),
                parse_wait_for(fm),
                parse_date_field(fm, "due"),
                parse_date_field(fm, "stale_after"),
            )
        )
    return rows


def status_index(snap: Snapshot) -> dict[str, str]:
    """Maps every known task ID in the control repo to its declared status."""
    return {r.task_id: r.status for r in get_task_rows(snap) if r.task_id}


def unresolved_blockers(row: TaskRow, index: dict[str, str]) -> list[str]:
    """Blockers still holding ROW back.

    Unknown IDs count as resolved: a deleted blocker must never leave its
    dependents permanently unworkable.
    """
    return [
        dep
        for dep in row.blocked_by
        if dep in index and index[dep] not in RESOLVED_STATES
    ]


def unresolved_wait_for(row: TaskRow, today: date) -> list[str]:
    """Returns wait_for entries still holding ROW back as of TODAY.

    ISO dates (YYYY-MM-DD) hold a task back only while date > today.
    External/human gates (b/..., cl/..., gh:..., @handle) remain unresolved
    while present in frontmatter.
    """
    out: list[str] = []
    for item in row.wait_for:
        d = parse_iso_date(item)
        if d is not None:
            if d > today:
                out.append(item)
        else:
            out.append(item)
    return out


def find_dependency_cycles(rows: list[TaskRow]) -> list[list[str]]:
    """Returns each dependency cycle once, as a list of task IDs."""
    edges = {r.task_id: r.blocked_by for r in rows if r.task_id}
    cycles: list[list[str]] = []
    seen_keys: set[frozenset[str]] = set()
    state: dict[str, int] = {}
    stack: list[str] = []

    def visit(node: str) -> None:
        state[node] = 1
        stack.append(node)
        for dep in edges.get(node, ()):
            if dep not in edges:
                continue
            if state.get(dep) == 1:
                cycle = stack[stack.index(dep) :]
                key = frozenset(cycle)
                if key not in seen_keys:
                    seen_keys.add(key)
                    cycles.append(cycle)
            elif state.get(dep, 0) == 0:
                visit(dep)
        stack.pop()
        state[node] = 2

    for task_id in edges:
        if state.get(task_id, 0) == 0:
            visit(task_id)
    return cycles


def generate_task_id(snap: Snapshot) -> str:
    existing_ids = {r.task_id for r in get_task_rows(snap) if r.task_id}
    for i in range(1, 257):
        entropy = f"{time.time_ns()}:{os.getpid()}:{os.urandom(8).hex()}:{i}"
        h = hashlib.sha1(entropy.encode("utf-8")).hexdigest()[:5].upper()
        candidate = f"TASK-{h}"
        if candidate not in existing_ids:
            return candidate
    die("could not allocate unique task ID")


@dataclass(slots=True, frozen=True)
class AdrRow:
    project: str
    filename: str
    title: str
    rel_path: str
    raw_supersedes: tuple[str, ...] = ()
    supersedes: tuple[str, ...] = ()
    unknown_supersedes: tuple[str, ...] = ()
    superseded_by: tuple[str, ...] = ()
    self_marked_superseded: bool = False

    @property
    def is_superseded(self) -> bool:
        return bool(self.superseded_by) or self.self_marked_superseded


def parse_adr_list_field(fm: dict[str, Any], key: str) -> tuple[str, ...]:
    """Reads an optional scalar or list frontmatter field on an ADR."""
    return read_field(fm, DECISION_SCHEMA.field(key))


def resolve_adr_token(token: str, filenames: list[str]) -> str | None:
    """Resolves a supersedes token (filename, stem, or numeric prefix) to a filename."""
    t = token.strip().strip("'\"")
    if not t:
        return None
    t_lower = t.lower()
    for fn in filenames:
        if fn.lower() == t_lower or Path(fn).stem.lower() == t_lower:
            return fn
    m = re.match(r"^(?:adr[-_]?)?0*(\d+)$", t, re.IGNORECASE)
    if m:
        num = int(m.group(1))
        matches = [fn for fn in filenames if re.match(rf"^0*{num}(?:[-_.]|$)", fn)]
        if len(matches) == 1:
            return matches[0]
    return None


def is_adr_self_superseded(fm: dict[str, Any], body: str) -> bool:
    """Returns True if frontmatter status or ## Status prose marks the ADR superseded."""
    fm_status = str(fm.get("status", "")).strip().lower()
    if "superseded" in fm_status:
        return True
    m = re.search(
        r"^##\s+Status\s*$\n(.*?)(?=^##\s+|\Z)",
        body,
        re.MULTILINE | re.IGNORECASE | re.DOTALL,
    )
    return bool(m and re.search(r"\bsuperseded\b", m.group(1), re.IGNORECASE))


def get_adr_rows(snap: Snapshot, project_name: str) -> list[AdrRow]:
    """Loads all ADR rows under <project>/decisions/*.md and resolves supersedes edges."""
    adr_files = snap.glob_md(f"{project_name}/decisions")
    if not adr_files:
        return []
    filenames = [rel.rsplit("/", 1)[1] for rel in adr_files]

    prelim: list[
        tuple[str, str, str, dict[str, Any], str, tuple[str, ...], tuple[str, ...]]
    ] = []
    superseded_by_map: dict[str, list[str]] = {fn: [] for fn in filenames}

    for rel, name in zip(adr_files, filenames, strict=True):
        try:
            content = snap.read_text(rel)
        except OSError:
            continue
        fm, body = parse_frontmatter(content)
        title = extract_title(content) or name.removesuffix(".md")
        raw_sup = parse_adr_list_field(fm, "supersedes")
        resolved: list[str] = []
        unknown: list[str] = []
        for tok in raw_sup:
            target = resolve_adr_token(tok, filenames)
            if target is not None:
                if target not in resolved:
                    resolved.append(target)
                if name not in superseded_by_map[target]:
                    superseded_by_map[target].append(name)
            else:
                unknown.append(tok)
        prelim.append(
            (rel, name, title, fm, body, raw_sup, (tuple(resolved), tuple(unknown)))
        )

    rows: list[AdrRow] = []
    for rel, name, title, fm, body, raw_sup, (resolved_tup, unknown_tup) in prelim:
        rows.append(
            AdrRow(
                project=project_name,
                filename=name,
                title=title,
                rel_path=rel,
                raw_supersedes=raw_sup,
                supersedes=resolved_tup,
                unknown_supersedes=unknown_tup,
                superseded_by=tuple(superseded_by_map.get(name, ())),
                self_marked_superseded=is_adr_self_superseded(fm, body),
            )
        )
    return rows


def find_adr_cycles(rows: list[AdrRow]) -> list[list[str]]:
    """Returns each ADR supersedes cycle once, as a list of ADR filenames."""
    edges = {r.filename: r.supersedes for r in rows}
    cycles: list[list[str]] = []
    seen_keys: set[frozenset[str]] = set()
    state: dict[str, int] = {}
    stack: list[str] = []

    def visit(node: str) -> None:
        state[node] = 1
        stack.append(node)
        for dep in edges.get(node, ()):
            if dep not in edges:
                continue
            if state.get(dep) == 1:
                cycle = stack[stack.index(dep) :]
                key = frozenset(cycle)
                if key not in seen_keys:
                    seen_keys.add(key)
                    cycles.append(cycle)
            elif state.get(dep, 0) == 0:
                visit(dep)
        stack.pop()
        state[node] = 2

    for fn in edges:
        if state.get(fn, 0) == 0:
            visit(fn)
    return cycles


def build_status_block(
    snap: Snapshot,
    project_name: str,
    all_rows: list[TaskRow] | None = None,
    index: dict[str, str] | None = None,
) -> str:
    if all_rows is not None:
        rows = [r for r in all_rows if r.project == project_name]
    else:
        rows = get_task_rows(snap, project_name)
    if index is None:
        if all_rows is not None:
            index = {r.task_id: r.status for r in all_rows if r.task_id}
        else:
            index = status_index(snap)
    today = get_today(snap)
    due_cutoff = today + timedelta(days=DUE_SOON_DAYS)
    in_progress = [r for r in rows if r.status == "in-progress"]
    # Declared blocked, or held by an unresolved edge/gate. In-progress wins the
    # row so the two sections stay disjoint; doctor reports the contradiction.
    blocked = [
        r
        for r in rows
        if r.status != "in-progress"
        and (
            r.status == "blocked"
            or unresolved_blockers(r, index)
            or (r.status not in RESOLVED_STATES and unresolved_wait_for(r, today))
        )
    ]
    todo_count = sum(1 for r in rows if r.status == "todo")
    done_count = sum(1 for r in rows if r.status == "done")
    unclassified_count = sum(
        1 for r in rows if not r.status or r.status not in STANDARD_STATES
    )

    lines: list[str] = [
        BEGIN,
        "",
        "## Task snapshot",
        "",
        "### In progress",
        "",
    ]
    if in_progress:
        for r in in_progress:
            d = parse_iso_date(r.due)
            suffix = (
                f" (due `{d.isoformat()}`)" if d is not None and d <= due_cutoff else ""
            )
            lines.append(f"- `{r.task_id}` — {r.title}{suffix}")
    else:
        lines.append("- None")

    lines.extend(
        [
            "",
            "### Blocked",
            "",
        ]
    )
    if blocked:
        for r in blocked:
            notes: list[str] = []
            held = unresolved_blockers(r, index)
            if held:
                notes.append(f"blocked by {', '.join(f'`{d}`' for d in held)}")
            waiting = (
                unresolved_wait_for(r, today) if r.status not in RESOLVED_STATES else []
            )
            if waiting:
                notes.append(f"waiting for {', '.join(f'`{w}`' for w in waiting)}")
            if r.status not in RESOLVED_STATES:
                d = parse_iso_date(r.due)
                if d is not None and d <= due_cutoff:
                    notes.append(f"due `{d.isoformat()}`")
            suffix = f" ({'; '.join(notes)})" if notes else ""
            lines.append(f"- `{r.task_id}` — {r.title}{suffix}")
    else:
        lines.append("- None")

    due_soon = [
        r
        for r in rows
        if r not in in_progress
        and r not in blocked
        and r.status not in RESOLVED_STATES
        and (d := parse_iso_date(r.due)) is not None
        and d <= due_cutoff
    ]
    due_soon.sort(key=lambda r: (parse_iso_date(r.due) or date.max, r.task_id))
    if due_soon:
        lines.extend(
            [
                "",
                "### Due soon",
                "",
            ]
        )
        for r in due_soon:
            d = parse_iso_date(r.due)
            due_str = d.isoformat() if d is not None else str(r.due)
            lines.append(f"- `{r.task_id}` — {r.title} (due `{due_str}`)")

    adr_rows = get_adr_rows(snap, project_name)
    if adr_rows:
        active_adrs = [a for a in adr_rows if not a.is_superseded]
        lines.extend(
            [
                "",
                "### Decisions",
                "",
            ]
        )
        if active_adrs:
            for a in active_adrs:
                lines.append(f"- `{a.filename}` — {a.title}")
        else:
            lines.append("- None")

    counts = f"\nTodo: {todo_count} Done: {done_count}"
    if unclassified_count > 0:
        counts += f" Unclassified: {unclassified_count}"
    lines.append(counts)
    lines.append("")
    lines.append(END)
    return "\n".join(lines)


def has_commit_auth(root: Path) -> bool:
    """Check if the repository grants local commit authority in both HEAD and working tree."""
    has_head = run_git(["rev-parse", "HEAD"], check=False).returncode == 0
    if has_head:
        show_agents = run_git(["show", "HEAD:AGENTS.md"], check=False)
        if show_agents.returncode != 0 or COMMIT_AUTH not in show_agents.stdout:
            return False
    agents_path = root / "AGENTS.md"
    return agents_path.is_file() and COMMIT_AUTH in agents_path.read_text(
        encoding="utf-8"
    )


def render_status_file(
    snap: Snapshot,
    project_name: str,
    all_rows: list[TaskRow] | None = None,
    index: dict[str, str] | None = None,
) -> str:
    status_rel = f"{project_name}/STATUS.md"
    new_block = build_status_block(snap, project_name, all_rows=all_rows, index=index)

    if not snap.is_file(status_rel):
        return f"# Status\n\n## Summary\n\n{new_block}\n\n## Next\n"

    content = snap.read_text(status_rel)
    if BEGIN in content and END in content:
        pattern = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END), re.DOTALL)
        return pattern.sub(lambda _: new_block, content)
    return content.rstrip() + f"\n\n{new_block}\n"


def sync_status(
    snap: Snapshot,
    project_name: str,
    all_rows: list[TaskRow] | None = None,
    index: dict[str, str] | None = None,
) -> bool:
    """Returns True if file was updated/created, False if already identical."""
    status_rel = f"{project_name}/STATUS.md"
    rendered = render_status_file(snap, project_name, all_rows=all_rows, index=index)
    rendered = format_markdown(rendered)
    if snap.is_file(status_rel) and snap.read_text(status_rel) == rendered:
        return False
    snap.write_text(status_rel, rendered)
    return True


def resolve_target(root: Path, query: str, allow_deleted: bool = False) -> Path:
    # Direct file path
    p = Path(query)
    target = None
    if p.is_file():
        target = p.resolve()
    elif (root / query).is_file():
        target = (root / query).resolve()

    if target is not None:
        try:
            target.relative_to(root.resolve())
            return target
        except ValueError:
            die(f"path is outside control repository: {query}")

    if not ID_PATTERN.match(query):
        die(f"cannot resolve: {query}")

    hits: list[Path] = []
    for row in get_task_rows(FsSnapshot(root)):
        if row.task_id == query:
            hits.append(root / row.rel_path)

    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"ambiguous id: {query}")

    # Fallback to searching Git history for archived/deleted tasks
    if allow_deleted:
        res = run_git(
            ["log", "--all", "--name-only", "--format=", "--", f"*{query}*"],
            check=False,
        )
        if res.returncode == 0:
            seen_paths: set[str] = set()
            for line in res.stdout.splitlines():
                line = line.strip()
                if line.endswith(".md") and query in line:
                    seen_paths.add(line)
            if len(seen_paths) == 1:
                return (root / next(iter(seen_paths))).resolve()
            if len(seen_paths) > 1:
                die(f"ambiguous id in history: {query}")

    die(f"cannot resolve: {query}")


# ===========================================================================
# Audit & Reconciliation Engine (Shared by doctor and fix)
# ===========================================================================


@dataclass(slots=True, frozen=True)
class Finding:
    category: str
    severity: Literal["PASS", "INFO", "WARN", "FAIL"]
    message: str
    path: str | None = None  # relative to the repository root
    remediation: Callable[[], list[str] | None] | None = (
        None  # None if requires human review
    )


def resolve_link(snap: Snapshot, base: str, target: str) -> str | None:
    """The relative path TARGET names from directory BASE, or None if outside."""
    rel = posixpath.normpath(join_rel(base, target))
    if rel == ".":
        return ""
    if rel == ".." or rel.startswith("../"):
        return None
    return rel


def audit_project_adrs(snap: Snapshot, name: str, findings: list[Finding]) -> None:
    """Validates ADR sections, supersedes edges, cycles, and relative links on active ADRs."""
    decisions_dir = f"{name}/decisions"
    adr_files = snap.glob_md(decisions_dir)
    if not adr_files:
        return

    for rel in adr_files:
        filename = rel.rsplit("/", 1)[1]
        try:
            dcontent = snap.read_text(rel)
        except OSError:
            continue
        for key in unknown_fields(parse_frontmatter(dcontent)[0], DECISION_SCHEMA):
            findings.append(
                Finding(
                    category="adr",
                    severity="INFO",
                    message=f"{name}/{filename}: frontmatter field '{key}' is not in the decision schema",
                    path=rel,
                    remediation=None,
                )
            )
        for sec in schema_headings(DECISION_SCHEMA, required=True):
            if not re.search(
                rf"^##\s+{sec}\s*$", dcontent, re.MULTILINE | re.IGNORECASE
            ):
                findings.append(
                    Finding(
                        category="adr",
                        severity="WARN",
                        message=f"{name}/{filename}: ADR missing ## {sec}",
                        path=rel,
                        remediation=None,
                    )
                )

    adr_rows = get_adr_rows(snap, name)
    if not adr_rows:
        return

    for row in adr_rows:
        if row.unknown_supersedes:
            findings.append(
                Finding(
                    category="adr",
                    severity="WARN",
                    message=(
                        f"{name}/decisions/{row.filename}: supersedes names unknown "
                        f"ADR(s): {', '.join(row.unknown_supersedes)}"
                    ),
                    path=row.rel_path,
                    remediation=None,
                )
            )

    for cycle in find_adr_cycles(adr_rows):
        chain = " -> ".join([*cycle, cycle[0]])
        findings.append(
            Finding(
                category="adr",
                severity="WARN",
                message=f"{name}: ADR supersedes cycle: {chain}",
                path=decisions_dir,
                remediation=None,
            )
        )

    candidate_bases = [decisions_dir, name, ""]

    for row in adr_rows:
        if row.is_superseded:
            continue
        try:
            raw_content = snap.read_text(row.rel_path)
        except OSError:
            continue
        _, body = parse_frontmatter(raw_content)

        for other in adr_rows:
            if (
                not other.is_superseded
                or other.filename == row.filename
                or other.filename in row.supersedes
            ):
                continue
            stem = Path(other.filename).stem
            if re.search(
                rf"(?<![\w/-])(?:{re.escape(other.filename)}|{re.escape(stem)})(?![\w.-])",
                body,
            ):
                findings.append(
                    Finding(
                        category="adr",
                        severity="WARN",
                        message=(
                            f"{name}/decisions/{row.filename}: active ADR references "
                            f"superseded ADR '{other.filename}'"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )

        stale_refs: list[str] = []
        for m in re.finditer(r"\[[^\]]+\]\(([^)\s]+)\)", body):
            target = m.group(1).split("#", 1)[0].strip()
            if (
                not target
                or re.match(r"^(?:https?|mailto|conversation|file):", target)
                or target.startswith("/")
            ):
                continue
            valid_link = any(
                (resolved := resolve_link(snap, base, target)) is not None
                and snap.exists(resolved)
                for base in candidate_bases
            )
            if not valid_link:
                stale_refs.append(target)

        for ref in dict.fromkeys(stale_refs):
            findings.append(
                Finding(
                    category="adr",
                    severity="WARN",
                    message=f"{name}/decisions/{row.filename}: stale file reference '{ref}'",
                    path=row.rel_path,
                    remediation=None,
                )
            )


def audit_workspace(root: Path, target_project: str | None = None) -> list[Finding]:
    """Audits the working tree: repository checks, then the snapshot audit."""
    findings: list[Finding] = []

    # Shallow clone check
    try:
        shallow = run_git(["rev-parse", "--is-shallow-repository"]).stdout.strip()
        if shallow == "true":
            findings.append(
                Finding(
                    category="git",
                    severity="WARN",
                    message="shallow clone: history may be incomplete",
                )
            )
    except Exception:
        pass

    return findings + audit_snapshot(FsSnapshot(root), target_project)


def markdown_finding(snap: Snapshot, rel: str) -> Finding | None:
    """A finding when REL is not formatted (fixable) or cannot be formatted."""
    try:
        content = snap.read_text(rel)
        if format_markdown(content) == content:
            return None

        def remediate(target=rel) -> list[str]:
            if not snap.is_file(target):
                return []
            current = snap.read_text(target)
            formatted = format_markdown(current)
            if current != formatted:
                snap.write_text(target, formatted)
                return [target]
            return []

        return Finding(
            category="markdown",
            severity="INFO",
            message=f"{rel}: markdown formatting needed",
            path=rel,
            remediation=remediate,
        )
    except Exception as e:
        return Finding(
            category="markdown",
            severity="WARN",
            message=f"{rel}: failed to format markdown: {e}",
            path=rel,
            remediation=None,
        )


def audit_snapshot(snap: Snapshot, target_project: str | None = None) -> list[Finding]:
    """Single shared diagnostic engine for doctor and fix.

    Remediations write through SNAP, so they apply only to a writable one.
    """
    findings: list[Finding] = []

    # 1. AGENTS.md check & remediation
    agents_file = "AGENTS.md"
    if not snap.is_file(agents_file):

        def remediate_missing_agents() -> list[str]:
            # Tracking repos include commit authorization by default so agents can maintain tracker state.
            snap.write_markdown(
                agents_file,
                f"# Agent instructions\n\nThis repository follows taskgo: <{CANONICAL_URL}>.\n\n{COMMIT_AUTH}\n",
            )
            return [agents_file]

        findings.append(
            Finding(
                category="root",
                severity="WARN",
                message="missing AGENTS.md",
                path=agents_file,
                remediation=remediate_missing_agents,
            )
        )
    else:
        agents_txt = snap.read_text(agents_file)
        needs_decl = not re.search(
            r"(follows|structured|maintained|according to).*taskgo",
            agents_txt,
            re.IGNORECASE,
        )
        needs_url = CANONICAL_URL not in agents_txt
        needs_auth = COMMIT_AUTH not in agents_txt

        if needs_decl or needs_url or needs_auth:

            def remediate_agents() -> list[str]:
                cur = snap.read_text(agents_file)
                has_decl = bool(
                    re.search(
                        r"(follows|structured|maintained|according to).*taskgo",
                        cur,
                        re.IGNORECASE,
                    )
                )
                if not has_decl:
                    cur = (
                        f"This repository follows taskgo: <{CANONICAL_URL}>.\n\n" + cur
                    )
                elif CANONICAL_URL not in cur:
                    cur += f"\nCanonical URL: <{CANONICAL_URL}>\n"
                if COMMIT_AUTH not in cur:
                    cur = cur.rstrip() + f"\n\n{COMMIT_AUTH}\n"
                snap.write_markdown(agents_file, cur)
                return [agents_file]

            if needs_decl:
                findings.append(
                    Finding(
                        category="root",
                        severity="WARN",
                        message="AGENTS.md: must state that the repository follows taskgo",
                        path=agents_file,
                        remediation=remediate_agents,
                    )
                )
            if needs_url:
                findings.append(
                    Finding(
                        category="root",
                        severity="WARN",
                        message=f"AGENTS.md: missing canonical taskgo URL: {CANONICAL_URL}",
                        path=agents_file,
                        remediation=remediate_agents,
                    )
                )
            if needs_auth:
                findings.append(
                    Finding(
                        category="root",
                        severity="INFO",
                        message=f"AGENTS.md: missing {COMMIT_AUTH}",
                        path=agents_file,
                        remediation=remediate_agents,
                    )
                )

    # 2. INBOX.md check & remediation
    inbox_file = "INBOX.md"
    if not snap.is_file(inbox_file):

        def remediate_missing_inbox() -> list[str]:
            snap.write_markdown(inbox_file, "# Inbox\n")
            return [inbox_file]

        findings.append(
            Finding(
                category="root",
                severity="WARN",
                message="missing INBOX.md",
                path=inbox_file,
                remediation=remediate_missing_inbox,
            )
        )

    # 3. Duplicate global task IDs
    all_rows = get_task_rows(snap)
    status_idx = {r.task_id: r.status for r in all_rows if r.task_id}
    seen_ids: dict[str, int] = {}
    for r in all_rows:
        if r.task_id:
            seen_ids[r.task_id] = seen_ids.get(r.task_id, 0) + 1
    dups = [k for k, v in seen_ids.items() if v > 1]
    if dups:
        findings.append(
            Finding(
                category="tasks",
                severity="WARN",
                message=f"duplicate global task ID(s): {' '.join(sorted(dups))}",
                remediation=None,  # Ambiguous duplicate resolution requires human review
            )
        )

    # 4. Project-level checks
    if target_project:
        projects = [require_project(snap, target_project)]
    else:
        projects = list_projects(snap)

    for name in projects:
        tasks_dir = f"{name}/tasks"
        status_file = f"{name}/STATUS.md"

        # Check STATUS.md
        if not snap.is_file(status_file):

            def make_remediate_status(p_name=name, p_status=status_file):
                def remediate() -> list[str]:
                    sync_status(snap, p_name)
                    return [p_status]

                return remediate

            findings.append(
                Finding(
                    category="project",
                    severity="WARN",
                    message=f"{name}: missing STATUS.md",
                    path=status_file,
                    remediation=make_remediate_status(name, status_file),
                )
            )

        # Check tasks
        for tf in snap.glob_md(tasks_dir):
            content = snap.read_text(tf)
            rel_path = tf
            tf_name = tf.rsplit("/", 1)[1]

            m_fm = re.search(r"^---\n(.*?)\n---(?:\n|$)", content, re.DOTALL)
            if m_fm:
                yaml = YAML()
                try:
                    parsed_yaml = yaml.load(m_fm.group(1))
                    if not isinstance(parsed_yaml, dict):
                        findings.append(
                            Finding(
                                category="task",
                                severity="FAIL",
                                message=(
                                    f"{rel_path}: invalid YAML frontmatter: frontmatter must be a YAML mapping\n"
                                    "        Fix syntax between '---' delimiters to ensure frontmatter is a key-value mapping."
                                ),
                                path=tf,
                                remediation=None,
                            )
                        )
                        continue
                except Exception as e:
                    err_line = str(e).splitlines()[0] if str(e) else "syntax error"
                    findings.append(
                        Finding(
                            category="task",
                            severity="FAIL",
                            message=(
                                f"{rel_path}: invalid YAML frontmatter: {err_line}\n"
                                "        Fix YAML frontmatter syntax or restore task from git."
                            ),
                            path=tf,
                            remediation=None,
                        )
                    )
                    continue

            fm, _ = parse_frontmatter(content)

            # Field values and keys come from the task schema; id and
            # status get repair findings below.
            for spec, value in invalid_field_values(fm, TASK_SCHEMA):
                if spec.name in ("id", "status"):
                    continue
                findings.append(
                    Finding(
                        category="task",
                        severity=spec.invalid,
                        message=f"{rel_path}: {describe_invalid(spec, value)}",
                        path=tf,
                        remediation=None,
                    )
                )
            for key in unknown_fields(fm, TASK_SCHEMA):
                findings.append(
                    Finding(
                        category="task",
                        severity="INFO",
                        message=f"{rel_path}: frontmatter field '{key}' is not in the task schema",
                        path=tf,
                        remediation=None,
                    )
                )

            task_id = fm.get("id", "")
            raw_status = fm.get("status", "")

            # A done task's Outcome gives the verdict against its Criteria.
            # Older records predate the rule, so this does not block.
            if raw_status == "done":
                body = extract_body(content)
                spans, similar = find_sections(body, "Outcome")
                if not any(body[s:e].partition("\n")[2].strip() for s, e in spans):
                    hint = f" (similar: {', '.join(similar)})" if similar else ""
                    findings.append(
                        Finding(
                            category="task",
                            severity="INFO",
                            message=(
                                f"{rel_path}: done task has no ## Outcome text{hint}\n"
                                "        Give a verdict against each criterion."
                            ),
                            path=tf,
                            remediation=None,
                        )
                    )

            m = re.search(r"TASK-[0-9A-F]{5}", tf_name)
            filename_id = m.group(0) if m else ""

            needs_id_fix = not field_is_valid(TASK_SCHEMA.field("id"), task_id)
            needs_status_fix = not field_is_valid(
                TASK_SCHEMA.field("status"), raw_status
            )
            needs_filename_fix = (
                bool(filename_id and filename_id != task_id) or not filename_id
            )

            if needs_id_fix or needs_status_fix or needs_filename_fix:

                def make_remediate_task(target_tf=tf, p_tasks=tasks_dir):
                    def remediate() -> list[str]:
                        t_content = snap.read_text(target_tf)
                        t_fm, t_body = parse_frontmatter_for_edit(t_content)
                        t_id = ""
                        id_key = None
                        for k in list(t_fm.keys()):
                            if str(k).lower() == "id":
                                t_id = str(t_fm[k])
                                id_key = k
                                break
                        if not ID_PATTERN.match(t_id):
                            t_id = generate_task_id(snap)

                        raw_status = "todo"
                        status_key = None
                        for k in list(t_fm.keys()):
                            if str(k).lower() == "status":
                                raw_status = str(t_fm[k])
                                status_key = k
                                break
                        t_status = normalize_status(raw_status)
                        target_name = target_tf.rsplit("/", 1)[1]
                        t_title = extract_title(t_content) or target_name.removesuffix(
                            ".md"
                        )
                        if not t_body.strip():
                            t_body = f"\n# {t_title}\n\n## Outcome\n\n## Findings\n\n## Next\n"

                        t_fm[id_key or "id"] = t_id
                        t_fm[status_key or "status"] = t_status

                        new_content = f"{dump_frontmatter(t_fm)}\n{t_body.lstrip()}\n"
                        snap.write_markdown(target_tf, new_content)
                        # Preserve a caller-chosen slug when the file is
                        # already taskgo-named: only its ID prefix is
                        # being repaired. Files adopted from other names
                        # still get a slug derived from their title.
                        slug = filename_slug(target_name) or slugify(t_title) or "task"
                        new_name = f"{t_id}-{slug}.md"
                        new_path = f"{p_tasks}/{new_name}"
                        if target_name != new_name:
                            snap.rename(target_tf, new_path)
                            return [target_tf, new_path]
                        return [target_tf]

                    return remediate

                if needs_id_fix:
                    findings.append(
                        Finding(
                            category="task",
                            severity="WARN",
                            message=f"{rel_path}: invalid/missing id '{task_id}'",
                            path=tf,
                            remediation=make_remediate_task(tf, tasks_dir),
                        )
                    )
                if needs_status_fix and not needs_id_fix:
                    findings.append(
                        Finding(
                            category="task",
                            severity="WARN",
                            message=f"{rel_path}: non-standard status '{raw_status}'",
                            path=tf,
                            remediation=make_remediate_task(tf, tasks_dir),
                        )
                    )
                if needs_filename_fix and not needs_id_fix:
                    findings.append(
                        Finding(
                            category="task",
                            severity="WARN",
                            message=f"{rel_path}: filename/frontmatter IDs disagree",
                            path=tf,
                            remediation=make_remediate_task(tf, tasks_dir),
                        )
                    )

        # Check STATUS.md snapshot drift
        if snap.is_file(status_file):
            current_status = snap.read_text(status_file)
            rendered = render_status_file(
                snap, name, all_rows=all_rows, index=status_idx
            )
            rendered = format_markdown(rendered)
            if current_status != rendered:

                def make_remediate_snapshot(p_name=name, p_status=status_file):
                    def remediate() -> list[str]:
                        sync_status(snap, p_name)
                        return [p_status]

                    return remediate

                findings.append(
                    Finding(
                        category="status",
                        severity="WARN",
                        message=f"{name}: stale STATUS task snapshot (run sync)",
                        path=status_file,
                        remediation=make_remediate_snapshot(name, status_file),
                    )
                )

            for sec in schema_headings(STATUS_SCHEMA, required=True):
                if not re.search(rf"^##\s+{sec}\s*$", current_status, re.MULTILINE):
                    findings.append(
                        Finding(
                            category="status",
                            severity="WARN",
                            message=f"{name}: STATUS.md missing ## {sec}",
                            path=status_file,
                            remediation=None,
                        )
                    )

            rows = [r for r in all_rows if r.project == name]
            active = sum(1 for r in rows if r.status == "in-progress")
            prose = re.sub(
                re.escape(BEGIN) + r".*?" + re.escape(END),
                "",
                current_status,
                flags=re.DOTALL,
            )
            if active > 0 and re.search(
                r"(no\s+tasks?|nothing)(\s+(is|are))?(\s+currently)?\s+in[ -]progress",
                prose,
                re.IGNORECASE,
            ):
                findings.append(
                    Finding(
                        category="status",
                        severity="WARN",
                        message=f"{name}: STATUS prose says no task is in progress, but {active} task(s) are in-progress",
                        path=status_file,
                        remediation=None,  # Human semantic editing required
                    )
                )

        # Check decisions ADRs
        audit_project_adrs(snap, name, findings)

        # Check Markdown formatting for all markdown files in project
        for mf in snap.walk_md(name):
            parts = mf.split("/")
            if any(part.startswith(".") for part in parts) or "node_modules" in parts:
                continue
            if (finding := markdown_finding(snap, mf)) is not None:
                findings.append(finding)

    if not target_project:
        for rmf in snap.glob_md(""):
            if rmf.startswith("."):
                continue
            if (finding := markdown_finding(snap, rmf)) is not None:
                findings.append(finding)

    # The zone decides "today" for every project, so check it on every run.
    tz_name = repo_timezone_name(snap)
    if tz_name and load_zone(tz_name) is None:
        findings.append(
            Finding(
                category="root",
                severity="FAIL",
                message=(
                    f"unknown timezone {tz_name!r} in README.md; "
                    "using the machine's local date"
                ),
                path="README.md",
                remediation=None,
            )
        )

    # Dependency edges & temporal gates. Never auto-remediated: an invented or
    # removed edge/gate is worse than an absent one, so every finding here needs
    # human review.
    index = status_idx
    today = get_today(snap)
    scoped_rows = [
        r for r in all_rows if not target_project or r.project == target_project
    ]
    for row in scoped_rows:
        unknown = [dep for dep in row.blocked_by if dep not in index]
        if unknown:
            findings.append(
                Finding(
                    category="depends",
                    severity="WARN",
                    message=f"{row.rel_path}: blocked_by names unknown task(s): {', '.join(unknown)}",
                    path=row.rel_path,
                    remediation=None,
                )
            )
        if row.status not in RESOLVED_STATES:
            done_deps = [
                dep
                for dep in row.blocked_by
                if index.get(dep, "").lower() == TaskStatus.DONE.value
            ]
            if done_deps:
                formatted = ", ".join(f"{dep} (done)" for dep in done_deps)
                findings.append(
                    Finding(
                        category="depends",
                        severity="WARN",
                        message=(
                            f"{row.rel_path}: blocked_by names resolved task(s): "
                            f"{formatted}; remove the edge"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )
            cancelled_deps = [
                dep
                for dep in row.blocked_by
                if index.get(dep, "").lower() == TaskStatus.CANCELLED.value
            ]
            if cancelled_deps:
                formatted = ", ".join(f"{dep} (cancelled)" for dep in cancelled_deps)
                findings.append(
                    Finding(
                        category="depends",
                        severity="WARN",
                        message=(
                            f"{row.rel_path}: blocked_by names resolved task(s): "
                            f"{formatted}; re-plan or remove the edge"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )

            # Invalid dates are reported by the schema field check.
            due_date = parse_iso_date(row.due)
            if due_date is not None and due_date < today:
                findings.append(
                    Finding(
                        category="schedule",
                        severity="FAIL",
                        message=(
                            f"{row.rel_path}: overdue (due {due_date.isoformat()}, "
                            f"{(today - due_date).days}d ago)"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )
            elif due_date is not None and due_date <= today + timedelta(days=2):
                findings.append(
                    Finding(
                        category="schedule",
                        severity="WARN",
                        message=(
                            f"{row.rel_path}: due soon (due {due_date.isoformat()}, "
                            "within 48h)"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )

            stale_date = parse_iso_date(row.stale_after)
            if stale_date is not None and stale_date < today:
                findings.append(
                    Finding(
                        category="schedule",
                        severity="WARN",
                        message=(
                            f"{row.rel_path}: stale task "
                            f"(stale_after {stale_date.isoformat()}); "
                            "re-scope or cancel"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )

        if (
            row.status == TaskStatus.BLOCKED.value
            and not unresolved_blockers(row, index)
            and not unresolved_wait_for(row, today)
        ):
            if row.blocked_by:
                detail = "all blocked_by edges resolved"
            elif row.wait_for:
                detail = "all wait_for gates elapsed"
            else:
                detail = "no blocked_by edges"
            findings.append(
                Finding(
                    category="depends",
                    severity="WARN",
                    message=f"{row.rel_path}: status is blocked but {detail}",
                    path=row.rel_path,
                    remediation=None,
                )
            )

    for cycle in find_dependency_cycles(all_rows):
        if target_project and not any(
            r.task_id in cycle and r.project == target_project for r in scoped_rows
        ):
            continue
        findings.append(
            Finding(
                category="depends",
                severity="WARN",
                message=f"blocked_by cycle: {' -> '.join(cycle)} -> {cycle[0]}",
                remediation=None,
            )
        )

    return findings


def cmd_id() -> None:
    """Allocate a unique task ID."""
    root = get_repo_root()
    print(generate_task_id(FsSnapshot(root)))


def cmd_root() -> None:
    """Print the resolved control repository root."""
    print(get_repo_root())


def render_task_file(
    task_id: str,
    title: str,
    status: str,
    problem: str | None = None,
    cost: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
    wait_for: list[str] | tuple[str, ...] | None = None,
    due: str | None = None,
    stale_after: str | None = None,
    blocked_by: list[str] | tuple[str, ...] | None = None,
    conversations: list[str] | None = None,
) -> str:
    """Render and format a task Markdown document."""
    body_blocks = []
    if problem:
        body_blocks.append(f"**Problem:** {problem}")
    if cost:
        body_blocks.append(f"**Cost:** {cost}")
    if goal:
        body_blocks.append(f"**Goal:** {goal}")
    if criteria:
        body_blocks.append(f"**Criteria:** {criteria}")
    if sketch:
        body_blocks.append(
            f"**Sketch:**\n\n{sketch}"
            if ("\n" in sketch or sketch.strip().startswith("1."))
            else f"**Sketch:** {sketch}"
        )
    if constraints:
        body_blocks.append(f"**Constraints:** {constraints}")

    if status == "done":
        if outcome:
            body_blocks.append(f"## Outcome\n\n{outcome}")
        else:
            body_blocks.append("## Outcome")

        if findings:
            body_blocks.append(f"## Findings\n\n{findings}")
        else:
            body_blocks.append("## Findings")

        if next_steps:
            body_blocks.append(f"## Next\n\n{next_steps}")
        else:
            body_blocks.append("## Next")
    else:
        if outcome:
            body_blocks.append(f"## Outcome\n\n{outcome}")
        if findings:
            body_blocks.append(f"## Findings\n\n{findings}")
        if next_steps:
            body_blocks.append(f"## Next\n\n{next_steps}")

        if not body_blocks:
            body_blocks.append("**Goal:**\n\n**Criteria:**")

    body = "\n\n".join(body_blocks)

    fm_data: dict[str, Any] = {"id": task_id, "status": status}
    if blocked_by:
        deps = CommentedSeq(blocked_by)
        deps.fa.set_flow_style()
        fm_data["blocked_by"] = deps
    if wait_for:
        fm_data["wait_for"] = [parse_iso_date(w) or w for w in wait_for]
    if due:
        fm_data["due"] = parse_iso_date(due) or due
    if stale_after:
        fm_data["stale_after"] = parse_iso_date(stale_after) or stale_after
    convs = list(dict.fromkeys([*([conv] if conv else []), *(conversations or [])]))
    if convs:
        fm_data["conversations"] = convs
    fm_block = dump_frontmatter(fm_data)

    raw = f"""{fm_block}
# {title}

{body}
"""
    try:
        return format_markdown(raw)
    except Exception:
        return raw


def create_task(snap: Snapshot, project_name: str, rel_path: str, content: str) -> None:
    """Writes a new task, scaffolding its project if needed, and syncs STATUS.md."""
    # Auto-initialize project scaffolding if it's a new project
    if not is_project(snap, project_name):
        readme = f"{project_name}/README.md"
        if not snap.is_file(readme):
            snap.write_markdown(readme, f"# {project_name}\n\nProject overview.\n")
        status_file = f"{project_name}/STATUS.md"
        if not snap.is_file(status_file):
            snap.write_markdown(
                status_file,
                f"# Status\n\n## Summary\n\nInitial setup for {project_name}.\n\n<!-- taskgo:begin -->\n<!-- taskgo:end -->\n\n## Next\n",
            )
    snap.write_markdown(rel_path, content)
    sync_status(snap, project_name)


def cmd_create(
    project_name: str,
    title: str,
    slug: str | None = None,
    status: str = "todo",
    problem: str | None = None,
    cost: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
    wait_for: list[str] | None = None,
    due: str | None = None,
    stale_after: str | None = None,
    no_commit: bool = False,
    dry_run: bool = False,
    add_blocked_by: list[str] | None = None,
    add_wait_for: list[str] | None = None,
    add_conversations: list[str] | None = None,
) -> None:
    """Create a new task in PROJECT."""
    if (
        "/" in project_name
        or "\\" in project_name
        or ".." in project_name
        or not project_name
        or project_name.startswith(".")
    ):
        die(
            f"invalid project name (must be a top-level directory and cannot start with a dot): {project_name}"
        )

    if due is not None and parse_iso_date(due) is None:
        die_scoped(f"invalid ISO date for --due (expected YYYY-MM-DD): {due}")
    if stale_after is not None and parse_iso_date(stale_after) is None:
        die_scoped(
            f"invalid ISO date for --stale-after (expected YYYY-MM-DD): {stale_after}"
        )
    wait_spec = TASK_SCHEMA.field("wait_for")
    norm_wait_for = split_field_values(
        [*(wait_for or []), *(add_wait_for or [])], wait_spec
    )
    require_field_values(wait_spec, norm_wait_for, "--wait-for")
    blocked_spec = TASK_SCHEMA.field("blocked_by")
    deps = split_field_values(add_blocked_by or [], blocked_spec)
    require_field_values(blocked_spec, deps, "--add-blocked-by")
    extra_convs: list[str] = []
    for entry in split_field_values(
        add_conversations or [], TASK_SCHEMA.field("conversations")
    ):
        parsed = normalize_conversation_id(entry)
        if parsed:
            extra_convs.append(f"{parsed[0]}://{parsed[1]}")

    if slug is not None:
        task_slug = normalize_slug(slug)
        if not task_slug:
            die_scoped(f"--slug contains no usable characters: {slug}")
        if len(task_slug) > SLUG_MAX_LEN:
            die_scoped(
                f"--slug too long ({len(task_slug)} > {SLUG_MAX_LEN} chars): {task_slug}"
            )
    else:
        full_slug = normalize_slug(title)
        task_slug = slugify(title) or "task"
        if not full_slug or len(full_slug) > SLUG_MAX_LEN:
            reason = (
                "Title yields no usable filename slug"
                if not full_slug
                else "Title too long for a filename"
            )
            print(
                _tagged(f"[WARN]  {reason}; using '{task_slug}'.", sys.stderr),
                file=sys.stderr,
            )
            print(
                _tagged(
                    f"[WARN]    Pass --slug SLUG (<= {SLUG_MAX_LEN} chars) to choose a better filename.",
                    sys.stderr,
                ),
                file=sys.stderr,
            )

    status = require_status(status, "--status")
    session = get_active_session(conv)
    conv_uri = f"{session[0]}://{session[1]}" if session else None
    root = get_repo_root()
    snap = FsSnapshot(root)
    if deps:
        check_new_blockers(snap, None, deps, tuple(deps))
    if snap.is_file(project_name):
        die(
            f"cannot create project '{project_name}': a file with this name already exists"
        )

    task_id = generate_task_id(snap)
    filename = f"{task_id}-{task_slug}.md"
    rel_task_path = f"{project_name}/tasks/{filename}"
    is_new_project = not is_project(snap, project_name)

    if dry_run:
        print(
            _tagged(
                "[INFO]  Dry run: would create task record and sync STATUS.md:",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        if is_new_project:
            print(
                _tagged(
                    f"[INFO]    - Scaffolding: {project_name}/README.md, {project_name}/STATUS.md",
                    sys.stderr,
                ),
                file=sys.stderr,
            )
        print(
            _tagged(
                f"[INFO]    - Task file:   {rel_task_path} (status: {status})",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        prefix = f"{project_name}: create {task_id}"
        remaining = 50 - len(prefix) - 3
        if remaining > 5 and len(title) > remaining:
            short_title = title[: remaining - 3].rstrip() + "..."
            subject = f"{prefix} ({short_title})"
        elif remaining > 5:
            subject = f"{prefix} ({title})"
        else:
            subject = prefix
        print(
            _tagged(f"[INFO]    - Commit:      {subject}", sys.stderr), file=sys.stderr
        )
        print(f"{task_id}\t{rel_task_path}")
        return

    content = render_task_file(
        task_id=task_id,
        title=title,
        status=status,
        problem=problem,
        cost=cost,
        goal=goal,
        criteria=criteria,
        sketch=sketch,
        constraints=constraints,
        outcome=outcome,
        findings=findings,
        next_steps=next_steps,
        conv=conv_uri,
        wait_for=norm_wait_for or None,
        due=due,
        stale_after=stale_after,
        blocked_by=deps or None,
        conversations=extra_convs or None,
    )
    create_task(snap, project_name, rel_task_path, content)

    # Machine-readable output contract on stdout
    print(f"{task_id}\t{rel_task_path}")

    if no_commit:
        return

    if not has_commit_auth(root):
        print(
            _tagged(
                "[INFO]  Skipping commit: repository lacks authorized <!-- taskgo:allow-local-commits -->",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        return

    # Stage task file, STATUS.md, and optionally new scaffolding files
    to_stage = [rel_task_path, f"{project_name}/STATUS.md"]
    if is_new_project:
        rel_readme = f"{project_name}/README.md"
        if (root / rel_readme).is_file():
            to_stage.append(rel_readme)

    run_git(["add", "--", *to_stage])

    subject = conventional_subject(f"create {task_id}", project_name)

    msg_lines = [subject, "", wrap_body(title)]
    if conv_uri:
        msg_lines.extend(["", f"Conversation: {conv_uri}"])
    commit_msg = "\n".join(msg_lines) + "\n"

    run_git(["commit", "--no-verify", "--no-gpg-sign", "-m", commit_msg])
    commit_sha = run_git(["rev-parse", "HEAD"]).stdout.strip()
    print(
        _tagged(f"[INFO]  Committed new task: {commit_sha[:10]}", sys.stderr),
        file=sys.stderr,
    )


def edit_task_text(
    snap: Snapshot,
    rel_path: str,
    content: str,
    status: str | None = None,
    title: str | None = None,
    problem: str | None = None,
    cost: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
    wait_for: list[str] | None = None,
    due: str | None = None,
    stale_after: str | None = None,
    expect_status: str | None = None,
    add_blocked_by: list[str] | None = None,
    remove_blocked_by: list[str] | None = None,
    add_wait_for: list[str] | None = None,
    remove_wait_for: list[str] | None = None,
    add_conversations: list[str] | None = None,
    remove_conversations: list[str] | None = None,
) -> tuple[str, list[str]]:
    """Applies field and section edits to the task text CONTENT at REL_PATH.

    Returns the edited, unformatted text and any warnings. SNAP is read only
    to check added blockers against the other tasks.
    """
    warnings: list[str] = []
    data, body = parse_frontmatter_for_edit(content)

    if expect_status is not None:
        expected = require_status(expect_status, "--expect-status")
        current = next(
            (str(v) for k, v in data.items() if str(k).lower() == "status"), ""
        )
        if canonical_status(current) != expected:
            die_scoped(
                f"{rel_path}: status is '{current}', expected '{expected}'; "
                "nothing changed"
            )

    if status:
        norm_status = require_status(status, "--status")
        status_key = next((k for k in data if str(k).lower() == "status"), "status")
        data[status_key] = norm_status

    if wait_for is not None:
        if len(wait_for) == 1 and not wait_for[0].strip():
            for k in [k for k in list(data.keys()) if str(k).lower() == "wait_for"]:
                data.pop(k, None)
        else:
            items = normalize_wait_for_args(wait_for)
            require_field_values(TASK_SCHEMA.field("wait_for"), items, "--wait-for")
            wf_key = next((k for k in data if str(k).lower() == "wait_for"), "wait_for")
            data[wf_key] = [parse_iso_date(w) or w for w in items]

    if due is not None:
        if not due.strip():
            for k in [k for k in list(data.keys()) if str(k).lower() == "due"]:
                data.pop(k, None)
        else:
            parsed_due = parse_iso_date(due)
            if parsed_due is None:
                die_scoped(f"invalid ISO date for --due (expected YYYY-MM-DD): {due}")
            due_key = next((k for k in data if str(k).lower() == "due"), "due")
            data[due_key] = parsed_due

    if stale_after is not None:
        if not stale_after.strip():
            for k in [k for k in list(data.keys()) if str(k).lower() == "stale_after"]:
                data.pop(k, None)
        else:
            parsed_stale = parse_iso_date(stale_after)
            if parsed_stale is None:
                die_scoped(
                    f"invalid ISO date for --stale-after (expected YYYY-MM-DD): {stale_after}"
                )
            sa_key = next(
                (k for k in data if str(k).lower() == "stale_after"), "stale_after"
            )
            data[sa_key] = parsed_stale

    own_id = next((str(v) for k, v in data.items() if str(k).lower() == "id"), None)
    wait_spec = TASK_SCHEMA.field("wait_for")
    if add_wait_for or remove_wait_for:
        adds = split_field_values(add_wait_for or [], wait_spec)
        require_field_values(wait_spec, adds, "--add-wait-for")
        edit_set_field(
            data, wait_spec, adds, split_field_values(remove_wait_for or [], wait_spec)
        )

    blocked_spec = TASK_SCHEMA.field("blocked_by")
    if add_blocked_by or remove_blocked_by:
        adds = split_field_values(add_blocked_by or [], blocked_spec)
        require_field_values(blocked_spec, adds, "--add-blocked-by")
        removes = split_field_values(remove_blocked_by or [], blocked_spec)
        edit_set_field(data, blocked_spec, adds, removes)
        deps = parse_blocked_by({str(k).lower(): v for k, v in data.items()})
        check_new_blockers(snap, own_id, adds, deps)

    conv_spec = TASK_SCHEMA.field("conversations")
    for entry in split_field_values(remove_conversations or [], conv_spec):
        parsed = parse_conversation_entry(entry)
        remove_task_conversation(data, parsed[1] if parsed else entry)
    for entry in split_field_values(add_conversations or [], conv_spec):
        added = normalize_conversation_id(entry)
        if added:
            update_task_conversation(data, *added)

    session = normalize_conversation_id(conv) if conv else None
    if session:
        scheme, c_id = session
        update_task_conversation(data, scheme, c_id)

    fm_text = dump_frontmatter(data)

    if title:
        body = re.sub(r"^#\s+[^\n]+", f"# {title}", body, count=1, flags=re.MULTILINE)

    def upsert_runin(body_str: str, label: str, val: str) -> str:
        block = "\n" in val or val.strip().startswith("1.")
        replacement = f"**{label}:**\n\n{val}" if block else f"**{label}:** {val}"
        spans = find_runins(body_str, label)
        if len(spans) > 1:
            die_scoped(
                f"{rel_path}: **{label}:** appears {len(spans)} times; "
                "edit the task file directly"
            )
        if not spans:
            return body_str.rstrip() + f"\n\n{replacement}\n"
        start, end = spans[0]
        before, after = body_str[:start], body_str[end:]
        # Give the edited run-in its own paragraph, as 'create' lays it out,
        # when mdformat has reflowed it into a paragraph with its neighbours.
        if before.strip() and not before.endswith("\n\n"):
            before = before.rstrip() + "\n\n"
        if after.strip() and not after.startswith("\n\n"):
            after = "\n\n" + after.lstrip()
        return before + replacement + after

    def upsert_section(body_str: str, heading: str, val: str) -> str:
        replacement = f"## {heading}\n\n{val}"
        spans, similar = find_sections(body_str, heading)
        if len(spans) > 1:
            die_scoped(
                f"{rel_path}: '## {heading}' appears {len(spans)} times; "
                "edit the task file directly"
            )
        if not spans:
            if similar:
                warnings.append(
                    f"{rel_path}: no '## {heading}' section; "
                    f"appending one (similar: {', '.join(similar)})"
                )
            return body_str.rstrip() + f"\n\n{replacement}\n"
        start, end = spans[0]
        return body_str[:start] + replacement + body_str[end:]

    if problem:
        body = upsert_runin(body, "Problem", problem)
    if cost:
        body = upsert_runin(body, "Cost", cost)
    if goal:
        body = upsert_runin(body, "Goal", goal)
    if criteria:
        body = upsert_runin(body, "Criteria", criteria)
    if sketch:
        body = upsert_runin(body, "Sketch", sketch)
    if constraints:
        body = upsert_runin(body, "Constraints", constraints)
    if outcome:
        body = upsert_section(body, "Outcome", outcome)
    if findings:
        body = upsert_section(body, "Findings", findings)
    if next_steps:
        body = upsert_section(body, "Next", next_steps)

    return fm_text + "\n" + body.lstrip(), warnings


@dataclass(slots=True, frozen=True)
class TaskUpdate:
    task_id: str
    rel_path: str
    renamed_from: str | None
    warnings: tuple[str, ...]


def update_task(
    snap: Snapshot,
    rel_path: str,
    new_slug: str | None = None,
    fallback_id: str | None = None,
    **edits: Any,
) -> TaskUpdate:
    """Edits the task at REL_PATH in SNAP, renames it, and syncs its STATUS.md.

    EDITS are edit_task_text's keyword arguments. FALLBACK_ID names the task
    in the result when its frontmatter has no ID.
    """
    project_name = rel_path.split("/", maxsplit=1)[0]
    try:
        content = snap.read_text(rel_path)
    except OSError as e:
        die(f"cannot read task file {rel_path}: {e}")
    new_content, warnings = edit_task_text(snap, rel_path, content, **edits)
    snap.write_markdown(rel_path, new_content)

    data, _ = parse_frontmatter_for_edit(new_content)
    task_id_val = next(
        (str(v) for k, v in data.items() if str(k).lower() == "id"),
        fallback_id or rel_path,
    )

    renamed_from = None
    if new_slug is not None:
        prefix = task_id_val if ID_PATTERN.match(task_id_val) else ""
        new_name = f"{prefix}-{new_slug}.md" if prefix else f"{new_slug}.md"
        new_rel = join_rel(rel_path.rsplit("/", 1)[0], new_name)
        if new_rel != rel_path:
            if snap.exists(new_rel):
                die_scoped(f"cannot rename {rel_path}: {new_name} already exists")
            snap.rename(rel_path, new_rel)
            renamed_from, rel_path = rel_path, new_rel

    sync_status(snap, project_name)
    return TaskUpdate(task_id_val, rel_path, renamed_from, tuple(warnings))


def cmd_update(
    query: str,
    status: str | None = None,
    title: str | None = None,
    slug: str | None = None,
    problem: str | None = None,
    cost: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
    wait_for: list[str] | None = None,
    due: str | None = None,
    stale_after: str | None = None,
    expect_status: str | None = None,
    add_blocked_by: list[str] | None = None,
    remove_blocked_by: list[str] | None = None,
    add_wait_for: list[str] | None = None,
    remove_wait_for: list[str] | None = None,
    add_conversations: list[str] | None = None,
    remove_conversations: list[str] | None = None,
) -> None:
    """Update task fields, status, or headings."""
    new_slug: str | None = None
    if slug is not None:
        new_slug = normalize_slug(slug)
        if not new_slug:
            die_scoped(f"--slug contains no usable characters: {slug}")
        if len(new_slug) > SLUG_MAX_LEN:
            die_scoped(
                f"--slug too long ({len(new_slug)} > {SLUG_MAX_LEN} chars): {new_slug}"
            )

    root = get_repo_root()
    target_path = resolve_target(root, query)
    result = update_task(
        FsSnapshot(root),
        target_path.relative_to(root).as_posix(),
        new_slug=new_slug,
        fallback_id=query,
        status=status,
        title=title,
        problem=problem,
        cost=cost,
        goal=goal,
        criteria=criteria,
        sketch=sketch,
        constraints=constraints,
        outcome=outcome,
        findings=findings,
        next_steps=next_steps,
        conv=conv,
        wait_for=wait_for,
        due=due,
        stale_after=stale_after,
        expect_status=expect_status,
        add_blocked_by=add_blocked_by,
        remove_blocked_by=remove_blocked_by,
        add_wait_for=add_wait_for,
        remove_wait_for=remove_wait_for,
        add_conversations=add_conversations,
        remove_conversations=remove_conversations,
    )
    for warning in result.warnings:
        print(_tagged(f"[WARN]  {warning}", sys.stderr), file=sys.stderr)
    if result.renamed_from:
        print(
            _tagged(
                f"[INFO]  Renamed {result.renamed_from} -> {result.rel_path}",
                sys.stderr,
            ),
            file=sys.stderr,
        )
    print(
        _tagged(f"[INFO]  Updated {result.task_id} in {result.rel_path}", sys.stderr),
        file=sys.stderr,
    )


def schema_document() -> dict[str, Any]:
    """Returns the record schema as plain data, for conformance checks."""
    return {
        "version": SCHEMA_VERSION,
        "value_types": {
            name: {
                "description": vt.description,
                **({"pattern": vt.pattern} if vt.pattern else {}),
                **({"values": list(vt.values)} if vt.values else {}),
            }
            for name, vt in VALUE_TYPES.items()
        },
        "kinds": [
            {
                "kind": schema.kind,
                "path": schema.path,
                "fields": [
                    {
                        "name": f.name,
                        "shape": f.shape,
                        "value": f.value,
                        "required": f.required,
                        "mutable": f.mutable,
                        **({"aliases": list(f.aliases)} if f.aliases else {}),
                    }
                    for f in schema.fields
                ],
                "sections": [
                    {
                        "name": sec.name,
                        "form": sec.form,
                        "required": sec.required,
                        "writable": sec.writable,
                    }
                    for sec in schema.sections
                ],
            }
            for schema in SCHEMAS
        ],
    }


def cmd_schema(as_json: bool = False) -> None:
    """Prints the record schema for tasks, decisions, and STATUS.md."""
    doc = schema_document()
    if as_json:
        print(json.dumps(doc, indent=2))
        return
    for kind in doc["kinds"]:
        print(f"{kind['kind']}: {kind['path']}")
        if kind["fields"]:
            print("  Fields:")
            for f in kind["fields"]:
                notes = [
                    n
                    for n, on in (
                        ("required", f["required"]),
                        ("immutable", not f["mutable"]),
                    )
                    if on
                ]
                notes += [f"alias {a}" for a in f.get("aliases", [])]
                print(
                    f"    {f['name']:<15}{f['shape']:<8}{f['value']:<14}{', '.join(notes)}".rstrip()
                )
        print("  Sections:")
        for sec in kind["sections"]:
            notes = [
                n
                for n, on in (
                    ("required", sec["required"]),
                    ("read-only", not sec["writable"]),
                )
                if on
            ]
            print(f"    {sec['name']:<15}{sec['form']:<11}{', '.join(notes)}".rstrip())
        print()
    print("Value types:")
    for name, vt in doc["value_types"].items():
        print(f"  {name:<15}{vt['description']}")


def select_task_rows(
    snap: Snapshot, project: str | None = None, state: str | None = None
) -> list[TaskRow]:
    """The task rows 'taskgo list' prints, filtered by STATE.

    'ready' is derived, not a declared status: todo with nothing holding it,
    soonest due date first.
    """
    rows = get_task_rows(snap, project)
    if not state:
        return rows
    if state.strip().lower() == "ready":
        index = status_index(snap)
        today = get_today(snap)
        rows = [
            r
            for r in rows
            if r.status == TaskStatus.TODO.value
            and not unresolved_blockers(r, index)
            and not unresolved_wait_for(r, today)
        ]
        rows.sort(
            key=lambda r: (
                parse_iso_date(r.due) is None,
                parse_iso_date(r.due) or date.max,
            )
        )
        return rows
    norm_state = normalize_status(state)
    return [r for r in rows if r.status == norm_state]


def task_row_json(r: TaskRow) -> dict[str, Any]:
    """The JSON form of a task row, as 'taskgo list --json' prints it."""
    return {
        "project": r.project,
        "id": r.task_id,
        "status": r.status,
        "title": r.title,
        "path": r.rel_path,
        "blocked_by": list(r.blocked_by),
        "wait_for": list(r.wait_for),
        "due": r.due,
        "stale_after": r.stale_after,
    }


def cmd_list(
    project: str | None = None,
    state: str | None = None,
    as_json: bool = False,
) -> None:
    """List tasks in the repository or a specific project."""
    rows = select_task_rows(FsSnapshot(get_repo_root()), project, state)

    if as_json:
        print(json.dumps([task_row_json(r) for r in rows], indent=2))
        return

    if not rows:
        return

    print("PROJECT\tTASK\tSTATE\tTITLE\tPATH")
    for r in rows:
        print(
            f"{r.project}\t{r.task_id}\t{r.status or '(missing)'}\t{r.title}\t{r.rel_path}"
        )


def _to_jsonable(val: Any) -> Any:
    """Recursively converts ruamel.yaml mappings/sequences/scalars into standard JSON-serializable types."""
    if isinstance(val, datetime):
        return val.date().isoformat()
    if isinstance(val, date):
        return val.isoformat()
    if isinstance(val, dict):
        return {str(k): _to_jsonable(v) for k, v in val.items()}
    if isinstance(val, list):
        return [_to_jsonable(v) for v in val]
    if not isinstance(val, (str, int, float, bool, type(None))):
        return str(val)
    return val


def _normalize_skill_list(raw: Any) -> list[str]:
    """Normalizes a frontmatter 'skills' value (list or comma/space-separated string) into a list of strings."""
    if not raw:
        return []
    items: list[str] = []
    if isinstance(raw, list):
        for entry in raw:
            for tok in re.split(r"[\s,]+", str(entry).strip()):
                if tok:
                    items.append(tok)
    elif isinstance(raw, str):
        for tok in re.split(r"[\s,]+", raw.strip()):
            if tok:
                items.append(tok)
    seen: set[str] = set()
    deduped: list[str] = []
    for item in items:
        low = item.lower()
        if low not in seen:
            seen.add(low)
            deduped.append(item)
    return deduped


def cmd_info(
    project: str,
    as_json: bool = False,
) -> None:
    """Show project metadata from README.md YAML frontmatter."""
    root = get_repo_root()
    proj_dir = root / require_project(FsSnapshot(root), project)

    readme_file = proj_dir / "README.md"
    if not readme_file.is_file() and (proj_dir / "PROJECT.md").is_file():
        readme_file = proj_dir / "PROJECT.md"

    fm: dict[str, Any] = {}
    if readme_file.is_file():
        fm, _ = parse_frontmatter(readme_file.read_text(encoding="utf-8"))

    skills = _normalize_skill_list(fm.get("skills"))

    info: dict[str, Any] = {
        "project": project,
        "path": str(proj_dir),
        "readme": str(readme_file) if readme_file.is_file() else None,
        "skills": skills,
    }
    for k, v in fm.items():
        if k not in info:
            info[k] = _to_jsonable(v)

    if as_json:
        print(json.dumps(info, indent=2))
        return

    print(f"Project: {project}")
    print(f"Path: {display_path(proj_dir)}")
    print(f"Skills: {', '.join(skills) if skills else 'none'}")
    for k, v in fm.items():
        if k == "skills":
            continue
        label = k.replace("_", " ").title()
        norm_v = _to_jsonable(v)
        if isinstance(norm_v, list):
            val_str = ", ".join(str(x) for x in norm_v) if norm_v else "none"
        elif isinstance(norm_v, dict):
            val_str = json.dumps(norm_v)
        else:
            val_str = str(norm_v)
        print(f"{label}: {val_str}")


def project_status_json(
    snap: Snapshot, project: str, with_tasks: bool = False
) -> dict[str, Any]:
    """One project's entry in 'taskgo status --json'."""
    rows = get_task_rows(snap, project)
    out: dict[str, Any] = {
        "project": project,
        "in_progress": [r.task_id for r in rows if r.status == "in-progress"],
        "blocked": [r.task_id for r in rows if r.status == "blocked"],
        "todo_count": sum(1 for r in rows if r.status == "todo"),
        "done_count": sum(1 for r in rows if r.status == "done"),
    }
    if with_tasks:
        out["tasks"] = [
            {
                "id": r.task_id,
                "status": r.status,
                "title": r.title,
                "path": r.rel_path,
            }
            for r in rows
        ]
    return out


def cmd_status(
    project: str | None = None,
    as_json: bool = False,
) -> None:
    """Show project status or whole-workspace summary."""
    root = get_repo_root()
    snap = FsSnapshot(root)
    if project:
        require_project(snap, project)
        if as_json:
            out = project_status_json(snap, project, with_tasks=True)
            print(json.dumps(out, indent=2))
            return
        status_file = f"{project}/STATUS.md"
        if snap.is_file(status_file):
            print(snap.read_text(status_file).rstrip())
        else:
            print(render_status_file(snap, project).rstrip())
        return

    # All projects
    projects = list_projects(snap)
    if as_json:
        all_data = [project_status_json(snap, p) for p in projects]
        print(json.dumps(all_data, indent=2))
        return

    for p in projects:
        data = project_status_json(snap, p)
        prog_str = ", ".join(data["in_progress"]) if data["in_progress"] else "none"
        blk_str = ", ".join(data["blocked"]) if data["blocked"] else "none"
        print(
            f"{p}: in-progress=[{prog_str}] blocked=[{blk_str}] "
            f"todo={data['todo_count']} done={data['done_count']}"
        )


class TaskgoError(Exception):
    """A refusal the core reports to its caller: the CLI dies with the message,
    the MCP server returns it as a tool error."""


@dataclass(slots=True)
class DispatchPlan:
    task_id: str
    project: str
    title: str
    goal: str
    findings: list[tuple[Literal["WARN", "FAIL"], str]]


def plan_dispatch(
    snap: Snapshot, rel_path: str, content: str, audit: list["Finding"]
) -> DispatchPlan:
    """Checks a committed task record for dispatch.

    CONTENT is the record as committed; AUDIT is the project's audit findings.
    Raises TaskgoError when the record cannot be dispatched at all.
    """
    project_name = rel_path.split("/", maxsplit=1)[0]
    resolved_id = extract_frontmatter_field(content, "id")
    if not ID_PATTERN.match(resolved_id):
        raise TaskgoError(f"{rel_path} has no valid committed task ID")
    status = extract_frontmatter_field(content, "status")
    title = extract_title(content)
    goal = extract_runin(content, "Goal")

    # Dispatching finished work is a selection error, so refuse it.
    if status in RESOLVED_STATES:
        raise TaskgoError(
            f"{resolved_id} is {status}; dispatch accepts only unfinished work "
            f"(see 'taskgo list {project_name} --state ready')"
        )

    findings: list[tuple[Literal["WARN", "FAIL"], str]] = []
    if not title:
        findings.append(
            ("WARN", f"{resolved_id} has no title heading; the note names only its ID")
        )
    if not goal:
        findings.append(
            (
                "WARN",
                f"{resolved_id} has no '**Goal:**'; the summary cannot say what the work is",
            )
        )

    findings.extend(
        (finding.severity, finding.message)
        for finding in audit
        if finding.severity in {"WARN", "FAIL"}
    )

    rows = get_task_rows(snap, project_name)
    row = next((r for r in rows if r.task_id == resolved_id), None)
    if row is not None:
        blockers = unresolved_blockers(row, status_index(snap))
        if blockers:
            findings.append(
                (
                    "WARN",
                    (
                        f"{resolved_id} is still blocked by {', '.join(blockers)}; "
                        "it is not ready to dispatch"
                    ),
                )
            )
        waiting = unresolved_wait_for(row, get_today(snap))
        if waiting:
            findings.append(
                (
                    "WARN",
                    (
                        f"{resolved_id} is still waiting for {', '.join(waiting)}; "
                        "it is not ready to dispatch"
                    ),
                )
            )
    return DispatchPlan(resolved_id, project_name, title, goal, findings)


def dispatch_note(plan: DispatchPlan, status_ref: str, task_ref: str) -> str:
    """The dispatch note: headline, Goal, and where to read before acting."""
    headline = f"Next is taskgo {plan.task_id} ({plan.project})"
    if plan.title:
        headline += f": {plan.title}"
        if plan.title[-1] not in ".?!":
            headline += "."
    else:
        headline += "."

    paragraphs = [headline]
    if plan.goal:
        paragraphs.append(plan.goal)
    paragraphs.append(
        f"Read {status_ref} and the task record ({task_ref}) before acting, and "
        "form your own view of the approach."
    )
    # Never break inside a path or hyphenated identifier: the note is pasted and
    # its file references must stay greppable.
    return "\n\n".join(
        textwrap.fill(p, width=76, break_long_words=False, break_on_hyphens=False)
        for p in paragraphs
    )


def cmd_dispatch(task_id: str) -> None:
    """Emit instructions dispatching an agent to TASK_ID."""
    root = get_repo_root()
    target_path = resolve_target(root, task_id)
    rel_path = Path(str(target_path.relative_to(root))).as_posix()
    project_name = rel_path.split("/")[0]

    committed = run_git(["show", f"HEAD:{rel_path}"], check=False)
    if committed.returncode != 0:
        die_scoped(
            f"{rel_path} is not committed at HEAD; commit the task before dispatching it"
        )

    try:
        plan = plan_dispatch(
            FsSnapshot(root),
            rel_path,
            committed.stdout,
            audit_workspace(root, project_name),
        )
    except TaskgoError as e:
        die_scoped(str(e))

    # A dispatch note points at committed state. Uncommitted project files mean
    # the receiving agent cannot see every current workspace change.
    dirty = run_git(
        ["status", "--porcelain", "--", project_name], check=False
    ).stdout.strip()
    if dirty:
        plan.findings.append(
            (
                "WARN",
                (
                    f"{project_name} has uncommitted changes; the note describes "
                    "committed state only"
                ),
            )
        )

    for severity, message in plan.findings:
        print(_tagged(f"[{severity}]  {message}", sys.stderr), file=sys.stderr)

    status_md = str((root / project_name / "STATUS.md").resolve())
    print(dispatch_note(plan, status_md, str(target_path.resolve())))


def cmd_sync(
    project: str | None = None,
) -> None:
    """Update STATUS.md snapshot for a project or the workspace."""
    snap = FsSnapshot(get_repo_root())
    if project:
        require_project(snap, project)
        updated = sync_status(snap, project)
        if updated:
            print("updated")
        else:
            print("current")
        return

    projects = list_projects(snap)
    all_rows = get_task_rows(snap)
    index = {r.task_id: r.status for r in all_rows if r.task_id}
    any_updated = False
    for p in projects:
        if sync_status(snap, p, all_rows=all_rows, index=index):
            any_updated = True
    if any_updated:
        print("updated")
    else:
        print("current")


def cmd_doctor(
    project: str | None = None,
) -> None:
    """Run mechanical health checks across the workspace or a project."""
    root = get_repo_root()
    _, source = resolve_root_candidate()

    print(_tagged(f"{'[PASS]'.ljust(8)}Control repository"))
    print(f"        Root: {display_path(root)}")
    print(f"        Source: {source}")

    findings = audit_workspace(root, project)

    has_warn_or_fail = False
    for f in findings:
        prefix = f"[{f.severity}]".ljust(8)
        print(_tagged(f"{prefix}{f.message}"))
        if f.severity in ("WARN", "FAIL"):
            has_warn_or_fail = True

    print(
        _tagged(
            """[INFO]  Agent semantic review
        Check STATUS Summary is rewritten current state (not a session log) and matches tasks/Next.
        Check active conversation ID ([<conversation-id>](<agent>://<conversation-id>)) is recorded in STATUS.md Summary or task Outcome.
        Check PLAN is current direction, not accumulated history.
        Check README/ADRs link to artifact or skill owners rather than copying their facts.
        Check private tracker material has not leaked to public/shared artifacts.
        After merges, check reconciled files express one coherent current state."""
        )
    )

    if has_warn_or_fail:
        sys.exit(1)


def cmd_fix(
    project: str | None = None,
    dry_run: bool = False,
    no_commit: bool = False,
) -> None:
    """Auto-heal IDs, statuses, and snapshot drift."""
    root = get_repo_root()
    snap = FsSnapshot(root)
    if project:
        require_project(snap, project)

    findings = audit_workspace(root, project)
    fixable = [f for f in findings if f.remediation is not None]

    if not fixable:
        unfixable = [f for f in findings if f.severity in ("WARN", "FAIL")]
        if unfixable:
            for f in unfixable:
                print(
                    _tagged(
                        f"[{f.severity}]  Manual fix required: {f.message}", sys.stderr
                    ),
                    file=sys.stderr,
                )
        else:
            print(
                _tagged("[INFO]  Workspace is clean, no fixes needed.", sys.stderr),
                file=sys.stderr,
            )
        return

    if dry_run:
        print(
            _tagged(
                f"[INFO]  Dry run: {len(fixable)} repair(s) would be applied:",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        dry_run_files: set[str] = set()
        for f in fixable:
            print(_tagged(f"[INFO]    - {f.message}", sys.stderr), file=sys.stderr)
            if f.path:
                dry_run_files.add(f.path)
        if dry_run_files:
            print("\n".join(sorted(dry_run_files)))
        return

    # Invariant: assert clean Git index before mutating
    diff_cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if diff_cached.returncode != 0:
        die("fix: git index contains staged changes; unstage or commit them first")

    # Execute all remediations and collect explicitly touched paths (deduplicated)
    touched_paths: set[str] = set()
    executed_remediations = set()
    for f in fixable:
        if f.remediation in executed_remediations:
            continue
        executed_remediations.add(f.remediation)
        res = f.remediation()
        if res:
            for p in res:
                touched_paths.add(p)
        elif f.path:
            touched_paths.add(f.path)

    # Re-run audit to verify convergence
    post_findings = audit_workspace(root, project)
    remaining_errors = [f for f in post_findings if f.severity in ("WARN", "FAIL")]
    if remaining_errors:
        for f in remaining_errors:
            print(
                _tagged(
                    f"[{f.severity}]  Still open after fix: {f.message}", sys.stderr
                ),
                file=sys.stderr,
            )

    # Ensure all affected projects have their STATUS.md synchronized and included if modified
    affected_projects: set[str] = set()
    if project:
        affected_projects.add(project)
    for tp in touched_paths:
        parts = tp.split("/")
        if len(parts) > 1 and is_project(snap, parts[0]):
            affected_projects.add(parts[0])

    for proj_name in affected_projects:
        sync_status(snap, proj_name)
        status_p = f"{proj_name}/STATUS.md"
        if snap.is_file(status_p):
            touched_paths.add(status_p)

    # Keep the touched files that have modifications or were created/deleted
    modified_files: list[str] = []
    for rel in sorted(touched_paths, key=path_key):
        st = run_git(["status", "--porcelain", "--", rel], check=False).stdout.strip()
        if st and rel not in modified_files:
            modified_files.append(rel)

    if not modified_files:
        print(
            _tagged("[INFO]  Workspace is clean, no files changed.", sys.stderr),
            file=sys.stderr,
        )
        return

    if no_commit:
        print(
            _tagged(
                f"[INFO]  Applied {len(modified_files)} repair(s) without commit (--no-commit).",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        print("\n".join(modified_files))
        return

    if not has_commit_auth(root):
        print(
            _tagged(
                f"[INFO]  Applied {len(modified_files)} repair(s) (commit skipped: no auth marker).",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        print("\n".join(modified_files))
        return

    run_git(["add", "--", *modified_files])
    commit_msg = conventional_subject("fix metadata and status", project) + "\n"
    run_git(["commit", "--no-verify", "--no-gpg-sign", "-m", commit_msg])
    commit_sha = run_git(["rev-parse", "HEAD"]).stdout.strip()

    print(
        _tagged(
            f"[INFO]  Committed {len(modified_files)} fixed file(s): {commit_sha[:10]}",
            sys.stderr,
        ),
        file=sys.stderr,
    )

    # Machine-readable output contract on stdout
    print(f"COMMIT_SHA: {commit_sha}")
    print(f"MODIFIED: {','.join(modified_files)}")
    print(f"SUMMARY: {commit_msg.strip()}")


_BUG_URI_RE = re.compile(r"^b/(\d+)$", re.IGNORECASE)
_CL_URI_RE = re.compile(r"^cl/(\d+)$", re.IGNORECASE)
_GH_URI_RE = re.compile(r"^gh:([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#(\d+)$", re.IGNORECASE)

_BUG_TERMINAL_STATES = {"FIXED", "WONT_FIX", "DUPLICATE", "OBSOLETE"}
_CL_TERMINAL_STATES = {"MERGED", "SUBMITTED", "ABANDONED"}
_GH_TERMINAL_STATES = {"CLOSED", "MERGED"}


@dataclass(slots=True, frozen=True)
class CheckTrigger:
    kind: Literal[
        "wait_for_elapsed",
        "wait_for_resolved",
        "wait_for_activity",
        "due_overdue",
        "due_soon",
        "stale",
    ]
    gate: str | None
    detail: str
    upstream_state: str | None = None
    upstream_modified: str | None = None


def _is_offline() -> bool:
    return os.environ.get("AGENT_OFFLINE", "").strip().lower() in {
        "1",
        "true",
        "yes",
        "on",
    }


def parse_iso_timestamp(value: Any) -> datetime | None:
    """Parses an ISO 8601 or Perforce timestamp string into an aware UTC datetime."""
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, datetime):
        return value if value.tzinfo is not None else value.replace(tzinfo=timezone.utc)
    s = str(value).strip().strip("'\"")
    if not s:
        return None
    normalized = re.sub(r"^(\d{4})/(\d{2})/(\d{2})\b", r"\1-\2-\3", s)
    try:
        dt = datetime.fromisoformat(normalized)
        return dt if dt.tzinfo is not None else dt.replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def get_task_watermark(root: Path, row: TaskRow) -> tuple[str | None, datetime | None]:
    """Returns (iso_str, aware_datetime) for the latest task-scoped commit on row.rel_path.

    Uses `git log -1 --grep="^Task: <ID>$" --format=%cI -- <task_file>` first so
    mechanical formatting sweeps (`taskgo fix`) cannot advance the watermark,
    falling back to `git log -1 --format=%cI -- <task_file>`.
    """
    ts_str = ""
    if row.task_id:
        res = run_git(
            [
                "log",
                "-1",
                f"--grep=^Task: {row.task_id}$",
                "--format=%cI",
                "--",
                row.rel_path,
            ],
            cwd=root,
            check=False,
        )
        if res.returncode == 0:
            ts_str = res.stdout.strip()
    if not ts_str:
        res = run_git(
            ["log", "-1", "--format=%cI", "--", row.rel_path],
            cwd=root,
            check=False,
        )
        if res.returncode == 0:
            ts_str = res.stdout.strip()
    if not ts_str:
        return None, None
    return ts_str, parse_iso_timestamp(ts_str)


def _run_probe_cmd(cmd: list[str], timeout_sec: float = 10.0) -> str | None:
    """Runs a read-only external probe command gracefully, returning stdout or None."""
    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError:
        return None
    _active_subprocesses.add(proc)
    try:
        stdout, _ = proc.communicate(timeout=timeout_sec)
    except (subprocess.TimeoutExpired, OSError):
        try:
            proc.kill()
            proc.wait(timeout=1.0)
        except (OSError, subprocess.SubprocessError):
            pass
        return None
    finally:
        _active_subprocesses.discard(proc)
    if proc.returncode != 0:
        return None
    return stdout or ""


def poll_external_uri(
    gate: str,
) -> tuple[str, bool, datetime | None, str | None] | None:
    """Polls an external wait_for URI (`b/<id>`, `cl/<id>`, `gh:owner/repo#num`).

    Returns `(canonical_status, is_terminal, modified_dt, modified_str)`, or `None`
    when `gate` is not an external URI or when corp/network tools are unavailable.
    """
    if _is_offline():
        return None

    if m_bug := _BUG_URI_RE.match(gate):
        issues_bin = shutil.which("issues")
        if not issues_bin:
            default_issues = Path("/google/bin/releases/issues-cli/issues")
            if default_issues.is_file() and os.access(default_issues, os.X_OK):
                issues_bin = str(default_issues)
        if not issues_bin:
            return None
        out = _run_probe_cmd(
            [issues_bin, "readonly", "get-issue-metadata", m_bug.group(1)]
        )
        if out is None:
            return None
        raw_status: str | None = None
        raw_mod: str | None = None
        for line in out.splitlines():
            key, sep, val = line.partition(":")
            if not sep:
                continue
            k = key.strip().lower()
            v = val.strip()
            if k == "status":
                raw_status = v
            elif k == "last modified":
                raw_mod = v
        if not raw_status and not raw_mod:
            return None
        norm_status = (raw_status or "OPEN").upper().replace("-", "_").replace(" ", "_")
        if norm_status == "WONTFIX":
            norm_status = "WONT_FIX"
        return (
            norm_status,
            norm_status in _BUG_TERMINAL_STATES,
            parse_iso_timestamp(raw_mod),
            raw_mod,
        )

    if m_cl := _CL_URI_RE.match(gate):
        g4_bin = shutil.which("g4")
        if not g4_bin:
            return None
        out = _run_probe_cmd([g4_bin, "describe", "-s", m_cl.group(1)])
        if out is None:
            return None
        first_line = next((ln.strip() for ln in out.splitlines() if ln.strip()), "")
        m_redir = re.match(r"^Change\s+\d+\s+is\s+([A-Za-z_-]+)", first_line)
        if m_redir:
            norm_status = m_redir.group(1).upper().replace("-", "_")
            return norm_status, norm_status in _CL_TERMINAL_STATES, None, None
        m_hdr = re.match(
            r"^Change\s+\d+\s+by\s+\S+\s+on\s+(\d{4}/\d{2}/\d{2}\s+\d{2}:\d{2}:\d{2})(?:\s+\*([^*]+)\*)?",
            first_line,
        )
        if not m_hdr:
            return None
        raw_mod = m_hdr.group(1)
        norm_status = (m_hdr.group(2) or "SUBMITTED").strip().upper().replace("-", "_")
        return (
            norm_status,
            norm_status in _CL_TERMINAL_STATES,
            parse_iso_timestamp(raw_mod),
            raw_mod,
        )

    if m_gh := _GH_URI_RE.match(gate):
        gh_bin = shutil.which("gh")
        if not gh_bin:
            return None
        out = _run_probe_cmd(
            [
                gh_bin,
                "issue",
                "view",
                m_gh.group(2),
                "--repo",
                m_gh.group(1),
                "--json",
                "state,updatedAt",
            ]
        )
        if out is None:
            return None
        try:
            data = json.loads(out)
        except json.JSONDecodeError:
            return None
        if not isinstance(data, dict):
            return None
        raw_status = str(data.get("state") or "").strip() or None
        raw_mod = str(data.get("updatedAt") or "").strip() or None
        if not raw_status and not raw_mod:
            return None
        norm_status = (raw_status or "OPEN").upper().replace("-", "_")
        return (
            norm_status,
            norm_status in _GH_TERMINAL_STATES,
            parse_iso_timestamp(raw_mod),
            raw_mod,
        )

    return None


def cmd_check(
    project: str | None = None,
    as_json: bool = False,
) -> None:
    """Evaluate wait_for gates, due deadlines, and stale_after cutoffs."""
    root = get_repo_root()
    snap = FsSnapshot(root)
    if project:
        require_project(snap, project)

    today = get_today(snap)
    rows = get_task_rows(snap, project)
    probe_cache: dict[str, tuple[str, bool, datetime | None, str | None] | None] = {}

    triggered_entries: list[tuple[TaskRow, str | None, list[CheckTrigger]]] = []

    for row in rows:
        if row.status in RESOLVED_STATES:
            continue
        if not (row.wait_for or row.due or row.stale_after):
            continue

        triggers: list[CheckTrigger] = []
        watermark_cached: tuple[str | None, datetime | None] | None = None

        def get_wm(r: TaskRow = row) -> tuple[str | None, datetime | None]:
            nonlocal watermark_cached
            if watermark_cached is None:
                watermark_cached = get_task_watermark(root, r)
            return watermark_cached

        for gate in row.wait_for:
            gate_date = parse_iso_date(gate)
            if gate_date is not None:
                if today >= gate_date:
                    triggers.append(
                        CheckTrigger(
                            kind="wait_for_elapsed",
                            gate=gate,
                            detail=f"wait_for date {gate_date.isoformat()} elapsed",
                        )
                    )
                continue

            if gate not in probe_cache:
                probe_cache[gate] = poll_external_uri(gate)
            polled = probe_cache[gate]
            if polled is None:
                continue

            up_status, is_terminal, mod_dt, mod_str = polled
            if is_terminal:
                triggers.append(
                    CheckTrigger(
                        kind="wait_for_resolved",
                        gate=gate,
                        detail=f"wait_for {gate} resolved ({up_status})",
                        upstream_state=up_status,
                        upstream_modified=mod_str,
                    )
                )
            elif mod_dt is not None:
                _, wm_dt = get_wm()
                if wm_dt is None or mod_dt > wm_dt:
                    triggers.append(
                        CheckTrigger(
                            kind="wait_for_activity",
                            gate=gate,
                            detail=(
                                f"wait_for {gate} updated ({up_status} at "
                                f"{mod_str or mod_dt.isoformat()})"
                            ),
                            upstream_state=up_status,
                            upstream_modified=mod_str or mod_dt.isoformat(),
                        )
                    )

        if row.due is not None:
            due_date = parse_iso_date(row.due)
            if due_date is not None:
                if today > due_date:
                    triggers.append(
                        CheckTrigger(
                            kind="due_overdue",
                            gate=due_date.isoformat(),
                            detail=(
                                f"overdue (due {due_date.isoformat()}, "
                                f"{(today - due_date).days}d ago)"
                            ),
                        )
                    )
                elif due_date <= today + timedelta(days=2):
                    triggers.append(
                        CheckTrigger(
                            kind="due_soon",
                            gate=due_date.isoformat(),
                            detail=f"due soon (due {due_date.isoformat()}, within 48h)",
                        )
                    )

        if row.stale_after is not None:
            stale_date = parse_iso_date(row.stale_after)
            if stale_date is not None and today > stale_date:
                triggers.append(
                    CheckTrigger(
                        kind="stale",
                        gate=stale_date.isoformat(),
                        detail=f"stale task (stale_after {stale_date.isoformat()})",
                    )
                )

        if triggers:
            wm_str, _ = get_wm()
            triggered_entries.append((row, wm_str, triggers))

    if not triggered_entries:
        return

    if as_json:
        out = [
            {
                "project": r.project,
                "id": r.task_id,
                "status": r.status,
                "title": r.title,
                "path": r.rel_path,
                "watermark": wm_str,
                "wait_for": list(r.wait_for),
                "due": r.due,
                "stale_after": r.stale_after,
                "triggers": [
                    {
                        "kind": t.kind,
                        "gate": t.gate,
                        "detail": t.detail,
                        **(
                            {"upstream_state": t.upstream_state}
                            if t.upstream_state is not None
                            else {}
                        ),
                        **(
                            {"upstream_modified": t.upstream_modified}
                            if t.upstream_modified is not None
                            else {}
                        ),
                    }
                    for t in trigs
                ],
            }
            for r, wm_str, trigs in triggered_entries
        ]
        print(json.dumps(out, indent=2))
        return

    for r, _, trigs in triggered_entries:
        summary = "; ".join(t.detail for t in trigs)
        print(
            f"{r.project}\t{r.task_id}\t{r.status or '(missing)'}\t{summary}\t{r.rel_path}"
        )


@dataclass(slots=True, frozen=True)
class FieldChange:
    date: str
    before: str
    after: str
    sha: str
    subject: str


def field_history(
    versions: list[tuple[str, str, str, str]], field: str
) -> list[FieldChange]:
    """Changes of frontmatter FIELD across VERSIONS, oldest first.

    Each version is (commit SHA, date, subject, file content). A version whose
    value equals the previous one is skipped; the first has before '(none)'.
    """
    changes: list[FieldChange] = []
    prev = "__x"
    for sha, d, s, content in versions:
        v = extract_frontmatter_field(content, field)
        if v == prev:
            continue
        prev_label = "(none)" if prev == "__x" else prev
        changes.append(FieldChange(d, prev_label, v or "(missing)", sha, s))
        prev = v
    return changes


def format_field_change(c: FieldChange) -> str:
    return f"{c.date}\t{c.before} -> {c.after}\t{c.sha[:10]}\t{c.subject}"


def file_versions(
    repo: Path, rev: str, rel_path: str
) -> list[tuple[str, str, str, str]]:
    """Every committed version of REL_PATH reachable from REV, oldest first,
    following renames, as field_history takes them."""
    cmd = [
        "log",
        "--follow",
        "--name-only",
        "--format=COMMIT:%H\t%ad\t%s",
        "--date=short",
        rev,
        "--",
        rel_path,
    ]
    res = run_git(cmd, cwd=repo)

    entries: list[tuple[str, str, str, str]] = []
    cur_sha = ""
    cur_date = ""
    cur_subj = ""

    for line in res.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith("COMMIT:"):
            parts = line[len("COMMIT:") :].split("\t", 2)
            cur_sha = parts[0]
            cur_date = parts[1] if len(parts) > 1 else ""
            cur_subj = parts[2] if len(parts) > 2 else ""
        else:
            entries.append((cur_sha, cur_date, cur_subj, line))

    versions: list[tuple[str, str, str, str]] = []
    for sha, d, s, p in reversed(entries):
        show_res = run_git(["show", f"{sha}:{p}"], cwd=repo, check=False)
        if show_res.returncode != 0:
            continue
        versions.append((sha, d, s, show_res.stdout))
    return versions


def cmd_history(query: str, field: str = "status") -> None:
    """Show frontmatter field history across git revisions."""
    root = get_repo_root()
    target_path = resolve_target(root, query, allow_deleted=True)
    rel_path = str(target_path.relative_to(root))

    versions = file_versions(root, "HEAD", rel_path)
    if not versions:
        die(f"no git history for {rel_path}")

    for change in field_history(versions, field):
        print(format_field_change(change))


def cmd_checkpoint(
    task_id: str,
    subject: str,
    all_files: bool = False,
    paths: list[str] | None = None,
    body: str = "",
    refs: list[str] | None = None,
    conv: str | None = None,
) -> None:
    """Commit an authorized tracker checkpoint for TASK_ID."""
    paths_list = paths or []
    refs_list = refs or []
    session = get_active_session(conv)
    conv_uri = f"{session[0]}://{session[1]}" if session else None

    root = get_repo_root()
    if not ID_PATTERN.match(task_id):
        die(f"checkpoint: invalid task ID: {task_id}")

    if not has_commit_auth(root):
        die(f"checkpoint: committed AGENTS.md must contain {COMMIT_AUTH}")

    # Index must be empty
    diff_cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if diff_cached.returncode != 0:
        die("checkpoint: index is not empty")

    target_path = resolve_target(root, task_id)
    rel_path = str(target_path.relative_to(root))
    project_name = Path(rel_path).as_posix().split("/")[0]
    snap = FsSnapshot(root)
    require_project(snap, project_name)
    status_rel = f"{project_name}/STATUS.md"

    requested = [rel_path, status_rel]
    for p_arg in paths_list:
        p_clean = p_arg.removeprefix("./")
        if p_clean.startswith("/") or ".." in p_clean.split("/"):
            die(f"checkpoint: unsafe path: {p_arg}")
        if not p_clean.startswith(f"{project_name}/"):
            die(f"checkpoint: path is outside project {project_name}: {p_arg}")
        is_existing_file = (root / p_clean).is_file()
        is_git_deleted = bool(
            run_git(["status", "--porcelain", "--", p_clean]).stdout.strip()
        )
        if not is_existing_file and not is_git_deleted:
            die(f"checkpoint: path not found: {p_arg}")
        requested.append(p_clean)

    # Synchronize status for project
    sync_status(snap, project_name)

    # Find project changes
    diff_proj = [
        f
        for f in run_git(
            ["diff", "-z", "--name-only", "--", f"{project_name}/"]
        ).stdout.split("\0")
        if f
    ]
    untracked_proj = [
        f
        for f in run_git(
            [
                "ls-files",
                "-z",
                "--others",
                "--exclude-standard",
                "--",
                f"{project_name}/",
            ]
        ).stdout.split("\0")
        if f
    ]
    all_changed = sorted(set(diff_proj + untracked_proj))

    if all_files:
        requested = sorted(set(requested + [c for c in all_changed if c]))

    # Check that at least one project file has changes
    has_changes = any(
        bool(run_git(["status", "--porcelain", "--", req]).stdout.strip())
        for req in requested
    )
    if not has_changes:
        die("checkpoint: no project changes detected to commit")

    # Check for unlisted project changes
    unlisted = [c for c in all_changed if c and c not in requested]
    if unlisted:
        suggested = " ".join(f"--path {p}" for p in unlisted)
        print(
            f"[HINT] To include unlisted project file(s), add --all or: {suggested}",
            file=sys.stderr,
        )
        die(f"checkpoint: unlisted project change: {unlisted[0]}")

    # Run doctor in-process
    findings = audit_workspace(root, project_name)
    if any(f.severity in ("WARN", "FAIL") for f in findings):
        die("checkpoint: doctor found errors")

    if session:
        scheme, c_id = session
        try:
            t_content = target_path.read_text(encoding="utf-8")
            t_data, t_body = parse_frontmatter_for_edit(t_content)
            if update_task_conversation(t_data, scheme, c_id):
                new_content = f"{dump_frontmatter(t_data)}{t_body}"
                write_markdown(target_path, new_content)
        except Exception as e:
            print(
                _tagged(
                    f"[WARN]  Failed to update task frontmatter: {e}",
                    sys.stderr,
                ),
                file=sys.stderr,
            )

    # Stage requested files
    try:
        run_git(["add", "--", *requested])
        cached_check = run_git(["diff", "--cached", "--quiet"], check=False)
        if cached_check.returncode == 0:
            die("checkpoint: nothing to commit")

        staged_files = [
            f
            for f in run_git(["diff", "-z", "--cached", "--name-only"]).stdout.split(
                "\0"
            )
            if f
        ]
        for sf in staged_files:
            if sf and sf not in requested:
                die(f"checkpoint: refused staged path: {sf}")

        subject = ensure_conventional_subject(subject, project_name)
        wrapped_body = wrap_body(body)
        if body and wrapped_body != body:
            print(
                _tagged(
                    "[WARN]  Rewrapped commit body to fit 72 characters", sys.stderr
                ),
                file=sys.stderr,
            )
        msg_lines = [subject]
        if body:
            msg_lines.extend(["", wrapped_body])
        trailers = []
        if conv_uri:
            trailers.append(f"Conversation: {conv_uri}")
        for r in refs_list:
            trailers.append(f"Ref: {r}")
        if trailers:
            msg_lines.append("")
            msg_lines.extend(trailers)
        msg = "\n".join(msg_lines) + "\n"

        run_git(["commit", "--no-verify", "--no-gpg-sign", "-F", "-"], input_data=msg)
    except BaseException:
        run_git(["restore", "--staged", "--", *requested], check=False)
        raise


def cmd_commit(
    subject: str,
    body: str = "",
    refs: list[str] | None = None,
    conv: str | None = None,
) -> None:
    """Commit a logical transition with automatic project status synchronization."""
    refs_list = refs or []
    session = get_active_session(conv)
    conv_uri = f"{session[0]}://{session[1]}" if session else None
    root = get_repo_root()
    snap = FsSnapshot(root)
    if not has_commit_auth(root):
        die(f"commit: committed AGENTS.md must contain {COMMIT_AUTH}")

    diff_cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if diff_cached.returncode == 0:
        die("nothing staged")

    staged_files = [
        f
        for f in run_git(["diff", "-z", "--cached", "--name-only"]).stdout.split("\0")
        if f
    ]
    projects = {
        f.split("/")[0]
        for f in staged_files
        if "/" in f and is_project(snap, f.split("/")[0])
    }
    if len(projects) > 1:
        die("staged changes touch multiple projects")

    if projects:
        project_name = next(iter(projects))
        require_project(snap, project_name)
        findings = audit_workspace(root, project_name)
        if any(f.severity in ("WARN", "FAIL") for f in findings):
            die("doctor found errors")
        if session:
            scheme, c_id = session
            for sf in staged_files:
                if "/tasks/" in sf and sf.endswith(".md"):
                    p_sf = root / sf
                    if p_sf.is_file():
                        try:
                            t_content = p_sf.read_text(encoding="utf-8")
                            t_data, t_body = parse_frontmatter_for_edit(t_content)
                            if update_task_conversation(t_data, scheme, c_id):
                                new_content = f"{dump_frontmatter(t_data)}{t_body}"
                                write_markdown(p_sf, new_content)
                                run_git(["add", sf])
                        except Exception as e:
                            print(
                                _tagged(
                                    f"[WARN]  Failed to update task frontmatter: {e}",
                                    sys.stderr,
                                ),
                                file=sys.stderr,
                            )
        status_porcelain = run_git(
            ["status", "--porcelain", "--", f"{project_name}/STATUS.md"],
            check=False,
        ).stdout.strip()
        if status_porcelain:
            print(
                _tagged(
                    f"[INFO]  Staging working-tree updates in {project_name}/STATUS.md",
                    sys.stderr,
                ),
                file=sys.stderr,
            )
        if sync_status(snap, project_name):
            run_git(["add", f"{project_name}/STATUS.md"])

    project_for_scope = next(iter(projects)) if projects else None
    subject = ensure_conventional_subject(subject, project_for_scope)
    wrapped_body = wrap_body(body)
    if body and wrapped_body != body:
        print(
            _tagged("[WARN]  Rewrapped commit body to fit 72 characters", sys.stderr),
            file=sys.stderr,
        )
    msg_lines = [subject]
    if body:
        msg_lines.extend(["", wrapped_body])
    trailers = []
    if conv_uri:
        trailers.append(f"Conversation: {conv_uri}")
    for r in refs_list:
        trailers.append(f"Ref: {r}")
    if trailers:
        msg_lines.append("")
        msg_lines.extend(trailers)
    msg = "\n".join(msg_lines) + "\n"

    run_git(["commit", "--no-verify", "--no-gpg-sign", "-F", "-"], input_data=msg)


# ===========================================================================
# MCP server ('taskgo mcp'): read-only tools over committed state
# ===========================================================================
#
# Each tools/call resolves one commit and reads only that commit, through a
# GitTreeSnapshot, so a response is coherent even while main moves. Payloads
# that the CLI also prints use the CLI's own functions, so they match the CLI
# at that commit. The transport is MCP Streamable HTTP, stateless: each POST
# carries one JSON-RPC message and gets one JSON response. Cloudflare Access
# authenticates callers in front of the server; the server checks the Access
# JWT on every request. --stdio serves one local client instead.

MCP_SERVER_VERSION = "0.3.0"
MCP_PROTOCOL_VERSIONS = ("2025-11-25", "2025-06-18", "2025-03-26")
MCP_MAX_FILE_BYTES = 256 * 1024
MCP_MAX_REQUEST_BYTES = 1024 * 1024
MCP_FETCH_TIMEOUT = 60
MCP_CERTS_TTL = 3600
MCP_LOOPBACK = ("localhost", "127.0.0.1", "::1")
# Answers GET with 200 and no content, unauthenticated, for health checks such
# as a reverse proxy's. It reads nothing.
MCP_HEALTH_PATH = "/up"

MCP_DATA_CARE = (
    "Data care: everything this server returns is private tracker content. "
    "Never copy it, or conversation links from it, into artifact repositories "
    "(code, commits, pull request descriptions, issues, or files), which may "
    "be public. Describe the work there in your own words, from the code."
)

MCP_UNVERIFIED = (
    "External wait_for gates (bugs, changes, issues, people) are not checked by "
    "this server; each is reported as unverified and treated as still holding "
    "its task. Run 'taskgo check' locally to poll them."
)

MCP_INSTRUCTIONS = f"""\
This server reads a taskgo control repository: a private Git repository of
Markdown that tracks projects, tasks (TASK-XXXXX), decisions, and each
project's STATUS.md. It is read-only.

Start with list_projects or list_tasks (state 'ready' for workable tasks),
then get_task and get_project_status. dispatch_task gives the briefing note
for a task. Every response names the commit it read in as_of.commit; pass it
as 'at' to keep several reads on the same commit.

{MCP_DATA_CARE}

{MCP_UNVERIFIED}"""


class McpToolError(Exception):
    """A refusal reported to the MCP client as a tool error."""


@dataclass(slots=True)
class McpConfig:
    repo: Path
    remote: str | None  # None reads the local branch without fetching
    branch: str
    auth: Literal["access", "none"]
    team: str | None = None
    audience: str | None = None
    certs_url: str | None = None


class McpReader:
    """Resolves commits of one control repository and keeps their snapshots.

    Snapshots are immutable per commit, so the few most recent are kept.
    """

    KEEP = 4

    def __init__(self, cfg: McpConfig):
        self.cfg = cfg
        self.snaps: dict[str, tuple[GitTreeSnapshot, int]] = {}

    def git(self, *args: str) -> subprocess.CompletedProcess:
        return run_git(list(args), cwd=self.cfg.repo, check=False)

    def fetch(self) -> None:
        cfg = self.cfg
        try:
            res = subprocess.run(
                ["git", "fetch", "--quiet", "--no-tags", cfg.remote, cfg.branch],
                cwd=cfg.repo,
                capture_output=True,
                text=True,
                timeout=MCP_FETCH_TIMEOUT,
                env=dict(os.environ, GIT_TERMINAL_PROMPT="0"),
                check=False,
            )
        except subprocess.TimeoutExpired:
            raise McpToolError(
                f"could not fetch {cfg.branch} from {cfg.remote} (timed out); "
                "pass an earlier as_of.commit as 'at' to read it"
            ) from None
        if res.returncode != 0:
            print(f"taskgo mcp: fetch failed: {res.stderr.strip()}", file=sys.stderr)
            raise McpToolError(
                f"could not fetch {cfg.branch} from {cfg.remote}; pass an "
                "earlier as_of.commit as 'at' to read it"
            )

    def resolve(self, at: Any) -> str:
        """The commit to read: AT when given, else the head of the branch."""
        if at:
            if not isinstance(at, str) or not re.fullmatch(r"[0-9a-fA-F]{7,40}", at):
                raise McpToolError(f"'at' is not a commit SHA: {at!r}")
            res = self.git("rev-parse", "--verify", "--quiet", f"{at}^{{commit}}")
            if res.returncode != 0 and self.cfg.remote:
                # Perhaps newer than the last fetch.
                self.fetch()
                res = self.git("rev-parse", "--verify", "--quiet", f"{at}^{{commit}}")
            if res.returncode != 0:
                raise McpToolError(f"no commit {at} in the control repository")
            return res.stdout.strip()
        if self.cfg.remote:
            self.fetch()
            ref = f"refs/remotes/{self.cfg.remote}/{self.cfg.branch}"
        else:
            ref = f"refs/heads/{self.cfg.branch}"
        res = self.git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}")
        if res.returncode != 0:
            raise McpToolError(f"{ref} does not exist in the control repository")
        return res.stdout.strip()

    def snapshot(self, sha: str) -> tuple[GitTreeSnapshot, int]:
        """The snapshot of commit SHA and its commit time (Unix seconds)."""
        if sha in self.snaps:
            self.snaps[sha] = self.snaps.pop(sha)  # most recent last
            return self.snaps[sha]
        snap = GitTreeSnapshot(self.cfg.repo, sha)
        committed = int(self.git("show", "-s", "--format=%ct", sha).stdout.strip())
        self.snaps[sha] = (snap, committed)
        while len(self.snaps) > self.KEEP:
            self.snaps.pop(next(iter(self.snaps)))
        return snap, committed


@dataclass(slots=True)
class McpRead:
    """One tool call's view: a commit, its snapshot, and the reader."""

    reader: McpReader
    snap: GitTreeSnapshot
    committed: int

    def as_of(self) -> dict[str, Any]:
        return {
            "commit": self.snap.rev,
            "committed_at": datetime.fromtimestamp(
                self.committed, timezone.utc
            ).isoformat(),
            "today": get_today(self.snap).isoformat(),
            "timezone": repo_timezone_name(self.snap),
        }


def mcp_unverified_gates(rows: list[TaskRow]) -> dict[str, list[str]]:
    out = {}
    for r in rows:
        gates = [g for g in r.wait_for if parse_iso_date(g) is None]
        if gates and r.status not in RESOLVED_STATES:
            out[r.task_id] = gates
    return out


def mcp_find_task(snap: GitTreeSnapshot, task_id: Any) -> TaskRow:
    task_id = str(task_id or "").strip().upper()
    if not ID_PATTERN.match(task_id):
        raise McpToolError(f"not a task ID: {task_id!r} (expected TASK-XXXXX)")
    matches = [r for r in get_task_rows(snap) if r.task_id == task_id]
    if not matches:
        raise McpToolError(f"{task_id} is not in commit {snap.rev[:12]}")
    if len(matches) > 1:
        paths = ", ".join(r.rel_path for r in matches)
        raise McpToolError(f"{task_id} names more than one record: {paths}")
    return matches[0]


def mcp_project(snap: GitTreeSnapshot, project: Any) -> str:
    if not isinstance(project, str) or not is_project(snap, project):
        raise McpToolError(f"unknown project: {project}")
    return project


def mcp_path(path: Any) -> str:
    path = str(path or "").strip().strip("/")
    parts = path.split("/") if path else []
    if any(p in ("", ".", "..") for p in parts) or "\\" in path:
        raise McpToolError(f"invalid path: {path!r}")
    if parts and parts[0].startswith(".git"):
        raise McpToolError(f"invalid path: {path!r}")
    return path


def mcp_list_projects(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    return {
        "as_of": r.as_of(),
        "projects": [project_status_json(r.snap, p) for p in list_projects(r.snap)],
    }


def mcp_list_tasks(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    project = args.get("project")
    if project:
        mcp_project(r.snap, project)
    state = args.get("state")
    if state and state.strip().lower() != "ready" and canonical_status(state) is None:
        raise McpToolError(f"unknown state: {state}")
    rows = select_task_rows(r.snap, project, state)
    return {
        "as_of": r.as_of(),
        "tasks": [task_row_json(row) for row in rows],
        "unverified_gates": mcp_unverified_gates(rows),
    }


def mcp_get_task(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    row = mcp_find_task(r.snap, args.get("id"))
    content = r.snap.read_text(row.rel_path)
    fm, _ = parse_frontmatter(content)
    return {
        "as_of": r.as_of(),
        "task": task_row_json(row),
        "blob": r.snap.blobs[row.rel_path],
        "frontmatter": _to_jsonable(fm),
        "sections": record_sections(content, TASK_SCHEMA),
        "unresolved_blocked_by": unresolved_blockers(row, status_index(r.snap)),
        "unresolved_wait_for": unresolved_wait_for(row, get_today(r.snap)),
        "unverified_gates": mcp_unverified_gates([row]).get(row.task_id, []),
        "content": content,
    }


def mcp_get_project_status(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    project = mcp_project(r.snap, args.get("project"))
    rel = f"{project}/STATUS.md"
    committed = r.snap.read_text(rel) if r.snap.is_file(rel) else None
    fresh = format_markdown(render_status_file(r.snap, project))

    def block(text: str | None) -> str | None:
        if text is None:
            return None
        sections = record_sections(text, STATUS_SCHEMA)
        return next((s["text"] for s in sections if s["name"] == "snapshot"), None)

    committed_block = block(committed)
    fresh_block = block(fresh)
    return {
        "as_of": r.as_of(),
        "project": project,
        "path": rel,
        "blob": r.snap.blobs.get(rel),
        "sections": (
            record_sections(committed, STATUS_SCHEMA) if committed is not None else []
        ),
        "committed_block": committed_block,
        "fresh_block": fresh_block,
        "block_current": committed_block == fresh_block,
        "unverified_gates": mcp_unverified_gates(get_task_rows(r.snap, project)),
        "content": committed,
    }


def mcp_read_file(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    rel = mcp_path(args.get("path"))
    sha = r.snap.blobs.get(rel)
    if sha is None:
        if r.snap.is_dir(rel):
            raise McpToolError(f"{rel} is a directory; use list_files")
        raise McpToolError(f"{rel} is not in commit {r.snap.rev[:12]}")
    size = int(r.reader.git("cat-file", "-s", sha).stdout.strip())
    if size > MCP_MAX_FILE_BYTES:
        raise McpToolError(
            f"{rel} is {size} bytes; the server returns files up to "
            f"{MCP_MAX_FILE_BYTES} bytes"
        )
    raw = run_git(["cat-file", "blob", sha], cwd=r.reader.cfg.repo, text=False).stdout
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise McpToolError(f"{rel} is not UTF-8 text") from None
    return {"as_of": r.as_of(), "path": rel, "blob": sha, "size": size, "content": text}


def mcp_list_files(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    prefix = mcp_path(args.get("prefix"))
    if prefix and not r.snap.exists(prefix):
        raise McpToolError(f"{prefix} is not in commit {r.snap.rev[:12]}")
    files = [
        {"path": rel, "blob": sha, "executable": r.snap.modes[rel] == "100755"}
        for rel, sha in sorted(r.snap.blobs.items())
        if not prefix or rel == prefix or rel.startswith(prefix + "/")
    ]
    return {"as_of": r.as_of(), "files": files}


def mcp_dispatch_task(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    row = mcp_find_task(r.snap, args.get("id"))
    content = r.snap.read_text(row.rel_path)
    try:
        plan = plan_dispatch(
            r.snap, row.rel_path, content, audit_snapshot(r.snap, row.project)
        )
    except TaskgoError as e:
        raise McpToolError(str(e)) from None
    note = dispatch_note(plan, f"{row.project}/STATUS.md", row.rel_path)
    note += (
        "\n\nThese paths are in the taskgo control repository, not in your "
        "checkout: read them with this server's get_project_status and get_task "
        f"tools, at commit {r.snap.rev[:12]}.\n\n{MCP_DATA_CARE}"
    )
    return {
        "as_of": r.as_of(),
        "task": task_row_json(row),
        "findings": [{"severity": s, "message": m} for s, m in plan.findings],
        "unverified_gates": mcp_unverified_gates([row]).get(row.task_id, []),
        "note": note,
    }


def mcp_get_task_history(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    row = mcp_find_task(r.snap, args.get("id"))
    field = str(args.get("field") or "status").strip()
    versions = file_versions(r.reader.cfg.repo, r.snap.rev, row.rel_path)
    changes = field_history(versions, field)
    return {
        "as_of": r.as_of(),
        "task": task_row_json(row),
        "field": field,
        "changes": [
            {
                "date": c.date,
                "before": c.before,
                "after": c.after,
                "commit": c.sha,
                "subject": c.subject,
            }
            for c in changes
        ],
        "text": "\n".join(format_field_change(c) for c in changes),
    }


MCP_AT = {
    "type": "string",
    "description": (
        "Commit SHA to read. Omit to read the head of main; pass the 'commit' "
        "from an earlier response to keep several reads on one commit."
    ),
}
MCP_TASK_ID = {"type": "string", "description": "Task ID, TASK-XXXXX."}
MCP_PROJECT = {"type": "string", "description": "Project name."}


@dataclass(slots=True, frozen=True)
class McpTool:
    name: str
    description: str
    properties: dict[str, Any]
    required: tuple[str, ...]
    handler: Callable[[McpRead, dict[str, Any]], dict[str, Any]]

    def listing(self) -> dict[str, Any]:
        schema: dict[str, Any] = {
            "type": "object",
            "properties": {**self.properties, "at": MCP_AT},
        }
        if self.required:
            schema["required"] = list(self.required)
        return {
            "name": self.name,
            "description": self.description,
            "inputSchema": schema,
            "annotations": {"readOnlyHint": True, "openWorldHint": False},
        }


MCP_TOOLS = [
    McpTool(
        "list_projects",
        "List the projects in the taskgo control repository, with task counts "
        "and in-progress and blocked task IDs (as 'taskgo status --json').",
        {},
        (),
        mcp_list_projects,
    ),
    McpTool(
        "list_tasks",
        "List tasks, optionally for one project and one state (as 'taskgo list "
        "--json'). State 'ready' means todo with no unresolved blocked_by or "
        "wait_for, soonest due date first.",
        {
            "project": MCP_PROJECT,
            "state": {
                "type": "string",
                "description": "todo, in-progress, blocked, done, cancelled, or ready.",
            },
        },
        (),
        mcp_list_tasks,
    ),
    McpTool(
        "get_task",
        "Read one task record by ID: frontmatter, sections with hashes, "
        "unresolved dependencies, and the full Markdown.",
        {"id": MCP_TASK_ID},
        ("id",),
        mcp_get_task,
    ),
    McpTool(
        "get_project_status",
        "Read a project's STATUS.md: Summary and Next with hashes, the committed "
        "task snapshot block, and a freshly computed block for today (they "
        "differ when dates have moved since the last sync).",
        {"project": MCP_PROJECT},
        ("project",),
        mcp_get_project_status,
    ),
    McpTool(
        "read_file",
        "Read any UTF-8 text file in the control repository by its "
        f"repository-relative path, up to {MCP_MAX_FILE_BYTES // 1024} KiB.",
        {
            "path": {
                "type": "string",
                "description": "Path such as 'taskgo/PLAN.md'.",
            }
        },
        ("path",),
        mcp_read_file,
    ),
    McpTool(
        "list_files",
        "List the files in the control repository, or under one directory, "
        "with their blob SHAs.",
        {
            "prefix": {
                "type": "string",
                "description": "Directory or file path; omit for all files.",
            }
        },
        (),
        mcp_list_files,
    ),
    McpTool(
        "dispatch_task",
        "Produce the dispatch note for an unfinished task (as 'taskgo "
        "dispatch'), with readiness and audit findings and the data-care rule.",
        {"id": MCP_TASK_ID},
        ("id",),
        mcp_dispatch_task,
    ),
    McpTool(
        "get_task_history",
        "Show how one frontmatter field of a task (default 'status') changed "
        "across commits, following renames (as 'taskgo history').",
        {
            "id": MCP_TASK_ID,
            "field": {
                "type": "string",
                "description": "Frontmatter field; default 'status'.",
            },
        },
        ("id",),
        mcp_get_task_history,
    ),
]
MCP_TOOLS_BY_NAME = {t.name: t for t in MCP_TOOLS}


class McpAuthError(Exception):
    pass


class AccessVerifier:
    """Checks Cloudflare Access JWTs (Cf-Access-Jwt-Assertion): RS256
    signature against the team's certificates, issuer, audience, and expiry."""

    def __init__(self, team: str, audience: str, certs_url: str | None = None):
        import jwt  # Only the server needs it.

        self.jwt = jwt
        self.team, self.audience = team, audience
        self.jwks = jwt.PyJWKClient(
            certs_url or f"https://{team}/cdn-cgi/access/certs",
            cache_keys=True,
            lifespan=MCP_CERTS_TTL,
            # Cloudflare refuses urllib's default user agent.
            headers={"User-Agent": f"taskgo-mcp/{MCP_SERVER_VERSION}"},
            timeout=10,
        )

    def verify(self, token: str) -> dict[str, Any]:
        jwt = self.jwt
        try:
            key = self.jwks.get_signing_key_from_jwt(token)
            return jwt.decode(
                token,
                key.key,
                algorithms=["RS256"],
                audience=self.audience,
                issuer=f"https://{self.team}",
                leeway=60,
                options={"require": ["exp", "iss", "aud"]},
            )
        except jwt.ExpiredSignatureError:
            raise McpAuthError("Access token expired") from None
        except jwt.InvalidAudienceError:
            raise McpAuthError("Access token for another application") from None
        except jwt.InvalidIssuerError:
            raise McpAuthError("Access token from another team") from None
        except jwt.PyJWKClientError as e:
            raise McpAuthError(f"Access token key not usable: {e}") from None
        except jwt.PyJWTError as e:
            raise McpAuthError(f"Access token refused: {e}") from None


def mcp_rpc_result(msg_id: Any, result: Any) -> dict[str, Any]:
    return {"jsonrpc": "2.0", "id": msg_id, "result": result}


def mcp_rpc_error(msg_id: Any, code: int, message: str) -> dict[str, Any]:
    return {"jsonrpc": "2.0", "id": msg_id, "error": {"code": code, "message": message}}


def mcp_tool_error(message: str) -> dict[str, Any]:
    return {"content": [{"type": "text", "text": message}], "isError": True}


class McpServer:
    """The JSON-RPC methods, shared by the HTTP and stdio transports.

    Calls are serialized: they share the Git repository and snapshot cache,
    and the core is not written for concurrent use.
    """

    def __init__(self, cfg: McpConfig):
        import threading

        self.reader = McpReader(cfg)
        self.lock = threading.Lock()

    def handle(self, msg: Any) -> dict[str, Any] | None:
        """The response to MSG, or None for a notification or response."""
        if not isinstance(msg, dict) or msg.get("jsonrpc") != "2.0":
            return mcp_rpc_error(None, -32600, "invalid request")
        if "method" not in msg or "id" not in msg:
            return None
        msg_id, method = msg["id"], msg["method"]
        params = msg.get("params") or {}
        if method == "initialize":
            requested = params.get("protocolVersion")
            version = (
                requested
                if requested in MCP_PROTOCOL_VERSIONS
                else MCP_PROTOCOL_VERSIONS[0]
            )
            return mcp_rpc_result(
                msg_id,
                {
                    "protocolVersion": version,
                    "capabilities": {"tools": {"listChanged": False}},
                    "serverInfo": {"name": "taskgo", "version": MCP_SERVER_VERSION},
                    "instructions": MCP_INSTRUCTIONS,
                },
            )
        if method == "ping":
            return mcp_rpc_result(msg_id, {})
        if method == "tools/list":
            return mcp_rpc_result(msg_id, {"tools": [t.listing() for t in MCP_TOOLS]})
        if method == "tools/call":
            return mcp_rpc_result(msg_id, self.call_tool(params))
        return mcp_rpc_error(msg_id, -32601, f"method not found: {method}")

    def call_tool(self, params: dict[str, Any]) -> dict[str, Any]:
        tool = MCP_TOOLS_BY_NAME.get(params.get("name"))
        if tool is None:
            return mcp_tool_error(f"unknown tool: {params.get('name')}")
        args = params.get("arguments") or {}
        if not isinstance(args, dict):
            return mcp_tool_error("arguments must be an object")
        started = time.monotonic()
        with self.lock:
            try:
                sha = self.reader.resolve(args.get("at"))
                snap, committed = self.reader.snapshot(sha)
                result = tool.handler(McpRead(self.reader, snap, committed), args)
            except McpToolError as e:
                return mcp_tool_error(str(e))
            except SystemExit:
                # The core died with its message on stderr.
                return mcp_tool_error("the taskgo core refused the request")
            except Exception:
                import traceback

                traceback.print_exc()
                return mcp_tool_error("internal error; see the server log")
        ms = int((time.monotonic() - started) * 1000)
        print(f"taskgo mcp: {tool.name} {sha[:12]} {ms} ms", file=sys.stderr)
        return {
            "content": [{"type": "text", "text": json.dumps(result, indent=1)}],
            "structuredContent": result,
            "isError": False,
        }


def mcp_serve_stdio(server: McpServer) -> None:
    """Newline-delimited JSON-RPC on stdin and stdout, for one local client."""
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            reply: dict[str, Any] | None = mcp_rpc_error(None, -32700, "parse error")
        else:
            reply = server.handle(msg)
        if reply is not None:
            sys.stdout.write(json.dumps(reply) + "\n")
            sys.stdout.flush()


def mcp_is_loopback(host: str | None) -> bool:
    if not host:
        return False
    host = host.strip().lower()
    if host.startswith("["):  # [::1]:8080
        host = host[1 : host.find("]")]
    elif host.count(":") == 1:  # localhost:8080
        host = host.split(":", 1)[0]
    return host in MCP_LOOPBACK


def mcp_serve_http(
    server: McpServer, cfg: McpConfig, host: str, port: int, path: str
) -> None:
    import http.server
    from urllib.parse import urlsplit

    verifier = (
        AccessVerifier(cfg.team or "", cfg.audience or "", cfg.certs_url)
        if cfg.auth == "access"
        else None
    )

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = f"taskgo-mcp/{MCP_SERVER_VERSION}"
        protocol_version = "HTTP/1.1"

        def reply(self, status: int, body: Any = None, allow: str | None = None):
            data = b""
            ctype = "text/plain; charset=utf-8"
            if isinstance(body, (dict, list)):
                data = json.dumps(body).encode()
                ctype = "application/json"
            elif body is not None:
                data = str(body).encode()
            self.send_response(status)
            if data:
                self.send_header("Content-Type", ctype)
            if allow:
                self.send_header("Allow", allow)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def refused(self) -> bool:
            """Replies and returns True when the request may not proceed."""
            if urlsplit(self.path).path != path:
                self.reply(404, "not found")
                return True
            if verifier is None:
                # Unauthenticated mode serves only requests addressed to a
                # loopback name, from a page on one if from a browser at all.
                origin = self.headers.get("Origin")
                if not mcp_is_loopback(self.headers.get("Host")) or (
                    origin and not mcp_is_loopback(urlsplit(origin).netloc)
                ):
                    self.reply(403, "forbidden")
                    return True
                return False
            token = self.headers.get("Cf-Access-Jwt-Assertion")
            if not token:
                self.reply(401, "Cloudflare Access token required")
                return True
            try:
                verifier.verify(token)
            except McpAuthError as e:
                self.reply(403, str(e))
                return True
            return False

        def do_POST(self):
            if self.refused():
                return
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                length = -1
            if length < 0 or length > MCP_MAX_REQUEST_BYTES:
                self.reply(413, "request too large")
                return
            try:
                msg = json.loads(self.rfile.read(length))
            except ValueError:
                self.reply(400, mcp_rpc_error(None, -32700, "parse error"))
                return
            reply = server.handle(msg)
            if reply is None:
                self.reply(202)
            elif "error" in reply and reply["error"]["code"] == -32600:
                self.reply(400, reply)
            else:
                self.reply(200, reply)

        def do_GET(self):
            if urlsplit(self.path).path == MCP_HEALTH_PATH:
                self.reply(200, "ok")
                return
            # No server-initiated stream, and no sessions to delete.
            if not self.refused():
                self.reply(405, "method not allowed", allow="POST")

        def do_DELETE(self):
            if not self.refused():
                self.reply(405, "method not allowed", allow="POST")

        def log_message(self, format, *args):
            pass

    httpd = http.server.ThreadingHTTPServer((host, port), Handler)
    print(
        f"taskgo mcp: serving {display_path(cfg.repo)} on http://{host}:{port}{path} "
        f"(auth {cfg.auth})",
        file=sys.stderr,
    )
    try:
        httpd.serve_forever()
    finally:
        httpd.server_close()


def cmd_mcp(
    host: str = "127.0.0.1",
    port: int = 8789,
    path: str = "/mcp",
    remote: str = "origin",
    branch: str = "main",
    no_fetch: bool = False,
    auth: str = "access",
    team: str | None = None,
    audience: str | None = None,
    stdio: bool = False,
) -> None:
    """Serve the control repository's committed state over MCP, read-only."""
    root = get_repo_root()
    team = team or os.environ.get("TASKGO_MCP_ACCESS_TEAM")
    audience = audience or os.environ.get("TASKGO_MCP_ACCESS_AUD")
    if stdio:
        auth = "none"
    if auth == "access" and not (team and audience):
        die_scoped(
            "Access needs --access-team and --access-aud (or TASKGO_MCP_ACCESS_TEAM "
            "and TASKGO_MCP_ACCESS_AUD); --auth none serves loopback only"
        )
    if auth == "none" and not stdio and not mcp_is_loopback(host):
        die_scoped(f"--auth none serves loopback only, not {host}")
    if not no_fetch and run_git(["remote", "get-url", remote], check=False).returncode:
        die_scoped(
            f"no remote '{remote}' to fetch from; pass --no-fetch to read {branch}"
        )
    cfg = McpConfig(
        repo=root,
        remote=None if no_fetch else remote,
        branch=branch,
        auth="access" if auth == "access" else "none",
        team=team,
        audience=audience,
        certs_url=os.environ.get("TASKGO_MCP_ACCESS_CERTS_URL") or None,
    )
    server = McpServer(cfg)
    if stdio:
        mcp_serve_stdio(server)
    else:
        mcp_serve_http(server, cfg, host, port, path)


class HouseStyleHelpFormatter(argparse.RawDescriptionHelpFormatter):
    """Capitalizes argparse's fixed help headings to match the CLI house style."""

    def format_help(self) -> str:
        rendered = super().format_help()
        return (
            rendered.replace("usage:", "Usage:", 1)
            .replace("positional arguments:", "Arguments:", 1)
            .replace("options:", "Options:", 1)
        )


def help_text() -> str:
    """Renders top-level help, including the resolved control repository root."""
    root_dir, source = resolve_root_candidate()
    return f"""Usage: taskgo COMMAND [OPTIONS]

Maintain a private Git-backed personal project/task control repo.

Commands:
  id                               Allocate a unique task ID
  root                             Print the active control repository root
  create PROJECT TITLE [OPTIONS]   Create a new task (--slug, --problem, etc.)
  update TASK_ID [OPTIONS]         Update task fields, status, or headings
  list [PROJECT] [OPTIONS]         List tasks (--state ready for the frontier)
  info PROJECT [--json]            Show project metadata from README.md frontmatter
  status [PROJECT] [--json]        Show project status
  dispatch TASK_ID                 Print agent instructions for a selected task
  sync [PROJECT]                   Update STATUS.md snapshot
  check [PROJECT] [--json]         Sweep wait_for gates and date horizons
  doctor [PROJECT]                 Run mechanical checks (read-only)
  fix [PROJECT] [OPTIONS]          Auto-heal IDs, statuses, and snapshots
  history PATH_OR_TASK_ID [FIELD]  Show frontmatter history
  checkpoint TASK_ID SUBJECT [...] Commit an authorized tracker checkpoint (--all)
  commit SUBJECT [OPTIONS]         Commit a logical transition
  schema [--json]                  Show the task, decision, and STATUS schema
  mcp [OPTIONS]                    Serve committed state to MCP clients (read-only)

Options:
  -R, --root DIR  Operate on the control repository at DIR instead of the
                  default (~/.projects); overrides TASKGO_ROOT. Must appear
                  before COMMAND.
  --help, -h      Display this help message and exit

Environment:
  Root: {display_path(root_dir)}
  Source: {source}

Examples:
  taskgo id
  taskgo create my-project "Diagnose intermittent disconnects" --slug disconnects
  taskgo create my-project "Add cache layer" --slug cache-layer --problem "High latency"
  taskgo update TASK-3A91F --status in-progress --sketch "Use in-memory dict"
  taskgo dispatch TASK-3A91F
  taskgo sync my-project
  taskgo fix my-project
  taskgo checkpoint TASK-3A91F "project: start diagnosis" --all"""


def add_set_field_options(parser: argparse.ArgumentParser, removable: bool) -> None:
    """Adds --add-FIELD (and --remove-FIELD) options for the task set fields."""
    for spec in TASK_SCHEMA.set_fields():
        if spec.option is None:
            continue
        vt = VALUE_TYPES[spec.value]
        parser.add_argument(
            f"--add-{spec.option}",
            dest=f"add_{spec.name}",
            action="append",
            default=None,
            metavar=vt.metavar,
            help=f"Add to {spec.name} (repeatable; repeats are no-ops)",
        )
        if removable:
            parser.add_argument(
                f"--remove-{spec.option}",
                dest=f"remove_{spec.name}",
                action="append",
                default=None,
                metavar=vt.metavar,
                help=f"Remove from {spec.name} (repeatable; absent values are no-ops)",
            )


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="taskgo",
        description="Maintain a private Git-backed personal project/task control repo.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        add_help=False,
    )
    parser.add_argument(
        "--help",
        "-h",
        action="store_true",
        help="Display this help message and exit",
    )
    parser.add_argument(
        "--root",
        "-R",
        metavar="DIR",
        default=None,
        help=(
            "Control repository to operate on (default: ~/.projects, "
            "overridden by TASKGO_ROOT); must appear before COMMAND"
        ),
    )

    subparsers = parser.add_subparsers(dest="command", metavar="COMMAND")

    # id
    subparsers.add_parser(
        "id",
        help="Allocate a unique task ID",
        description="Allocate a unique task ID.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # root
    subparsers.add_parser(
        "root",
        help="Print the active control repository root",
        description=(
            "Print the resolved control repository root (the directory all "
            "commands operate on), after validation."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # create
    p_create = subparsers.add_parser(
        "create",
        help="Create a new task in PROJECT",
        description="Create a new task in PROJECT.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  taskgo create my-project "Diagnose intermittent disconnects" --slug disconnects
  taskgo create my-project "Add a read-through cache layer in front of the resolver" \\
    --slug cache-layer --problem "High latency" --goal "Sub-10ms"
  taskgo create --status in-progress my-project "Initial implementation" --slug initial-impl

TITLE is prose for humans (it becomes the H1 and appears in STATUS.md); SLUG is
the filename mnemonic. A slug derived from a long TITLE keeps the leading words,
which are rarely the distinguishing ones, so pass --slug whenever TITLE is longer
than a few words.""",
    )
    p_create.add_argument("project_name", metavar="PROJECT", help="Project identifier")
    p_create.add_argument("title", metavar="TITLE", help="Task title")
    p_create.add_argument(
        "--slug",
        default=None,
        metavar="SLUG",
        help=f"Filename mnemonic, max {SLUG_MAX_LEN} chars (default: derived from TITLE)",
    )
    p_create.add_argument(
        "--status",
        "-s",
        default="todo",
        help="Initial task state (default: todo)",
    )
    p_create.add_argument("--problem", "-p", default=None, help="Problem description")
    p_create.add_argument(
        "--cost", default=None, help="Consequences of leaving the task undone"
    )
    p_create.add_argument("--goal", "-g", default=None, help="Goal description")
    p_create.add_argument(
        "--criteria", "-c", default=None, help="Observable end condition"
    )
    p_create.add_argument("--sketch", default=None, help="Implementation sketch")
    p_create.add_argument("--constraints", default=None, help="Constraints")
    p_create.add_argument("--outcome", default=None, help="Outcome description")
    p_create.add_argument("--findings", default=None, help="Findings")
    p_create.add_argument("--next", dest="next_steps", default=None, help="Next steps")
    p_create.add_argument(
        "--conv",
        "-C",
        "--conversation",
        dest="conv",
        default=None,
        help="Active conversation or session ID",
    )
    p_create.add_argument(
        "--wait-for",
        dest="wait_for",
        action="append",
        default=None,
        metavar="GATE",
        help="External or temporal gate (YYYY-MM-DD, b/..., cl/..., gh:..., @handle)",
    )
    p_create.add_argument(
        "--due",
        default=None,
        metavar="YYYY-MM-DD",
        help="Committed completion deadline (YYYY-MM-DD)",
    )
    p_create.add_argument(
        "--stale-after",
        dest="stale_after",
        default=None,
        metavar="YYYY-MM-DD",
        help="Relevance cutoff date (YYYY-MM-DD)",
    )
    add_set_field_options(p_create, removable=False)
    p_create.add_argument(
        "--no-commit", action="store_true", help="Do not commit created task"
    )
    p_create.add_argument(
        "--dry-run",
        action="store_true",
        help="Preview allocation without modifying files",
    )

    # update
    p_update = subparsers.add_parser(
        "update",
        help="Update task fields, status, or headings",
        description="Update task fields, status, or headings.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  taskgo update TASK-3A91F --status in-progress
  taskgo update TASK-3A91F --expect-status todo --status in-progress
  taskgo update TASK-3A91F --add-blocked-by TASK-1627D --remove-wait-for 2026-10-13
  taskgo update TASK-3A91F --sketch "Use in-memory dict" --findings "Latency reduced by 40%" """,
    )
    p_update.add_argument("query", metavar="TASK_ID", help="Task ID or relative path")
    p_update.add_argument("--status", "-s", default=None, help="New task state")
    p_update.add_argument(
        "--expect-status",
        default=None,
        metavar="STATE",
        help="Refuse the update unless the current state is STATE",
    )
    p_update.add_argument("--title", "-t", default=None, help="New task title")
    p_update.add_argument(
        "--slug",
        default=None,
        metavar="SLUG",
        help=f"Rename the task file's slug, max {SLUG_MAX_LEN} chars",
    )
    p_update.add_argument("--problem", "-p", default=None, help="Problem description")
    p_update.add_argument(
        "--cost", default=None, help="Consequences of leaving the task undone"
    )
    p_update.add_argument("--goal", "-g", default=None, help="Goal description")
    p_update.add_argument(
        "--criteria", "-c", default=None, help="Observable end condition"
    )
    p_update.add_argument("--sketch", default=None, help="Implementation sketch")
    p_update.add_argument("--constraints", default=None, help="Constraints")
    p_update.add_argument("--outcome", default=None, help="Outcome description")
    p_update.add_argument("--findings", default=None, help="Findings")
    p_update.add_argument("--next", dest="next_steps", default=None, help="Next steps")
    p_update.add_argument(
        "--conv",
        "-C",
        "--conversation",
        dest="conv",
        default=None,
        help="Active conversation or session ID",
    )
    p_update.add_argument(
        "--wait-for",
        dest="wait_for",
        action="append",
        default=None,
        metavar="GATE",
        help="External or temporal gate (YYYY-MM-DD, b/..., cl/..., gh:..., @handle)",
    )
    p_update.add_argument(
        "--due",
        default=None,
        metavar="YYYY-MM-DD",
        help="Committed completion deadline (YYYY-MM-DD)",
    )
    p_update.add_argument(
        "--stale-after",
        dest="stale_after",
        default=None,
        metavar="YYYY-MM-DD",
        help="Relevance cutoff date (YYYY-MM-DD)",
    )

    add_set_field_options(p_update, removable=True)

    # schema
    p_schema = subparsers.add_parser(
        "schema",
        help="Show the task, decision, and STATUS schema",
        description=(
            "Show the record schema: the fields and sections of tasks, decisions,\n"
            "and STATUS.md. Validation, doctor, and the create/update set options\n"
            "read it; --json is the conformance form for other implementations."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_schema.add_argument("--json", action="store_true", help="Output as JSON")

    # list
    p_list = subparsers.add_parser(
        "list",
        help="List tasks in the repository or a specific project",
        description="List tasks in the repository or a specific project.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_list.add_argument(
        "project",
        nargs="?",
        default=None,
        metavar="PROJECT",
        help="Optional project name filter",
    )
    p_list.add_argument(
        "--state",
        "--status",
        "-s",
        dest="state",
        default=None,
        help="Filter tasks by state (e.g. in-progress, done, or ready)",
    )
    p_list.add_argument(
        "--json",
        "-j",
        dest="as_json",
        action="store_true",
        help="Output machine-readable JSON",
    )

    # info
    p_info = subparsers.add_parser(
        "info",
        help="Show project metadata from README.md YAML frontmatter",
        description="Show project metadata from README.md YAML frontmatter.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_info.add_argument(
        "project",
        metavar="PROJECT",
        help="Target project name",
    )
    p_info.add_argument(
        "--json",
        "-j",
        dest="as_json",
        action="store_true",
        help="Output machine-readable JSON",
    )

    # status
    p_status = subparsers.add_parser(
        "status",
        help="Show project status or whole-workspace summary",
        description="Show project status or whole-workspace summary.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_status.add_argument(
        "project",
        nargs="?",
        default=None,
        metavar="PROJECT",
        help="Optional target project",
    )
    p_status.add_argument(
        "--json",
        "-j",
        dest="as_json",
        action="store_true",
        help="Output machine-readable JSON",
    )

    # dispatch
    p_dispatch = subparsers.add_parser(
        "dispatch",
        help="Print agent instructions for a selected task",
        description="Print instructions dispatching an agent to a selected task.",
        formatter_class=HouseStyleHelpFormatter,
        add_help=False,
        epilog="""Examples:
  taskgo dispatch TASK-3A91F
  taskgo --root ~/projects dispatch TASK-3A91F

The note is generated from the task record committed at HEAD. Findings about
working-tree or tracker readiness are written to stderr.""",
    )
    p_dispatch.add_argument(
        "--help",
        "-h",
        action="help",
        help="Display this help message and exit",
    )
    p_dispatch.add_argument(
        "task_id",
        metavar="TASK_ID",
        help="Task to assign to the agent",
    )

    # sync
    p_sync = subparsers.add_parser(
        "sync",
        help="Update STATUS.md snapshot for a project or the workspace",
        description="Update STATUS.md snapshot for a project or the workspace.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_sync.add_argument(
        "project",
        nargs="?",
        default=None,
        metavar="PROJECT",
        help="Optional target project",
    )

    # check
    p_check = subparsers.add_parser(
        "check",
        help="Evaluate wait_for gates, due deadlines, and stale_after cutoffs",
        description="Evaluate wait_for gates, due deadlines, and stale_after cutoffs.",
        formatter_class=HouseStyleHelpFormatter,
        add_help=False,
        epilog="""Examples:
  taskgo check
  taskgo check my-project --json

Scans open tasks declaring wait_for, due, or stale_after against today and each
task file's Git commit watermark, emitting nothing when no tasks trigger.""",
    )
    p_check.add_argument(
        "--help",
        "-h",
        action="help",
        help="Display this help message and exit",
    )
    p_check.add_argument(
        "project",
        nargs="?",
        default=None,
        metavar="PROJECT",
        help="Optional target project",
    )
    p_check.add_argument(
        "--json",
        "-j",
        dest="as_json",
        action="store_true",
        help="Output machine-readable JSON",
    )

    # doctor
    p_doctor = subparsers.add_parser(
        "doctor",
        help="Run mechanical health checks across the workspace or a project",
        description="Run mechanical health checks across the workspace or a project.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_doctor.add_argument(
        "project",
        nargs="?",
        default=None,
        metavar="PROJECT",
        help="Optional target project",
    )

    # fix
    p_fix = subparsers.add_parser(
        "fix",
        help="Auto-heal IDs, statuses, and snapshot drift",
        description="Auto-heal IDs, statuses, and snapshot drift.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_fix.add_argument(
        "project",
        nargs="?",
        default=None,
        metavar="PROJECT",
        help="Optional target project",
    )
    p_fix.add_argument(
        "--dry-run",
        action="store_true",
        help="Preview repairs without modifying files",
    )
    p_fix.add_argument(
        "--no-commit",
        action="store_true",
        help="Apply repairs on disk without committing",
    )

    # mcp
    p_mcp = subparsers.add_parser(
        "mcp",
        help="Serve the control repository's committed state over MCP",
        description=textwrap.dedent(
            """\
            Serve the control repository's committed state to MCP clients,
            read-only, over Streamable HTTP (stateless, one JSON response per
            message) or, with --stdio, to one local client.

            Each tool call fetches BRANCH from REMOTE, resolves it once, and
            reads only that commit; it never touches the working tree.
            Cloudflare Access, with Managed OAuth, is meant to sit in front
            of the server, and the server checks the Access JWT of every
            request (issuer, audience, signature, expiry). --auth none skips
            the check and serves only requests addressed to a loopback name.

            Environment:
              TASKGO_MCP_ACCESS_TEAM  Default for --access-team
              TASKGO_MCP_ACCESS_AUD   Default for --access-aud"""
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_mcp.add_argument(
        "--host", default="127.0.0.1", help="Address to listen on (default 127.0.0.1)"
    )
    p_mcp.add_argument(
        "--port", type=int, default=8789, help="Port to listen on (default 8789)"
    )
    p_mcp.add_argument("--path", default="/mcp", help="Endpoint path (default /mcp)")
    p_mcp.add_argument(
        "--remote", default="origin", help="Remote to fetch from (default origin)"
    )
    p_mcp.add_argument(
        "--branch", default="main", help="Branch to serve (default main)"
    )
    p_mcp.add_argument(
        "--no-fetch",
        action="store_true",
        help="Serve the local BRANCH without fetching",
    )
    p_mcp.add_argument(
        "--auth",
        choices=["access", "none"],
        default="access",
        help="Check Cloudflare Access JWTs (default) or nothing (loopback only)",
    )
    p_mcp.add_argument(
        "--access-team",
        metavar="DOMAIN",
        default=None,
        help="Access team domain, such as example.cloudflareaccess.com",
    )
    p_mcp.add_argument(
        "--access-aud",
        metavar="TAG",
        default=None,
        help="Access application audience (AUD) tag",
    )
    p_mcp.add_argument(
        "--stdio",
        action="store_true",
        help="Serve one client on stdin and stdout instead (no authentication)",
    )

    # history
    p_history = subparsers.add_parser(
        "history",
        help="Show frontmatter field history across git revisions",
        description="Show frontmatter field history across git revisions.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_history.add_argument(
        "query", metavar="PATH_OR_TASK_ID", help="Task ID or relative path"
    )
    p_history.add_argument(
        "field",
        nargs="?",
        default="status",
        metavar="FIELD",
        help="Frontmatter field to track (default: status)",
    )

    # checkpoint
    p_checkpoint = subparsers.add_parser(
        "checkpoint",
        help="Commit an authorized tracker checkpoint for TASK_ID",
        description=(
            "Commit an authorized tracker checkpoint for TASK_ID. Nonconforming"
            " subjects are rewritten as 'chore(<project>): <subject>'"
            " (truncated to 50 characters)."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  taskgo checkpoint TASK-3A91F "chore(proj): start diagnosis" --all
  taskgo checkpoint TASK-3A91F "docs(proj): update task" --path proj/tasks/TASK-3A91F-slug.md """,
    )
    p_checkpoint.add_argument("task_id", metavar="TASK_ID", help="Target task ID")
    p_checkpoint.add_argument(
        "subject",
        metavar="SUBJECT",
        help="Conventional Commits subject line (rewritten when nonconforming)",
    )
    p_checkpoint.add_argument(
        "--all",
        "-a",
        dest="all_files",
        action="store_true",
        help="Stage all modified/untracked project files",
    )
    p_checkpoint.add_argument(
        "--path",
        "-p",
        dest="paths",
        action="append",
        default=[],
        help="Explicit project files to stage",
    )
    p_checkpoint.add_argument(
        "--body",
        "-b",
        default="",
        help="Plain-text commit body (hard-wrapped to 72 columns)",
    )
    p_checkpoint.add_argument(
        "--ref",
        "-r",
        dest="refs",
        action="append",
        default=[],
        help="External references (e.g. artifact@sha)",
    )
    p_checkpoint.add_argument(
        "--conv",
        "-C",
        "--conversation",
        dest="conv",
        default=None,
        help="Active conversation or session ID",
    )

    # commit
    p_commit = subparsers.add_parser(
        "commit",
        help="Commit a logical transition with automatic project status synchronization",
        description="Commit a logical transition with automatic project status synchronization.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_commit.add_argument(
        "subject",
        metavar="SUBJECT",
        help="Conventional Commits subject line (rewritten when nonconforming)",
    )
    p_commit.add_argument(
        "--body",
        "-b",
        default="",
        help="Plain-text commit body (hard-wrapped to 72 columns)",
    )
    p_commit.add_argument(
        "--ref",
        "-r",
        dest="refs",
        action="append",
        default=[],
        help="External references (e.g. artifact@sha)",
    )
    p_commit.add_argument(
        "--conv",
        "-C",
        "--conversation",
        dest="conv",
        default=None,
        help="Active conversation or session ID",
    )

    return parser


def main(argv: list[str] | None = None) -> None:
    if argv is None:
        argv = sys.argv[1:]

    if not argv or (len(argv) == 1 and argv[0] in ("--help", "-h", "help")):
        print(help_text())
        sys.exit(0)

    parser = create_parser()
    args = parser.parse_args(argv)

    global _ACTIVE_COMMAND
    _ACTIVE_COMMAND = args.command
    set_explicit_root(getattr(args, "root", None))

    if args.command == "id":
        cmd_id()
    elif args.command == "root":
        cmd_root()
    elif args.command == "create":
        cmd_create(
            project_name=args.project_name,
            title=args.title,
            slug=args.slug,
            status=args.status,
            problem=args.problem,
            cost=args.cost,
            goal=args.goal,
            criteria=args.criteria,
            sketch=args.sketch,
            constraints=args.constraints,
            outcome=args.outcome,
            findings=args.findings,
            next_steps=args.next_steps,
            conv=getattr(args, "conv", None),
            wait_for=getattr(args, "wait_for", None),
            due=getattr(args, "due", None),
            stale_after=getattr(args, "stale_after", None),
            no_commit=args.no_commit,
            dry_run=args.dry_run,
            add_blocked_by=args.add_blocked_by,
            add_wait_for=args.add_wait_for,
            add_conversations=args.add_conversations,
        )
    elif args.command == "update":
        cmd_update(
            query=args.query,
            status=args.status,
            title=args.title,
            slug=args.slug,
            problem=args.problem,
            cost=args.cost,
            goal=args.goal,
            criteria=args.criteria,
            sketch=args.sketch,
            constraints=args.constraints,
            outcome=args.outcome,
            findings=args.findings,
            next_steps=args.next_steps,
            conv=getattr(args, "conv", None),
            wait_for=getattr(args, "wait_for", None),
            due=getattr(args, "due", None),
            stale_after=getattr(args, "stale_after", None),
            expect_status=args.expect_status,
            add_blocked_by=args.add_blocked_by,
            remove_blocked_by=args.remove_blocked_by,
            add_wait_for=args.add_wait_for,
            remove_wait_for=args.remove_wait_for,
            add_conversations=args.add_conversations,
            remove_conversations=args.remove_conversations,
        )
    elif args.command == "schema":
        cmd_schema(as_json=args.json)
    elif args.command == "list":
        cmd_list(
            project=args.project,
            state=args.state,
            as_json=args.as_json,
        )
    elif args.command == "info":
        cmd_info(
            project=args.project,
            as_json=args.as_json,
        )
    elif args.command == "status":
        cmd_status(
            project=args.project,
            as_json=args.as_json,
        )
    elif args.command == "dispatch":
        cmd_dispatch(task_id=args.task_id)
    elif args.command == "sync":
        cmd_sync(project=args.project)
    elif args.command == "check":
        cmd_check(project=args.project, as_json=args.as_json)
    elif args.command == "doctor":
        cmd_doctor(project=args.project)
    elif args.command == "fix":
        cmd_fix(
            project=args.project,
            dry_run=args.dry_run,
            no_commit=args.no_commit,
        )
    elif args.command == "mcp":
        cmd_mcp(
            host=args.host,
            port=args.port,
            path=args.path,
            remote=args.remote,
            branch=args.branch,
            no_fetch=args.no_fetch,
            auth=args.auth,
            team=args.access_team,
            audience=args.access_aud,
            stdio=args.stdio,
        )
    elif args.command == "history":
        cmd_history(
            query=args.query,
            field=args.field,
        )
    elif args.command == "checkpoint":
        cmd_checkpoint(
            task_id=args.task_id,
            subject=args.subject,
            all_files=args.all_files,
            paths=args.paths,
            body=args.body,
            refs=args.refs,
            conv=getattr(args, "conv", None),
        )
    elif args.command == "commit":
        cmd_commit(
            subject=args.subject,
            body=args.body,
            refs=args.refs,
            conv=getattr(args, "conv", None),
        )
    else:
        print(help_text())
        sys.exit(0)


if __name__ == "__main__":
    # Installed only when run as the CLI: the MCP server imports this file as
    # its core module.
    signal.signal(signal.SIGTERM, sigterm_handler)
    signal.signal(signal.SIGINT, sigint_handler)
    try:
        main()
    except KeyboardInterrupt:
        handle_signal_exit(signal.SIGINT)
    except BrokenPipeError:
        import os

        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(128 + signal.SIGPIPE)
