# Keep track of active child processes for clean teardown on signal
_active_subprocesses: set[subprocess.Popen] = set()
_received_sigterm: bool = False


def reap_subprocesses(signaled_by_parent: bool = True) -> None:
    """Gracefully tear down active subprocesses in compliance with POSIX standards."""
    for proc in list(_active_subprocesses):
        if proc.poll() is not None:
            _active_subprocesses.discard(proc)
            continue

        try:
            proc.terminate()
        except ProcessLookupError:
            pass

        try:
            proc.wait(timeout=1.5)
        except subprocess.TimeoutExpired:
            try:
                proc.kill()
            except ProcessLookupError:
                pass
            try:
                proc.wait(timeout=1.0)
            except (subprocess.TimeoutExpired, ProcessLookupError):
                pass

        _active_subprocesses.discard(proc)


def handle_signal_exit(signum: int) -> None:
    # Protect teardown logic from re-entrant signals
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

    reap_subprocesses(signaled_by_parent=(signum == signal.SIGTERM))
    try:
        sys.stderr.write("\n")
        sys.stderr.flush()
    except OSError:
        pass
    sys.exit(128 + signum)


def sigterm_handler(signum, frame):
    handle_signal_exit(signal.SIGTERM)


def sigint_handler(signum, frame):
    handle_signal_exit(signal.SIGINT)


def die(msg: str, exit_code: int = 1) -> NoReturn:
    print(f"taskgo: {msg}", file=sys.stderr)
    sys.exit(exit_code)


_ACTIVE_COMMAND: str | None = None


def die_scoped(msg: str, exit_code: int = 1) -> NoReturn:
    """Dies with a git-style subcommand-scoped message (taskgo list: ...)."""
    if _ACTIVE_COMMAND:
        print(f"taskgo {_ACTIVE_COMMAND}: {msg}", file=sys.stderr)
        sys.exit(exit_code)
    die(msg, exit_code)


_REPO_ROOT_CACHE: Path | None = None
_EXPLICIT_ROOT: Path | None = None
DEFAULT_ROOT = "~/.projects"


def set_explicit_root(value: str | None) -> None:
    """Records an explicitly selected control repository root (--root option)."""
    global _EXPLICIT_ROOT
    if value:
        _EXPLICIT_ROOT = Path(value).expanduser()


def resolve_root_candidate() -> tuple[Path, str]:
    """Returns the configured root path and its source for error messages."""
    if _EXPLICIT_ROOT is not None:
        return _EXPLICIT_ROOT, "--root"
    env_root = os.environ.get("TASKGO_ROOT")
    if env_root:
        return Path(env_root).expanduser(), "TASKGO_ROOT"
    return Path(DEFAULT_ROOT).expanduser(), "default"


def display_path(path: Path) -> str:
    """Renders a path with a ~ prefix when anchored under $HOME.

    Keeps help and doctor output identical across machines (and under the
    sandboxed HOME used by command-index-format), matching bin/skill's
    clean_p() convention.
    """
    home = str(Path.home())
    s = str(path)
    if s.startswith(home):
        return "~" + s[len(home) :]
    return s


def get_repo_root() -> Path:
    global _REPO_ROOT_CACHE
    if _REPO_ROOT_CACHE is not None:
        return _REPO_ROOT_CACHE

    root_dir, source = resolve_root_candidate()
    shown = DEFAULT_ROOT if source == "default" else f"'{root_dir}'"
    if not root_dir.is_dir():
        hint = ""
        if source == "default":
            hint = (
                " (initialize it with: mkdir -p ~/.projects && git -C ~/.projects init)"
            )
        die_scoped(f"control repository {shown} does not exist{hint}")
    if not (root_dir / ".git").exists():
        die_scoped(f"control repository {shown} is not a Git repository (missing .git)")
    _REPO_ROOT_CACHE = root_dir.resolve()
    return _REPO_ROOT_CACHE


def run_git(
    args: list[str],
    cwd: Path | None = None,
    check: bool = True,
    capture_output: bool = True,
    text: bool = True,
    input_data: str | bytes | None = None,
) -> subprocess.CompletedProcess:
    if cwd is None:
        cwd = get_repo_root()
    cmd = ["git", *args]
    proc = subprocess.Popen(
        cmd,
        cwd=cwd,
        stdin=subprocess.PIPE if input_data is not None else None,
        stdout=subprocess.PIPE if capture_output else None,
        stderr=subprocess.PIPE if capture_output else None,
        text=text,
    )
    _active_subprocesses.add(proc)
    try:
        stdout, stderr = proc.communicate(input=input_data)
    finally:
        _active_subprocesses.discard(proc)

    empty = "" if text else b""
    ret = subprocess.CompletedProcess(
        cmd, proc.returncode, stdout or empty, stderr or empty
    )
    if check and ret.returncode != 0:
        if ret.stderr:
            sys.stderr.write(
                ret.stderr if text else ret.stderr.decode("utf-8", "replace")
            )
        die(f"git {' '.join(args)} failed (exit {ret.returncode})")
    return ret


def atomic_write(path: Path, content: str) -> None:
    """Atomically writes content to path using a PID-tagged temp file and os.replace.

    Line endings are written verbatim, and an existing file keeps its
    permission bits (an executable script stays executable).
    """
    tmp = path.with_suffix(f".tmp.{os.getpid()}")
    with open(tmp, "w", encoding="utf-8", newline="") as f:
        f.write(content)
    try:
        os.chmod(tmp, path.stat().st_mode & 0o7777)
    except FileNotFoundError:
        pass
    os.replace(tmp, path)


def write_markdown(path: Path, content: str) -> None:
    """Formats Markdown content and writes it atomically.

    Every CLI writer goes through here so touched files are always formatted
    and untouched files are never rewritten.
    """
    atomic_write(path, format_markdown(content))


# ===========================================================================
# Snapshots: the core's only access to repository files
# ===========================================================================


class ReadOnlySnapshotError(Exception):
    """Raised when a write reaches a snapshot that cannot be written."""


def path_key(rel: str) -> list[str]:
    """Sort key ordering relative paths component by component, as Path does."""
    return rel.split("/")


def join_rel(*parts: str) -> str:
    """Joins relative path parts, skipping empty ones ('' is the root)."""
    return "/".join(p for p in parts if p)


class Snapshot:
    """Files of a control repository, addressed by relative POSIX path.

    Parsing, validation, rendering, audit, and edit operations read and write
    only through this interface, so the same code runs over a working tree
    (FsSnapshot) or a Git commit (GitTreeSnapshot). '' names the root.
    """

    def read_text(self, rel: str) -> str:
        """Returns the file's UTF-8 text; raises OSError when it is absent."""
        raise NotImplementedError

    def is_file(self, rel: str) -> bool:
        raise NotImplementedError

    def is_dir(self, rel: str) -> bool:
        raise NotImplementedError

    def list_dir(self, rel: str) -> list[str]:
        """Sorted entry names of directory REL; empty when it is not one."""
        raise NotImplementedError

    def write_text(self, rel: str, text: str) -> None:
        """Writes TEXT to REL, creating parent directories."""
        raise ReadOnlySnapshotError(f"cannot write {rel}: snapshot is read-only")

    def rename(self, src: str, dst: str) -> None:
        raise ReadOnlySnapshotError(f"cannot rename {src}: snapshot is read-only")

    def delete(self, rel: str) -> None:
        raise ReadOnlySnapshotError(f"cannot delete {rel}: snapshot is read-only")

    def exists(self, rel: str) -> bool:
        return self.is_file(rel) or self.is_dir(rel)

    def is_link(self, rel: str) -> bool:
        """True when REL or a directory above it is a symbolic link."""
        return False

    def is_executable(self, rel: str) -> bool:
        return False

    def historical_task_ids(self) -> set[str]:
        """Task IDs named in the history of any ref of the repository."""
        return set()

    def write_markdown(self, rel: str, content: str) -> None:
        """Formats Markdown content and writes it.

        Every writer goes through here so touched files are always formatted
        and untouched files are never rewritten.
        """
        self.write_text(rel, format_markdown(content))

    def glob_md(self, rel_dir: str) -> list[str]:
        """Relative paths of the *.md files directly in REL_DIR."""
        return [
            join_rel(rel_dir, name)
            for name in self.list_dir(rel_dir)
            if name.endswith(".md") and self.is_file(join_rel(rel_dir, name))
        ]

    def walk_md(self, rel_dir: str) -> list[str]:
        """Relative paths of every *.md file under REL_DIR, in path order."""
        out: list[str] = []
        for name in self.list_dir(rel_dir):
            rel = join_rel(rel_dir, name)
            if self.is_dir(rel):
                out.extend(self.walk_md(rel))
            elif name.endswith(".md") and self.is_file(rel):
                out.append(rel)
        return sorted(out, key=path_key)


class FsSnapshot(Snapshot):
    """A working tree on disk. Reads and writes go straight to the files."""

    def __init__(self, root: Path):
        self.root = root

    def path(self, rel: str) -> Path:
        return self.root / rel if rel else self.root

    def read_text(self, rel: str) -> str:
        # No newline translation: CRLF bytes survive, as in a Git blob.
        return self.path(rel).read_bytes().decode("utf-8")

    def is_file(self, rel: str) -> bool:
        return self.path(rel).is_file()

    def is_dir(self, rel: str) -> bool:
        return self.path(rel).is_dir()

    def list_dir(self, rel: str) -> list[str]:
        p = self.path(rel)
        return sorted(c.name for c in p.iterdir()) if p.is_dir() else []

    def write_text(self, rel: str, text: str) -> None:
        p = self.path(rel)
        p.parent.mkdir(parents=True, exist_ok=True)
        atomic_write(p, text)

    def rename(self, src: str, dst: str) -> None:
        self.path(src).rename(self.path(dst))

    def delete(self, rel: str) -> None:
        self.path(rel).unlink()

    def is_link(self, rel: str) -> bool:
        parts = rel.split("/") if rel else []
        return any(
            self.path("/".join(parts[: i + 1])).is_symlink() for i in range(len(parts))
        )

    def is_executable(self, rel: str) -> bool:
        p = self.path(rel)
        return p.is_file() and bool(p.stat().st_mode & 0o111)

    def historical_task_ids(self) -> set[str]:
        return task_ids_in_history(self.root)

    def walk_md(self, rel_dir: str) -> list[str]:
        # Only files Git would track: ignored paths (such as a nested external
        # checkout) are someone else's files.
        listed = run_git(
            [
                "ls-files",
                "-z",
                "--cached",
                "--others",
                "--exclude-standard",
                "--",
                rel_dir or ".",
            ],
            cwd=self.root,
            check=False,
        )
        if listed.returncode == 0:
            return sorted(
                {
                    rel
                    for rel in listed.stdout.split("\0")
                    if rel.endswith(".md") and self.is_file(rel)
                },
                key=path_key,
            )
        # Not a work tree. rglob does not descend into symlinked directories;
        # keep that.
        return sorted(
            (
                p.relative_to(self.root).as_posix()
                for p in self.path(rel_dir).rglob("*.md")
                if p.is_file()
            ),
            key=path_key,
        )


class WorktreeBlobs:
    """Git blob SHAs of working-tree files, computed on demand.

    Read like GitTreeSnapshot.blobs: a SHA names the bytes on disk, so it
    matches the committed blob exactly when the file is unchanged.
    """

    def __init__(self, root: Path):
        self.root = root

    def get(self, rel: str, default: str | None = None) -> str | None:
        path = self.root / rel
        if path.is_symlink() or not path.is_file():
            return default
        data = path.read_bytes()
        return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()

    def __getitem__(self, rel: str) -> str:
        sha = self.get(rel)
        if sha is None:
            raise KeyError(rel)
        return sha


class WorktreeSnapshot(FsSnapshot):
    """A working tree read as handoff and status read it: the files on disk,
    with REV, the commit HEAD names (None before the first commit), and the
    blob SHA of each file."""

    def __init__(self, root: Path, rev: str | None):
        super().__init__(root)
        self.rev = rev
        self.blobs = WorktreeBlobs(root)


class GitTreeSnapshot(Snapshot):
    """The tree of one Git commit, read without a checkout. Read-only.

    Lists the tree once and reads Markdown blobs in a single batch on first
    use, so a whole-repository render costs two Git processes.
    """

    def __init__(self, repo: Path, rev: str):
        self.repo = repo
        resolved = run_git(["rev-parse", "--verify", f"{rev}^{{commit}}"], cwd=repo)
        self.rev = resolved.stdout.strip()
        self.blobs: dict[str, str] = {}
        self.modes: dict[str, str] = {}
        self.links: set[str] = set()
        self.children: dict[str, set[str]] = {"": set()}
        out = run_git(["ls-tree", "-r", "-z", "--full-tree", self.rev], cwd=repo)
        for entry in filter(None, out.stdout.split("\0")):
            meta, rel = entry.split("\t", 1)
            mode, kind, sha = meta.split()
            if mode == "120000":
                self.links.add(rel)
            if kind != "blob" or mode not in ("100644", "100755"):
                continue
            self.blobs[rel] = sha
            self.modes[rel] = mode
            parts = rel.split("/")
            for i in range(len(parts)):
                parent = "/".join(parts[:i])
                self.children.setdefault(parent, set()).add(parts[i])
        self.texts: dict[str, str] | None = None

    def historical_task_ids(self) -> set[str]:
        return task_ids_in_history(self.repo)

    def is_link(self, rel: str) -> bool:
        parts = rel.split("/")
        return any("/".join(parts[: i + 1]) in self.links for i in range(len(parts)))

    def is_executable(self, rel: str) -> bool:
        return self.modes.get(rel) == "100755"

    def _load(self) -> dict[str, str]:
        if self.texts is None:
            md = [rel for rel in self.blobs if rel.endswith(".md")]
            self.texts = self._cat(md)
        return self.texts

    def _cat(self, rels: list[str]) -> dict[str, str]:
        if not rels:
            return {}
        shas = "".join(f"{self.blobs[rel]}\n" for rel in rels)
        raw = run_git(
            ["cat-file", "--batch"],
            cwd=self.repo,
            text=False,
            input_data=shas.encode(),
        ).stdout
        texts: dict[str, str] = {}
        pos = 0
        for rel in rels:
            nl = raw.index(b"\n", pos)
            size = int(raw[pos:nl].split()[2])
            texts[rel] = raw[nl + 1 : nl + 1 + size].decode("utf-8")
            pos = nl + 1 + size + 1
        return texts

    def read_text(self, rel: str) -> str:
        if rel not in self.blobs:
            raise FileNotFoundError(f"{rel} is not in {self.rev[:12]}")
        texts = self._load()
        if rel not in texts:
            texts.update(self._cat([rel]))
        return texts[rel]

    def is_file(self, rel: str) -> bool:
        return rel in self.blobs

    def is_dir(self, rel: str) -> bool:
        return rel in self.children

    def list_dir(self, rel: str) -> list[str]:
        return sorted(self.children.get(rel, ()))


# What handoff reads: a commit, or the working tree beside the commit HEAD names.
TreeSnapshot = GitTreeSnapshot | WorktreeSnapshot


class OverlaySnapshot(Snapshot):
    """Pending writes over a base snapshot, held in memory.

    A change set is applied here and reaches the base only once all of it has
    applied and validated, so a refused change set writes nothing.
    """

    def __init__(self, base: Snapshot):
        self.base = base
        self.changes: dict[str, str | None] = {}  # None: deleted
        # Executable bits a change set sets or clears, by path.
        self.modes: dict[str, bool] = {}
        self.history: set[str] | None = None

    def read_text(self, rel: str) -> str:
        if rel in self.changes:
            text = self.changes[rel]
            if text is None:
                raise FileNotFoundError(f"{rel} is deleted")
            return text
        return self.base.read_text(rel)

    def is_file(self, rel: str) -> bool:
        if rel in self.changes:
            return self.changes[rel] is not None
        return self.base.is_file(rel)

    def is_dir(self, rel: str) -> bool:
        prefix = f"{rel}/" if rel else ""
        return self.base.is_dir(rel) or any(
            k.startswith(prefix) for k, v in self.changes.items() if v is not None
        )

    def list_dir(self, rel: str) -> list[str]:
        prefix = f"{rel}/" if rel else ""
        names = set(self.base.list_dir(rel))
        for k, v in self.changes.items():
            if not k.startswith(prefix):
                continue
            rest = k[len(prefix) :]
            if v is not None:
                names.add(rest.split("/", 1)[0])
            elif "/" not in rest:
                names.discard(rest)
        return sorted(names)

    def write_text(self, rel: str, text: str) -> None:
        self.changes[rel] = text

    def delete(self, rel: str) -> None:
        self.changes[rel] = None
        self.modes[rel] = False

    def is_link(self, rel: str) -> bool:
        return self.base.is_link(rel)

    def is_executable(self, rel: str) -> bool:
        if rel in self.modes:
            return self.modes[rel]
        if rel in self.changes and self.changes[rel] is None:
            return False
        # A rewritten file keeps its mode; a new one is not executable.
        return self.base.is_executable(rel)

    def set_executable(self, rel: str, executable: bool) -> None:
        self.modes[rel] = executable

    def historical_task_ids(self) -> set[str]:
        # Read once per change set: a set may create several tasks.
        if self.history is None:
            self.history = self.base.historical_task_ids()
        return self.history

    def diff(self) -> dict[str, tuple[str | None, str | None]]:
        """(before, after) text of each path the overlay changes; None: absent.

        A path whose executable bit changes is listed even when its text
        does not.
        """
        out: dict[str, tuple[str | None, str | None]] = {}
        for rel in sorted(set(self.changes) | set(self.modes), key=path_key):
            after = self.read_text(rel) if self.is_file(rel) else None
            before = self.base.read_text(rel) if self.base.is_file(rel) else None
            mode_changed = after is not None and (
                self.is_executable(rel) != self.base.is_executable(rel)
            )
            if before != after or mode_changed:
                out[rel] = (before, after)
        return out


def is_project(snap: Snapshot, name: str) -> bool:
    if name.startswith(".") or not snap.is_dir(name):
        return False
    return snap.is_file(f"{name}/README.md") or snap.is_file(f"{name}/PROJECT.md")


def list_projects(snap: Snapshot) -> list[str]:
    return [name for name in snap.list_dir("") if is_project(snap, name)]


def check_project_name(project_name: str) -> None:
    if (
        "/" in project_name
        or "\\" in project_name
        or ".." in project_name
        or not project_name
        or project_name.startswith(".")
    ):
        die(
            f"invalid project name (must be a top-level directory and cannot start with a dot): {project_name}"
        )


def require_project(snap: Snapshot, project_name: str) -> str:
    """Validates PROJECT_NAME and dies unless it names a directory."""
    check_project_name(project_name)
    if snap.is_file(project_name):
        die(
            f"invalid project name (a file with this name already exists): {project_name}"
        )
    if not snap.is_dir(project_name):
        die(f"unknown project: {project_name}")
    return project_name


def parse_frontmatter(
    content: str, *, lowercase_keys: bool = True
) -> tuple[dict[str, Any], str]:
    """Tolerant frontmatter parser using ruamel.yaml. Returns (dict_of_fields, body_without_fm)."""
    match = re.search(r"^---\r?\n(.*?)\r?\n---(?:\r?\n|$)", content, re.DOTALL)
    if not match:
        return {}, content

    frontmatter_str = match.group(1)
    body = content[match.end() :]

    yaml = YAML()
    try:
        data = yaml.load(frontmatter_str)
        if not isinstance(data, dict):
            data = {}
    except Exception:
        data = {}

    if lowercase_keys:
        return {str(k).lower(): v for k, v in data.items()}, body
    return {str(k): v for k, v in data.items()}, body


def parse_frontmatter_for_edit(content: str) -> tuple[Any, str]:
    """Loads frontmatter preserving raw ruamel.yaml CommentedMap and body."""
    match = re.search(r"^---\r?\n(.*?)\r?\n---(?:\r?\n|$)", content, re.DOTALL)
    if not match:
        yaml = YAML()
        return yaml.load("{}"), content

    frontmatter_str = match.group(1)
    body = content[match.end() :]

    yaml = YAML()
    try:
        data = yaml.load(frontmatter_str)
        if not isinstance(data, dict):
            die("frontmatter must be a YAML mapping")
    except Exception as e:
        die(f"cannot parse YAML frontmatter: {e}")

    return data, body


def dump_frontmatter(data: Any) -> str:
    """Serializes frontmatter mapping to YAML string using ruamel.yaml."""
    yaml = YAML()
    yaml.width = WRAP_WIDTH
    yaml.preserve_quotes = True
    yaml.default_flow_style = False
    yaml.indent(mapping=2, sequence=4, offset=2)
    buf = io.StringIO()
    yaml.dump(data, buf)
    return f"---\n{buf.getvalue()}---\n"


def extract_frontmatter_field(content: str, key: str) -> str:
    fm, _ = parse_frontmatter(content)
    val = fm.get(key.lower(), "")
    if not val:
        m = re.search(
            rf"^{re.escape(key)}:\s*(.+)$", content, re.MULTILINE | re.IGNORECASE
        )
        if m:
            val = m.group(1).strip().strip("'\"")
    if isinstance(val, datetime):
        return val.date().isoformat()
    if isinstance(val, date):
        return val.isoformat()
    if isinstance(val, (list, dict)):
        return json.dumps(_to_jsonable(val))
    return str(val)


def extract_body(content: str) -> str:
    match = re.search(r"^---\r?\n(.*?)\r?\n---(?:\r?\n|$)", content, re.DOTALL)
    return content[match.end() :] if match else content


def extract_title_from_body(body: str) -> str:
    """Extracts H1 title from task body (ATX-style '# Title' headings only; Setext not supported)."""
    body_no_code = re.sub(r"```.*?```", "", body, flags=re.DOTALL)
    for line in body_no_code.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return ""


def extract_title(content: str) -> str:
    """Extracts H1 title from task body (ATX-style '# Title' headings only; Setext not supported)."""
    body = extract_body(content)
    return extract_title_from_body(body)


def fenced_spans(body: str) -> list[tuple[int, int]]:
    """Character ranges of the fenced code blocks in BODY."""
    spans: list[tuple[int, int]] = []
    fence = None
    start = pos = 0
    for line in body.splitlines(keepends=True):
        m = re.match(r" {0,3}(`{3,}|~{3,})", line)
        if fence is None and m:
            fence, start = m.group(1), pos
        elif (
            fence is not None
            and m
            and m.group(1)[0] == fence[0]
            and len(m.group(1)) >= len(fence)
            and not line[m.end() :].strip()
        ):
            spans.append((start, pos + len(line)))
            fence = None
        pos += len(line)
    if fence is not None:
        spans.append((start, pos))
    return spans


def find_runins(body: str, label: str) -> list[tuple[int, int]]:
    """Spans of each bold run-in LABEL in BODY, from the label to its text's end.

    A run-in is '**Label:**' outside fenced code, in a paragraph that starts
    with a template run-in label: at the paragraph start, or after whitespace
    later in it (mdformat reflows adjacent run-ins into one paragraph). Bold
    labels elsewhere, such as '- **Cost:**' in an Outcome list, are not
    run-ins. Its text ends at a blank line followed by another bold label or a
    heading, at the whitespace before the next run-in in the same paragraph, or
    at the end of BODY.
    """
    fences = fenced_spans(body)
    labels = "|".join(re.escape(lbl) for lbl in RUNIN_LABELS)
    para_start = re.compile(rf"\*\*(?:{labels}):\*\*")

    def is_runin(i: int) -> bool:
        if any(a <= i < b for a, b in fences):
            return False
        p = body.rfind("\n\n", 0, i)
        p = 0 if p < 0 else p + 2
        return bool(para_start.match(body, p))

    stop = re.compile(rf"\n\n(?=\*\*|#)|\s+(?=\*\*(?:{labels}):\*\*)")
    spans = []
    for m in re.finditer(rf"(?<!\S)\*\*{re.escape(label)}:\*\*", body):
        if not is_runin(m.start()):
            continue
        end = len(body)
        for e in stop.finditer(body, m.end()):
            if any(a <= e.start() < b for a, b in fences):
                continue
            if e.group().startswith("\n\n") or is_runin(e.end()):
                end = e.start()
                break
        spans.append((m.start(), end))
    return spans


def find_sections(body: str, heading: str) -> tuple[list[tuple[int, int]], list[str]]:
    """Spans of each '## HEADING' section in BODY, and similar headings.

    The heading text must equal HEADING exactly. A section ends before the
    blank lines preceding the next level-1 or level-2 heading, or at the end of
    BODY. Headings inside fenced code are ignored. The second value lists
    level-2 headings that start with HEADING but are not equal to it (such as
    '## Outcome & Commit'), so callers can report them.
    """
    fences = fenced_spans(body)
    spans: list[tuple[int, int]] = []
    similar: list[str] = []
    start = None
    pos = 0
    for line in body.splitlines(keepends=True):
        if not any(a <= pos < b for a, b in fences):
            h = re.match(r"(#{1,6})[ \t]+(.*?)[ \t#]*$", line.rstrip("\n"))
            if h:
                if len(h.group(1)) <= 2 and start is not None:
                    spans.append((start, len(body[:pos].rstrip())))
                    start = None
                if len(h.group(1)) == 2 and h.group(2) == heading:
                    start = pos
                elif len(h.group(1)) >= 2 and re.match(
                    rf"{re.escape(heading)}\b", h.group(2), re.IGNORECASE
                ):
                    similar.append(line.strip())
            elif re.match(rf"\*\*{re.escape(heading)}:\*\*", line):
                similar.append(f"**{heading}:**")
        pos += len(line)
    if start is not None:
        spans.append((start, len(body.rstrip())))
    return spans, similar


def extract_runin(content: str, label: str) -> str:
    """Extracts the text of a bold run-in label (e.g. '**Goal:** ...') from a task body.

    Returns the first such label's prose with internal newlines collapsed, or
    '' when the label is absent. Mirrors the run-in layout written by
    'create'/'update'.
    """
    body = extract_body(content)
    spans = find_runins(body, label)
    if not spans:
        return ""
    start, end = spans[0]
    return " ".join(body[start + len(f"**{label}:**") : end].split())


def section_hash(text: str) -> str:
    """The precondition hash of a section's exact text."""
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]


def section_spans(body: str, spec: "SectionSpec") -> list[tuple[int, int]]:
    """Spans of each occurrence of section SPEC in the record body BODY.

    The title is its '# ' line, a run-in runs from its bold label to its
    text's end, a heading section from its '## ' line to before the next
    level-1 or level-2 heading (or the generated block), and the generated
    section from BEGIN to END.
    """
    begin = body.find(BEGIN)
    spans: list[tuple[int, int]] = []
    if spec.form == "title":
        fences = fenced_spans(body)
        for m in re.finditer(r"^# .*$", body, re.MULTILINE):
            if not any(a <= m.start() < b for a, b in fences):
                spans.append((m.start(), m.end()))
                break
    elif spec.form == "run-in":
        spans = find_runins(body, spec.name)
    elif spec.form == "heading":
        found, _ = find_sections(body, spec.name)
        for a, b in found:
            if a < begin < b:
                b = len(body[:begin].rstrip())
            spans.append((a, b))
    elif spec.form == "generated":
        end = body.find(END)
        if begin >= 0 and end > begin:
            spans.append((begin, end + len(END)))
    return spans


def record_sections(content: str, schema: "RecordSchema") -> list[dict[str, str]]:
    """The schema sections present in CONTENT, in schema order, with hashes.

    Each entry is {name, text, hash}, with the text section_spans() finds. A
    section that occurs more than once is listed once per occurrence.
    """
    body = extract_body(content)
    out: list[dict[str, str]] = []
    for spec in schema.sections:
        for a, b in section_spans(body, spec):
            text = body[a:b]
            out.append({"name": spec.name, "text": text, "hash": section_hash(text)})
    return out


def normalize_slug(value: str) -> str:
    """Normalizes VALUE into slug form (lowercase, hyphen-separated, no truncation)."""
    s = value.lower()
    s = re.sub(r"[^a-z0-9]+", "-", s)
    s = re.sub(r"-+", "-", s)
    return s.strip("-")


def slugify(title: str, max_len: int = SLUG_MAX_LEN) -> str:
    """Derives a filename slug from TITLE, truncated at word boundaries."""
    s = normalize_slug(title)
    if len(s) <= max_len:
        return s
    words = s.split("-")
    kept: list[str] = []
    length = 0
    for word in words:
        extra = len(word) if not kept else len(word) + 1
        if length + extra > max_len:
            break
        kept.append(word)
        length += extra
    if not kept:
        # A single leading word exceeds the budget; hard-cut it rather than
        # return nothing.
        return words[0][:max_len]
    return "-".join(kept)


def filename_slug(name: str) -> str:
    """Extracts the slug of an already taskgo-named file (empty when not one)."""
    m = re.match(r"^TASK-[0-9A-F]{5}-(.+)$", name.removesuffix(".md"))
    return normalize_slug(m.group(1)) if m else ""


def normalize_status(raw_status: str) -> str:
    clean = raw_status.strip().lower().replace(" ", "-")
    return STATE_ALIASES.get(clean, clean if clean in STANDARD_STATES else "todo")


def get_task_files(snap: Snapshot, project_name: str | None = None) -> list[str]:
    """Relative paths of the task files in PROJECT_NAME, or in every project."""
    if project_name:
        projects = [require_project(snap, project_name)]
    else:
        projects = list_projects(snap)
    files = [f for p in projects for f in snap.glob_md(f"{p}/tasks")]
    return sorted(files, key=path_key)


ISO_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
DUE_SOON_DAYS = 7


def parse_iso_date(value: Any) -> date | None:
    """Parses a YYYY-MM-DD string or date object into a datetime.date, or None."""
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, datetime):
        return value.date()
    if isinstance(value, date):
        return value
    s = str(value).strip().strip("'\"")
    if not ISO_DATE_RE.match(s):
        return None
    try:
        return date.fromisoformat(s)
    except ValueError:
        return None


def repo_timezone_name(snap: Snapshot) -> str | None:
    """The timezone named in the root README.md frontmatter, if any."""
    try:
        fm, _ = parse_frontmatter(snap.read_text("README.md"))
    except OSError:
        return None
    name = str(fm.get("timezone") or "").strip()
    return name or None


def load_zone(name: str) -> ZoneInfo | None:
    """The ZoneInfo for IANA zone NAME, or None when it is not a known zone."""
    try:
        return ZoneInfo(name)
    except (ZoneInfoNotFoundError, ValueError):
        return None


def get_today(snap: Snapshot) -> date:
    """Returns today's calendar date for the repository.

    Stored dates are floating calendar days; the timezone only decides which
    day it is now. TASKGO_TODAY=YYYY-MM-DD wins, then the root README.md
    `timezone`, then the machine's local date (also when the zone is unknown,
    which doctor reports).
    """
    env_today = os.environ.get("TASKGO_TODAY")
    if env_today:
        parsed = parse_iso_date(env_today)
        if parsed is not None:
            return parsed
    name = repo_timezone_name(snap)
    zone = load_zone(name) if name else None
    if zone is not None:
        return datetime.now(zone).date()
    return datetime.now().astimezone().date()


def parse_blocked_by(fm: dict[str, Any]) -> tuple[str, ...]:
    """Reads the optional blocked_by edge list, tolerating a bare scalar."""
    return read_field(fm, TASK_SCHEMA.field("blocked_by"))


def parse_wait_for(fm: dict[str, Any]) -> tuple[str, ...]:
    """Reads the optional wait_for gate list, tolerating scalars and dates."""
    return read_field(fm, TASK_SCHEMA.field("wait_for"))


def parse_date_field(fm: dict[str, Any], key: str) -> str | None:
    """Reads an optional scalar date field (due, stale_after) as YYYY-MM-DD string."""
    values = read_field(fm, TASK_SCHEMA.field(key))
    return values[0] if values else None


def normalize_wait_for_args(raw_list: list[str]) -> list[str]:
    """Normalizes CLI --wait-for values into deduplicated gate tokens."""
    tokens: list[str] = []
    for entry in raw_list:
        for sub in re.split(r"[,\s]+", str(entry)):
            cleaned = sub.strip().strip("'\"")
            if cleaned:
                tokens.append(cleaned)
    return list(dict.fromkeys(tokens))


# Record schema. One declarative description per controlled record kind:
# frontmatter fields (scalar or set, value type, mutability), and body
# sections. Validation in create/update, the doctor field checks, and the
# create/update set options read it; `taskgo schema --json` publishes it as a
# conformance artifact for other implementations (such as an MCP server).
SCHEMA_VERSION = 1

GATE_PATTERN = (
    r"^(?:\d{4}-\d{2}-\d{2}|b/\d+|cl/\d+"
    r"|gh:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#\d+|@[A-Za-z0-9_.-]+|https?://\S+)$"
)


@dataclass(slots=True, frozen=True)
class ValueType:
    description: str
    check: Callable[[Any], bool]
    pattern: str | None = None
    values: tuple[str, ...] = ()
    metavar: str = "VALUE"


def _is_gate(value: Any) -> bool:
    token = str(value)
    if ISO_DATE_RE.match(token):
        return parse_iso_date(token) is not None
    return bool(re.match(GATE_PATTERN, token))


VALUE_TYPES: dict[str, ValueType] = {
    "task-id": ValueType(
        "Task ID: TASK- and five uppercase hex digits",
        lambda v: bool(ID_PATTERN.match(str(v))),
        ID_PATTERN.pattern,
        metavar="TASK_ID",
    ),
    "status": ValueType(
        "Task state",
        lambda v: str(v) in STANDARD_STATES,
        values=tuple(s.value for s in TaskStatus),
    ),
    "date": ValueType(
        "Calendar date, YYYY-MM-DD",
        lambda v: parse_iso_date(v) is not None,
        ISO_DATE_RE.pattern,
    ),
    "gate": ValueType(
        "External or temporal gate: YYYY-MM-DD, b/N, cl/N, "
        "gh:owner/repo#N, @handle, or an http(s) URL",
        _is_gate,
        GATE_PATTERN,
        metavar="GATE",
    ),
    "conversation": ValueType(
        "Conversation URI, <agent>://<id> (id of 16 or more characters)",
        lambda v: parse_conversation_entry(v) is not None,
        metavar="URI",
    ),
    "adr-ref": ValueType(
        "ADR filename, stem, or number in the same decisions/ directory",
        lambda v: bool(str(v).strip()),
    ),
    "text": ValueType("Free text", lambda v: True),
}


@dataclass(slots=True, frozen=True)
class FieldSpec:
    name: str
    shape: Literal["scalar", "set"]
    value: str
    required: bool = False
    mutable: bool = True
    invalid: Literal["INFO", "WARN", "FAIL"] = "WARN"
    aliases: tuple[str, ...] = ()
    option: str | None = None


@dataclass(slots=True, frozen=True)
class SectionSpec:
    name: str
    form: Literal["title", "run-in", "heading", "generated"]
    required: bool = False
    writable: bool = True


@dataclass(slots=True, frozen=True)
class RecordSchema:
    kind: str
    path: str
    fields: tuple[FieldSpec, ...]
    sections: tuple[SectionSpec, ...]

    def field(self, name: str) -> FieldSpec:
        return next(f for f in self.fields if f.name == name)

    def set_fields(self) -> tuple[FieldSpec, ...]:
        return tuple(f for f in self.fields if f.shape == "set")


TASK_SCHEMA = RecordSchema(
    kind="task",
    path="<project>/tasks/TASK-XXXXX-<slug>.md",
    fields=(
        FieldSpec("id", "scalar", "task-id", required=True, mutable=False),
        FieldSpec("status", "scalar", "status", required=True),
        FieldSpec("blocked_by", "set", "task-id", option="blocked-by"),
        FieldSpec("wait_for", "set", "gate", option="wait-for"),
        FieldSpec("due", "scalar", "date", invalid="FAIL"),
        FieldSpec("stale_after", "scalar", "date", invalid="FAIL"),
        FieldSpec(
            "conversations",
            "set",
            "conversation",
            invalid="INFO",
            aliases=("conversation",),
            option="conversation",
        ),
    ),
    sections=(
        SectionSpec("title", "title", required=True),
        SectionSpec("Problem", "run-in"),
        SectionSpec("Cost", "run-in"),
        SectionSpec("Goal", "run-in"),
        SectionSpec("Criteria", "run-in"),
        SectionSpec("Sketch", "run-in"),
        SectionSpec("Constraints", "run-in"),
        SectionSpec("Outcome", "heading"),
        SectionSpec("Findings", "heading"),
        SectionSpec("Next", "heading"),
    ),
)

DECISION_SCHEMA = RecordSchema(
    kind="decision",
    path="<project>/decisions/<NNN>-<slug>.md",
    fields=(
        FieldSpec("status", "scalar", "text"),
        FieldSpec("supersedes", "set", "adr-ref"),
    ),
    sections=(
        SectionSpec("title", "title", required=True),
        SectionSpec("Status", "heading", required=True),
        SectionSpec("Context", "heading", required=True),
        SectionSpec("Decision", "heading", required=True),
        SectionSpec("Consequences", "heading", required=True),
    ),
)

STATUS_SCHEMA = RecordSchema(
    kind="status",
    path="<project>/STATUS.md",
    fields=(),
    sections=(
        SectionSpec("title", "title", required=True),
        SectionSpec("Summary", "heading", required=True),
        SectionSpec("snapshot", "generated", required=True, writable=False),
        SectionSpec("Next", "heading", required=True),
    ),
)

SCHEMAS = (TASK_SCHEMA, DECISION_SCHEMA, STATUS_SCHEMA)

RUNIN_LABELS = tuple(s.name for s in TASK_SCHEMA.sections if s.form == "run-in")


def read_field(fm: dict[str, Any], spec: FieldSpec) -> tuple[str, ...]:
    """Reads a field from lowercased frontmatter as normalized string values.

    Set fields tolerate a bare scalar and comma- or space-separated entries;
    dates become YYYY-MM-DD; task IDs are uppercased; repeats are dropped.
    """
    raw = next(
        (fm[k] for k in (spec.name, *spec.aliases) if fm.get(k) not in (None, "")),
        None,
    )
    if raw is None:
        return ()
    items = raw if spec.shape == "set" and isinstance(raw, list) else [raw]
    values: list[str] = []
    for item in items:
        if isinstance(item, datetime):
            values.append(item.date().isoformat())
        elif isinstance(item, date):
            values.append(item.isoformat())
        elif spec.shape == "scalar" or spec.value == "conversation":
            values.append(str(item).strip().strip("'\""))
        else:
            values.extend(split_field_values([str(item)], spec))
    if spec.value == "task-id":
        values = [v.upper() for v in values]
    return tuple(dict.fromkeys(v for v in values if v))


def split_field_values(raw_list: list[str], spec: FieldSpec) -> list[str]:
    """Splits CLI or frontmatter entries for a set field into distinct values."""
    values: list[str] = []
    for entry in raw_list:
        for sub in re.split(r"[,\s]+", str(entry)):
            cleaned = sub.strip().strip("'\"")
            if cleaned:
                values.append(cleaned.upper() if spec.value == "task-id" else cleaned)
    return list(dict.fromkeys(values))


def field_is_valid(spec: FieldSpec, value: Any) -> bool:
    return VALUE_TYPES[spec.value].check(value)


def invalid_field_values(
    fm: dict[str, Any], schema: RecordSchema
) -> list[tuple[FieldSpec, str]]:
    """Returns each (field, value) in FM whose value fails its schema type."""
    return [
        (spec, value)
        for spec in schema.fields
        for value in read_field(fm, spec)
        if not field_is_valid(spec, value)
    ]


def unknown_fields(fm: dict[str, Any], schema: RecordSchema) -> list[str]:
    """Returns frontmatter keys that SCHEMA does not declare."""
    known = {n for f in schema.fields for n in (f.name, *f.aliases)}
    return [k for k in fm if k not in known]


def describe_invalid(spec: FieldSpec, value: str) -> str:
    if spec.value == "date":
        return f"invalid ISO date in {spec.name} '{value}' (expected YYYY-MM-DD)"
    if spec.value == "conversation":
        return f"unparseable conversation entry '{value}'"
    return (
        f"invalid {spec.name} '{value}' "
        f"(expected {VALUE_TYPES[spec.value].description})"
    )


def schema_headings(schema: RecordSchema, required: bool = False) -> list[str]:
    return [
        s.name
        for s in schema.sections
        if s.form == "heading" and (s.required or not required)
    ]


def canonical_status(raw: Any) -> str | None:
    """Maps a state or alias to its standard state, or None when unknown."""
    clean = str(raw or "").strip().lower().replace(" ", "-")
    state = STATE_ALIASES.get(clean)
    return state.value if state else None


def require_status(raw: str, option: str) -> str:
    """Returns the standard state for RAW, or exits naming the valid states."""
    state = canonical_status(raw)
    if state is None:
        die_scoped(
            f"unknown status for {option}: {raw} "
            f"(expected one of: {', '.join(VALUE_TYPES['status'].values)})"
        )
    return str(state)


def require_field_values(spec: FieldSpec, values: list[str], option: str) -> None:
    for value in values:
        if not field_is_valid(spec, value):
            die_scoped(
                f"invalid {option} value '{value}' "
                f"(expected {VALUE_TYPES[spec.value].description})"
            )


def edit_set_field(
    data: Any,
    spec: FieldSpec,
    add: list[str],
    remove: list[str],
    schema: RecordSchema = TASK_SCHEMA,
) -> bool:
    """Adds and removes values of a set field in editable frontmatter.

    Repeats are no-ops. An existing list keeps its flow or block style, a new
    blocked_by or supersedes list uses flow style, and a field left empty is
    removed. A new field goes after the fields SCHEMA declares before it.
    Returns True if DATA changed.
    """
    names = (spec.name, *spec.aliases)
    key = next((k for k in data if str(k).lower() in names), None)
    current = list(read_field({spec.name: data[key]} if key else {}, spec))
    updated = [v for v in current if v not in remove]
    updated += [v for v in add if v not in updated]
    if updated == current:
        return False
    if not updated:
        data.pop(key, None)
        return True
    values: list[Any] = (
        [parse_iso_date(v) or v for v in updated] if spec.value == "gate" else updated
    )
    existing = data.get(key) if key is not None else None
    if isinstance(existing, list):
        del existing[:]
        existing.extend(values)
        return True
    seq = CommentedSeq(values)
    if spec.value in ("task-id", "adr-ref"):
        seq.fa.set_flow_style()
    if key is not None:
        data[key] = seq
        return True
    order = [f.name for f in schema.fields]
    earlier = set(order[: order.index(spec.name)])
    pos = max(
        (i + 1 for i, k in enumerate(data) if str(k).lower() in earlier),
        default=len(data),
    )
    data.insert(pos, spec.name, seq)
    return True


def remove_task_conversation(data: Any, conv_id: str) -> bool:
    """Removes entries for CONV_ID from frontmatter conversations."""
    changed = False
    for key in [k for k in data if str(k).lower() in ("conversations", "conversation")]:
        raw = data[key]
        items = raw if isinstance(raw, list) else [raw]
        keep = [
            i
            for i in items
            if (parse_conversation_entry(i) or ("", str(i).strip()))[1] != conv_id
        ]
        if len(keep) == len(items):
            continue
        changed = True
        if not keep:
            data.pop(key, None)
        elif isinstance(raw, list):
            del raw[:]
            raw.extend(keep)
    return changed


def check_new_blockers(
    snap: Snapshot, task_id: str | None, adds: list[str], deps: tuple[str, ...]
) -> None:
    """Refuses unknown or self-referencing added blockers, and cycles."""
    rows = get_task_rows(snap)
    known = {r.task_id for r in rows if r.task_id}
    for dep in adds:
        if dep == task_id:
            die_scoped(f"{dep} cannot be blocked by itself")
        if dep not in known:
            die_scoped(f"unknown task for --add-blocked-by: {dep}")
    if not task_id:
        return
    rows = [replace(r, blocked_by=deps) if r.task_id == task_id else r for r in rows]
    for cycle in find_dependency_cycles(rows):
        if task_id in cycle:
            chain = " -> ".join([*cycle, cycle[0]])
            die_scoped(f"blocked_by would form a cycle: {chain}")


@dataclass(slots=True, frozen=True)
class TaskRow:
    project: str
    task_id: str
    status: str
    title: str
    rel_path: str
    blocked_by: tuple[str, ...] = ()
    wait_for: tuple[str, ...] = ()
    due: str | None = None
    stale_after: str | None = None


def get_task_rows(snap: Snapshot, project_name: str | None = None) -> list[TaskRow]:
    files = get_task_files(snap, project_name)
    rows: list[TaskRow] = []
    for rel_path in files:
        try:
            content = snap.read_text(rel_path)
        except OSError:
            continue
        fm, body = parse_frontmatter(content)
        task_id = str(fm.get("id", ""))
        if not task_id:
            m = re.search(r"^id:\s*(.+)$", content, re.MULTILINE | re.IGNORECASE)
            if m:
                task_id = m.group(1).strip().strip("'\"")
        status = str(fm.get("status", ""))
        if not status:
            m = re.search(r"^status:\s*(.+)$", content, re.MULTILINE | re.IGNORECASE)
            if m:
                status = m.group(1).strip().strip("'\"")
        title = extract_title_from_body(body)
        project = rel_path.split("/")[0]
        rows.append(
            TaskRow(
                project,
                task_id,
                status,
                title,
                rel_path,
                parse_blocked_by(fm),
                parse_wait_for(fm),
                parse_date_field(fm, "due"),
                parse_date_field(fm, "stale_after"),
            )
        )
    return rows


def status_index(snap: Snapshot) -> dict[str, str]:
    """Maps every known task ID in the control repo to its declared status."""
    return {r.task_id: r.status for r in get_task_rows(snap) if r.task_id}


def unresolved_blockers(row: TaskRow, index: dict[str, str]) -> list[str]:
    """Blockers still holding ROW back.

    Unknown IDs count as resolved: a deleted blocker must never leave its
    dependents permanently unworkable.
    """
    return [
        dep
        for dep in row.blocked_by
        if dep in index and index[dep] not in RESOLVED_STATES
    ]


def unresolved_wait_for(row: TaskRow, today: date) -> list[str]:
    """Returns wait_for entries still holding ROW back as of TODAY.

    ISO dates (YYYY-MM-DD) hold a task back only while date > today.
    External/human gates (b/..., cl/..., gh:..., @handle) remain unresolved
    while present in frontmatter.
    """
    out: list[str] = []
    for item in row.wait_for:
        d = parse_iso_date(item)
        if d is not None:
            if d > today:
                out.append(item)
        else:
            out.append(item)
    return out


def find_dependency_cycles(rows: list[TaskRow]) -> list[list[str]]:
    """Returns each dependency cycle once, as a list of task IDs."""
    edges = {r.task_id: r.blocked_by for r in rows if r.task_id}
    cycles: list[list[str]] = []
    seen_keys: set[frozenset[str]] = set()
    state: dict[str, int] = {}
    stack: list[str] = []

    def visit(node: str) -> None:
        state[node] = 1
        stack.append(node)
        for dep in edges.get(node, ()):
            if dep not in edges:
                continue
            if state.get(dep) == 1:
                cycle = stack[stack.index(dep) :]
                key = frozenset(cycle)
                if key not in seen_keys:
                    seen_keys.add(key)
                    cycles.append(cycle)
            elif state.get(dep, 0) == 0:
                visit(dep)
        stack.pop()
        state[node] = 2

    for task_id in edges:
        if state.get(task_id, 0) == 0:
            visit(task_id)
    return cycles


def task_ids_in_history(repo: Path) -> set[str]:
    """Task IDs in the paths and messages of every commit reachable from a ref.

    Covers deleted tasks, tasks on unmerged branches, and Task: trailers. One
    uncached git log over all refs, so it is right in every repository state;
    it costs about 4 s at 70,000 commits. Empty outside a repository or before
    the first commit.
    """
    res = run_git(
        ["log", "--all", "--no-renames", "--format=%B", "--name-only"],
        cwd=repo,
        check=False,
    )
    return set(ID_IN_TEXT.findall(res.stdout)) if res.returncode == 0 else set()


def random_task_ids() -> Iterator[str]:
    for i in range(1, 257):
        entropy = f"{time.time_ns()}:{os.getpid()}:{os.urandom(8).hex()}:{i}"
        h = hashlib.sha1(entropy.encode("utf-8")).hexdigest()[:5].upper()
        yield f"TASK-{h}"


def generate_task_id(snap: Snapshot) -> str:
    """A task ID not used in the snapshot or anywhere in its history."""
    existing_ids = {r.task_id for r in get_task_rows(snap) if r.task_id}
    existing_ids |= snap.historical_task_ids()
    for candidate in random_task_ids():
        if candidate not in existing_ids:
            return candidate
    die("could not allocate unique task ID")


@dataclass(slots=True, frozen=True)
class AdrRow:
    project: str
    filename: str
    title: str
    rel_path: str
    raw_supersedes: tuple[str, ...] = ()
    supersedes: tuple[str, ...] = ()
    unknown_supersedes: tuple[str, ...] = ()
    superseded_by: tuple[str, ...] = ()
    self_marked_superseded: bool = False

    @property
    def is_superseded(self) -> bool:
        return bool(self.superseded_by) or self.self_marked_superseded


def parse_adr_list_field(fm: dict[str, Any], key: str) -> tuple[str, ...]:
    """Reads an optional scalar or list frontmatter field on an ADR."""
    return read_field(fm, DECISION_SCHEMA.field(key))


def resolve_adr_token(token: str, filenames: list[str]) -> str | None:
    """Resolves a supersedes token (filename, stem, or numeric prefix) to a filename."""
    t = token.strip().strip("'\"")
    if not t:
        return None
    t_lower = t.lower()
    for fn in filenames:
        if fn.lower() == t_lower or Path(fn).stem.lower() == t_lower:
            return fn
    m = re.match(r"^(?:adr[-_]?)?0*(\d+)$", t, re.IGNORECASE)
    if m:
        num = int(m.group(1))
        matches = [fn for fn in filenames if re.match(rf"^0*{num}(?:[-_.]|$)", fn)]
        if len(matches) == 1:
            return matches[0]
    return None


def is_adr_self_superseded(fm: dict[str, Any], body: str) -> bool:
    """Returns True if frontmatter status or ## Status prose marks the ADR superseded."""
    fm_status = str(fm.get("status", "")).strip().lower()
    if "superseded" in fm_status:
        return True
    m = re.search(
        r"^##\s+Status\s*$\n(.*?)(?=^##\s+|\Z)",
        body,
        re.MULTILINE | re.IGNORECASE | re.DOTALL,
    )
    return bool(m and re.search(r"\bsuperseded\b", m.group(1), re.IGNORECASE))


def get_adr_rows(snap: Snapshot, project_name: str) -> list[AdrRow]:
    """Loads all ADR rows under <project>/decisions/*.md and resolves supersedes edges."""
    adr_files = snap.glob_md(f"{project_name}/decisions")
    if not adr_files:
        return []
    filenames = [rel.rsplit("/", 1)[1] for rel in adr_files]

    prelim: list[
        tuple[str, str, str, dict[str, Any], str, tuple[str, ...], tuple[str, ...]]
    ] = []
    superseded_by_map: dict[str, list[str]] = {fn: [] for fn in filenames}

    for rel, name in zip(adr_files, filenames, strict=True):
        try:
            content = snap.read_text(rel)
        except OSError:
            continue
        fm, body = parse_frontmatter(content)
        title = extract_title(content) or name.removesuffix(".md")
        raw_sup = parse_adr_list_field(fm, "supersedes")
        resolved: list[str] = []
        unknown: list[str] = []
        for tok in raw_sup:
            target = resolve_adr_token(tok, filenames)
            if target is not None:
                if target not in resolved:
                    resolved.append(target)
                if name not in superseded_by_map[target]:
                    superseded_by_map[target].append(name)
            else:
                unknown.append(tok)
        prelim.append(
            (rel, name, title, fm, body, raw_sup, (tuple(resolved), tuple(unknown)))
        )

    rows: list[AdrRow] = []
    for rel, name, title, fm, body, raw_sup, (resolved_tup, unknown_tup) in prelim:
        rows.append(
            AdrRow(
                project=project_name,
                filename=name,
                title=title,
                rel_path=rel,
                raw_supersedes=raw_sup,
                supersedes=resolved_tup,
                unknown_supersedes=unknown_tup,
                superseded_by=tuple(superseded_by_map.get(name, ())),
                self_marked_superseded=is_adr_self_superseded(fm, body),
            )
        )
    return rows


def find_adr_cycles(rows: list[AdrRow]) -> list[list[str]]:
    """Returns each ADR supersedes cycle once, as a list of ADR filenames."""
    edges = {r.filename: r.supersedes for r in rows}
    cycles: list[list[str]] = []
    seen_keys: set[frozenset[str]] = set()
    state: dict[str, int] = {}
    stack: list[str] = []

    def visit(node: str) -> None:
        state[node] = 1
        stack.append(node)
        for dep in edges.get(node, ()):
            if dep not in edges:
                continue
            if state.get(dep) == 1:
                cycle = stack[stack.index(dep) :]
                key = frozenset(cycle)
                if key not in seen_keys:
                    seen_keys.add(key)
                    cycles.append(cycle)
            elif state.get(dep, 0) == 0:
                visit(dep)
        stack.pop()
        state[node] = 2

    for fn in edges:
        if state.get(fn, 0) == 0:
            visit(fn)
    return cycles


def build_status_block(
    snap: Snapshot,
    project_name: str,
    all_rows: list[TaskRow] | None = None,
    index: dict[str, str] | None = None,
) -> str:
    if all_rows is not None:
        rows = [r for r in all_rows if r.project == project_name]
    else:
        rows = get_task_rows(snap, project_name)
    if index is None:
        if all_rows is not None:
            index = {r.task_id: r.status for r in all_rows if r.task_id}
        else:
            index = status_index(snap)
    today = get_today(snap)
    due_cutoff = today + timedelta(days=DUE_SOON_DAYS)
    in_progress = [r for r in rows if r.status == "in-progress"]
    blocked = held_rows(rows, index, today)
    todo_count = sum(1 for r in rows if r.status == "todo")
    done_count = sum(1 for r in rows if r.status == "done")
    unclassified_count = sum(
        1 for r in rows if not r.status or r.status not in STANDARD_STATES
    )

    lines: list[str] = [
        BEGIN,
        "",
        "## Task snapshot",
        "",
        "### In progress",
        "",
    ]
    if in_progress:
        for r in in_progress:
            d = parse_iso_date(r.due)
            suffix = f" (due `{d.isoformat()}`)" if d is not None else ""
            lines.append(f"- `{r.task_id}` — {r.title}{suffix}")
    else:
        lines.append("- None")

    lines.extend(
        [
            "",
            "### Blocked",
            "",
        ]
    )
    if blocked:
        for r in blocked:
            notes: list[str] = []
            held = unresolved_blockers(r, index)
            if held:
                notes.append(f"blocked by {', '.join(f'`{d}`' for d in held)}")
            waiting = (
                unresolved_wait_for(r, today) if r.status not in RESOLVED_STATES else []
            )
            if waiting:
                notes.append(f"waiting for {', '.join(f'`{w}`' for w in waiting)}")
            if r.status not in RESOLVED_STATES:
                d = parse_iso_date(r.due)
                if d is not None:
                    notes.append(f"due `{d.isoformat()}`")
            suffix = f" ({'; '.join(notes)})" if notes else ""
            lines.append(f"- `{r.task_id}` — {r.title}{suffix}")
    else:
        lines.append("- None")

    due_soon = [
        r
        for r in rows
        if r not in in_progress
        and r not in blocked
        and r.status not in RESOLVED_STATES
        and (d := parse_iso_date(r.due)) is not None
        and d <= due_cutoff
    ]
    due_soon.sort(key=lambda r: (parse_iso_date(r.due) or date.max, r.task_id))
    if due_soon:
        lines.extend(
            [
                "",
                "### Due soon",
                "",
            ]
        )
        for r in due_soon:
            d = parse_iso_date(r.due)
            due_str = d.isoformat() if d is not None else str(r.due)
            lines.append(f"- `{r.task_id}` — {r.title} (due `{due_str}`)")

    adr_rows = get_adr_rows(snap, project_name)
    if adr_rows:
        active_adrs = [a for a in adr_rows if not a.is_superseded]
        lines.extend(
            [
                "",
                "### Decisions",
                "",
            ]
        )
        if active_adrs:
            for a in active_adrs:
                lines.append(f"- `{a.filename}` — {a.title}")
        else:
            lines.append("- None")

    counts = f"\nTodo: {todo_count} Done: {done_count}"
    if unclassified_count > 0:
        counts += f" Unclassified: {unclassified_count}"
    lines.append(counts)
    lines.append("")
    lines.append(END)
    return "\n".join(lines)


def has_commit_auth(root: Path) -> bool:
    """Check if the repository grants local commit authority in both HEAD and working tree."""
    has_head = run_git(["rev-parse", "HEAD"], check=False).returncode == 0
    if has_head:
        show_agents = run_git(["show", "HEAD:AGENTS.md"], check=False)
        if show_agents.returncode != 0 or COMMIT_AUTH not in show_agents.stdout:
            return False
    agents_path = root / "AGENTS.md"
    return agents_path.is_file() and COMMIT_AUTH in agents_path.read_text(
        encoding="utf-8"
    )


def held_rows(rows: list[TaskRow], index: dict[str, str], today: date) -> list[TaskRow]:
    """The rows the STATUS.md snapshot lists as blocked.

    Declared blocked, or held by an unresolved edge or gate. In-progress wins
    the row so the two sections stay disjoint; doctor reports the
    contradiction.
    """
    return [
        r
        for r in rows
        if r.status != "in-progress"
        and (
            r.status == "blocked"
            or unresolved_blockers(r, index)
            or (r.status not in RESOLVED_STATES and unresolved_wait_for(r, today))
        )
    ]


def render_status_file(
    snap: Snapshot,
    project_name: str,
    all_rows: list[TaskRow] | None = None,
    index: dict[str, str] | None = None,
) -> str:
    status_rel = f"{project_name}/STATUS.md"
    new_block = build_status_block(snap, project_name, all_rows=all_rows, index=index)

    if not snap.is_file(status_rel):
        return f"# Status\n\n## Summary\n\n{new_block}\n\n## Next\n"

    content = snap.read_text(status_rel)
    if BEGIN in content and END in content:
        pattern = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END), re.DOTALL)
        return pattern.sub(lambda _: new_block, content)
    return content.rstrip() + f"\n\n{new_block}\n"


def sync_status(
    snap: Snapshot,
    project_name: str,
    all_rows: list[TaskRow] | None = None,
    index: dict[str, str] | None = None,
) -> bool:
    """Returns True if file was updated/created, False if already identical."""
    status_rel = f"{project_name}/STATUS.md"
    rendered = render_status_file(snap, project_name, all_rows=all_rows, index=index)
    rendered = format_markdown(rendered)
    if snap.is_file(status_rel) and snap.read_text(status_rel) == rendered:
        return False
    snap.write_text(status_rel, rendered)
    return True


def resolve_target(root: Path, query: str, allow_deleted: bool = False) -> Path:
    # Direct file path
    p = Path(query)
    target = None
    if p.is_file():
        target = p.resolve()
    elif (root / query).is_file():
        target = (root / query).resolve()

    if target is not None:
        try:
            target.relative_to(root.resolve())
            return target
        except ValueError:
            die(f"path is outside control repository: {query}")

    if not ID_PATTERN.match(query):
        die(f"cannot resolve: {query}")

    hits: list[Path] = []
    for row in get_task_rows(FsSnapshot(root)):
        if row.task_id == query:
            hits.append(root / row.rel_path)

    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"ambiguous id: {query}")

    # Fallback to searching Git history for archived/deleted tasks
    if allow_deleted:
        res = run_git(
            ["log", "--all", "--name-only", "--format=", "--", f"*{query}*"],
            check=False,
        )
        if res.returncode == 0:
            seen_paths: set[str] = set()
            for line in res.stdout.splitlines():
                line = line.strip()
                if line.endswith(".md") and query in line:
                    seen_paths.add(line)
            if len(seen_paths) == 1:
                return (root / next(iter(seen_paths))).resolve()
            if len(seen_paths) > 1:
                die(f"ambiguous id in history: {query}")

    die(f"cannot resolve: {query}")


# ===========================================================================
# Audit & Reconciliation Engine (Shared by doctor and fix)
# ===========================================================================


@dataclass(slots=True, frozen=True)
class Finding:
    category: str
    severity: Literal["PASS", "INFO", "WARN", "FAIL"]
    message: str
    path: str | None = None  # relative to the repository root
    remediation: Callable[[], list[str] | None] | None = (
        None  # None if requires human review
    )


def resolve_link(snap: Snapshot, base: str, target: str) -> str | None:
    """The relative path TARGET names from directory BASE, or None if outside."""
    rel = posixpath.normpath(join_rel(base, target))
    if rel == ".":
        return ""
    if rel == ".." or rel.startswith("../"):
        return None
    return rel


def audit_project_adrs(snap: Snapshot, name: str, findings: list[Finding]) -> None:
    """Validates ADR sections, supersedes edges, cycles, and relative links on active ADRs."""
    decisions_dir = f"{name}/decisions"
    adr_files = snap.glob_md(decisions_dir)
    if not adr_files:
        return

    for rel in adr_files:
        filename = rel.rsplit("/", 1)[1]
        try:
            dcontent = snap.read_text(rel)
        except OSError:
            continue
        for key in unknown_fields(parse_frontmatter(dcontent)[0], DECISION_SCHEMA):
            findings.append(
                Finding(
                    category="adr",
                    severity="INFO",
                    message=f"{name}/{filename}: frontmatter field '{key}' is not in the decision schema",
                    path=rel,
                    remediation=None,
                )
            )
        for sec in schema_headings(DECISION_SCHEMA, required=True):
            if not re.search(
                rf"^##\s+{sec}\s*$", dcontent, re.MULTILINE | re.IGNORECASE
            ):
                findings.append(
                    Finding(
                        category="adr",
                        severity="WARN",
                        message=f"{name}/{filename}: ADR missing ## {sec}",
                        path=rel,
                        remediation=None,
                    )
                )

    adr_rows = get_adr_rows(snap, name)
    if not adr_rows:
        return

    for row in adr_rows:
        if row.unknown_supersedes:
            findings.append(
                Finding(
                    category="adr",
                    severity="WARN",
                    message=(
                        f"{name}/decisions/{row.filename}: supersedes names unknown "
                        f"ADR(s): {', '.join(row.unknown_supersedes)}"
                    ),
                    path=row.rel_path,
                    remediation=None,
                )
            )

    for cycle in find_adr_cycles(adr_rows):
        chain = " -> ".join([*cycle, cycle[0]])
        findings.append(
            Finding(
                category="adr",
                severity="WARN",
                message=f"{name}: ADR supersedes cycle: {chain}",
                path=decisions_dir,
                remediation=None,
            )
        )

    candidate_bases = [decisions_dir, name, ""]

    for row in adr_rows:
        if row.is_superseded:
            continue
        try:
            raw_content = snap.read_text(row.rel_path)
        except OSError:
            continue
        _, body = parse_frontmatter(raw_content)

        for other in adr_rows:
            if (
                not other.is_superseded
                or other.filename == row.filename
                or other.filename in row.supersedes
            ):
                continue
            stem = Path(other.filename).stem
            if re.search(
                rf"(?<![\w/-])(?:{re.escape(other.filename)}|{re.escape(stem)})(?![\w.-])",
                body,
            ):
                findings.append(
                    Finding(
                        category="adr",
                        severity="WARN",
                        message=(
                            f"{name}/decisions/{row.filename}: active ADR references "
                            f"superseded ADR '{other.filename}'"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )

        stale_refs: list[str] = []
        for m in re.finditer(r"\[[^\]]+\]\(([^)\s]+)\)", body):
            target = m.group(1).split("#", 1)[0].strip()
            if (
                not target
                or re.match(r"^(?:https?|mailto|conversation|file):", target)
                or target.startswith("/")
            ):
                continue
            valid_link = any(
                (resolved := resolve_link(snap, base, target)) is not None
                and snap.exists(resolved)
                for base in candidate_bases
            )
            if not valid_link:
                stale_refs.append(target)

        for ref in dict.fromkeys(stale_refs):
            findings.append(
                Finding(
                    category="adr",
                    severity="WARN",
                    message=f"{name}/decisions/{row.filename}: stale file reference '{ref}'",
                    path=row.rel_path,
                    remediation=None,
                )
            )


def audit_workspace(root: Path, target_project: str | None = None) -> list[Finding]:
    """Audits the working tree: repository checks, then the snapshot audit."""
    findings: list[Finding] = []

    # Shallow clone check
    try:
        shallow = run_git(["rev-parse", "--is-shallow-repository"]).stdout.strip()
        if shallow == "true":
            findings.append(
                Finding(
                    category="git",
                    severity="WARN",
                    message="shallow clone: history may be incomplete",
                )
            )
    except Exception:
        pass

    snap = FsSnapshot(root)
    return (
        findings
        + audit_skills(snap, target_project)
        + audit_snapshot(snap, target_project)
    )


# Root files taskgo scaffolds and formats; other root Markdown is left alone.
ROOT_RECORDS = ("AGENTS.md", "INBOX.md", "README.md")


def is_record_file(rel: str) -> bool:
    """True when REL is a project file taskgo controls: README.md,
    PROJECT.md, STATUS.md, or a Markdown file directly in tasks/ or
    decisions/. The formatting sweep covers only these."""
    parts = rel.split("/")
    if any(p.startswith(".") for p in parts):
        return False
    if len(parts) == 2:
        return parts[1] in ("README.md", "PROJECT.md", "STATUS.md")
    return (
        len(parts) == 3
        and parts[1] in ("tasks", "decisions")
        and parts[2].endswith(".md")
    )


def markdown_finding(snap: Snapshot, rel: str) -> Finding | None:
    """A finding when REL is not formatted (fixable) or cannot be formatted."""
    try:
        content = snap.read_text(rel)
        if format_markdown(content) == content:
            return None

        def remediate(target=rel) -> list[str]:
            if not snap.is_file(target):
                return []
            current = snap.read_text(target)
            formatted = format_markdown(current)
            if current != formatted:
                snap.write_text(target, formatted)
                return [target]
            return []

        return Finding(
            category="markdown",
            severity="INFO",
            message=f"{rel}: markdown formatting needed",
            path=rel,
            remediation=remediate,
        )
    except Exception as e:
        return Finding(
            category="markdown",
            severity="WARN",
            message=f"{rel}: failed to format markdown: {e}",
            path=rel,
            remediation=None,
        )


def audit_snapshot(snap: Snapshot, target_project: str | None = None) -> list[Finding]:
    """Single shared diagnostic engine for doctor and fix.

    Remediations write through SNAP, so they apply only to a writable one.
    """
    findings: list[Finding] = []

    # 1. AGENTS.md check & remediation
    agents_file = "AGENTS.md"
    if not snap.is_file(agents_file):

        def remediate_missing_agents() -> list[str]:
            # Tracking repos include commit authorization by default so agents can maintain tracker state.
            snap.write_markdown(
                agents_file,
                f"# Agent instructions\n\nThis repository follows taskgo: <{CANONICAL_URL}>.\n\n{COMMIT_AUTH}\n",
            )
            return [agents_file]

        findings.append(
            Finding(
                category="root",
                severity="WARN",
                message="missing AGENTS.md",
                path=agents_file,
                remediation=remediate_missing_agents,
            )
        )
    else:
        agents_txt = snap.read_text(agents_file)
        needs_decl = not re.search(
            r"(follows|structured|maintained|according to).*taskgo",
            agents_txt,
            re.IGNORECASE,
        )
        needs_url = CANONICAL_URL not in agents_txt
        needs_auth = COMMIT_AUTH not in agents_txt

        if needs_decl or needs_url or needs_auth:

            def remediate_agents() -> list[str]:
                cur = snap.read_text(agents_file)
                has_decl = bool(
                    re.search(
                        r"(follows|structured|maintained|according to).*taskgo",
                        cur,
                        re.IGNORECASE,
                    )
                )
                if not has_decl:
                    cur = (
                        f"This repository follows taskgo: <{CANONICAL_URL}>.\n\n" + cur
                    )
                elif CANONICAL_URL not in cur:
                    cur += f"\nCanonical URL: <{CANONICAL_URL}>\n"
                if COMMIT_AUTH not in cur:
                    cur = cur.rstrip() + f"\n\n{COMMIT_AUTH}\n"
                snap.write_markdown(agents_file, cur)
                return [agents_file]

            if needs_decl:
                findings.append(
                    Finding(
                        category="root",
                        severity="WARN",
                        message="AGENTS.md: must state that the repository follows taskgo",
                        path=agents_file,
                        remediation=remediate_agents,
                    )
                )
            if needs_url:
                findings.append(
                    Finding(
                        category="root",
                        severity="WARN",
                        message=f"AGENTS.md: missing canonical taskgo URL: {CANONICAL_URL}",
                        path=agents_file,
                        remediation=remediate_agents,
                    )
                )
            if needs_auth:
                findings.append(
                    Finding(
                        category="root",
                        severity="INFO",
                        message=f"AGENTS.md: missing {COMMIT_AUTH}",
                        path=agents_file,
                        remediation=remediate_agents,
                    )
                )

    # 2. INBOX.md check & remediation
    inbox_file = "INBOX.md"
    if not snap.is_file(inbox_file):

        def remediate_missing_inbox() -> list[str]:
            snap.write_markdown(inbox_file, "# Inbox\n")
            return [inbox_file]

        findings.append(
            Finding(
                category="root",
                severity="WARN",
                message="missing INBOX.md",
                path=inbox_file,
                remediation=remediate_missing_inbox,
            )
        )

    # 3. Duplicate global task IDs
    all_rows = get_task_rows(snap)
    status_idx = {r.task_id: r.status for r in all_rows if r.task_id}
    seen_ids: dict[str, int] = {}
    for r in all_rows:
        if r.task_id:
            seen_ids[r.task_id] = seen_ids.get(r.task_id, 0) + 1
    dups = [k for k, v in seen_ids.items() if v > 1]
    if dups:
        findings.append(
            Finding(
                category="tasks",
                severity="WARN",
                message=f"duplicate global task ID(s): {' '.join(sorted(dups))}",
                remediation=None,  # Ambiguous duplicate resolution requires human review
            )
        )

    # 4. Project-level checks
    if target_project:
        projects = [require_project(snap, target_project)]
    else:
        projects = list_projects(snap)

    for name in projects:
        tasks_dir = f"{name}/tasks"
        status_file = f"{name}/STATUS.md"

        # Check STATUS.md
        if not snap.is_file(status_file):

            def make_remediate_status(p_name=name, p_status=status_file):
                def remediate() -> list[str]:
                    sync_status(snap, p_name)
                    return [p_status]

                return remediate

            findings.append(
                Finding(
                    category="project",
                    severity="WARN",
                    message=f"{name}: missing STATUS.md",
                    path=status_file,
                    remediation=make_remediate_status(name, status_file),
                )
            )

        # Check project README / PROJECT frontmatter syntax
        for doc_name in ("README.md", "PROJECT.md"):
            doc_rel = f"{name}/{doc_name}"
            if snap.is_file(doc_rel):
                doc_text = snap.read_text(doc_rel)
                if re.match(r"^---\r?\n", doc_text):
                    try:
                        split_record(doc_text)
                    except ChangeSetError as e:
                        findings.append(
                            Finding(
                                category="project",
                                severity="FAIL",
                                message=f"{doc_rel}: invalid YAML frontmatter: {e}",
                                path=doc_rel,
                                remediation=None,
                            )
                        )
                        continue
                    # 'skills' names skills as the skill CLI resolves them;
                    # the catalog check is audit_skills (doctor and fix).
                    raw = parse_frontmatter(doc_text)[0].get("skills")
                    bad = [
                        s
                        for s in _normalize_skill_list(raw)
                        if not SKILL_SPEC_RE.match(s)
                    ]
                    if raw is not None and not isinstance(raw, (list, str)):
                        bad = [str(raw)]
                    if bad:
                        findings.append(
                            Finding(
                                category="project",
                                severity="WARN",
                                message=(
                                    f"{doc_rel}: skills must be a list of skill "
                                    f"names, not {', '.join(repr(b) for b in bad)}"
                                ),
                                path=doc_rel,
                            )
                        )

        # Check tasks
        for tf in snap.glob_md(tasks_dir):
            content = snap.read_text(tf)
            rel_path = tf
            tf_name = tf.rsplit("/", 1)[1]

            m_fm = re.search(r"^---\r?\n(.*?)\r?\n---(?:\r?\n|$)", content, re.DOTALL)
            if not m_fm and re.match(r"^---\r?\n", content):
                findings.append(
                    Finding(
                        category="task",
                        severity="FAIL",
                        message=(
                            f"{rel_path}: invalid YAML frontmatter: frontmatter is not closed\n"
                            "        Add closing '---' delimiter after frontmatter fields."
                        ),
                        path=tf,
                        remediation=None,
                    )
                )
                continue
            if m_fm:
                yaml = YAML()
                try:
                    parsed_yaml = yaml.load(m_fm.group(1))
                    if not isinstance(parsed_yaml, dict):
                        findings.append(
                            Finding(
                                category="task",
                                severity="FAIL",
                                message=(
                                    f"{rel_path}: invalid YAML frontmatter: frontmatter must be a YAML mapping\n"
                                    "        Fix syntax between '---' delimiters to ensure frontmatter is a key-value mapping."
                                ),
                                path=tf,
                                remediation=None,
                            )
                        )
                        continue
                except Exception as e:
                    err_line = str(e).splitlines()[0] if str(e) else "syntax error"
                    findings.append(
                        Finding(
                            category="task",
                            severity="FAIL",
                            message=(
                                f"{rel_path}: invalid YAML frontmatter: {err_line}\n"
                                "        Fix YAML frontmatter syntax or restore task from git."
                            ),
                            path=tf,
                            remediation=None,
                        )
                    )
                    continue

            fm, _ = parse_frontmatter(content)

            # Field values and keys come from the task schema; id and
            # status get repair findings below.
            for spec, value in invalid_field_values(fm, TASK_SCHEMA):
                if spec.name in ("id", "status"):
                    continue
                findings.append(
                    Finding(
                        category="task",
                        severity=spec.invalid,
                        message=f"{rel_path}: {describe_invalid(spec, value)}",
                        path=tf,
                        remediation=None,
                    )
                )
            for key in unknown_fields(fm, TASK_SCHEMA):
                findings.append(
                    Finding(
                        category="task",
                        severity="INFO",
                        message=f"{rel_path}: frontmatter field '{key}' is not in the task schema",
                        path=tf,
                        remediation=None,
                    )
                )

            task_id = fm.get("id", "")
            raw_status = fm.get("status", "")

            # A done task's Outcome gives the verdict against its Criteria.
            # Older records predate the rule, so this does not block.
            if raw_status == "done":
                body = extract_body(content)
                spans, similar = find_sections(body, "Outcome")
                if not any(body[s:e].partition("\n")[2].strip() for s, e in spans):
                    hint = f" (similar: {', '.join(similar)})" if similar else ""
                    findings.append(
                        Finding(
                            category="task",
                            severity="INFO",
                            message=(
                                f"{rel_path}: done task has no ## Outcome text{hint}\n"
                                "        Give a verdict against each criterion."
                            ),
                            path=tf,
                            remediation=None,
                        )
                    )

            m = re.search(r"TASK-[0-9A-F]{5}", tf_name)
            filename_id = m.group(0) if m else ""

            needs_id_fix = not field_is_valid(TASK_SCHEMA.field("id"), task_id)
            needs_status_fix = not field_is_valid(
                TASK_SCHEMA.field("status"), raw_status
            )
            needs_filename_fix = (
                bool(filename_id and filename_id != task_id) or not filename_id
            )

            if needs_id_fix or needs_status_fix or needs_filename_fix:

                def make_remediate_task(target_tf=tf, p_tasks=tasks_dir):
                    def remediate() -> list[str]:
                        t_content = snap.read_text(target_tf)
                        t_fm, t_body = parse_frontmatter_for_edit(t_content)
                        t_id = ""
                        id_key = None
                        for k in list(t_fm.keys()):
                            if str(k).lower() == "id":
                                t_id = str(t_fm[k])
                                id_key = k
                                break
                        if not ID_PATTERN.match(t_id):
                            t_id = generate_task_id(snap)

                        raw_status = "todo"
                        status_key = None
                        for k in list(t_fm.keys()):
                            if str(k).lower() == "status":
                                raw_status = str(t_fm[k])
                                status_key = k
                                break
                        t_status = normalize_status(raw_status)
                        target_name = target_tf.rsplit("/", 1)[1]
                        t_title = extract_title(t_content) or target_name.removesuffix(
                            ".md"
                        )
                        if not t_body.strip():
                            t_body = f"\n# {t_title}\n\n## Outcome\n\n## Findings\n\n## Next\n"

                        t_fm[id_key or "id"] = t_id
                        t_fm[status_key or "status"] = t_status

                        new_content = f"{dump_frontmatter(t_fm)}\n{t_body.lstrip()}\n"
                        snap.write_markdown(target_tf, new_content)
                        # Preserve a caller-chosen slug when the file is
                        # already taskgo-named: only its ID prefix is
                        # being repaired. Files adopted from other names
                        # still get a slug derived from their title.
                        slug = filename_slug(target_name) or slugify(t_title) or "task"
                        new_name = f"{t_id}-{slug}.md"
                        new_path = f"{p_tasks}/{new_name}"
                        if target_name != new_name:
                            snap.rename(target_tf, new_path)
                            return [target_tf, new_path]
                        return [target_tf]

                    return remediate

                if needs_id_fix:
                    findings.append(
                        Finding(
                            category="task",
                            severity="WARN",
                            message=f"{rel_path}: invalid/missing id '{task_id}'",
                            path=tf,
                            remediation=make_remediate_task(tf, tasks_dir),
                        )
                    )
                if needs_status_fix and not needs_id_fix:
                    findings.append(
                        Finding(
                            category="task",
                            severity="WARN",
                            message=f"{rel_path}: non-standard status '{raw_status}'",
                            path=tf,
                            remediation=make_remediate_task(tf, tasks_dir),
                        )
                    )
                if needs_filename_fix and not needs_id_fix:
                    findings.append(
                        Finding(
                            category="task",
                            severity="WARN",
                            message=f"{rel_path}: filename/frontmatter IDs disagree",
                            path=tf,
                            remediation=make_remediate_task(tf, tasks_dir),
                        )
                    )

        # Check STATUS.md snapshot drift
        if snap.is_file(status_file):
            current_status = snap.read_text(status_file)
            rendered = render_status_file(
                snap, name, all_rows=all_rows, index=status_idx
            )
            rendered = format_markdown(rendered)
            if current_status != rendered:

                def make_remediate_snapshot(p_name=name, p_status=status_file):
                    def remediate() -> list[str]:
                        sync_status(snap, p_name)
                        return [p_status]

                    return remediate

                findings.append(
                    Finding(
                        category="status",
                        severity="WARN",
                        message=f"{name}: stale STATUS task snapshot (run sync)",
                        path=status_file,
                        remediation=make_remediate_snapshot(name, status_file),
                    )
                )

            for sec in schema_headings(STATUS_SCHEMA, required=True):
                if not re.search(rf"^##\s+{sec}\s*$", current_status, re.MULTILINE):
                    findings.append(
                        Finding(
                            category="status",
                            severity="WARN",
                            message=f"{name}: STATUS.md missing ## {sec}",
                            path=status_file,
                            remediation=None,
                        )
                    )

            rows = [r for r in all_rows if r.project == name]
            active = sum(1 for r in rows if r.status == "in-progress")
            prose = re.sub(
                re.escape(BEGIN) + r".*?" + re.escape(END),
                "",
                current_status,
                flags=re.DOTALL,
            )
            if active > 0 and re.search(
                r"(no\s+tasks?|nothing)(\s+(is|are))?(\s+currently)?\s+in[ -]progress",
                prose,
                re.IGNORECASE,
            ):
                findings.append(
                    Finding(
                        category="status",
                        severity="WARN",
                        message=f"{name}: STATUS prose says no task is in progress, but {active} task(s) are in-progress",
                        path=status_file,
                        remediation=None,  # Human semantic editing required
                    )
                )

        # Check decisions ADRs
        audit_project_adrs(snap, name, findings)

        # Check Markdown formatting of the project's records; free-form
        # documents are the owner's to format.
        for mf in snap.walk_md(name):
            if is_record_file(mf) and (finding := markdown_finding(snap, mf)):
                findings.append(finding)

    if not target_project:
        for rmf in ROOT_RECORDS:
            if snap.is_file(rmf) and (finding := markdown_finding(snap, rmf)):
                findings.append(finding)

    # The zone decides "today" for every project, so check it on every run.
    tz_name = repo_timezone_name(snap)
    if tz_name and load_zone(tz_name) is None:
        findings.append(
            Finding(
                category="root",
                severity="FAIL",
                message=(
                    f"unknown timezone {tz_name!r} in README.md; "
                    "using the machine's local date"
                ),
                path="README.md",
                remediation=None,
            )
        )

    # Dependency edges & temporal gates. Never auto-remediated: an invented or
    # removed edge/gate is worse than an absent one, so every finding here needs
    # human review.
    index = status_idx
    today = get_today(snap)
    scoped_rows = [
        r for r in all_rows if not target_project or r.project == target_project
    ]
    for row in scoped_rows:
        unknown = [dep for dep in row.blocked_by if dep not in index]
        if unknown:
            findings.append(
                Finding(
                    category="depends",
                    severity="WARN",
                    message=f"{row.rel_path}: blocked_by names unknown task(s): {', '.join(unknown)}",
                    path=row.rel_path,
                    remediation=None,
                )
            )
        if row.status not in RESOLVED_STATES:
            done_deps = [
                dep
                for dep in row.blocked_by
                if index.get(dep, "").lower() == TaskStatus.DONE.value
            ]
            if done_deps:
                formatted = ", ".join(f"{dep} (done)" for dep in done_deps)
                findings.append(
                    Finding(
                        category="depends",
                        severity="WARN",
                        message=(
                            f"{row.rel_path}: blocked_by names resolved task(s): "
                            f"{formatted}; remove the edge"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )
            cancelled_deps = [
                dep
                for dep in row.blocked_by
                if index.get(dep, "").lower() == TaskStatus.CANCELLED.value
            ]
            if cancelled_deps:
                formatted = ", ".join(f"{dep} (cancelled)" for dep in cancelled_deps)
                findings.append(
                    Finding(
                        category="depends",
                        severity="WARN",
                        message=(
                            f"{row.rel_path}: blocked_by names resolved task(s): "
                            f"{formatted}; re-plan or remove the edge"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )

            # Invalid dates are reported by the schema field check.
            due_date = parse_iso_date(row.due)
            if due_date is not None and due_date < today:
                findings.append(
                    Finding(
                        category="schedule",
                        severity="FAIL",
                        message=(
                            f"{row.rel_path}: overdue (due {due_date.isoformat()}, "
                            f"{(today - due_date).days}d ago)"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )
            elif due_date is not None and due_date <= today + timedelta(days=2):
                findings.append(
                    Finding(
                        category="schedule",
                        severity="INFO",
                        message=(
                            f"{row.rel_path}: due soon (due {due_date.isoformat()}, "
                            "within 48h)"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )

            stale_date = parse_iso_date(row.stale_after)
            if stale_date is not None and stale_date < today:
                findings.append(
                    Finding(
                        category="schedule",
                        severity="WARN",
                        message=(
                            f"{row.rel_path}: stale task "
                            f"(stale_after {stale_date.isoformat()}); "
                            "re-scope or cancel"
                        ),
                        path=row.rel_path,
                        remediation=None,
                    )
                )

        if (
            row.status == TaskStatus.BLOCKED.value
            and not unresolved_blockers(row, index)
            and not unresolved_wait_for(row, today)
        ):
            if row.blocked_by:
                detail = "all blocked_by edges resolved"
            elif row.wait_for:
                detail = "all wait_for gates elapsed"
            else:
                detail = "no blocked_by edges"
            findings.append(
                Finding(
                    category="depends",
                    severity="WARN",
                    message=f"{row.rel_path}: status is blocked but {detail}",
                    path=row.rel_path,
                    remediation=None,
                )
            )

    for cycle in find_dependency_cycles(all_rows):
        if target_project and not any(
            r.task_id in cycle and r.project == target_project for r in scoped_rows
        ):
            continue
        findings.append(
            Finding(
                category="depends",
                severity="WARN",
                message=f"blocked_by cycle: {' -> '.join(cycle)} -> {cycle[0]}",
                remediation=None,
            )
        )

    return findings


def cmd_id() -> None:
    """Allocate a unique task ID."""
    root = get_repo_root()
    print(generate_task_id(FsSnapshot(root)))


def cmd_root() -> None:
    """Print the resolved control repository root."""
    print(get_repo_root())


def render_task_file(
    task_id: str,
    title: str,
    status: str,
    problem: str | None = None,
    cost: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
    wait_for: list[str] | tuple[str, ...] | None = None,
    due: str | None = None,
    stale_after: str | None = None,
    blocked_by: list[str] | tuple[str, ...] | None = None,
    conversations: list[str] | None = None,
) -> str:
    """Render and format a task Markdown document."""
    body_blocks = []
    if problem:
        body_blocks.append(f"**Problem:** {problem}")
    if cost:
        body_blocks.append(f"**Cost:** {cost}")
    if goal:
        body_blocks.append(f"**Goal:** {goal}")
    if criteria:
        body_blocks.append(f"**Criteria:** {criteria}")
    if sketch:
        body_blocks.append(
            f"**Sketch:**\n\n{sketch}"
            if ("\n" in sketch or sketch.strip().startswith("1."))
            else f"**Sketch:** {sketch}"
        )
    if constraints:
        body_blocks.append(f"**Constraints:** {constraints}")

    if status == "done":
        if outcome:
            body_blocks.append(f"## Outcome\n\n{outcome}")
        else:
            body_blocks.append("## Outcome")

        if findings:
            body_blocks.append(f"## Findings\n\n{findings}")
        else:
            body_blocks.append("## Findings")

        if next_steps:
            body_blocks.append(f"## Next\n\n{next_steps}")
        else:
            body_blocks.append("## Next")
    else:
        if outcome:
            body_blocks.append(f"## Outcome\n\n{outcome}")
        if findings:
            body_blocks.append(f"## Findings\n\n{findings}")
        if next_steps:
            body_blocks.append(f"## Next\n\n{next_steps}")

        if not body_blocks:
            body_blocks.append("**Goal:**\n\n**Criteria:**")

    body = "\n\n".join(body_blocks)

    fm_data: dict[str, Any] = {"id": task_id, "status": status}
    if blocked_by:
        deps = CommentedSeq(blocked_by)
        deps.fa.set_flow_style()
        fm_data["blocked_by"] = deps
    if wait_for:
        fm_data["wait_for"] = [parse_iso_date(w) or w for w in wait_for]
    if due:
        fm_data["due"] = parse_iso_date(due) or due
    if stale_after:
        fm_data["stale_after"] = parse_iso_date(stale_after) or stale_after
    convs = list(dict.fromkeys([*([conv] if conv else []), *(conversations or [])]))
    if convs:
        fm_data["conversations"] = convs
    fm_block = dump_frontmatter(fm_data)

    raw = f"""{fm_block}
# {title}

{body}
"""
    try:
        return format_markdown(raw)
    except Exception:
        return raw


def create_task(snap: Snapshot, project_name: str, rel_path: str, content: str) -> None:
    """Writes a new task, scaffolding its project if needed, and syncs STATUS.md."""
    # Auto-initialize project scaffolding if it's a new project
    if not is_project(snap, project_name):
        readme = f"{project_name}/README.md"
        if not snap.is_file(readme):
            snap.write_markdown(readme, f"# {project_name}\n\nProject overview.\n")
        status_file = f"{project_name}/STATUS.md"
        if not snap.is_file(status_file):
            snap.write_markdown(
                status_file,
                f"# Status\n\n## Summary\n\nInitial setup for {project_name}.\n\n<!-- taskgo:begin -->\n<!-- taskgo:end -->\n\n## Next\n",
            )
    snap.write_markdown(rel_path, content)
    sync_status(snap, project_name)


def cmd_create(
    project_name: str,
    title: str,
    slug: str | None = None,
    status: str = "todo",
    problem: str | None = None,
    cost: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
    wait_for: list[str] | None = None,
    due: str | None = None,
    stale_after: str | None = None,
    no_commit: bool = False,
    dry_run: bool = False,
    add_blocked_by: list[str] | None = None,
    add_wait_for: list[str] | None = None,
    add_conversations: list[str] | None = None,
) -> None:
    """Create a new task in PROJECT."""
    if (
        "/" in project_name
        or "\\" in project_name
        or ".." in project_name
        or not project_name
        or project_name.startswith(".")
    ):
        die(
            f"invalid project name (must be a top-level directory and cannot start with a dot): {project_name}"
        )

    if due is not None and parse_iso_date(due) is None:
        die_scoped(f"invalid ISO date for --due (expected YYYY-MM-DD): {due}")
    if stale_after is not None and parse_iso_date(stale_after) is None:
        die_scoped(
            f"invalid ISO date for --stale-after (expected YYYY-MM-DD): {stale_after}"
        )
    wait_spec = TASK_SCHEMA.field("wait_for")
    norm_wait_for = split_field_values(
        [*(wait_for or []), *(add_wait_for or [])], wait_spec
    )
    require_field_values(wait_spec, norm_wait_for, "--wait-for")
    blocked_spec = TASK_SCHEMA.field("blocked_by")
    deps = split_field_values(add_blocked_by or [], blocked_spec)
    require_field_values(blocked_spec, deps, "--add-blocked-by")
    extra_convs: list[str] = []
    for entry in split_field_values(
        add_conversations or [], TASK_SCHEMA.field("conversations")
    ):
        parsed = normalize_conversation_id(entry)
        if parsed:
            extra_convs.append(f"{parsed[0]}://{parsed[1]}")

    if slug is not None:
        task_slug = normalize_slug(slug)
        if not task_slug:
            die_scoped(f"--slug contains no usable characters: {slug}")
        if len(task_slug) > SLUG_MAX_LEN:
            die_scoped(
                f"--slug too long ({len(task_slug)} > {SLUG_MAX_LEN} chars): {task_slug}"
            )
    else:
        full_slug = normalize_slug(title)
        task_slug = slugify(title) or "task"
        if not full_slug or len(full_slug) > SLUG_MAX_LEN:
            reason = (
                "Title yields no usable filename slug"
                if not full_slug
                else "Title too long for a filename"
            )
            print(
                _tagged(f"[WARN]  {reason}; using '{task_slug}'.", sys.stderr),
                file=sys.stderr,
            )
            print(
                _tagged(
                    f"[WARN]    Pass --slug SLUG (<= {SLUG_MAX_LEN} chars) to choose a better filename.",
                    sys.stderr,
                ),
                file=sys.stderr,
            )

    status = require_status(status, "--status")
    if status == "done" and not (outcome or "").strip():
        die_scoped(
            "a done task needs an Outcome: pass --outcome with a verdict "
            "against each criterion"
        )
    session = get_active_session(conv)
    conv_uri = f"{session[0]}://{session[1]}" if session else None
    root = get_repo_root()
    snap = FsSnapshot(root)
    if deps:
        check_new_blockers(snap, None, deps, tuple(deps))
    if snap.is_file(project_name):
        die(
            f"cannot create project '{project_name}': a file with this name already exists"
        )

    task_id = generate_task_id(snap)
    filename = f"{task_id}-{task_slug}.md"
    rel_task_path = f"{project_name}/tasks/{filename}"
    is_new_project = not is_project(snap, project_name)

    if dry_run:
        print(
            _tagged(
                "[INFO]  Dry run: would create task record and sync STATUS.md:",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        if is_new_project:
            print(
                _tagged(
                    f"[INFO]    - Scaffolding: {project_name}/README.md, {project_name}/STATUS.md",
                    sys.stderr,
                ),
                file=sys.stderr,
            )
        print(
            _tagged(
                f"[INFO]    - Task file:   {rel_task_path} (status: {status})",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        prefix = f"{project_name}: create {task_id}"
        remaining = 50 - len(prefix) - 3
        if remaining > 5 and len(title) > remaining:
            short_title = title[: remaining - 3].rstrip() + "..."
            subject = f"{prefix} ({short_title})"
        elif remaining > 5:
            subject = f"{prefix} ({title})"
        else:
            subject = prefix
        print(
            _tagged(f"[INFO]    - Commit:      {subject}", sys.stderr), file=sys.stderr
        )
        print(f"{task_id}\t{rel_task_path}")
        return

    content = render_task_file(
        task_id=task_id,
        title=title,
        status=status,
        problem=problem,
        cost=cost,
        goal=goal,
        criteria=criteria,
        sketch=sketch,
        constraints=constraints,
        outcome=outcome,
        findings=findings,
        next_steps=next_steps,
        conv=conv_uri,
        wait_for=norm_wait_for or None,
        due=due,
        stale_after=stale_after,
        blocked_by=deps or None,
        conversations=extra_convs or None,
    )
    create_task(snap, project_name, rel_task_path, content)

    # Machine-readable output contract on stdout
    print(f"{task_id}\t{rel_task_path}")

    if no_commit:
        return

    if not has_commit_auth(root):
        print(
            _tagged(
                "[INFO]  Skipping commit: repository lacks authorized <!-- taskgo:allow-local-commits -->",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        return

    # Stage task file, STATUS.md, and optionally new scaffolding files
    to_stage = [rel_task_path, f"{project_name}/STATUS.md"]
    if is_new_project:
        rel_readme = f"{project_name}/README.md"
        if (root / rel_readme).is_file():
            to_stage.append(rel_readme)

    run_git(["add", "--", *to_stage])

    subject = conventional_subject(f"create {task_id}", project_name)

    msg_lines = [subject, "", wrap_body(title)]
    if conv_uri:
        msg_lines.extend(["", f"Conversation: {conv_uri}"])
    commit_msg = "\n".join(msg_lines) + "\n"

    run_git(["commit", "--no-verify", "--no-gpg-sign", "-m", commit_msg])
    commit_sha = run_git(["rev-parse", "HEAD"]).stdout.strip()
    print(
        _tagged(f"[INFO]  Committed new task: {commit_sha[:10]}", sys.stderr),
        file=sys.stderr,
    )


def edit_task_text(
    snap: Snapshot,
    rel_path: str,
    content: str,
    status: str | None = None,
    title: str | None = None,
    problem: str | None = None,
    cost: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
    wait_for: list[str] | None = None,
    due: str | None = None,
    stale_after: str | None = None,
    expect_status: str | None = None,
    add_blocked_by: list[str] | None = None,
    remove_blocked_by: list[str] | None = None,
    add_wait_for: list[str] | None = None,
    remove_wait_for: list[str] | None = None,
    add_conversations: list[str] | None = None,
    remove_conversations: list[str] | None = None,
) -> tuple[str, list[str]]:
    """Applies field and section edits to the task text CONTENT at REL_PATH.

    Returns the edited, unformatted text and any warnings. SNAP is read only
    to check added blockers against the other tasks.
    """
    warnings: list[str] = []
    data, body = parse_frontmatter_for_edit(content)

    if expect_status is not None:
        expected = require_status(expect_status, "--expect-status")
        current = next(
            (str(v) for k, v in data.items() if str(k).lower() == "status"), ""
        )
        if canonical_status(current) != expected:
            die_scoped(
                f"{rel_path}: status is '{current}', expected '{expected}'; "
                "nothing changed"
            )

    if status:
        norm_status = require_status(status, "--status")
        status_key = next((k for k in data if str(k).lower() == "status"), "status")
        data[status_key] = norm_status

    if wait_for is not None:
        if len(wait_for) == 1 and not wait_for[0].strip():
            for k in [k for k in list(data.keys()) if str(k).lower() == "wait_for"]:
                data.pop(k, None)
        else:
            items = normalize_wait_for_args(wait_for)
            require_field_values(TASK_SCHEMA.field("wait_for"), items, "--wait-for")
            wf_key = next((k for k in data if str(k).lower() == "wait_for"), "wait_for")
            data[wf_key] = [parse_iso_date(w) or w for w in items]

    if due is not None:
        if not due.strip():
            for k in [k for k in list(data.keys()) if str(k).lower() == "due"]:
                data.pop(k, None)
        else:
            parsed_due = parse_iso_date(due)
            if parsed_due is None:
                die_scoped(f"invalid ISO date for --due (expected YYYY-MM-DD): {due}")
            due_key = next((k for k in data if str(k).lower() == "due"), "due")
            data[due_key] = parsed_due

    if stale_after is not None:
        if not stale_after.strip():
            for k in [k for k in list(data.keys()) if str(k).lower() == "stale_after"]:
                data.pop(k, None)
        else:
            parsed_stale = parse_iso_date(stale_after)
            if parsed_stale is None:
                die_scoped(
                    f"invalid ISO date for --stale-after (expected YYYY-MM-DD): {stale_after}"
                )
            sa_key = next(
                (k for k in data if str(k).lower() == "stale_after"), "stale_after"
            )
            data[sa_key] = parsed_stale

    own_id = next((str(v) for k, v in data.items() if str(k).lower() == "id"), None)
    wait_spec = TASK_SCHEMA.field("wait_for")
    if add_wait_for or remove_wait_for:
        adds = split_field_values(add_wait_for or [], wait_spec)
        require_field_values(wait_spec, adds, "--add-wait-for")
        edit_set_field(
            data, wait_spec, adds, split_field_values(remove_wait_for or [], wait_spec)
        )

    blocked_spec = TASK_SCHEMA.field("blocked_by")
    if add_blocked_by or remove_blocked_by:
        adds = split_field_values(add_blocked_by or [], blocked_spec)
        require_field_values(blocked_spec, adds, "--add-blocked-by")
        removes = split_field_values(remove_blocked_by or [], blocked_spec)
        edit_set_field(data, blocked_spec, adds, removes)
        deps = parse_blocked_by({str(k).lower(): v for k, v in data.items()})
        check_new_blockers(snap, own_id, adds, deps)

    conv_spec = TASK_SCHEMA.field("conversations")
    for entry in split_field_values(remove_conversations or [], conv_spec):
        parsed = parse_conversation_entry(entry)
        remove_task_conversation(data, parsed[1] if parsed else entry)
    for entry in split_field_values(add_conversations or [], conv_spec):
        added = normalize_conversation_id(entry)
        if added:
            update_task_conversation(data, *added)

    session = normalize_conversation_id(conv) if conv else None
    if session:
        scheme, c_id = session
        update_task_conversation(data, scheme, c_id)

    fm_text = dump_frontmatter(data)

    if title:
        body = re.sub(r"^#\s+[^\n]+", f"# {title}", body, count=1, flags=re.MULTILINE)

    def upsert_runin(body_str: str, label: str, val: str) -> str:
        block = "\n" in val or val.strip().startswith("1.")
        replacement = f"**{label}:**\n\n{val}" if block else f"**{label}:** {val}"
        spans = find_runins(body_str, label)
        if len(spans) > 1:
            die_scoped(
                f"{rel_path}: **{label}:** appears {len(spans)} times; "
                "edit the task file directly"
            )
        if not spans:
            return body_str.rstrip() + f"\n\n{replacement}\n"
        start, end = spans[0]
        before, after = body_str[:start], body_str[end:]
        # Give the edited run-in its own paragraph, as 'create' lays it out,
        # when mdformat has reflowed it into a paragraph with its neighbours.
        if before.strip() and not before.endswith("\n\n"):
            before = before.rstrip() + "\n\n"
        if after.strip() and not after.startswith("\n\n"):
            after = "\n\n" + after.lstrip()
        return before + replacement + after

    def upsert_section(body_str: str, heading: str, val: str) -> str:
        replacement = f"## {heading}\n\n{val}"
        spans, similar = find_sections(body_str, heading)
        if len(spans) > 1:
            die_scoped(
                f"{rel_path}: '## {heading}' appears {len(spans)} times; "
                "edit the task file directly"
            )
        if not spans:
            if similar:
                warnings.append(
                    f"{rel_path}: no '## {heading}' section; "
                    f"appending one (similar: {', '.join(similar)})"
                )
            return body_str.rstrip() + f"\n\n{replacement}\n"
        start, end = spans[0]
        return body_str[:start] + replacement + body_str[end:]

    if problem:
        body = upsert_runin(body, "Problem", problem)
    if cost:
        body = upsert_runin(body, "Cost", cost)
    if goal:
        body = upsert_runin(body, "Goal", goal)
    if criteria:
        body = upsert_runin(body, "Criteria", criteria)
    if sketch:
        body = upsert_runin(body, "Sketch", sketch)
    if constraints:
        body = upsert_runin(body, "Constraints", constraints)
    if outcome:
        body = upsert_section(body, "Outcome", outcome)
    if findings:
        body = upsert_section(body, "Findings", findings)
    if next_steps:
        body = upsert_section(body, "Next", next_steps)

    return fm_text + "\n" + body.lstrip(), warnings


@dataclass(slots=True, frozen=True)
class TaskUpdate:
    task_id: str
    rel_path: str
    renamed_from: str | None
    warnings: tuple[str, ...]


def update_task(
    snap: Snapshot,
    rel_path: str,
    new_slug: str | None = None,
    fallback_id: str | None = None,
    **edits: Any,
) -> TaskUpdate:
    """Edits the task at REL_PATH in SNAP, renames it, and syncs its STATUS.md.

    EDITS are edit_task_text's keyword arguments. FALLBACK_ID names the task
    in the result when its frontmatter has no ID.
    """
    project_name = rel_path.split("/", maxsplit=1)[0]
    try:
        content = snap.read_text(rel_path)
    except OSError as e:
        die(f"cannot read task file {rel_path}: {e}")
    new_content, warnings = edit_task_text(snap, rel_path, content, **edits)
    if lacks_required_outcome(content, new_content):
        die_scoped(
            f"{rel_path}: a done task needs an Outcome: pass --outcome with a "
            "verdict against each criterion; nothing changed"
        )
    snap.write_markdown(rel_path, new_content)

    data, _ = parse_frontmatter_for_edit(new_content)
    task_id_val = next(
        (str(v) for k, v in data.items() if str(k).lower() == "id"),
        fallback_id or rel_path,
    )

    renamed_from = None
    if new_slug is not None:
        prefix = task_id_val if ID_PATTERN.match(task_id_val) else ""
        new_name = f"{prefix}-{new_slug}.md" if prefix else f"{new_slug}.md"
        new_rel = join_rel(rel_path.rsplit("/", 1)[0], new_name)
        if new_rel != rel_path:
            if snap.exists(new_rel):
                die_scoped(f"cannot rename {rel_path}: {new_name} already exists")
            snap.rename(rel_path, new_rel)
            renamed_from, rel_path = rel_path, new_rel

    sync_status(snap, project_name)
    return TaskUpdate(task_id_val, rel_path, renamed_from, tuple(warnings))


def cmd_update(
    query: str,
    status: str | None = None,
    title: str | None = None,
    slug: str | None = None,
    problem: str | None = None,
    cost: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
    wait_for: list[str] | None = None,
    due: str | None = None,
    stale_after: str | None = None,
    expect_status: str | None = None,
    add_blocked_by: list[str] | None = None,
    remove_blocked_by: list[str] | None = None,
    add_wait_for: list[str] | None = None,
    remove_wait_for: list[str] | None = None,
    add_conversations: list[str] | None = None,
    remove_conversations: list[str] | None = None,
) -> None:
    """Update task fields, status, or headings."""
    new_slug: str | None = None
    if slug is not None:
        new_slug = normalize_slug(slug)
        if not new_slug:
            die_scoped(f"--slug contains no usable characters: {slug}")
        if len(new_slug) > SLUG_MAX_LEN:
            die_scoped(
                f"--slug too long ({len(new_slug)} > {SLUG_MAX_LEN} chars): {new_slug}"
            )

    root = get_repo_root()
    target_path = resolve_target(root, query)
    result = update_task(
        FsSnapshot(root),
        target_path.relative_to(root).as_posix(),
        new_slug=new_slug,
        fallback_id=query,
        status=status,
        title=title,
        problem=problem,
        cost=cost,
        goal=goal,
        criteria=criteria,
        sketch=sketch,
        constraints=constraints,
        outcome=outcome,
        findings=findings,
        next_steps=next_steps,
        conv=conv,
        wait_for=wait_for,
        due=due,
        stale_after=stale_after,
        expect_status=expect_status,
        add_blocked_by=add_blocked_by,
        remove_blocked_by=remove_blocked_by,
        add_wait_for=add_wait_for,
        remove_wait_for=remove_wait_for,
        add_conversations=add_conversations,
        remove_conversations=remove_conversations,
    )
    for warning in result.warnings:
        print(_tagged(f"[WARN]  {warning}", sys.stderr), file=sys.stderr)
    if result.renamed_from:
        print(
            _tagged(
                f"[INFO]  Renamed {result.renamed_from} -> {result.rel_path}",
                sys.stderr,
            ),
            file=sys.stderr,
        )
    print(
        _tagged(f"[INFO]  Updated {result.task_id} in {result.rel_path}", sys.stderr),
        file=sys.stderr,
    )


# ===========================================================================
# Change sets: typed, atomic writes (taskgo apply; the MCP server's writes)
# ===========================================================================

WRITE_FILE_MAX_BYTES = 256 * 1024
CHANGE_OPS = (
    "create",
    "set",
    "add",
    "remove",
    "replace_section",
    "write_file",
    "delete_file",
    "edit_file",
)
# Scalars `set` may change, per record kind; title is the record's H1.
SETTABLE = {
    "task": ("status", "due", "stale_after", "title"),
    "decision": ("status",),
}


class ChangeSetError(Exception):
    """A change set refused before anything was written.

    KIND is 'invalid' (a malformed or disallowed change), 'precondition' (an
    expected value, section hash, or blob SHA that no longer holds), or
    'validation' (the state after the whole set breaks a rule).
    """

    def __init__(
        self,
        message: str,
        kind: Literal["invalid", "precondition", "validation"] = "invalid",
    ):
        super().__init__(message)
        self.kind = kind


def git_blob_sha(data: bytes) -> str:
    """The Git blob SHA-1 of DATA, as 'git hash-object' computes it."""
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


@dataclass(slots=True, frozen=True)
class AppliedEdit:
    """One applied edit_file replacement before final Markdown formatting."""

    path: str
    occurrences_replaced: int
    start_line: int
    end_line: int
    pre_format: str


@dataclass(slots=True)
class ChangeSet:
    """A change set being applied over an overlay of the repository."""

    snap: OverlaySnapshot
    # 'ref' names from create, mapped to the task ID or decision path.
    refs: dict[str, str]
    created: list[dict[str, str]]
    # Text of each controlled record before the set touched it; None: new.
    before: dict[str, str | None]
    # (record path, value) pairs added to blocked_by or supersedes.
    added_refs: list[tuple[str, str]]
    # Records edit_file wrote verbatim, formatted once the set has applied.
    unformatted: set[str] = dataclass_field(default_factory=set)
    # What each edit_file did, in order, for the result.
    edits: list[AppliedEdit] = dataclass_field(default_factory=list)

    def touch(self, rel: str) -> None:
        if rel not in self.before:
            self.before[rel] = (
                self.snap.base.read_text(rel) if self.snap.base.is_file(rel) else None
            )


def change_keys(change: dict[str, Any], required: tuple[str, ...], optional=()) -> None:
    missing = [k for k in required if k not in change]
    if missing:
        raise ChangeSetError(f"missing {', '.join(missing)}")
    unknown = sorted(set(change) - {"op", *required, *optional})
    if unknown:
        raise ChangeSetError(f"unknown key {', '.join(unknown)}")


def change_str(value: Any, what: str, nullable: bool = False) -> str | None:
    if value is None and nullable:
        return None
    if not isinstance(value, str):
        raise ChangeSetError(f"{what} must be a string{' or null' if nullable else ''}")
    return value


def change_line(value: Any, what: str) -> str:
    text = str(change_str(value, what)).strip()
    if not text or "\n" in text:
        raise ChangeSetError(f"{what} must be one non-empty line")
    return text


def change_list(value: Any, what: str) -> list[str]:
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        raise ChangeSetError(f"{what} must be a list of strings")
    return value


def resolve_ref(cs: ChangeSet, token: str) -> str:
    """The task ID or decision path that a '$name' TOKEN names; else TOKEN."""
    if not token.startswith("$"):
        return token
    if token[1:] not in cs.refs:
        raise ChangeSetError(f"unknown ref {token} (refs name earlier creates)")
    return cs.refs[token[1:]]


def trim_boundary_path(path: str) -> str:
    """Trims surrounding whitespace and leading/trailing '/' on boundary inputs."""
    return path.strip().strip("/")


def clean_rel_path(
    path: Any, *, allow_empty: bool = False, strip_slashes: bool = True
) -> str:
    """Validated repository-relative POSIX path, or raises TaskgoError.

    Rejects empty components, '.', '..', backslashes, newlines, and a root
    '.git*' directory. With STRIP_SLASHES, leading and trailing '/' are trimmed
    first (as CLI and MCP boundary inputs allow); with ALLOW_EMPTY, '' is valid.
    """
    if not isinstance(path, str):
        raise TaskgoError(f"path must be a string, not {path!r}")
    rel = trim_boundary_path(path) if strip_slashes else path.strip()
    if not rel:
        if allow_empty:
            return ""
        raise TaskgoError(f"invalid path: {path!r}")
    parts = rel.split("/")
    if "\\" in rel or "\n" in rel or any(p in ("", ".", "..") for p in parts):
        raise TaskgoError(f"invalid path: {path!r}")
    if parts[0].startswith(".git"):
        raise TaskgoError(f"invalid path: {path!r}")
    return rel


def resolve_commit(root: Path, rev: str) -> str | None:
    """Full commit SHA for REV in repository ROOT, or None if not a commit."""
    res = run_git(
        ["rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}"],
        cwd=root,
        check=False,
    )
    return res.stdout.strip() if res.returncode == 0 else None


def remap_line_span(
    before_text: str, after_text: str, start: int, end: int
) -> tuple[int, int]:
    """Maps 1-indexed inclusive lines [START..END] from BEFORE_TEXT to AFTER_TEXT."""
    if before_text == after_text:
        return start, end
    import difflib

    before_lines = before_text.splitlines()
    after_lines = after_text.splitlines()
    a0, a1 = max(0, start - 1), max(start, end)
    out_start: int | None = None
    out_end: int | None = None
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(
        None, before_lines, after_lines, autojunk=False
    ).get_opcodes():
        if i2 <= a0 or i1 >= a1:
            continue
        if tag == "equal":
            s = j1 + max(0, a0 - i1)
            e = j1 + min(i2, a1) - i1
        else:
            s, e = j1, j2
        if out_start is None:
            out_start = s
        out_end = max(s, e)
    if out_start is None or out_end is None:
        return start, end
    s_line = out_start + 1
    return s_line, max(s_line, out_end)


def check_record_path(snap: Snapshot, rel: str) -> str:
    """REL, if it names a record inside a project: no '..', '.', or empty
    component, no backslash, and no symbolic link on the way, so a write
    cannot leave the control repository."""
    try:
        clean_rel_path(rel, strip_slashes=False)
    except TaskgoError:
        raise ChangeSetError(f"invalid path {rel!r}") from None
    parts = rel.split("/")
    if not is_project(snap, parts[0]):
        raise ChangeSetError(f"{rel}: {parts[0]!r} is not a project")
    if snap.is_link(rel):
        raise ChangeSetError(f"{rel} is or is under a symbolic link")
    return rel


def find_record(cs: ChangeSet, record: Any) -> tuple[str, RecordSchema]:
    """The path and schema of RECORD: a task ID, a '$ref', or a path."""
    token = resolve_ref(cs, change_line(record, "record"))
    if ID_PATTERN.match(token.upper()):
        task_id = token.upper()
        paths = [r.rel_path for r in get_task_rows(cs.snap) if r.task_id == task_id]
        if not paths:
            raise ChangeSetError(f"no task {task_id}")
        if len(paths) > 1:
            raise ChangeSetError(f"{task_id} names {len(paths)} records")
        return check_record_path(cs.snap, paths[0]), TASK_SCHEMA
    parts = token.split("/")
    if len(parts) == 2 and parts[1] == "STATUS.md":
        return check_record_path(cs.snap, token), STATUS_SCHEMA
    if len(parts) == 3 and parts[1] == "decisions" and token.endswith(".md"):
        check_record_path(cs.snap, token)
        if not cs.snap.is_file(token):
            raise ChangeSetError(f"no decision {token}")
        return token, DECISION_SCHEMA
    raise ChangeSetError(
        f"record {token!r} is not a task ID, a '$ref', a decision path, "
        "or a project's STATUS.md"
    )


def split_record(text: str) -> tuple[Any, str]:
    """Editable frontmatter (empty when absent) and body of a record."""
    match = re.search(r"^---\r?\n(.*?)\r?\n---(?:\r?\n|$)", text, re.DOTALL)
    if not match:
        if re.match(r"^---\r?\n", text):
            raise ChangeSetError("frontmatter is not closed")
        return YAML().load("{}"), text
    try:
        data = YAML().load(match.group(1))
    except Exception as e:
        raise ChangeSetError(f"cannot parse its frontmatter: {e}") from None
    if not isinstance(data, dict):
        raise ChangeSetError("its frontmatter is not a YAML mapping")
    return data, text[match.end() :]


def join_record(data: Any, body: str) -> str:
    return (dump_frontmatter(data) + "\n" if data else "") + body.lstrip()


def fm_key(data: Any, name: str) -> Any:
    return next((k for k in data if str(k).lower() == name), name)


def resolve_values(
    cs: ChangeSet, spec: FieldSpec, values: list[str], rel: str | None
) -> list[str]:
    """Checks set-field VALUES and resolves '$ref' entries in them."""
    out: list[str] = []
    for raw in values:
        value = raw.strip()
        if spec.value in ("task-id", "adr-ref"):
            value = resolve_ref(cs, value)
        if spec.value == "task-id":
            value = value.upper()
        if spec.value == "adr-ref":
            value = value.rsplit("/", 1)[-1].removesuffix(".md")
        if spec.value == "conversation" and "://" not in value:
            raise ChangeSetError(
                f"conversation {value!r} needs a scheme, as <agent>://<id>"
            )
        if not field_is_valid(spec, value):
            raise ChangeSetError(
                f"invalid {spec.name} value {raw!r} "
                f"(expected {VALUE_TYPES[spec.value].description})"
            )
        if rel and spec.name in ("blocked_by", "supersedes"):
            cs.added_refs.append((rel, value))
        out.append(value)
    return list(dict.fromkeys(out))


def create_task_change(cs: ChangeSet, change: dict[str, Any], project: str) -> str:
    fields = change.get("fields") or {}
    sections = change.get("sections") or {}
    if not isinstance(fields, dict) or not isinstance(sections, dict):
        raise ChangeSetError("fields and sections must be objects")
    settable = {"status", "due", "stale_after"} | {
        f.name for f in TASK_SCHEMA.set_fields()
    }
    unknown = sorted(set(fields) - settable)
    if unknown:
        raise ChangeSetError(f"unknown task field {', '.join(unknown)}")
    writable = {s.name for s in TASK_SCHEMA.sections}
    unknown = sorted(set(sections) - writable)
    if unknown:
        raise ChangeSetError(f"unknown task section {', '.join(unknown)}")
    title = change_line(sections.get("title"), "sections.title")
    status = canonical_status(change_str(fields.get("status", "todo"), "status"))
    if status is None:
        raise ChangeSetError(f"unknown status {fields.get('status')!r}")
    dates: dict[str, str | None] = {}
    for name in ("due", "stale_after"):
        value = change_str(fields.get(name), name, nullable=True)
        if value is not None and parse_iso_date(value) is None:
            raise ChangeSetError(f"{name} must be YYYY-MM-DD: {value!r}")
        dates[name] = value
    sets: dict[str, list[str]] = {}
    for spec in TASK_SCHEMA.set_fields():
        values = change_list(fields.get(spec.name, []), spec.name)
        sets[spec.name] = resolve_values(cs, spec, values, None)
    texts = {
        name: change_str(text, f"sections.{name}")
        for name, text in sections.items()
        if name != "title"
    }
    if "slug" in change:
        slug = normalize_slug(str(change_str(change["slug"], "slug")))
        if not slug or len(slug) > SLUG_MAX_LEN:
            raise ChangeSetError(f"slug must give 1 to {SLUG_MAX_LEN} characters")
    else:
        slug = slugify(title) or "task"

    task_id = generate_task_id(cs.snap)
    rel = check_record_path(cs.snap, f"{project}/tasks/{task_id}-{slug}.md")
    content = render_task_file(
        task_id=task_id,
        title=title,
        status=status,
        problem=texts.get("Problem"),
        cost=texts.get("Cost"),
        goal=texts.get("Goal"),
        criteria=texts.get("Criteria"),
        sketch=texts.get("Sketch"),
        constraints=texts.get("Constraints"),
        outcome=texts.get("Outcome"),
        findings=texts.get("Findings"),
        next_steps=texts.get("Next"),
        wait_for=sets["wait_for"],
        due=dates["due"],
        stale_after=dates["stale_after"],
        blocked_by=sets["blocked_by"],
        conversations=sets["conversations"],
    )
    cs.touch(rel)
    cs.snap.write_markdown(rel, content)
    cs.added_refs.extend((rel, dep) for dep in sets["blocked_by"])
    cs.created.append({"kind": "task", "id": task_id, "path": rel})
    return task_id


def create_decision_change(cs: ChangeSet, change: dict[str, Any], project: str) -> str:
    fields = change.get("fields") or {}
    sections = change.get("sections") or {}
    if not isinstance(fields, dict) or not isinstance(sections, dict):
        raise ChangeSetError("fields and sections must be objects")
    unknown = sorted(set(fields) - {f.name for f in DECISION_SCHEMA.fields})
    if unknown:
        raise ChangeSetError(f"unknown decision field {', '.join(unknown)}")
    names = [s.name for s in DECISION_SCHEMA.sections]
    unknown = sorted(set(sections) - set(names))
    if unknown:
        raise ChangeSetError(f"unknown decision section {', '.join(unknown)}")
    title = change_line(sections.get("title"), "sections.title")
    sections = {"Status": "Accepted", **sections}
    missing = [n for n in names if n != "title" and not sections.get(n)]
    if missing:
        raise ChangeSetError(f"missing decision section {', '.join(missing)}")
    supersedes = resolve_values(
        cs,
        DECISION_SCHEMA.field("supersedes"),
        change_list(fields.get("supersedes", []), "supersedes"),
        None,
    )
    status = change_str(fields.get("status"), "status", nullable=True)
    if "slug" in change:
        slug = normalize_slug(str(change_str(change["slug"], "slug")))
        if not slug or len(slug) > SLUG_MAX_LEN:
            raise ChangeSetError(f"slug must give 1 to {SLUG_MAX_LEN} characters")
    else:
        slug = slugify(title) or "decision"

    numbers = [
        int(m.group(1))
        for name in cs.snap.list_dir(f"{project}/decisions")
        if (m := re.match(r"^(\d+)-", name))
    ]
    number = max(numbers, default=0) + 1
    rel = check_record_path(cs.snap, f"{project}/decisions/{number:03d}-{slug}.md")
    data: dict[str, Any] = {}
    if status:
        data["status"] = status
    if supersedes:
        seq = CommentedSeq(supersedes)
        seq.fa.set_flow_style()
        data["supersedes"] = seq
    body = "\n\n".join(
        [f"# {number}. {title}"]
        + [f"## {n}\n\n{str(sections[n]).strip()}" for n in names if n != "title"]
    )
    cs.touch(rel)
    cs.snap.write_markdown(rel, (dump_frontmatter(data) + "\n" if data else "") + body)
    cs.added_refs.extend((rel, s) for s in supersedes)
    cs.created.append({"kind": "decision", "path": rel})
    return rel


def apply_create(cs: ChangeSet, change: dict[str, Any]) -> None:
    change_keys(change, ("kind", "project"), ("ref", "slug", "fields", "sections"))
    kind = change["kind"]
    project = change_line(change["project"], "project")
    if "/" in project or project.startswith(".") or not is_project(cs.snap, project):
        raise ChangeSetError(
            f"unknown project {project!r} (new projects are created locally)"
        )
    ref = change.get("ref")
    if ref is not None:
        ref = change_line(ref, "ref").removeprefix("$")
        if ref in cs.refs:
            raise ChangeSetError(f"ref ${ref} is already defined")
    if kind == "task":
        target = create_task_change(cs, change, project)
    elif kind == "decision":
        target = create_decision_change(cs, change, project)
    else:
        raise ChangeSetError(f"kind must be 'task' or 'decision', not {kind!r}")
    if ref is not None:
        cs.refs[ref] = target
        cs.created[-1]["ref"] = ref


def current_scalar(data: Any, body: str, field: str) -> str | None:
    if field == "title":
        return extract_title_from_body(body) or None
    raw = next((v for k, v in data.items() if str(k).lower() == field), None)
    if raw in (None, ""):
        return None
    if isinstance(raw, (date, datetime)):
        return parse_iso_date(raw).isoformat()  # type: ignore[union-attr]
    return str(raw)


def apply_set(cs: ChangeSet, change: dict[str, Any]) -> None:
    change_keys(change, ("record", "field", "value"), ("expected",))
    rel, schema = find_record(cs, change["record"])
    field = change_str(change["field"], "field")
    if field not in SETTABLE.get(schema.kind, ()):
        raise ChangeSetError(f"cannot set {field!r} on a {schema.kind}")
    data, body = split_record(cs.snap.read_text(rel))
    current = current_scalar(data, body, str(field))
    is_task_status = schema.kind == "task" and field == "status"
    if is_task_status and current is not None:
        current = canonical_status(current) or current
    if "expected" in change:
        expected = change_str(change["expected"], "expected", nullable=True)
        if is_task_status and expected is not None:
            expected = canonical_status(expected) or expected
        if expected != current:
            raise ChangeSetError(
                f"{rel}: {field} is {current!r}, expected {expected!r}",
                "precondition",
            )
    value = change_str(change["value"], "value", nullable=field != "title")
    if field == "title":
        value = change_line(value, "value")
        spans = section_spans(body, TASK_SCHEMA.sections[0])
        if spans:
            a, b = spans[0]
            body = f"{body[:a]}# {value}{body[b:]}"
        else:
            body = f"# {value}\n\n{body}"
    elif value is None:
        data.pop(fm_key(data, field), None)
    elif is_task_status:
        status = canonical_status(value)
        if status is None:
            raise ChangeSetError(f"unknown status {value!r}")
        data[fm_key(data, field)] = status
    elif field in ("due", "stale_after"):
        parsed = parse_iso_date(value)
        if parsed is None:
            raise ChangeSetError(f"{field} must be YYYY-MM-DD: {value!r}")
        data[fm_key(data, field)] = parsed
    else:
        data[fm_key(data, field)] = value
    cs.touch(rel)
    cs.snap.write_markdown(rel, join_record(data, body))


def apply_add_remove(cs: ChangeSet, change: dict[str, Any]) -> None:
    change_keys(change, ("record", "field", "values"))
    op = change["op"]
    rel, schema = find_record(cs, change["record"])
    field = change_str(change["field"], "field")
    spec = next((f for f in schema.set_fields() if f.name == field), None)
    if spec is None:
        raise ChangeSetError(f"{field!r} is not a set field of a {schema.kind}")
    values = change_list(change["values"], "values")
    values = resolve_values(cs, spec, values, rel if op == "add" else None)
    data, body = split_record(cs.snap.read_text(rel))
    if spec.name == "blocked_by" and op == "add":
        own = str(data.get(fm_key(data, "id"), "")).upper()
        if own in values:
            raise ChangeSetError(f"{own} cannot be blocked by itself")
    if spec.name == "conversations":
        for value in values:
            scheme, conv_id = parse_conversation_entry(value)  # type: ignore[misc]
            if op == "add":
                update_task_conversation(data, scheme, conv_id)
            else:
                remove_task_conversation(data, conv_id)
    elif op == "add":
        edit_set_field(data, spec, values, [], schema)
    else:
        edit_set_field(data, spec, [], values, schema)
    cs.touch(rel)
    cs.snap.write_markdown(rel, join_record(data, body))


def section_counts(body: str, schema: RecordSchema) -> dict[str, int]:
    return {s.name: len(section_spans(body, s)) for s in schema.sections}


def apply_replace_section(cs: ChangeSet, change: dict[str, Any]) -> None:
    change_keys(change, ("record", "section", "text", "expected_hash"))
    rel, schema = find_record(cs, change["record"])
    name = change_str(change["section"], "section")
    spec = next((s for s in schema.sections if s.name == name), None)
    if (
        spec is None
        or spec.form in ("title", "generated")
        or schema.kind == "decision"
        or not spec.writable
    ):
        raise ChangeSetError(f"cannot replace section {name!r} of a {schema.kind}")
    text = change_str(change["text"], "text", nullable=True)
    expected = change_str(change["expected_hash"], "expected_hash", nullable=True)
    if text is not None and (BEGIN in text or END in text):
        raise ChangeSetError("text must not contain the generated block markers")
    data, body = split_record(cs.snap.read_text(rel))
    spans = section_spans(body, spec)
    if len(spans) > 1:
        raise ChangeSetError(
            f"{rel}: {name} appears {len(spans)} times; edit the file directly"
        )
    current = section_hash(body[slice(*spans[0])]) if spans else None
    if expected != current:
        raise ChangeSetError(
            f"{rel}: {name} has hash {current or 'none (absent)'}, "
            f"expected {expected or 'none (absent)'}",
            "precondition",
        )
    if text is None and spec.required:
        raise ChangeSetError(f"{name} is required in a {schema.kind}")

    replacement = None
    if text is not None:
        text = text.strip()
        if spec.form == "run-in":
            block = "\n" in text or text.startswith("1.")
            label = f"**{name}:**"
            replacement = f"{label}\n\n{text}" if block else f"{label} {text}".strip()
        else:
            replacement = f"## {name}\n\n{text}".strip()
    if spans:
        a, b = spans[0]
    else:
        # Before the first section the schema lists after this one.
        later = schema.sections[schema.sections.index(spec) + 1 :]
        starts = [
            found[0][0]
            for s in later
            if s.form != "title" and (found := section_spans(body, s))
        ]
        a = b = min(starts, default=len(body.rstrip()))
    before, after = body[:a].rstrip(), body[b:].lstrip()
    parts = [p for p in (before, replacement, after) if p]
    new_body = "\n\n".join(parts) + "\n"

    expected_counts = section_counts(body, schema)
    expected_counts[name] = 0 if replacement is None else 1
    if section_counts(format_markdown(new_body), schema) != expected_counts:
        raise ChangeSetError(
            f"text for {name} would add or remove other sections of {rel}"
        )
    cs.touch(rel)
    cs.snap.write_markdown(rel, join_record(data, new_body))


def check_asset_path(snap: Snapshot, path: Any) -> str:
    """REL, if write_file, delete_file, or edit_file may change it: a project
    asset or INBOX.md. An executable file is an asset like any other; writes
    keep its mode unless write_file's 'executable' says otherwise.
    """
    rel = change_line(path, "path")
    parts = rel.split("/")
    if "\\" in rel or any(p in ("", ".", "..") for p in parts):
        raise ChangeSetError(f"invalid path {rel!r}")
    if any(p.startswith(".git") for p in parts):
        raise ChangeSetError(f"{rel}: Git files are not writable")
    if rel != "INBOX.md":
        if len(parts) < 2 or not is_project(snap, parts[0]):
            raise ChangeSetError(
                f"{rel}: only files in an existing project, and INBOX.md, are writable"
            )
        if parts[1] in ("tasks", "decisions") or parts[1:] == ["STATUS.md"]:
            raise ChangeSetError(
                f"{rel} is controlled state; change it with typed operations"
            )
    if snap.is_link(rel):
        raise ChangeSetError(f"{rel} is or is under a symbolic link")
    if snap.is_dir(rel):
        raise ChangeSetError(f"{rel} is a directory")
    if any(snap.is_file("/".join(parts[:i])) for i in range(1, len(parts))):
        raise ChangeSetError(f"{rel}: a parent of it is a file")
    return rel


def asset_blob(cs: ChangeSet, rel: str) -> str | None:
    """The blob SHA of asset REL as the change set has it, or None if absent."""
    if not cs.snap.is_file(rel):
        return None
    try:
        return git_blob_sha(cs.snap.read_text(rel).encode("utf-8"))
    except UnicodeDecodeError:
        raise ChangeSetError(f"{rel} is not UTF-8 text") from None


def is_project_readme(rel: str) -> bool:
    parts = rel.split("/")
    return len(parts) == 2 and parts[1] in ("README.md", "PROJECT.md")


def check_readme_frontmatter(rel: str, content: str) -> None:
    """Refuses malformed YAML frontmatter in a project README.md or PROJECT.md."""
    if is_project_readme(rel) and re.match(r"^---\r?\n", content):
        try:
            split_record(content)
        except ChangeSetError as e:
            raise ChangeSetError(f"{rel}: {e}") from None


def apply_write_file(cs: ChangeSet, change: dict[str, Any]) -> None:
    """Write a whole asset. Without expected_blob (or with null) the file
    must not exist yet; to overwrite, expected_blob names its current blob,
    so a write never loses one made since the caller read the file.
    """
    change_keys(change, ("path", "content"), ("expected_blob", "executable"))
    rel = check_asset_path(cs.snap, change["path"])
    if change["content"] is None:
        raise ChangeSetError(
            f"{rel}: content must be a string; delete a file with delete_file"
        )
    content = change_str(change["content"], "content")
    expected = change_str(change.get("expected_blob"), "expected_blob", nullable=True)
    executable = change.get("executable")
    if executable is not None and not isinstance(executable, bool):
        raise ChangeSetError("executable must be true, false, or null")
    current = asset_blob(cs, rel)
    if expected is None and current is not None:
        raise ChangeSetError(
            f"{rel} already exists (blob {current}); pass that as expected_blob "
            "to overwrite it, or use edit_file",
            "precondition",
        )
    if (expected or "").lower() != (current or ""):
        raise ChangeSetError(
            f"{rel}: blob is {current or 'none (absent)'}, expected {expected}",
            "precondition",
        )
    try:
        size = len(content.encode("utf-8"))
    except UnicodeEncodeError:
        raise ChangeSetError(f"{rel}: content is not valid UTF-8") from None
    if size > WRITE_FILE_MAX_BYTES:
        raise ChangeSetError(
            f"{rel}: content is {size} bytes; the limit is {WRITE_FILE_MAX_BYTES}"
        )
    check_readme_frontmatter(rel, content)
    if rel.endswith(".md"):
        cs.snap.write_markdown(rel, content)
    else:
        cs.snap.write_text(rel, content)
    if executable is not None:
        cs.snap.set_executable(rel, executable)


def apply_delete_file(cs: ChangeSet, change: dict[str, Any]) -> None:
    """Delete an asset whose current blob is expected_blob."""
    change_keys(change, ("path", "expected_blob"))
    rel = check_asset_path(cs.snap, change["path"])
    expected = change_str(change["expected_blob"], "expected_blob")
    if is_project_readme(rel):
        raise ChangeSetError(f"{rel} defines its project; it cannot be deleted")
    current = asset_blob(cs, rel)
    if current is None:
        raise ChangeSetError(f"{rel}: no such file", "precondition")
    if expected.lower() != current:
        raise ChangeSetError(
            f"{rel}: blob is {current}, expected {expected}", "precondition"
        )
    cs.snap.delete(rel)


def count_lines(text: str) -> int:
    """Lines in TEXT, each ended by '\\n' (the last perhaps by the end)."""
    return text.count("\n") + (1 if text and not text.endswith("\n") else 0)


# Files with more lines than this get no near-miss hint from edit_file.
EDIT_HINT_MAX_LINES = 2000


def edit_near_miss(content: str, old: str) -> str:
    """A unified diff of OLD against the closest lines of CONTENT, or ''.

    The anchor is the line of CONTENT closest to OLD's first non-blank line,
    compared without surrounding whitespace, as Caxton's search_and_replace
    does.
    """
    import difflib

    lines = content.split("\n")
    old_lines = old.split("\n")
    first = next((ln.strip() for ln in old_lines if ln.strip()), "")
    if not first or len(lines) > EDIT_HINT_MAX_LINES:
        return ""
    stripped = [ln.strip() for ln in lines]
    matches = difflib.get_close_matches(first, stripped, n=1)
    if not matches:
        return ""
    lead = next(i for i, ln in enumerate(old_lines) if ln.strip())
    idx = max(0, stripped.index(matches[0]) - lead)
    window = lines[max(0, idx - 1) : idx + len(old_lines) + 1]
    return "\n".join(
        difflib.unified_diff(
            old_lines, window, "old_string", "file", lineterm="", n=len(old_lines)
        )
    )


def edit_target(cs: ChangeSet, path: Any) -> tuple[str, RecordSchema | None]:
    """The path edit_file may change, and its schema when it is a record.

    Records are a project's tasks/*.md, decisions/*.md, and STATUS.md; any
    other file write_file may write is an asset. The file must exist.
    """
    rel = change_line(path, "path")
    parts = rel.split("/")
    schema: RecordSchema | None = None
    if len(parts) == 3 and parts[1] == "tasks" and rel.endswith(".md"):
        schema = TASK_SCHEMA
    elif len(parts) == 3 and parts[1] == "decisions" and rel.endswith(".md"):
        schema = DECISION_SCHEMA
    elif len(parts) == 2 and parts[1] == "STATUS.md":
        schema = STATUS_SCHEMA
    if schema is not None:
        check_record_path(cs.snap, rel)
    elif len(parts) > 1 and parts[1] in ("tasks", "decisions"):
        raise ChangeSetError(
            f"{rel}: only the records directly in {parts[1]}/ can be edited"
        )
    else:
        check_asset_path(cs.snap, rel)
    if not cs.snap.is_file(rel):
        raise ChangeSetError(f"{rel}: no such file (edit_file changes existing files)")
    return rel, schema


def check_record_edit(
    cs: ChangeSet, rel: str, schema: RecordSchema, before: str, after: str
) -> None:
    """Refuses an edit of record REL from BEFORE to AFTER that would break it.

    The frontmatter must still parse, a task keeps its ID and a known status,
    no schema section may appear twice where it appeared at most once.
    Entries the edit adds to blocked_by or supersedes join cs.added_refs, so
    validation checks them as it checks the typed operations' additions.
    (apply_edit_file keeps edits out of a STATUS.md generated block.)
    """
    try:
        split_record(after)
    except ChangeSetError as e:
        raise ChangeSetError(f"{rel}: after the edit, {e}") from None
    old_fm, old_body = parse_frontmatter(before)
    new_fm, new_body = parse_frontmatter(after)
    if schema is TASK_SCHEMA:
        old_id, new_id = str(old_fm.get("id", "")), str(new_fm.get("id", ""))
        if new_id != old_id:
            raise ChangeSetError(
                f"{rel}: the edit changes id from {old_id!r} to {new_id!r}"
            )
    for spec in schema.fields:
        if spec.shape != "scalar" or spec.name == "id":
            continue
        raw = new_fm.get(spec.name)
        if raw is None or raw == old_fm.get(spec.name):
            continue
        if spec.value == "status":
            if canonical_status(raw) is None:
                raise ChangeSetError(
                    f"{rel}: unknown status {raw!r} (expected one of: "
                    f"{', '.join(VALUE_TYPES['status'].values)})"
                )
        elif not field_is_valid(spec, str(raw) if isinstance(raw, date) else raw):
            raise ChangeSetError(
                f"{rel}: invalid {spec.name} value {raw!r} "
                f"(expected {VALUE_TYPES[spec.value].description})"
            )
    for spec in schema.set_fields():
        if spec.name not in ("blocked_by", "supersedes"):
            continue
        added = [
            v for v in read_field(new_fm, spec) if v not in read_field(old_fm, spec)
        ]
        for value in added:
            if spec.value == "adr-ref":
                value = value.rsplit("/", 1)[-1].removesuffix(".md")
            if not field_is_valid(spec, value):
                raise ChangeSetError(
                    f"{rel}: invalid {spec.name} value {value!r} "
                    f"(expected {VALUE_TYPES[spec.value].description})"
                )
            if spec.name == "blocked_by" and value == str(new_fm.get("id", "")).upper():
                raise ChangeSetError(f"{value} cannot be blocked by itself")
            cs.added_refs.append((rel, value))
    old_counts = section_counts(old_body, schema)
    new_counts = section_counts(new_body, schema)
    for s_spec in schema.sections:
        n = new_counts.get(s_spec.name, 0)
        old_n = old_counts.get(s_spec.name, 0)
        if n > 1 and old_n <= 1:
            raise ChangeSetError(
                f"{rel}: the edit would make {s_spec.name} appear {n} times"
            )
        if s_spec.required and n == 0 and old_n > 0:
            raise ChangeSetError(
                f"{rel}: the edit removes required section {s_spec.name}"
            )


def apply_edit_file(cs: ChangeSet, change: dict[str, Any]) -> None:
    """Replaces exact text in one file, as Caxton's search_and_replace does.

    OLD_STRING must occur exactly once, or REPLACE_ALL must be true. Bytes
    are matched verbatim; only when nothing matches, the file has CRLF line
    endings, and OLD_STRING has none, are both strings retried with CRLF.
    Assets are written as replaced; records are formatted once the whole set
    has applied, as every record write is. An executable keeps its mode.
    """
    change_keys(
        change, ("path", "old_string", "new_string"), ("replace_all", "expected_blob")
    )
    rel, schema = edit_target(cs, change["path"])
    old = change_str(change["old_string"], "old_string")
    new = change_str(change["new_string"], "new_string")
    expected = change_str(change.get("expected_blob"), "expected_blob", nullable=True)
    replace_all = change.get("replace_all", False)
    if not isinstance(replace_all, bool):
        raise ChangeSetError("replace_all must be true or false")
    if not old:
        raise ChangeSetError("old_string must not be empty")
    try:
        content = cs.snap.read_text(rel)
    except UnicodeDecodeError:
        raise ChangeSetError(f"{rel} is not UTF-8 text") from None
    data = content.encode("utf-8")
    if len(data) > WRITE_FILE_MAX_BYTES:
        raise ChangeSetError(
            f"{rel} is {len(data)} bytes; edit_file changes files up to "
            f"{WRITE_FILE_MAX_BYTES}"
        )
    if expected is not None and expected.lower() != git_blob_sha(data):
        raise ChangeSetError(
            f"{rel}: blob is {git_blob_sha(data)}, expected {expected}", "precondition"
        )

    count = content.count(old)
    if count == 0 and "\r\n" in content and "\r\n" not in old and "\n" in old:
        crlf_old = old.replace("\n", "\r\n")
        if content.count(crlf_old):
            old = crlf_old
            new = new.replace("\r\n", "\n").replace("\n", "\r\n")
            count = content.count(old)
    if count == 0:
        hint = edit_near_miss(content, old)
        raise ChangeSetError(
            f"{rel}: old_string not found"
            + (f"; the closest text:\n{hint}" if hint else "; check whitespace"),
            "precondition",
        )
    if count > 1 and not replace_all:
        raise ChangeSetError(
            f"{rel}: old_string occurs {count} times; add surrounding text to "
            "make it unique, or set replace_all"
        )
    if schema is STATUS_SCHEMA:
        if BEGIN in new or END in new:
            raise ChangeSetError(
                "new_string must not contain the generated block markers"
            )
        a, b = content.find(BEGIN), content.find(END)
        if a != -1 and b != -1:
            block = (a, b + len(END))
            pos = content.find(old)
            while pos != -1:
                if pos < block[1] and pos + len(old) > block[0]:
                    raise ChangeSetError(
                        f"{rel}: old_string reaches into the generated block, "
                        "which taskgo regenerates"
                    )
                if not replace_all:
                    break
                pos = content.find(old, pos + len(old))

    first = content.find(old)
    after = content.replace(old, new, -1 if replace_all else 1)
    size = len(after.encode("utf-8"))
    if size > WRITE_FILE_MAX_BYTES:
        raise ChangeSetError(
            f"{rel}: the result is {size} bytes; the limit is {WRITE_FILE_MAX_BYTES}"
        )
    if schema is not None:
        check_record_edit(cs, rel, schema, content, after)
        cs.touch(rel)
        cs.unformatted.add(rel)
    else:
        check_readme_frontmatter(rel, after)
    start = content.count("\n", 0, first) + 1
    end = start + new.removesuffix("\n").count("\n")
    cs.snap.write_text(rel, after)
    cs.edits.append(
        AppliedEdit(
            path=rel,
            occurrences_replaced=count if replace_all else 1,
            start_line=start,
            end_line=end,
            pre_format=after,
        )
    )


def outcome_text(text: str | None) -> str | None:
    """The Outcome section of the task text TEXT, or None when it has none."""
    if text is None:
        return None
    body = extract_body(text)
    spec = next(s for s in TASK_SCHEMA.sections if s.name == "Outcome")
    spans = section_spans(body, spec)
    return body[slice(*spans[0])] if spans else None


def lacks_required_outcome(before: str | None, after: str) -> bool:
    """True when the task text AFTER is done without Outcome text.

    BEFORE is the text it replaces (None for a new task). A task that was
    already done and keeps its Outcome unchanged is let through: older
    records predate the rule and are repaired when next completed. The CLI,
    'apply', and the MCP server share this rule.
    """
    if canonical_status(parse_frontmatter(after)[0].get("status")) != "done":
        return False
    was_done = before is not None and (
        canonical_status(parse_frontmatter(before)[0].get("status")) == "done"
    )
    outcome = outcome_text(after)
    if was_done and outcome == outcome_text(before):
        return False
    return not (outcome or "").removeprefix("## Outcome").strip()


def validate_change_set(cs: ChangeSet) -> list[str]:
    """Checks the state after the whole change set.

    Returns the projects whose STATUS.md must be regenerated: each project
    with a changed task, decision, or STATUS.md, and each project with a task
    that a changed task blocks (a snapshot block shows only direct blockers).
    """
    snap = cs.snap
    rows = get_task_rows(snap)
    paths_by_id: dict[str, list[str]] = {}
    for r in rows:
        paths_by_id.setdefault(r.task_id, []).append(r.rel_path)
    touched = [r for r in rows if r.rel_path in cs.before]
    touched_ids = {r.task_id for r in touched}

    for rel, value in cs.added_refs:
        if "/tasks/" in rel and value not in paths_by_id:
            raise ChangeSetError(
                f"{rel}: blocked_by names unknown task {value}", "validation"
            )
    for r in touched:
        if len(paths_by_id[r.task_id]) > 1:
            raise ChangeSetError(
                f"{r.task_id} names {len(paths_by_id[r.task_id])} records", "validation"
            )
        if lacks_required_outcome(cs.before[r.rel_path], snap.read_text(r.rel_path)):
            raise ChangeSetError(
                f"{r.task_id} is done but has no Outcome", "validation"
            )
    for cycle in find_dependency_cycles(rows):
        if touched_ids & set(cycle):
            chain = " -> ".join([*cycle, cycle[0]])
            raise ChangeSetError(
                f"blocked_by would form a cycle: {chain}", "validation"
            )

    decisions = sorted(rel for rel in cs.before if "/decisions/" in rel)
    for project in sorted({rel.split("/")[0] for rel in decisions}):
        adr_rows = get_adr_rows(snap, project)
        filenames = [a.filename for a in adr_rows]
        names = {rel.rsplit("/", 1)[1] for rel in decisions if rel.startswith(project)}
        for rel, token in cs.added_refs:
            if rel.startswith(f"{project}/decisions/") and (
                resolve_adr_token(token, filenames) is None
            ):
                raise ChangeSetError(
                    f"{rel}: supersedes names unknown {token}", "validation"
                )
        for cycle in find_adr_cycles(adr_rows):
            if names & set(cycle):
                chain = " -> ".join([*cycle, cycle[0]])
                raise ChangeSetError(
                    f"supersedes would form a cycle: {chain}", "validation"
                )

    projects = {rel.split("/")[0] for rel in cs.before}
    projects |= {r.project for r in rows if touched_ids & set(r.blocked_by)}
    return sorted(projects)


def unknown_change(cs: ChangeSet, change: Any) -> None:
    raise ChangeSetError(f"op must be one of: {', '.join(CHANGE_OPS)}")


CHANGE_HANDLERS: dict[str, Callable[[ChangeSet, dict[str, Any]], None]] = {
    "create": apply_create,
    "set": apply_set,
    "add": apply_add_remove,
    "remove": apply_add_remove,
    "replace_section": apply_replace_section,
    "write_file": apply_write_file,
    "delete_file": apply_delete_file,
    "edit_file": apply_edit_file,
}


def apply_change_set(
    base: Snapshot, doc: Any, conversation: str | None = None
) -> ChangeSet:
    """Applies the change set DOC over BASE in memory.

    Changes apply in order, each seeing the ones before it, then the whole
    result is validated and the affected projects' STATUS.md blocks are
    regenerated. CONVERSATION, a session URI, joins the conversations of
    every task the set touches, as a CLI commit adds the active session.
    Raises ChangeSetError, naming the change, on any refusal; BASE is never
    written.
    """
    changes = doc.get("changes") if isinstance(doc, dict) else None
    if not isinstance(changes, list) or set(doc) != {"changes"}:
        raise ChangeSetError("a change set is an object with one key, 'changes'")
    if not changes:
        raise ChangeSetError("the change set has no changes")
    cs = ChangeSet(OverlaySnapshot(base), {}, [], {}, [])
    for i, change in enumerate(changes, 1):
        op = change.get("op") if isinstance(change, dict) else None
        handler = CHANGE_HANDLERS.get(op) if isinstance(op, str) else None
        try:
            (handler or unknown_change)(cs, change)
        except ChangeSetError as e:
            raise ChangeSetError(f"change {i} ({op}): {e}", e.kind) from None
    if conversation is not None:
        touched = [
            r for r in get_task_rows(cs.snap) if r.rel_path in cs.before and r.task_id
        ]
        for row in touched:
            add = {"op": "add", "record": row.task_id, "field": "conversations"}
            try:
                apply_add_remove(cs, {**add, "values": [conversation]})
            except ChangeSetError as e:
                raise ChangeSetError(f"conversation: {e}", e.kind) from None
    # Records edit_file wrote verbatim are formatted now, so that several
    # edits of one record each match the text the one before it left.
    for rel in sorted(cs.unformatted, key=path_key):
        if cs.snap.is_file(rel):
            cs.snap.write_markdown(rel, cs.snap.read_text(rel))
    projects = validate_change_set(cs)
    rows = get_task_rows(cs.snap)
    index = {r.task_id: r.status for r in rows if r.task_id}
    for project in projects:
        if is_project(cs.snap, project):
            sync_status(cs.snap, project, all_rows=rows, index=index)
    return cs


def change_set_result(cs: ChangeSet) -> dict[str, Any]:
    """The created records and the files changed, with their new blob SHAs.

    A file whose executable bit changed says so; each edit_file reports its
    replacements, the lines of the first, and the file's lines afterwards.
    """
    files = []
    for rel, (before, after) in cs.snap.diff().items():
        entry: dict[str, Any] = {
            "path": rel,
            "change": (
                "deleted"
                if after is None
                else "added"
                if before is None
                else "modified"
            ),
            "blob": git_blob_sha(after.encode("utf-8")) if after is not None else None,
        }
        executable = cs.snap.is_executable(rel)
        if after is not None and executable != cs.snap.base.is_executable(rel):
            entry["executable"] = executable
        files.append(entry)
    result: dict[str, Any] = {"created": cs.created, "files": files}
    if cs.edits:
        final = {
            e.path: cs.snap.read_text(e.path)
            for e in cs.edits
            if cs.snap.is_file(e.path)
        }
        edits_out = []
        for e in cs.edits:
            s_line, e_line = e.start_line, e.end_line
            if e.path in final:
                s_line, e_line = remap_line_span(
                    e.pre_format, final[e.path], s_line, e_line
                )
            edits_out.append(
                {
                    "path": e.path,
                    "occurrences_replaced": e.occurrences_replaced,
                    "start_line": s_line,
                    "end_line": e_line,
                    "total_lines": (
                        count_lines(final[e.path]) if e.path in final else None
                    ),
                    "blob": (
                        git_blob_sha(final[e.path].encode("utf-8"))
                        if e.path in final
                        else None
                    ),
                }
            )
        result["edits"] = edits_out
    return result


def cmd_apply(changes_path: str, dry_run: bool = False) -> None:
    """Apply a change set to the working tree."""
    try:
        raw = (
            sys.stdin.read()
            if changes_path == "-"
            else Path(changes_path).read_text(encoding="utf-8")
        )
    except OSError as e:
        die_scoped(f"cannot read {changes_path}: {e.strerror}")
    try:
        doc = json.loads(raw)
    except json.JSONDecodeError as e:
        die_scoped(f"{changes_path} is not JSON: {e}")
    result = run_change_set(doc, dry_run)
    if result is not None:
        print(json.dumps(result, indent=2))


def set_file_executable(path: Path, executable: bool) -> None:
    """Sets or clears PATH's executable bits, where it is readable."""
    mode = path.stat().st_mode & 0o7777
    mode = (mode | (mode & 0o444) >> 2) if executable else (mode & ~0o111)
    os.chmod(path, mode)


def run_change_set(doc: Any, dry_run: bool = False) -> dict[str, Any] | None:
    """Applies change set DOC to the working tree and returns the result.

    With DRY_RUN, prints the diff instead, writes nothing, and returns None.
    A refused set exits, naming the change, with nothing written.
    """
    root = get_repo_root()
    base = FsSnapshot(root)
    try:
        cs = apply_change_set(base, doc)
    except ChangeSetError as e:
        die_scoped(f"{e}; nothing changed")
    diff = cs.snap.diff()
    if dry_run:
        import difflib

        for rel, (before, after) in diff.items():
            old_x, new_x = base.is_executable(rel), cs.snap.is_executable(rel)
            if before is not None and after is not None and old_x != new_x:
                modes = ("100755" if x else "100644" for x in (old_x, new_x))
                old_mode, new_mode = modes
                sys.stdout.write(
                    f"mode {rel}\nold mode {old_mode}\nnew mode {new_mode}\n"
                )
            sys.stdout.writelines(
                difflib.unified_diff(
                    (before or "").splitlines(keepends=True),
                    (after or "").splitlines(keepends=True),
                    "/dev/null" if before is None else f"a/{rel}",
                    "/dev/null" if after is None else f"b/{rel}",
                )
            )
        return None
    result = change_set_result(cs)
    for rel, (_, after) in diff.items():
        if after is None:
            base.delete(rel)
            continue
        base.write_text(rel, after)
        if cs.snap.is_executable(rel) != base.is_executable(rel):
            set_file_executable(base.path(rel), cs.snap.is_executable(rel))
    return result


def edit_arg_text(text: str | None, path: str | None, what: str) -> str:
    """The text of --WHAT or --WHAT-file (- for standard input), verbatim."""
    if (text is None) == (path is None):
        die_scoped(f"give exactly one of --{what} and --{what}-file")
    if text is not None:
        return text
    try:
        if path == "-":
            return sys.stdin.buffer.read().decode("utf-8")
        return Path(str(path)).read_bytes().decode("utf-8")
    except OSError as e:
        die_scoped(f"cannot read {path}: {e.strerror}")
    except UnicodeDecodeError:
        die_scoped(f"{path} is not UTF-8 text")


def cmd_edit(
    path: str,
    old: str | None = None,
    new: str | None = None,
    old_file: str | None = None,
    new_file: str | None = None,
    replace_all: bool = False,
    expected_blob: str | None = None,
    dry_run: bool = False,
    as_json: bool = False,
) -> None:
    """Replace exact text in one file of the working tree (edit_file)."""
    if old_file == "-" and new_file == "-":
        die_scoped("only one of --old-file and --new-file can be -")
    change: dict[str, Any] = {
        "op": "edit_file",
        "path": trim_boundary_path(path),
        "old_string": edit_arg_text(old, old_file, "old"),
        "new_string": edit_arg_text(new, new_file, "new"),
        "replace_all": replace_all,
    }
    if expected_blob is not None:
        change["expected_blob"] = expected_blob
    result = run_change_set({"changes": [change]}, dry_run)
    if result is None:
        return
    if as_json:
        print(json.dumps(result, indent=2))
        return
    e = result["edits"][0]
    n = e["occurrences_replaced"]
    lines = (
        f"line {e['start_line']}"
        if e["start_line"] == e["end_line"]
        else f"lines {e['start_line']}-{e['end_line']}"
    )
    print(
        f"{e['path']}: replaced {n} occurrence{'s' if n != 1 else ''} "
        f"(first at {lines}); {e['total_lines']} lines, blob {e['blob'][:12]}"
    )
    others = [f["path"] for f in result["files"] if f["path"] != e["path"]]
    if others:
        print(f"also changed: {', '.join(others)}")


def schema_document() -> dict[str, Any]:
    """Returns the record schema as plain data, for conformance checks."""
    return {
        "version": SCHEMA_VERSION,
        "value_types": {
            name: {
                "description": vt.description,
                **({"pattern": vt.pattern} if vt.pattern else {}),
                **({"values": list(vt.values)} if vt.values else {}),
            }
            for name, vt in VALUE_TYPES.items()
        },
        "kinds": [
            {
                "kind": schema.kind,
                "path": schema.path,
                "fields": [
                    {
                        "name": f.name,
                        "shape": f.shape,
                        "value": f.value,
                        "required": f.required,
                        "mutable": f.mutable,
                        **({"aliases": list(f.aliases)} if f.aliases else {}),
                    }
                    for f in schema.fields
                ],
                "sections": [
                    {
                        "name": sec.name,
                        "form": sec.form,
                        "required": sec.required,
                        "writable": sec.writable,
                    }
                    for sec in schema.sections
                ],
            }
            for schema in SCHEMAS
        ],
    }


def cmd_schema(as_json: bool = False) -> None:
    """Prints the record schema for tasks, decisions, and STATUS.md."""
    doc = schema_document()
    if as_json:
        print(json.dumps(doc, indent=2))
        return
    for kind in doc["kinds"]:
        print(f"{kind['kind']}: {kind['path']}")
        if kind["fields"]:
            print("  Fields:")
            for f in kind["fields"]:
                notes = [
                    n
                    for n, on in (
                        ("required", f["required"]),
                        ("immutable", not f["mutable"]),
                    )
                    if on
                ]
                notes += [f"alias {a}" for a in f.get("aliases", [])]
                print(
                    f"    {f['name']:<15}{f['shape']:<8}{f['value']:<14}{', '.join(notes)}".rstrip()
                )
        print("  Sections:")
        for sec in kind["sections"]:
            notes = [
                n
                for n, on in (
                    ("required", sec["required"]),
                    ("read-only", not sec["writable"]),
                )
                if on
            ]
            print(f"    {sec['name']:<15}{sec['form']:<11}{', '.join(notes)}".rstrip())
        print()
    print("Value types:")
    for name, vt in doc["value_types"].items():
        print(f"  {name:<15}{vt['description']}")


def select_task_rows(
    snap: Snapshot, project: str | None = None, state: str | None = None
) -> list[TaskRow]:
    """The task rows 'taskgo list' prints, filtered by STATE.

    'ready' is derived, not a declared status: todo with nothing holding it,
    soonest due date first.
    """
    rows = get_task_rows(snap, project)
    if not state:
        return rows
    if state.strip().lower() == "ready":
        index = status_index(snap)
        today = get_today(snap)
        rows = [
            r
            for r in rows
            if r.status == TaskStatus.TODO.value
            and not unresolved_blockers(r, index)
            and not unresolved_wait_for(r, today)
        ]
        rows.sort(
            key=lambda r: (
                parse_iso_date(r.due) is None,
                parse_iso_date(r.due) or date.max,
            )
        )
        return rows
    norm_state = normalize_status(state)
    return [r for r in rows if r.status == norm_state]


def task_row_json(r: TaskRow) -> dict[str, Any]:
    """The JSON form of a task row, as 'taskgo list --json' prints it."""
    return {
        "project": r.project,
        "id": r.task_id,
        "status": r.status,
        "title": r.title,
        "path": r.rel_path,
        "blocked_by": list(r.blocked_by),
        "wait_for": list(r.wait_for),
        "due": r.due,
        "stale_after": r.stale_after,
    }


def cmd_list(
    project: str | None = None,
    state: str | None = None,
    as_json: bool = False,
) -> None:
    """List tasks in the repository or a specific project."""
    rows = select_task_rows(FsSnapshot(get_repo_root()), project, state)

    if as_json:
        print(json.dumps([task_row_json(r) for r in rows], indent=2))
        return

    if not rows:
        return

    print("PROJECT\tTASK\tSTATE\tTITLE\tPATH")
    for r in rows:
        print(
            f"{r.project}\t{r.task_id}\t{r.status or '(missing)'}\t{r.title}\t{r.rel_path}"
        )


def _to_jsonable(val: Any) -> Any:
    """Recursively converts ruamel.yaml mappings/sequences/scalars into standard JSON-serializable types."""
    if isinstance(val, datetime):
        return val.date().isoformat()
    if isinstance(val, date):
        return val.isoformat()
    if isinstance(val, dict):
        return {str(k): _to_jsonable(v) for k, v in val.items()}
    if isinstance(val, list):
        return [_to_jsonable(v) for v in val]
    if not isinstance(val, (str, int, float, bool, type(None))):
        return str(val)
    return val


def _normalize_skill_list(raw: Any) -> list[str]:
    """Normalizes a frontmatter 'skills' value (list or comma/space-separated string) into a list of strings."""
    if not raw:
        return []
    items: list[str] = []
    if isinstance(raw, list):
        for entry in raw:
            for tok in re.split(r"[\s,]+", str(entry).strip()):
                if tok:
                    items.append(tok)
    elif isinstance(raw, str):
        for tok in re.split(r"[\s,]+", raw.strip()):
            if tok:
                items.append(tok)
    seen: set[str] = set()
    deduped: list[str] = []
    for item in items:
        low = item.lower()
        if low not in seen:
            seen.add(low)
            deduped.append(item)
    return deduped


# A skill spec as the skill CLI resolves it: a catalog short name, optionally
# qualified by its namespace ('coding-standards', 'local:notes').
SKILL_SPEC_RE = re.compile(
    r"^(?:[A-Za-z0-9][A-Za-z0-9_.-]*:)?[A-Za-z0-9][A-Za-z0-9_.-]*$"
)


def project_readme_rel(snap: Snapshot, project: str) -> str | None:
    """PROJECT's README.md, or PROJECT.md when only that exists."""
    return next(
        (
            rel
            for rel in (f"{project}/README.md", f"{project}/PROJECT.md")
            if snap.is_file(rel)
        ),
        None,
    )


def project_skills(snap: Snapshot, project: str) -> list[str]:
    """The skills PROJECT's README frontmatter declares, normalized.

    Malformed frontmatter yields none; doctor reports it.
    """
    rel = project_readme_rel(snap, project)
    if rel is None:
        return []
    try:
        fm, _ = parse_frontmatter(snap.read_text(rel))
    except Exception:
        return []
    return _normalize_skill_list(fm.get("skills"))


def skill_catalog() -> set[tuple[str, str]] | None:
    """The skill CLI's catalog as (namespace, short name) pairs, lowercased,
    or None when the CLI is not on PATH or cannot list it."""
    if shutil.which("skill") is None:
        return None
    try:
        res = subprocess.run(
            ["skill", "catalog", "--json"],
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if res.returncode != 0:
        return None
    # JSON Lines today; a JSON array is accepted should that change.
    records: list[Any]
    try:
        whole = json.loads(res.stdout)
        records = whole if isinstance(whole, list) else [whole]
    except ValueError:
        records = []
        for line in res.stdout.splitlines():
            try:
                records.append(json.loads(line))
            except ValueError:
                continue
    entries: set[tuple[str, str]] = set()
    for rec in records:
        key = str(rec.get("name") or "") if isinstance(rec, dict) else ""
        if not key:
            continue
        # The CLI's own rule: a key without a namespace is 'local'.
        ns, short = key.split(":", 1) if ":" in key else ("local", key)
        entries.add((ns.lower(), short.lower()))
    return entries


def skill_in_catalog(spec: str, catalog: set[tuple[str, str]]) -> bool:
    """True when the skill CLI would resolve SPEC in CATALOG: a short name
    matches any namespace; 'ns:name' must match in that namespace."""
    if ":" in spec:
        ns, name = spec.split(":", 1)
        return (ns.lower(), name.lower()) in catalog
    return any(short == spec.lower() for _, short in catalog)


def audit_skills(snap: Snapshot, target_project: str | None = None) -> list[Finding]:
    """Checks each project's declared skills against the skill CLI's catalog.

    Separate from audit_snapshot because it runs a command: doctor and fix
    call it; handoff and the MCP server do not.
    """
    import difflib

    projects = [require_project(snap, target_project)] if target_project else []
    projects = projects or list_projects(snap)
    declared = [
        (project_readme_rel(snap, name), spec)
        for name in projects
        for spec in project_skills(snap, name)
    ]
    if not declared:
        return []
    catalog = skill_catalog()
    if catalog is None:
        return [
            Finding(
                category="skills",
                severity="INFO",
                message="skills not checked (skill CLI not found or failed)",
            )
        ]
    shorts = sorted({short for _, short in catalog})
    findings = []
    for rel, spec in declared:
        if skill_in_catalog(spec, catalog):
            continue
        short = spec.split(":", 1)[-1].lower()
        close = difflib.get_close_matches(short, shorts, n=1, cutoff=0.7)
        hint = f" (did you mean {close[0]!r}?)" if close else ""
        findings.append(
            Finding(
                category="skills",
                severity="WARN",
                message=f"{rel}: unknown skill {spec!r}{hint}",
                path=rel,
            )
        )
    return findings


def cmd_skills(project: str, as_json: bool = False) -> None:
    """Print the skills a project declares, one per line."""
    snap = FsSnapshot(get_repo_root())
    skills = project_skills(snap, require_project(snap, project))
    if as_json:
        print(json.dumps(skills))
        return
    for s in skills:
        print(s)


def cmd_info(
    project: str,
    as_json: bool = False,
) -> None:
    """Show project metadata from README.md YAML frontmatter."""
    root = get_repo_root()
    proj_dir = root / require_project(FsSnapshot(root), project)

    readme_file = proj_dir / "README.md"
    if not readme_file.is_file() and (proj_dir / "PROJECT.md").is_file():
        readme_file = proj_dir / "PROJECT.md"

    fm: dict[str, Any] = {}
    if readme_file.is_file():
        fm, _ = parse_frontmatter(readme_file.read_text(encoding="utf-8"))

    skills = _normalize_skill_list(fm.get("skills"))

    info: dict[str, Any] = {
        "project": project,
        "path": str(proj_dir),
        "readme": str(readme_file) if readme_file.is_file() else None,
        "skills": skills,
    }
    for k, v in fm.items():
        if k not in info:
            info[k] = _to_jsonable(v)

    if as_json:
        print(json.dumps(info, indent=2))
        return

    print(f"Project: {project}")
    print(f"Path: {display_path(proj_dir)}")
    print(f"Skills: {', '.join(skills) if skills else 'none'}")
    for k, v in fm.items():
        if k == "skills":
            continue
        label = k.replace("_", " ").title()
        norm_v = _to_jsonable(v)
        if isinstance(norm_v, list):
            val_str = ", ".join(str(x) for x in norm_v) if norm_v else "none"
        elif isinstance(norm_v, dict):
            val_str = json.dumps(norm_v)
        else:
            val_str = str(norm_v)
        print(f"{label}: {val_str}")


def project_status_json(
    snap: Snapshot, project: str, with_tasks: bool = False
) -> dict[str, Any]:
    """One project's entry in 'taskgo status --json'."""
    rows = get_task_rows(snap, project)
    out: dict[str, Any] = {
        "project": project,
        "in_progress": [r.task_id for r in rows if r.status == "in-progress"],
        "blocked": [r.task_id for r in rows if r.status == "blocked"],
        "todo_count": sum(1 for r in rows if r.status == "todo"),
        "done_count": sum(1 for r in rows if r.status == "done"),
    }
    if with_tasks:
        out["tasks"] = [
            {
                "id": r.task_id,
                "status": r.status,
                "title": r.title,
                "path": r.rel_path,
            }
            for r in rows
        ]
    return out


def task_state_line(snap: Snapshot, row: TaskRow) -> str:
    """A task's declared status and what the tracker derives from it."""
    held = []
    if row.status not in RESOLVED_STATES:
        held = [
            *(f"blocked by {b}" for b in unresolved_blockers(row, status_index(snap))),
            *(f"waiting for {w}" for w in unresolved_wait_for(row, get_today(snap))),
        ]
    if row.status == TaskStatus.TODO.value and not held:
        return f"{row.status}, ready"
    return ", ".join([row.status, *held])


def cmd_status(
    target: str | None = None,
    at: str | None = None,
    as_json: bool = False,
) -> None:
    """Show a task's, a project's, or the whole workspace's status."""
    root = get_repo_root()
    snap = tree_snapshot(root, at)
    name = (target or "").strip()
    if name and ID_PATTERN.match(name.upper()):
        try:
            row = find_task_row(snap, name.upper())
        except TaskgoError as e:
            die_scoped(str(e))
        if as_json:
            committed = commit_time(root, snap.rev) if snap.rev else None
            out = {
                "as_of": snapshot_as_of(snap, committed),
                **task_record_json(snap, row),
            }
            print(json.dumps(out, indent=2, ensure_ascii=False))
            return
        title = row.title or row.task_id
        print(f"{row.task_id} ({row.project}): {title}")
        print(f"State: {task_state_line(snap, row)}")
        print(f"Path: {row.rel_path}")
        print()
        print(snap.read_text(row.rel_path).rstrip())
        return
    project = name or None
    if project:
        require_project(snap, project)
        if as_json:
            out = project_status_json(snap, project, with_tasks=True)
            print(json.dumps(out, indent=2))
            return
        status_file = f"{project}/STATUS.md"
        if snap.is_file(status_file):
            print(snap.read_text(status_file).rstrip())
        else:
            print(render_status_file(snap, project).rstrip())
        return

    # All projects
    projects = list_projects(snap)
    if as_json:
        all_data = [project_status_json(snap, p) for p in projects]
        print(json.dumps(all_data, indent=2))
        return

    for p in projects:
        data = project_status_json(snap, p)
        prog_str = ", ".join(data["in_progress"]) if data["in_progress"] else "none"
        blk_str = ", ".join(data["blocked"]) if data["blocked"] else "none"
        print(
            f"{p}: in-progress=[{prog_str}] blocked=[{blk_str}] "
            f"todo={data['todo_count']} done={data['done_count']}"
        )


class TaskgoError(Exception):
    """A refusal the core reports to its caller: the CLI dies with the message,
    the MCP server returns it as a tool error."""


@dataclass(slots=True)
class HandoffPlan:
    task_id: str
    project: str
    title: str
    goal: str
    findings: list[tuple[Literal["WARN", "FAIL"], str]]


def plan_handoff(
    snap: Snapshot, rel_path: str, content: str, audit: list["Finding"]
) -> HandoffPlan:
    """Checks a task record for handoff.

    CONTENT is the record as read; AUDIT is the project's audit findings.
    Raises TaskgoError when the record cannot be handed off at all.
    """
    project_name = rel_path.split("/", maxsplit=1)[0]
    resolved_id = extract_frontmatter_field(content, "id")
    if not ID_PATTERN.match(resolved_id):
        raise TaskgoError(f"{rel_path} has no valid committed task ID")
    status = extract_frontmatter_field(content, "status")
    title = extract_title(content)
    goal = extract_runin(content, "Goal")

    # Handing off finished work is a selection error, so refuse it.
    if status in RESOLVED_STATES:
        raise TaskgoError(
            f"{resolved_id} is {status}; handoff accepts only unfinished work "
            f"(see 'taskgo list {project_name} --state ready')"
        )

    findings: list[tuple[Literal["WARN", "FAIL"], str]] = []
    if not title:
        findings.append(
            ("WARN", f"{resolved_id} has no title heading; the note names only its ID")
        )
    if not goal:
        findings.append(
            (
                "WARN",
                f"{resolved_id} has no '**Goal:**'; the summary cannot say what the work is",
            )
        )

    findings.extend(
        (finding.severity, finding.message)
        for finding in audit
        if finding.severity in {"WARN", "FAIL"}
    )

    rows = get_task_rows(snap, project_name)
    row = next((r for r in rows if r.task_id == resolved_id), None)
    if row is not None:
        blockers = unresolved_blockers(row, status_index(snap))
        if blockers:
            findings.append(
                (
                    "WARN",
                    (
                        f"{resolved_id} is still blocked by {', '.join(blockers)}; "
                        "it is not ready for handoff"
                    ),
                )
            )
        waiting = unresolved_wait_for(row, get_today(snap))
        if waiting:
            findings.append(
                (
                    "WARN",
                    (
                        f"{resolved_id} is still waiting for {', '.join(waiting)}; "
                        "it is not ready for handoff"
                    ),
                )
            )
    return HandoffPlan(resolved_id, project_name, title, goal, findings)


def handoff_note(plan: HandoffPlan, status_ref: str, task_ref: str) -> str:
    """The handoff note: headline, Goal, and where to read before acting."""
    headline = f"Next is taskgo {plan.task_id} ({plan.project})"
    if plan.title:
        headline += f": {plan.title}"
        if plan.title[-1] not in ".?!":
            headline += "."
    else:
        headline += "."

    paragraphs = [headline]
    if plan.goal:
        paragraphs.append(plan.goal)
    paragraphs.append(
        f"Read {status_ref} and the task record ({task_ref}) before acting, and "
        "form your own view of the approach."
    )
    # Never break inside a path or hyphenated identifier: the note is pasted and
    # its file references must stay greppable.
    return "\n\n".join(
        textwrap.fill(p, width=76, break_long_words=False, break_on_hyphens=False)
        for p in paragraphs
    )


# The most tasks a project handoff note lists before pointing at 'taskgo list'.
HANDOFF_TASK_LIMIT = 10


def project_handoff_tasks(snap: Snapshot, project: str) -> str:
    """The project note's task list: in-progress tasks, then ready ones.

    One unwrapped line per task, so the person passing the note on can
    check where the agent will start; the agent still chooses.
    """
    groups = [
        ("In progress", select_task_rows(snap, project, "in-progress")),
        ("Ready", select_task_rows(snap, project, "ready")),
    ]
    if not any(rows for _, rows in groups):
        return "No task is in progress or ready."
    lines = []
    budget = HANDOFF_TASK_LIMIT
    for label, rows in groups:
        if not rows:
            continue
        lines.append(f"{label}:")
        lines.extend(f"  {r.task_id}  {r.title or '(untitled)'}" for r in rows[:budget])
        if len(rows) > budget:
            state = "in-progress" if label == "In progress" else "ready"
            lines.append(
                f"  ...and {len(rows) - budget} more "
                f"(taskgo list {project} --state {state})"
            )
        budget = max(budget - len(rows), 0)
    return "\n".join(lines)


def project_handoff_note(project: str, title: str, refs: list[str], tasks: str) -> str:
    """The handoff note for a project: headline, its active and ready tasks,
    and what to read first."""
    headline = f"Next is taskgo project {project}"
    headline += f": {title}" if title else ""
    headline += "" if headline[-1] in ".?!" else "."
    if len(refs) > 2:
        listed = ", ".join(refs[:-1]) + f", and {refs[-1]}"
    else:
        listed = " and ".join(refs)
    paragraphs = [
        headline,
        f"Read {listed} before acting, and form your own view of the approach.",
    ]
    # The task list is already laid out, one task per line, so it is not filled.
    headline, read = (
        textwrap.fill(p, width=76, break_long_words=False, break_on_hyphens=False)
        for p in paragraphs
    )
    return f"{headline}\n\n{tasks}\n\n{read}"


@dataclass(slots=True)
class HandoffTarget:
    """A resolved handoff target: a project, or one task in it."""

    project: str
    row: TaskRow | None
    plan: HandoffPlan | None
    readme: str | None  # README.md, or PROJECT.md when only that exists
    findings: list[tuple[Literal["WARN", "FAIL"], str]]
    skills: list[str]  # as the project README declares them

    def note(self, snap: Snapshot, ref: Callable[[str], str]) -> str:
        """The short handoff note, naming files through REF."""
        status_rel = f"{self.project}/STATUS.md"
        if self.plan is not None and self.row is not None:
            note = handoff_note(self.plan, ref(status_rel), ref(self.row.rel_path))
        else:
            title = extract_title(snap.read_text(self.readme)) if self.readme else ""
            rels = [r for r in (self.readme, status_rel) if r and snap.is_file(r)]
            plan_rel = f"{self.project}/PLAN.md"
            if snap.is_file(plan_rel):
                rels.append(plan_rel)
            note = project_handoff_note(
                self.project,
                title,
                [ref(r) for r in rels] or [ref(self.project)],
                project_handoff_tasks(snap, self.project),
            )
        if self.skills:
            note += "\n\n" + skills_note(self.project, self.skills)
        return note


def skills_note(project: str, skills: list[str]) -> str:
    """The handoff note's skills paragraph: what to activate, and how.

    Adding a skill that is already active is harmless, so the agent need
    not work out which ones it lacks. The command is on a line of its own,
    never wrapped, so it can be run as it is.
    """
    prose = textwrap.fill(
        f"Skills: {', '.join(skills)}. If your harness has a skill manager, "
        "activate them for this session with the command below (adding one "
        "that is already active is harmless); otherwise read each skill's "
        "SKILL.md.",
        width=76,
        break_long_words=False,
        break_on_hyphens=False,
    )
    return f"{prose}\n\n  taskgo skills {project} | skill --scope session add -"


def find_task_row(snap: TreeSnapshot, task_id: str) -> TaskRow:
    """The one record of TASK_ID in SNAP; raises TaskgoError otherwise."""
    matches = [r for r in get_task_rows(snap) if r.task_id == task_id]
    if not matches:
        where = (
            f"commit {snap.rev[:12]}"
            if isinstance(snap, GitTreeSnapshot)
            else "the working tree"
        )
        raise TaskgoError(f"{task_id} is not in {where}")
    if len(matches) > 1:
        paths = ", ".join(r.rel_path for r in matches)
        raise TaskgoError(f"{task_id} names more than one record: {paths}")
    return matches[0]


def resolve_handoff(snap: TreeSnapshot, target: Any) -> HandoffTarget:
    """Resolves TARGET, a project name or a task ID, in SNAP for handoff.

    Raises TaskgoError for an unknown target or a finished task.
    """
    name = str(target or "").strip()
    row = None
    if ID_PATTERN.match(name.upper()):
        row = find_task_row(snap, name.upper())
        project = row.project
    elif is_project(snap, name):
        project = name
    else:
        raise TaskgoError(f"not a project or task ID: {name!r}")
    audit = audit_snapshot(snap, project)
    readme = project_readme_rel(snap, project)
    skills = project_skills(snap, project)
    if row is not None:
        plan = plan_handoff(snap, row.rel_path, snap.read_text(row.rel_path), audit)
        return HandoffTarget(project, row, plan, readme, plan.findings, skills)
    findings = [
        (f.severity, f.message) for f in audit if f.severity in {"WARN", "FAIL"}
    ]
    return HandoffTarget(project, None, None, readme, findings, skills)


def status_snapshot_block(text: str | None) -> str | None:
    """The generated task snapshot block of STATUS.md text, if it has one."""
    if text is None:
        return None
    sections = record_sections(text, STATUS_SCHEMA)
    return next((s["text"] for s in sections if s["name"] == "snapshot"), None)


def snapshot_as_of(snap: Snapshot, committed: int | None) -> dict[str, Any]:
    """The as_of of a read of SNAP, whose commit time is COMMITTED.

    A read of the working tree names the commit HEAD names and says it read
    the working tree, whose files may differ from that commit.
    """
    as_of = {
        "commit": getattr(snap, "rev", None),
        "committed_at": (
            datetime.fromtimestamp(committed, timezone.utc).isoformat()
            if committed is not None
            else None
        ),
        "today": get_today(snap).isoformat(),
        "timezone": repo_timezone_name(snap),
    }
    if isinstance(snap, WorktreeSnapshot):
        as_of["working_tree"] = True
    return as_of


def commit_time(repo: Path, sha: str) -> int:
    """The commit time of SHA, in Unix seconds."""
    return int(run_git(["show", "-s", "--format=%ct", sha], cwd=repo).stdout.strip())


def unverified_gates(rows: list[TaskRow]) -> dict[str, list[str]]:
    """The wait_for gates, other than dates, of the unfinished ROWS, by task."""
    out = {}
    for r in rows:
        gates = [g for g in r.wait_for if parse_iso_date(g) is None]
        if gates and r.status not in RESOLVED_STATES:
            out[r.task_id] = gates
    return out


def task_record_json(snap: TreeSnapshot, row: TaskRow) -> dict[str, Any]:
    """One task record as get_task returns it, without as_of."""
    content = snap.read_text(row.rel_path)
    fm, _ = parse_frontmatter(content)
    return {
        "task": task_row_json(row),
        "blob": snap.blobs[row.rel_path],
        "frontmatter": _to_jsonable(fm),
        "sections": record_sections(content, TASK_SCHEMA),
        "unresolved_blocked_by": unresolved_blockers(row, status_index(snap)),
        "unresolved_wait_for": unresolved_wait_for(row, get_today(snap)),
        "unverified_gates": unverified_gates([row]).get(row.task_id, []),
        "content": content,
    }


def handoff_file(snap: TreeSnapshot, rel: str) -> dict[str, Any] | None:
    """File REL verbatim, cut as read_file cuts it, or None when absent."""
    blob = snap.blobs.get(rel)
    if blob is None:
        return None
    data = snap.read_text(rel).encode("utf-8")
    result = read_slice(rel, blob, data)
    return {k: result[k] for k in ("path", "blob", "content", "truncated")}


def readme_frontmatter(content: str) -> dict[str, Any]:
    """README frontmatter as YAML parses it: no key filtered or renamed."""
    return _to_jsonable(parse_frontmatter(content, lowercase_keys=False)[0])


def status_projection(snap: Snapshot, project: str) -> dict[str, Any]:
    """Committed STATUS.md sections, snapshot blocks, and drift flag for PROJECT."""
    rel = f"{project}/STATUS.md"
    committed = snap.read_text(rel) if snap.is_file(rel) else None
    committed_block = status_snapshot_block(committed)
    live_block = status_snapshot_block(
        format_markdown(render_status_file(snap, project))
    )
    return {
        "sections": (
            record_sections(committed, STATUS_SCHEMA) if committed is not None else []
        ),
        "committed_block": committed_block,
        "live_block": live_block,
        "block_current": committed_block == live_block,
    }


def handoff_payload(
    snap: TreeSnapshot, t: HandoffTarget, as_of: dict[str, Any]
) -> dict[str, Any]:
    """Everything an agent reads before starting on T, in one object.

    The note stays the short pointer a person pastes; the files it names
    ride beside it verbatim, as SNAP holds them.
    """
    project = t.project
    note = t.note(snap, lambda rel: rel)
    if isinstance(snap, GitTreeSnapshot):
        source = f"commit {snap.rev[:12]}"
    elif snap.rev:
        source = f"the working tree (HEAD is {snap.rev[:12]})"
    else:
        source = "the working tree"
    note += (
        "\n\nThese paths are in the taskgo control repository; this payload "
        f"carries them as of {source}.\n\n{MCP_DATA_CARE}"
    )
    readme = handoff_file(snap, t.readme) if t.readme else None
    status_rel = f"{project}/STATUS.md"
    status = handoff_file(snap, status_rel) or {
        "path": status_rel,
        "blob": None,
        "content": None,
        "truncated": False,
    }
    status.update(status_projection(snap, project))
    return {
        "as_of": as_of,
        "project": project,
        "task": task_record_json(snap, t.row) if t.row is not None else None,
        "note": note,
        "findings": [{"severity": s, "message": m} for s, m in t.findings],
        "unverified_gates": unverified_gates(get_task_rows(snap, project)),
        "frontmatter": (
            readme_frontmatter(snap.read_text(t.readme)) if t.readme else {}
        ),
        "skills": t.skills,
        "readme": readme,
        "status": status,
        "plan": handoff_file(snap, f"{project}/PLAN.md"),
        "agents_md": handoff_file(snap, "AGENTS.md"),
        "tasks": {
            "in_progress": [
                task_row_json(r) for r in select_task_rows(snap, project, "in-progress")
            ],
            "blocked": [
                task_row_json(r)
                for r in held_rows(
                    get_task_rows(snap, project), status_index(snap), get_today(snap)
                )
            ],
            "ready": [
                task_row_json(r) for r in select_task_rows(snap, project, "ready")
            ],
        },
    }


def tree_snapshot(root: Path, at: str | None) -> TreeSnapshot:
    """The tree status and handoff read: commit AT, or else the working tree."""
    if at is None:
        return WorktreeSnapshot(root, resolve_commit(root, "HEAD"))
    sha = resolve_commit(root, at)
    if sha is None:
        die_scoped(f"no commit {at} in the control repository")
    return GitTreeSnapshot(root, sha)


def cmd_handoff(target: str, at: str | None = None, as_json: bool = False) -> None:
    """Emit instructions handing a project or task to an agent."""
    root = get_repo_root()
    snap = tree_snapshot(root, at)
    try:
        t = resolve_handoff(snap, target.strip())
    except TaskgoError as e:
        die_scoped(str(e))

    if at is None:
        # A local agent reads the working tree, as the note does; an agent
        # reading through the MCP server sees only what has been pushed.
        shallow = run_git(
            ["rev-parse", "--is-shallow-repository"], cwd=root, check=False
        ).stdout.strip()
        if shallow == "true":
            t.findings.insert(0, ("WARN", "shallow clone: history may be incomplete"))
        dirty = run_git(
            ["status", "--porcelain", "--", t.project], cwd=root, check=False
        ).stdout.strip()
        if dirty:
            t.findings.append(
                (
                    "WARN",
                    (
                        f"{t.project} has uncommitted changes; agents reading "
                        "through MCP see only what is committed and pushed"
                    ),
                )
            )

    if as_json:
        committed = commit_time(root, snap.rev) if snap.rev else None
        payload = handoff_payload(snap, t, snapshot_as_of(snap, committed))
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return

    for severity, message in t.findings:
        print(_tagged(f"[{severity}]  {message}", sys.stderr), file=sys.stderr)
    if at is None:
        print(t.note(snap, lambda rel: str((root / rel).resolve())))
    else:
        print(t.note(snap, lambda rel: rel))


def cmd_sync(
    project: str | None = None,
) -> None:
    """Update STATUS.md snapshot for a project or the workspace."""
    snap = FsSnapshot(get_repo_root())
    if project:
        require_project(snap, project)
        updated = sync_status(snap, project)
        if updated:
            print("updated")
        else:
            print("current")
        return

    projects = list_projects(snap)
    all_rows = get_task_rows(snap)
    index = {r.task_id: r.status for r in all_rows if r.task_id}
    any_updated = False
    for p in projects:
        if sync_status(snap, p, all_rows=all_rows, index=index):
            any_updated = True
    if any_updated:
        print("updated")
    else:
        print("current")


def cmd_doctor(
    project: str | None = None,
) -> None:
    """Run mechanical health checks across the workspace or a project."""
    root = get_repo_root()
    _, source = resolve_root_candidate()

    print(_tagged(f"{'[PASS]'.ljust(8)}Control repository"))
    print(f"        Root: {display_path(root)}")
    print(f"        Source: {source}")

    findings = audit_workspace(root, project)

    has_warn_or_fail = False
    for f in findings:
        prefix = f"[{f.severity}]".ljust(8)
        print(_tagged(f"{prefix}{f.message}"))
        if f.severity in ("WARN", "FAIL"):
            has_warn_or_fail = True

    print(
        _tagged(
            """[INFO]  Agent semantic review
        Check STATUS Summary is rewritten current state (not a session log) and matches tasks/Next.
        Check active conversation ID ([<conversation-id>](<agent>://<conversation-id>)) is recorded in STATUS.md Summary or task Outcome.
        Check PLAN is current direction, not accumulated history.
        Check README/ADRs link to artifact or skill owners rather than copying their facts.
        Check private tracker material has not leaked to public/shared artifacts.
        After merges, check reconciled files express one coherent current state."""
        )
    )

    if has_warn_or_fail:
        sys.exit(1)


def cmd_fix(
    project: str | None = None,
    dry_run: bool = False,
    no_commit: bool = False,
) -> None:
    """Auto-heal IDs, statuses, and snapshot drift."""
    root = get_repo_root()
    snap = FsSnapshot(root)
    if project:
        require_project(snap, project)

    findings = audit_workspace(root, project)
    fixable = [f for f in findings if f.remediation is not None]

    if not fixable:
        unfixable = [f for f in findings if f.severity in ("WARN", "FAIL")]
        if unfixable:
            for f in unfixable:
                print(
                    _tagged(
                        f"[{f.severity}]  Manual fix required: {f.message}", sys.stderr
                    ),
                    file=sys.stderr,
                )
        else:
            print(
                _tagged("[INFO]  Workspace is clean, no fixes needed.", sys.stderr),
                file=sys.stderr,
            )
        return

    if dry_run:
        print(
            _tagged(
                f"[INFO]  Dry run: {len(fixable)} repair(s) would be applied:",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        dry_run_files: set[str] = set()
        for f in fixable:
            print(_tagged(f"[INFO]    - {f.message}", sys.stderr), file=sys.stderr)
            if f.path:
                dry_run_files.add(f.path)
        if dry_run_files:
            print("\n".join(sorted(dry_run_files)))
        return

    # Invariant: assert clean Git index before mutating
    diff_cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if diff_cached.returncode != 0:
        die("fix: git index contains staged changes; unstage or commit them first")

    # Execute all remediations and collect explicitly touched paths (deduplicated)
    touched_paths: set[str] = set()
    executed_remediations = set()
    for f in fixable:
        if f.remediation in executed_remediations:
            continue
        executed_remediations.add(f.remediation)
        res = f.remediation()
        if res:
            for p in res:
                touched_paths.add(p)
        elif f.path:
            touched_paths.add(f.path)

    # Re-run audit to verify convergence
    post_findings = audit_workspace(root, project)
    remaining_errors = [f for f in post_findings if f.severity in ("WARN", "FAIL")]
    if remaining_errors:
        for f in remaining_errors:
            print(
                _tagged(
                    f"[{f.severity}]  Still open after fix: {f.message}", sys.stderr
                ),
                file=sys.stderr,
            )

    # Ensure all affected projects have their STATUS.md synchronized and included if modified
    affected_projects: set[str] = set()
    if project:
        affected_projects.add(project)
    for tp in touched_paths:
        parts = tp.split("/")
        if len(parts) > 1 and is_project(snap, parts[0]):
            affected_projects.add(parts[0])

    for proj_name in affected_projects:
        sync_status(snap, proj_name)
        status_p = f"{proj_name}/STATUS.md"
        if snap.is_file(status_p):
            touched_paths.add(status_p)

    # Keep the touched files that have modifications or were created/deleted
    modified_files: list[str] = []
    for rel in sorted(touched_paths, key=path_key):
        st = run_git(["status", "--porcelain", "--", rel], check=False).stdout.strip()
        if st and rel not in modified_files:
            modified_files.append(rel)

    if not modified_files:
        print(
            _tagged("[INFO]  Workspace is clean, no files changed.", sys.stderr),
            file=sys.stderr,
        )
        return

    if no_commit:
        print(
            _tagged(
                f"[INFO]  Applied {len(modified_files)} repair(s) without commit (--no-commit).",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        print("\n".join(modified_files))
        return

    if not has_commit_auth(root):
        print(
            _tagged(
                f"[INFO]  Applied {len(modified_files)} repair(s) (commit skipped: no auth marker).",
                sys.stderr,
            ),
            file=sys.stderr,
        )
        print("\n".join(modified_files))
        return

    run_git(["add", "--", *modified_files])
    commit_msg = conventional_subject("fix metadata and status", project) + "\n"
    run_git(["commit", "--no-verify", "--no-gpg-sign", "-m", commit_msg])
    commit_sha = run_git(["rev-parse", "HEAD"]).stdout.strip()

    print(
        _tagged(
            f"[INFO]  Committed {len(modified_files)} fixed file(s): {commit_sha[:10]}",
            sys.stderr,
        ),
        file=sys.stderr,
    )

    # Machine-readable output contract on stdout
    print(f"COMMIT_SHA: {commit_sha}")
    print(f"MODIFIED: {','.join(modified_files)}")
    print(f"SUMMARY: {commit_msg.strip()}")


_BUG_URI_RE = re.compile(r"^b/(\d+)$", re.IGNORECASE)
_CL_URI_RE = re.compile(r"^cl/(\d+)$", re.IGNORECASE)
_GH_URI_RE = re.compile(r"^gh:([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#(\d+)$", re.IGNORECASE)

_BUG_TERMINAL_STATES = {"FIXED", "WONT_FIX", "DUPLICATE", "OBSOLETE"}
_CL_TERMINAL_STATES = {"MERGED", "SUBMITTED", "ABANDONED"}
_GH_TERMINAL_STATES = {"CLOSED", "MERGED"}


@dataclass(slots=True, frozen=True)
class CheckTrigger:
    kind: Literal[
        "wait_for_elapsed",
        "wait_for_resolved",
        "wait_for_activity",
        "due_overdue",
        "due_soon",
        "stale",
    ]
    gate: str | None
    detail: str
    upstream_state: str | None = None
    upstream_modified: str | None = None


def _is_offline() -> bool:
    return os.environ.get("AGENT_OFFLINE", "").strip().lower() in {
        "1",
        "true",
        "yes",
        "on",
    }


def parse_iso_timestamp(value: Any) -> datetime | None:
    """Parses an ISO 8601 or Perforce timestamp string into an aware UTC datetime."""
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, datetime):
        return value if value.tzinfo is not None else value.replace(tzinfo=timezone.utc)
    s = str(value).strip().strip("'\"")
    if not s:
        return None
    normalized = re.sub(r"^(\d{4})/(\d{2})/(\d{2})\b", r"\1-\2-\3", s)
    try:
        dt = datetime.fromisoformat(normalized)
        return dt if dt.tzinfo is not None else dt.replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def get_task_watermark(root: Path, row: TaskRow) -> tuple[str | None, datetime | None]:
    """Returns (iso_str, aware_datetime) for the latest task-scoped commit on row.rel_path.

    Uses `git log -1 --grep="^Task: <ID>$" --format=%cI -- <task_file>` first so
    mechanical formatting sweeps (`taskgo fix`) cannot advance the watermark,
    falling back to `git log -1 --format=%cI -- <task_file>`.
    """
    ts_str = ""
    if row.task_id:
        res = run_git(
            [
                "log",
                "-1",
                f"--grep=^Task: {row.task_id}$",
                "--format=%cI",
                "--",
                row.rel_path,
            ],
            cwd=root,
            check=False,
        )
        if res.returncode == 0:
            ts_str = res.stdout.strip()
    if not ts_str:
        res = run_git(
            ["log", "-1", "--format=%cI", "--", row.rel_path],
            cwd=root,
            check=False,
        )
        if res.returncode == 0:
            ts_str = res.stdout.strip()
    if not ts_str:
        return None, None
    return ts_str, parse_iso_timestamp(ts_str)


def _run_probe_cmd(cmd: list[str], timeout_sec: float = 10.0) -> str | None:
    """Runs a read-only external probe command gracefully, returning stdout or None."""
    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError:
        return None
    _active_subprocesses.add(proc)
    try:
        stdout, _ = proc.communicate(timeout=timeout_sec)
    except (subprocess.TimeoutExpired, OSError):
        try:
            proc.kill()
            proc.wait(timeout=1.0)
        except (OSError, subprocess.SubprocessError):
            pass
        return None
    finally:
        _active_subprocesses.discard(proc)
    if proc.returncode != 0:
        return None
    return stdout or ""


def poll_external_uri(
    gate: str,
) -> tuple[str, bool, datetime | None, str | None] | None:
    """Polls an external wait_for URI (`b/<id>`, `cl/<id>`, `gh:owner/repo#num`).

    Returns `(canonical_status, is_terminal, modified_dt, modified_str)`, or `None`
    when `gate` is not an external URI or when corp/network tools are unavailable.
    """
    if _is_offline():
        return None

    if m_bug := _BUG_URI_RE.match(gate):
        issues_bin = shutil.which("issues")
        if not issues_bin:
            default_issues = Path("/google/bin/releases/issues-cli/issues")
            if default_issues.is_file() and os.access(default_issues, os.X_OK):
                issues_bin = str(default_issues)
        if not issues_bin:
            return None
        out = _run_probe_cmd(
            [issues_bin, "readonly", "get-issue-metadata", m_bug.group(1)]
        )
        if out is None:
            return None
        raw_status: str | None = None
        raw_mod: str | None = None
        for line in out.splitlines():
            key, sep, val = line.partition(":")
            if not sep:
                continue
            k = key.strip().lower()
            v = val.strip()
            if k == "status":
                raw_status = v
            elif k == "last modified":
                raw_mod = v
        if not raw_status and not raw_mod:
            return None
        norm_status = (raw_status or "OPEN").upper().replace("-", "_").replace(" ", "_")
        if norm_status == "WONTFIX":
            norm_status = "WONT_FIX"
        return (
            norm_status,
            norm_status in _BUG_TERMINAL_STATES,
            parse_iso_timestamp(raw_mod),
            raw_mod,
        )

    if m_cl := _CL_URI_RE.match(gate):
        g4_bin = shutil.which("g4")
        if not g4_bin:
            return None
        out = _run_probe_cmd([g4_bin, "describe", "-s", m_cl.group(1)])
        if out is None:
            return None
        first_line = next((ln.strip() for ln in out.splitlines() if ln.strip()), "")
        m_redir = re.match(r"^Change\s+\d+\s+is\s+([A-Za-z_-]+)", first_line)
        if m_redir:
            norm_status = m_redir.group(1).upper().replace("-", "_")
            return norm_status, norm_status in _CL_TERMINAL_STATES, None, None
        m_hdr = re.match(
            r"^Change\s+\d+\s+by\s+\S+\s+on\s+(\d{4}/\d{2}/\d{2}\s+\d{2}:\d{2}:\d{2})(?:\s+\*([^*]+)\*)?",
            first_line,
        )
        if not m_hdr:
            return None
        raw_mod = m_hdr.group(1)
        norm_status = (m_hdr.group(2) or "SUBMITTED").strip().upper().replace("-", "_")
        return (
            norm_status,
            norm_status in _CL_TERMINAL_STATES,
            parse_iso_timestamp(raw_mod),
            raw_mod,
        )

    if m_gh := _GH_URI_RE.match(gate):
        gh_bin = shutil.which("gh")
        if not gh_bin:
            return None
        out = _run_probe_cmd(
            [
                gh_bin,
                "issue",
                "view",
                m_gh.group(2),
                "--repo",
                m_gh.group(1),
                "--json",
                "state,updatedAt",
            ]
        )
        if out is None:
            return None
        try:
            data = json.loads(out)
        except json.JSONDecodeError:
            return None
        if not isinstance(data, dict):
            return None
        raw_status = str(data.get("state") or "").strip() or None
        raw_mod = str(data.get("updatedAt") or "").strip() or None
        if not raw_status and not raw_mod:
            return None
        norm_status = (raw_status or "OPEN").upper().replace("-", "_")
        return (
            norm_status,
            norm_status in _GH_TERMINAL_STATES,
            parse_iso_timestamp(raw_mod),
            raw_mod,
        )

    return None


def cmd_check(
    project: str | None = None,
    as_json: bool = False,
) -> None:
    """Evaluate wait_for gates, due deadlines, and stale_after cutoffs."""
    root = get_repo_root()
    snap = FsSnapshot(root)
    if project:
        require_project(snap, project)

    today = get_today(snap)
    rows = get_task_rows(snap, project)
    probe_cache: dict[str, tuple[str, bool, datetime | None, str | None] | None] = {}

    triggered_entries: list[tuple[TaskRow, str | None, list[CheckTrigger]]] = []

    for row in rows:
        if row.status in RESOLVED_STATES:
            continue
        if not (row.wait_for or row.due or row.stale_after):
            continue

        triggers: list[CheckTrigger] = []
        watermark_cached: tuple[str | None, datetime | None] | None = None

        def get_wm(r: TaskRow = row) -> tuple[str | None, datetime | None]:
            nonlocal watermark_cached
            if watermark_cached is None:
                watermark_cached = get_task_watermark(root, r)
            return watermark_cached

        for gate in row.wait_for:
            gate_date = parse_iso_date(gate)
            if gate_date is not None:
                if today >= gate_date:
                    triggers.append(
                        CheckTrigger(
                            kind="wait_for_elapsed",
                            gate=gate,
                            detail=f"wait_for date {gate_date.isoformat()} elapsed",
                        )
                    )
                continue

            if gate not in probe_cache:
                probe_cache[gate] = poll_external_uri(gate)
            polled = probe_cache[gate]
            if polled is None:
                continue

            up_status, is_terminal, mod_dt, mod_str = polled
            if is_terminal:
                triggers.append(
                    CheckTrigger(
                        kind="wait_for_resolved",
                        gate=gate,
                        detail=f"wait_for {gate} resolved ({up_status})",
                        upstream_state=up_status,
                        upstream_modified=mod_str,
                    )
                )
            elif mod_dt is not None:
                _, wm_dt = get_wm()
                if wm_dt is None or mod_dt > wm_dt:
                    triggers.append(
                        CheckTrigger(
                            kind="wait_for_activity",
                            gate=gate,
                            detail=(
                                f"wait_for {gate} updated ({up_status} at "
                                f"{mod_str or mod_dt.isoformat()})"
                            ),
                            upstream_state=up_status,
                            upstream_modified=mod_str or mod_dt.isoformat(),
                        )
                    )

        if row.due is not None:
            due_date = parse_iso_date(row.due)
            if due_date is not None:
                if today > due_date:
                    triggers.append(
                        CheckTrigger(
                            kind="due_overdue",
                            gate=due_date.isoformat(),
                            detail=(
                                f"overdue (due {due_date.isoformat()}, "
                                f"{(today - due_date).days}d ago)"
                            ),
                        )
                    )
                elif due_date <= today + timedelta(days=2):
                    triggers.append(
                        CheckTrigger(
                            kind="due_soon",
                            gate=due_date.isoformat(),
                            detail=f"due soon (due {due_date.isoformat()}, within 48h)",
                        )
                    )

        if row.stale_after is not None:
            stale_date = parse_iso_date(row.stale_after)
            if stale_date is not None and today > stale_date:
                triggers.append(
                    CheckTrigger(
                        kind="stale",
                        gate=stale_date.isoformat(),
                        detail=f"stale task (stale_after {stale_date.isoformat()})",
                    )
                )

        if triggers:
            wm_str, _ = get_wm()
            triggered_entries.append((row, wm_str, triggers))

    if not triggered_entries:
        return

    if as_json:
        out = [
            {
                "project": r.project,
                "id": r.task_id,
                "status": r.status,
                "title": r.title,
                "path": r.rel_path,
                "watermark": wm_str,
                "wait_for": list(r.wait_for),
                "due": r.due,
                "stale_after": r.stale_after,
                "triggers": [
                    {
                        "kind": t.kind,
                        "gate": t.gate,
                        "detail": t.detail,
                        **(
                            {"upstream_state": t.upstream_state}
                            if t.upstream_state is not None
                            else {}
                        ),
                        **(
                            {"upstream_modified": t.upstream_modified}
                            if t.upstream_modified is not None
                            else {}
                        ),
                    }
                    for t in trigs
                ],
            }
            for r, wm_str, trigs in triggered_entries
        ]
        print(json.dumps(out, indent=2))
        return

    for r, _, trigs in triggered_entries:
        summary = "; ".join(t.detail for t in trigs)
        print(
            f"{r.project}\t{r.task_id}\t{r.status or '(missing)'}\t{summary}\t{r.rel_path}"
        )


@dataclass(slots=True, frozen=True)
class FieldChange:
    date: str
    before: str
    after: str
    sha: str
    subject: str


def field_history(
    versions: list[tuple[str, str, str, str]], field: str
) -> list[FieldChange]:
    """Changes of frontmatter FIELD across VERSIONS, oldest first.

    Each version is (commit SHA, date, subject, file content). A version whose
    value equals the previous one is skipped; the first has before '(none)'.
    """
    changes: list[FieldChange] = []
    prev = "__x"
    for sha, d, s, content in versions:
        v = extract_frontmatter_field(content, field)
        if v == prev:
            continue
        prev_label = "(none)" if prev == "__x" else prev
        changes.append(FieldChange(d, prev_label, v or "(missing)", sha, s))
        prev = v
    return changes


def format_field_change(c: FieldChange) -> str:
    return f"{c.date}\t{c.before} -> {c.after}\t{c.sha[:10]}\t{c.subject}"


def file_versions(
    repo: Path, rev: str, rel_path: str
) -> list[tuple[str, str, str, str]]:
    """Every committed version of REL_PATH reachable from REV, oldest first,
    following renames, as field_history takes them."""
    cmd = [
        "log",
        "--follow",
        "--name-only",
        "--format=COMMIT:%H\t%ad\t%s",
        "--date=short",
        rev,
        "--",
        rel_path,
    ]
    res = run_git(cmd, cwd=repo)

    entries: list[tuple[str, str, str, str]] = []
    cur_sha = ""
    cur_date = ""
    cur_subj = ""

    for line in res.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith("COMMIT:"):
            parts = line[len("COMMIT:") :].split("\t", 2)
            cur_sha = parts[0]
            cur_date = parts[1] if len(parts) > 1 else ""
            cur_subj = parts[2] if len(parts) > 2 else ""
        else:
            entries.append((cur_sha, cur_date, cur_subj, line))

    versions: list[tuple[str, str, str, str]] = []
    for sha, d, s, p in reversed(entries):
        show_res = run_git(["show", f"{sha}:{p}"], cwd=repo, check=False)
        if show_res.returncode != 0:
            continue
        versions.append((sha, d, s, show_res.stdout))
    return versions


def cmd_history(query: str, field: str = "status") -> None:
    """Show frontmatter field history across git revisions."""
    root = get_repo_root()
    target_path = resolve_target(root, query, allow_deleted=True)
    rel_path = str(target_path.relative_to(root))

    versions = file_versions(root, "HEAD", rel_path)
    if not versions:
        die(f"no git history for {rel_path}")

    for change in field_history(versions, field):
        print(format_field_change(change))


# Most bytes of file content one read returns, from the CLI or the MCP server.
READ_MAX_BYTES = 256 * 1024


def read_line_arg(name: str, value: Any) -> int | None:
    """VALUE as a line number argument, or None when it is absent."""
    if value is None:
        return None
    if isinstance(value, bool) or not isinstance(value, int):
        raise TaskgoError(f"{name} must be an integer, not {value!r}")
    return value


def read_slice(
    rel: str,
    blob: str | None,
    data: bytes,
    start_line: Any = None,
    end_line: Any = None,
    limit: int = READ_MAX_BYTES,
    line_numbers: bool = False,
) -> dict[str, Any]:
    """The read of lines START_LINE..END_LINE of file REL, whose bytes are DATA.

    Lines are 1-indexed and inclusive, and end at '\\n' only, as in 'git grep
    -n' and sed; the content is the file's bytes, with no line endings
    rewritten. The range is clamped to the file: a start past the end, or
    after the end line, reads nothing. At most LIMIT bytes of content are
    returned, cut after the last whole line that fits; truncated then says so,
    end_line names the last line returned, and the next read starts at
    end_line + 1. A first line longer than LIMIT is cut at a character
    boundary. With LINE_NUMBERS, each line is prefixed with its number and
    ': ' (as in '7: text'), the limit counts the prefixes, and the content is
    no longer the file's bytes.
    """
    if not isinstance(line_numbers, bool):
        raise TaskgoError(f"line_numbers must be true or false, not {line_numbers!r}")
    start = read_line_arg("start_line", start_line)
    end = read_line_arg("end_line", end_line)
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise TaskgoError(f"{rel} is not UTF-8 text") from None
    lines = [ln + "\n" for ln in text.split("\n")]
    lines[-1] = lines[-1][:-1]  # the text after the last newline
    if not lines[-1]:
        lines.pop()  # a final newline ends the last line; it starts none
    total = len(lines)
    s = max(1, 1 if start is None else start)
    e = total if end is None else min(total, max(0, end))
    parts: list[str] = []
    used = 0
    truncated = False
    last = s - 1
    for i in range(s, e + 1):
        line = f"{i}: {lines[i - 1]}" if line_numbers else lines[i - 1]
        size = len(line.encode("utf-8"))
        if used + size > limit:
            truncated = True
            if not parts:
                cut = line.encode("utf-8")[:limit]
                parts.append(cut.decode("utf-8", "ignore"))
                last = i
            break
        parts.append(line)
        used += size
        last = i
    result = {
        "path": rel,
        "blob": blob,
        "size": len(data),
        "start_line": s,
        "end_line": last if s <= e else e,
        "total_lines": total,
        "truncated": truncated,
        "content": "".join(parts),
    }
    if line_numbers:
        result["line_numbers"] = True
    return result


def cmd_read(
    path: str,
    start_line: int | None = None,
    end_line: int | None = None,
    at: str | None = None,
    as_json: bool = False,
    line_numbers: bool = False,
) -> None:
    """Print lines of a file in the working tree, or in commit AT."""
    root = get_repo_root()
    try:
        rel = clean_rel_path(path)
    except TaskgoError:
        die_scoped(f"invalid path: {path!r}")
    if at:
        sha = resolve_commit(root, at)
        if sha is None:
            die_scoped(f"no commit {at} in the control repository")
        snap = GitTreeSnapshot(root, sha)
        blob = snap.blobs.get(rel)
        if blob is None:
            if snap.is_dir(rel):
                die_scoped(f"{rel} is a directory")
            die_scoped(f"{rel} is not in commit {snap.rev[:12]}")
        data = run_git(["cat-file", "blob", blob], cwd=root, text=False).stdout
    else:
        target = root / rel
        if not target.resolve().is_relative_to(root.resolve()):
            die_scoped(f"invalid path: {path!r}")
        if target.is_dir():
            die_scoped(f"{rel} is a directory")
        if not target.is_file():
            die_scoped(f"{rel} does not exist")
        data = target.read_bytes()
        hashed = run_git(["hash-object", "--", rel], cwd=root, check=False)
        blob = hashed.stdout.strip() if hashed.returncode == 0 else None
    try:
        result = read_slice(
            rel, blob, data, start_line, end_line, line_numbers=line_numbers
        )
    except TaskgoError as e:
        die_scoped(str(e))
    if as_json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return
    sys.stdout.write(result["content"])
    if result["truncated"]:
        print(
            f"taskgo read: {rel}: stopped at line {result['end_line']} of "
            f"{result['total_lines']} ({READ_MAX_BYTES // 1024} KiB limit); "
            f"continue with --start-line {result['end_line'] + 1}",
            file=sys.stderr,
        )


# Most bytes of output one search returns, from the CLI or the MCP server, and
# the most bytes of any one output line; a longer line is cut and marked.
SEARCH_MAX_BYTES = 64 * 1024
SEARCH_LINE_MAX_BYTES = 1024
SEARCH_LINE_MARK = " ...[truncated]"
SEARCH_TIMEOUT = 30

# The git grep options a search may pass, each mapped to whether it takes a
# value. Anything else is refused, abbreviations included (git would expand
# them): some options read files outside the repository (-f, --no-index),
# search other trees (--cached, --untracked, --recurse-submodules), run
# commands (-O, --textconv), or reshape the output taskgo parses (-h, -z,
# --heading, --color).
SEARCH_SHORT_OPTIONS = {
    **dict.fromkeys("GEFPiwvnlLcoWpI", False),
    **dict.fromkeys("eABCm", True),
}
SEARCH_LONG_OPTIONS = {
    **dict.fromkeys(
        (
            "--basic-regexp",
            "--extended-regexp",
            "--fixed-strings",
            "--perl-regexp",
            "--ignore-case",
            "--word-regexp",
            "--invert-match",
            "--and",
            "--or",
            "--not",
            "--all-match",
            "--function-context",
            "--show-function",
            "--line-number",
            "--files-with-matches",
            "--name-only",
            "--files-without-match",
            "--count",
            "--only-matching",
        ),
        False,
    ),
    **dict.fromkeys(
        (
            "--after-context",
            "--before-context",
            "--context",
            "--max-count",
            "--max-depth",
        ),
        True,
    ),
}

# Configuration that would change what git grep searches or how it prints:
# pinned so that user and repository settings cannot. With core.quotePath
# off, paths with non-ASCII characters print as they are, not C-quoted.
SEARCH_GIT_CONFIG = (
    "core.pager=",
    "core.quotePath=false",
    "color.grep=never",
    "grep.column=false",
    "grep.fullName=false",
    "grep.lineNumber=true",
    "grep.patternType=basic",
    "grep.extendedRegexp=false",
    "grep.fallbackToNoIndex=false",
    "submodule.recurse=false",
)


@dataclass(slots=True)
class SearchArgs:
    """A validated search: git grep options with every pattern behind -e."""

    argv: list[str]
    paths: list[str]
    at: str | None = None
    as_json: bool = False


def search_path(path: Any) -> str:
    """PATH as a repository-relative pathspec ('' for '.'), or a TaskgoError."""
    if isinstance(path, str) and path.strip().strip("/") == ".":
        return ""
    return clean_rel_path(path)


def parse_search_args(
    tokens: Any, paths: Any = None, *, cli: bool = False
) -> SearchArgs:
    """TOKENS, git grep arguments, checked against the option allowlist.

    Tokens after '--' are pathspecs, as are PATHS. A search has one bare
    pattern, or patterns given with -e, never both: git would read a second
    bare token as a tree to search. The bare pattern is passed as '-e
    PATTERN', so options may follow it. With CLI, '--at REV' and '--json'
    are taskgo's own options.
    """
    if tokens is None:
        tokens = []
    if paths is None:
        paths = []
    if not isinstance(tokens, list) or not isinstance(paths, list):
        raise TaskgoError("args and paths must be lists of strings")
    for t in [*tokens, *paths]:
        if not isinstance(t, str):
            raise TaskgoError(f"arguments must be strings, not {t!r}")
        if "\0" in t:
            raise TaskgoError(f"arguments must not contain NUL: {t!r}")
    out = SearchArgs([], [sp for p in paths if (sp := search_path(p))])
    bare: list[str] = []
    with_e = 0
    i, n = 0, len(tokens)

    def value(opt: str) -> str:
        nonlocal i
        i += 1
        if i >= n:
            raise TaskgoError(f"option {opt} needs a value")
        return tokens[i]

    while i < n:
        t = tokens[i]
        if t == "--":
            out.paths += [sp for p in tokens[i + 1 :] if (sp := search_path(p))]
            break
        if cli and t in ("--json", "-j"):
            out.as_json = True
        elif cli and t == "--at":
            out.at = value(t)
        elif cli and t.startswith("--at="):
            out.at = t.partition("=")[2]
        elif t in ("(", ")"):
            out.argv.append(t)
        elif t.startswith("--"):
            name, eq, val = t.partition("=")
            if name not in SEARCH_LONG_OPTIONS:
                raise TaskgoError(f"option {name} is not allowed in a search")
            if SEARCH_LONG_OPTIONS[name]:
                out.argv += [name, val if eq else value(name)]
            elif eq:
                raise TaskgoError(f"option {name} takes no value")
            else:
                out.argv.append(name)
        elif t.startswith("-") and len(t) > 1:
            for j, c in enumerate(t[1:], start=1):
                if c not in SEARCH_SHORT_OPTIONS:
                    raise TaskgoError(f"option -{c} is not allowed in a search")
                if SEARCH_SHORT_OPTIONS[c]:
                    out.argv += [f"-{c}", t[j + 1 :] or value(f"-{c}")]
                    with_e += c == "e"
                    break
                out.argv.append(f"-{c}")
        else:
            bare.append(t)
            out.argv += ["-e", t]
        i += 1
    if len(bare) > 1:
        raise TaskgoError(
            f"more than one bare pattern ({', '.join(map(repr, bare))}); "
            "give each pattern with -e, and paths after '--' or in paths"
        )
    if bare and with_e:
        raise TaskgoError(
            f"bare pattern {bare[0]!r} given with -e; give every pattern with -e"
        )
    if not bare and not with_e:
        raise TaskgoError("no pattern given")
    return out


# A path followed by what git grep prints after one: a line number and its
# separator (':' match, '-' context, '=' function), or a count after ':'.
_SEARCH_AFTER_PATH = re.compile(r"\d+[:=-]|\d+$")


def search_line_path(line: str, known: set[str]) -> str | None:
    """The file that output LINE names, given the files KNOWN to the search."""
    if line in known:
        return line  # -l and -L print the bare path
    for i, c in enumerate(line):
        if c in ":-=" and line[:i] in known and _SEARCH_AFTER_PATH.match(line[i + 1 :]):
            return line[:i]
    return None


def run_search(
    repo: Path,
    search: SearchArgs,
    rev: str | None,
    known: set[str],
    limit: int = SEARCH_MAX_BYTES,
) -> tuple[dict[str, Any], bool]:
    """Runs SEARCH over commit REV, or the working tree: (result, matched).

    The result has the output with REV's prefix stripped, so each path is
    repository-relative; the files it names, in order; and truncated. Output
    is read as git prints it, and git is stopped once LIMIT bytes are
    read, or after SEARCH_TIMEOUT seconds. A git error is a TaskgoError
    with git's message.
    """
    import tempfile
    import threading

    cmd = ["git"]
    for setting in SEARCH_GIT_CONFIG:
        cmd += ["-c", setting]
    cmd += ["grep", "--no-color", "-n", "-I", *search.argv]
    if rev:
        cmd.append(rev)
    cmd += ["--", *search.paths]
    prefix = f"{rev}:".encode() if rev else b""
    cap = SEARCH_LINE_MAX_BYTES
    lines: list[str] = []
    files: dict[str, None] = {}
    used = 0
    truncated = False
    timed_out = threading.Event()
    with tempfile.TemporaryFile() as err:
        proc = subprocess.Popen(
            cmd,
            cwd=repo,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=err,
            env=dict(os.environ, GIT_TERMINAL_PROMPT="0"),
        )
        _active_subprocesses.add(proc)

        def expire() -> None:
            timed_out.set()
            proc.kill()

        timer = threading.Timer(SEARCH_TIMEOUT, expire)
        timer.start()
        try:
            assert proc.stdout is not None
            while True:
                raw = proc.stdout.readline(len(prefix) + cap + 1)
                if not raw:
                    break
                cut = not raw.endswith(b"\n")
                if cut and len(raw) <= len(prefix) + cap:
                    cut = False  # the last line, with no newline
                elif cut:
                    while (rest := proc.stdout.readline(65536)) and not (
                        rest.endswith(b"\n")
                    ):
                        pass
                raw = raw.rstrip(b"\n")
                if prefix and raw.startswith(prefix):
                    raw = raw[len(prefix) :]
                if cut or len(raw) > cap:
                    end = cap
                    while end > 0 and raw[end] & 0xC0 == 0x80:
                        end -= 1  # inside a UTF-8 character
                    text = raw[:end].decode("utf-8", "replace") + SEARCH_LINE_MARK
                else:
                    text = raw.decode("utf-8", "replace")
                size = len(text.encode("utf-8")) + 1
                if used + size > limit:
                    truncated = True
                    proc.kill()
                    break
                used += size
                lines.append(text)
                path = search_line_path(text, known)
                if path is not None:
                    files[path] = None
            proc.wait()
        finally:
            timer.cancel()
            if proc.poll() is None:
                proc.kill()
                proc.wait()
            _active_subprocesses.discard(proc)
        err.seek(0)
        stderr = err.read().decode("utf-8", "replace").strip()
    if timed_out.is_set():
        raise TaskgoError(
            f"search timed out after {SEARCH_TIMEOUT} s; narrow it with paths, "
            "a simpler pattern, -l, or -m"
        )
    if not truncated and proc.returncode not in (0, 1):
        raise TaskgoError(stderr or f"git grep failed (exit {proc.returncode})")
    result = {
        "output": "".join(line + "\n" for line in lines),
        "files": list(files),
        "truncated": truncated,
    }
    return result, truncated or proc.returncode == 0


def cmd_search(tokens: list[str]) -> None:
    """Search the working tree, or commit --at REV, with git grep."""
    try:
        search = parse_search_args(tokens, cli=True)
    except TaskgoError as e:
        die_scoped(str(e), 2)
    root = get_repo_root()
    if search.at:
        rev = resolve_commit(root, search.at)
        if rev is None:
            die_scoped(f"no commit {search.at} in the control repository", 2)
        known = set(GitTreeSnapshot(root, rev).blobs)
    else:
        rev = None
        listed = run_git(["ls-files", "-z"], cwd=root).stdout
        known = set(filter(None, listed.split("\0")))
    try:
        result, matched = run_search(root, search, rev, known)
    except TaskgoError as e:
        die_scoped(str(e), 2)
    if search.as_json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        sys.stdout.write(result["output"])
    if result["truncated"]:
        print(
            f"taskgo search: output stopped at {SEARCH_MAX_BYTES // 1024} KiB; "
            "narrow the search with paths, -l, or -m",
            file=sys.stderr,
        )
    sys.exit(0 if matched else 1)


def cmd_checkpoint(
    task_id: str,
    subject: str,
    all_files: bool = False,
    paths: list[str] | None = None,
    body: str = "",
    refs: list[str] | None = None,
    conv: str | None = None,
) -> None:
    """Commit an authorized tracker checkpoint for TASK_ID."""
    paths_list = paths or []
    refs_list = refs or []
    session = get_active_session(conv)
    conv_uri = f"{session[0]}://{session[1]}" if session else None

    root = get_repo_root()
    if not ID_PATTERN.match(task_id):
        die(f"checkpoint: invalid task ID: {task_id}")

    if not has_commit_auth(root):
        die(f"checkpoint: committed AGENTS.md must contain {COMMIT_AUTH}")

    # Index must be empty
    diff_cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if diff_cached.returncode != 0:
        die("checkpoint: index is not empty")

    target_path = resolve_target(root, task_id)
    rel_path = str(target_path.relative_to(root))
    project_name = Path(rel_path).as_posix().split("/")[0]
    snap = FsSnapshot(root)
    require_project(snap, project_name)
    status_rel = f"{project_name}/STATUS.md"

    requested = [rel_path, status_rel]
    for p_arg in paths_list:
        p_clean = p_arg.removeprefix("./")
        if p_clean.startswith("/") or ".." in p_clean.split("/"):
            die(f"checkpoint: unsafe path: {p_arg}")
        if not p_clean.startswith(f"{project_name}/"):
            die(f"checkpoint: path is outside project {project_name}: {p_arg}")
        is_existing_file = (root / p_clean).is_file()
        is_git_deleted = bool(
            run_git(["status", "--porcelain", "--", p_clean]).stdout.strip()
        )
        if not is_existing_file and not is_git_deleted:
            die(f"checkpoint: path not found: {p_arg}")
        requested.append(p_clean)

    # Synchronize status for project
    sync_status(snap, project_name)

    # Find project changes
    diff_proj = [
        f
        for f in run_git(
            ["diff", "-z", "--name-only", "--", f"{project_name}/"]
        ).stdout.split("\0")
        if f
    ]
    untracked_proj = [
        f
        for f in run_git(
            [
                "ls-files",
                "-z",
                "--others",
                "--exclude-standard",
                "--",
                f"{project_name}/",
            ]
        ).stdout.split("\0")
        if f
    ]
    all_changed = sorted(set(diff_proj + untracked_proj))

    if all_files:
        requested = sorted(set(requested + [c for c in all_changed if c]))

    # Check that at least one project file has changes
    has_changes = any(
        bool(run_git(["status", "--porcelain", "--", req]).stdout.strip())
        for req in requested
    )
    if not has_changes:
        die("checkpoint: no project changes detected to commit")

    # Check for unlisted project changes
    unlisted = [c for c in all_changed if c and c not in requested]
    if unlisted:
        suggested = " ".join(f"--path {p}" for p in unlisted)
        print(
            f"[HINT] To include unlisted project file(s), add --all or: {suggested}",
            file=sys.stderr,
        )
        die(f"checkpoint: unlisted project change: {unlisted[0]}")

    # Run doctor in-process
    findings = audit_workspace(root, project_name)
    if any(f.severity in ("WARN", "FAIL") for f in findings):
        die("checkpoint: doctor found errors")

    if session:
        scheme, c_id = session
        try:
            t_content = target_path.read_text(encoding="utf-8")
            t_data, t_body = parse_frontmatter_for_edit(t_content)
            if update_task_conversation(t_data, scheme, c_id):
                new_content = f"{dump_frontmatter(t_data)}{t_body}"
                write_markdown(target_path, new_content)
        except Exception as e:
            print(
                _tagged(
                    f"[WARN]  Failed to update task frontmatter: {e}",
                    sys.stderr,
                ),
                file=sys.stderr,
            )

    # Stage requested files
    try:
        run_git(["add", "--", *requested])
        cached_check = run_git(["diff", "--cached", "--quiet"], check=False)
        if cached_check.returncode == 0:
            die("checkpoint: nothing to commit")

        staged_files = [
            f
            for f in run_git(["diff", "-z", "--cached", "--name-only"]).stdout.split(
                "\0"
            )
            if f
        ]
        for sf in staged_files:
            if sf and sf not in requested:
                die(f"checkpoint: refused staged path: {sf}")

        subject = ensure_conventional_subject(subject, project_name)
        wrapped_body = wrap_body(body)
        if body and wrapped_body != body:
            print(
                _tagged(
                    "[WARN]  Rewrapped commit body to fit 72 characters", sys.stderr
                ),
                file=sys.stderr,
            )
        msg_lines = [subject]
        if body:
            msg_lines.extend(["", wrapped_body])
        trailers = []
        if conv_uri:
            trailers.append(f"Conversation: {conv_uri}")
        for r in refs_list:
            trailers.append(f"Ref: {r}")
        if trailers:
            msg_lines.append("")
            msg_lines.extend(trailers)
        msg = "\n".join(msg_lines) + "\n"

        run_git(["commit", "--no-verify", "--no-gpg-sign", "-F", "-"], input_data=msg)
    except BaseException:
        run_git(["restore", "--staged", "--", *requested], check=False)
        raise


def cmd_commit(
    subject: str,
    body: str = "",
    refs: list[str] | None = None,
    conv: str | None = None,
) -> None:
    """Commit a logical transition with automatic project status synchronization."""
    refs_list = refs or []
    session = get_active_session(conv)
    conv_uri = f"{session[0]}://{session[1]}" if session else None
    root = get_repo_root()
    snap = FsSnapshot(root)
    if not has_commit_auth(root):
        die(f"commit: committed AGENTS.md must contain {COMMIT_AUTH}")

    diff_cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if diff_cached.returncode == 0:
        die("nothing staged")

    staged_files = [
        f
        for f in run_git(["diff", "-z", "--cached", "--name-only"]).stdout.split("\0")
        if f
    ]
    projects = {
        f.split("/")[0]
        for f in staged_files
        if "/" in f and is_project(snap, f.split("/")[0])
    }
    if len(projects) > 1:
        die("staged changes touch multiple projects")

    if projects:
        project_name = next(iter(projects))
        require_project(snap, project_name)
        findings = audit_workspace(root, project_name)
        if any(f.severity in ("WARN", "FAIL") for f in findings):
            die("doctor found errors")
        if session:
            scheme, c_id = session
            for sf in staged_files:
                if "/tasks/" in sf and sf.endswith(".md"):
                    p_sf = root / sf
                    if p_sf.is_file():
                        try:
                            t_content = p_sf.read_text(encoding="utf-8")
                            t_data, t_body = parse_frontmatter_for_edit(t_content)
                            if update_task_conversation(t_data, scheme, c_id):
                                new_content = f"{dump_frontmatter(t_data)}{t_body}"
                                write_markdown(p_sf, new_content)
                                run_git(["add", sf])
                        except Exception as e:
                            print(
                                _tagged(
                                    f"[WARN]  Failed to update task frontmatter: {e}",
                                    sys.stderr,
                                ),
                                file=sys.stderr,
                            )
        status_porcelain = run_git(
            ["status", "--porcelain", "--", f"{project_name}/STATUS.md"],
            check=False,
        ).stdout.strip()
        if status_porcelain:
            print(
                _tagged(
                    f"[INFO]  Staging working-tree updates in {project_name}/STATUS.md",
                    sys.stderr,
                ),
                file=sys.stderr,
            )
        if sync_status(snap, project_name):
            run_git(["add", f"{project_name}/STATUS.md"])

    project_for_scope = next(iter(projects)) if projects else None
    subject = ensure_conventional_subject(subject, project_for_scope)
    wrapped_body = wrap_body(body)
    if body and wrapped_body != body:
        print(
            _tagged("[WARN]  Rewrapped commit body to fit 72 characters", sys.stderr),
            file=sys.stderr,
        )
    msg_lines = [subject]
    if body:
        msg_lines.extend(["", wrapped_body])
    trailers = []
    if conv_uri:
        trailers.append(f"Conversation: {conv_uri}")
    for r in refs_list:
        trailers.append(f"Ref: {r}")
    if trailers:
        msg_lines.append("")
        msg_lines.extend(trailers)
    msg = "\n".join(msg_lines) + "\n"

    run_git(["commit", "--no-verify", "--no-gpg-sign", "-F", "-"], input_data=msg)


# ===========================================================================
# MCP server ('taskgo mcp'): tools over committed state
# ===========================================================================
#
# Each read resolves one commit and reads only that commit, through a
# GitTreeSnapshot, so a response is coherent even while main moves. Payloads
# that the CLI also prints use the CLI's own functions, so they match the CLI
# at that commit. Unpinned reads fetch the branch, or use the head fetched or
# pushed in the last few seconds (--fetch-ttl); when the fetch fails, they
# serve the last head fetched, marked stale. Each write applies one change
# set over the head, commits it without a working tree, and pushes it without
# force; a rejected push fetches the head and applies the set again there.
# With --local there is no remote: the local branch is read as it is, and a
# write moves it (compare-and-swap) and refreshes the checkout's touched
# paths, so the CLI keeps working beside the server.
# The MCP Python SDK speaks the protocol (ADR 12): every revision it supports,
# over Streamable HTTP (stateless, with JSON responses) or, with --stdio, for
# one local client.
# Cloudflare Access authenticates callers in front of the server; McpGate
# checks the Access JWT on every HTTP request before the SDK sees it.

MCP_SERVER_VERSION = "0.13.0"
MCP_MAX_FILE_BYTES = READ_MAX_BYTES
MCP_MAX_REQUEST_BYTES = 1024 * 1024
MCP_FETCH_TIMEOUT = 60
MCP_PUSH_TIMEOUT = 60
# Seconds a fetch (or this server's own push) stays fresh for unpinned reads;
# 0 fetches on every call. Half of an agent's back-to-back tool calls come
# within 5s of each other.
MCP_FETCH_TTL = 5.0
# Pushes per write; each rejected one re-reads the head and applies again.
MCP_WRITE_ATTEMPTS = 5
# How long, and for how many requests, a retry is recognized (ADR 2).
MCP_REQUEST_TTL = 24 * 3600
MCP_REQUEST_KEEP = 1000
MCP_REQUEST_ID_MAX = 128
# Commits behind the head searched for a request_id's trailers when the ID
# is not in memory, as after a restart; and the trailers themselves.
MCP_REQUEST_SCAN = 200
MCP_REQUEST_ID_TRAILER = "Request-Id"
MCP_REQUEST_DIGEST_TRAILER = "Request-Digest"
MCP_REQUEST_DIGEST_LEN = 16
MCP_CERTS_TTL = 3600
MCP_LOOPBACK = ("localhost", "127.0.0.1", "::1")
# Answers GET with 200 and no content, unauthenticated, for health checks such
# as a reverse proxy's. It reads nothing.
MCP_HEALTH_PATH = "/up"
# Icons a browser asks for on its own (Safari asks for three on each visit to
# the log page): answered 404, unauthenticated, and not logged.
MCP_ICON_PATHS = re.compile(r"/(?:favicon\.ico|apple-touch-icon[\w-]*\.png)")
# Longest value, and longest reason, in a request's log line.
MCP_LOG_VALUE_MAX = 80
MCP_LOG_REASON_MAX = 200
# The request log: a JSON record for each request, appended to a file that is
# rotated by size, with the latest records kept in memory for the log page.
MCP_LOG_ENV = "TASKGO_MCP_LOG"
MCP_LOG_ROTATE_BYTES = 8 * 1024 * 1024
MCP_LOG_ROTATED = 4  # FILE.1 (newest) to FILE.4: 40 MiB in all
MCP_LOG_RING = 500
# The log page, and the records it polls for. Like the endpoint, both need an
# Access token; neither is part of MCP.
MCP_LOGS_PATH = "/logs"
MCP_LOGS_DATA_PATH = "/logs/records"
# Tool calls by one caller this many seconds apart or less form one chain.
MCP_CHAIN_GAP = 120.0
# Tool arguments a record keeps, shortened: those that name what a call is
# about (a project, a task, a path, a search), never those that carry text
# (titles, bodies, file content, edits) or conversation links.
MCP_LOG_ARGS = (
    "target",
    "project",
    "id",
    "state",
    "path",
    "prefix",
    "field",
    "kind",
    "slug",
    "start_line",
    "end_line",
    "line_numbers",
    "replace_all",
    "args",
    "paths",
    "at",
    "request_id",
)
MCP_LOG_ARG_MAX = 60
# Longest client name the log page and 'taskgo requests' show.
MCP_CLIENT_MAX = 20
# JWT claims that identify a caller, hashed into a record's caller key.
MCP_CALLER_CLAIMS = ("sub", "email", "client_id", "azp")

MCP_DATA_CARE = (
    "Data care: everything this server returns is private tracker content. "
    "Never copy it, or conversation links from it, into artifact repositories "
    "(code, commits, pull request descriptions, issues, or files), which may "
    "be public. Describe the work there in your own words, from the code."
)

MCP_UNVERIFIED = (
    "External wait_for gates (bugs, changes, issues, people) are not checked by "
    "this server; each is reported as unverified and treated as still holding "
    "its task. Run 'taskgo check' locally to poll them."
)

MCP_INSTRUCTIONS = f"""\
This server reads and writes a taskgo control repository: a private Git
repository of Markdown that tracks projects, tasks (TASK-XXXXX), decisions,
and each project's STATUS.md.

Start with handoff(target), a project name or a task ID: one call returns
the project's README.md, STATUS.md, PLAN.md, the root AGENTS.md, its active
and ready tasks, and the task record. list_projects and list_tasks (state
'ready' for workable tasks) find a target. Every response names the commit
it read in as_of.commit; pass it as 'at' to keep several reads on the same
commit. handoff.skills names the agent skills the project expects: activate
them if your harness has a skill manager (adding one already active is
harmless), otherwise ignore them.

create and apply_changes record progress: each call is one commit on main,
or nothing. Edits name the section hash or blob SHA they replace, as read
from get_task, get_project_status, or list_files, and are refused if it no
longer holds; read again and retry. Pass a fresh request_id for each write
and the same one when retrying it after an unclear outcome, so that it is
recorded once.

{MCP_DATA_CARE}

{MCP_UNVERIFIED}"""


class McpToolError(Exception):
    """A refusal reported to the MCP client as a tool error."""


@dataclass(slots=True)
class McpConfig:
    repo: Path
    remote: str | None  # None reads the local branch without fetching
    branch: str
    auth: Literal["access", "none"]
    team: str | None = None
    audience: str | None = None
    certs_url: str | None = None
    fetch_ttl: float = MCP_FETCH_TTL
    # Without a remote: writes move the local branch and refresh the checkout
    # (--local), rather than being refused (--no-fetch).
    local: bool = False

    def where(self) -> str:
        """The branch as a message names it."""
        if self.remote:
            return f"{self.branch} from {self.remote}"
        return f"local {self.branch}"

    def unreadable(self) -> str:
        """The start of a message about a head that could not be read."""
        return f"could not {'fetch' if self.remote else 'read'} {self.where()}"


class McpReader:
    """Resolves commits of one control repository and keeps their snapshots.

    Snapshots are immutable per commit, so the few most recent are kept.

    The remote-tracking ref is the cached head of the branch. It is fresh for
    fetch_ttl seconds after a fetch, or after a push by this server, which
    moves it; until then, unpinned reads use it without fetching. Losing the
    cache, as on a restart, only costs a fetch. Without a remote, the local
    branch is the head, read as it is for every call.
    """

    KEEP = 4

    def __init__(self, cfg: McpConfig):
        self.cfg = cfg
        self.snaps: dict[str, tuple[GitTreeSnapshot, int]] = {}
        # When the remote-tracking ref was last known to match the remote
        # (time.monotonic()); None when it is not known to.
        self.fetched_at: float | None = None
        # When a fetch last failed; None after one succeeds. Unpinned reads
        # within fetch_ttl of a failure serve the stale head without trying
        # again, so an unreachable remote costs one timeout per TTL, not one
        # per call.
        self.failed_at: float | None = None

    def git(self, *args: str) -> subprocess.CompletedProcess:
        return run_git(list(args), cwd=self.cfg.repo, check=False)

    def tracking_ref(self) -> str:
        return f"refs/remotes/{self.cfg.remote}/{self.cfg.branch}"

    def branch_ref(self) -> str:
        """The ref that holds the head: the tracking ref, or the local branch."""
        if self.cfg.remote:
            return self.tracking_ref()
        return f"refs/heads/{self.cfg.branch}"

    def cached(self) -> bool:
        """True when there is a cached head that writes may try first."""
        return self.cfg.fetch_ttl > 0 and self.fetched_at is not None

    def fresh(self) -> bool:
        """True when the cached head is recent enough for an unpinned read."""
        at = self.fetched_at
        return (
            self.cfg.fetch_ttl > 0
            and at is not None
            and time.monotonic() - at < self.cfg.fetch_ttl
        )

    def forget(self) -> None:
        """Stops trusting the cached head: the next unpinned read fetches."""
        self.fetched_at = None

    def pushed(self, sha: str) -> None:
        """Records that SHA is now the head of the remote branch. A local
        branch was moved by the push itself, and is never cached."""
        if self.cfg.remote:
            self.git("update-ref", self.tracking_ref(), sha)
            self.fetched_at = time.monotonic()

    def fetch(self) -> None:
        cfg = self.cfg
        try:
            res = subprocess.run(
                ["git", "fetch", "--quiet", "--no-tags", cfg.remote, cfg.branch],
                cwd=cfg.repo,
                capture_output=True,
                text=True,
                timeout=MCP_FETCH_TIMEOUT,
                env=dict(os.environ, GIT_TERMINAL_PROMPT="0"),
                check=False,
            )
        except subprocess.TimeoutExpired:
            self.failed_at = time.monotonic()
            mcp_log(f"fetch failed: timed out after {MCP_FETCH_TIMEOUT}s")
            raise McpToolError(
                f"could not fetch {cfg.branch} from {cfg.remote} (timed out); "
                "pass an earlier as_of.commit as 'at' to read it"
            ) from None
        if res.returncode != 0:
            self.failed_at = time.monotonic()
            mcp_log(f"fetch failed: {res.stderr.strip()}")
            raise McpToolError(
                f"could not fetch {cfg.branch} from {cfg.remote}; pass an "
                "earlier as_of.commit as 'at' to read it"
            )
        self.fetched_at = time.monotonic()
        self.failed_at = None

    def failing(self) -> bool:
        """True while a failed fetch is recent enough not to retry for a read."""
        at = self.failed_at
        return (
            self.cfg.fetch_ttl > 0
            and at is not None
            and time.monotonic() - at < self.cfg.fetch_ttl
        )

    def resolve(self, at: Any, *, fetch: bool = False) -> str:
        """The commit to read: AT when given, else the head of the branch.

        The head is the cached one while it is fresh, unless FETCH asks for
        the remote's head as it is now.
        """
        if at:
            if not isinstance(at, str) or not re.fullmatch(r"[0-9a-fA-F]{7,40}", at):
                raise McpToolError(f"'at' is not a commit SHA: {at!r}")
            sha = resolve_commit(self.cfg.repo, at)
            if sha is None and self.cfg.remote:
                # Perhaps newer than the last fetch.
                self.fetch()
                sha = resolve_commit(self.cfg.repo, at)
            if sha is None:
                raise McpToolError(f"no commit {at} in the control repository")
            return sha
        if self.cfg.remote and (fetch or not self.fresh()):
            self.fetch()
        ref = self.branch_ref()
        sha = resolve_commit(self.cfg.repo, ref)
        if sha is None:
            raise McpToolError(f"{ref} does not exist in the control repository")
        return sha

    def resolve_for_read(self, at: Any) -> tuple[str, bool]:
        """The commit a read tool reads, and whether it is a stale head.

        An unpinned read whose fetch fails is served the head last fetched,
        or pushed by this server, when there is one, rather than nothing;
        the response says so, and reads within fetch_ttl of the failure are
        served the same way without fetching again. A pinned read, or a
        first read with nothing fetched yet, fails as the fetch did.
        """
        if not at and self.cfg.remote and self.failing() and not self.fresh():
            sha = resolve_commit(self.cfg.repo, self.tracking_ref())
            if sha is not None:
                return sha, True
        try:
            return self.resolve(at), False
        except McpToolError:
            if at or not self.cfg.remote:
                raise
            sha = resolve_commit(self.cfg.repo, self.tracking_ref())
            if sha is None:
                raise
            mcp_log(f"serving the last fetched head {sha[:12]} as stale")
            return sha, True

    def snapshot(self, sha: str) -> tuple[GitTreeSnapshot, int]:
        """The snapshot of commit SHA and its commit time (Unix seconds)."""
        if sha in self.snaps:
            self.snaps[sha] = self.snaps.pop(sha)  # most recent last
            return self.snaps[sha]
        snap = GitTreeSnapshot(self.cfg.repo, sha)
        committed = int(self.git("show", "-s", "--format=%ct", sha).stdout.strip())
        self.snaps[sha] = (snap, committed)
        while len(self.snaps) > self.KEEP:
            self.snaps.pop(next(iter(self.snaps)))
        return snap, committed

    def is_ancestor(self, sha: str, head: str) -> bool:
        return self.git("merge-base", "--is-ancestor", sha, head).returncode == 0

    def commit(self, snap: GitTreeSnapshot, cs: ChangeSet, message: str) -> str:
        """A commit of CS over SNAP's commit, made without a working tree.

        Writes blobs, a tree, and the commit to the object store, through a
        temporary index; no ref moves.
        """
        import tempfile

        repo = self.cfg.repo
        with tempfile.TemporaryDirectory(prefix="taskgo-mcp-") as tmp:
            env = dict(os.environ, GIT_INDEX_FILE=str(Path(tmp) / "index"))

            def git(*args: str, data: bytes | None = None) -> str:
                res = subprocess.run(
                    ["git", *args],
                    cwd=repo,
                    input=data,
                    capture_output=True,
                    env=env,
                    check=False,
                )
                if res.returncode != 0:
                    err = res.stderr.decode("utf-8", "replace").strip()
                    raise McpToolError(f"git {args[0]} failed: {err}")
                return res.stdout.decode("utf-8").strip()

            git("read-tree", snap.rev)
            entries = []
            for rel, (_, after) in cs.snap.diff().items():
                if after is None:
                    entries.append(f"0 {'0' * 40}\t{rel}")
                else:
                    blob = git("hash-object", "-w", "--stdin", data=after.encode())
                    mode = "100755" if cs.snap.is_executable(rel) else "100644"
                    entries.append(f"{mode} {blob}\t{rel}")
            git(
                "update-index",
                "-z",
                "--index-info",
                data="".join(e + "\0" for e in entries).encode(),
            )
            tree = git("write-tree")
            return git(
                "-c",
                "user.useConfigOnly=true",
                "commit-tree",
                "--no-gpg-sign",
                tree,
                "-p",
                snap.rev,
                "-F",
                "-",
                data=message.encode(),
            )

    def push(self, sha: str) -> tuple[bool, str]:
        """Makes SHA the head of the branch, if its parent still is: pushed
        to the remote without force, or, without one, moved to on the local
        branch (see move). Returns (accepted, Git's message)."""
        cfg = self.cfg
        if not cfg.remote:
            return self.move(sha)
        try:
            res = subprocess.run(
                [
                    "git",
                    "push",
                    "--quiet",
                    "--no-verify",
                    cfg.remote,
                    f"{sha}:refs/heads/{cfg.branch}",
                ],
                cwd=cfg.repo,
                capture_output=True,
                text=True,
                timeout=MCP_PUSH_TIMEOUT,
                env=dict(os.environ, GIT_TERMINAL_PROMPT="0"),
                check=False,
            )
        except subprocess.TimeoutExpired:
            return False, "push timed out"
        # The ' ! [rejected] ... (fetch first)' line says why, when there is one.
        lines = [line.strip() for line in res.stderr.strip().splitlines()]
        why = next((line for line in lines if line.startswith("!")), None)
        return res.returncode == 0, why or (lines[-1] if lines else "")

    def move(self, sha: str) -> tuple[bool, str]:
        """Moves the local branch from SHA's parent to SHA (--local).

        The checkout must have the branch checked out, and no uncommitted
        change to a path the commit touches; other dirty paths are left
        alone. The move is a compare-and-swap on the ref, so a commit made
        meanwhile from the checkout refuses it, as a remote refuses a
        non-fast-forward push: (False, why), and the caller applies the set
        again over the new head. After the move, the index and working tree
        are brought from the parent to SHA for the touched paths only, so
        the checkout shows the commit as if it had been made there.
        """
        cfg = self.cfg
        ref = f"refs/heads/{cfg.branch}"
        parent = self.git("rev-parse", "--verify", f"{sha}^").stdout.strip()
        bare = self.git("rev-parse", "--is-bare-repository").stdout.strip() == "true"
        if not bare:
            head = self.git("symbolic-ref", "--quiet", "HEAD").stdout.strip()
            if head != ref:
                raise McpToolError(
                    f"the checkout does not have {cfg.branch} checked out "
                    f"({head or 'detached HEAD'}); nothing was written"
                )
            paths = self.git(
                "diff-tree", "-r", "--no-commit-id", "--name-only", "-z", sha
            ).stdout.split("\0")
            paths = [p for p in paths if p]
            dirty = self.git(
                "status", "--porcelain", "--untracked-files=all", "--", *paths
            ).stdout
            if dirty.strip():
                names = ", ".join(line[3:] for line in dirty.splitlines())
                raise McpToolError(
                    f"the checkout has uncommitted changes to {names}; commit "
                    "or discard them first. Nothing was written"
                )
        res = self.git("update-ref", "-m", "taskgo mcp: write", ref, sha, parent)
        if res.returncode != 0:
            why = res.stderr.strip().splitlines()
            return False, (why[-1] if why else f"{cfg.branch} moved").removeprefix(
                "fatal: "
            )
        if not bare:
            # Two-tree read-tree: a fast-forward of the index and working tree
            # for the paths that differ between the parent and SHA, which also
            # removes files the commit deletes; other entries are kept.
            res = self.git("read-tree", "-m", "-u", parent, sha)
            if res.returncode != 0:
                mcp_log(
                    f"{cfg.branch} is at {sha[:12]} but the checkout could not be "
                    f"refreshed: {res.stderr.strip()}"
                )
        return True, ""

    def find_request(self, head: str, rid: str) -> tuple[str, str | None] | None:
        """The commit, with its digest, that the last MCP_REQUEST_SCAN commits
        behind HEAD record for request RID in their trailers, or None.

        Git picks out the trailer block, so a body line that happens to start
        with the trailer's name is not one.
        """
        res = self.git(
            "log",
            "-z",
            f"-n{MCP_REQUEST_SCAN}",
            "--format=%H%n%(trailers:only,unfold)",
            head,
        )
        if res.returncode != 0:
            return None
        for record in res.stdout.split("\0"):
            sha, _, message = record.partition("\n")
            trailers = dict(
                line.split(": ", 1)
                for line in message.splitlines()
                if ": " in line
                and line.split(": ", 1)[0]
                in (MCP_REQUEST_ID_TRAILER, MCP_REQUEST_DIGEST_TRAILER)
            )
            if trailers.get(MCP_REQUEST_ID_TRAILER) == rid:
                return sha, trailers.get(MCP_REQUEST_DIGEST_TRAILER)
        return None


@dataclass(slots=True)
class McpRead:
    """One tool call's view: a commit, its snapshot, and the reader. A read
    served a stale head, because the branch could not be fetched, says so
    in its as_of."""

    reader: McpReader
    snap: GitTreeSnapshot
    committed: int
    stale: bool = False

    def as_of(self) -> dict[str, Any]:
        as_of = snapshot_as_of(self.snap, self.committed)
        if self.stale:
            as_of["stale"] = True
        return as_of


def mcp_find_task(snap: GitTreeSnapshot, task_id: Any) -> TaskRow:
    task_id = str(task_id or "").strip().upper()
    if not ID_PATTERN.match(task_id):
        raise McpToolError(f"not a task ID: {task_id!r} (expected TASK-XXXXX)")
    try:
        return find_task_row(snap, task_id)
    except TaskgoError as e:
        raise McpToolError(str(e)) from None


def mcp_project(snap: GitTreeSnapshot, project: Any) -> str:
    if not isinstance(project, str) or not is_project(snap, project):
        raise McpToolError(f"unknown project: {project}")
    return project


def mcp_path(path: Any) -> str:
    try:
        return clean_rel_path(str(path or ""), allow_empty=True)
    except TaskgoError:
        raise McpToolError(
            f"invalid path: {str(path or '').strip().strip('/')!r}"
        ) from None


def mcp_list_projects(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    return {
        "as_of": r.as_of(),
        "projects": [project_status_json(r.snap, p) for p in list_projects(r.snap)],
    }


def mcp_list_tasks(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    project = args.get("project")
    if project:
        mcp_project(r.snap, project)
    state = args.get("state")
    if state and state.strip().lower() != "ready" and canonical_status(state) is None:
        raise McpToolError(f"unknown state: {state}")
    rows = select_task_rows(r.snap, project, state)
    return {
        "as_of": r.as_of(),
        "tasks": [task_row_json(row) for row in rows],
        "unverified_gates": unverified_gates(rows),
    }


def mcp_get_task(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    row = mcp_find_task(r.snap, args.get("id"))
    return {"as_of": r.as_of(), **task_record_json(r.snap, row)}


def mcp_get_project_status(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    project = mcp_project(r.snap, args.get("project"))
    rel = f"{project}/STATUS.md"
    committed = r.snap.read_text(rel) if r.snap.is_file(rel) else None
    proj = status_projection(r.snap, project)
    return {
        "as_of": r.as_of(),
        "project": project,
        "path": rel,
        "blob": r.snap.blobs.get(rel),
        **proj,
        "fresh_block": proj["live_block"],
        "unverified_gates": unverified_gates(get_task_rows(r.snap, project)),
        "content": committed,
    }


def mcp_read_file(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    rel = mcp_path(args.get("path"))
    sha = r.snap.blobs.get(rel)
    if sha is None:
        if r.snap.is_dir(rel):
            raise McpToolError(f"{rel} is a directory; use list_files")
        raise McpToolError(f"{rel} is not in commit {r.snap.rev[:12]}")
    raw = run_git(["cat-file", "blob", sha], cwd=r.reader.cfg.repo, text=False).stdout
    try:
        result = read_slice(
            rel,
            sha,
            raw,
            args.get("start_line"),
            args.get("end_line"),
            MCP_MAX_FILE_BYTES,
            args.get("line_numbers", False),
        )
    except TaskgoError as e:
        raise McpToolError(str(e)) from None
    return {"as_of": r.as_of(), **result}


def mcp_search_files(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    try:
        search = parse_search_args(args.get("args"), args.get("paths"))
        result, _ = run_search(r.reader.cfg.repo, search, r.snap.rev, set(r.snap.blobs))
    except TaskgoError as e:
        raise McpToolError(str(e)) from None
    return {"as_of": r.as_of(), **result}


def mcp_list_files(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    prefix = mcp_path(args.get("prefix"))
    if prefix and not r.snap.exists(prefix):
        raise McpToolError(f"{prefix} is not in commit {r.snap.rev[:12]}")
    files = [
        {"path": rel, "blob": sha, "executable": r.snap.modes[rel] == "100755"}
        for rel, sha in sorted(r.snap.blobs.items())
        if not prefix or rel == prefix or rel.startswith(prefix + "/")
    ]
    return {"as_of": r.as_of(), "files": files}


def mcp_handoff(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    try:
        t = resolve_handoff(r.snap, args.get("target"))
    except TaskgoError as e:
        raise McpToolError(str(e)) from None
    return handoff_payload(r.snap, t, r.as_of())


def mcp_get_task_history(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    row = mcp_find_task(r.snap, args.get("id"))
    field = str(args.get("field") or "status").strip()
    versions = file_versions(r.reader.cfg.repo, r.snap.rev, row.rel_path)
    changes = field_history(versions, field)
    return {
        "as_of": r.as_of(),
        "task": task_row_json(row),
        "field": field,
        "changes": [
            {
                "date": c.date,
                "before": c.before,
                "after": c.after,
                "commit": c.sha,
                "subject": c.subject,
            }
            for c in changes
        ],
        "text": "\n".join(format_field_change(c) for c in changes),
    }


MCP_AT = {
    "type": "string",
    "description": (
        "Commit SHA to read. Omit to read the head of main; pass the 'commit' "
        "from an earlier response to keep several reads on one commit."
    ),
}
MCP_TASK_ID = {"type": "string", "description": "Task ID, TASK-XXXXX."}
MCP_PROJECT = {"type": "string", "description": "Project name."}


@dataclass(slots=True, frozen=True)
class McpTool:
    """A read tool's handler maps a commit's view and the arguments to the
    result; a write tool's handler maps the arguments to a change set."""

    name: str
    description: str
    properties: dict[str, Any]
    required: tuple[str, ...]
    handler: Callable[..., dict[str, Any]]
    writes: bool = False
    destructive: bool = False

    def listing(self) -> dict[str, Any]:
        if self.writes:
            properties = self.properties
            annotations = {
                "readOnlyHint": False,
                "destructiveHint": self.destructive,
                # With the same request_id, a retry is recorded once.
                "idempotentHint": True,
                "openWorldHint": False,
            }
        else:
            properties = {**self.properties, "at": MCP_AT}
            annotations = {"readOnlyHint": True, "openWorldHint": False}
        schema: dict[str, Any] = {"type": "object", "properties": properties}
        if self.required:
            schema["required"] = list(self.required)
        return {
            "name": self.name,
            "description": self.description,
            "inputSchema": schema,
            "annotations": annotations,
        }


def mcp_create_doc(args: dict[str, Any]) -> dict[str, Any]:
    fields, sections = args.get("fields") or {}, args.get("sections") or {}
    if not isinstance(fields, dict) or not isinstance(sections, dict):
        raise McpToolError("fields and sections must be objects")
    if "title" in sections:
        raise McpToolError("pass the title as 'title', not in sections")
    change = {
        "op": "create",
        "kind": args.get("kind") or "task",
        "project": args.get("project"),
        "fields": fields,
        "sections": {"title": args.get("title"), **sections},
    }
    if "slug" in args:
        change["slug"] = args["slug"]
    return {"changes": [change]}


def mcp_apply_doc(args: dict[str, Any]) -> dict[str, Any]:
    return {"changes": args.get("changes")}


def mcp_edit_doc(args: dict[str, Any]) -> dict[str, Any]:
    keys = ("path", "old_string", "new_string", "replace_all", "expected_blob")
    change = {"op": "edit_file", **{k: args[k] for k in keys if k in args}}
    if isinstance(change.get("path"), str):
        change["path"] = trim_boundary_path(change["path"])
    return {"changes": [change]}


MCP_WRITE_PROPERTIES = {
    "request_id": {
        "type": "string",
        "description": (
            "A fresh ID for this write, such as a UUID. Reuse it only to retry "
            "this same write after an unclear outcome: a write that already "
            "landed is then reported again, not recorded twice."
        ),
    },
    "subject": {
        "type": "string",
        "description": (
            "Commit subject, as Conventional Commits 'type(scope): description' "
            "in up to 50 characters; derived from the changes when omitted."
        ),
    },
    "body": {"type": "string", "description": "Commit body, plain text."},
    "conversation": {
        "type": "string",
        "description": (
            "Your session URI, as <agent>://<id>: recorded in a Conversation: "
            "trailer and in the conversations of every task the write touches."
        ),
    },
    "refs": {
        "type": "array",
        "items": {"type": "string"},
        "description": (
            "External references, such as artifact commits (repo@sha) or pull "
            "request URLs, each recorded in a Ref: trailer."
        ),
    },
}


MCP_TOOLS = [
    McpTool(
        "list_projects",
        "List the projects in the taskgo control repository, with task counts "
        "and in-progress and blocked task IDs (as 'taskgo status --json').",
        {},
        (),
        mcp_list_projects,
    ),
    McpTool(
        "list_tasks",
        "List tasks, optionally for one project and one state (as 'taskgo list "
        "--json'). State 'ready' means todo with no unresolved blocked_by or "
        "wait_for, soonest due date first.",
        {
            "project": MCP_PROJECT,
            "state": {
                "type": "string",
                "description": "todo, in-progress, blocked, done, cancelled, or ready.",
            },
        },
        (),
        mcp_list_tasks,
    ),
    McpTool(
        "get_task",
        "Read one task record by ID: frontmatter, sections with hashes, "
        "unresolved dependencies, and the full Markdown.",
        {"id": MCP_TASK_ID},
        ("id",),
        mcp_get_task,
    ),
    McpTool(
        "get_project_status",
        "Read a project's STATUS.md: Summary and Next with hashes, the committed "
        "task snapshot block, and a freshly computed block for today (they "
        "differ when dates have moved since the last sync).",
        {"project": MCP_PROJECT},
        ("project",),
        mcp_get_project_status,
    ),
    McpTool(
        "read_file",
        "Read a UTF-8 text file in the control repository by its "
        "repository-relative path, whole or as lines start_line..end_line "
        "(1-indexed, inclusive; lines end at '\\n'). Returns at most "
