    # search (main() hands its arguments to cmd_search; this parser gives help)
    p_search = subparsers.add_parser(
        "search",
        help="Search file contents with git grep",
        usage="taskgo search [--at REV] [--json] GREP_ARGS... [-- PATHS...]",
        description=(
            "Search tracked files in the control repository with git grep,"
            " in the working tree or in commit REV, as the MCP server's"
            " search_files tool does. GREP_ARGS are git grep arguments: one"
            " bare pattern, or patterns given with -e, and these options:"
            " -i -w -v -E -G -F -P -n -I -l -L -c -o -W -p, -A/-B/-C N,"
            " -m N, --max-depth N, --and, --or, --not, ( ), --all-match, and"
            " their long forms. Other options, abbreviations, and further"
            " bare arguments are refused. Pathspecs follow '--'. Output is"
            " git grep's, with paths relative to the repository root, lines"
            f" cut at {SEARCH_LINE_MAX_BYTES} bytes, and at most"
            f" {SEARCH_MAX_BYTES // 1024} KiB in all. Exits 0 on a match, 1"
            f" on none, and 2 on an error; git is stopped after"
            f" {SEARCH_TIMEOUT} s."
        ),
        formatter_class=HouseStyleHelpFormatter,
        epilog="""Examples:
  taskgo search TASK-084C7
  taskgo search -i -C2 'partner name' -- meta/ '*.md'
  taskgo search -l -e b/123456 -e cl/123456
  taskgo search -e TODO --and --not -e done --at HEAD~3 --json""",
    )
    p_search.add_argument(
        "--at",
        metavar="REV",
        default=None,
        help="Search commit REV instead of the working tree",
    )
    p_search.add_argument(
        "--json",
        "-j",
        dest="as_json",
        action="store_true",
        help="Print output, files, and truncated as JSON",
    )
    p_search.add_argument(
        "grep_args",
        nargs=argparse.REMAINDER,
        metavar="GREP_ARGS",
        help="git grep pattern and options, then optionally -- PATHS",
    )

    # checkpoint
    p_checkpoint = subparsers.add_parser(
        "checkpoint",
        help="Commit an authorized tracker checkpoint for TASK_ID",
        description=(
            "Commit an authorized tracker checkpoint for TASK_ID. Nonconforming"
            " subjects are rewritten as 'chore(<project>): <subject>'"
            " (truncated to 50 characters)."
        ),
        formatter_class=HouseStyleHelpFormatter,
        epilog="""Examples:
  taskgo checkpoint TASK-3A91F "chore(proj): start diagnosis" --all
  taskgo checkpoint TASK-3A91F "docs(proj): update task" --path proj/tasks/TASK-3A91F-slug.md """,
    )
    p_checkpoint.add_argument("task_id", metavar="TASK_ID", help="Target task ID")
    p_checkpoint.add_argument(
        "subject",
        metavar="SUBJECT",
        help="Conventional Commits subject line (rewritten when nonconforming)",
    )
    p_checkpoint.add_argument(
        "--all",
        "-a",
        dest="all_files",
        action="store_true",
        help="Stage all modified/untracked project files",
    )
    p_checkpoint.add_argument(
        "--path",
        "-p",
        dest="paths",
        action="append",
        default=[],
        help="Explicit project files to stage",
    )
    p_checkpoint.add_argument(
        "--body",
        "-b",
        default="",
        help="Plain-text commit body (hard-wrapped to 72 columns)",
    )
    p_checkpoint.add_argument(
        "--ref",
        "-r",
        dest="refs",
        action="append",
        default=[],
        help="External references (e.g. artifact@sha)",
    )
    p_checkpoint.add_argument(
        "--conv",
        "-C",
        "--conversation",
        dest="conv",
        default=None,
        help="Active conversation or session ID",
    )

    # commit
    p_commit = subparsers.add_parser(
        "commit",
        help="Commit a logical transition with automatic project status synchronization",
        description="Commit a logical transition with automatic project status synchronization.",
        formatter_class=HouseStyleHelpFormatter,
    )
    p_commit.add_argument(
        "subject",
        metavar="SUBJECT",
        help="Conventional Commits subject line (rewritten when nonconforming)",
    )
    p_commit.add_argument(
        "--body",
        "-b",
        default="",
        help="Plain-text commit body (hard-wrapped to 72 columns)",
    )
    p_commit.add_argument(
        "--ref",
        "-r",
        dest="refs",
        action="append",
        default=[],
        help="External references (e.g. artifact@sha)",
    )
    p_commit.add_argument(
        "--conv",
        "-C",
        "--conversation",
        dest="conv",
        default=None,
        help="Active conversation or session ID",
    )

    return parser


def search_command_split(argv: list[str]) -> tuple[list[str], list[str]] | None:
    """ARGV split after a 'search' command: (head, its arguments), or None."""
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--root", "-R"):
            i += 2
        elif a.startswith("--root=") or (a.startswith("-R") and len(a) > 2):
            i += 1
        else:
            break
    if i < len(argv) and argv[i] == "search":
        return argv[: i + 1], argv[i + 1 :]
    return None


def main(argv: list[str] | None = None) -> None:
    if argv is None:
        argv = sys.argv[1:]

    if not argv or (len(argv) == 1 and argv[0] in ("--help", "-h", "help")):
        print(help_text())
        sys.exit(0)

    parser = create_parser()
    # git grep's options are not taskgo's, so search takes its arguments
    # verbatim rather than through argparse, which would mistake them.
    search = search_command_split(argv)
    if search is not None:
        head, tokens = search
        if tokens in (["-h"], ["--help"]):
            parser.parse_args([*head, "--help"])
        args = parser.parse_args(head)
    else:
        args = parser.parse_args(argv)

    # handover and dispatch (the former name) are aliases of handoff.
    if args.command in ("handover", "dispatch"):
        args.command = "handoff"
    global _ACTIVE_COMMAND
    _ACTIVE_COMMAND = args.command
    set_explicit_root(getattr(args, "root", None))

    if search is not None:
        cmd_search(search[1])
    elif args.command == "id":
        cmd_id()
    elif args.command == "root":
        cmd_root()
    elif args.command == "create":
        cmd_create(
            project_name=args.project_name,
            title=args.title,
            slug=args.slug,
            status=args.status,
            problem=args.problem,
            cost=args.cost,
            goal=args.goal,
            criteria=args.criteria,
            sketch=args.sketch,
            constraints=args.constraints,
            outcome=args.outcome,
            findings=args.findings,
            next_steps=args.next_steps,
            conv=getattr(args, "conv", None),
            wait_for=getattr(args, "wait_for", None),
            due=getattr(args, "due", None),
            stale_after=getattr(args, "stale_after", None),
            no_commit=args.no_commit,
            dry_run=args.dry_run,
            add_blocked_by=args.add_blocked_by,
            add_wait_for=args.add_wait_for,
            add_conversations=args.add_conversations,
        )
    elif args.command == "update":
        cmd_update(
            query=args.query,
            status=args.status,
            title=args.title,
            slug=args.slug,
            problem=args.problem,
            cost=args.cost,
            goal=args.goal,
            criteria=args.criteria,
            sketch=args.sketch,
            constraints=args.constraints,
            outcome=args.outcome,
            findings=args.findings,
            next_steps=args.next_steps,
            conv=getattr(args, "conv", None),
            wait_for=getattr(args, "wait_for", None),
            due=getattr(args, "due", None),
            stale_after=getattr(args, "stale_after", None),
            expect_status=args.expect_status,
            add_blocked_by=args.add_blocked_by,
            remove_blocked_by=args.remove_blocked_by,
            add_wait_for=args.add_wait_for,
            remove_wait_for=args.remove_wait_for,
            add_conversations=args.add_conversations,
            remove_conversations=args.remove_conversations,
        )
    elif args.command == "apply":
        cmd_apply(changes_path=args.changes_path, dry_run=args.dry_run)
    elif args.command == "edit":
        cmd_edit(
            path=args.path,
            old=args.old,
            new=args.new,
            old_file=args.old_file,
            new_file=args.new_file,
            replace_all=args.replace_all,
            expected_blob=args.expected_blob,
            dry_run=args.dry_run,
            as_json=args.as_json,
        )
    elif args.command == "schema":
        cmd_schema(as_json=args.json)
    elif args.command == "list":
        cmd_list(
            project=args.project,
            state=args.state,
            as_json=args.as_json,
        )
    elif args.command == "info":
        cmd_info(
            project=args.project,
            as_json=args.as_json,
        )
    elif args.command == "skills":
        cmd_skills(project=args.project, as_json=args.as_json)
    elif args.command == "status":
        cmd_status(target=args.target, at=args.at, as_json=args.as_json)
    elif args.command == "handoff":
        cmd_handoff(target=args.target, at=args.at, as_json=args.as_json)
    elif args.command == "sync":
        cmd_sync(project=args.project)
    elif args.command == "check":
        cmd_check(project=args.project, as_json=args.as_json)
    elif args.command == "doctor":
        cmd_doctor(project=args.project)
    elif args.command == "fix":
        cmd_fix(
            project=args.project,
            dry_run=args.dry_run,
            no_commit=args.no_commit,
        )
    elif args.command == "mcp":
        cmd_mcp(
            host=args.host,
            port=args.port,
            path=args.path,
            remote=args.remote,
            branch=args.branch,
            no_fetch=args.no_fetch,
            local=args.local,
            auth=args.auth,
            team=args.access_team,
            audience=args.access_aud,
            stdio=args.stdio,
            fetch_ttl=args.fetch_ttl,
            log=args.log,
        )
    elif args.command == "requests":
        cmd_requests(log=args.log, days=args.days, gap=args.gap, as_json=args.json)
    elif args.command == "history":
        cmd_history(
            query=args.query,
            field=args.field,
        )
    elif args.command == "read":
        cmd_read(
            path=args.path,
            start_line=args.start_line,
            end_line=args.end_line,
            at=args.at,
            as_json=args.as_json,
            line_numbers=args.line_numbers,
        )
    elif args.command == "checkpoint":
        cmd_checkpoint(
            task_id=args.task_id,
            subject=args.subject,
            all_files=args.all_files,
            paths=args.paths,
            body=args.body,
            refs=args.refs,
            conv=getattr(args, "conv", None),
        )
    elif args.command == "commit":
        cmd_commit(
            subject=args.subject,
            body=args.body,
            refs=args.refs,
            conv=getattr(args, "conv", None),
        )
    else:
        print(help_text())
        sys.exit(0)


if __name__ == "__main__":
    # Installed only when run as the CLI: the MCP server imports this file as
    # its core module.
    signal.signal(signal.SIGTERM, sigterm_handler)
    signal.signal(signal.SIGINT, sigint_handler)
    try:
        main()
    except KeyboardInterrupt:
        handle_signal_exit(signal.SIGINT)
    except BrokenPipeError:
        import os

        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(128 + signal.SIGPIPE)
