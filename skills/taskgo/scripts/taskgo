END = "<!-- taskgo:end -->"
CANONICAL_URL = "https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo"
COMMIT_AUTH = "<!-- taskgo:allow-local-commits -->"
ID_PATTERN = re.compile(r"^TASK-[0-9A-F]{5}$")
WRAP_WIDTH = 80
SLUG_MAX_LEN = 32

_TAG_ANSI = {
    "PASS": "\033[32m",
    "INFO": "\033[36m",
    "WARN": "\033[33m",
    "FAIL": "\033[31m",
}
_TAG_PATTERN = re.compile(r"\[(PASS|INFO|WARN|FAIL)\]")


def _use_color(stream: Any) -> bool:
    """Decides whether diagnostic output to stream may carry ANSI styling.

    Styling is an enhancement only: disabled when NO_COLOR is set
    (https://no-color.org), forced by FORCE_COLOR, otherwise on only when
    the destination stream is attached to a terminal.
    """
    if os.environ.get("NO_COLOR"):
        return False
    force = os.environ.get("FORCE_COLOR")
    if force and force != "0":
        return True
    return bool(getattr(stream, "isatty", lambda: False)())


def _tagged(text: str, stream: Any = sys.stdout) -> str:
    """Colorises canonical diagnostic tags ([PASS] etc.) found in text.

    Tag characters are never added, removed, or moved, so piped output stays
    byte-identical to unstyled output and remains greppable either way.
    """
    if not _use_color(stream):
        return text

    def _wrap(m: re.Match[str]) -> str:
        return f"{_TAG_ANSI[m.group(1)]}{m.group(0)}\033[0m"

    return _TAG_PATTERN.sub(_wrap, text)


class TaskStatus(StrEnum):
    TODO = "todo"
    IN_PROGRESS = "in-progress"
    BLOCKED = "blocked"
    DONE = "done"
    CANCELLED = "cancelled"


RoundTripRepresenter.add_representer(
    TaskStatus, lambda dumper, data: dumper.represent_str(str(data))
)
Representer.add_representer(
    TaskStatus, lambda dumper, data: dumper.represent_str(str(data))
)

STANDARD_STATES = {s.value for s in TaskStatus}


