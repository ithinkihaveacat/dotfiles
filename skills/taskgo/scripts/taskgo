MCP_TOOLS_BY_NAME = {t.name: t for t in MCP_TOOLS}


class McpAuthError(Exception):
    pass


class AccessVerifier:
    """Checks Cloudflare Access JWTs (Cf-Access-Jwt-Assertion): RS256
    signature against the team's certificates, issuer, audience, and expiry."""

    def __init__(self, team: str, audience: str, certs_url: str | None = None):
        import jwt  # Only the server needs it.

        self.jwt = jwt
        self.team, self.audience = team, audience
        self.jwks = jwt.PyJWKClient(
            certs_url or f"https://{team}/cdn-cgi/access/certs",
            cache_keys=True,
            lifespan=MCP_CERTS_TTL,
            # Cloudflare refuses urllib's default user agent.
            headers={"User-Agent": f"taskgo-mcp/{MCP_SERVER_VERSION}"},
            timeout=10,
        )

    def verify(self, token: str) -> dict[str, Any]:
        jwt = self.jwt
        try:
            key = self.jwks.get_signing_key_from_jwt(token)
            return jwt.decode(
                token,
                key.key,
                algorithms=["RS256"],
                audience=self.audience,
                issuer=f"https://{self.team}",
                leeway=60,
                options={"require": ["exp", "iss", "aud"]},
            )
        except jwt.ExpiredSignatureError:
            raise McpAuthError("Access token expired") from None
        except jwt.InvalidAudienceError:
            raise McpAuthError("Access token for another application") from None
        except jwt.InvalidIssuerError:
            raise McpAuthError("Access token from another team") from None
        except jwt.PyJWKClientError as e:
            raise McpAuthError(f"Access token key not usable: {e}") from None
        except jwt.PyJWTError as e:
            raise McpAuthError(f"Access token refused: {e}") from None


def mcp_tool_error(message: str) -> dict[str, Any]:
    return {"content": [{"type": "text", "text": message}], "isError": True}


MCP_CHANGE_ERRORS = {
    "invalid": "refused",
    "precondition": "precondition failed",
    "validation": "validation failed",
}


@dataclass(slots=True)
class McpRequest:
    """One request_id: a digest of its arguments, when it was first seen,
    and each commit built for it, with the result to report if it lands."""

    digest: str
    seen: float
    candidates: dict[str, dict[str, Any]]


@dataclass(slots=True, frozen=True)
class McpCommitArgs:
    subject: str | None
    body: str
    conversation: str | None
    refs: list[str]


def mcp_line(value: Any, what: str, limit: int = 300) -> str:
    if not isinstance(value, str) or not value.strip() or "\n" in value.strip():
        raise McpToolError(f"{what} must be one non-empty line")
    if len(value.strip()) > limit:
        raise McpToolError(f"{what} is longer than {limit} characters")
    return value.strip()


def mcp_commit_args(args: dict[str, Any]) -> McpCommitArgs:
    subject = args.get("subject")
    subject = mcp_line(subject, "subject") if subject is not None else None
    body = args.get("body") or ""
    if not isinstance(body, str):
        raise McpToolError("body must be a string")
    conv = args.get("conversation")
    if conv is not None:
        conv = mcp_line(conv, "conversation")
        if "://" not in conv or not field_is_valid(
            TASK_SCHEMA.field("conversations"), conv
        ):
            raise McpToolError(
                f"conversation {conv!r} is not a session URI, as <agent>://<id>"
            )
    refs = args.get("refs") or []
    if not isinstance(refs, list):
        raise McpToolError("refs must be a list of strings")
    return McpCommitArgs(
        subject, body.strip(), conv, [mcp_line(r, "each ref") for r in refs]
    )


def mcp_describe(cs: ChangeSet) -> str:
    """A commit description of CS, for when the caller gives no subject."""
    diff = cs.snap.diff()
    new = {c["path"] for c in cs.created}
    created = [
        c.get("id") or c["path"].rsplit("/", 1)[-1].removesuffix(".md")
        for c in cs.created
    ]
    updated = sorted(
        {
            r.task_id
            for r in get_task_rows(cs.snap)
            if r.rel_path in cs.before and r.rel_path not in new and r.task_id
        }
    )
    parts = []
    if created:
        parts.append("add " + ", ".join(created))
    if updated:
        parts.append("update " + ", ".join(updated))
    if not parts:
        names = sorted(
            {
                rel.rsplit("/", 1)[-1]
                for rel in diff
                if rel not in new
                and (not rel.endswith("/STATUS.md") or rel in cs.before)
            }
        )
        parts.append("update " + ", ".join(names or ["STATUS.md"]))
    return "; ".join(parts)


def mcp_request_digest(args: dict[str, Any]) -> str:
    """The digest of a write's arguments, request_id aside: the same request
    again has the same digest, a different write under the same ID not."""
    return hashlib.sha256(
        json.dumps(
            {k: v for k, v in args.items() if k != "request_id"}, sort_keys=True
        ).encode()
    ).hexdigest()


def mcp_commit_message(cs: ChangeSet, c: McpCommitArgs, rid: str, digest: str) -> str:
    """The message a CLI checkpoint of CS would carry, plus the request's
    trailers.

    The scope is the one project the changes are in, not counting STATUS.md
    files regenerated only because a task they list changed. The trailers
    Request-Id and Request-Digest (a prefix of the arguments' digest) let a
    server that has forgotten RID, as after a restart, find the commit it
    made for it and tell a retry from a reused ID.
    """
    rels = [
        rel
        for rel in cs.snap.diff()
        if "/" in rel and (not rel.endswith("/STATUS.md") or rel in cs.before)
    ]
    projects = {rel.split("/")[0] for rel in rels}
    scope = next(iter(projects)) if len(projects) == 1 else None
    if c.subject:
        subject = ensure_conventional_subject(c.subject, scope)
    else:
        subject = conventional_subject(mcp_describe(cs), scope)
    lines = [subject]
    if c.body:
        lines += ["", wrap_body(c.body)]
    trailers = [f"Conversation: {c.conversation}"] if c.conversation else []
    trailers += [f"Ref: {r}" for r in c.refs]
    trailers += [
        f"{MCP_REQUEST_ID_TRAILER}: {rid}",
        f"{MCP_REQUEST_DIGEST_TRAILER}: {digest[:MCP_REQUEST_DIGEST_LEN]}",
    ]
    lines += ["", *trailers]
    return "\n".join(lines) + "\n"


def mcp_log(message: str) -> None:
    print(f"taskgo mcp: {message}", file=sys.stderr)


def mcp_log_value(value: Any, limit: int = MCP_LOG_VALUE_MAX) -> str:
    """VALUE as a log field: bare when it is a plain token, otherwise quoted
    as JSON, so text from a client can neither break nor forge a line."""
    text = str(value)
    if len(text) > limit:
        text = text[: limit - 1] + "\u2026"
    if re.fullmatch(r"[\w./:@+-]+", text, re.ASCII):
        return text
    return json.dumps(text)


MCP_LOG_QUOTED = re.compile(r"'(?:[^'\\]|\\.)*'|\"(?:[^\"\\]|\\.)*\"")


def mcp_log_reason(message: str) -> str:
    """MESSAGE, a tool error, for the log: its first line, with quoted values
    elided, since those can be tracker text (a title in a failed
    precondition)."""
    return MCP_LOG_QUOTED.sub("'\u2026'", message.split("\n", 1)[0])


@dataclass(slots=True)
class McpEvent:
    """What one request came to, for the line and the record logged for it.

    The outcome is ok, tool-error (a tool call that failed), rpc-error (a
    JSON-RPC error), refused (an HTTP refusal before JSON-RPC), or error (the
    reply could not be sent). Fields name the request, never its content.
    """

    transport: str
    started: float
    http: str | None = None
    method: Any = None
    tool: Any = None
    outcome: str = "ok"
    status: int | None = None
    commit: str | None = None
    reason: str | None = None
    agent: str | None = None
    caller: str | None = None
    size: int | None = None  # bytes of a tool call's result
    args: dict[str, str] | None = None
    at: float = dataclass_field(default_factory=time.time)
    ms: int | None = None

    def fail(self, outcome: str, reason: str) -> None:
        self.outcome, self.reason = outcome, reason

    def finish(self) -> None:
        if self.ms is None:
            self.ms = int((time.monotonic() - self.started) * 1000)

    def line(self) -> str:
        self.finish()
        fields: list[tuple[str, Any]] = [
            ("transport", self.transport),
            ("http", self.http),
            ("method", self.method),
            ("tool", self.tool),
            ("outcome", self.outcome),
            ("status", self.status),
            ("ms", self.ms),
            ("commit", self.commit),
        ]
        parts = [f"{k}={mcp_log_value(v)}" for k, v in fields if v is not None]
        if self.reason:
            parts.append(f"reason={mcp_log_value(self.reason, MCP_LOG_REASON_MAX)}")
        if self.agent:
            parts.append(f"agent={mcp_log_value(self.agent)}")
        return "request " + " ".join(parts)

    def record(self) -> dict[str, Any]:
        """The request as a JSON record, with the line's fields and when it
        came, its result's size, its caller key, and the server's version.
        Client text is truncated as in the line; JSON escapes the rest."""
        self.finish()

        def text(value: Any, limit: int = MCP_LOG_VALUE_MAX) -> str | None:
            if value is None:
                return None
            value = str(value)
            return value if len(value) <= limit else value[: limit - 1] + "\u2026"

        stamp = datetime.fromtimestamp(self.at, timezone.utc)
        rec = {
            "ts": stamp.isoformat(timespec="milliseconds").replace("+00:00", "Z"),
            "transport": self.transport,
            "http": self.http,
            "method": text(self.method),
            "tool": text(self.tool),
            "args": self.args or None,
            "outcome": self.outcome,
            "status": self.status,
            "ms": self.ms,
            "bytes": self.size,
            "commit": self.commit,
            "reason": text(self.reason, MCP_LOG_REASON_MAX),
            "agent": text(self.agent),
            "caller": self.caller,
            "version": MCP_SERVER_VERSION,
        }
        return {k: v for k, v in rec.items() if v is not None}


def mcp_log_args(args: dict[str, Any]) -> dict[str, str]:
    """A tool call's ARGS for its record: the MCP_LOG_ARGS that are present,
    each on one line and shortened, and apply_changes' changes as each one's
    operation and target."""

    def short(value: Any) -> str:
        if isinstance(value, list):
            value = " ".join(str(v) for v in value)
        text = " ".join(str(value).split())
        if len(text) > MCP_LOG_ARG_MAX:
            text = text[: MCP_LOG_ARG_MAX - 1] + "\u2026"
        return text

    out = {
        k: short(args[k])
        for k in MCP_LOG_ARGS
        if isinstance(args.get(k), (str, int, bool, list))
    }
    changes = args.get("changes")
    if isinstance(changes, list):
        parts = []
        for c in changes:
            if not isinstance(c, dict):
                continue
            target = c.get("record") or c.get("path") or c.get("project")
            detail = c.get("field") or c.get("section")
            parts.append(" ".join(str(x) for x in (c.get("op"), target, detail) if x))
        out["changes"] = short(f"{len(changes)}: " + ", ".join(parts))
    return out


def mcp_caller(*parts: Any) -> str:
    """An opaque key for one caller, from PARTS that identify it, so that a
    record groups a caller's calls without naming who it is."""
    joined = "\0".join("" if p is None else str(p) for p in parts)
    return hashlib.sha256(joined.encode()).hexdigest()[:10]


def mcp_log_default() -> Path:
    """The request log's path without --log or TASKGO_MCP_LOG."""
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "taskgo" / "mcp.jsonl"


def mcp_log_files(path: Path) -> list[Path]:
    """PATH and its rotated files that exist, oldest first."""
    rotated = [Path(f"{path}.{i}") for i in range(MCP_LOG_ROTATED, 0, -1)]
    return [f for f in [*rotated, path] if f.is_file()]


def mcp_log_records(f: Path, since: float | None = None) -> list[dict[str, Any]]:
    """The records in log file F, from SINCE (seconds since the epoch) on,
    each with its time as _at. Lines that are not records are skipped: a
    write cut short leaves a partial line."""
    records: list[dict[str, Any]] = []
    with open(f, encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            try:
                rec = json.loads(raw)
                at = datetime.fromisoformat(rec["ts"]).timestamp()
            except (ValueError, TypeError, KeyError):
                continue
            if since is None or at >= since:
                rec["_at"] = at
                records.append(rec)
    return records


def mcp_log_read(path: Path, since: float | None = None) -> list[dict[str, Any]]:
    """The records in PATH and its rotated files, oldest first, from SINCE
    on."""
    return [rec for f in mcp_log_files(path) for rec in mcp_log_records(f, since)]


class McpLog:
    """Where each request is logged: a line on stderr, a record appended to
    the log file, and, for the log page, the latest records in memory.

    Logging never fails a request. A record the file cannot take is dropped
    there (the stderr line remains), with one warning. Several servers may
    share one file, as stdio servers do by default: each append and rotation
    holds an exclusive lock on the file.
    """

    def __init__(self, path: Path | None, keep: int = 0):
        import collections
        import secrets

        self.path = path
        self.recent: collections.deque[tuple[int, dict[str, Any]]] = collections.deque(
            maxlen=keep or None
        )
        self.keep = keep
        self.seq = 0
        # Names this process's sequence of records for the page's cursor.
        self.instance = secrets.token_hex(4)
        self.warned = False
        if keep and path:
            # The latest records, read from the newest file back.
            latest: list[dict[str, Any]] = []
            try:
                for f in reversed(mcp_log_files(path)):
                    latest = mcp_log_records(f) + latest
                    if len(latest) >= keep:
                        break
            except OSError as e:
                self.warn(e)
            for rec in latest[-keep:]:
                rec.pop("_at", None)
                self.remember(rec)

    def remember(self, rec: dict[str, Any]) -> None:
        if self.keep:
            self.seq += 1
            self.recent.append((self.seq, rec))

    def emit(self, event: McpEvent) -> None:
        mcp_log(event.line())
        rec = event.record()
        self.remember(rec)
        if self.path:
            try:
                self.append(json.dumps(rec, separators=(",", ":")) + "\n")
            except OSError as e:
                self.warn(e)

    def warn(self, e: OSError) -> None:
        if not self.warned:
            self.warned = True
            mcp_log(
                f"cannot use the request log {self.path}: {e}; logging to stderr only"
            )

    def append(self, line: str) -> None:
        import fcntl

        assert self.path
        data = line.encode()
        self.path.parent.mkdir(parents=True, exist_ok=True)
        # Another server may rotate the file between the open and the lock;
        # then the lock is on a rotated file, so open the new one.
        for _ in range(3):
            with open(self.path, "ab") as fh:
                fcntl.flock(fh, fcntl.LOCK_EX)
                st = os.fstat(fh.fileno())
                try:
                    current = os.stat(self.path).st_ino == st.st_ino
                except FileNotFoundError:
                    current = False
                if not current:
                    continue
                if st.st_size and st.st_size + len(data) > MCP_LOG_ROTATE_BYTES:
                    for i in range(MCP_LOG_ROTATED - 1, 0, -1):
                        older = Path(f"{self.path}.{i}")
                        if older.exists():
                            os.replace(older, f"{self.path}.{i + 1}")
                    os.replace(self.path, f"{self.path}.1")
                    with open(self.path, "ab") as fresh:
                        fresh.write(data)
                else:
                    fh.write(data)
                return
        raise OSError(f"{self.path} kept being rotated")

    def since(self, cursor: int) -> list[dict[str, Any]]:
        return [rec for seq, rec in self.recent if seq > cursor]


def mcp_percentile(values: list[int], pct: int) -> int | None:
    """The nearest-rank PCT percentile of VALUES."""
    if not values:
        return None
    ordered = sorted(values)
    return ordered[max(0, -(-len(ordered) * pct // 100) - 1)]


def mcp_log_stats(
    records: list[dict[str, Any]], gap: float = MCP_CHAIN_GAP, top: int = 10
) -> dict[str, Any]:
    """Counts over request RECORDS (oldest first): outcomes, then requests,
    failures, and latency per client and per tool, then the commonest runs of
    two or three tool calls within one caller's chains (calls GAP seconds
    apart or less), by client."""

    def group(key: str) -> list[dict[str, Any]]:
        rows: dict[str, list[dict[str, Any]]] = {}
        for rec in records:
            if rec.get(key) is not None:
                rows.setdefault(str(rec[key]), []).append(rec)
        out = []
        for name, recs in rows.items():
            ms = [r["ms"] for r in recs if isinstance(r.get("ms"), int)]
            sizes = [r["bytes"] for r in recs if isinstance(r.get("bytes"), int)]
            out.append(
                {
                    key: name,
                    "requests": len(recs),
                    "failed": sum(r.get("outcome") != "ok" for r in recs),
                    "p50_ms": mcp_percentile(ms, 50),
                    "p95_ms": mcp_percentile(ms, 95),
                    "p50_bytes": mcp_percentile(sizes, 50),
                }
            )
        return sorted(out, key=lambda row: (-row["requests"], row[key]))

    outcomes: dict[str, int] = {}
    for rec in records:
        outcome = str(rec.get("outcome"))
        outcomes[outcome] = outcomes.get(outcome, 0) + 1

    chains: list[tuple[str, list[str]]] = []
    open_chains: dict[tuple[Any, ...], tuple[float, list[str]]] = {}
    for rec in records:
        if rec.get("method") != "tools/call" or rec.get("tool") is None:
            continue
        at = rec.get("_at")
        if at is None:
            try:
                at = datetime.fromisoformat(rec["ts"]).timestamp()
            except (ValueError, TypeError, KeyError):
                continue
        key = (rec.get("transport"), rec.get("caller"), rec.get("agent"))
        last = open_chains.get(key)
        if last is None or at - last[0] > gap:
            calls: list[str] = []
            chains.append((str(rec.get("agent") or rec.get("transport")), calls))
        else:
            calls = last[1]
        calls.append(str(rec["tool"]))
        open_chains[key] = (at, calls)
    runs: dict[tuple[str, tuple[str, ...]], int] = {}
    for client, calls in chains:
        for size in (2, 3):
            for i in range(len(calls) - size + 1):
                run = (client, tuple(calls[i : i + size]))
                runs[run] = runs.get(run, 0) + 1
    sequences = [
        {"agent": client, "calls": list(calls), "count": count}
        for (client, calls), count in sorted(
            runs.items(), key=lambda kv: (-kv[1], -len(kv[0][1]), kv[0])
        )
        if count > 1
    ][:top]

    return {
        "requests": len(records),
        "first": records[0]["ts"] if records else None,
        "last": records[-1]["ts"] if records else None,
        "outcomes": dict(sorted(outcomes.items(), key=lambda kv: -kv[1])),
        "agents": group("agent"),
        "tools": group("tool"),
        "chains": len(chains),
        "sequences": sequences,
    }


class McpServer:
    """The tools, shared by the HTTP and stdio transports.

    Calls are serialized: they share the Git repository and snapshot cache,
    and the core is not written for concurrent use. Serializing also keeps
    this server's own writes from racing each other; pushes from elsewhere
    race on equal terms, through the remote's refusal of a non-fast-forward.
    """

    def __init__(self, cfg: McpConfig, log: McpLog | None = None):
        import threading

        self.reader = McpReader(cfg)
        # Without a log, requests are logged to stderr only.
        self.log = log or McpLog(None)
        self.lock = threading.Lock()
        # request_id -> McpRequest. In memory: losing it, as on a restart,
        # loses only the recognition of retries, never a write (ADR 2).
        self.requests: dict[str, McpRequest] = {}

    def call_tool(self, params: dict[str, Any], event: McpEvent) -> dict[str, Any]:
        event.tool = params.get("name")
        tool = MCP_TOOLS_BY_NAME.get(params.get("name"))
        if tool is None:
            event.fail("tool-error", "unknown tool")
            return mcp_tool_error(f"unknown tool: {params.get('name')}")
        args = params.get("arguments") or {}
        if not isinstance(args, dict):
            event.fail("tool-error", "arguments must be an object")
            return mcp_tool_error("arguments must be an object")
        event.args = mcp_log_args(args)
        with self.lock:
            try:
                if tool.writes:
                    result = self.write(tool, args)
                    sha = result["as_of"]["commit"]
                else:
                    sha, stale = self.reader.resolve_for_read(args.get("at"))
                    snap, committed = self.reader.snapshot(sha)
                    result = tool.handler(
                        McpRead(self.reader, snap, committed, stale), args
                    )
            except McpToolError as e:
                event.fail("tool-error", mcp_log_reason(str(e)))
                return mcp_tool_error(str(e))
            except SystemExit:
                # The core died with its message on stderr.
                event.fail("tool-error", "the taskgo core refused the request")
                return mcp_tool_error("the taskgo core refused the request")
            except Exception:
                import traceback

                traceback.print_exc()
                event.fail("tool-error", "internal error")
                return mcp_tool_error("internal error; see the server log")
        event.commit = sha[:12]
        text = json.dumps(result, indent=1)
        event.size = len(text.encode())
        return {
            "content": [{"type": "text", "text": text}],
            "structuredContent": result,
            "isError": False,
        }

    def write(self, tool: McpTool, args: dict[str, Any]) -> dict[str, Any]:
        """Applies a write tool's change set as one commit on the branch.

        The set applies over the head and is pushed without force. The head
        is the cached one when there is one, and the push checks that it
        still is: a refused push re-reads the head from the remote. If the
        commit is there, the push did land; otherwise the set applies again
        over the new head, so its preconditions are checked against what is
        now there. A refusal by the set itself over a cached head is checked
        against the fetched head the same way. A request_id seen before
        fetches first and reports the commit already built for it, when that
        commit is on the branch, instead of writing again; one not in memory
        is looked for in the trailers of the commits behind the head first.
        Without a remote (--local), the local branch is the head, read for
        every write, and moving it is the push. Called with the lock held.
        """
        reader, cfg = self.reader, self.reader.cfg
        unknown = sorted(set(args) - set(tool.properties))
        if unknown:
            raise McpToolError(
                f"unknown argument {', '.join(unknown)}"
                + (
                    "; writes always apply to the head of the branch"
                    if "at" in unknown
                    else ""
                )
            )
        if cfg.remote is None and not cfg.local:
            raise McpToolError(
                "this server reads a local branch (--no-fetch) and has nowhere "
                "to push; it does not write"
            )
        rid = mcp_line(args.get("request_id"), "request_id", MCP_REQUEST_ID_MAX)
        label = f"{tool.name} {json.dumps(rid[:40])}"
        doc = tool.handler(args)
        commit_args = mcp_commit_args(args)
        for ident in ("GIT_AUTHOR_IDENT", "GIT_COMMITTER_IDENT"):
            # Never a guessed identity: only the configured owner commits.
            if reader.git("-c", "user.useConfigOnly=true", "var", ident).returncode:
                raise McpToolError(
                    "the server has no commit identity: set user.name and "
                    "user.email, or GIT_AUTHOR_NAME, GIT_AUTHOR_EMAIL, "
                    "GIT_COMMITTER_NAME, and GIT_COMMITTER_EMAIL"
                )
        digest = mcp_request_digest(args)
        now = time.monotonic()
        for key in [
            k for k, r in self.requests.items() if now - r.seen > MCP_REQUEST_TTL
        ]:
            del self.requests[key]
        while len(self.requests) >= MCP_REQUEST_KEEP:
            del self.requests[next(iter(self.requests))]
        request = self.requests.get(rid)
        reused = (
            f"request_id {rid!r} was used for a different write; pass a fresh "
            "one for each write"
        )
        if request is not None and request.digest != digest:
            raise McpToolError(reused)

        # A request seen before reads the remote as it is now, so a commit
        # built for it that landed unseen is found. Otherwise the set first
        # applies over the cached head, when there is one, and the push says
        # whether it was still the head; anything that can come from a stale
        # head (a refused push, a failed precondition or validation, no
        # change, no commit authority) fetches and tries again.
        fetched = request is not None or not reader.cached()
        try:
            head = reader.resolve(None, fetch=fetched)
        except McpToolError:
            raise McpToolError(f"{cfg.unreadable()}; nothing was written") from None
        if request is not None:
            for sha, result in request.candidates.items():
                if reader.is_ancestor(sha, head):
                    mcp_log(f"{label} already landed as {sha[:12]}")
                    return {**self.landed(result), "replayed": True}
        else:
            # Forgotten, as after a restart: the branch may still remember.
            found = reader.find_request(head, rid)
            if found is not None:
                sha, recorded = found
                if recorded != digest[:MCP_REQUEST_DIGEST_LEN]:
                    raise McpToolError(reused)
                mcp_log(f"{label} already landed as {sha[:12]} (from its trailers)")
                result = self.recorded(sha, rid)
                self.requests[rid] = McpRequest(digest, now, {sha: result})
                return {**self.landed(result), "replayed": True}

        def refetch(why: str) -> str:
            mcp_log(f"{label} cached head {head[:12]} may be stale ({why}); fetching")
            reader.forget()
            try:
                return reader.resolve(None, fetch=True)
            except McpToolError:
                raise McpToolError(f"{cfg.unreadable()}; nothing was written") from None

        # Pushes allowed: the first, over a cached head, does not count.
        budget = MCP_WRITE_ATTEMPTS + (0 if fetched else 1)
        pushes = 0
        mine: set[str] = set()
        while True:
            snap, committed = reader.snapshot(head)
            if not snap.is_file("AGENTS.md") or COMMIT_AUTH not in snap.read_text(
                "AGENTS.md"
            ):
                if not fetched:
                    head, fetched = refetch("no commit authority"), True
                    continue
                raise McpToolError(
                    f"writes are refused: AGENTS.md at {head[:12]} does not carry "
                    f"{COMMIT_AUTH}"
                )
            try:
                cs = apply_change_set(snap, doc, commit_args.conversation)
            except ChangeSetError as e:
                if not fetched and e.kind != "invalid":
                    head, fetched = refetch(MCP_CHANGE_ERRORS[e.kind]), True
                    continue
                raise McpToolError(
                    f"{MCP_CHANGE_ERRORS[e.kind]}: {e}; nothing was written"
                ) from None
            if not cs.snap.diff():
                if not fetched:
                    head, fetched = refetch("no change"), True
                    continue
                mcp_log(f"{label} changes nothing at {head[:12]}")
                return {
                    "as_of": McpRead(reader, snap, committed).as_of(),
                    "request_id": rid,
                    "commit": None,
                    "subject": None,
                    "created": [],
                    "files": [],
                    "attempts": pushes,
                    "replayed": False,
                }
            message = mcp_commit_message(cs, commit_args, rid, digest)
            sha = reader.commit(snap, cs, message)
            pushes += 1
            result = {
                "request_id": rid,
                "commit": sha,
                "subject": message.split("\n", 1)[0],
                **change_set_result(cs),
                "attempts": pushes,
                "replayed": False,
            }
            # Remembered only once there is a commit to recognize: a request
            # refused before that can be corrected and sent with the same ID.
            # Every pushed commit is kept, since a push can land unseen.
            if request is None:
                request = self.requests[rid] = McpRequest(digest, now, {})
            request.candidates[sha] = result
            mine.add(sha)
            pushed, why = reader.push(sha)
            if pushed:
                reader.pushed(sha)
                mcp_log(f"{label} attempt {pushes} pushed {sha[:12]} on {head[:12]}")
                return self.landed(result)
            mcp_log(f"{label} attempt {pushes} push of {sha[:12]} refused: {why}")
            reader.forget()
            try:
                new_head = reader.resolve(None, fetch=True)
            except McpToolError:
                raise McpToolError(
                    f"the push of {sha[:12]} failed ({why}) and {cfg.branch} could "
                    "not be read again, so whether it landed is unknown; retry "
                    "with the same request_id"
                ) from None
            fetched = True
            for cand, cand_result in request.candidates.items():
                if reader.is_ancestor(cand, new_head):
                    mcp_log(f"{label} attempt {pushes} landed {cand[:12]} after all")
                    return {**self.landed(cand_result), "replayed": cand not in mine}
            if new_head == head:
                raise McpToolError(
                    f"could not update {cfg.where()}: {why}; nothing was written"
                )
            head = new_head
            if pushes >= budget:
                raise McpToolError(
                    f"{cfg.branch} moved on each of {pushes} attempts; nothing "
                    "was written. Retry with the same request_id"
                )

    def landed(self, result: dict[str, Any]) -> dict[str, Any]:
        """RESULT, with as_of for its commit."""
        snap, committed = self.reader.snapshot(result["commit"])
        return {"as_of": McpRead(self.reader, snap, committed).as_of(), **result}

    def recorded(self, sha: str, rid: str) -> dict[str, Any]:
        """The result of the write that made commit SHA, as far as the commit
        tells it: its subject, the records it created, and the files it
        changed, but not the lines of its edits."""
        reader = self.reader
        snap, _ = reader.snapshot(sha)
        raw = reader.git(
            "diff-tree", "-r", "--no-commit-id", "--raw", "-z", sha
        ).stdout.split("\0")
        files, created = [], []
        rows = {r.rel_path: r.task_id for r in get_task_rows(snap)}
        # Each entry is ':mode mode blob blob status' then the path.
        for meta, rel in zip(raw[0::2], raw[1::2], strict=False):
            status, blob = meta.split()[4][0], meta.split()[3]
            files.append(
                {
                    "path": rel,
                    "change": {"A": "added", "D": "deleted"}.get(status, "modified"),
                    "blob": None if status == "D" else blob,
                }
            )
            if status == "A" and "/decisions/" in rel:
                created.append({"kind": "decision", "path": rel})
            elif status == "A" and rows.get(rel):
                created.append({"kind": "task", "id": rows[rel], "path": rel})
        return {
            "request_id": rid,
            "commit": sha,
            "subject": reader.git("show", "-s", "--format=%s", sha).stdout.strip(),
            "created": created,
            "files": files,
            "attempts": 0,
            "replayed": True,
        }


# The request being served, for the transport's log line. McpGate sets it for
# each HTTP request; over stdio, the SDK middleware sets it for each message.
MCP_EVENT: contextvars.ContextVar[McpEvent | None] = contextvars.ContextVar(
    "MCP_EVENT", default=None
)

MCP_RPC_ERRORS = {
    -32700: "parse error",
    -32600: "invalid request",
    -32601: "method not found",
    -32602: "invalid params",
    -32603: "internal error",
}


def mcp_rpc_reason(code: Any) -> str:
    """The log reason for JSON-RPC error CODE: a fixed phrase, since the
    message beside it can quote the request."""
    return MCP_RPC_ERRORS.get(code, f"error {mcp_log_value(code)}")


def mcp_sdk_server(server: McpServer) -> Any:
    """SERVER's tools behind the MCP SDK's low-level server, which speaks the
    protocol: every revision the SDK supports, over either transport."""
    import anyio
    import mcp_types
    from mcp.server.lowlevel import Server
    from mcp.shared.exceptions import MCPError

    async def list_tools(ctx: Any, params: Any) -> Any:
        return mcp_types.ListToolsResult(
            tools=[mcp_types.Tool.model_validate(t.listing()) for t in MCP_TOOLS]
        )

    async def call_tool(ctx: Any, params: Any) -> Any:
        event = MCP_EVENT.get() or McpEvent("none", time.monotonic())
        raw = {"name": params.name, "arguments": params.arguments}
        # In a worker thread, so a long fetch or push holds up only the calls
        # queued behind it on the lock, not the event loop.
        result = await anyio.to_thread.run_sync(server.call_tool, raw, event)
        return mcp_types.CallToolResult.model_validate(result)

    # One stdio server serves one client.
    stdio_caller = mcp_caller("stdio", os.getpid(), time.time())

    async def logged(ctx: Any, call_next: Any) -> Any:
        """Logs each stdio message; McpGate logs HTTP requests itself."""
        if MCP_EVENT.get() is not None:
            return await call_next(ctx)
        event = McpEvent(
            "stdio", time.monotonic(), method=ctx.method, caller=stdio_caller
        )
        token = MCP_EVENT.set(event)
        try:
            return await call_next(ctx)
        except MCPError as e:
            event.fail("rpc-error", mcp_rpc_reason(e.code))
            raise
        except Exception:
            # The SDK reports malformed params as a pydantic ValidationError.
            event.fail("rpc-error", mcp_rpc_reason(-32602))
            raise
        finally:
            MCP_EVENT.reset(token)
            server.log.emit(event)

    sdk = Server(
        "taskgo",
        version=MCP_SERVER_VERSION,
        instructions=MCP_INSTRUCTIONS,
        on_list_tools=list_tools,
        on_call_tool=call_tool,
    )
    sdk.middleware.append(logged)
    return sdk


def mcp_serve_stdio(server: McpServer) -> None:
    """Newline-delimited JSON-RPC on stdin and stdout, for one local client."""
    import anyio
    from mcp.server.stdio import stdio_server

    sdk = mcp_sdk_server(server)

    async def serve() -> None:
        async with stdio_server() as (read, write):
            await sdk.run(read, write, sdk.create_initialization_options())

    anyio.run(serve)


def mcp_is_loopback(host: str | None) -> bool:
    if not host:
        return False
    host = host.strip().lower()
    if host.startswith("["):  # [::1]:8080
        host = host[1 : host.find("]")]
    elif host.count(":") == 1:  # localhost:8080
        host = host.split(":", 1)[0]
    return host in MCP_LOOPBACK


async def mcp_asgi_reply(
    send: Callable,
    status: int,
    text: str,
    allow: str | None = None,
    content_type: str = "text/plain; charset=utf-8",
    extra: tuple[tuple[str, str], ...] = (),
) -> None:
    data = text.encode()
    headers = [
        (b"content-type", content_type.encode()),
        (b"content-length", str(len(data)).encode()),
    ]
    if allow:
        headers.append((b"allow", allow.encode()))
    headers += [(k.encode(), v.encode()) for k, v in extra]
    await send({"type": "http.response.start", "status": status, "headers": headers})
    await send({"type": "http.response.body", "body": data})


# The log page: static, with every value inserted as text. It polls
# MCP_LOGS_DATA_PATH every second for the records after its cursor and the
# stats over those kept; kamal-proxy buffers responses, so it polls rather
# than streams. The script is pinned by its hash in the page's CSP.
MCP_LOGS_SCRIPT = """
const DATA = "@DATA@", MAX = 500, CLIENT_MAX = @CLIENT_MAX@;
const $ = (id) => document.getElementById(id);
const state = { server: "", next: 0 };

function cell(tr, text, cls) {
  const td = tr.insertCell();
  td.textContent = text == null ? "" : String(text);
  if (cls) td.className = cls;
  return td;
}

// A client's name, clipped; the cell's title has all of it.
function client(tr, name, cls) {
  const td = cell(tr, name, cls);
  if (name && name.length > CLIENT_MAX) {
    td.textContent = name.slice(0, CLIENT_MAX - 1) + "\u2026";
    td.title = name;
  }
  return td;
}

function table(el, head, rows) {
  const t = document.createElement("table");
  const h = t.createTHead().insertRow();
  for (const [label, cls] of head) cell(h, label, cls);
  const b = t.createTBody();
  for (const r of rows) {
    const tr = b.insertRow();
    r.forEach((v, i) => (head[i][2] ? client : cell)(tr, v, head[i][1]));
  }
  el.replaceChildren(t);
}

function row(rec) {
  const tr = document.createElement("tr");
  if (rec.outcome !== "ok") tr.className = "fail";
  const when = new Date(rec.ts);
  cell(tr, when.toLocaleTimeString([], { hour12: false })).title = rec.ts;
  client(tr, rec.agent || rec.transport);
  cell(tr, rec.caller);
  cell(tr, rec.method);
  cell(tr, rec.tool);
  cell(tr, Object.entries(rec.args || {}).map(([k, v]) => `${k}=${v}`).join(" "), "args");
  cell(tr, rec.outcome);
  cell(tr, rec.status, "num");
  cell(tr, rec.ms, "num");
  cell(tr, rec.bytes, "num");
  cell(tr, rec.commit);
  cell(tr, rec.reason);
  return tr;
}

function render(stats, version) {
  const outcomes = Object.entries(stats.outcomes).map(([k, v]) => `${k} ${v}`);
  $("summary").textContent =
    `${stats.requests} requests kept` +
    (outcomes.length ? ` (${outcomes.join(", ")})` : "") +
    ` · ${stats.chains} chains · server ${version}`;
  const num = (label) => [label, "num"];
  const head = (name, clip) => [[name, "", clip], num("Requests"), num("Failed"),
    num("p50 ms"), num("p95 ms"), num("p50 bytes")];
  const line = (key) => (r) => [r[key], r.requests, r.failed,
    r.p50_ms, r.p95_ms, r.p50_bytes];
  table($("agents"), head("Client", true), stats.agents.map(line("agent")));
  table($("tools"), head("Tool"), stats.tools.map(line("tool")));
  table($("sequences"), [num("Count"), ["Client", "", true], ["Sequence"]],
    stats.sequences.map((q) => [q.count, q.agent, q.calls.join(" > ")]));
}

function status(cls, text) {
  $("status").className = cls;
  $("status").textContent = text;
}

async function poll() {
  let delay = 1000;
  try {
    const url = `${DATA}?after=${state.next}&server=${encodeURIComponent(state.server)}`;
    const reply = await fetch(url, { cache: "no-store", credentials: "same-origin" });
    if (!reply.ok) throw new Error(`HTTP ${reply.status}`);
    const data = await reply.json();
    if (data.server !== state.server) $("rows").replaceChildren();
    state.server = data.server;
    state.next = data.next;
    for (const rec of data.records) $("rows").prepend(row(rec));
    while ($("rows").children.length > MAX) $("rows").lastElementChild.remove();
    render(data.stats, data.version);
    status("live", "live");
  } catch (e) {
    status("down", `disconnected (${e.message}); retrying. Reload to sign in again.`);
    delay = 5000;
  }
  setTimeout(poll, delay);
}

poll();
""".replace("@DATA@", MCP_LOGS_DATA_PATH).replace("@CLIENT_MAX@", str(MCP_CLIENT_MAX))

MCP_LOGS_CSP = (
    "default-src 'none'; style-src 'unsafe-inline'; img-src data:; connect-src 'self'; "
    "script-src 'sha256-"
    + base64.b64encode(hashlib.sha256(MCP_LOGS_SCRIPT.encode()).digest()).decode()
    + "'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
)

