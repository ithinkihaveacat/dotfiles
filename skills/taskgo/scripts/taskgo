    )

    # fix
    p_fix = subparsers.add_parser(
        "fix",
        help="Auto-heal IDs, statuses, and snapshot drift",
        description="Auto-heal IDs, statuses, and snapshot drift.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_fix.add_argument(
        "project",
        nargs="?",
        default=None,
        metavar="PROJECT",
        help="Optional target project",
    )
    p_fix.add_argument(
        "--dry-run",
        action="store_true",
        help="Preview repairs without modifying files",
    )
    p_fix.add_argument(
        "--no-commit",
        action="store_true",
        help="Apply repairs on disk without committing",
    )

    # history
    p_history = subparsers.add_parser(
        "history",
        help="Show frontmatter field history across git revisions",
        description="Show frontmatter field history across git revisions.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_history.add_argument(
        "query", metavar="PATH_OR_TASK_ID", help="Task ID or relative path"
    )
    p_history.add_argument(
        "field",
        nargs="?",
        default="status",
        metavar="FIELD",
        help="Frontmatter field to track (default: status)",
    )

    # checkpoint
    p_checkpoint = subparsers.add_parser(
        "checkpoint",
        help="Commit an authorized tracker checkpoint for TASK_ID",
        description="Commit an authorized tracker checkpoint for TASK_ID.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  taskgo checkpoint TASK-3A91F "proj: start diagnosis" --all
  taskgo checkpoint TASK-3A91F "proj: update task" --path proj/tasks/TASK-3A91F-slug.md """,
    )
    p_checkpoint.add_argument("task_id", metavar="TASK_ID", help="Target task ID")
    p_checkpoint.add_argument("subject", metavar="SUBJECT", help="Commit subject line")
    p_checkpoint.add_argument(
        "--all",
        "-a",
        dest="all_files",
        action="store_true",
        help="Stage all modified/untracked project files",
    )
    p_checkpoint.add_argument(
        "--path",
        "-p",
        dest="paths",
        action="append",
        default=[],
        help="Explicit project files to stage",
    )
    p_checkpoint.add_argument("--body", "-b", default="", help="Commit body")
    p_checkpoint.add_argument(
        "--ref",
        "-r",
        dest="refs",
        action="append",
        default=[],
        help="External references (e.g. artifact@sha)",
    )
    p_checkpoint.add_argument(
        "--conv",
        "-C",
        "--conversation",
        dest="conv",
        default=None,
        help="Active conversation or session ID",
    )

    # commit
    p_commit = subparsers.add_parser(
        "commit",
        help="Commit a logical transition with automatic project status synchronization",
        description="Commit a logical transition with automatic project status synchronization.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_commit.add_argument("subject", metavar="SUBJECT", help="Commit subject line")
    p_commit.add_argument("--body", "-b", default="", help="Commit body")
    p_commit.add_argument(
        "--ref",
        "-r",
        dest="refs",
        action="append",
        default=[],
        help="External references (e.g. artifact@sha)",
    )
    p_commit.add_argument(
        "--conv",
        "-C",
        "--conversation",
        dest="conv",
        default=None,
        help="Active conversation or session ID",
    )

    return parser


def main(argv: list[str] | None = None) -> None:
    if argv is None:
        argv = sys.argv[1:]

    if not argv or (len(argv) == 1 and argv[0] in ("--help", "-h", "help")):
        print(HELP_TEXT)
        sys.exit(0)

    parser = create_parser()
    args = parser.parse_args(argv)

    global _ACTIVE_COMMAND
    _ACTIVE_COMMAND = args.command
    set_explicit_root(getattr(args, "root", None))

    if args.command == "id":
        cmd_id()
    elif args.command == "root":
        cmd_root()
    elif args.command == "create":
        cmd_create(
            project_name=args.project_name,
            title=args.title,
            status=args.status,
            problem=args.problem,
            goal=args.goal,
            criteria=args.criteria,
            sketch=args.sketch,
            constraints=args.constraints,
            outcome=args.outcome,
            findings=args.findings,
            next_steps=args.next_steps,
            conv=getattr(args, "conv", None),
            no_commit=args.no_commit,
            dry_run=args.dry_run,
        )
    elif args.command == "update":
        cmd_update(
            query=args.query,
            status=args.status,
            title=args.title,
            problem=args.problem,
            goal=args.goal,
            criteria=args.criteria,
            sketch=args.sketch,
            constraints=args.constraints,
            outcome=args.outcome,
            findings=args.findings,
            next_steps=args.next_steps,
            conv=getattr(args, "conv", None),
        )
    elif args.command == "list":
        cmd_list(
            project=args.project,
            state=args.state,
            as_json=args.as_json,
        )
    elif args.command == "status":
        cmd_status(
            project=args.project,
            as_json=args.as_json,
        )
    elif args.command == "sync":
        cmd_sync(project=args.project)
    elif args.command == "doctor":
        cmd_doctor(project=args.project)
    elif args.command == "fix":
        cmd_fix(
            project=args.project,
            dry_run=args.dry_run,
            no_commit=args.no_commit,
        )
    elif args.command == "history":
        cmd_history(
            query=args.query,
            field=args.field,
        )
    elif args.command == "checkpoint":
        cmd_checkpoint(
            task_id=args.task_id,
            subject=args.subject,
            all_files=args.all_files,
            paths=args.paths,
            body=args.body,
            refs=args.refs,
            conv=getattr(args, "conv", None),
        )
    elif args.command == "commit":
        cmd_commit(
            subject=args.subject,
            body=args.body,
            refs=args.refs,
            conv=getattr(args, "conv", None),
        )
    else:
        print(HELP_TEXT)
        sys.exit(0)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        handle_signal_exit(signal.SIGINT)
    except BrokenPipeError:
        import os

        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(128 + signal.SIGPIPE)
