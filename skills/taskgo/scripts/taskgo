#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "mdformat",
#     "mdformat-gfm",
#     "mdformat-frontmatter",
#     "ruamel.yaml",
# ]
# ///

import argparse
import hashlib
import io
import json
import os
import re
import signal
import subprocess
import sys
import time
from collections.abc import Callable
from dataclasses import dataclass
from enum import StrEnum
from pathlib import Path
from typing import Any, Literal, TypedDict

import mdformat
from ruamel.yaml import YAML
from ruamel.yaml.representer import Representer, RoundTripRepresenter

BEGIN = "<!-- taskgo:begin -->"
END = "<!-- taskgo:end -->"
CANONICAL_URL = "https://github.com/ithinkihaveacat/dotfiles/tree/master/skills/taskgo"
COMMIT_AUTH = "<!-- taskgo:allow-local-commits -->"
ID_PATTERN = re.compile(r"^TASK-[0-9A-F]{5}$")
WRAP_WIDTH = 80


class TaskStatus(StrEnum):
    TODO = "todo"
    IN_PROGRESS = "in-progress"
    BLOCKED = "blocked"
    DONE = "done"
    CANCELLED = "cancelled"


RoundTripRepresenter.add_representer(
    TaskStatus, lambda dumper, data: dumper.represent_str(str(data))
)
Representer.add_representer(
    TaskStatus, lambda dumper, data: dumper.represent_str(str(data))
)

STANDARD_STATES = {s.value for s in TaskStatus}


class TaskFrontmatter(TypedDict, total=False):
    id: str
    status: str
    conversations: list[str]


def normalize_conversation_id(conv: str | None) -> str | None:
    """Validates and normalizes a conversation or session identifier."""
    if not conv:
        return None
    c = conv.strip()
    if c.startswith("conversation://"):
        c = c.removeprefix("conversation://")
    if not c:
        return None
    if len(c) < 16 or not re.match(r"^[A-Za-z0-9_-]+$", c):
        die(
            f"invalid conversation ID '{conv}' (must be a globally unique identifier with at least 16 alphanumeric characters, dashes, or underscores)"
        )
    return c


def get_active_conversation_id(cli_arg: str | None = None) -> str | None:
    """Resolves the conversation ID from explicit CLI arg or opportunistic environment variables."""
    if cli_arg:
        return normalize_conversation_id(cli_arg)
    # TODO: Verify whether these candidate environment variable names are
    # actively populated in practice across different agent runtimes (e.g.
    # Jetski, Claude Code, Antigravity) or if other conventions are used.
    for var in (
        "JETSKI_CONVERSATION_ID",
        "INVOKER_INFO_ROOT_SESSION_ID",
        "CONVERSATION_ID",
    ):
        val = os.environ.get(var)
        if val:
            try:
                norm = normalize_conversation_id(val)
                if norm:
                    return norm
            except SystemExit:
                print(
                    f"[WARN]  Ignoring invalid conversation ID in ${var}: {val}",
                    file=sys.stderr,
                )
    return None


def reformat_frontmatter(text: str) -> str:
    """Reflows YAML frontmatter scalars to WRAP_WIDTH using ruamel.yaml."""
    m = re.search(r"^---\n(.*?)\n---(?:\n|$)", text, re.DOTALL)
    if not m:
        return text

    frontmatter_str = m.group(1)
    body = text[m.end() :]

    yaml = YAML()
    yaml.width = WRAP_WIDTH
    yaml.preserve_quotes = True
    yaml.default_flow_style = False

    try:
        data = yaml.load(frontmatter_str)
    except Exception:
        return text

    if not data:
        return text

    buf = io.StringIO()
    yaml.dump(data, buf)
    body_sep = "\n" if body else ""
    return f"---\n{buf.getvalue()}---\n{body_sep}{body}"


def format_markdown(text: str) -> str:
    """Formats Markdown text using mdformat (with gfm, frontmatter, and 80-char wrap)."""
    text = reformat_frontmatter(text)
    return mdformat.text(
        text,
        options={"wrap": WRAP_WIDTH},
        extensions={"gfm", "frontmatter"},
    )


STATE_ALIASES = {
    "todo": TaskStatus.TODO,
    "open": TaskStatus.TODO,
    "backlog": TaskStatus.TODO,
    "in-progress": TaskStatus.IN_PROGRESS,
    "in_progress": TaskStatus.IN_PROGRESS,
    "inprogress": TaskStatus.IN_PROGRESS,
    "wip": TaskStatus.IN_PROGRESS,
    "started": TaskStatus.IN_PROGRESS,
    "blocked": TaskStatus.BLOCKED,
    "hold": TaskStatus.BLOCKED,
    "on-hold": TaskStatus.BLOCKED,
    "done": TaskStatus.DONE,
    "complete": TaskStatus.DONE,
    "completed": TaskStatus.DONE,
    "closed": TaskStatus.DONE,
    "fixed": TaskStatus.DONE,
    "cancelled": TaskStatus.CANCELLED,
    "canceled": TaskStatus.CANCELLED,
    "abandoned": TaskStatus.CANCELLED,
    "wontfix": TaskStatus.CANCELLED,
}

# Keep track of active child processes for clean teardown on signal
_active_subprocesses: set[subprocess.Popen] = set()
_received_sigterm: bool = False


def reap_subprocesses(signaled_by_parent: bool = True) -> None:
    """Gracefully tear down active subprocesses in compliance with POSIX standards."""
    for proc in list(_active_subprocesses):
        if proc.poll() is not None:
            _active_subprocesses.discard(proc)
            continue

        try:
            proc.terminate()
        except ProcessLookupError:
            pass

        try:
            proc.wait(timeout=1.5)
        except subprocess.TimeoutExpired:
            try:
                proc.kill()
            except ProcessLookupError:
                pass
            try:
                proc.wait(timeout=1.0)
            except (subprocess.TimeoutExpired, ProcessLookupError):
                pass

        _active_subprocesses.discard(proc)


def handle_signal_exit(signum: int) -> None:
    # Protect teardown logic from re-entrant signals
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

    reap_subprocesses(signaled_by_parent=(signum == signal.SIGTERM))
    try:
        sys.stderr.write("\n")
        sys.stderr.flush()
    except OSError:
        pass
    sys.exit(128 + signum)


def sigterm_handler(signum, frame):
    handle_signal_exit(signal.SIGTERM)


def sigint_handler(signum, frame):
    handle_signal_exit(signal.SIGINT)


signal.signal(signal.SIGTERM, sigterm_handler)
signal.signal(signal.SIGINT, sigint_handler)


def die(msg: str, exit_code: int = 1) -> None:
    print(f"taskgo: {msg}", file=sys.stderr)
    sys.exit(exit_code)


_ACTIVE_COMMAND: str | None = None


def die_scoped(msg: str, exit_code: int = 1) -> None:
    """Dies with a git-style subcommand-scoped message (taskgo list: ...)."""
    if _ACTIVE_COMMAND:
        print(f"taskgo {_ACTIVE_COMMAND}: {msg}", file=sys.stderr)
        sys.exit(exit_code)
    die(msg, exit_code)


_REPO_ROOT_CACHE: Path | None = None
_EXPLICIT_ROOT: Path | None = None
DEFAULT_ROOT = "~/.projects"


def set_explicit_root(value: str | None) -> None:
    """Records an explicitly selected control repository root (--root option)."""
    global _EXPLICIT_ROOT
    if value:
        _EXPLICIT_ROOT = Path(value).expanduser()


def resolve_root_candidate() -> tuple[Path, str]:
    """Returns the configured root path and its source for error messages."""
    if _EXPLICIT_ROOT is not None:
        return _EXPLICIT_ROOT, "--root"
    env_root = os.environ.get("TASKGO_ROOT")
    if env_root:
        return Path(env_root).expanduser(), "TASKGO_ROOT"
    return Path(DEFAULT_ROOT).expanduser(), "default"


def get_repo_root() -> Path:
    global _REPO_ROOT_CACHE
    if _REPO_ROOT_CACHE is not None:
        return _REPO_ROOT_CACHE

    root_dir, source = resolve_root_candidate()
    shown = DEFAULT_ROOT if source == "default" else f"'{root_dir}'"
    if not root_dir.is_dir():
        hint = ""
        if source == "default":
            hint = (
                " (initialize it with: mkdir -p ~/.projects && git -C ~/.projects init)"
            )
        die_scoped(f"control repository {shown} does not exist{hint}")
    if not (root_dir / ".git").exists():
        die_scoped(f"control repository {shown} is not a Git repository (missing .git)")
    _REPO_ROOT_CACHE = root_dir.resolve()
    return _REPO_ROOT_CACHE


def run_git(
    args: list[str],
    cwd: Path | None = None,
    check: bool = True,
    capture_output: bool = True,
    text: bool = True,
    input_data: str | None = None,
) -> subprocess.CompletedProcess:
    if cwd is None:
        cwd = get_repo_root()
    cmd = ["git", *args]
    proc = subprocess.Popen(
        cmd,
        cwd=cwd,
        stdin=subprocess.PIPE if input_data is not None else None,
        stdout=subprocess.PIPE if capture_output else None,
        stderr=subprocess.PIPE if capture_output else None,
        text=text,
    )
    _active_subprocesses.add(proc)
    try:
        stdout, stderr = proc.communicate(input=input_data)
    finally:
        _active_subprocesses.discard(proc)

    ret = subprocess.CompletedProcess(cmd, proc.returncode, stdout or "", stderr or "")
    if check and ret.returncode != 0:
        if ret.stderr:
            sys.stderr.write(ret.stderr)
        die(f"git {' '.join(args)} failed (exit {ret.returncode})")
    return ret


def atomic_write(path: Path, content: str) -> None:
    """Atomically writes content to path using a PID-tagged temp file and os.replace."""
    tmp = path.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(content, encoding="utf-8")
    os.replace(tmp, path)


def is_project_dir(p: Path) -> bool:
    if not p.is_dir() or p.name.startswith("."):
        return False
    return (p / "README.md").is_file() or (p / "PROJECT.md").is_file()


def get_proj_dir(project_name: str, root: Path) -> Path:
    if (
        "/" in project_name
        or "\\" in project_name
        or ".." in project_name
        or not project_name
        or project_name.startswith(".")
    ):
        die(
            f"invalid project name (must be a top-level directory and cannot start with a dot): {project_name}"
        )
    p = root / project_name
    if p.is_file():
        die(
            f"invalid project name (a file with this name already exists): {project_name}"
        )
    if not p.is_dir():
        die(f"unknown project: {project_name}")
    return p


def parse_frontmatter(content: str) -> tuple[dict[str, Any], str]:
    """Tolerant frontmatter parser using ruamel.yaml. Returns (dict_of_fields, body_without_fm)."""
    match = re.search(r"^---\n(.*?)\n---(?:\n|$)", content, re.DOTALL)
    if not match:
        return {}, content

    frontmatter_str = match.group(1)
    body = content[match.end() :]

    yaml = YAML()
    try:
        data = yaml.load(frontmatter_str)
        if not isinstance(data, dict):
            data = {}
    except Exception:
        data = {}

    return {str(k).lower(): v for k, v in data.items()}, body


def parse_frontmatter_for_edit(content: str) -> tuple[Any, str]:
    """Loads frontmatter preserving raw ruamel.yaml CommentedMap and body."""
    match = re.search(r"^---\n(.*?)\n---(?:\n|$)", content, re.DOTALL)
    if not match:
        yaml = YAML()
        return yaml.load("{}"), content

    frontmatter_str = match.group(1)
    body = content[match.end() :]

    yaml = YAML()
    try:
        data = yaml.load(frontmatter_str)
        if not isinstance(data, dict):
            die("frontmatter must be a YAML mapping")
    except Exception as e:
        die(f"cannot parse YAML frontmatter: {e}")

    return data, body


def extract_frontmatter_field(content: str, key: str) -> str:
    fm, _ = parse_frontmatter(content)
    val = fm.get(key.lower(), "")
    if not val:
        m = re.search(
            rf"^{re.escape(key)}:\s*(.+)$", content, re.MULTILINE | re.IGNORECASE
        )
        if m:
            val = m.group(1).strip().strip("'\"")
    if isinstance(val, (list, dict)):
        return json.dumps(val)
    return str(val)


def extract_title(content: str) -> str:
    """Extracts H1 title from task body (ATX-style '# Title' headings only; Setext not supported)."""
    _, body = parse_frontmatter(content)
    body_no_code = re.sub(r"```.*?```", "", body, flags=re.DOTALL)
    for line in body_no_code.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return ""


def slugify(title: str) -> str:
    s = title.lower()
    s = re.sub(r"[^a-z0-9]+", "-", s)
    s = s.strip("-")
    s = re.sub(r"-+", "-", s)
    return s[:48]


def normalize_status(raw_status: str) -> str:
    clean = raw_status.strip().lower().replace(" ", "-")
    return STATE_ALIASES.get(clean, clean if clean in STANDARD_STATES else "todo")


def get_task_files(root: Path, project_name: str | None = None) -> list[Path]:
    files: list[Path] = []
    if project_name:
        proj_dir = get_proj_dir(project_name, root)
        tasks_dir = proj_dir / "tasks"
        if tasks_dir.is_dir():
            for f in sorted(tasks_dir.glob("*.md")):
                if f.is_file():
                    files.append(f)
    else:
        for p in sorted(root.iterdir()):
            if is_project_dir(p):
                tasks_dir = p / "tasks"
                if tasks_dir.is_dir():
                    for f in sorted(tasks_dir.glob("*.md")):
                        if f.is_file():
                            files.append(f)
    return sorted(files)


@dataclass(slots=True, frozen=True)
class TaskRow:
    project: str
    task_id: str
    status: str
    title: str
    rel_path: str
    abs_path: Path


def get_task_rows(root: Path, project_name: str | None = None) -> list[TaskRow]:
    files = get_task_files(root, project_name)
    rows: list[TaskRow] = []
    for f in files:
        try:
            content = f.read_text(encoding="utf-8")
        except OSError:
            continue
        task_id = extract_frontmatter_field(content, "id")
        status = extract_frontmatter_field(content, "status")
        title = extract_title(content)
        rel_path = str(f.relative_to(root))
        project = Path(rel_path).as_posix().split("/")[0]
        rows.append(TaskRow(project, task_id, status, title, rel_path, f.resolve()))
    return rows


def generate_task_id(root: Path) -> str:
    existing_ids = {r.task_id for r in get_task_rows(root) if r.task_id}
    for i in range(1, 257):
        entropy = f"{time.time_ns()}:{os.getpid()}:{os.urandom(8).hex()}:{i}"
        h = hashlib.sha1(entropy.encode("utf-8")).hexdigest()[:5].upper()
        candidate = f"TASK-{h}"
        if candidate not in existing_ids:
            return candidate
    die("could not allocate unique task ID")


def build_status_block(root: Path, project_name: str) -> str:
    rows = get_task_rows(root, project_name)
    in_progress = [r for r in rows if r.status == "in-progress"]
    blocked = [r for r in rows if r.status == "blocked"]
    todo_count = sum(1 for r in rows if r.status == "todo")
    done_count = sum(1 for r in rows if r.status == "done")
    unclassified_count = sum(
        1 for r in rows if not r.status or r.status not in STANDARD_STATES
    )

    lines: list[str] = [
        BEGIN,
        "",
        "## Task snapshot",
        "",
        "### In progress",
        "",
    ]
    if in_progress:
        for r in in_progress:
            lines.append(f"- `{r.task_id}` — {r.title}")
    else:
        lines.append("- None")

    lines.extend(
        [
            "",
            "### Blocked",
            "",
        ]
    )
    if blocked:
        for r in blocked:
            lines.append(f"- `{r.task_id}` — {r.title}")
    else:
        lines.append("- None")

    counts = f"\nTodo: {todo_count} Done: {done_count}"
    if unclassified_count > 0:
        counts += f" Unclassified: {unclassified_count}"
    lines.append(counts)
    lines.append("")
    lines.append(END)
    return "\n".join(lines)


def has_commit_auth(root: Path) -> bool:
    """Check if the repository grants local commit authority in both HEAD and working tree."""
    has_head = run_git(["rev-parse", "HEAD"], check=False).returncode == 0
    if has_head:
        show_agents = run_git(["show", "HEAD:AGENTS.md"], check=False)
        if show_agents.returncode != 0 or COMMIT_AUTH not in show_agents.stdout:
            return False
    agents_path = root / "AGENTS.md"
    return agents_path.is_file() and COMMIT_AUTH in agents_path.read_text(
        encoding="utf-8"
    )


def render_status_file(root: Path, project_name: str) -> str:
    proj_dir = root / project_name
    status_file = proj_dir / "STATUS.md"
    new_block = build_status_block(root, project_name)

    if not status_file.is_file():
        return f"# Status\n\n## Summary\n\n{new_block}\n\n## Next\n"

    content = status_file.read_text(encoding="utf-8")
    if BEGIN in content and END in content:
        pattern = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END), re.DOTALL)
        return pattern.sub(lambda _: new_block, content)
    return content.rstrip() + f"\n\n{new_block}\n"


def sync_status(root: Path, project_name: str) -> bool:
    """Returns True if file was updated/created, False if already identical."""
    proj_dir = root / project_name
    status_file = proj_dir / "STATUS.md"
    rendered = render_status_file(root, project_name)
    try:
        rendered = format_markdown(rendered)
    except Exception:
        pass
    if status_file.is_file():
        current = status_file.read_text(encoding="utf-8")
        if current == rendered:
            return False
    atomic_write(status_file, rendered)
    return True


def resolve_target(root: Path, query: str, allow_deleted: bool = False) -> Path:
    # Direct file path
    p = Path(query)
    target = None
    if p.is_file():
        target = p.resolve()
    elif (root / query).is_file():
        target = (root / query).resolve()

    if target is not None:
        try:
            target.relative_to(root.resolve())
            return target
        except ValueError:
            die(f"path is outside control repository: {query}")

    if not ID_PATTERN.match(query):
        die(f"cannot resolve: {query}")

    hits: list[Path] = []
    for row in get_task_rows(root):
        if row.task_id == query:
            hits.append(row.abs_path)

    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"ambiguous id: {query}")

    # Fallback to searching Git history for archived/deleted tasks
    if allow_deleted:
        res = run_git(
            ["log", "--all", "--name-only", "--format=", "--", f"*{query}*"],
            check=False,
        )
        if res.returncode == 0:
            seen_paths: set[str] = set()
            for line in res.stdout.splitlines():
                line = line.strip()
                if line.endswith(".md") and query in line:
                    seen_paths.add(line)
            if len(seen_paths) == 1:
                return (root / next(iter(seen_paths))).resolve()
            if len(seen_paths) > 1:
                die(f"ambiguous id in history: {query}")

    die(f"cannot resolve: {query}")


# ===========================================================================
# Audit & Reconciliation Engine (Shared by doctor and fix)
# ===========================================================================


@dataclass(slots=True, frozen=True)
class Finding:
    category: str
    severity: Literal["PASS", "INFO", "WARN", "FAIL"]
    message: str
    file_path: Path | None = None
    remediation: Callable[[], list[Path] | None] | None = (
        None  # None if requires human review
    )


def audit_workspace(root: Path, target_project: str | None = None) -> list[Finding]:
    """Single shared diagnostic engine for doctor and fix."""
    findings: list[Finding] = []

    # 1. Shallow clone check
    try:
        shallow = run_git(["rev-parse", "--is-shallow-repository"]).stdout.strip()
        if shallow == "true":
            findings.append(
                Finding(
                    category="git",
                    severity="WARN",
                    message="shallow clone: history may be incomplete",
                )
            )
    except Exception:
        pass

    # 2. AGENTS.md check & remediation
    agents_file = root / "AGENTS.md"
    if not agents_file.is_file():

        def remediate_missing_agents() -> list[Path]:
            # Tracking repos include commit authorization by default so agents can maintain tracker state.
            atomic_write(
                agents_file,
                f"# Agent instructions\n\nThis repository follows taskgo: <{CANONICAL_URL}>.\n\n{COMMIT_AUTH}\n",
            )
            return [agents_file]

        findings.append(
            Finding(
                category="root",
                severity="WARN",
                message="missing AGENTS.md",
                file_path=agents_file,
                remediation=remediate_missing_agents,
            )
        )
    else:
        agents_txt = agents_file.read_text(encoding="utf-8")
        needs_decl = not re.search(
            r"(follows|structured|maintained|according to).*taskgo",
            agents_txt,
            re.IGNORECASE,
        )
        needs_url = CANONICAL_URL not in agents_txt
        needs_auth = COMMIT_AUTH not in agents_txt

        if needs_decl or needs_url or needs_auth:

            def remediate_agents() -> list[Path]:
                cur = agents_file.read_text(encoding="utf-8")
                has_decl = bool(
                    re.search(
                        r"(follows|structured|maintained|according to).*taskgo",
                        cur,
                        re.IGNORECASE,
                    )
                )
                if not has_decl:
                    cur = (
                        f"This repository follows taskgo: <{CANONICAL_URL}>.\n\n" + cur
                    )
                elif CANONICAL_URL not in cur:
                    cur += f"\nCanonical URL: <{CANONICAL_URL}>\n"
                if COMMIT_AUTH not in cur:
                    cur = cur.rstrip() + f"\n\n{COMMIT_AUTH}\n"
                atomic_write(agents_file, cur)
                return [agents_file]

            if needs_decl:
                findings.append(
                    Finding(
                        category="root",
                        severity="WARN",
                        message="AGENTS.md: must state that the repository follows taskgo",
                        file_path=agents_file,
                        remediation=remediate_agents,
                    )
                )
            if needs_url:
                findings.append(
                    Finding(
                        category="root",
                        severity="WARN",
                        message=f"AGENTS.md: missing canonical taskgo URL: {CANONICAL_URL}",
                        file_path=agents_file,
                        remediation=remediate_agents,
                    )
                )
            if needs_auth:
                findings.append(
                    Finding(
                        category="root",
                        severity="INFO",
                        message=f"AGENTS.md: missing {COMMIT_AUTH}",
                        file_path=agents_file,
                        remediation=remediate_agents,
                    )
                )

    # 3. INBOX.md check & remediation
    inbox_file = root / "INBOX.md"
    if not inbox_file.is_file():

        def remediate_missing_inbox() -> list[Path]:
            atomic_write(inbox_file, "# Inbox\n")
            return [inbox_file]

        findings.append(
            Finding(
                category="root",
                severity="WARN",
                message="missing INBOX.md",
                file_path=inbox_file,
                remediation=remediate_missing_inbox,
            )
        )

    # 4. Duplicate global task IDs
    all_rows = get_task_rows(root)
    seen_ids: dict[str, int] = {}
    for r in all_rows:
        if r.task_id:
            seen_ids[r.task_id] = seen_ids.get(r.task_id, 0) + 1
    dups = [k for k, v in seen_ids.items() if v > 1]
    if dups:
        findings.append(
            Finding(
                category="tasks",
                severity="WARN",
                message=f"duplicate global task ID(s): {' '.join(sorted(dups))}",
                remediation=None,  # Ambiguous duplicate resolution requires human review
            )
        )

    # 5. Project-level checks
    projects: list[Path] = []
    if target_project:
        projects.append(get_proj_dir(target_project, root))
    else:
        for p in sorted(root.iterdir()):
            if is_project_dir(p):
                projects.append(p)

    for p in projects:
        name = p.name
        tasks_dir = p / "tasks"
        status_file = p / "STATUS.md"

        # Check STATUS.md
        if not status_file.is_file():

            def make_remediate_status(p_name=name, p_status=status_file):
                def remediate() -> list[Path]:
                    sync_status(root, p_name)
                    return [p_status]

                return remediate

            findings.append(
                Finding(
                    category="project",
                    severity="WARN",
                    message=f"{name}: missing STATUS.md",
                    file_path=status_file,
                    remediation=make_remediate_status(name, status_file),
                )
            )

        # Check tasks
        if tasks_dir.is_dir():
            for tf in sorted(tasks_dir.glob("*.md")):
                if not tf.is_file():
                    continue
                content = tf.read_text(encoding="utf-8")
                fm, _ = parse_frontmatter(content)
                rel_path = str(tf.relative_to(root))

                task_id = fm.get("id", "")
                raw_status = fm.get("status", "")

                m = re.search(r"TASK-[0-9A-F]{5}", tf.name)
                filename_id = m.group(0) if m else ""

                needs_id_fix = not ID_PATTERN.match(task_id)
                needs_status_fix = (
                    bool(raw_status and raw_status not in STANDARD_STATES)
                    or not raw_status
                )
                needs_filename_fix = (
                    bool(filename_id and filename_id != task_id) or not filename_id
                )

                if needs_id_fix or needs_status_fix or needs_filename_fix:

                    def make_remediate_task(
                        target_tf=tf, p_root=root, p_tasks=tasks_dir
                    ):
                        def remediate() -> list[Path]:
                            t_content = target_tf.read_text(encoding="utf-8")
                            t_fm, t_body = parse_frontmatter_for_edit(t_content)
                            t_id = ""
                            id_key = None
                            for k in list(t_fm.keys()):
                                if str(k).lower() == "id":
                                    t_id = str(t_fm[k])
                                    id_key = k
                                    break
                            if not ID_PATTERN.match(t_id):
                                t_id = generate_task_id(p_root)

                            raw_status = "todo"
                            status_key = None
                            for k in list(t_fm.keys()):
                                if str(k).lower() == "status":
                                    raw_status = str(t_fm[k])
                                    status_key = k
                                    break
                            t_status = normalize_status(raw_status)
                            t_title = extract_title(t_content) or target_tf.stem
                            if not t_body.strip():
                                t_body = f"\n# {t_title}\n\n## Outcome\n\n## Findings\n\n## Next\n"

                            t_fm[id_key or "id"] = t_id
                            t_fm[status_key or "status"] = t_status

                            yaml = YAML()
                            yaml.width = WRAP_WIDTH
                            yaml.preserve_quotes = True
                            yaml.default_flow_style = False
                            buf = io.StringIO()
                            yaml.dump(t_fm, buf)
                            new_content = (
                                f"---\n{buf.getvalue()}---\n\n{t_body.lstrip()}\n"
                            )
                            try:
                                new_content = format_markdown(new_content)
                            except Exception:
                                pass
                            atomic_write(target_tf, new_content)
                            slug = slugify(t_title) or "task"
                            new_name = f"{t_id}-{slug}.md"
                            new_path = p_tasks / new_name
                            if target_tf.name != new_name:
                                target_tf.rename(new_path)
                                return [target_tf, new_path]
                            return [target_tf]

                        return remediate

                    if needs_id_fix:
                        findings.append(
                            Finding(
                                category="task",
                                severity="WARN",
                                message=f"{rel_path}: invalid/missing id '{task_id}'",
                                file_path=tf,
                                remediation=make_remediate_task(tf, root, tasks_dir),
                            )
                        )
                    if needs_status_fix and not needs_id_fix:
                        findings.append(
                            Finding(
                                category="task",
                                severity="WARN",
                                message=f"{rel_path}: non-standard status '{raw_status}'",
                                file_path=tf,
                                remediation=make_remediate_task(tf, root, tasks_dir),
                            )
                        )
                    if needs_filename_fix and not needs_id_fix:
                        findings.append(
                            Finding(
                                category="task",
                                severity="WARN",
                                message=f"{rel_path}: filename/frontmatter IDs disagree",
                                file_path=tf,
                                remediation=make_remediate_task(tf, root, tasks_dir),
                            )
                        )

        # Check STATUS.md snapshot drift
        if status_file.is_file():
            current_status = status_file.read_text(encoding="utf-8")
            rendered = render_status_file(root, name)
            try:
                rendered = format_markdown(rendered)
            except Exception:
                pass
            if current_status != rendered:

                def make_remediate_snapshot(p_name=name, p_status=status_file):
                    def remediate() -> list[Path]:
                        sync_status(root, p_name)
                        return [p_status]

                    return remediate

                findings.append(
                    Finding(
                        category="status",
                        severity="WARN",
                        message=f"{name}: stale STATUS task snapshot (run sync)",
                        file_path=status_file,
                        remediation=make_remediate_snapshot(name, status_file),
                    )
                )

            rows = get_task_rows(root, name)
            active = sum(1 for r in rows if r.status == "in-progress")
            prose = re.sub(
                re.escape(BEGIN) + r".*?" + re.escape(END),
                "",
                current_status,
                flags=re.DOTALL,
            )
            if active > 0 and re.search(
                r"(no\s+tasks?|nothing)(\s+(is|are))?(\s+currently)?\s+in[ -]progress",
                prose,
                re.IGNORECASE,
            ):
                findings.append(
                    Finding(
                        category="status",
                        severity="WARN",
                        message=f"{name}: STATUS prose says no task is in progress, but {active} task(s) are in-progress",
                        file_path=status_file,
                        remediation=None,  # Human semantic editing required
                    )
                )

        # Check decisions ADRs
        decisions_dir = p / "decisions"
        if decisions_dir.is_dir():
            for df in sorted(decisions_dir.glob("*.md")):
                if df.is_file():
                    dcontent = df.read_text(encoding="utf-8")
                    for sec in [
                        "Status",
                        "Context",
                        "Decision",
                        "Consequences",
                    ]:
                        if not re.search(
                            rf"^##\s+{sec}\s*$", dcontent, re.MULTILINE | re.IGNORECASE
                        ):
                            findings.append(
                                Finding(
                                    category="adr",
                                    severity="WARN",
                                    message=f"{name}/{df.name}: ADR missing ## {sec}",
                                    file_path=df,
                                    remediation=None,  # Manual ADR structure repair
                                )
                            )

        # Check Markdown formatting for all markdown files in project
        for mf in sorted(p.rglob("*.md")):
            if (
                not mf.is_file()
                or any(part.startswith(".") for part in mf.parts)
                or "node_modules" in mf.parts
            ):
                continue
            try:
                mcontent = mf.read_text(encoding="utf-8")
                mformatted = format_markdown(mcontent)
                if mformatted != mcontent:
                    rel_path = str(mf.relative_to(root))

                    def make_remediate_proj_md(target_file=mf):
                        def remediate() -> list[Path]:
                            if not target_file.is_file():
                                return []
                            current = target_file.read_text(encoding="utf-8")
                            formatted = format_markdown(current)
                            if current != formatted:
                                atomic_write(target_file, formatted)
                                return [target_file]
                            return []

                        return remediate

                    findings.append(
                        Finding(
                            category="markdown",
                            severity="INFO",
                            message=f"{rel_path}: markdown formatting needed",
                            file_path=mf,
                            remediation=make_remediate_proj_md(mf),
                        )
                    )
            except Exception as e:
                rel_path = str(mf.relative_to(root))
                findings.append(
                    Finding(
                        category="markdown",
                        severity="WARN",
                        message=f"{rel_path}: failed to format markdown: {e}",
                        file_path=mf,
                        remediation=None,
                    )
                )

    if not target_project:
        for rmf in sorted(root.glob("*.md")):
            if not rmf.is_file() or rmf.name.startswith("."):
                continue
            try:
                rcontent = rmf.read_text(encoding="utf-8")
                rformatted = format_markdown(rcontent)
                if rformatted != rcontent:
                    rel_path = rmf.name

                    def make_remediate_root_md(target_file=rmf):
                        def remediate() -> list[Path]:
                            if not target_file.is_file():
                                return []
                            current = target_file.read_text(encoding="utf-8")
                            formatted = format_markdown(current)
                            if current != formatted:
                                atomic_write(target_file, formatted)
                                return [target_file]
                            return []

                        return remediate

                    findings.append(
                        Finding(
                            category="markdown",
                            severity="INFO",
                            message=f"{rel_path}: markdown formatting needed",
                            file_path=rmf,
                            remediation=make_remediate_root_md(rmf),
                        )
                    )
            except Exception as e:
                rel_path = rmf.name
                findings.append(
                    Finding(
                        category="markdown",
                        severity="WARN",
                        message=f"{rel_path}: failed to format markdown: {e}",
                        file_path=rmf,
                        remediation=None,
                    )
                )

    return findings


def cmd_id() -> None:
    """Allocate a unique task ID."""
    root = get_repo_root()
    print(generate_task_id(root))


def cmd_root() -> None:
    """Print the resolved control repository root."""
    print(get_repo_root())


def render_task_file(
    task_id: str,
    title: str,
    status: str,
    problem: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
) -> str:
    """Render and format a task Markdown document."""
    body_blocks = []
    if problem:
        body_blocks.append(f"**Problem:** {problem}")
    if goal:
        body_blocks.append(f"**Goal:** {goal}")
    if criteria:
        body_blocks.append(f"**Criteria:** {criteria}")
    if sketch:
        body_blocks.append(
            f"**Sketch:**\n\n{sketch}"
            if ("\n" in sketch or sketch.strip().startswith("1."))
            else f"**Sketch:** {sketch}"
        )
    if constraints:
        body_blocks.append(f"**Constraints:** {constraints}")

    if status == "done":
        if outcome:
            body_blocks.append(f"## Outcome\n\n{outcome}")
        else:
            body_blocks.append("## Outcome")

        if findings:
            body_blocks.append(f"## Findings\n\n{findings}")
        else:
            body_blocks.append("## Findings")

        if next_steps:
            body_blocks.append(f"## Next\n\n{next_steps}")
        else:
            body_blocks.append("## Next")
    else:
        if outcome:
            body_blocks.append(f"## Outcome\n\n{outcome}")
        if findings:
            body_blocks.append(f"## Findings\n\n{findings}")
        if next_steps:
            body_blocks.append(f"## Next\n\n{next_steps}")

        if not body_blocks:
            body_blocks.append("**Goal:**\n\n**Criteria:**")

    body = "\n\n".join(body_blocks)

    fm_lines = [f"id: {task_id}", f"status: {status}"]
    if conv:
        fm_lines.append("conversations:")
        fm_lines.append(f"  - conversation://{conv}")
    fm_block = "\n".join(fm_lines)

    raw = f"""---
{fm_block}
---

# {title}

{body}
"""
    try:
        return format_markdown(raw)
    except Exception:
        return raw


def cmd_create(
    project_name: str,
    title: str,
    status: str = "todo",
    problem: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
    no_commit: bool = False,
    dry_run: bool = False,
) -> None:
    """Create a new task in PROJECT."""
    if (
        "/" in project_name
        or "\\" in project_name
        or ".." in project_name
        or not project_name
        or project_name.startswith(".")
    ):
        die(
            f"invalid project name (must be a top-level directory and cannot start with a dot): {project_name}"
        )

    status = normalize_status(status)
    conv_id = get_active_conversation_id(conv)
    root = get_repo_root()
    proj_dir = root / project_name
    if proj_dir.is_file():
        die(
            f"cannot create project '{project_name}': a file with this name already exists"
        )

    task_id = generate_task_id(root)
    slug = slugify(title) or "task"
    filename = f"{task_id}-{slug}.md"
    rel_task_path = f"{project_name}/tasks/{filename}"
    is_new_project = not is_project_dir(proj_dir)

    if dry_run:
        print(
            "[INFO]  Dry run: would create task record and sync STATUS.md:",
            file=sys.stderr,
        )
        if is_new_project:
            print(
                f"[INFO]    - Scaffolding: {project_name}/README.md, {project_name}/STATUS.md",
                file=sys.stderr,
            )
        print(
            f"[INFO]    - Task file:   {rel_task_path} (status: {status})",
            file=sys.stderr,
        )
        prefix = f"{project_name}: create {task_id}"
        remaining = 50 - len(prefix) - 3
        if remaining > 5 and len(title) > remaining:
            short_title = title[: remaining - 3].rstrip() + "..."
            subject = f"{prefix} ({short_title})"
        elif remaining > 5:
            subject = f"{prefix} ({title})"
        else:
            subject = prefix
        print(f"[INFO]    - Commit:      {subject}", file=sys.stderr)
        print(f"{task_id}\t{rel_task_path}")
        return

    # Auto-initialize project scaffolding if it's a new project
    is_new_project = not is_project_dir(proj_dir)
    if is_new_project:
        proj_dir.mkdir(parents=True, exist_ok=True)
        readme = proj_dir / "README.md"
        if not readme.is_file():
            atomic_write(
                readme,
                f"# {project_name}\n\nProject overview.\n",
            )
        status_file = proj_dir / "STATUS.md"
        if not status_file.is_file():
            atomic_write(
                status_file,
                f"# Status\n\n## Summary\n\nInitial setup for {project_name}.\n\n<!-- taskgo:begin -->\n<!-- taskgo:end -->\n\n## Next\n",
            )

    tasks_dir = proj_dir / "tasks"
    tasks_dir.mkdir(parents=True, exist_ok=True)
    task_file = tasks_dir / filename

    content = render_task_file(
        task_id=task_id,
        title=title,
        status=status,
        problem=problem,
        goal=goal,
        criteria=criteria,
        sketch=sketch,
        constraints=constraints,
        outcome=outcome,
        findings=findings,
        next_steps=next_steps,
        conv=conv_id,
    )
    atomic_write(task_file, content)

    # Sync project STATUS.md
    sync_status(root, project_name)

    # Machine-readable output contract on stdout
    print(f"{task_id}\t{rel_task_path}")

    if no_commit:
        return

    if not has_commit_auth(root):
        print(
            "[INFO]  Skipping commit: repository lacks authorized <!-- taskgo:allow-local-commits -->",
            file=sys.stderr,
        )
        return

    # Stage task file, STATUS.md, and optionally new scaffolding files
    to_stage = [rel_task_path, f"{project_name}/STATUS.md"]
    if is_new_project:
        rel_readme = f"{project_name}/README.md"
        if (root / rel_readme).is_file():
            to_stage.append(rel_readme)

    run_git(["add", "--", *to_stage])

    # Craft commit subject <= 50 chars
    prefix = f"{project_name}: create {task_id}"
    remaining = 50 - len(prefix) - 3  # for " ()"
    if remaining > 5 and len(title) > remaining:
        short_title = title[: remaining - 3].rstrip() + "..."
        subject = f"{prefix} ({short_title})"
    elif remaining > 5:
        subject = f"{prefix} ({title})"
    else:
        subject = prefix

    msg_lines = [subject]
    if subject != f"{prefix} ({title})":
        msg_lines.extend(["", title])
    if conv_id:
        msg_lines.extend(["", f"Conversation: conversation://{conv_id}"])
    commit_msg = "\n".join(msg_lines) + "\n"

    run_git(["commit", "--no-verify", "--no-gpg-sign", "-m", commit_msg])
    commit_sha = run_git(["rev-parse", "HEAD"]).stdout.strip()
    print(f"[INFO]  Committed new task: {commit_sha[:10]}", file=sys.stderr)


def cmd_update(
    query: str,
    status: str | None = None,
    title: str | None = None,
    problem: str | None = None,
    goal: str | None = None,
    criteria: str | None = None,
    sketch: str | None = None,
    constraints: str | None = None,
    outcome: str | None = None,
    findings: str | None = None,
    next_steps: str | None = None,
    conv: str | None = None,
) -> None:
    """Update task fields, status, or headings."""
    root = get_repo_root()
    target_path = resolve_target(root, query)
    rel_path = str(target_path.relative_to(root))
    project_name = Path(rel_path).as_posix().split("/")[0]

    try:
        content = target_path.read_text(encoding="utf-8")
    except OSError as e:
        die(f"cannot read task file {rel_path}: {e}")
    data, body = parse_frontmatter_for_edit(content)

    if status:
        norm_status = normalize_status(status)
        status_key = next((k for k in data if str(k).lower() == "status"), "status")
        data[status_key] = norm_status

    conv_id = normalize_conversation_id(conv) if conv else None
    if conv_id:
        conv_uri = f"conversation://{conv_id}"
        conversations_key = next(
            (k for k in data if str(k).lower() == "conversations"), None
        )
        conversation_key = next(
            (k for k in data if str(k).lower() == "conversation"), None
        )
        if conversations_key:
            existing = data[conversations_key]
            if isinstance(existing, list):
                if conv_uri not in existing:
                    existing.append(conv_uri)
            elif isinstance(existing, str):
                if existing != conv_uri:
                    data[conversations_key] = [existing, conv_uri]
                else:
                    data[conversations_key] = [conv_uri]
            else:
                data[conversations_key] = [conv_uri]
        elif conversation_key:
            old_c = data.pop(conversation_key)
            if old_c != conv_uri:
                data["conversations"] = [old_c, conv_uri]
            else:
                data["conversations"] = [conv_uri]
        else:
            data["conversations"] = [conv_uri]

    yaml = YAML()
    yaml.width = WRAP_WIDTH
    yaml.preserve_quotes = True
    yaml.default_flow_style = False
    buf = io.StringIO()
    yaml.dump(data, buf)
    fm_text = f"---\n{buf.getvalue()}---\n"

    if title:
        body = re.sub(r"^#\s+[^\n]+", f"# {title}", body, count=1, flags=re.MULTILINE)

    def upsert_runin(body_str: str, label: str, val: str) -> str:
        pattern = re.compile(
            rf"\*\*{re.escape(label)}:\*\*.*?(?=(\n\n\*\*|\n\n#|\Z))",
            re.DOTALL,
        )
        replacement = (
            f"**{label}:**\n\n{val}"
            if ("\n" in val or val.strip().startswith("1."))
            else f"**{label}:** {val}"
        )
        if pattern.search(body_str):
            return pattern.sub(lambda _: replacement, body_str, count=1)
        return body_str.rstrip() + f"\n\n{replacement}\n"

    def upsert_section(body_str: str, heading: str, val: str) -> str:
        pattern = re.compile(
            rf"^##\s+{re.escape(heading)}\b.*?(?=(\n#\s+|\n##\s+|\Z))",
            re.DOTALL | re.MULTILINE,
        )
        replacement = f"## {heading}\n\n{val}"
        if pattern.search(body_str):
            return pattern.sub(lambda _: replacement, body_str, count=1)
        return body_str.rstrip() + f"\n\n{replacement}\n"

    if problem:
        body = upsert_runin(body, "Problem", problem)
    if goal:
        body = upsert_runin(body, "Goal", goal)
    if criteria:
        body = upsert_runin(body, "Criteria", criteria)
    if sketch:
        body = upsert_runin(body, "Sketch", sketch)
    if constraints:
        body = upsert_runin(body, "Constraints", constraints)
    if outcome:
        body = upsert_section(body, "Outcome", outcome)
    if findings:
        body = upsert_section(body, "Findings", findings)
    if next_steps:
        body = upsert_section(body, "Next", next_steps)

    new_content = fm_text + "\n" + body.lstrip()
    try:
        new_content = format_markdown(new_content)
    except Exception:
        pass
    atomic_write(target_path, new_content)

    sync_status(root, project_name)
    task_id_val = next(
        (str(v) for k, v in data.items() if str(k).lower() == "id"), query
    )
    print(f"[INFO]  Updated {task_id_val} in {rel_path}", file=sys.stderr)


def cmd_list(
    project: str | None = None,
    state: str | None = None,
    as_json: bool = False,
) -> None:
    """List tasks in the repository or a specific project."""
    root = get_repo_root()
    rows = get_task_rows(root, project)
    if state:
        norm_state = normalize_status(state)
        rows = [r for r in rows if r.status == norm_state]

    if as_json:
        out = [
            {
                "project": r.project,
                "id": r.task_id,
                "status": r.status,
                "title": r.title,
                "path": str(r.abs_path.relative_to(root)),
            }
            for r in rows
        ]
        print(json.dumps(out, indent=2))
        return

    if not rows:
        return

    print("PROJECT\tTASK\tSTATE\tTITLE\tPATH")
    for r in rows:
        rel = str(r.abs_path.relative_to(root))
        print(f"{r.project}\t{r.task_id}\t{r.status or '(missing)'}\t{r.title}\t{rel}")


def cmd_status(
    project: str | None = None,
    as_json: bool = False,
) -> None:
    """Show project status or whole-workspace summary."""
    root = get_repo_root()
    if project:
        proj_dir = get_proj_dir(project, root)
        if as_json:
            rows = get_task_rows(root, project)
            out = {
                "project": project,
                "in_progress": [r.task_id for r in rows if r.status == "in-progress"],
                "blocked": [r.task_id for r in rows if r.status == "blocked"],
                "todo_count": sum(1 for r in rows if r.status == "todo"),
                "done_count": sum(1 for r in rows if r.status == "done"),
                "tasks": [
                    {
                        "id": r.task_id,
                        "status": r.status,
                        "title": r.title,
                        "path": str(r.abs_path.relative_to(root)),
                    }
                    for r in rows
                ],
            }
            print(json.dumps(out, indent=2))
            return
        status_file = proj_dir / "STATUS.md"
        if status_file.is_file():
            print(status_file.read_text(encoding="utf-8").rstrip())
        else:
            print(render_status_file(root, project).rstrip())
        return

    # All projects
    projects = list_projects(root)
    if as_json:
        all_data = []
        for p in projects:
            rows = get_task_rows(root, p)
            all_data.append(
                {
                    "project": p,
                    "in_progress": [
                        r.task_id for r in rows if r.status == "in-progress"
                    ],
                    "blocked": [r.task_id for r in rows if r.status == "blocked"],
                    "todo_count": sum(1 for r in rows if r.status == "todo"),
                    "done_count": sum(1 for r in rows if r.status == "done"),
                }
            )
        print(json.dumps(all_data, indent=2))
        return

    for p in projects:
        rows = get_task_rows(root, p)
        in_prog = [r.task_id for r in rows if r.status == "in-progress"]
        blocked = [r.task_id for r in rows if r.status == "blocked"]
        todo = sum(1 for r in rows if r.status == "todo")
        done = sum(1 for r in rows if r.status == "done")
        prog_str = ", ".join(in_prog) if in_prog else "none"
        blk_str = ", ".join(blocked) if blocked else "none"
        print(
            f"{p}: in-progress=[{prog_str}] blocked=[{blk_str}] todo={todo} done={done}"
        )


def list_projects(root: Path) -> list[str]:
    return [p.name for p in sorted(root.iterdir()) if is_project_dir(p)]


def cmd_sync(
    project: str | None = None,
) -> None:
    """Update STATUS.md snapshot for a project or the workspace."""
    root = get_repo_root()
    if project:
        get_proj_dir(project, root)
        updated = sync_status(root, project)
        if updated:
            print("updated")
        else:
            print("current")
        return

    projects = list_projects(root)
    any_updated = False
    for p in projects:
        if sync_status(root, p):
            any_updated = True
    if any_updated:
        print("updated")
    else:
        print("current")


def cmd_doctor(
    project: str | None = None,
) -> None:
    """Run mechanical health checks across the workspace or a project."""
    root = get_repo_root()
    _, source = resolve_root_candidate()

    print(f"{'[PASS]'.ljust(8)}Control repository")
    print(f"        Root: {root}")
    print(f"        Source: {source}")

    findings = audit_workspace(root, project)

    has_warn_or_fail = False
    for f in findings:
        prefix = f"[{f.severity}]".ljust(8)
        print(f"{prefix}{f.message}")
        if f.severity in ("WARN", "FAIL"):
            has_warn_or_fail = True

    print(
        """[INFO]  Agent semantic review
        Check STATUS Summary/Next for contradictions with tasks and recent work.
        Check active conversation ID ([<conversation-id>](conversation://<conversation-id>)) is recorded in STATUS.md Summary or task Outcome.
        Check PLAN is current direction, not accumulated history.
        Check ADR status/rationale and artifact references remain meaningful.
        Check private tracker material has not leaked to public/shared artifacts.
        After merges, check reconciled files express one coherent current state."""
    )

    if has_warn_or_fail:
        sys.exit(1)


def cmd_fix(
    project: str | None = None,
    dry_run: bool = False,
    no_commit: bool = False,
) -> None:
    """Auto-heal IDs, statuses, and snapshot drift."""
    root = get_repo_root()
    if project:
        get_proj_dir(project, root)

    findings = audit_workspace(root, project)
    fixable = [f for f in findings if f.remediation is not None]

    if not fixable:
        unfixable = [f for f in findings if f.severity in ("WARN", "FAIL")]
        if unfixable:
            for f in unfixable:
                print(
                    f"[{f.severity}]  Manual fix required: {f.message}",
                    file=sys.stderr,
                )
        else:
            print("[INFO]  Workspace is clean, no fixes needed.", file=sys.stderr)
        return

    if dry_run:
        print(
            f"[INFO]  Dry run: {len(fixable)} repair(s) would be applied:",
            file=sys.stderr,
        )
        dry_run_files: set[str] = set()
        for f in fixable:
            print(f"[INFO]    - {f.message}", file=sys.stderr)
            if f.file_path:
                try:
                    dry_run_files.add(
                        str(f.file_path.resolve().relative_to(root.resolve()))
                    )
                except ValueError:
                    pass
        if dry_run_files:
            print("\n".join(sorted(dry_run_files)))
        return

    # Invariant: assert clean Git index before mutating
    diff_cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if diff_cached.returncode != 0:
        die("fix: git index contains staged changes; unstage or commit them first")

    # Execute all remediations and collect explicitly touched paths (deduplicated)
    touched_paths: set[Path] = set()
    executed_remediations = set()
    for f in fixable:
        if f.remediation in executed_remediations:
            continue
        executed_remediations.add(f.remediation)
        res = f.remediation()
        if res:
            for p in res:
                touched_paths.add(p)
        elif f.file_path:
            touched_paths.add(f.file_path)

    # Re-run audit to verify convergence
    post_findings = audit_workspace(root, project)
    remaining_errors = [f for f in post_findings if f.severity in ("WARN", "FAIL")]
    if remaining_errors:
        for f in remaining_errors:
            print(f"[{f.severity}]  Still open after fix: {f.message}", file=sys.stderr)

    # Ensure all affected projects have their STATUS.md synchronized and included if modified
    affected_projects: set[str] = set()
    if project:
        affected_projects.add(project)
    for tp in touched_paths:
        try:
            rel = tp.resolve().relative_to(root.resolve())
            parts = rel.parts
            if len(parts) > 1 and is_project_dir(root / parts[0]):
                affected_projects.add(parts[0])
        except ValueError:
            pass

    for proj_name in affected_projects:
        sync_status(root, proj_name)
        status_p = root / proj_name / "STATUS.md"
        if status_p.is_file():
            touched_paths.add(status_p)

    # Convert touched paths to repo-relative files that have modifications or were created/deleted
    modified_files: list[str] = []
    for tp in sorted(touched_paths):
        try:
            rel = str(tp.resolve().relative_to(root.resolve()))
        except ValueError:
            continue
        st = run_git(["status", "--porcelain", "--", rel], check=False).stdout.strip()
        if st and rel not in modified_files:
            modified_files.append(rel)

    if not modified_files:
        print("[INFO]  Workspace is clean, no files changed.", file=sys.stderr)
        return

    if no_commit:
        print(
            f"[INFO]  Applied {len(modified_files)} repair(s) without commit (--no-commit).",
            file=sys.stderr,
        )
        print("\n".join(modified_files))
        return

    if not has_commit_auth(root):
        print(
            f"[INFO]  Applied {len(modified_files)} repair(s) (commit skipped: no auth marker).",
            file=sys.stderr,
        )
        print("\n".join(modified_files))
        return

    run_git(["add", "--", *modified_files])
    if project:
        commit_msg = f"chore({project}): fix metadata and status\n"
        if len(commit_msg.strip()) > 50:
            commit_msg = f"{project}: fix metadata and status\n"
    else:
        commit_msg = "chore: fix task metadata and status\n"
    run_git(["commit", "--no-verify", "--no-gpg-sign", "-m", commit_msg])
    commit_sha = run_git(["rev-parse", "HEAD"]).stdout.strip()

    print(
        f"[INFO]  Committed {len(modified_files)} fixed file(s): {commit_sha[:10]}",
        file=sys.stderr,
    )

    # Machine-readable output contract on stdout
    print(f"COMMIT_SHA: {commit_sha}")
    print(f"MODIFIED: {','.join(modified_files)}")
    print(f"SUMMARY: {commit_msg.strip()}")


def cmd_history(query: str, field: str = "status") -> None:
    """Show frontmatter field history across git revisions."""
    root = get_repo_root()
    target_path = resolve_target(root, query, allow_deleted=True)
    rel_path = str(target_path.relative_to(root))

    cmd = [
        "log",
        "--follow",
        "--name-only",
        "--format=COMMIT:%H\t%ad\t%s",
        "--date=short",
        "--",
        rel_path,
    ]
    res = run_git(cmd)
    if not res.stdout.strip():
        die(f"no git history for {rel_path}")

    entries: list[tuple[str, str, str, str]] = []
    cur_sha = ""
    cur_date = ""
    cur_subj = ""

    for line in res.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith("COMMIT:"):
            parts = line[len("COMMIT:") :].split("\t", 2)
            cur_sha = parts[0]
            cur_date = parts[1] if len(parts) > 1 else ""
            cur_subj = parts[2] if len(parts) > 2 else ""
        else:
            entries.append((cur_sha, cur_date, cur_subj, line))

    prev = "__x"
    for sha, d, s, p in reversed(entries):
        show_res = run_git(["show", f"{sha}:{p}"], check=False)
        if show_res.returncode != 0:
            continue
        v = extract_frontmatter_field(show_res.stdout, field)
        if v == prev:
            continue

        prev_label = "(none)" if prev == "__x" else prev
        v_label = v or "(missing)"
        print(f"{d}\t{prev_label} -> {v_label}\t{sha[:10]}\t{s}")
        prev = v


def cmd_checkpoint(
    task_id: str,
    subject: str,
    all_files: bool = False,
    paths: list[str] | None = None,
    body: str = "",
    refs: list[str] | None = None,
    conv: str | None = None,
) -> None:
    """Commit an authorized tracker checkpoint for TASK_ID."""
    paths_list = paths or []
    refs_list = refs or []
    conv_id = get_active_conversation_id(conv)

    root = get_repo_root()
    if not ID_PATTERN.match(task_id):
        die(f"checkpoint: invalid task ID: {task_id}")

    if not has_commit_auth(root):
        die(f"checkpoint: committed AGENTS.md must contain {COMMIT_AUTH}")

    # Index must be empty
    diff_cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if diff_cached.returncode != 0:
        die("checkpoint: index is not empty")

    target_path = resolve_target(root, task_id)
    rel_path = str(target_path.relative_to(root))
    project_name = Path(rel_path).as_posix().split("/")[0]
    get_proj_dir(project_name, root)
    status_rel = f"{project_name}/STATUS.md"

    requested = [rel_path, status_rel]
    for p_arg in paths_list:
        p_clean = p_arg.removeprefix("./")
        if p_clean.startswith("/") or ".." in p_clean.split("/"):
            die(f"checkpoint: unsafe path: {p_arg}")
        if not p_clean.startswith(f"{project_name}/"):
            die(f"checkpoint: path is outside project {project_name}: {p_arg}")
        is_existing_file = (root / p_clean).is_file()
        is_git_deleted = bool(
            run_git(["status", "--porcelain", "--", p_clean]).stdout.strip()
        )
        if not is_existing_file and not is_git_deleted:
            die(f"checkpoint: path not found: {p_arg}")
        requested.append(p_clean)

    # Synchronize status for project
    sync_status(root, project_name)

    # Find project changes
    diff_proj = [
        f
        for f in run_git(
            ["diff", "-z", "--name-only", "--", f"{project_name}/"]
        ).stdout.split("\0")
        if f
    ]
    untracked_proj = [
        f
        for f in run_git(
            [
                "ls-files",
                "-z",
                "--others",
                "--exclude-standard",
                "--",
                f"{project_name}/",
            ]
        ).stdout.split("\0")
        if f
    ]
    all_changed = sorted(set(diff_proj + untracked_proj))

    if all_files:
        requested = sorted(set(requested + [c for c in all_changed if c]))

    # Check that at least one project file has changes
    has_changes = any(
        bool(run_git(["status", "--porcelain", "--", req]).stdout.strip())
        for req in requested
    )
    if not has_changes:
        die("checkpoint: no project changes detected to commit")

    # Check for unlisted project changes
    unlisted = [c for c in all_changed if c and c not in requested]
    if unlisted:
        suggested = " ".join(f"--path {p}" for p in unlisted)
        print(
            f"[HINT] To include unlisted project file(s), add --all or: {suggested}",
            file=sys.stderr,
        )
        die(f"checkpoint: unlisted project change: {unlisted[0]}")

    # Run doctor in-process
    findings = audit_workspace(root, project_name)
    if any(f.severity in ("WARN", "FAIL") for f in findings):
        die("checkpoint: doctor found errors")

    # Stage requested files
    try:
        run_git(["add", "--", *requested])
        cached_check = run_git(["diff", "--cached", "--quiet"], check=False)
        if cached_check.returncode == 0:
            die("checkpoint: nothing to commit")

        staged_files = [
            f
            for f in run_git(["diff", "-z", "--cached", "--name-only"]).stdout.split(
                "\0"
            )
            if f
        ]
        for sf in staged_files:
            if sf and sf not in requested:
                die(f"checkpoint: refused staged path: {sf}")

        msg_lines = [subject]
        if body:
            msg_lines.extend(["", body])
        trailers = []
        if conv_id:
            trailers.append(f"Conversation: conversation://{conv_id}")
        for r in refs_list:
            trailers.append(f"Ref: {r}")
        if trailers:
            msg_lines.append("")
            msg_lines.extend(trailers)
        msg = "\n".join(msg_lines) + "\n"

        run_git(["commit", "--no-verify", "--no-gpg-sign", "-F", "-"], input_data=msg)
    except BaseException:
        run_git(["restore", "--staged", "--", *requested], check=False)
        raise


def cmd_commit(
    subject: str,
    body: str = "",
    refs: list[str] | None = None,
    conv: str | None = None,
) -> None:
    """Commit a logical transition with automatic project status synchronization."""
    refs_list = refs or []
    conv_id = get_active_conversation_id(conv)
    root = get_repo_root()
    if not has_commit_auth(root):
        die(f"commit: committed AGENTS.md must contain {COMMIT_AUTH}")

    diff_cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if diff_cached.returncode == 0:
        die("nothing staged")

    staged_files = [
        f
        for f in run_git(["diff", "-z", "--cached", "--name-only"]).stdout.split("\0")
        if f
    ]
    projects = {
        f.split("/")[0]
        for f in staged_files
        if "/" in f and is_project_dir(root / f.split("/")[0])
    }
    if len(projects) > 1:
        die("staged changes touch multiple projects")

    if projects:
        project_name = next(iter(projects))
        get_proj_dir(project_name, root)
        findings = audit_workspace(root, project_name)
        if any(f.severity in ("WARN", "FAIL") for f in findings):
            die("doctor found errors")
        status_porcelain = run_git(
            ["status", "--porcelain", "--", f"{project_name}/STATUS.md"],
            check=False,
        ).stdout.strip()
        if status_porcelain:
            print(
                f"[INFO]  Staging working-tree updates in {project_name}/STATUS.md",
                file=sys.stderr,
            )
        if sync_status(root, project_name):
            run_git(["add", f"{project_name}/STATUS.md"])

    msg_lines = [subject]
    if body:
        msg_lines.extend(["", body])
    trailers = []
    if conv_id:
        trailers.append(f"Conversation: conversation://{conv_id}")
    for r in refs_list:
        trailers.append(f"Ref: {r}")
    if trailers:
        msg_lines.append("")
        msg_lines.extend(trailers)
    msg = "\n".join(msg_lines) + "\n"

    run_git(["commit", "--no-verify", "--no-gpg-sign", "-F", "-"], input_data=msg)


HELP_TEXT = """Usage: taskgo COMMAND [OPTIONS]

Maintain a private Git-backed personal project/task control repo.

Commands:
  id                               Allocate a unique task ID
  root                             Print the active control repository root
  create PROJECT TITLE [OPTIONS]   Create a new task (--problem, --goal, etc.)
  update TASK_ID [OPTIONS]         Update task fields, status, or headings
  list [PROJECT] [OPTIONS]         List tasks
  status [PROJECT] [--json]        Show project status
  sync [PROJECT]                   Update STATUS.md snapshot
  doctor [PROJECT]                 Run mechanical checks (read-only)
  fix [PROJECT] [OPTIONS]          Auto-heal IDs, statuses, and snapshots
  history PATH_OR_TASK_ID [FIELD]  Show frontmatter history
  checkpoint TASK_ID SUBJECT [...] Commit an authorized tracker checkpoint (--all)
  commit SUBJECT [OPTIONS]         Commit a logical transition

Options:
  -R, --root DIR  Operate on the control repository at DIR instead of the
                  default (~/.projects); overrides TASKGO_ROOT. Must appear
                  before COMMAND.
  --help, -h      Display this help message and exit

Examples:
  taskgo id
  taskgo create my-project "Diagnose intermittent disconnects"
  taskgo create my-project "Add cache layer" --problem "High latency" --goal "Sub-10ms"
  taskgo update TASK-3A91F --status in-progress --sketch "Use in-memory dict"
  taskgo sync my-project
  taskgo fix my-project
  taskgo checkpoint TASK-3A91F "project: start diagnosis" --all"""


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="taskgo",
        description="Maintain a private Git-backed personal project/task control repo.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        add_help=False,
    )
    parser.add_argument(
        "--help",
        "-h",
        action="store_true",
        help="Display this help message and exit",
    )
    parser.add_argument(
        "--root",
        "-R",
        metavar="DIR",
        default=None,
        help=(
            "Control repository to operate on (default: ~/.projects, "
            "overridden by TASKGO_ROOT); must appear before COMMAND"
        ),
    )

    subparsers = parser.add_subparsers(dest="command", metavar="COMMAND")

    # id
    subparsers.add_parser(
        "id",
        help="Allocate a unique task ID",
        description="Allocate a unique task ID.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # root
    subparsers.add_parser(
        "root",
        help="Print the active control repository root",
        description=(
            "Print the resolved control repository root (the directory all "
            "commands operate on), after validation."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # create
    p_create = subparsers.add_parser(
        "create",
        help="Create a new task in PROJECT",
        description="Create a new task in PROJECT.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  taskgo create my-project "Diagnose intermittent disconnects"
