    id: str
    status: str
    conversations: list[str]
    blocked_by: list[str]
    wait_for: list[str | date] | str | date
    due: str | date
    stale_after: str | date


RESOLVED_STATES = {TaskStatus.DONE.value, TaskStatus.CANCELLED.value}

CANONICAL_AGENTS = ("jetski", "antigravity", "claude", "codex", "opencode")

SESSION_VARS = (
    "CLAUDE_CODE_SESSION_ID",
    "CLAUDE_CODE_REMOTE_SESSION_ID",
    "JETSKI_CONVERSATION_ID",
    "ANTIGRAVITY_CONVERSATION_ID",
    "ANTIGRAVITY_SESSION",
    "CLAUDE_SESSION_ID",
    "OPENCODE_SESSION_ID",
    "CODEX_SESSION_ID",
    "INVOKER_INFO_ROOT_SESSION_ID",
    "CONVERSATION_ID",
)


def canonicalize_agent_name(name: str | None) -> str | None:
    """Maps free-text or version-stamped agent names to canonical tokens.

    Checks CANONICAL_AGENTS in priority order (first substring match wins).
    """
    if not name:
        return None
    lower = name.lower()
    for agent in CANONICAL_AGENTS:
        if agent in lower:
            return agent
    return None


def detect_agent_scheme() -> str:
    """Detects the canonical agent platform scheme from runtime environment variables."""
    for var in ("AI_AGENT", "INVOKER_INFO_NAME"):
        c = canonicalize_agent_name(os.environ.get(var))
        if c:
            return c
    if os.environ.get("JETSKI_CONVERSATION_ID"):
        return "jetski"
    if os.environ.get("ANTIGRAVITY_CONVERSATION_ID") or os.environ.get(
        "ANTIGRAVITY_SESSION"
    ):
        return "antigravity"
    if (
        os.environ.get("CLAUDE_CODE_SESSION_ID")
        or os.environ.get("CLAUDE_CODE_REMOTE_SESSION_ID")
        or os.environ.get("CLAUDE_SESSION_ID")
    ):
        return "claude"
    if os.environ.get("OPENCODE_SESSION_ID"):
        return "opencode"
    if os.environ.get("CODEX_SESSION_ID"):
        return "codex"
    return "conversation"


def parse_conversation_entry(entry: Any) -> tuple[str, str] | None:
    """Parses a conversation entry into (scheme, session_id).

    Tolerates web URLs and bare IDs without errors while validating charsets.
    """
    if not entry:
        return None
    if isinstance(entry, dict):
        clean = ", ".join(f"{k}: {v}" for k, v in entry.items())
    else:
        clean = str(entry).strip().replace("\n", " ")
        clean = re.sub(r"\s+", " ", clean)

    if "://" in clean:
        parts = clean.split("://", 1)
        scheme = parts[0].strip().lower()
        remainder = parts[1].strip()
        if (
            re.match(r"^[a-z][a-z0-9+.-]*$", scheme)
            and len(remainder) >= 16
            and re.match(r"^[A-Za-z0-9_./?=&%#-]+$", remainder)
        ):
            return scheme, remainder
        return None

    # Bare identifier (at least 16 alphanumeric characters, dashes, or underscores)
    if len(clean) >= 16 and re.match(r"^[A-Za-z0-9_-]+$", clean):
        return "conversation", clean

    return None


def normalize_conversation_id(
    conv: str | None,
) -> tuple[str, str] | None:
    """Validates and normalizes a conversation or session identifier.

    Returns (scheme, conv_id) or None.
    """
    if not conv:
        return None
    parsed = parse_conversation_entry(conv)
    if not parsed:
        die(
            f"invalid conversation ID '{conv}' (must be a globally unique identifier with at least 16 alphanumeric characters, dashes, or underscores)"
        )
    scheme, conv_id = parsed
    if not scheme or scheme == "conversation":
        scheme = detect_agent_scheme()
    return scheme, conv_id


def get_active_session(
    cli_arg: str | None = None,
) -> tuple[str, str] | None:
    """Resolves (scheme, conv_id) from CLI arg or environment in pairwise priority."""
    if cli_arg:
        return normalize_conversation_id(cli_arg)

    for var in SESSION_VARS:
        val = os.environ.get(var)
        if val:
            parsed = parse_conversation_entry(val)
            if parsed:
                scheme, conv_id = parsed
                if not scheme or scheme == "conversation":
                    if var in (
                        "CLAUDE_CODE_SESSION_ID",
                        "CLAUDE_CODE_REMOTE_SESSION_ID",
                        "CLAUDE_SESSION_ID",
                    ):
                        scheme = "claude"
                    elif var == "JETSKI_CONVERSATION_ID":
                        scheme = "jetski"
                    elif var in ("ANTIGRAVITY_CONVERSATION_ID", "ANTIGRAVITY_SESSION"):
                        scheme = "antigravity"
                    elif var == "CODEX_SESSION_ID":
                        scheme = "codex"
                    elif var == "OPENCODE_SESSION_ID":
                        scheme = "opencode"
                    else:
                        scheme = detect_agent_scheme()
                return scheme, conv_id
            print(
                _tagged(
                    f"[WARN]  Ignoring invalid conversation ID in ${var}: {val}",
                    sys.stderr,
                ),
                file=sys.stderr,
            )

    return None


def get_active_conversation_id(cli_arg: str | None = None) -> str | None:
    """Resolves the conversation URI ('<scheme>://<id>') from CLI arg or environment."""
    session = get_active_session(cli_arg)
    if not session:
        return None
    scheme, conv_id = session
    return f"{scheme}://{conv_id}"


def update_task_conversation(
    data: dict[str, Any],
    scheme: str,
    conv_id: str,
) -> bool:
    """Updates frontmatter conversations with scheme://conv_id.

    Returns True if data was modified, False otherwise.
    Upgrades existing conversation://conv_id to the specific agent scheme
    so task frontmatter and Git commit trailers stay aligned.
    """
    convs_key = next((k for k in data if str(k).lower() == "conversations"), None)
    conv_key = next((k for k in data if str(k).lower() == "conversation"), None)

    entries: list[Any] = []
    if convs_key and isinstance(data[convs_key], list):
        entries = data[convs_key]
    elif convs_key and data[convs_key]:
        entries = [data[convs_key]]
        data[convs_key] = entries
    elif conv_key and data[conv_key]:
        entries = (
            list(data[conv_key])
            if isinstance(data[conv_key], list)
            else [data[conv_key]]
        )
        data.pop(conv_key, None)
        data["conversations"] = entries
        convs_key = "conversations"
    else:
        entries = []
        data["conversations"] = entries
        convs_key = "conversations"

    target_uri = f"{scheme}://{conv_id}"

    for idx, item in enumerate(entries):
        parsed = parse_conversation_entry(item)
        if parsed and parsed[1] == conv_id:
            e_scheme, _ = parsed
            # Upgrade generic conversation:// to specific agent scheme
            if e_scheme == "conversation" and scheme != "conversation":
                entries[idx] = target_uri
                return True
            # Already matches target URI or has another specific scheme
            return False

    entries.append(target_uri)
    return True


# taskgo owns its control repository commits and bypasses local hooks with
# --no-verify, so it enforces the workspace commit standard (Conventional
# Commits plus a 50-character subject limit) on its own output instead.
COMMIT_TYPES = (
    "build",
    "chore",
    "ci",
    "docs",
    "feat",
    "fix",
    "perf",
    "refactor",
    "revert",
    "style",
    "test",
)
SUBJECT_MAX_LEN = 50
CONVENTIONAL_SUBJECT_RE = re.compile(
    r"^(?P<type>"
    + "|".join(COMMIT_TYPES)
    + r")(?P<scope>\([^()]*\))?(?P<bang>!?): (?P<desc>.+)$"
)


def _truncate_subject_desc(text: str, budget: int) -> str:
    """Truncate text to budget characters at a word boundary, with ellipsis."""
    if budget <= 3:
        return text[:budget]
    cut = text[: budget - 3].rstrip()
    if " " in cut:
        cut = cut[: cut.rfind(" ")].rstrip()
    return f"{cut}..."


def conventional_subject(desc: str, project_name: str | None) -> str:
    """Build a conforming 'chore' subject for an auto-generated commit."""
    scope = ""
    if project_name:
        scope = re.sub(r"[^a-z0-9-]+", "-", project_name.lower()).strip("-")
    candidates = []
    if scope:
        candidates.append(f"chore({scope}): {desc}")
    candidates.append(f"chore: {desc}")
    for subject in candidates:
        if len(subject) <= SUBJECT_MAX_LEN:
            return subject
    budget = SUBJECT_MAX_LEN - len("chore: ")
    return f"chore: {_truncate_subject_desc(desc, budget)}"


def ensure_conventional_subject(subject: str, project_name: str | None) -> str:
    """Rewrite a nonconforming commit subject into Conventional Commits form.

    Deterministic and boring: conforming subjects pass through untouched
    apart from lowercased type/scope; anything else becomes
    chore(<project>): <subject>, truncated to the 50-character limit.
    Prints a [WARN] whenever rewriting occurs so agents can adjust.
    """
    original = subject.strip()
    if not original:
        die("commit subject must not be empty")
    match = CONVENTIONAL_SUBJECT_RE.match(original)
    if match:
        rebuilt = "{}{}{}: {}".format(
            match.group("type").lower(),
            match.group("scope") or "",
            match.group("bang"),
            match.group("desc").strip(),
        )
        prefix_len = len(rebuilt) - len(match.group("desc"))
        if len(rebuilt) > SUBJECT_MAX_LEN:
            truncated = rebuilt[:prefix_len] + _truncate_subject_desc(
                match.group("desc"), SUBJECT_MAX_LEN - prefix_len
            )
            print(
                _tagged(
                    f"[WARN]  Truncated over-long commit subject (> {SUBJECT_MAX_LEN}):\n"
                    f"[WARN]    {original}\n"
                    f"[WARN]    -> {truncated}",
                    sys.stderr,
                ),
                file=sys.stderr,
            )
            return truncated
        if rebuilt != original:
            print(
                _tagged(
                    f"[WARN]  Normalized commit subject case: {rebuilt}", sys.stderr
                ),
                file=sys.stderr,
            )
        return rebuilt
    # Legacy 'project: subject' and 'project/TASK-ID: subject' prefixes carry
    # no Conventional Commits meaning; the token becomes redundant once the
    # project name is used as the scope, so drop it.
    stripped = re.match(r"^[A-Za-z0-9._/-]+:[ \t]+(.+)$", original)
    desc = (stripped.group(1).strip() if stripped else original) or original
    new = conventional_subject(desc, project_name)
    print(
        _tagged(
            "[WARN]  Rewrote nonconforming commit subject"
            " (expected 'type(scope): description'):\n"
            f"[WARN]    {original}\n"
            f"[WARN]    -> {new}",
            sys.stderr,
        ),
        file=sys.stderr,
    )
    return new


BODY_WRAP_WIDTH = 72


def wrap_body(text: str) -> str:
    """Hard-wrap a plain-text commit body to BODY_WRAP_WIDTH columns.

    Bodies are plain text, not Markdown: blank-line-separated paragraphs
    are reflowed; lines that start with whitespace or a code fence are
    left verbatim so pasted structure degrades gracefully. Unbreakable
    tokens such as URLs are never split (they may exceed the width on
    their own line). Returns the original text unchanged when it already
    fits.
    """
    if not text:
        return text
    out: list[str] = []
    para: list[str] = []

    def flush() -> None:
        if para:
            out.extend(
                textwrap.wrap(
                    " ".join(para),
                    width=BODY_WRAP_WIDTH,
                    break_long_words=False,
                    break_on_hyphens=False,
                )
                or [""]
            )
            para.clear()

    for line in text.splitlines():
        if not line.strip():
            flush()
            out.append("")
        elif line[0].isspace() or line.startswith(("```", "~~~")):
            flush()
            out.append(line.rstrip())
        else:
            para.append(line.strip())
    flush()
    wrapped = "\n".join(out)
    return wrapped if wrapped != text else text


def reformat_frontmatter(text: str) -> str:
    """Reflows YAML frontmatter scalars to WRAP_WIDTH using ruamel.yaml."""
    m = re.search(r"^---\n(.*?)\n---(?:\n|$)", text, re.DOTALL)
    if not m:
        return text

    frontmatter_str = m.group(1)
    body = text[m.end() :]

    yaml = YAML()
    yaml.width = WRAP_WIDTH
    yaml.preserve_quotes = True
    yaml.default_flow_style = False

    try:
        data = yaml.load(frontmatter_str)
    except Exception:
        return text

    if not data:
        return text

    buf = io.StringIO()
    yaml.dump(data, buf)
    body_sep = "\n" if body else ""
    return f"---\n{buf.getvalue()}---\n{body_sep}{body}"


def format_markdown(text: str) -> str:
    """Formats Markdown text using mdformat (with gfm, frontmatter, and 80-char wrap)."""
    text = reformat_frontmatter(text)
    return mdformat.text(
        text,
        options={"wrap": WRAP_WIDTH},
        extensions={"gfm", "frontmatter"},
    )


