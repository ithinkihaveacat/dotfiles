def skill_root() -> Path:
    """The directory holding this skill's SKILL.md, found by sentinel rather
    than depth so that a symlink or a move within the tree still works.
    TASKGO_SKILL_DIR names it when the script has been copied elsewhere."""
    override = os.environ.get("TASKGO_SKILL_DIR")
    if override:
        return Path(override).expanduser().resolve()
    for parent in Path(__file__).resolve().parents:
        if (parent / "SKILL.md").is_file():
            return parent
    sys.exit("taskgo mcp: cannot find SKILL.md above this script; set TASKGO_SKILL_DIR")


def load_cli() -> Any:
    """The taskgo CLI as a module: its snapshots, change sets, and audit."""
    existing = sys.modules.get("taskgo_cli")
    if existing is not None:
        return existing
    path = skill_root() / "scripts" / "taskgo"
    if not path.is_file():
        sys.exit(f"taskgo mcp: {path} not found; set TASKGO_SKILL_DIR")
    loader = SourceFileLoader("taskgo_cli", str(path))
    spec = importlib.util.spec_from_loader("taskgo_cli", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules["taskgo_cli"] = module
    loader.exec_module(module)
    return module


_cli = load_cli()
