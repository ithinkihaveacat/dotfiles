# ===========================================================================
# MCP server ('taskgo mcp'): tools over committed state
# ===========================================================================
#
# Each read resolves one commit and reads only that commit, through a
# GitTreeSnapshot, so a response is coherent even while main moves. Payloads
# that the CLI also prints use the CLI's own functions, so they match the CLI
# at that commit. Unpinned reads fetch the branch, or use the head fetched or
# pushed in the last few seconds (--fetch-ttl); when the fetch fails, they
# serve the last head fetched, marked stale. Each write applies one change
# set over the head, commits it without a working tree, and pushes it without
# force; a rejected push fetches the head and applies the set again there.
# With --local there is no remote: the local branch is read as it is, and a
# write moves it (compare-and-swap) and refreshes the checkout's touched
# paths, so the CLI keeps working beside the server.
# The MCP Python SDK speaks the protocol (ADR 12): every revision it supports,
# over Streamable HTTP (stateless, with JSON responses) or, with --stdio, for
# one local client.
# Cloudflare Access authenticates callers in front of the server; McpGate
# checks the Access JWT on every HTTP request before the SDK sees it.

MCP_SERVER_VERSION = "0.15.0"
MCP_MAX_FILE_BYTES = READ_MAX_BYTES
MCP_MAX_REQUEST_BYTES = 1024 * 1024
MCP_FETCH_TIMEOUT = 60
MCP_PUSH_TIMEOUT = 60
# Seconds a fetch (or this server's own push) stays fresh for unpinned reads;
# 0 fetches on every call. Half of an agent's back-to-back tool calls come
# within 5s of each other.
# Pushes per write; each rejected one re-reads the head and applies again.
MCP_WRITE_ATTEMPTS = 5
# How long, and for how many requests, a retry is recognized (ADR 2).
MCP_REQUEST_TTL = 24 * 3600
MCP_REQUEST_KEEP = 1000
MCP_REQUEST_ID_MAX = 128
# Commits behind the head searched for a request_id's trailers when the ID
# is not in memory, as after a restart; and the trailers themselves.
MCP_REQUEST_SCAN = 200
MCP_REQUEST_ID_TRAILER = "Request-Id"
MCP_REQUEST_DIGEST_TRAILER = "Request-Digest"
MCP_REQUEST_DIGEST_LEN = 16
MCP_CERTS_TTL = 3600
MCP_LOOPBACK = ("localhost", "127.0.0.1", "::1")
# Answers GET and HEAD with 200 and the server's version and source commit,
# unauthenticated, for health checks such as a reverse proxy's. It reads
# nothing of the tracker.
MCP_HEALTH_PATH = "/up"
# Longest value, and longest reason, in a request's log line.
MCP_LOG_VALUE_MAX = 80
MCP_LOG_REASON_MAX = 200
# The request log: a JSON record for each request, appended to a file that is
# rotated by size.
MCP_LOG_ENV = "TASKGO_MCP_LOG"
MCP_LOG_ROTATE_BYTES = 8 * 1024 * 1024
MCP_LOG_ROTATED = 4  # FILE.1 (newest) to FILE.4: 40 MiB in all
# Tool arguments a record keeps, shortened: those that name what a call is
# about (a project, a task, a path, a search), never those that carry text
# (titles, bodies, file content, edits) or conversation links.
MCP_LOG_ARGS = (
    "target",
    "project",
    "id",
    "state",
    "path",
    "prefix",
    "field",
    "kind",
    "slug",
    "start_line",
    "end_line",
    "line_numbers",
    "replace_all",
    "args",
    "paths",
    "at",
    "request_id",
)
MCP_LOG_ARG_MAX = 60
# JWT claims that identify a caller, hashed into a record's caller key.
MCP_CALLER_CLAIMS = ("sub", "email", "client_id", "azp")

MCP_UNVERIFIED = (
    "External wait_for gates (bugs, changes, issues, people, free text) are not checked by "
    "this server; each is reported as unverified and treated as still holding "
    "its task. Run 'taskgo check' locally to poll them."
)

MCP_INSTRUCTIONS = f"""\
This server reads and writes a taskgo control repository: a private Git
repository of Markdown that tracks projects, tasks (TASK-XXXXX), decisions,
and each project's STATUS.md.

Start with handoff(target), a project name or a task ID: one call returns
the project's README.md, STATUS.md, PLAN.md, the root AGENTS.md, its active
and ready tasks, and the task record. list_projects and list_tasks (state
'ready' for workable tasks) find a target. Every response names the commit
it read in as_of.commit; pass it as 'at' to keep several reads on the same
commit. handoff.skills names the agent skills the project expects: activate
them if your harness has a skill manager (adding one already active is
harmless), otherwise ignore them. Before your first write, read
handoff.guide: how to keep the tracker current.

create and apply_changes record progress: each call is one commit on main,
or nothing. Edits name the section hash or blob SHA they replace, as read
from get_task, get_project_status, or list_files, and are refused if it no
longer holds; read again and retry. Each write returns findings on the
files and tasks it touched: advice, since the write has landed. Pass a
fresh request_id for each write and the same one when retrying it after an
unclear outcome, so that it is recorded once.

{MCP_DATA_CARE}

{MCP_UNVERIFIED}"""


def status_prose(
    snap: Snapshot, project: str, every: bool = False
) -> list[tuple[str, str]] | None:
    """PROJECT's STATUS.md Summary and Next texts in SNAP, or with EVERY all
    its sections but the task snapshot; None without one."""
    rel = f"{project}/STATUS.md"
    if not snap.is_file(rel):
        return None
    return [
        (s["name"], s["text"])
        for s in record_sections(snap.read_text(rel), STATUS_SCHEMA)
        if (s["name"] != "snapshot" if every else s["name"] in ("Summary", "Next"))
    ]


def write_findings(
    snap: Snapshot,
    parent: Snapshot | None,
    paths: list[str],
    rows: list[TaskRow] | None = None,
) -> list[dict[str, str]]:
    """What a write that changed PATHS, from PARENT to SNAP, leaves to check.

    doctor's findings, without its formatting checks (the write formatted
    its records), on the files the write touched or naming a task in them,
    such as a blocker it resolved in any project; and, for each project
    where it changed an existing task but not STATUS.md's Summary or Next,
    a reminder. ROWS are SNAP's task rows, when the caller has them.
    """
    rows = get_task_rows(snap) if rows is None else rows
    touched = set(paths)
    # A STATUS.md the write only regenerated, because a task it changed
    # holds one in another project, says nothing about the write.
    if parent is not None:
        touched -= {
            rel
            for rel in touched
            if rel.endswith("/STATUS.md")
            and not any(
                p != rel and p.startswith(rel.removesuffix("STATUS.md"))
                for p in touched
            )
            and status_prose(snap, rel.split("/", 1)[0], every=True)
            == status_prose(parent, rel.split("/", 1)[0], every=True)
        }
    ids = {r.task_id for r in rows if r.task_id and r.rel_path in touched}
    out = [
        {"severity": f.severity, "message": f.message}
        for f in audit_snapshot(snap, markdown=False, rows=rows, only=touched)
        if f.severity != "PASS"
        and (f.path in touched or any(i in f.message for i in ids))
    ]
    if parent is None:
        return out
    changed = {
        p.split("/", 1)[0]
        for p in touched
        if p.partition("/")[2].startswith("tasks/") and parent.is_file(p)
    }
    for project in sorted(changed):
        if status_prose(snap, project) == status_prose(parent, project):
            out.append(
                {
                    "severity": "INFO",
                    "message": (
                        f"{project}/STATUS.md: Summary and Next are unchanged; "
                        "if this write changed where the project stands or what "
                        "comes next, rewrite them"
                    ),
                }
            )
    return out


@dataclass(slots=True)
class McpConfig:
    repo: Path
    remote: str | None  # None reads the local branch without fetching
    branch: str
    auth: Literal["access", "none"]
    team: str | None = None
    audience: str | None = None
    certs_url: str | None = None
    fetch_ttl: float = MCP_FETCH_TTL
    # Without a remote: writes move the local branch and refresh the checkout
    # (--local), rather than being refused (--no-fetch).
    local: bool = False

    def where(self) -> str:
        """The branch as a message names it."""
        if self.remote:
            return f"{self.branch} from {self.remote}"
        return f"local {self.branch}"

    def unreadable(self) -> str:
        """The start of a message about a head that could not be read."""
        return f"could not {'fetch' if self.remote else 'read'} {self.where()}"


class McpReader:
    """Resolves commits of one control repository and keeps their snapshots.

    Snapshots are immutable per commit, so the few most recent are kept.

    The remote-tracking ref is the cached head of the branch. It is fresh for
    fetch_ttl seconds after a fetch, or after a push by this server, which
    moves it; until then, unpinned reads use it without fetching. Losing the
    cache, as on a restart, only costs a fetch. Without a remote, the local
    branch is the head, read as it is for every call.
    """

    KEEP = 4

    def __init__(self, cfg: McpConfig):
        self.cfg = cfg
        self.snaps: dict[str, tuple[GitTreeSnapshot, int]] = {}
        # When the remote-tracking ref was last known to match the remote
        # (time.monotonic()); None when it is not known to.
        self.fetched_at: float | None = None
        # When a fetch last failed; None after one succeeds. Unpinned reads
        # within fetch_ttl of a failure serve the stale head without trying
        # again, so an unreachable remote costs one timeout per TTL, not one
        # per call.
        self.failed_at: float | None = None

    def git(self, *args: str) -> subprocess.CompletedProcess:
        return run_git(list(args), cwd=self.cfg.repo, check=False)

    def tracking_ref(self) -> str:
        return f"refs/remotes/{self.cfg.remote}/{self.cfg.branch}"

    def branch_ref(self) -> str:
        """The ref that holds the head: the tracking ref, or the local branch."""
        if self.cfg.remote:
            return self.tracking_ref()
        return f"refs/heads/{self.cfg.branch}"

    def cached(self) -> bool:
        """True when there is a cached head that writes may try first."""
        return self.cfg.fetch_ttl > 0 and self.fetched_at is not None

    def fresh(self) -> bool:
        """True when the cached head is recent enough for an unpinned read."""
        at = self.fetched_at
        return (
            self.cfg.fetch_ttl > 0
            and at is not None
            and time.monotonic() - at < self.cfg.fetch_ttl
        )

    def forget(self) -> None:
        """Stops trusting the cached head: the next unpinned read fetches."""
        self.fetched_at = None

    def pushed(self, sha: str) -> None:
        """Records that SHA is now the head of the remote branch. A local
        branch was moved by the push itself, and is never cached."""
        if self.cfg.remote:
            self.git("update-ref", self.tracking_ref(), sha)
            self.fetched_at = time.monotonic()

    def fetch(self) -> None:
        cfg = self.cfg
        try:
            res = subprocess.run(
                ["git", "fetch", "--quiet", "--no-tags", cfg.remote, cfg.branch],
                cwd=cfg.repo,
                capture_output=True,
                text=True,
                timeout=MCP_FETCH_TIMEOUT,
                env=dict(os.environ, GIT_TERMINAL_PROMPT="0"),
                check=False,
            )
        except subprocess.TimeoutExpired:
            self.failed_at = time.monotonic()
            mcp_log(f"fetch failed: timed out after {MCP_FETCH_TIMEOUT}s")
            mcp_note(fetch="timed out")
            raise McpToolError(
                f"could not fetch {cfg.branch} from {cfg.remote} (timed out); "
                "pass an earlier as_of.commit as 'at' to read it"
            ) from None
        if res.returncode != 0:
            self.failed_at = time.monotonic()
            mcp_log(f"fetch failed: {res.stderr.strip()}")
            mcp_note(fetch="failed")
            raise McpToolError(
                f"could not fetch {cfg.branch} from {cfg.remote}; pass an "
                "earlier as_of.commit as 'at' to read it"
            )
        self.fetched_at = time.monotonic()
        self.failed_at = None

    def failing(self) -> bool:
        """True while a failed fetch is recent enough not to retry for a read."""
        at = self.failed_at
        return (
            self.cfg.fetch_ttl > 0
            and at is not None
            and time.monotonic() - at < self.cfg.fetch_ttl
        )

    def resolve(self, at: Any, *, fetch: bool = False) -> str:
        """The commit to read: AT when given, else the head of the branch.

        The head is the cached one while it is fresh, unless FETCH asks for
        the remote's head as it is now.
        """
        if at:
            if not isinstance(at, str) or not re.fullmatch(r"[0-9a-fA-F]{7,40}", at):
                raise McpToolError(f"'at' is not a commit SHA: {at!r}")
            sha = resolve_commit(self.cfg.repo, at)
            if sha is None and self.cfg.remote:
                # Perhaps newer than the last fetch.
                self.fetch()
                sha = resolve_commit(self.cfg.repo, at)
            if sha is None:
                raise McpToolError(f"no commit {at} in the control repository")
            return sha
        if self.cfg.remote and (fetch or not self.fresh()):
            self.fetch()
        ref = self.branch_ref()
        sha = resolve_commit(self.cfg.repo, ref)
        if sha is None:
            raise McpToolError(f"{ref} does not exist in the control repository")
        return sha

    def resolve_for_read(self, at: Any) -> tuple[str, bool]:
        """The commit a read tool reads, and whether it is a stale head.

        An unpinned read whose fetch fails is served the head last fetched,
        or pushed by this server, when there is one, rather than nothing;
        the response says so, and reads within fetch_ttl of the failure are
        served the same way without fetching again. A pinned read, or a
        first read with nothing fetched yet, fails as the fetch did.
        """
        if not at and self.cfg.remote and self.failing() and not self.fresh():
            sha = resolve_commit(self.cfg.repo, self.tracking_ref())
            if sha is not None:
                mcp_note(stale=True)
                return sha, True
        try:
            return self.resolve(at), False
        except McpToolError:
            if at or not self.cfg.remote:
                raise
            sha = resolve_commit(self.cfg.repo, self.tracking_ref())
            if sha is None:
                raise
            mcp_log(f"serving the last fetched head {sha[:12]} as stale")
            mcp_note(stale=True)
            return sha, True

    def snapshot(self, sha: str) -> tuple[GitTreeSnapshot, int]:
        """The snapshot of commit SHA and its commit time (Unix seconds)."""
        if sha in self.snaps:
            self.snaps[sha] = self.snaps.pop(sha)  # most recent last
            return self.snaps[sha]
        snap = GitTreeSnapshot(self.cfg.repo, sha)
        committed = int(self.git("show", "-s", "--format=%ct", sha).stdout.strip())
        self.snaps[sha] = (snap, committed)
        while len(self.snaps) > self.KEEP:
            self.snaps.pop(next(iter(self.snaps)))
        return snap, committed

    def is_ancestor(self, sha: str, head: str) -> bool:
        return self.git("merge-base", "--is-ancestor", sha, head).returncode == 0

    def commit(self, snap: GitTreeSnapshot, cs: ChangeSet, message: str) -> str:
        """A commit of CS over SNAP's commit, made without a working tree.

        Writes blobs, a tree, and the commit to the object store, through a
        temporary index; no ref moves.
        """
        import tempfile

        repo = self.cfg.repo
        with tempfile.TemporaryDirectory(prefix="taskgo-mcp-") as tmp:
            env = dict(os.environ, GIT_INDEX_FILE=str(Path(tmp) / "index"))

            def git(*args: str, data: bytes | None = None) -> str:
                res = subprocess.run(
                    ["git", *args],
                    cwd=repo,
                    input=data,
                    capture_output=True,
                    env=env,
                    check=False,
                )
                if res.returncode != 0:
                    err = res.stderr.decode("utf-8", "replace").strip()
                    raise McpToolError(f"git {args[0]} failed: {err}")
                return res.stdout.decode("utf-8").strip()

            git("read-tree", snap.rev)
            entries = []
            for rel, (_, after) in cs.snap.diff().items():
                if after is None:
                    entries.append(f"0 {'0' * 40}\t{rel}")
                else:
                    blob = git("hash-object", "-w", "--stdin", data=after.encode())
                    mode = "100755" if cs.snap.is_executable(rel) else "100644"
                    entries.append(f"{mode} {blob}\t{rel}")
            git(
                "update-index",
                "-z",
                "--index-info",
                data="".join(e + "\0" for e in entries).encode(),
            )
            tree = git("write-tree")
            return git(
                "-c",
                "user.useConfigOnly=true",
                "commit-tree",
                "--no-gpg-sign",
                tree,
                "-p",
                snap.rev,
                "-F",
                "-",
                data=message.encode(),
            )

    def push(self, sha: str) -> tuple[bool, str]:
        """Makes SHA the head of the branch, if its parent still is: pushed
        to the remote without force, or, without one, moved to on the local
        branch (see move). Returns (accepted, Git's message)."""
        cfg = self.cfg
        if not cfg.remote:
            return self.move(sha)
        try:
            res = subprocess.run(
                [
                    "git",
                    "push",
                    "--quiet",
                    "--no-verify",
                    cfg.remote,
                    f"{sha}:refs/heads/{cfg.branch}",
                ],
                cwd=cfg.repo,
                capture_output=True,
                text=True,
                timeout=MCP_PUSH_TIMEOUT,
                env=dict(os.environ, GIT_TERMINAL_PROMPT="0"),
                check=False,
            )
        except subprocess.TimeoutExpired:
            return False, "push timed out"
        # The ' ! [rejected] ... (fetch first)' line says why, when there is one.
        lines = [line.strip() for line in res.stderr.strip().splitlines()]
        why = next((line for line in lines if line.startswith("!")), None)
        return res.returncode == 0, why or (lines[-1] if lines else "")

    def move(self, sha: str) -> tuple[bool, str]:
        """Moves the local branch from SHA's parent to SHA (--local).

        The checkout must have the branch checked out, and no uncommitted
        change to a path the commit touches; other dirty paths are left
        alone. The move is a compare-and-swap on the ref, so a commit made
        meanwhile from the checkout refuses it, as a remote refuses a
        non-fast-forward push: (False, why), and the caller applies the set
        again over the new head. After the move, the index and working tree
        are brought from the parent to SHA for the touched paths only, so
        the checkout shows the commit as if it had been made there.
        """
        cfg = self.cfg
        ref = f"refs/heads/{cfg.branch}"
        parent = self.git("rev-parse", "--verify", f"{sha}^").stdout.strip()
        bare = self.git("rev-parse", "--is-bare-repository").stdout.strip() == "true"
        if not bare:
            git_dir = resolve_git_dir(cfg.repo)
            for marker, label in (
                ("rebase-merge", "rebase"),
                ("rebase-apply", "rebase"),
                ("MERGE_HEAD", "merge"),
                ("CHERRY_PICK_HEAD", "cherry-pick"),
                ("REVERT_HEAD", "revert"),
            ):
                if (git_dir / marker).exists():
                    raise McpToolError(
                        f"the checkout has a git {label} in progress; finish or "
                        "abort it first. Nothing was written"
                    )
            if self.git("ls-files", "-u").stdout.strip():
                raise McpToolError(
                    "the checkout has unmerged files; resolve conflicts first. "
                    "Nothing was written"
                )
            head = self.git("symbolic-ref", "--quiet", "HEAD").stdout.strip()
            if head != ref:
                raise McpToolError(
                    f"the checkout does not have {cfg.branch} checked out "
                    f"({head or 'detached HEAD'}); nothing was written"
                )
            paths = self.git(
                "diff-tree", "-r", "--no-commit-id", "--name-only", "-z", sha
            ).stdout.split("\0")
            paths = [p for p in paths if p]
            dirty = self.git(
                "status", "--porcelain", "--untracked-files=all", "--", *paths
            ).stdout
            if dirty.strip():
                names = ", ".join(line[3:] for line in dirty.splitlines())
                raise McpToolError(
                    f"the checkout has uncommitted changes to {names}; commit "
                    "or discard them first. Nothing was written"
                )
        res = self.git("update-ref", "-m", "taskgo mcp: write", ref, sha, parent)
        if res.returncode != 0:
            why = res.stderr.strip().splitlines()
            return False, (why[-1] if why else f"{cfg.branch} moved").removeprefix(
                "fatal: "
            )
        if not bare:
            # Two-tree read-tree: a fast-forward of the index and working tree
            # for the paths that differ between the parent and SHA, which also
            # removes files the commit deletes; other entries are kept.
            res = self.git("read-tree", "-m", "-u", parent, sha)
            if res.returncode != 0:
                mcp_log(
                    f"{cfg.branch} is at {sha[:12]} but the checkout could not be "
                    f"refreshed: {res.stderr.strip()}"
                )
        return True, ""

    def find_request(self, head: str, rid: str) -> tuple[str, str | None] | None:
        """The commit, with its digest, that the last MCP_REQUEST_SCAN commits
        behind HEAD record for request RID in their trailers, or None.

        Git picks out the trailer block, so a body line that happens to start
        with the trailer's name is not one.
        """
        res = self.git(
            "log",
            "-z",
            f"-n{MCP_REQUEST_SCAN}",
            "--format=%H%n%(trailers:only,unfold)",
            head,
        )
        if res.returncode != 0:
            return None
        for record in res.stdout.split("\0"):
            sha, _, message = record.partition("\n")
            trailers = dict(
                line.split(": ", 1)
                for line in message.splitlines()
                if ": " in line
                and line.split(": ", 1)[0]
                in (MCP_REQUEST_ID_TRAILER, MCP_REQUEST_DIGEST_TRAILER)
            )
            if trailers.get(MCP_REQUEST_ID_TRAILER) == rid:
                return sha, trailers.get(MCP_REQUEST_DIGEST_TRAILER)
        return None


@dataclass(slots=True)
class McpRead:
    """One tool call's view: a commit, its snapshot, and the reader. A read
    served a stale head, because the branch could not be fetched, says so
    in its as_of."""

    reader: McpReader
    snap: GitTreeSnapshot
    committed: int
    stale: bool = False

    def as_of(self) -> dict[str, Any]:
        as_of = snapshot_as_of(self.snap, self.committed)
        if self.stale:
            as_of["stale"] = True
        return as_of


def mcp_find_task(snap: GitTreeSnapshot, task_id: Any) -> TaskRow:
    task_id = str(task_id or "").strip().upper()
    if not ID_PATTERN.match(task_id):
        raise McpToolError(f"not a task ID: {task_id!r} (expected TASK-XXXXX)")
    try:
        return find_task_row(snap, task_id)
    except TaskgoError as e:
        raise McpToolError(str(e)) from None


def mcp_project(snap: GitTreeSnapshot, project: Any) -> str:
    if not isinstance(project, str) or not is_project(snap, project):
        raise McpToolError(f"unknown project: {project}")
    return project


def mcp_path(path: Any) -> str:
    try:
        return clean_rel_path(str(path or ""), allow_empty=True)
    except TaskgoError:
        raise McpToolError(
            f"invalid path: {str(path or '').strip().strip('/')!r}"
        ) from None


def mcp_list_projects(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    return {
        "as_of": r.as_of(),
        "projects": [project_status_json(r.snap, p) for p in list_projects(r.snap)],
    }


def mcp_list_tasks(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    project = args.get("project")
    if project:
        mcp_project(r.snap, project)
    state = args.get("state")
    if state and state.strip().lower() != "ready" and canonical_status(state) is None:
        raise McpToolError(f"unknown state: {state}")
    rows = select_task_rows(r.snap, project, state)
    return {
        "as_of": r.as_of(),
        "tasks": [task_row_json(row) for row in rows],
        "unverified_gates": unverified_gates(rows),
    }


def mcp_get_task(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    row = mcp_find_task(r.snap, args.get("id"))
    return {"as_of": r.as_of(), **task_record_json(r.snap, row)}


def mcp_get_project_status(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    project = mcp_project(r.snap, args.get("project"))
    rel = f"{project}/STATUS.md"
    committed = r.snap.read_text(rel) if r.snap.is_file(rel) else None
    proj = status_projection(r.snap, project)
    return {
        "as_of": r.as_of(),
        "project": project,
        "path": rel,
        "blob": r.snap.blobs.get(rel),
        **proj,
        "fresh_block": proj["live_block"],
        "unverified_gates": unverified_gates(get_task_rows(r.snap, project)),
        "content": committed,
    }


def mcp_read_file(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    rel = mcp_path(args.get("path"))
    sha = r.snap.blobs.get(rel)
    if sha is None:
        if r.snap.is_dir(rel):
            raise McpToolError(f"{rel} is a directory; use list_files")
        raise McpToolError(f"{rel} is not in commit {r.snap.rev[:12]}")
    raw = run_git(["cat-file", "blob", sha], cwd=r.reader.cfg.repo, text=False).stdout
    try:
        result = read_slice(
            rel,
            sha,
            raw,
            args.get("start_line"),
            args.get("end_line"),
            MCP_MAX_FILE_BYTES,
            args.get("line_numbers", False),
        )
    except TaskgoError as e:
        raise McpToolError(str(e)) from None
    return {"as_of": r.as_of(), **result}


def mcp_search_files(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    try:
        search = parse_search_args(args.get("args"), args.get("paths"))
        result, _ = run_search(r.reader.cfg.repo, search, r.snap.rev, set(r.snap.blobs))
    except TaskgoError as e:
        raise McpToolError(str(e)) from None
    return {"as_of": r.as_of(), **result}


def mcp_list_files(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    prefix = mcp_path(args.get("prefix"))
    if prefix and not r.snap.exists(prefix):
        raise McpToolError(f"{prefix} is not in commit {r.snap.rev[:12]}")
    files = [
        {"path": rel, "blob": sha, "executable": r.snap.modes[rel] == "100755"}
        for rel, sha in sorted(r.snap.blobs.items())
        if not prefix or rel == prefix or rel.startswith(prefix + "/")
    ]
    return {"as_of": r.as_of(), "files": files}


def mcp_handoff(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    try:
        t = resolve_handoff(r.snap, args.get("target"))
    except TaskgoError as e:
        raise McpToolError(str(e)) from None
    return handoff_payload(r.snap, t, r.as_of())


def mcp_get_task_history(r: McpRead, args: dict[str, Any]) -> dict[str, Any]:
    row = mcp_find_task(r.snap, args.get("id"))
    field = str(args.get("field") or "status").strip()
    versions = file_versions(r.reader.cfg.repo, r.snap.rev, row.rel_path)
    changes = field_history(versions, field)
    return {
        "as_of": r.as_of(),
        "task": task_row_json(row),
        "field": field,
        "changes": [
            {
                "date": c.date,
                "before": c.before,
                "after": c.after,
                "commit": c.sha,
                "subject": c.subject,
            }
            for c in changes
        ],
        "text": "\n".join(format_field_change(c) for c in changes),
    }


MCP_AT = {
    "type": "string",
    "description": (
        "Commit SHA to read. Omit to read the head of main; pass the 'commit' "
        "from an earlier response to keep several reads on one commit."
    ),
}
MCP_TASK_ID = {"type": "string", "description": "Task ID, TASK-XXXXX."}
MCP_PROJECT = {"type": "string", "description": "Project name."}


@dataclass(slots=True, frozen=True)
class McpTool:
    """A read tool's handler maps a commit's view and the arguments to the
    result; a write tool's handler maps the arguments to a change set."""

    name: str
    description: str
    properties: dict[str, Any]
    required: tuple[str, ...]
    handler: Callable[..., dict[str, Any]]
    writes: bool = False
    destructive: bool = False

    def listing(self) -> dict[str, Any]:
        if self.writes:
            properties = self.properties
            annotations = {
                "readOnlyHint": False,
                "destructiveHint": self.destructive,
                # With the same request_id, a retry is recorded once.
                "idempotentHint": True,
                "openWorldHint": False,
            }
        else:
            properties = {**self.properties, "at": MCP_AT}
            annotations = {"readOnlyHint": True, "openWorldHint": False}
        schema: dict[str, Any] = {"type": "object", "properties": properties}
        if self.required:
            schema["required"] = list(self.required)
        return {
            "name": self.name,
            "description": self.description,
            "inputSchema": schema,
            "annotations": annotations,
        }


def mcp_create_doc(args: dict[str, Any]) -> dict[str, Any]:
    fields, sections = args.get("fields") or {}, args.get("sections") or {}
    if not isinstance(fields, dict) or not isinstance(sections, dict):
        raise McpToolError("fields and sections must be objects")
    if "title" in sections:
        raise McpToolError("pass the title as 'title', not in sections")
    change = {
        "op": "create",
        "kind": args.get("kind") or "task",
        "project": args.get("project"),
        "fields": fields,
        "sections": {"title": args.get("title"), **sections},
    }
    if "slug" in args:
        change["slug"] = args["slug"]
    return {"changes": [change]}


def mcp_apply_doc(args: dict[str, Any]) -> dict[str, Any]:
    return {"changes": args.get("changes")}


def mcp_edit_doc(args: dict[str, Any]) -> dict[str, Any]:
    keys = ("path", "old_string", "new_string", "replace_all", "expected_blob")
    change = {"op": "edit_file", **{k: args[k] for k in keys if k in args}}
    if isinstance(change.get("path"), str):
        change["path"] = trim_boundary_path(change["path"])
    return {"changes": [change]}


MCP_WRITE_PROPERTIES = {
    "request_id": {
        "type": "string",
        "description": (
            "A fresh ID for this write, such as a UUID. Reuse it only to retry "
            "this same write after an unclear outcome: a write that already "
            "landed is then reported again, not recorded twice."
        ),
    },
    "subject": {
        "type": "string",
        "description": (
            "Commit subject, as Conventional Commits 'type(scope): description' "
            "in up to 50 characters; derived from the changes when omitted."
        ),
    },
    "body": {"type": "string", "description": "Commit body, plain text."},
    "conversation": {
        "type": "string",
        "description": (
            "Your session URI, as <agent>://<id>, where <agent> is one of "
            f"{', '.join(CANONICAL_AGENTS)} (claude for Claude Code) and <id> "
            "your session ID: recorded in a Conversation: trailer and in the "
            "conversations of every task the write touches."
        ),
    },
    "refs": {
        "type": "array",
        "items": {"type": "string"},
        "description": (
            "External references, such as artifact commits (repo@sha) or pull "
            "request URLs, each recorded in a Ref: trailer."
        ),
    },
}


