# Commands that 'permission apply' must not pre-approve.
# mcp serves the tracker to other agents and commits and pushes their writes.
# Guard lines match a command's leading words, so flags before 'mcp' (such as
# 'taskgo --root DIR mcp') are not matched by this prefix rule.
taskgo mcp
# Standalone MCP server script invoked by 'taskgo mcp' (or directly).
taskgo-mcp
