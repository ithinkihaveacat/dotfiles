#!/usr/bin/env bash

# Tests: skills/emumanager/tests/test-emumanager

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/emumanager"

echo "1..9"

OUTPUT=$(mktemp)
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR" "$OUTPUT"' EXIT

# Test 1: Main --help output
if "$BIN" --help >"$OUTPUT" 2>&1 && grep -q "Usage: emumanager" "$OUTPUT"; then
  echo "ok 1 - main help output includes usage"
else
  echo "not ok 1 - main help output failed"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 2: download package --help includes --channel
if "$BIN" download package --help >"$OUTPUT" 2>&1 && grep -q "\-\-channel" "$OUTPUT"; then
  echo "ok 2 - download package help documents --channel"
else
  echo "not ok 2 - download package help missing --channel"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 3: create avd --help includes --channel
if "$BIN" create avd --help >"$OUTPUT" 2>&1 && grep -q "\-\-channel" "$OUTPUT"; then
  echo "ok 3 - create avd help documents --channel"
else
  echo "not ok 3 - create avd help missing --channel"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 4: catalog package --help includes --channel
if "$BIN" catalog package --help >"$OUTPUT" 2>&1 && grep -q "\-\-channel" "$OUTPUT"; then
  echo "ok 4 - catalog package help documents --channel"
else
  echo "not ok 4 - catalog package help missing --channel"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 5: update package --help includes --channel
if "$BIN" update package --help >"$OUTPUT" 2>&1 && grep -q "\-\-channel" "$OUTPUT"; then
  echo "ok 5 - update package help documents --channel"
else
  echo "not ok 5 - update package help missing --channel"
  sed 's/^/# /' "$OUTPUT"
fi

# Test 6: Hermetic catalog package output formatting with mock sdkmanager
MOCK_SDK="$TMPDIR/mock-sdk"
mkdir -p "$MOCK_SDK/cmdline-tools/latest/bin"
mkdir -p "$MOCK_SDK/platform-tools"
mkdir -p "$MOCK_SDK/emulator"

touch "$MOCK_SDK/platform-tools/adb"
chmod +x "$MOCK_SDK/platform-tools/adb"
touch "$MOCK_SDK/emulator/emulator"
chmod +x "$MOCK_SDK/emulator/emulator"

cat <<'EOF' >"$MOCK_SDK/cmdline-tools/latest/bin/sdkmanager"
#!/usr/bin/env bash
if [[ "$*" == *"--list_installed"* ]]; then
  echo "  system-images;android-34;android-wear;arm64-v8a | 1 | Wear OS 5 ARM 64 v8a System Image | system-images/android-34/android-wear/arm64-v8a"
  echo "  system-images;android-34;android-wear;x8664 | 1 | Wear OS 5 Intel x86_64 Atom System Image | system-images/android-34/android-wear/x8664"
  exit 0
fi

if [[ "$*" == *"--list"* ]]; then
  cat <<'OUT'
Installed packages:
  system-images;android-34;android-wear;arm64-v8a | 1 | Wear OS 5 ARM 64 v8a System Image | system-images/android-34/android-wear/arm64-v8a
  system-images;android-34;android-wear;x8664 | 1 | Wear OS 5 Intel x86_64 Atom System Image | system-images/android-34/android-wear/x8664

Available Packages:
  system-images;android-34;android-wear;arm64-v8a | 1 | Wear OS 5 ARM 64 v8a System Image | system-images/android-34/android-wear/arm64-v8a
  system-images;android-34;android-wear;x8664 | 1 | Wear OS 5 Intel x86_64 Atom System Image | system-images/android-34/android-wear/x8664
  system-images;android-37.0;android-wear-signed;arm64-v8a | 1 | Wear OS 7.0 - Preview ARM 64 v8a System Image (signed) | system-images/android-37.0/android-wear-signed/arm64-v8a
  system-images;android-37.0;android-wear-signed;x8664 | 1 | Wear OS 7.0 - Preview Intel x86_64 Atom System Image (signed) | system-images/android-37.0/android-wear-signed/x8664
  system-images;android-36;google_apis_playstore;arm64-v8a | 1 | Google Play ARM 64 v8a System Image | system-images/android-36/google_apis_playstore/arm64-v8a
  system-images;android-36;google_apis_playstore;x8664 | 1 | Google Play Intel x86_64 Atom System Image | system-images/android-36/google_apis_playstore/x8664
OUT
  exit 0
fi
EOF
chmod +x "$MOCK_SDK/cmdline-tools/latest/bin/sdkmanager"

case "$(uname -m)" in
  arm64 | aarch64) ARCH="arm64-v8a" ;;
  *) ARCH="x8664" ;;
esac

CATALOG_OUT=$(ANDROID_HOME="$MOCK_SDK" "$BIN" catalog package)
if echo "$CATALOG_OUT" | grep -q "\* system-images;android-34;android-wear;${ARCH} *(api34, wear)" &&
  echo "$CATALOG_OUT" | grep -q "  system-images;android-37.0;android-wear-signed;${ARCH} *(api37.0, wear, preview)" &&
  echo "$CATALOG_OUT" | grep -q "  system-images;android-36;google_apis_playstore;${ARCH} *(api36, playstore)"; then
  echo "ok 6 - catalog package formats extracted metadata tags correctly"
else
  echo "not ok 6 - catalog package output formatting failed"
  printf '%s\n' "$CATALOG_OUT" | sed 's/^/# /'
fi

# Test 7: doctor output piped to a file carries plain ASCII tags, no escapes
if "$BIN" doctor >"$OUTPUT" 2>&1 || true; then
  if grep -q $'\033' "$OUTPUT"; then
    echo "not ok 7 - piped doctor output unexpectedly contains escape sequences"
    sed 's/^/# /' "$OUTPUT" | head
  elif ! grep -qE '^\[(PASS|INFO|WARN|FAIL)\]' "$OUTPUT"; then
    echo "not ok 7 - piped doctor output missing canonical tags"
    sed 's/^/# /' "$OUTPUT" | head
  else
    echo "ok 7 - piped doctor output is plain ASCII tags"
  fi
else
  echo "not ok 7 - doctor could not run"
fi

# Test 8: FORCE_COLOR styles diagnostic tags even when piped
FORCE_COLOR=1 "$BIN" doctor >"$OUTPUT" 2>&1 || true
if grep -q $'\033\[3[1236]m\[' "$OUTPUT"; then
  echo "ok 8 - FORCE_COLOR styles diagnostic tags"
else
  echo "not ok 8 - FORCE_COLOR did not style diagnostic tags"
  sed 's/^/# /' "$OUTPUT" | head
fi

# Test 9: NO_COLOR suppresses styling even when FORCE_COLOR is set
NO_COLOR=1 FORCE_COLOR=1 "$BIN" doctor >"$OUTPUT" 2>&1 || true
if grep -q $'\033' "$OUTPUT"; then
  echo "not ok 9 - NO_COLOR did not suppress styling"
else
  echo "ok 9 - NO_COLOR suppresses styling despite FORCE_COLOR"
fi
