""".replace("@TITLE@", f"{PROG} requests").replace("@SCRIPT@", LOGS_SCRIPT)


async def http_reply(
    send: Any,
    status: int,
    text: str,
    content_type: str = "text/plain; charset=utf-8",
    extra: tuple[tuple[str, str], ...] = (),
) -> None:
    data = text.encode()
    headers = [
        (b"content-type", content_type.encode()),
        (b"content-length", str(len(data)).encode()),
    ]
    headers += [(k.encode(), v.encode()) for k, v in extra]
    await send({"type": "http.response.start", "status": status, "headers": headers})
    await send({"type": "http.response.body", "body": data})


def host_name(header: str | None) -> str:
    """The name in a Host header, without its port or IPv6 brackets."""
    host = (header or "").strip().lower()
    if host.startswith("["):
        return host[1:].partition("]")[0]
    return host.rpartition(":")[0] if host.count(":") == 1 else host


class LoggingGate:
    """ASGI, in front of the SDK's app: the health check, the log page, Access
    (or, without it, a check that the page is asked for by a name the server
    answers to), the endpoint paths, the size limit, and one record for each
    request. The SDK sees only requests that pass."""

    def __init__(
        self,
        app: Any,
        verifier: Any,
        paths: set[str],
        log: RequestLog,
        hosts: list[str],
    ):
        self.app = app
        self.verifier = verifier
        self.paths = paths
        self.log = log
        self.hosts = {"127.0.0.1", "localhost", "::1", *(host_name(h) for h in hosts)}
        self.health = json.dumps(
            {"status": "ok", "version": VERSION, "commit": source_commit()}
        )

    async def __call__(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        if scope["type"] != "http":  # lifespan
            await self.app(scope, receive, send)
            return
        headers: dict[str, str] = {}
        for k, v in scope["headers"]:
            headers.setdefault(k.decode("latin-1").lower(), v.decode("latin-1"))
        path, method = scope["path"], scope["method"]
        if path == "/up" and method in ("GET", "HEAD"):
            # Polled by the proxy, so reachable without a token, and not logged.
            await http_reply(send, 200, self.health, "application/json")
            return
        if method == "GET" and ICON_PATHS.fullmatch(path):
            await http_reply(send, 404, "not found")
            return
        event = Event("http", http=method, agent=headers.get("user-agent"))
        token = EVENT.set(event)
        quiet = False
        try:
            if path in (LOGS_PATH, LOGS_DATA_PATH):
                quiet = await self.logs(scope, send, headers, event)
            else:
                await self.serve(scope, receive, send, headers, event)
        except BaseException as e:
            event.fail("error", type(e).__name__)
            quiet = False
            raise
        finally:
            EVENT.reset(token)
            if not quiet:
                self.log.emit(event)

    def refusal(
        self, headers: dict[str, str], event: Event
    ) -> tuple[int, str, str, tuple[tuple[str, str], ...]] | None:
        """(status, reason, text, headers) when the request may not proceed. A
        request with an Access token gets its caller key from its claims."""
        if self.verifier is None:
            return None
        tok = headers.get("cf-access-jwt-assertion")
        if not tok:
            return (
                401,
                "no Access token",
                "Cloudflare Access token required",
                (("www-authenticate", "Bearer"),),
            )
        try:
            claims = self.verifier.verify(tok)
        except AccessError as e:
            return 403, str(e), str(e), ()
        event.caller = caller_key(*(claims.get(k) for k in CALLER_CLAIMS))
        return None

    async def logs(
        self, scope: dict[str, Any], send: Any, headers: dict[str, str], event: Event
    ) -> bool:
        """Serves the log page, or the records after the page's cursor with
        stats over those kept. True if it did: the page polls every second,
        so only refusals are logged."""
        from urllib.parse import parse_qs

        refusal = self.refusal(headers, event)
        if (
            refusal is None
            and self.verifier is None
            and host_name(headers.get("host")) not in self.hosts
        ):
            # The SDK checks the Host header of MCP requests; this page is
            # served before it, so check here, against DNS rebinding.
            refusal = 421, "not addressed to an allowed host", "misdirected request", ()
        if refusal is None and scope["method"] != "GET":
            refusal = (
                405,
                "method not allowed",
                "method not allowed",
                (("allow", "GET"),),
            )
        if refusal:
            status, reason, text, extra = refusal
            event.fail("refused", reason)
            event.status = status
            await http_reply(send, status, text, extra=extra)
            return False
        private = (("cache-control", "no-store"), ("x-content-type-options", "nosniff"))
        if scope["path"] == LOGS_PATH:
            await http_reply(
                send,
                200,
                LOGS_PAGE,
                "text/html; charset=utf-8",
                (*private, ("content-security-policy", LOGS_CSP)),
            )
            return True
        query = parse_qs(scope.get("query_string", b"").decode("latin-1"))
        try:
            after = int(query.get("after", ["0"])[0])
        except ValueError:
            after = 0
        if query.get("server", [""])[0] != self.log.instance:
            # Another process's cursor, as after a restart: start over.
            after = 0
        payload = {
            "server": self.log.instance,
            "version": VERSION,
            "next": self.log.seq,
            "records": self.log.since(after),
            "stats": log_stats(self.log.kept()),
        }
        await http_reply(
            send,
            200,
            json.dumps(payload, separators=(",", ":"), ensure_ascii=False),
            "application/json",
            private,
        )
        return True

    async def serve(
        self,
        scope: dict[str, Any],
        receive: Any,
        send: Any,
        headers: dict[str, str],
        event: Event,
    ) -> None:
        async def sending(message: dict[str, Any]) -> None:
            if message["type"] == "http.response.start":
                event.status = message["status"]
                if event.status >= 400 and event.outcome == "ok":
                    event.fail("refused", f"HTTP {event.status}")
            elif message["type"] == "http.response.body" and event.outcome == "ok":
                try:
                    reply = json.loads(message.get("body") or b"null")
                except ValueError:
                    reply = None
                if isinstance(reply, dict) and isinstance(reply.get("error"), dict):
                    event.fail("rpc-error", rpc_reason(reply["error"].get("code")))
            await send(message)

        refusal = self.refusal(headers, event)
        if refusal is None and scope["path"] not in self.paths:
            refusal = 404, f"not found: {log_text(scope['path'])}", "not found", ()
        if refusal is None and scope["method"] != "POST":
            # No server-initiated stream, and no sessions to delete.
            refusal = (
                405,
                "method not allowed",
                "method not allowed",
                (("allow", "POST"),),
            )
        if refusal:
            status, reason, text, extra = refusal
            event.fail("refused", reason)
            await http_reply(sending, status, text, extra=extra)
            return
        body = await self.body(receive, headers)
        if body is None:
            event.fail("refused", "request too large")
            await http_reply(sending, 413, "request too large")
            return
        if body is False:
            # Gone before the body arrived: nothing to answer.
            event.fail("error", "client disconnected")
            return
        try:
            msg = json.loads(body)
        except ValueError:
            msg = None
        if isinstance(msg, dict):
            event.method = msg.get("method")
        delivered = False

        async def replay() -> dict[str, Any]:
            nonlocal delivered
            if delivered:
                return await receive()
            delivered = True
            return {"type": "http.request", "body": body, "more_body": False}

        await self.app(scope, replay, sending)

    @staticmethod
    async def body(receive: Any, headers: dict[str, str]) -> bytes | bool | None:
        """The request body, None if it is larger than the limit, or False if
        the client disconnected before sending all of it."""
        try:
            length = int(headers.get("content-length") or 0)
        except ValueError:
            length = -1
        if length < 0 or length > MAX_REQUEST_BYTES:
            return None
        body = b""
        more = True
        while more:
            message = await receive()
            if message["type"] == "http.disconnect":
                return False
            body += message.get("body", b"")
            if len(body) > MAX_REQUEST_BYTES:
                return None
            more = message.get("more_body", False)
        return body


# --- End of request log --------------------------------------------------------


def default_log() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "pinboard" / "mcp.jsonl"


def search_hash(args: dict[str, Any]) -> str | None:
    text = json.dumps(
        [args.get("query") or "", args.get("tags") or []], ensure_ascii=False
    )
    if text == '["", []]':
        return None
    return hashlib.sha256(text.encode()).hexdigest()[:16]


# --- Tools -------------------------------------------------------------------


class ToolError(Exception):
    """A call that cannot be served, reported to the model as structured JSON."""

    def __init__(self, code: str, message: str, **extra: Any):
        super().__init__(message)
        self.code = code
        self.extra = extra

    def payload(self) -> dict[str, Any]:
        return {"error": self.code, "message": pb.redact(str(self)), **self.extra}


def as_tool_error(e: Exception) -> ToolError:
    if isinstance(e, ToolError):
        return e
    if isinstance(e, pb.GateError):
        return ToolError("rate_limited", str(e), retry_after=e.retry_after)
    if isinstance(e, pb.GuardError):
        return ToolError("sync_refused", str(e))
    if isinstance(e, pb.NetworkError):
        return ToolError("network", str(e))
    if isinstance(e, pb.Error):
        return ToolError("failed", str(e))
    if isinstance(e, OSError):
        return ToolError("failed", f"{type(e).__name__}: {e}")
    raise e


def view(record: dict[str, Any], full: bool) -> dict[str, Any]:
    """A mirror record as tools show it: 'private' rather than 'shared', and
    without Pinboard's hashes."""
    out = {
        "url": record["url"],
        "title": record["title"],
        "notes": record["notes"],
        "tags": record["tags"],
        "time": record["time"],
        "private": not record["shared"],
        "toread": record["toread"],
    }
    if not full and len(out["notes"]) > pb.NOTES_PREVIEW:
        out["notes"] = out["notes"][: pb.NOTES_PREVIEW] + "…"
        out["notes_truncated"] = True
    return out


def outcome_view(outcome: Any) -> dict[str, Any]:
    if outcome is None:
        return {"state": "unchanged"}
    out = {"state": outcome.state}
    if outcome.state == "unpushed":
        out["warning"] = (
            "committed in the mirror but not pushed; the next write or sync pushes it"
        )
    return out


def text_arg(args: dict[str, Any], name: str, required: bool = False) -> str | None:
    value = args.get(name)
    if value is None:
        if required:
            raise ToolError("invalid_argument", f"{name} is required")
        return None
    if not isinstance(value, str):
        raise ToolError("invalid_argument", f"{name} must be a string")
    if required and not value.strip():
        raise ToolError("invalid_argument", f"{name} must not be empty")
    return value


def bool_arg(args: dict[str, Any], name: str) -> bool | None:
    value = args.get(name)
    if value is not None and not isinstance(value, bool):
        raise ToolError("invalid_argument", f"{name} must be true or false")
    return value


def tags_arg(args: dict[str, Any], name: str) -> list[str] | None:
    value = args.get(name)
    if value is None:
        return None
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, list) or not all(isinstance(t, str) for t in value):
        raise ToolError("invalid_argument", f"{name} must be a list of tags")
    return pb.split_tags(" ".join(value))


def int_arg(args: dict[str, Any], name: str, default: int, most: int) -> int:
    value = args.get(name, default)
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise ToolError("invalid_argument", f"{name} must be a positive integer")
    return min(value, most)


def date_arg(args: dict[str, Any], name: str) -> str | None:
    value = text_arg(args, name)
    if value is None or value == "":
        return None
    if not DATE_RE.match(value):
        raise ToolError(
            "invalid_argument", f"{name} must be YYYY, YYYY-MM or YYYY-MM-DD"
        )
    return value


class Service:
    """The tools, over one mirror clone. Reads use the last commit alone, so
    they never see a sync half-written; writes and syncs hold the CLI's lock
    on the clone, as 'pinboard' itself does, so they also wait for any CLI
    command running there."""

    def __init__(self, repo_arg: str | None, log: RequestLog, sync_hours: float):
        self.repo_arg = repo_arg
        self.log = log
        self.sync_hours = sync_hours
        self.sync_lock = threading.Lock()
        self.cache_lock = threading.Lock()
        self.active = 0  # tool calls and scheduled syncs running now
        self.active_lock = threading.Lock()
        self.cache: tuple[Any, dict[str, Any]] | None = None

    def context(self) -> Any:
        # A fresh context per call: other processes change the clone and its
        # local state.
        return pb.Context(self.repo_arg)

    def records(self, ctx: Any) -> dict[str, dict[str, Any]]:
        """The bookmarks in the clone's last commit, parsed again only when
        a commit changed them."""
        repo = ctx.require_clone()
        tree = pb.committed_tree(repo)
        with self.cache_lock:
            if self.cache is not None and self.cache[0] == tree:
                return self.cache[1]
        records = pb.load_committed(repo, tree)
        with self.cache_lock:
            self.cache = (tree, records)
        return records

    @staticmethod
    def mirror(ctx: Any) -> dict[str, Any]:
        fresh = ctx.freshness()
        return {
            "synced_at": fresh["synced"],
            "pinboard_changed_at": fresh["update_time"],
        }

    # Reads: never the API.

    def search_bookmarks(self, args: dict[str, Any]) -> dict[str, Any]:
        query = text_arg(args, "query") or ""
        tags = tags_arg(args, "tags") or []
        since, until = date_arg(args, "since"), date_arg(args, "until")
        toread, private = bool_arg(args, "toread"), bool_arg(args, "private")
        limit = int_arg(args, "limit", SEARCH_LIMIT, SEARCH_MAX)
        cursor = text_arg(args, "cursor") or None

        def keep(record: dict[str, Any]) -> bool:
            stamp = record["time"]
            if since and stamp < since:
                return False
            if until and stamp[: len(until)] > until:
                return False
            if toread is not None and record["toread"] != toread:
                return False
            return private is None or record["shared"] != private

        ctx = self.context()
        try:
            page, next_cursor = pb.run_search(
                self.records(ctx), query.split(), tags, limit, cursor, keep
            )
        except pb.Error as e:
            if str(e).startswith("bad cursor"):
                raise ToolError("invalid_argument", str(e)) from None
            raise
        return {
            "bookmarks": [view(r, full=False) for r in page],
            "next_cursor": next_cursor,
            "mirror": self.mirror(ctx),
        }

    def get_bookmark(self, args: dict[str, Any]) -> dict[str, Any]:
        url = text_arg(args, "url", required=True)
        ctx = self.context()
        record = self.records(ctx).get(url)
        mirror = self.mirror(ctx)
        if record is None:
            raise ToolError(
                "not_found",
                f"{url} is not in the mirror. If it was bookmarked in Pinboard "
                "since the last sync, call sync and try again.",
                mirror=mirror,
            )
        return {"bookmark": view(record, full=True), "mirror": mirror}

    def list_tags(self, args: dict[str, Any]) -> dict[str, Any]:
        match = (text_arg(args, "match") or "").casefold()
        limit = int_arg(args, "limit", TAGS_LIMIT, TAGS_MAX)
        ctx = self.context()
        counts = [
            (t, n) for t, n in pb.tag_counts(self.records(ctx)) if match in t.casefold()
        ]
        return {
            "tags": [{"tag": t, "count": n} for t, n in counts[:limit]],
            "total_tags": len(counts),
            "mirror": self.mirror(ctx),
        }

    # Live calls and writes.

    def suggest_tags(self, args: dict[str, Any]) -> dict[str, Any]:
        url = text_arg(args, "url", required=True)
        return pb.run_suggest(self.context(), url)

    def add_bookmark(self, args: dict[str, Any]) -> dict[str, Any]:
        private = bool_arg(args, "private")
        record = {
            "url": text_arg(args, "url", required=True),
            "title": text_arg(args, "title", required=True),
            "notes": text_arg(args, "notes") or "",
            "tags": tags_arg(args, "tags") or [],
            "time": "",
            "shared": private is False,
            "toread": bool(bool_arg(args, "toread")),
        }
        ctx = self.context()
        live, created, outcome = pb.run_add(ctx, record)
        out: dict[str, Any] = {"bookmark": view(live, full=True), "created": created}
        if not created:
            out["message"] = (
                "Pinboard already has this URL, so it was left unchanged; "
                "use update_bookmark to change it."
            )
        out["mirror_commit"] = outcome_view(outcome)
        out["mirror"] = self.mirror(ctx)
        return out

    def update_bookmark(self, args: dict[str, Any]) -> dict[str, Any]:
        url = text_arg(args, "url", required=True)
        tags = tags_arg(args, "tags")
        private = bool_arg(args, "private")
        edits = argparse.Namespace(
            title=text_arg(args, "title"),
            notes=text_arg(args, "notes"),
            tags=None if tags is None else [" ".join(tags)],
            add_tag=tags_arg(args, "add_tags"),
            remove_tag=tags_arg(args, "remove_tags"),
            shared=None if private is None else not private,
            toread=bool_arg(args, "toread"),
        )
        ctx = self.context()
        before, after, outcome = pb.run_update(
            ctx, url, lambda current: pb.apply_edits(current, edits)
        )
        return {
            "bookmark": view(after, full=True),
            "changed": not pb.same_content(before, after),
            "mirror_commit": outcome_view(outcome),
            "mirror": self.mirror(ctx),
        }

    def sync(self, args: dict[str, Any]) -> dict[str, Any]:
        if not self.sync_lock.acquire(blocking=False):
            raise ToolError(
                "sync_running",
                "a sync is already running; its result will be in the mirror shortly",
            )
        try:
            ctx = self.context()
            report = pb.run_sync(ctx)
        finally:
            self.sync_lock.release()
        return {
            "pinboard_changed": not report.skipped,
            "added": len(report.added),
            "updated": len(report.changed),
            "deleted": len(report.deleted),
            "total": report.total,
            "mirror_commit": outcome_view(report.outcome),
            "mirror": self.mirror(ctx),
        }

    # Dispatch and logging.

    READS = ("search_bookmarks", "get_bookmark", "list_tags")
    TOOLS = (*READS, "suggest_tags", "add_bookmark", "update_bookmark", "sync")

    def call(
        self, name: str, args: dict[str, Any], event: Event
    ) -> tuple[dict[str, Any], bool]:
        """Runs tool NAME, noting on EVENT what it came to; returns its payload
        and whether it failed. Whoever made EVENT logs it."""
        event.tool = name
        event.args = log_args(args)
        url = args.get("url")
        if name in ("add_bookmark", "update_bookmark", "suggest_tags") and isinstance(
            url, str
        ):
            event.args["host"] = pb.host_of(url)
        if name == "search_bookmarks":
            digest = search_hash(args)
            if digest:
                event.args["search"] = digest
        failed = False
        with self.active_lock:
            self.active += 1
        try:
            payload = getattr(self, name)(args)
            if name == "sync":
                event.extra["result"] = (
                    f"+{payload['added']} ~{payload['updated']} -{payload['deleted']}"
                    if payload["pinboard_changed"]
                    else "unchanged"
                )
        except Exception as e:
            err = as_tool_error(e)
            payload, failed = err.payload(), True
            event.fail("refused" if err.code in REFUSALS else "tool-error", err.code)
            if "retry_after" in err.extra:
                event.extra["retry_after"] = err.extra["retry_after"]
        finally:
            with self.active_lock:
                self.active -= 1
        event.size = len(json.dumps(payload, ensure_ascii=False).encode())
        return payload, failed


# --- Scheduled syncs ---------------------------------------------------------


class Scheduler:
    """Syncs when the last sync is older than the interval: at startup, so a
    restart catches up, then at every tick. Only the HTTP server runs it.

    The thread is not a daemon: a sync holds the clone's lock and writes Git
    objects, so shutdown waits for a running one rather than cutting it off
    and leaving the clone dirty."""

    def __init__(self, svc: Service, hours: float):
        self.svc = svc
        self.every = hours * 3600
        self.stopping = threading.Event()
        self.thread = threading.Thread(target=self.run, name="sync")

    def due(self) -> bool:
        synced = self.svc.context().synced_at()
        return synced is None or time.time() - synced >= self.every

    def run(self) -> None:
        tick = min(self.every, SCHEDULER_TICK) * pb.time_scale()
        while not self.stopping.is_set():
            event = Event("background", event="sync")
            try:
                if self.due():
                    self.svc.call("sync", {}, event)
                    self.svc.log.emit(event)
            except Exception as e:
                # Not the sync, which reports its own failures: the check
                # before it, such as an unreadable clone.
                event.fail("error", log_reason(pb.redact(f"{type(e).__name__}: {e}")))
                self.svc.log.emit(event)
            self.stopping.wait(max(tick, 0.05))

    def start(self) -> None:
        log_line(f"syncing when the last sync is {self.every / 3600:g} h old")
        self.thread.start()

    def stop(self) -> None:
        """Stops the loop, waiting for a running sync to finish."""
        self.stopping.set()
        if self.thread.is_alive():
            self.thread.join()


# --- MCP server --------------------------------------------------------------


def instructions(svc: Service, scheduled: bool) -> str:
    lag = (
        f"up to {svc.sync_hours:g} hours, as the server syncs on that schedule"
        if scheduled
        else "until someone syncs it"
    )
    return (
        "This server searches and edits the user's Pinboard bookmarks.\n\n"
        "search_bookmarks, get_bookmark and list_tags read a Git mirror of "
        "the account, not Pinboard itself. Search matches words in each "
        "bookmark's title, notes, tags and URL; it does not search the text of "
        "the bookmarked pages. Bookmarks added or changed in Pinboard's own "
        f"website, apps or bookmarklet reach the mirror only by a sync, so it "
        f"can lag behind Pinboard by {lag}. Every result gives the mirror's "
        "last sync (mirror.synced_at); call sync first when the user needs "
        "something saved in the last day.\n\n"
        "add_bookmark and update_bookmark change Pinboard, then the mirror, so "
        "the next search sees them. New bookmarks are private unless private is "
        "false. update_bookmark's tags replaces every tag; use add_tags and "
        "remove_tags to change some. There is no way to delete a bookmark here."
    )


