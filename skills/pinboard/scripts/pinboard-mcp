                        "type": "boolean",
                        "description": "Only to-read (true) or read (false) bookmarks.",
                    },
                    "private": {
                        "type": "boolean",
                        "description": "Only private (true) or public (false) bookmarks.",
                    },
                    "limit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": SEARCH_MAX,
                        "default": SEARCH_LIMIT,
