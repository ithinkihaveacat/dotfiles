# Tests: skills/pinboard/tests/test-pinboard-mcp
"""The 'pinboard mcp' server, run by 'pinboard mcp' so that 'pinboard' itself
needs no third-party packages."""

from __future__ import annotations

import argparse
import asyncio
import contextlib
import contextvars
import datetime
import hashlib
import importlib.util
import json
import os
import re
import signal
import sys
import threading
import time
from dataclasses import dataclass, field
from importlib.machinery import SourceFileLoader
from pathlib import Path
from typing import Any, NoReturn


def skill_root() -> Path:
    """The directory holding this skill's SKILL.md, found by sentinel rather
    than depth so that a symlink or a move within the tree still works.
    PINBOARD_SKILL_DIR names it when the script has been copied elsewhere."""
    override = os.environ.get("PINBOARD_SKILL_DIR")
    if override:
        return Path(override).expanduser().resolve()
    for parent in Path(__file__).resolve().parents:
        if (parent / "SKILL.md").is_file():
            return parent
    sys.exit(
        "pinboard mcp: cannot find SKILL.md above this script; set PINBOARD_SKILL_DIR"
    )


def load_cli() -> Any:
    """The pinboard CLI as a module: its mirror, API client, lock and guard."""
    path = skill_root() / "scripts" / "pinboard"
    if not path.is_file():
        sys.exit(f"pinboard mcp: {path} not found; set PINBOARD_SKILL_DIR")
    loader = SourceFileLoader("pinboard_cli", str(path))
    spec = importlib.util.spec_from_loader("pinboard_cli", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules["pinboard_cli"] = module
    loader.exec_module(module)
    return module


pb = load_cli()

PROG = "pinboard mcp"
VERSION = "1"
DEFAULT_PORT = 8791
LOOPBACK = ("127.0.0.1", "localhost", "::1")
ACCESS_HEADER = "cf-access-jwt-assertion"
MCP_PATH = "/mcp"
CERTS_TTL = 3600
LOG_ENV = "PINBOARD_MCP_LOG"
# Arguments a request's record keeps: never a URL, title, notes, tags or
# search text. A write keeps its URL's host; a search, a hash of its text.
LOG_ARGS = ("limit", "since", "until", "match", "private", "toread")
LOG_HASHED: tuple[str, ...] = ()
DEFAULT_SYNC_HOURS = 24.0
# The scheduler checks whether a sync is due this often (or at every
# interval, if that is shorter), so a refused or failed run waits this long.
SCHEDULER_TICK = 3600.0
SEARCH_LIMIT = 20
SEARCH_MAX = 100
TAGS_LIMIT = 100
TAGS_MAX = 2000
DATE_RE = re.compile(r"^\d{4}(-\d{2}(-\d{2})?)?$")
# Error codes that mean "not now" rather than "failed".
REFUSALS = ("rate_limited", "sync_running", "sync_refused")


def die(msg: str, code: int = 1) -> NoReturn:
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(code)


def log_line(msg: str) -> None:
    print(pb.redact(f"{PROG}: {msg}"), file=sys.stderr, flush=True)


# --- Request log ---------------------------------------------------------------
# The request log writer of this repository's MCP servers. skill-mcp and
# pinboard-mcp carry this block; taskgo and andon write the same records with
# code of their own. `mcp logs` reads them all, and its format reference
# (skills/agent-config/references/mcp-logs.md) is the specification; each
# server's tests check its records against it. Each file defines PROG, VERSION,
# LOG_ARGS and LOG_HASHED outside the block.
#
# One JSON line per message, and per job the server starts itself, in --log,
# else <TOOL>_MCP_LOG, else $XDG_STATE_HOME/<tool>/mcp.jsonl; rotated at 8 MiB
# to FILE.1 (newest) to FILE.4, each append under flock. Fields, any of them
# left out when empty:
#   ts         UTC, ISO 8601 with milliseconds and Z
#   transport  stdio, http, or background (a job the server started)
#   event      a background job's name, such as sync
#   http       the HTTP method
#   method     the JSON-RPC method
#   tool, args the tool, and its allowlisted arguments as short strings
#   outcome    ok; tool-error (isError); rpc-error (a JSON-RPC error);
#              refused (declined before it ran: auth, method, rate limit);
#              error (no answer could be given)
#   status, ms, bytes   HTTP status, duration, size of a tool's result
#   reason     why it was not ok: a short phrase, never quoting input
#   agent      the client's User-Agent
#   caller     10 hex digits of SHA-256 over the Access token's identifying
#              claims, or over stdio, the pid and start time
#   commit     a Git commit the call made or read
#   version    the server's
# plus a tool's own fields (pinboard: result, retry_after; skill: scope). Over
# HTTP, GET /up is open and unlogged and reports version and source commit.

LOG_ROTATE_BYTES = 8 * 1024 * 1024
LOG_ROTATED = 4  # FILE.1 (newest) to FILE.4
MAX_REQUEST_BYTES = 1024 * 1024
CALLER_CLAIMS = ("sub", "email", "client_id", "azp")
LOG_QUOTED = re.compile(r"'(?:[^'\\]|\\.)*'|\"(?:[^\"\\]|\\.)*\"")
RPC_ERRORS = {
    -32700: "parse error",
    -32600: "invalid request",
    -32601: "method not found",
    -32602: "invalid params",
    -32603: "internal error",
}


def log_text(value: Any, limit: int = 80) -> str | None:
    if value is None:
        return None
    text = str(value)
    return text if len(text) <= limit else text[: limit - 1] + "…"


def log_value(value: Any) -> str:
    """VALUE for a stderr line: bare if a plain token, else quoted as JSON, so
    client text can neither break nor forge a line."""
    text = str(value)
    plain = re.fullmatch(r"[\w./:@+-]+", text, re.ASCII)
    return text if plain else json.dumps(text, ensure_ascii=False)


def log_reason(message: str) -> str:
    """An error's first line, with quoted values elided: they can quote content."""
    return LOG_QUOTED.sub("'…'", str(message).split("\n", 1)[0])


def caller_key(*parts: Any) -> str:
    joined = "\0".join("" if p is None else str(p) for p in parts)
    return hashlib.sha256(joined.encode()).hexdigest()[:10]


def log_args(args: dict[str, Any]) -> dict[str, str]:
    """The LOG_ARGS in ARGS, shortened, and the LOG_HASHED as hashes; no others."""
    out: dict[str, str] = {}
    for k, v in args.items():
        if k in LOG_ARGS and isinstance(v, (str, int, float, bool, list)):
            v = " ".join(str(x) for x in v) if isinstance(v, list) else v
            out[k] = log_text(" ".join(str(v).split()), 60) or ""
        elif k in LOG_HASHED and v not in (None, "", []):
            text = json.dumps(v, ensure_ascii=False, sort_keys=True)
            out[k] = "#" + hashlib.sha256(text.encode()).hexdigest()[:12]
    return out


@dataclass
class Event:
    """What one request, or one job the server started, came to: never its
    content. EXTRA holds the tool's own fields."""

    transport: str
    started: float = field(default_factory=time.monotonic)
    at: float = field(default_factory=time.time)
    event: str | None = None
    http: str | None = None
    method: Any = None
    tool: Any = None
    args: dict[str, str] | None = None
    outcome: str = "ok"
    status: int | None = None
    size: int | None = None
    reason: str | None = None
    agent: str | None = None
    caller: str | None = None
    commit: str | None = None
    extra: dict[str, Any] = field(default_factory=dict)

    def fail(self, outcome: str, reason: str) -> None:
        self.outcome, self.reason = outcome, reason

    def record(self) -> dict[str, Any]:
        stamp = datetime.datetime.fromtimestamp(self.at, datetime.UTC)
        rec = {
            "ts": stamp.isoformat(timespec="milliseconds").replace("+00:00", "Z"),
            "transport": self.transport,
            "event": self.event,
            "http": self.http,
            "method": log_text(self.method),
            "tool": log_text(self.tool),
            "args": self.args or None,
            "outcome": self.outcome,
            "status": self.status,
            "ms": int((time.monotonic() - self.started) * 1000),
            "bytes": self.size,
            "reason": log_text(self.reason, 200),
            "agent": log_text(self.agent),
            "caller": self.caller,
            "commit": self.commit,
            **self.extra,
            "version": VERSION,
        }
        return {k: v for k, v in rec.items() if v is not None}


# The request being served: set by the HTTP gate, or by the middleware.
EVENT: contextvars.ContextVar[Event | None] = contextvars.ContextVar(
    "EVENT", default=None
)


class RequestLog:
    """Each record goes to stderr and the log file. Logging never fails a
    request: a record the file cannot take is dropped there, with one
    warning. Servers may share the file; each append and rotation holds an
    exclusive lock on it."""

    def __init__(self, path: Path | None):
        self.path = path
        self.warned = False
        self.lock = threading.Lock()

    def emit(self, event: Event) -> None:
        rec = event.record()
        line = " ".join(
            f"{k}={log_value(v)}"
            for k, v in rec.items()
            if k not in ("ts", "args", "version")
        )
        print(f"{PROG}: request {line}", file=sys.stderr, flush=True)
        if self.path is None:
            return
        with self.lock:
            try:
                self.append(json.dumps(rec, ensure_ascii=False) + "\n")
            except OSError as e:
                if not self.warned:
                    self.warned = True
                    print(
                        f"{PROG}: cannot use the request log {self.path}: {e}",
                        file=sys.stderr,
                    )

    def append(self, line: str) -> None:
        import fcntl

        assert self.path is not None
        self.path.parent.mkdir(parents=True, exist_ok=True)
        # Another server may rotate the file between the open and the lock;
        # then the lock is on a rotated file, so open the new one.
        for _ in range(3):
            with open(self.path, "a", encoding="utf-8") as fh:
                fcntl.flock(fh, fcntl.LOCK_EX)
                st = os.fstat(fh.fileno())
                try:
                    current = os.stat(self.path).st_ino == st.st_ino
                except FileNotFoundError:
                    current = False  # rotated, and not yet made again
                if not current:
                    continue
                if st.st_size and st.st_size + len(line) > LOG_ROTATE_BYTES:
                    for i in range(LOG_ROTATED - 1, 0, -1):
                        if Path(f"{self.path}.{i}").exists():
                            os.replace(f"{self.path}.{i}", f"{self.path}.{i + 1}")
                    os.replace(self.path, f"{self.path}.1")
                    with open(self.path, "a", encoding="utf-8") as fresh:
                        fcntl.flock(fresh, fcntl.LOCK_EX)
                        fresh.write(line)
                else:
                    fh.write(line)
                return
        raise OSError(f"{self.path} kept being rotated")


def source_commit() -> str | None:
    """The commit this script was checked out at, if it runs from Git."""
    import subprocess

    with contextlib.suppress(OSError, subprocess.TimeoutExpired):
        here = str(Path(__file__).resolve().parent)
        proc = subprocess.run(
            ["git", "-C", here, "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        return proc.stdout.strip()[:12] if proc.returncode == 0 else None
    return None


def request_logging(log: RequestLog) -> Any:
    """SDK middleware for every message: over HTTP it fills in the gate's
    event, which the gate logs; over stdio it makes and logs its own."""
    from mcp.shared.exceptions import MCPError
    from pydantic import ValidationError

    stdio_caller = caller_key("stdio", os.getpid(), time.time())

    async def logged(ctx: Any, call_next: Any) -> Any:
        event = EVENT.get()
        own = event is None
        if own:
            event = Event("stdio", caller=stdio_caller)
        event.method = ctx.method
        token = EVENT.set(event)
        try:
            return await call_next(ctx)
        except MCPError as e:
            event.fail("rpc-error", RPC_ERRORS.get(e.code, f"error {e.code}"))
            raise
        except ValidationError:
            # The SDK reports malformed params as a pydantic ValidationError.
            event.fail("rpc-error", RPC_ERRORS[-32602])
            raise
        except Exception:
            # Anything else is the server's fault, not the request's.
            event.fail("rpc-error", RPC_ERRORS[-32603])
            raise
        finally:
            EVENT.reset(token)
            if own:
                log.emit(event)

    return logged


async def http_reply(
    send: Any,
    status: int,
    text: str,
    ctype: str = "text/plain",
    extra: Any = (),
    head: bool = False,
) -> None:
    """Replies with TEXT, or for a HEAD request (HEAD) only its headers."""
    data = text.encode()
    headers = [(b"content-type", f"{ctype}; charset=utf-8".encode())]
    headers += [(b"content-length", str(len(data)).encode())]
    headers += [(k.encode(), v.encode()) for k, v in extra]
    await send({"type": "http.response.start", "status": status, "headers": headers})
    await send({"type": "http.response.body", "body": b"" if head else data})


class LoggingGate:
    """ASGI, in front of the SDK's app: the health check, the Access check,
    and one record for each request, refusals included."""

    def __init__(self, app: Any, verifier: Any, log: RequestLog):
        self.app, self.verifier, self.log = app, verifier, log
        health = {"status": "ok", "version": VERSION, "commit": source_commit()}
        self.health = json.dumps(health)

    async def __call__(self, scope: dict[str, Any], receive: Any, send: Any) -> None:
        if scope["type"] != "http":  # lifespan
            await self.app(scope, receive, send)
            return
        headers = {
            k.decode("latin-1").lower(): v.decode("latin-1")
            for k, v in scope["headers"]
        }
        path, method = scope["path"], scope["method"]
        if path == "/up" and method in ("GET", "HEAD"):
            # Polled by the proxy, so open to all, and not logged.
            await http_reply(
                send, 200, self.health, "application/json", head=method == "HEAD"
            )
            return
        event = Event("http", http=method, agent=headers.get("user-agent"))
        token = EVENT.set(event)
        refusal = self.refusal(headers, event)
        if refusal is None and method != "POST":
            # No server-initiated stream (GET), and no sessions to delete.
            refusal = 405, "method not allowed", ()

        async def sending(message: dict[str, Any]) -> None:
            if message["type"] == "http.response.start":
                event.status = message["status"]
                if event.status >= 400 and event.outcome == "ok":
                    # The SDK answers a message it cannot parse with a
                    # JSON-RPC error and 400; other statuses are refusals.
                    bad = event.status == 400
                    event.fail(
                        "rpc-error" if bad else "refused", f"HTTP {event.status}"
                    )
            await send(message)

        try:
            if refusal:
                event.fail("refused", refusal[1])
                await http_reply(sending, refusal[0], refusal[1], extra=refusal[2])
            else:
                await self.app(scope, receive, sending)
        except BaseException as e:
            event.fail("error", type(e).__name__)
            raise
        finally:
            EVENT.reset(token)
            self.log.emit(event)

    def refusal(self, headers: dict[str, str], event: Event) -> tuple | None:
        """(status, reason, headers) if the request may not proceed. A token
        gives the request its caller key, from its claims."""
        if self.verifier is None:
            # Loopback only; the SDK checks the Host header against rebinding.
            return None
        token = headers.get("cf-access-jwt-assertion")
        if not token:
            bearer = (("www-authenticate", "Bearer"),)
            return 401, "Cloudflare Access token required", bearer
        try:
            claims = self.verifier.verify(token)
        except AccessError as e:
            return 403, str(e), ()
        event.caller = caller_key(*(claims.get(k) for k in CALLER_CLAIMS))
        return None


# --- End of request log --------------------------------------------------------


def default_log() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "pinboard" / "mcp.jsonl"


def search_hash(args: dict[str, Any]) -> str | None:
    text = json.dumps(
        [args.get("query") or "", args.get("tags") or []], ensure_ascii=False
    )
    if text == '["", []]':
        return None
    return hashlib.sha256(text.encode()).hexdigest()[:16]


# --- Tools -------------------------------------------------------------------


class ToolError(Exception):
    """A call that cannot be served, reported to the model as structured JSON."""

    def __init__(self, code: str, message: str, **extra: Any):
        super().__init__(message)
        self.code = code
        self.extra = extra

    def payload(self) -> dict[str, Any]:
        return {"error": self.code, "message": pb.redact(str(self)), **self.extra}


def as_tool_error(e: Exception) -> ToolError:
    if isinstance(e, ToolError):
        return e
    if isinstance(e, pb.GateError):
        return ToolError("rate_limited", str(e), retry_after=e.retry_after)
    if isinstance(e, pb.GuardError):
        return ToolError("sync_refused", str(e))
    if isinstance(e, pb.NetworkError):
        return ToolError("network", str(e))
    if isinstance(e, pb.Error):
        return ToolError("failed", str(e))
    if isinstance(e, OSError):
        return ToolError("failed", f"{type(e).__name__}: {e}")
    raise e


def view(record: dict[str, Any], full: bool) -> dict[str, Any]:
    """A mirror record as tools show it: 'private' rather than 'shared', and
    without Pinboard's hashes."""
    out = {
        "url": record["url"],
        "title": record["title"],
        "notes": record["notes"],
        "tags": record["tags"],
        "time": record["time"],
        "private": not record["shared"],
        "toread": record["toread"],
    }
    if not full and len(out["notes"]) > pb.NOTES_PREVIEW:
        out["notes"] = out["notes"][: pb.NOTES_PREVIEW] + "…"
        out["notes_truncated"] = True
    return out


def outcome_view(outcome: Any) -> dict[str, Any]:
    if outcome is None:
        return {"state": "unchanged"}
    out = {"state": outcome.state}
    if outcome.state == "unpushed":
        out["warning"] = (
            "committed in the mirror but not pushed; the next write or sync pushes it"
        )
    return out


def text_arg(args: dict[str, Any], name: str, required: bool = False) -> str | None:
    value = args.get(name)
    if value is None:
        if required:
            raise ToolError("invalid_argument", f"{name} is required")
        return None
    if not isinstance(value, str):
        raise ToolError("invalid_argument", f"{name} must be a string")
    if required and not value.strip():
        raise ToolError("invalid_argument", f"{name} must not be empty")
    return value


def bool_arg(args: dict[str, Any], name: str) -> bool | None:
    value = args.get(name)
    if value is not None and not isinstance(value, bool):
        raise ToolError("invalid_argument", f"{name} must be true or false")
    return value


def tags_arg(args: dict[str, Any], name: str) -> list[str] | None:
    value = args.get(name)
    if value is None:
        return None
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, list) or not all(isinstance(t, str) for t in value):
        raise ToolError("invalid_argument", f"{name} must be a list of tags")
    return pb.split_tags(" ".join(value))


def int_arg(args: dict[str, Any], name: str, default: int, most: int) -> int:
    value = args.get(name, default)
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise ToolError("invalid_argument", f"{name} must be a positive integer")
    return min(value, most)


def date_arg(args: dict[str, Any], name: str) -> str | None:
    value = text_arg(args, name)
    if value is None or value == "":
        return None
    if not DATE_RE.match(value):
        raise ToolError(
            "invalid_argument", f"{name} must be YYYY, YYYY-MM or YYYY-MM-DD"
        )
    return value


class Service:
    """The tools, over one mirror clone. Reads use the last commit alone, so
    they never see a sync half-written; writes and syncs hold the CLI's lock
    on the clone, as 'pinboard' itself does, so they also wait for any CLI
    command running there."""

    def __init__(self, repo_arg: str | None, log: RequestLog, sync_hours: float):
        self.repo_arg = repo_arg
        self.log = log
        self.sync_hours = sync_hours
        self.sync_lock = threading.Lock()
        self.cache_lock = threading.Lock()
        self.active = 0  # tool calls and scheduled syncs running now
        self.active_lock = threading.Lock()
        self.cache: tuple[Any, dict[str, Any]] | None = None

    def context(self) -> Any:
        # A fresh context per call: other processes change the clone and its
        # local state.
        return pb.Context(self.repo_arg)

    def records(self, ctx: Any) -> dict[str, dict[str, Any]]:
        """The bookmarks in the clone's last commit, parsed again only when
        a commit changed them."""
        repo = ctx.require_clone()
        tree = pb.committed_tree(repo)
        with self.cache_lock:
            if self.cache is not None and self.cache[0] == tree:
                return self.cache[1]
        records = pb.load_committed(repo, tree)
        with self.cache_lock:
            self.cache = (tree, records)
        return records

    @staticmethod
    def mirror(ctx: Any) -> dict[str, Any]:
        fresh = ctx.freshness()
        return {
            "synced_at": fresh["synced"],
            "pinboard_changed_at": fresh["update_time"],
        }

    # Reads: never the API.

    def search_bookmarks(self, args: dict[str, Any]) -> dict[str, Any]:
        query = text_arg(args, "query") or ""
        tags = tags_arg(args, "tags") or []
        since, until = date_arg(args, "since"), date_arg(args, "until")
        toread, private = bool_arg(args, "toread"), bool_arg(args, "private")
        limit = int_arg(args, "limit", SEARCH_LIMIT, SEARCH_MAX)
        cursor = text_arg(args, "cursor") or None

        def keep(record: dict[str, Any]) -> bool:
            stamp = record["time"]
            if since and stamp < since:
                return False
            if until and stamp[: len(until)] > until:
                return False
            if toread is not None and record["toread"] != toread:
                return False
            return private is None or record["shared"] != private

        ctx = self.context()
        try:
            page, next_cursor = pb.run_search(
                self.records(ctx), query.split(), tags, limit, cursor, keep
            )
        except pb.Error as e:
            if str(e).startswith("bad cursor"):
                raise ToolError("invalid_argument", str(e)) from None
            raise
        return {
            "bookmarks": [view(r, full=False) for r in page],
            "next_cursor": next_cursor,
            "mirror": self.mirror(ctx),
        }

    def get_bookmark(self, args: dict[str, Any]) -> dict[str, Any]:
        url = text_arg(args, "url", required=True)
        ctx = self.context()
        record = self.records(ctx).get(url)
        mirror = self.mirror(ctx)
        if record is None:
            raise ToolError(
                "not_found",
                f"{url} is not in the mirror. If it was bookmarked in Pinboard "
                "since the last sync, call sync and try again.",
                mirror=mirror,
            )
        return {"bookmark": view(record, full=True), "mirror": mirror}

    def list_tags(self, args: dict[str, Any]) -> dict[str, Any]:
        match = (text_arg(args, "match") or "").casefold()
        limit = int_arg(args, "limit", TAGS_LIMIT, TAGS_MAX)
        ctx = self.context()
        counts = [
            (t, n) for t, n in pb.tag_counts(self.records(ctx)) if match in t.casefold()
        ]
        return {
            "tags": [{"tag": t, "count": n} for t, n in counts[:limit]],
            "total_tags": len(counts),
            "mirror": self.mirror(ctx),
        }

    # Live calls and writes.

    def suggest_tags(self, args: dict[str, Any]) -> dict[str, Any]:
        url = text_arg(args, "url", required=True)
        return pb.run_suggest(self.context(), url)

    def add_bookmark(self, args: dict[str, Any]) -> dict[str, Any]:
        private = bool_arg(args, "private")
        record = {
            "url": text_arg(args, "url", required=True),
            "title": text_arg(args, "title", required=True),
            "notes": text_arg(args, "notes") or "",
            "tags": tags_arg(args, "tags") or [],
            "time": "",
            "shared": private is False,
            "toread": bool(bool_arg(args, "toread")),
        }
        ctx = self.context()
        live, created, outcome = pb.run_add(ctx, record)
        out: dict[str, Any] = {"bookmark": view(live, full=True), "created": created}
        if not created:
            out["message"] = (
                "Pinboard already has this URL, so it was left unchanged; "
                "use update_bookmark to change it."
            )
        out["mirror_commit"] = outcome_view(outcome)
        out["mirror"] = self.mirror(ctx)
        return out

    def update_bookmark(self, args: dict[str, Any]) -> dict[str, Any]:
        url = text_arg(args, "url", required=True)
        tags = tags_arg(args, "tags")
        private = bool_arg(args, "private")
        edits = argparse.Namespace(
            title=text_arg(args, "title"),
            notes=text_arg(args, "notes"),
            tags=None if tags is None else [" ".join(tags)],
            add_tag=tags_arg(args, "add_tags"),
            remove_tag=tags_arg(args, "remove_tags"),
            shared=None if private is None else not private,
            toread=bool_arg(args, "toread"),
        )
        ctx = self.context()
        before, after, outcome = pb.run_update(
            ctx, url, lambda current: pb.apply_edits(current, edits)
        )
        return {
            "bookmark": view(after, full=True),
            "changed": not pb.same_content(before, after),
            "mirror_commit": outcome_view(outcome),
            "mirror": self.mirror(ctx),
        }

    def sync(self, args: dict[str, Any]) -> dict[str, Any]:
        if not self.sync_lock.acquire(blocking=False):
            raise ToolError(
                "sync_running",
                "a sync is already running; its result will be in the mirror shortly",
            )
        try:
            ctx = self.context()
            report = pb.run_sync(ctx)
        finally:
            self.sync_lock.release()
        return {
            "pinboard_changed": not report.skipped,
            "added": len(report.added),
            "updated": len(report.changed),
            "deleted": len(report.deleted),
            "total": report.total,
            "mirror_commit": outcome_view(report.outcome),
            "mirror": self.mirror(ctx),
        }

    # Dispatch and logging.

    READS = ("search_bookmarks", "get_bookmark", "list_tags")
    TOOLS = (*READS, "suggest_tags", "add_bookmark", "update_bookmark", "sync")

    def call(
        self, name: str, args: dict[str, Any], event: Event
    ) -> tuple[dict[str, Any], bool]:
        """Runs tool NAME, noting on EVENT what it came to; returns its payload
        and whether it failed. Whoever made EVENT logs it."""
        event.tool = name
        event.args = log_args(args)
        url = args.get("url")
        if name in ("add_bookmark", "update_bookmark", "suggest_tags") and isinstance(
            url, str
        ):
            event.args["host"] = pb.host_of(url)
        if name == "search_bookmarks":
            digest = search_hash(args)
            if digest:
                event.args["search"] = digest
        failed = False
        with self.active_lock:
            self.active += 1
        try:
            payload = getattr(self, name)(args)
            if name == "sync":
                event.extra["result"] = (
                    f"+{payload['added']} ~{payload['updated']} -{payload['deleted']}"
                    if payload["pinboard_changed"]
                    else "unchanged"
                )
        except Exception as e:
            err = as_tool_error(e)
            payload, failed = err.payload(), True
            event.fail("refused" if err.code in REFUSALS else "tool-error", err.code)
            if "retry_after" in err.extra:
                event.extra["retry_after"] = err.extra["retry_after"]
        finally:
            with self.active_lock:
                self.active -= 1
        event.size = len(json.dumps(payload, ensure_ascii=False).encode())
        return payload, failed


# --- Scheduled syncs ---------------------------------------------------------


class Scheduler:
    """Syncs when the last sync is older than the interval: at startup, so a
    restart catches up, then at every tick. Only the HTTP server runs it.

    The thread is not a daemon: a sync holds the clone's lock and writes Git
    objects, so shutdown waits for a running one rather than cutting it off
    and leaving the clone dirty."""

    def __init__(self, svc: Service, hours: float):
        self.svc = svc
        self.every = hours * 3600
        self.stopping = threading.Event()
        self.thread = threading.Thread(target=self.run, name="sync")

    def due(self) -> bool:
        synced = self.svc.context().synced_at()
        return synced is None or time.time() - synced >= self.every

    def run(self) -> None:
        tick = min(self.every, SCHEDULER_TICK) * pb.time_scale()
        while not self.stopping.is_set():
            event = Event("background", event="sync")
            try:
                if self.due():
                    self.svc.call("sync", {}, event)
                    self.svc.log.emit(event)
            except Exception as e:
                # Not the sync, which reports its own failures: the check
                # before it, such as an unreadable clone.
                event.fail("error", log_reason(pb.redact(f"{type(e).__name__}: {e}")))
                self.svc.log.emit(event)
            self.stopping.wait(max(tick, 0.05))

    def start(self) -> None:
        log_line(f"syncing when the last sync is {self.every / 3600:g} h old")
        self.thread.start()

    def stop(self) -> None:
        """Stops the loop, waiting for a running sync to finish."""
        self.stopping.set()
        if self.thread.is_alive():
            self.thread.join()


# --- MCP server --------------------------------------------------------------


def instructions(svc: Service, scheduled: bool) -> str:
    lag = (
        f"up to {svc.sync_hours:g} hours, as the server syncs on that schedule"
        if scheduled
        else "until someone syncs it"
    )
    return (
        "This server searches and edits the user's Pinboard bookmarks.\n\n"
        "search_bookmarks, get_bookmark and list_tags read a Git mirror of "
        "the account, not Pinboard itself. Search matches words in each "
        "bookmark's title, notes, tags and URL; it does not search the text of "
        "the bookmarked pages. Bookmarks added or changed in Pinboard's own "
        f"website, apps or bookmarklet reach the mirror only by a sync, so it "
        f"can lag behind Pinboard by {lag}. Every result gives the mirror's "
        "last sync (mirror.synced_at); call sync first when the user needs "
        "something saved in the last day.\n\n"
        "add_bookmark and update_bookmark change Pinboard, then the mirror, so "
        "the next search sees them. New bookmarks are private unless private is "
        "false. update_bookmark's tags replaces every tag; use add_tags and "
        "remove_tags to change some. There is no way to delete a bookmark here."
    )


