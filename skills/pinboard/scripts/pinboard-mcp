#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "PyJWT==2.15.1",
#     "anyio==4.15.1",
#     "cffi==2.1.1",
#     "cryptography==50.0.2",
#     "mcp==2.3.0",
