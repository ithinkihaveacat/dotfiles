    # Helpers.

    def git(self, *args: str) -> str:
        proc = subprocess.run(
            ["git", *args], capture_output=True, text=True, env=self.env, check=True
        )
        return proc.stdout.strip()

    def pb(self, *args: str, env: dict | None = None) -> subprocess.CompletedProcess:
        proc = subprocess.run(
            [str(BIN), *args],
            capture_output=True,
            text=True,
            env={**self.env, **(env or {})},
            stdin=subprocess.DEVNULL,
            timeout=120,
            check=False,
        )
        if args[0] == "sync" and proc.returncode:
            self.fail(f"pinboard sync failed: {proc.stderr}")
        return proc

    def calls(self) -> int:
        with FAKE.lock:
            return len(FAKE.calls)

    def records(self) -> list[dict[str, Any]]:
        if not self.log.exists():
            return []
        return [json.loads(line) for line in self.log.read_text().splitlines()]

    def make_stale(self) -> None:
        """The mirror as it is after the server was down for three days."""
        local = self.clone / ".git" / "pinboard" / "local.json"
        data = json.loads(local.read_text())
        data["last_sync"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(STALE))
        local.write_text(json.dumps(data))

    async def tool(self, client: ClientSession, name: str, args=None, error=False):
        result = await client.call_tool(name, args or {})
        self.assertEqual(result.is_error, error, result.content)
        data = json.loads(result.content[0].text)
        self.assertEqual(result.structured_content, data)
        return data

    @contextlib.asynccontextmanager
    async def http_server(self, *args: str, env: dict | None = None):
        port = free_port()
        errlog = self.tmp / f"server-{port}.log"
        with errlog.open("w") as err:
            proc = await asyncio.create_subprocess_exec(
                str(BIN),
                "mcp",
                "--http",
                "--port",
                str(port),
                *args,
                env={**self.env, **(env or {})},
                stderr=err,
            )
        base = f"http://127.0.0.1:{port}"
        try:
            async with httpx2.AsyncClient() as http:
                for _ in range(300):
                    if proc.returncode is not None:
                        self.fail(f"server exited: {errlog.read_text()}")
                    try:
                        await http.get(base + "/up")
                        break
                    except httpx2.TransportError:
                        await asyncio.sleep(0.1)
                else:
                    self.fail(f"server not listening on {base}")
            yield base
        finally:
            if proc.returncode is None:
                proc.terminate()
                await proc.wait()

    async def run_test(self, method) -> None:
        self.setUp()
        try:
            if "client" in inspect.signature(method).parameters:
                async with contextlib.AsyncExitStack() as stack:
                    errlog = stack.enter_context(tempfile.TemporaryFile(mode="w+"))  # noqa: SIM115 -- ExitStack owns cleanup
                    streams = await stack.enter_async_context(
                        stdio_client(
                            StdioServerParameters(
                                command=str(BIN), args=["mcp"], env=self.env
                            ),
                            errlog=errlog,
                        )
                    )
                    client = await stack.enter_async_context(
                        ClientSession(*streams, read_timeout_seconds=60)
                    )
                    await client.initialize()
                    await method(client)
            else:
                result = method()
                if inspect.isawaitable(result):
                    await result
        finally:
            self.tearDown()

