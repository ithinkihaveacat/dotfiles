    async def test_reads_make_no_api_call(self, client):
        before = self.calls()
        found = await self.tool(client, "search_bookmarks", {"query": "async rust"})
        self.assertEqual(
            [b["url"] for b in found["bookmarks"]], ["https://example.com/rust"]
        )
        rust = found["bookmarks"][0]
        self.assertTrue(rust["notes_truncated"])
        self.assertTrue(rust["private"])
        self.assertNotIn("shared", rust)
        self.assertEqual(found["mirror"]["synced_at"][:4], time.strftime("%Y"))
        self.assertTrue(found["mirror"]["pinboard_changed_at"])

        def urls(result):
            return [b["url"].rsplit("/", 1)[1] for b in result["bookmarks"]]

        found = await self.tool(client, "search_bookmarks", {"tags": ["programming"]})
        self.assertEqual(urls(found), ["kotlin", "rust"])
        found = await self.tool(client, "search_bookmarks", {"since": "2025"})
        self.assertEqual(urls(found), ["lemon", "kotlin"])
        found = await self.tool(
            client, "search_bookmarks", {"since": "2024-05", "until": "2025-02-01"}
        )
        self.assertEqual(urls(found), ["kotlin", "rust"])
        found = await self.tool(client, "search_bookmarks", {"toread": True})
        self.assertEqual(urls(found), ["kotlin"])
        found = await self.tool(client, "search_bookmarks", {"private": False})
        self.assertEqual(urls(found), ["lemon"])
        page = await self.tool(client, "search_bookmarks", {"limit": 2})
        self.assertEqual(urls(page), ["lemon", "kotlin"])
        page = await self.tool(
            client, "search_bookmarks", {"limit": 2, "cursor": page["next_cursor"]}
        )
        self.assertEqual((urls(page), page["next_cursor"]), (["rust"], None))
        bad = await self.tool(
            client, "search_bookmarks", {"since": "last week"}, error=True
        )
        self.assertEqual(bad["error"], "invalid_argument")

        got = await self.tool(
            client, "get_bookmark", {"url": "https://example.com/rust"}
        )
        self.assertEqual(len(got["bookmark"]["notes"]), len("Notes on async. " * 30))
        self.assertIn("mirror", got)
        got = await self.tool(
            client, "get_bookmark", {"url": "https://example.com/no"}, error=True
        )
        self.assertEqual(got["error"], "not_found")
        self.assertIn("synced_at", got["mirror"])
        tags = await self.tool(client, "list_tags", {"match": "PROG"})
        self.assertEqual(tags["tags"], [{"tag": "programming", "count": 2}])
        self.assertIn("synced_at", tags["mirror"])
        self.assertEqual(self.calls(), before, "a read called the Pinboard API")

    async def test_reads_ignore_a_sync_in_progress(self, client):
        """Reads see the last commit, never a sync's files half-written."""
        files = sorted((self.clone / "bookmarks").glob("*.jsonl"))
        self.assertGreater(len(files), 1)
        before = await self.tool(client, "search_bookmarks", {})
        # A bookmark caught between two year files, mid-write.
        files[0].write_text(files[0].read_text() + files[-1].read_text())
        during = await self.tool(client, "search_bookmarks", {})
        self.assertEqual(during["bookmarks"], before["bookmarks"])

    async def test_writes_show_in_next_search(self, client):
        added = await self.tool(
            client,
            "add_bookmark",
            {
                "url": "https://example.org/new?a=1&b=2",
                "title": "Secret title",
                "notes": "Secret notes",
                "tags": ["web", "later"],
            },
        )
        self.assertTrue(added["created"])
        self.assertTrue(added["bookmark"]["private"])
        self.assertEqual(added["mirror_commit"]["state"], "pushed")
        with FAKE.lock:
            self.assertEqual(
                FAKE.posts["https://example.org/new?a=1&b=2"]["shared"], "no"
            )
        found = await self.tool(client, "search_bookmarks", {"query": "secret"})
        self.assertEqual(
            found["bookmarks"][0]["url"], "https://example.org/new?a=1&b=2"
        )

        again = await self.tool(
            client,
            "add_bookmark",
            {"url": "https://example.org/new?a=1&b=2", "title": "Other"},
        )
        self.assertFalse(again["created"])
        self.assertEqual(again["bookmark"]["title"], "Secret title")

        updated = await self.tool(
            client,
            "update_bookmark",
            {
                "url": "https://example.com/rust",
                "add_tags": ["later"],
                "remove_tags": ["programming"],
                "private": False,
            },
        )
        self.assertTrue(updated["changed"])
        self.assertEqual(updated["bookmark"]["tags"], ["rust", "later"])
        self.assertEqual(updated["bookmark"]["time"], "2024-05-01T10:00:00Z")
        replaced = await self.tool(
            client,
            "update_bookmark",
            {"url": "https://example.com/rust", "tags": ["x"]},
        )
        self.assertEqual(replaced["bookmark"]["tags"], ["x"])
        found = await self.tool(client, "search_bookmarks", {"tags": ["x"]})
        self.assertEqual(len(found["bookmarks"]), 1)
        self.assertFalse(found["bookmarks"][0]["private"])
        missing = await self.tool(
            client, "update_bookmark", {"url": "https://example.com/gone"}, error=True
        )
        self.assertEqual(missing["error"], "failed")

        # A following sync finds the mirror already level with Pinboard.
        commits = self.git("-C", str(self.clone), "rev-list", "--count", "HEAD")
        synced = await self.tool(client, "sync")
        self.assertEqual(
            (synced["added"], synced["updated"], synced["deleted"]), (0, 0, 0)
        )
        self.assertEqual(
            self.git("-C", str(self.clone), "rev-list", "--count", "HEAD"), commits
        )

        log = self.log.read_text()
        for secret in ("Secret", "Other", "a=1", TOKEN, TOKEN.partition(":")[2]):
            self.assertNotIn(secret, log)
        records = self.records()
        add = next(r for r in records if r["tool"] == "add_bookmark")
        self.assertEqual(
            {k: add[k] for k in ("transport", "outcome", "host")},
            {"transport": "stdio", "outcome": "ok", "host": "example.org"},
        )
        self.assertIsInstance(add["ms"], int)
        search = next(r for r in records if r["tool"] == "search_bookmarks")
        self.assertRegex(search["search"], r"^[0-9a-f]{16}$")
        self.assertNotIn("host", search)
        self.assertIn(
            {"error": "failed", "outcome": "error"},
            [{k: r.get(k) for k in ("error", "outcome")} for r in records],
        )

    async def test_sync_gate(self):
        env = {"PINBOARD_TIME_SCALE": "0.01"}  # posts/all once every 3 s
        await asyncio.sleep(3.2)
        async with (
            stdio_client(
                StdioServerParameters(
                    command=str(BIN), args=["mcp"], env={**self.env, **env}
                ),
                errlog=self.errlog,
            ) as streams,
            ClientSession(*streams, read_timeout_seconds=60) as client,
        ):
            await client.initialize()
            with FAKE.lock:
                FAKE.put("https://example.com/one", "One", "2026-01-01T00:00:00Z")
            first = await self.tool(client, "sync")
            self.assertEqual(first["added"], 1)
            with FAKE.lock:
                FAKE.put("https://example.com/two", "Two", "2026-01-02T00:00:00Z")
            refused = await self.tool(client, "sync", error=True)
            self.assertEqual(refused["error"], "rate_limited")
            self.assertIsInstance(refused["retry_after"], int)
            self.assertGreater(refused["retry_after"], 0)
            record = self.records()[-1]
            self.assertEqual(
                (record["outcome"], record["error"]), ("refused", "rate_limited")
            )

    async def test_one_sync_at_a_time(self, client):
        with FAKE.lock:
            FAKE.all_delay = 2.0
            FAKE.put("https://example.com/one", "One", "2026-01-01T00:00:00Z")
        results = await asyncio.gather(
            client.call_tool("sync", {}), client.call_tool("sync", {})
        )
        outcomes = sorted(
            (r.is_error, json.loads(r.content[0].text).get("error")) for r in results
        )
        self.assertEqual(outcomes, [(False, None), (True, "sync_running")])
        with FAKE.lock:
            self.assertEqual(FAKE.count("posts/all"), 2)  # setup's sync, and one

    async def test_sync_concurrent_with_write(self, client):
        with FAKE.lock:
            FAKE.all_delay = 1.5
            FAKE.put("https://example.com/from-app", "From app", "2026-01-01T00:00:00Z")
        started = time.time()
        # The add starts while the sync holds the clone's lock in posts/all.
        sync = asyncio.create_task(self.tool(client, "sync"))
        await asyncio.sleep(0.3)
        added = await self.tool(
            client,
            "add_bookmark",
            {"url": "https://example.com/from-agent", "title": "From agent"},
        )
        await sync
        self.assertTrue(added["created"])
        for url in ("https://example.com/from-app", "https://example.com/from-agent"):
            got = await self.tool(client, "get_bookmark", {"url": url})
            self.assertIsNotNone(got["bookmark"], url)
        tree = self.git(
            "--git-dir",
            str(self.remote),
            "grep",
            "-c",
            "example.com/from-",
            "main",
            "--",
        )
        self.assertEqual(
            sum(int(line.rsplit(":", 1)[1]) for line in tree.splitlines()), 2
        )
        self.assertEqual(
            self.git(
                "--git-dir", str(self.remote), "rev-list", "--merges", "--count", "main"
            ),
            "0",
        )
        self.assertEqual(self.git("-C", str(self.clone), "status", "--porcelain"), "")
        # The write, which waited for the sync, kept the sync's gate time and
        # watermark rather than saving the state it read before waiting.
        local = json.loads((self.clone / ".git/pinboard/local.json").read_text())
        self.assertGreaterEqual(local["gates"]["posts/all"], started)
        self.assertGreaterEqual(
            local["last_sync"],
            time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(int(started))),
        )

    async def test_http_access(self):
        key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
        jwks = json.dumps({"keys": [jwk(key, "k1")]}).encode()

        class Certs(BaseHTTPRequestHandler):
            def do_GET(self):
                self.send_response(200)
                self.send_header("content-type", "application/json")
                self.end_headers()
                self.wfile.write(jwks)

            def log_message(self, *args):
                pass

        certs = ThreadingHTTPServer(("127.0.0.1", 0), Certs)
        threading.Thread(target=certs.serve_forever, daemon=True).start()
        env = {
            "PINBOARD_MCP_ACCESS_CERTS_URL": f"http://127.0.0.1:{certs.server_address[1]}/certs"
        }
        ping = {"jsonrpc": "2.0", "id": 1, "method": "ping"}
        headers = {"accept": "application/json, text/event-stream"}
        try:
            async with (
                self.http_server(
                    "--access-team",
                    TEAM,
                    "--access-aud",
                    AUD,
                    "--sync-every",
                    "0",
                    env=env,
                ) as base,
                httpx2.AsyncClient() as http,
            ):
                before = self.calls()
                up = await http.get(base + "/up")
                self.assertEqual((up.status_code, up.text), (200, "ok"))
                now = int(time.time())
                for name, token, status in (
                    ("missing", None, 401),
                    ("expired", jwt(key, exp=now - 600), 403),
                    ("wrong audience", jwt(key, aud=["other"]), 403),
                    ("valid", jwt(key), 200),
                ):
                    with self.subTest(token=name):
                        h = dict(headers)
                        if token:
                            h["cf-access-jwt-assertion"] = token
                        got = await http.post(base + "/mcp", json=ping, headers=h)
                        self.assertEqual(got.status_code, status, got.text)
                async with (
                    httpx2.AsyncClient(
                        headers={"cf-access-jwt-assertion": jwt(key)}
                    ) as authed,
                    streamable_http_client(
                        base + "/mcp", http_client=authed
                    ) as streams,
                    ClientSession(*streams[:2]) as client,
                ):
                    init = await client.initialize()
                    self.assertIn("mirror", init.instructions)
                    self.assertNotIn("on that schedule", init.instructions)
                    found = await self.tool(
                        client, "search_bookmarks", {"query": "lemon"}
                    )
                    self.assertEqual(len(found["bookmarks"]), 1)
                self.assertEqual(self.calls(), before)
                self.assertEqual(self.records()[-1]["transport"], "http")
        finally:
            certs.shutdown()

    def test_command_line(self):
        def run(*args: str) -> subprocess.CompletedProcess:
            return subprocess.run(
                [str(BIN), "mcp", *args],
                capture_output=True,
                text=True,
                env=self.env,
                timeout=60,
                check=False,
            )

        for args, says in (
            (["--http", "--host", "0.0.0.0"], "loopback only"),
            (["--http", "--access-team", TEAM], "both --access-team and --access-aud"),
            (["--access-team", TEAM, "--access-aud", AUD], "apply only to --http"),
            (["--sync-every", "1"], "applies only to --http"),
            (["--repo", str(self.tmp / "none")], "no mirror at"),
            (["--port", "nope"], "Try 'pinboard mcp --help'"),
        ):
            with self.subTest(args=args):
                res = run(*args)
                self.assertEqual(res.returncode, 1, res.stderr)
                self.assertIn(says, res.stderr)
        res = run("--help")
        self.assertEqual(res.returncode, 0)
        self.assertIn("--sync-every", res.stdout)

    def test_signals_exit_0(self):
        """SIGTERM stops either transport with status 0, a stdio server even
        while its client holds stdin open."""

        def stop(*args: str, stdin: Any = None) -> int:
            proc = subprocess.Popen(
                [str(BIN), "mcp", *args],
                stdin=stdin,
                stdout=subprocess.DEVNULL,
                stderr=self.errlog,
                env=self.env,
            )
            try:
                time.sleep(8)  # Started and serving.
                proc.send_signal(signal.SIGTERM)
                return proc.wait(timeout=30)
            finally:
                if proc.poll() is None:
                    proc.kill()
                    proc.wait()

        port = str(free_port())
        self.assertEqual(stop("--http", "--port", port, "--sync-every", "0"), 0)
        self.assertEqual(stop(stdin=subprocess.PIPE), 0)

    async def test_scheduler_catches_up_after_restart(self):
        self.make_stale()
        with FAKE.lock:
            FAKE.put(
                "https://example.com/while-down", "While down", "2026-01-01T00:00:00Z"
            )

        # A stdio server never schedules, however stale the mirror.
        before = self.calls()
        async with (
            stdio_client(
                StdioServerParameters(command=str(BIN), args=["mcp"], env=self.env),
                errlog=self.errlog,
            ) as streams,
            ClientSession(*streams, read_timeout_seconds=60) as client,
        ):
            await client.initialize()
            await asyncio.sleep(1.5)
        self.assertEqual(self.calls(), before)

        async def schedule_runs() -> list[dict[str, Any]]:
            return [r for r in self.records() if r["transport"] == "schedule"]

        async with self.http_server():
            for _ in range(100):
                if await schedule_runs():
                    break
                await asyncio.sleep(0.1)
            await asyncio.sleep(1.0)  # several ticks: it must not run again
        runs = await schedule_runs()
        self.assertEqual(
            [(r["tool"], r["outcome"], r["result"]) for r in runs],
            [("sync", "ok", "+1 ~0 -0")],
        )
        with FAKE.lock:
            updates = FAKE.count("posts/update")

        # Restarted within the interval: nothing is due.
        async with self.http_server():
            await asyncio.sleep(1.5)
        self.assertEqual(len(await schedule_runs()), 1)
        with FAKE.lock:
            self.assertEqual(FAKE.count("posts/update"), updates)

        # A failed run is logged and retried at a later tick (here, with an
        # interval of about a second, every few milliseconds).
        with FAKE.lock:
            FAKE.put("https://example.com/later", "Later", "2026-01-02T00:00:00Z")
            FAKE.all_mode = "error"
        async with self.http_server("--sync-every", "0.0003"):
            for _ in range(100):
                if len(await schedule_runs()) >= 3:
                    break
                await asyncio.sleep(0.1)
        failures = [r for r in await schedule_runs() if r["outcome"] != "ok"]
        self.assertGreaterEqual(len(failures), 2)
        self.assertEqual(failures[0]["error"], "failed")

    def fill_log(self) -> None:
        """A log one record short of rotation, and three older files."""
        self.log.parent.mkdir(parents=True, exist_ok=True)
        self.log.write_text("x" * (8 * 1024 * 1024 - 10) + "\n")
        for i in range(2, 5):
            Path(f"{self.log}.{i}").write_text(f"old {i}\n")

    def rotated(self) -> tuple[int, str, bool]:
        return (
            Path(f"{self.log}.1").stat().st_size,
            Path(f"{self.log}.4").read_text(),
            Path(f"{self.log}.5").exists(),
        )

    async def test_log_rotation(self, client):
        self.fill_log()
        await self.tool(client, "list_tags")
        self.assertEqual(self.rotated(), (8 * 1024 * 1024 - 9, "old 3\n", False))
        self.assertEqual([r["tool"] for r in self.records()], ["list_tags"])


