        "2026",
        "--source",
        "archive-today",
        "--interval",
        "0",
        "--timeout",
        "1",
        env=env,
    )
    ok(proc.returncode == 0, "an unreachable source is not fatal", proc.stderr)
    ok("unreachable" in proc.stderr, "the skip is reported", proc.stderr)
    ok(
        not any(e["op"] == "fallback" for e in journal(state)),
        "an unreachable source writes no results",
    )


def test_check_dry_run() -> None:
    repo, state, _ = fixture("dry-run")
    before = len([e for e in journal(state) if e["op"] == "fallback"])
    hits = dict(HITS)
    proc = audit(
        repo,
        "fallbacks",
        "check",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--source",
        "wayback",
        "--dry-run",
    )
    ok(proc.returncode == 0, "check dry run exits 0", proc.stderr)
    ok("would check" in proc.stdout, "dry run lists the scope", proc.stdout)
    ok(
        len([e for e in journal(state) if e["op"] == "fallback"]) == before,
        "dry run writes no results",
    )
    ok(hits == HITS, "dry run makes no upstream requests", str(HITS))


