COOKIES: list[str] = []
HITS: dict[str, int] = {}


class Site(BaseHTTPRequestHandler):
    def log_message(self, *args) -> None:
        pass

    def send(self, status: int, body, content_type: str = "text/html") -> None:
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(status)
        self.send_header("Content-Type", f"{content_type}; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def html(self, title: str, status: int = 200) -> None:
        self.send(
            status,
            f"<html><head><title>{title}</title></head><body>x</body></html>",
        )

    def do_GET(self) -> None:
        parts = urllib.parse.urlsplit(self.path)
        path, query = parts.path, urllib.parse.parse_qs(parts.query)
        HITS[path] = HITS.get(path, 0) + 1
        if path == "/wayback/available":
            target = urllib.parse.urlsplit(query.get("url", [""])[0]).path
            stamps = {
                "/gone": "20200101000000",
                "/wall": "20200102000000",
                "/nogood": "20200103000000",
            }
            closest = (
                {
                    "available": True,
                    "status": "200",
                    "timestamp": stamps[target],
                    "url": self.path,
                }
                if target in stamps
                else None
            )
            payload = {"archived_snapshots": {"closest": closest} if closest else {}}
            self.send(200, json.dumps(payload), "application/json")
            return
        if path == "/cdx/search/cdx":
            url = query.get("url", [""])[0]
            target = urllib.parse.urlsplit(url).path
            rows = [["timestamp", "original", "statuscode"]]
            if target == "/changed":
                rows.append(["20200202000000", url, "200"])
            self.send(200, json.dumps(rows), "application/json")
            return
        if path == "/throttle":
            self.html("Too Many Requests", 429)
            return
        if path == "/sub/article":
            cookie = self.headers.get("Cookie", "")
            COOKIES.append(cookie)
            if "session=test" in cookie:
                self.html("Sub Article")
            else:
                self.html("Forbidden", 403)
            return
        if path.startswith(("/web/", "/archive/newest/")):
            for marker, title in (
                ("/gone", "Gone Article"),
                ("/wall", "Wall Article"),
                ("/changed", "Changed Article"),
                ("/nogood", "Totally Different"),
            ):
                if marker in path:
                    self.html(title)
                    return
            self.html("Not Found", 404)
            return
        titles = {
            "/gone": ("Gone", 404),
            "/wall": ("Forbidden", 403),
            "/changed": ("Different Title", 200),
            "/ok": ("Same Title", 200),
            "/nogood": ("Forbidden", 403),
            "/": ("Archive", 200),
        }
        if path in titles:
            title, status = titles[path]
            self.html(title, status)
            return
        self.html("Not Found", 404)


SITE = ThreadingHTTPServer(("127.0.0.1", 0), Site)
