n = 0
failed = 0


def ok(condition: bool, description: str, diag: str = "") -> None:
    global n, failed
    n += 1
    print(f"{'ok' if condition else 'not ok'} {n} - {description}")
    if not condition:
        failed += 1
        for line in diag.splitlines()[-12:]:
            print(f"# {line}")


def reset_api() -> None:
    with FAKE.lock:
        FAKE.posts.clear()
        FAKE.calls.clear()
        FAKE.tick = 0
        FAKE.update_time = ""
        FAKE.reset_knobs()
    COOKIES.clear()
    HITS.clear()


def git(*args: str, cwd: Path) -> str:
    proc = subprocess.run(
        ["git", *args], capture_output=True, text=True, env=ENV, cwd=cwd, check=False
    )
    if proc.returncode:
        raise RuntimeError(proc.stderr)
    return proc.stdout.strip()


def record(
    url: str,
    title: str,
    time_: str,
    tags: list[str] | None = None,
) -> dict:
    return {
        "url": url,
        "hash": "0" * 32,
        "title": title,
        "notes": "",
        "tags": tags or [],
        "time": time_,
        "shared": False,
        "toread": False,
        "meta": "0" * 32,
    }


def make_repo(records: list[dict]) -> Path:
    repo = TMP / f"repo-{len(records)}-{os.urandom(4).hex()}"
    (repo / "bookmarks").mkdir(parents=True)
    by_year: dict[str, list[dict]] = {}
    for item in records:
        by_year.setdefault(item["time"][:4], []).append(item)
    for year, items in by_year.items():
        items.sort(key=lambda r: (r["time"], r["url"]))
        (repo / "bookmarks" / f"{year}.jsonl").write_text(
            "".join(json.dumps(item, ensure_ascii=False) + "\n" for item in items)
        )
    (repo / "state.json").write_text('{"format": 1, "update_time": ""}\n')
    (repo / "README.md").write_text("# Pinboard mirror\n")
    (repo / ".gitattributes").write_text("*.jsonl text eol=lf\n")
    git("init", "-b", "main", cwd=repo)
    git("add", "-A", cwd=repo)
    git("commit", "-q", "-m", "fixture", cwd=repo)
    return repo


def audit(repo: Path, *args: str, env: dict | None = None):
    return subprocess.run(
        [str(BIN), "--repo", str(repo), "audit", *args],
        capture_output=True,
        text=True,
        env=env or ENV,
        check=False,
    )


def journal(state: Path, pass_id: str = "2026") -> list[dict]:
    path = state / pass_id / "journal.jsonl"
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def fixture(name: str) -> tuple[Path, Path, list[dict]]:
    reset_api()
    records = [
        record(
            f"{BASE}/gone",
            "Gone Article",
            "2021-01-01T00:00:00Z",
            ["rust", ".status:dead", ".checked:2026"],
        ),
        record(
            f"{BASE}/wall",
            "Wall Article",
            "2021-01-02T00:00:00Z",
            [".status:blocked", ".checked:2026"],
        ),
        record(
            f"{BASE}/changed",
            "Changed Article",
            "2021-01-03T00:00:00Z",
            [".status:changed", ".checked:2026"],
        ),
        record(
            f"{BASE}/nogood",
            "No Good",
            "2021-01-04T00:00:00Z",
            [".status:blocked", ".checked:2026"],
        ),
        record(
            f"{BASE}/sub/article",
            "Sub Article",
            "2021-01-05T00:00:00Z",
            [".status:blocked", ".checked:2026"],
        ),
        record(
            f"{BASE}/ok",
            "Same Title",
            "2021-01-06T00:00:00Z",
            [".status:ok", ".checked:2026"],
        ),
    ]
    for item in records:
        FAKE.put(
            item["url"],
            item["title"],
            item["time"],
            tags=" ".join(item["tags"]),
        )
    repo = make_repo(records)
    state = TMP / name
    proc = audit(repo, "plan", "--state", str(state), "--pass", "2026")
    if proc.returncode:
        raise RuntimeError(proc.stderr)
    proc = audit(
        repo,
        "check",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--jobs",
        "1",
        "--timeout",
        "5",
    )
    if proc.returncode:
        raise RuntimeError(proc.stderr)
    return repo, state, records


def seed_checks(state: Path, verdicts: dict[str, str]) -> None:
    """Replace the journal with hand-written checks, when a test wants an
    exact target set without running the HTTP check phase."""
    (state / "2026" / "journal.jsonl").write_text(
        "".join(
            json.dumps({"seq": i, "op": "check", "url": url, "verdict": verdict}) + "\n"
            for i, (url, verdict) in enumerate(verdicts.items(), 1)
        )
    )


def tags_of(url: str) -> set[str]:
    return set(FAKE.posts[url]["tags"].split())


def load_pinboard():
    loader = SourceFileLoader("pb_fallbacks", str(BIN))
    spec = importlib.util.spec_from_loader("pb_fallbacks", loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules["pb_fallbacks"] = module
    loader.exec_module(module)
    return module


PB = load_pinboard()


def test_alt_tags() -> None:
    got = PB.alt_target_tags(
        ["rust", ".status:dead", ".alt:wayback", ".checked:2026"],
        ["archive-today"],
    )
    ok(
        got == ["rust", ".status:dead", ".checked:2026", ".alt:archive-today"],
        "alt namespace is replaced, status tags are kept",
        repr(got),
    )
    got = PB.alt_target_tags([], ["subscription", "wayback"])
    ok(
        got == [".alt:wayback", ".alt:subscription"],
        "sources follow the canonical order",
        repr(got),
    )


def test_permanent_fetch_error_is_a_miss() -> None:
    result = PB.fetch_with_retry(f"{BASE}/\x00", 5, PB.Pacer(0))
    ok(
        result["error"] == "InvalidURL",
        "a permanent fetch error is returned instead of aborting",
        str(result),
    )


def test_rate_limit_stops_instead_of_matching() -> None:
    start, attempts = PB.RETRY_START, PB.RETRY_ATTEMPTS
    PB.RETRY_START, PB.RETRY_ATTEMPTS = 0.01, 2
    try:
        try:
            PB.fetch_with_retry(f"{BASE}/throttle", 5, PB.Pacer(0))
            ok(False, "a persistent 429 is not treated as a result")
        except PB.Error as error:
            ok(
                "attempts" in str(error) and "larger --interval" in str(error),
                "a persistent 429 stops the run with advice",
                str(error),
            )
    finally:
        PB.RETRY_START, PB.RETRY_ATTEMPTS = start, attempts


def test_transient_results_are_retried() -> None:
    def fake(events: list[dict]):
        return type("P", (), {"journal": type("J", (), {"events": events})()})()

    throttled = {
        "op": "fallback",
        "url": "u",
        "source": "wayback",
        "http": 429,
        "error": "",
        "match": False,
    }
    real = {
        "op": "fallback",
        "url": "u",
        "source": "wayback",
        "http": 200,
        "error": "not-found",
        "match": False,
    }
    got = PB.fallback_events(fake([throttled, real]))
    ok(
        got["u"]["wayback"]["http"] == 200,
        "a throttled result is ignored in favour of a real one",
        str(got),
    )
    ok(
        "u" not in PB.fallback_events(fake([throttled])),
        "a lone transient result leaves the URL unchecked",
    )


def test_snapshot_score() -> None:
    score, seen = PB.snapshot_score(
        "Gone Article", b"<title>Gone Article</title>", "text/html"
    )
    ok(
        score == 1.0 and seen == "Gone Article",
        "matching title scores 1.0",
        repr(score),
    )
    score, _ = PB.snapshot_score(
        "Gone Article", b"<title>404 Not Found</title>", "text/html"
    )
    ok(score == 0.0, "an error page never matches", repr(score))
    score, _ = PB.snapshot_score(
        "Gone Article", b"<title>Just a moment...</title>", "text/html"
    )
    ok(score == 0.0, "a challenge page never matches", repr(score))


