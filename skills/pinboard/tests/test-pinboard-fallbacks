def test_wayback_check_apply_and_resume() -> None:
    repo, state, _ = fixture("wayback")
    proc = audit(
        repo,
        "fallbacks",
        "check",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--source",
        "wayback",
        "--interval",
        "0",
    )
    ok(proc.returncode == 0, "wayback check exits 0", proc.stderr)
    events = [e for e in journal(state) if e["op"] == "fallback"]
    ok(len(events) == 5, "one result per dead/blocked/changed target", str(len(events)))
    by_url = {e["url"].removeprefix(BASE): e for e in events}
    ok(
        by_url["/gone"]["match"] and by_url["/gone"]["score"] == 1.0,
        "the closest capture matches",
        str(by_url.get("/gone")),
    )
    ok(
        by_url["/changed"]["match"],
        "CDX finds a capture when availability returns none",
        str(by_url.get("/changed")),
    )
    ok(
        not by_url["/nogood"]["match"],
        "a capture with a different title does not match",
        str(by_url.get("/nogood")),
    )
    ok(
        by_url["/gone"]["snapshot"].startswith(f"{BASE}/web/20200101000000id_/"),
        "the raw snapshot URL is journaled",
        by_url["/gone"]["snapshot"],
    )
    ok(
        len(by_url["/gone"]["sha256"]) == 64 and by_url["/gone"]["ts"],
        "the journal records a content hash and fetch time",
        str(by_url["/gone"]),
    )
    ok(
        not any(tag.startswith(".alt:") for tag in tags_of(f"{BASE}/gone")),
        "check writes no tags",
    )

    proc = audit(
        repo,
        "fallbacks",
        "apply",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--dry-run",
    )
    ok(proc.returncode == 0, "apply dry run exits 0", proc.stderr)
    ok(".alt:wayback" in proc.stdout, "dry run reports the proposed tag", proc.stdout)
    ok(
        not any(tag.startswith(".alt:") for tag in tags_of(f"{BASE}/gone")),
        "dry run writes nothing",
    )

    proc = audit(repo, "fallbacks", "apply", "--state", str(state), "--pass", "2026")
    ok(proc.returncode == 0, "apply exits 0", proc.stderr)
    ok(
        tags_of(f"{BASE}/gone")
        == {"rust", ".status:dead", ".checked:2026", ".alt:wayback"},
        "apply keeps status tags and adds the alt tag",
        str(tags_of(f"{BASE}/gone")),
    )
    ok(
        tags_of(f"{BASE}/changed")
        == {".status:changed", ".checked:2026", ".alt:wayback"},
        "CDX match is tagged",
        str(tags_of(f"{BASE}/changed")),
    )
    ok(
        not any(tag.startswith(".alt:") for tag in tags_of(f"{BASE}/nogood")),
        "a miss is not tagged",
    )
    ok(
        not any(tag.startswith(".alt:") for tag in tags_of(f"{BASE}/ok")),
        "an ok bookmark is untouched",
    )

    proc = audit(repo, "fallbacks", "verify", "--state", str(state), "--pass", "2026")
    ok(proc.returncode == 0, "verify passes after apply", proc.stdout + proc.stderr)

    proc = audit(
        repo, "fallbacks", "status", "--state", str(state), "--pass", "2026", "--json"
    )
    payload = json.loads(proc.stdout)
    ok(
        payload["targets"] == 5
        and payload["checked"] == 5
        and payload["matched"] == 3
        and payload["applied"] == 3,
        "status counts targets, matches and writes",
        proc.stdout,
    )
    ok(
        payload["sources"]["wayback"] == {"checked": 5, "matched": 3},
        "status breaks results down by source",
        proc.stdout,
    )

    before = len([e for e in journal(state) if e["op"] == "fallback"])
    proc = audit(
        repo,
        "fallbacks",
        "check",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--source",
        "wayback",
        "--interval",
        "0",
    )
    ok(proc.returncode == 0, "a repeated check exits 0", proc.stderr)
    after = len([e for e in journal(state) if e["op"] == "fallback"])
    ok(
        before == after,
        "a repeated check does not repeat lookups",
        f"{before}->{after}",
    )

    proc = audit(repo, "fallbacks", "apply", "--state", str(state), "--pass", "2026")
    ok("nothing to apply" in proc.stdout, "apply is idempotent", proc.stdout)


def test_archive_today() -> None:
    repo, state, _ = fixture("archive-today")
    proc = audit(
        repo,
        "fallbacks",
        "check",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--source",
        "archive-today",
        "--interval",
        "0",
    )
    ok(proc.returncode == 0, "archive.today check exits 0", proc.stderr)
    events = [e for e in journal(state) if e["op"] == "fallback"]
    ok(len(events) == 5, "archive.today checks every target", str(len(events)))
    ok(
        sum(1 for e in events if e["match"]) == 3,
        "archive.today matches three captures",
        str([e["match"] for e in events]),
    )
    proc = audit(repo, "fallbacks", "apply", "--state", str(state), "--pass", "2026")
    ok(proc.returncode == 0, "archive.today apply exits 0", proc.stderr)
    ok(
        ".alt:archive-today" in tags_of(f"{BASE}/gone"),
        "the archive.today tag is written",
        str(tags_of(f"{BASE}/gone")),
    )
    ok(
        ".alt:wayback" not in tags_of(f"{BASE}/gone"),
        "an unchecked source is not tagged",
        str(tags_of(f"{BASE}/gone")),
    )


def test_subscription() -> None:
    repo, state, _ = fixture("subscription")
    headers = TMP / "subscription.headers"
    headers.write_text("Cookie: session=test\nUser-Agent: Test\n")
    headers.chmod(0o600)
    proc = audit(
        repo,
        "fallbacks",
        "check",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--source",
        "subscription",
        "--subscription",
        f"127.0.0.1={headers}",
        "--interval",
        "0",
    )
    ok(proc.returncode == 0, "subscription check exits 0", proc.stderr)
    events = [
        e
        for e in journal(state)
        if e["op"] == "fallback" and e["source"] == "subscription"
    ]
    ok(len(events) == 5, "subscription checks every target", str(len(events)))
    matched = [e for e in events if e["match"]]
    ok(
        len(matched) == 1 and matched[0]["url"] == f"{BASE}/sub/article",
        "only the opted-in page matches",
        str(matched),
    )
    ok(
        "session=test" in COOKIES[-1],
        "the local cookie was sent",
        str(COOKIES[-1:]),
    )
    ok(
        "session=test" not in (state / "2026" / "journal.jsonl").read_text(),
        "the journal never stores the cookie",
    )
    proc = audit(repo, "fallbacks", "apply", "--state", str(state), "--pass", "2026")
    ok(proc.returncode == 0, "subscription apply exits 0", proc.stderr)
    ok(
        ".alt:subscription" in tags_of(f"{BASE}/sub/article"),
        "the subscription tag is written",
        str(tags_of(f"{BASE}/sub/article")),
    )
    ok(
        not any(tag.startswith(".alt:") for tag in tags_of(f"{BASE}/nogood")),
        "an unmatched page is not tagged",
    )


def test_subscription_config_and_permissions() -> None:
    repo, state, _ = fixture("subscription-config")
    headers = TMP / "config.headers"
    headers.write_text("Cookie: session=test\n")
    headers.chmod(0o600)
    config = TMP / "fallbacks.json"
    config.write_text(json.dumps({"subscriptions": {"127.0.0.1": str(headers)}}))
    proc = audit(
        repo,
        "fallbacks",
        "check",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--source",
        "subscription",
        "--subscription-config",
        str(config),
        "--interval",
        "0",
    )
    ok(proc.returncode == 0, "the config file selects the domain", proc.stderr)
    ok(
        any(
            e["op"] == "fallback"
            and e["source"] == "subscription"
            and e["match"]
            and e["url"] == f"{BASE}/sub/article"
            for e in journal(state)
        ),
        "the config-driven check matches",
    )

    loose = TMP / "loose.headers"
    loose.write_text("Cookie: session=test\n")
    loose.chmod(0o644)
    try:
        PB.load_subscription_headers(loose)
        ok(False, "a group/world-readable header file is refused")
    except PB.Error as error:
        ok("chmod 600" in str(error), "refuse a loose header file", str(error))
    missing = TMP / "missing.headers"
    missing.write_text("User-Agent: Test\n")
    missing.chmod(0o600)
    try:
        PB.load_subscription_headers(missing)
        ok(False, "a header file without Cookie is refused")
    except PB.Error as error:
        ok("Cookie" in str(error), "require a Cookie header", str(error))


