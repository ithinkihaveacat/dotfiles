#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
# TAP tests for libexec/pinboard-audit. A fake Pinboard API and a local HTTP
# site are served from this process; no network access. Small by design: a
# handful of URLs per pass, never a full run.

from __future__ import annotations

import importlib.util
import json
import os
import subprocess
import sys
import tempfile
import threading
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from importlib.machinery import SourceFileLoader
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE / "fixtures"))
from fake_pinboard import API, FAKE, TOKEN  # noqa: E402

BIN = HERE.parent / "scripts" / "pinboard"
TMP = Path(tempfile.mkdtemp())
ENV = {
    k: v
    for k, v in os.environ.items()
    if not k.startswith(("PINBOARD_", "GIT_"))
    and k not in ("AGENT_OFFLINE", "NO_COLOR", "FORCE_COLOR")
}
ENV.update(
    PINBOARD_API_URL=API,
    PINBOARD_API_TOKEN=TOKEN,
    PINBOARD_TIME_SCALE="0.0001",
    XDG_STATE_HOME=str(TMP / "state"),
    GIT_CONFIG_GLOBAL=str(TMP / "gitconfig"),
    GIT_CONFIG_NOSYSTEM="1",
    GIT_AUTHOR_NAME="Pinboard Test",
    GIT_AUTHOR_EMAIL="pinboard@example.com",
    GIT_COMMITTER_NAME="Pinboard Test",
    GIT_COMMITTER_EMAIL="pinboard@example.com",
    NO_PROXY="*",
    no_proxy="*",
)
(TMP / "gitconfig").write_text("[init]\n\tdefaultBranch = main\n")

n = 0
failed = 0


def ok(condition: bool, description: str, diag: str = "") -> None:
    global n, failed
    n += 1
    print(f"{'ok' if condition else 'not ok'} {n} - {description}")
    if not condition:
        failed += 1
        for line in diag.splitlines()[-12:]:
            print(f"# {line}")


def git(*args: str, cwd: Path) -> str:
    proc = subprocess.run(
        ["git", *args], capture_output=True, text=True, env=ENV, cwd=cwd, check=False
    )
    if proc.returncode:
        raise RuntimeError(proc.stderr)
    return proc.stdout.strip()


def record(
    url: str,
    title: str,
    time_: str,
    tags: list[str] | None = None,
    shared: bool = False,
) -> dict:
    return {
        "url": url,
        "hash": "0" * 32,
        "title": title,
        "notes": "",
        "tags": tags or [],
        "time": time_,
        "shared": shared,
        "toread": False,
        "meta": "",
    }


def make_repo(records: list[dict]) -> Path:
    repo = TMP / f"repo-{len(records)}-{time_ns()}"
    (repo / "bookmarks").mkdir(parents=True)
    by_year: dict[str, list[dict]] = {}
    for item in records:
        by_year.setdefault(item["time"][:4], []).append(item)
    for year, items in by_year.items():
        items.sort(key=lambda r: (r["time"], r["url"]))
        (repo / "bookmarks" / f"{year}.jsonl").write_text(
            "".join(json.dumps(item, ensure_ascii=False) + "\n" for item in items)
        )
    (repo / "state.json").write_text('{"format": 1, "update_time": ""}\n')
    (repo / "README.md").write_text("# Pinboard mirror\n")
    (repo / ".gitattributes").write_text("*.jsonl text eol=lf\n")
    git("init", "-b", "main", cwd=repo)
    git("add", "-A", cwd=repo)
    git("commit", "-q", "-m", "fixture", cwd=repo)
    return repo


def time_ns() -> int:
    import time

    return time.time_ns()


def audit(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [str(BIN), "--repo", str(repo), "audit", *args],
        capture_output=True,
        text=True,
        env=ENV,
        check=False,
    )


def journal(pass_dir: Path) -> list[dict]:
    path = pass_dir / "journal.jsonl"
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


class Site(BaseHTTPRequestHandler):
    def log_message(self, *args) -> None:
        pass

    def do_GET(self) -> None:
        path = urllib.parse.urlsplit(self.path).path
        if path == "/redirect":
            self.send_response(302)
            self.send_header("Location", "/same")
            self.end_headers()
            return
        if path == "/gone":
            self.send_response(404)
            self.end_headers()
            return
        if path == "/wall":
            self.send_response(403)
            self.end_headers()
            return
        title = {"same": "Same Title", "project": "A Project"}.get(
            path.strip("/"), "Totally Different"
        )
        body = (
            f"<html><head><title>{title}</title></head><body>x</body></html>".encode()
        )
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


SITE = ThreadingHTTPServer(("127.0.0.1", 0), Site)
threading.Thread(target=SITE.serve_forever, daemon=True).start()
BASE = f"http://127.0.0.1:{SITE.server_address[1]}"


def reset_api() -> None:
    with FAKE.lock:
        FAKE.posts.clear()
        FAKE.calls.clear()
        FAKE.reset_knobs()


def load_pinboard():
    loader = SourceFileLoader("pinboard_cli_test", str(BIN))
    spec = importlib.util.spec_from_loader("pinboard_cli_test", loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules["pinboard_cli_test"] = module
    loader.exec_module(module)
    return module


PB = load_pinboard()


def test_target_tags() -> None:
    tags = PB.target_tags(
        ["rust", ".status:dead", ".checked:2025", "keep"], "ok", ".checked:2026"
    )
    ok(
        tags == ["rust", "keep", ".status:ok", ".checked:2026"],
        "strips old audit tags",
        repr(tags),
    )


def test_journal_torn_tail() -> None:
    path = TMP / "torn.jsonl"
    path.write_text(
        '{"seq":1,"op":"check","url":"a"}\n{"seq":2,"op":"check","url":"b"}\n{"seq":3,"op":'
    )
    book = PB.Journal(path)
    ok(len(book.events) == 2, "torn final line is discarded", repr(book.events))
    ok(book.seq == 2, "sequence resumes after the last valid line")


def test_plan_and_status() -> None:
    repo = make_repo(
        [
            record("https://example.com/old", "Old", "2020-01-01T00:00:00Z"),
            record("https://example.com/new", "New", "2021-06-01T00:00:00Z"),
            record(
                "https://example.com/tag", "Tagged", "2021-07-01T00:00:00Z", ["rust"]
            ),
        ]
    )
    proc = audit(repo, "plan", "--year", "2021", "--state", str(TMP / "p1"))
    ok(proc.returncode == 0, "plan exits 0", proc.stderr)
    plan = [
        json.loads(line)
        for line in (TMP / "p1" / "2026" / "plan.jsonl").read_text().splitlines()
    ]
    ok(len(plan) == 2, "plan filters by year", str(plan))
    proc = audit(repo, "status", "--state", str(TMP / "p1"), "--pass", "2026", "--json")
    payload = json.loads(proc.stdout)
    ok(
        payload["total"] == 2 and payload["remaining"] == 2,
        "status reports the plan",
        proc.stdout,
    )
    proc = audit(repo, "plan", "--year", "2021", "--state", str(TMP / "p1"))
    ok(proc.returncode != 0, "plan refuses to replace an existing pass", proc.stderr)


def test_check_classifies() -> None:
    reset_api()
    records = [
        record(f"{BASE}/same", "Same Title", "2021-01-01T00:00:00Z"),
        record(f"{BASE}/redirect", "Same Title", "2021-01-02T00:00:00Z"),
        record(f"{BASE}/other", "A Project", "2021-01-03T00:00:00Z"),
        record(f"{BASE}/gone", "Gone", "2021-01-04T00:00:00Z"),
        record(f"{BASE}/wall", "Wall", "2021-01-05T00:00:00Z"),
    ]
    repo = make_repo(records)
    state = TMP / "p2"
    proc = audit(
        repo, "plan", "--year", "2021", "--state", str(state), "--pass", "2026"
    )
    ok(proc.returncode == 0, "check plan exits 0", proc.stderr)
    proc = audit(
        repo,
        "check",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--jobs",
        "5",
        "--timeout",
        "5",
    )
    ok(proc.returncode == 0, "check exits 0", proc.stderr)
    events = [e for e in journal(state / "2026") if e["op"] == "check"]
    verdicts = {e["url"].removeprefix(BASE): e["verdict"] for e in events}
    ok(verdicts.get("/same") == "ok", "200 with the same title is ok", str(verdicts))
    ok(
        verdicts.get("/redirect") == "moved",
        "redirect to the same title is moved",
        str(verdicts),
    )
    ok(
        verdicts.get("/other") == "changed",
        "200 with a different title is changed",
        str(verdicts),
    )
    ok(verdicts.get("/gone") == "dead", "404 is dead", str(verdicts))
    ok(verdicts.get("/wall") == "blocked", "403 is blocked", str(verdicts))


def test_apply_and_verify() -> None:
    reset_api()
    url = "https://example.com/bookmark"
    FAKE.put(url, "Bookmark", "2021-05-01T00:00:00Z", tags="rust")
    repo = make_repo([record(url, "Bookmark", "2021-05-01T00:00:00Z", ["rust"])])
    state = TMP / "p3"
    proc = audit(repo, "plan", "--state", str(state), "--pass", "2026")
    ok(proc.returncode == 0, "apply plan exits 0", proc.stderr)
    # Seed a check by hand so the test does not depend on the check phase.
    events = state / "2026" / "journal.jsonl"
    events.write_text(
        json.dumps({"seq": 1, "op": "check", "url": url, "verdict": "ok", "http": 200})
        + "\n"
    )
    proc = audit(
        repo, "apply", "--state", str(state), "--pass", "2026", "--commit-every", "10"
    )
    ok(proc.returncode == 0, "apply exits 0", proc.stderr)
    ok(
        FAKE.posts[url]["tags"] == "rust .status:ok .checked:2026",
        "apply writes both tags",
        FAKE.posts[url]["tags"],
    )
    proc = audit(repo, "verify", "--state", str(state), "--pass", "2026")
    ok(proc.returncode == 0, "verify passes after apply", proc.stdout + proc.stderr)


def test_apply_recovers_intent() -> None:
    reset_api()
    url = "https://example.com/recover"
    FAKE.put(url, "Recover", "2021-05-01T00:00:00Z", tags=".status:ok .checked:2026")
    repo = make_repo([record(url, "Recover", "2021-05-01T00:00:00Z")])
    state = TMP / "p4"
    audit(repo, "plan", "--state", str(state), "--pass", "2026")
    events = state / "2026" / "journal.jsonl"
    events.write_text(
        json.dumps({"seq": 1, "op": "check", "url": url, "verdict": "ok"})
        + "\n"
        + json.dumps(
            {
                "seq": 2,
                "op": "intent",
                "url": url,
                "target": [".status:ok", ".checked:2026"],
            }
        )
        + "\n"
    )
    proc = audit(repo, "apply", "--state", str(state), "--pass", "2026")
    ok(proc.returncode == 0, "apply resolves an ambiguous intent", proc.stderr)
    ok(FAKE.count("posts/add") == 0, "a landed write is not repeated", str(FAKE.calls))
    last = journal(state / "2026")[-1]
    ok(
        last["op"] == "done" and last.get("recovered"),
        "recovery records done",
        str(last),
    )


def test_apply_recovers_dirty_mirror() -> None:
    reset_api()
    url = "https://example.com/dirty"
    FAKE.put(url, "Dirty", "2021-05-01T00:00:00Z")
    repo = make_repo([record(url, "Dirty", "2021-05-01T00:00:00Z")])
    state = TMP / "p6"
    audit(repo, "plan", "--state", str(state), "--pass", "2026")
    (state / "2026" / "journal.jsonl").write_text(
        json.dumps({"seq": 1, "op": "check", "url": url, "verdict": "ok"}) + "\n"
    )
    audit(repo, "apply", "--state", str(state), "--pass", "2026")
    bookmark = repo / "bookmarks" / "2021.jsonl"
    bookmark.write_text(bookmark.read_text() + " ")
    ok(git("status", "--porcelain", cwd=repo) != "", "fixture mirror is dirty")
    proc = audit(repo, "apply", "--state", str(state), "--pass", "2026")
    ok(proc.returncode == 0, "apply discards a half-written mirror update", proc.stderr)
    ok(
        git("status", "--porcelain", cwd=repo) == "",
        "mirror is clean again",
        git("status", "--porcelain", cwd=repo),
    )


def test_bump_requires_coverage() -> None:
    reset_api()
    url = "https://example.com/bump"
    FAKE.put(url, "Bump", "2021-05-01T00:00:00Z")
    repo = make_repo([record(url, "Bump", "2021-05-01T00:00:00Z")])
    state = TMP / "p5"
    audit(repo, "plan", "--state", str(state), "--pass", "2026")
    proc = audit(
        repo,
        "bump",
        "--state",
        str(state),
        "--pass",
        "2026",
        "--old",
        ".checked:2026",
        "--new",
        ".checked:2027",
    )
    ok(proc.returncode != 0, "bump refuses incomplete coverage", proc.stderr)


def main() -> int:
    for name, fn in sorted(globals().items()):
        if name.startswith("test_") and callable(fn):
            try:
                fn()
            except Exception as error:
                ok(False, f"{name} raised {type(error).__name__}: {error}")
    print(f"1..{n}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
