#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11,<3.15"
# dependencies = []
# ///
"""TAP test runner for wear-widget-audit."""

from __future__ import annotations

import sys
import traceback
import unittest
from pathlib import Path

TESTS_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(TESTS_DIR))

import test_wear_widget_audit as suite_mod  # noqa: E402


def main() -> int:
    loader = unittest.TestLoader()
    suite = loader.loadTestsFromModule(suite_mod)
    cases: list[unittest.TestCase] = []

    def collect(s: unittest.TestSuite | unittest.TestCase) -> None:
        if isinstance(s, unittest.TestSuite):
            for item in s:
                collect(item)
        else:
            cases.append(s)

    collect(suite)
    print(f"1..{len(cases)}")
    failed = 0
    for idx, case in enumerate(cases, start=1):
        result = unittest.TestResult()
        case.run(result)
        desc = case.id().split(".", 1)[-1]
        if result.wasSuccessful():
            print(f"ok {idx} - {desc}")
        else:
            failed += 1
            print(f"not ok {idx} - {desc}")
            for _tc, tb in result.failures + result.errors:
                for line in tb.strip().splitlines():
                    print(f"# {line}")
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        traceback.print_exc(file=sys.stderr)
        sys.exit(1)
