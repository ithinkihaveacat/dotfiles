_ACTIVE_PROCS: set[subprocess.Popen[Any]] = set()


class CheckPrefix(StrEnum):
    PASS = "PASS"
    WARN = "WARN"
    FAIL = "FAIL"
    NA = "N/A"
    GAP = "[GAP]"


@dataclass(slots=True, frozen=True)
class XmlNode:
    tag: str
    attrs: dict[str, str]
    children: tuple[XmlNode, ...]


@dataclass(slots=True, frozen=True)
class ResourceEntry:
    apk_name: str
    apk_path: Path
    qualifier: str
    file_path: str | None
    file_type: str | None
    value: str | None


@dataclass(slots=True)
class ResourceRecord:
    res_id: str
    res_type: str
    name: str
    entries: list[ResourceEntry] = field(default_factory=list)


@dataclass(slots=True, frozen=True)
class PreviewMetrics:
    res_ref: str
    logical_name: str
    apk_name: str
    qualifier: str
    archive_path: str
    is_nodpi: bool
    is_xml_drawable: bool
    width: int | None
    height: int | None
    aspect_ratio: float | None
    corners: tuple[tuple[int, int, int, int], ...] | None
    transparent_percent: float | None
    is_unmasked: bool
    sha256: str


@dataclass(slots=True)
class ContainerSpec:
    container_type: str  # "SMALL" | "LARGE"
    preview_ref: str | None
    preview: PreviewMetrics | None = None


@dataclass(slots=True)
class ProviderXmlSpec:
    res_ref: str
    archive_path: str | None
    label: str | None
    description: str | None
    icon: str | None
    group: str | None
    preferred_type: str | None
    config_intent_action: str | None
    containers: list[ContainerSpec] = field(default_factory=list)


@dataclass(slots=True)
class ServiceRecord:
    name: str
    descriptor: str
    exported: bool
    enabled: bool
    permission: str | None
    label_ref: str | None
    label: str | None
    actions: list[str]
    meta_data: dict[str, str]
    provider_xml: ProviderXmlSpec | None = None
    tile_preview: PreviewMetrics | None = None

    @property
    def is_widget(self) -> bool:
        return ACTION_WIDGET in self.actions or META_WIDGET_PROVIDER in self.meta_data

    @property
    def is_tile(self) -> bool:
        return ACTION_TILE in self.actions


@dataclass(slots=True)
class DexServiceInfo:
    descriptor: str
    found_in_dex: bool = False
    superclass: str | None = None
    runtime_annotations: list[tuple[str, list[str]]] = field(default_factory=list)
    init_widget_classes: list[str] = field(default_factory=list)
    has_di_or_lazy_init: bool = False
    has_on_create: bool = False


@dataclass(slots=True)
class DexAuditSummary:
    live_recovery_reader: bool = False
    reader_classes: list[str] = field(default_factory=list)
    services: dict[str, DexServiceInfo] = field(default_factory=dict)
    has_wear_widget_params: bool = False
    has_dynamic_theme_tokens: bool = False
    has_static_color_tokens: bool = False


