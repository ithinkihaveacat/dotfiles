#!/usr/bin/env bash
set -u

BIN="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../scripts/envrc"
TMP=$(mktemp -d)
trap 'rm -rf -- "$TMP"' EXIT

# All invocations use --output with an absolute path, so 'direnv allow' is
# never triggered and the tests are hermetic and parallel-safe.

n=0
ok() {
  n=$((n + 1))
  echo "ok $n - $1"
}
fail() {
  n=$((n + 1))
  echo "not ok $n - $1"
}

echo "1..21"

f="$TMP/a.envrc"

# 1: the removed 'skills' type is an unknown configuration type
if out=$("$BIN" --output "$f" create skills foo 2>&1); then
  fail "create skills is refused"
elif [[ "$out" == *"unknown configuration type: skills"* ]]; then
  ok "create skills is refused as an unknown type"
else
  fail "create skills is refused as an unknown type: $out"
fi

# 2: delete removes a leftover skills block and leaves other blocks intact
cat >"$f" <<'EOF'
# >>> envrc managed block: skills >>>
skills foo bar
# <<< envrc managed block: skills <<<
EOF
"$BIN" --output "$f" create uv >/dev/null 2>&1
"$BIN" --output "$f" delete skills >/dev/null 2>&1
if grep -q 'layout uv' "$f" && ! grep -q 'skills' "$f"; then
  ok "delete removes a leftover skills block and keeps the others"
else
  fail "delete removes a leftover skills block and keeps the others: $(cat "$f")"
fi

# 3: list prints the active blocks; a type argument is an error
out=$("$BIN" --output "$f" list 2>/dev/null)
if [[ "$out" == *"uv"* ]] && ! "$BIN" --output "$f" list uv >/dev/null 2>&1; then
  ok "list prints active blocks and takes no type"
else
  fail "list prints active blocks and takes no type: $out"
fi

# 4: the removed 'add' and 'remove' commands are unknown
if "$BIN" --output "$f" add skills foo >/dev/null 2>&1 ||
  "$BIN" --output "$f" remove skills foo >/dev/null 2>&1; then
  fail "add and remove are unknown commands"
else
  ok "add and remove are unknown commands"
fi

# 5: mutating a live .envrc (direnv present) prints the reload hint
live="$TMP/live"
mkdir -p "$live/bin"
cat >"$live/bin/direnv" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$live/bin/direnv"
out=$(cd "$live" && PATH="$live/bin:$PATH" "$BIN" create uv 2>&1)
if printf '%s\n' "$out" | grep -q "direnv reload" && grep -qx 'layout uv' "$live/.envrc"; then
  ok "mutating a live .envrc prints the reload hint"
else
  fail "mutating a live .envrc prints the reload hint: $out"
fi

# 6: set creates the env block with a single-quoted value
f6="$TMP/f.envrc"
"$BIN" --output "$f6" set FOO simple >/dev/null 2>&1
if grep -qx "export FOO='simple'" "$f6" && grep -qF '# >>> envrc managed block: env >>>' "$f6"; then
  ok "set creates the env block with a single-quoted value"
else
  fail "set creates the env block with a single-quoted value: $(cat "$f6")"
fi

# 7: set replaces an existing variable and keeps the others
"$BIN" --output "$f6" set BAR other >/dev/null 2>&1
"$BIN" --output "$f6" set FOO replaced >/dev/null 2>&1
if grep -qx "export FOO='replaced'" "$f6" && grep -qx "export BAR='other'" "$f6" &&
  [ "$(grep -c '^export FOO=' "$f6")" -eq 1 ]; then
  ok "set replaces an existing variable and keeps the others"
else
  fail "set replaces an existing variable and keeps the others: $(cat "$f6")"
fi

# 8: hostile values round-trip literally through set and get
# shellcheck disable=SC2016 # non-expansion of $(...) is the point of the test
hostile='a $(rm -rf /) b'\''c  d'
"$BIN" --output "$f6" set EVIL "$hostile" >/dev/null 2>&1
out=$("$BIN" --output "$f6" get EVIL 2>/dev/null)
if [ "$out" = "$hostile" ]; then
  ok "hostile values round-trip literally through set and get"
else
  fail "hostile values round-trip literally through set and get: $out"
fi

# 9: get reads a variable from a typed block
f7="$TMP/g.envrc"
"$BIN" --output "$f7" create appengine myapp >/dev/null 2>&1
out=$("$BIN" --output "$f7" get GAE_APP_ID 2>/dev/null)
if [ "$out" = "myapp" ]; then
  ok "get reads a variable from a typed block"
else
  fail "get reads a variable from a typed block: $out"
fi

# 10: set refuses a variable managed by another block
if "$BIN" --output "$f7" set GAE_APP_ID other >/dev/null 2>&1; then
  fail "set refuses a variable managed by another block"
elif "$BIN" --output "$f7" set GAE_APP_ID other 2>&1 | grep -q "'appengine' block"; then
  ok "set refuses a variable managed by another block"
else
  fail "set refuses a variable managed by another block (wrong message)"
fi

# 11: unset removes one variable and keeps the others
"$BIN" --output "$f6" unset EVIL >/dev/null 2>&1
if ! grep -q '^export EVIL=' "$f6" && grep -qx "export FOO='replaced'" "$f6"; then
  ok "unset removes one variable and keeps the others"
else
  fail "unset removes one variable and keeps the others: $(cat "$f6")"
fi

# 12: unsetting the last variable removes the env block entirely
"$BIN" --output "$f6" unset FOO >/dev/null 2>&1
"$BIN" --output "$f6" unset BAR >/dev/null 2>&1
if ! grep -qF '# >>> envrc managed block: env >>>' "$f6"; then
  ok "unsetting the last variable removes the env block"
else
  fail "unsetting the last variable removes the env block: $(cat "$f6")"
fi

# 13: unset of a missing variable errors
if "$BIN" --output "$f6" unset NOPE >/dev/null 2>&1; then
  fail "unset of a missing variable errors"
else
  ok "unset of a missing variable errors"
fi

# 14: get of a missing variable errors
if "$BIN" --output "$f6" get NOPE >/dev/null 2>&1; then
  fail "get of a missing variable errors"
else
  ok "get of a missing variable errors"
fi

# 15: show prints a block's content verbatim
out=$("$BIN" --output "$f7" show appengine 2>/dev/null)
if printf '%s\n' "$out" | grep -qx 'export GAE_APP_ID="myapp"'; then
  ok "show prints a block's content"
else
  fail "show prints a block's content: $out"
fi

# 16: show of a missing block errors
if "$BIN" --output "$f7" show no-such-block >/dev/null 2>&1; then
  fail "show of a missing block errors"
else
  ok "show of a missing block errors"
fi

# 17: create uv writes the uv layout block
f8="$TMP/h.envrc"
"$BIN" --output "$f8" create uv >/dev/null 2>&1
if grep -qx 'layout uv' "$f8" && grep -qF '# >>> envrc managed block: uv >>>' "$f8"; then
  ok "create uv writes the uv layout block"
else
  fail "create uv writes the uv layout block: $(cat "$f8")"
fi

# 18: create block reads raw content from stdin into a named block
printf 'export CORP=1\nexport MORE=2\n' | "$BIN" --output "$f8" create block corp-extra >/dev/null 2>&1
out=$("$BIN" --output "$f8" show corp-extra 2>/dev/null)
if [ "$out" = 'export CORP=1
export MORE=2' ]; then
  ok "create block reads raw content from stdin"
else
  fail "create block reads raw content from stdin: $out"
fi

# 19: create block refuses reserved block names
if printf 'x\n' | "$BIN" --output "$f8" create block env >/dev/null 2>&1; then
  fail "create block refuses reserved block names"
else
  ok "create block refuses reserved block names"
fi

# 20: set refuses invalid variable names
if "$BIN" --output "$f8" set 'BAD-NAME' x >/dev/null 2>&1; then
  fail "set refuses invalid variable names"
else
  ok "set refuses invalid variable names"
fi

# 21: an unknown command names itself and points at --help
err=$("$BIN" --output "$TMP/err.envrc" frobnicate 2>&1 || true)
if [[ "$err" == *"unknown command: frobnicate"* && "$err" == *"--help"* ]]; then
  ok "an unknown command outputs the correct error message"
else
  fail "an unknown command outputs the correct error message: $err"
fi
