#!/usr/bin/env bash

# Tests: skills/workspace-tools/tests/test-hook-markdown

set -u

DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../scripts/hook"
HOOK="$(cd -P "$DIR/../resources/hooks/markdown" >/dev/null 2>&1 && pwd)/pre-commit"
export PATH="$DIR/../scripts:$DIR/../../../bin:$PATH"

# Isolate from the user's/system git config (signing, hooks, templates).
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

echo "1..11"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
MDFMT_BIN="$DIR/../../coding-standards/scripts/markdown-format"

new_repo() {
  local repo="$WORK/$1"
  mkdir -p "$repo"
  git -C "$repo" init -q
  git -C "$repo" config user.email test@example.com
  git -C "$repo" config user.name "Test"
  git -C "$repo" config commit.gpgsign false
  printf '%s\n' "$repo"
}

# Reuse one configured repo for real trampoline commits and batched blob checks.
REPO_MAIN=$(new_repo main)
(cd "$REPO_MAIN" && "$BIN" add markdown) >/dev/null 2>&1

# Test 1: a valid, formatted markdown file passes and commits cleanly
printf '# Title\n\nProperly formatted markdown body.\n' >"$REPO_MAIN/doc.md"
git -C "$REPO_MAIN" add doc.md
if git -C "$REPO_MAIN" commit -q -m "feat: add doc" >/dev/null 2>&1 &&
  [ "$(git -C "$REPO_MAIN" show HEAD:doc.md)" = "$(cat "$REPO_MAIN/doc.md")" ]; then
  echo "ok 1 - valid formatted markdown commits cleanly through pre-commit multiplexer"
else
  echo "not ok 1 - valid formatted markdown failed to commit"
fi

# Test 2: an unformatted markdown file fails commit and reports error diagnostic
printf '# Title   \n\nUnformatted trailing spaces.   \n' >"$REPO_MAIN/bad.md"
git -C "$REPO_MAIN" add bad.md
rc=0
out=$(git -C "$REPO_MAIN" commit -q -m "feat: add bad doc" 2>&1) || rc=$?
git -C "$REPO_MAIN" reset -q HEAD bad.md >/dev/null 2>&1 || true
rm -f "$REPO_MAIN/bad.md"
if [ "$rc" -ne 0 ] && [[ "$out" == *'markdown-format: bad.md: needs formatting'* ]]; then
  echo "ok 2 - unformatted markdown is rejected with diagnostic"
else
  echo "not ok 2 - unformatted markdown was not rejected (rc=$rc, out=$out)"
fi

# Tests 7-14 and 20: run the remaining staged-blob checks inside one cached uv
# run importing mdformat once instead of 9 cold subprocess startups.
# First prepare T20's formatted frontmatter file outside REPO_MAIN.
SKILL_MD="$WORK/skill.md"
printf -- '---\nname: my-skill\ndescription: A very long description line that should be reflowed and wrapped properly when formatted according to the project rules.\n---\n\n# Body\n' >"$SKILL_MD"
"$MDFMT_BIN" "$SKILL_MD" >/dev/null 2>&1

uv run --quiet --script - "$HOOK" "$REPO_MAIN" "$WORK" "$SKILL_MD" <<'PY'
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "mdformat==1.0.0",
#     "mdformat-gfm==1.0.0",
#     "mdformat-frontmatter==2.2.0",
#     "ruamel.yaml==0.19.1",
# ]
# ///
import contextlib
import importlib.machinery
import importlib.util
import io
import os
import shutil
import subprocess
import sys

hook_src, repo, work, skill_md = sys.argv[1:]
loader = importlib.machinery.SourceFileLoader("md_pre_commit", hook_src)
spec = importlib.util.spec_from_loader(loader.name, loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)

base_sha = subprocess.check_output(
    ["git", "-C", repo, "rev-parse", "HEAD"], text=True
).strip()
os.chdir(repo)

def run_case(tag, fn):
    subprocess.run(["git", "reset", "--hard", "-q", base_sha], check=True)
    subprocess.run(["git", "clean", "-fdq"], check=True)
    fn()
    buf = io.StringIO()
    with contextlib.redirect_stderr(buf):
        rc = mod.main()
    with open(os.path.join(work, f"md.{tag}.rc"), "w") as f:
        f.write(str(rc))
    with open(os.path.join(work, f"md.{tag}.out"), "w") as f:
        f.write(buf.getvalue())

def w(rel, content):
    with open(os.path.join(repo, rel), "w") as f:
        f.write(content)

# t7: multi-file report
def t7():
    w("bad1.md", "# Title 1   \n")
    w("good.md", "# Title 2\n\nFormatted.\n")
    w("bad2.md", "# Title 3   \n")
    subprocess.run(["git", "add", "bad1.md", "good.md", "bad2.md"], check=True)
run_case("t7", t7)

# t8: non-markdown ignored
def t8():
    w("script.ts", "let x = 1;   \n")
    w("notes.txt", "some text with trailing spaces   \n")
    subprocess.run(["git", "add", "script.ts", "notes.txt"], check=True)
run_case("t8", t8)

# t9: unstaged dirty working tree does not fail clean staged hunk
def t9():
    w("doc2.md", "# Formatted Header\n\nBody.\n")
    subprocess.run(["git", "add", "doc2.md"], check=True)
    w("doc2.md", "# Formatted Header\n\nBody.\nUnstaged unformatted content with trailing spaces   \n")
run_case("t9", t9)

# t10: clean working tree does not mask dirty staged hunk
def t10():
    w("doc2.md", "# Header   \n")
    subprocess.run(["git", "add", "doc2.md"], check=True)
    w("doc2.md", "# Header\n")
run_case("t10", t10)

# t11: deleted markdown file is ignored
def t11():
    subprocess.run(["git", "rm", "-q", "doc.md"], check=True)
run_case("t11", t11)

# t12: space in path
def t12():
    w("my notes.md", "# Header   \n")
    subprocess.run(["git", "add", "my notes.md"], check=True)
run_case("t12", t12)

# t13: glob chars in path
def t13():
    w("a1.md", "# Header\n")
    w("a[1].md", "# Header   \n")
    subprocess.run(["git", "add", "a1.md", "a[1].md"], check=True)
run_case("t13", t13)

# t14: symlink is ignored
def t14():
    w("real.md", "# Header\n\nBody.\n")
    os.symlink("real.md", os.path.join(repo, "link.md"))
    subprocess.run(["git", "add", "real.md", "link.md"], check=True)
run_case("t14", t14)

# t20: formatted frontmatter passes
def t20():
    shutil.copyfile(skill_md, os.path.join(repo, "skill.md"))
    subprocess.run(["git", "add", "skill.md"], check=True)
run_case("t20", t20)

subprocess.run(["git", "reset", "--hard", "-q", base_sha], check=True)
subprocess.run(["git", "clean", "-fdq"], check=True)
PY

# Test 3: multiple staged files report all unformatted files before rejecting
rc=$(<"$WORK/md.t7.rc")
out=$(<"$WORK/md.t7.out")
if [ "$rc" -ne 0 ] &&
  [[ "$out" == *'markdown-format: bad1.md: needs formatting'* ]] &&
  [[ "$out" == *'markdown-format: bad2.md: needs formatting'* ]] &&
  ! [[ "$out" == *'markdown-format: good.md: needs formatting'* ]]; then
  echo "ok 3 - reports all unformatted files when multiple are staged"
else
  echo "not ok 3 - did not report all unformatted files (rc=$rc, out=$out)"
fi

# Test 4: non-markdown files are ignored and committed cleanly
if [ "$(<"$WORK/md.t8.rc")" -eq 0 ]; then
  echo "ok 4 - non-markdown files bypass the markdown hook"
else
  echo "not ok 4 - non-markdown files failed to commit"
fi

# Test 5: unstaged edits in working tree do not fail a formatted staged hunk
if [ "$(<"$WORK/md.t9.rc")" -eq 0 ]; then
  echo "ok 5 - unstaged edits in working tree do not fail formatted staged hunk"
else
  echo "not ok 5 - unstaged working tree edits interfered with staged commit"
fi

# Test 6: unstaged formatting fixes do not mask an unformatted staged hunk
rc=$(<"$WORK/md.t10.rc")
out=$(<"$WORK/md.t10.out")
if [ "$rc" -ne 0 ] && [[ "$out" == *'markdown-format: doc2.md: needs formatting'* ]]; then
  echo "ok 6 - working tree formatting does not mask unformatted staged hunk"
else
  echo "not ok 6 - unformatted staged hunk was erroneously allowed (rc=$rc)"
fi

# Test 7: deleted markdown file is ignored and commit passes
if [ "$(<"$WORK/md.t11.rc")" -eq 0 ]; then
  echo "ok 7 - deleted markdown file is ignored on commit"
else
  echo "not ok 7 - deleted markdown file failed on commit"
fi

# Test 8: staged file with spaces in path is checked properly
rc=$(<"$WORK/md.t12.rc")
out=$(<"$WORK/md.t12.out")
if [ "$rc" -ne 0 ] && [[ "$out" == *'markdown-format: my notes.md: needs formatting'* ]]; then
  echo "ok 8 - staged file with space in path is checked and reported"
else
  echo "not ok 8 - staged file with space in path failed check handling"
fi

# Test 9: staged file with glob characters in path is checked accurately
rc=$(<"$WORK/md.t13.rc")
out=$(<"$WORK/md.t13.out")
if [ "$rc" -ne 0 ] &&
  [[ "$out" == *'markdown-format: a[1].md: needs formatting'* ]] &&
  ! [[ "$out" == *'markdown-format: a1.md: needs formatting'* ]]; then
  echo "ok 9 - staged file with glob characters in path is checked accurately"
else
  echo "not ok 9 - staged file with glob characters failed check handling"
fi

# Test 10: staged symlink to markdown file is ignored (still tested in real commit below)
REPO_SYM=$(new_repo symlink)
(cd "$REPO_SYM" && "$BIN" add markdown) >/dev/null 2>&1
printf '# Header\n\nBody.\n' >"$REPO_SYM/real.md"
ln -s "real.md" "$REPO_SYM/link.md"
git -C "$REPO_SYM" add real.md link.md
if [ "$(<"$WORK/md.t14.rc")" -eq 0 ] &&
  git -C "$REPO_SYM" commit -q -m "feat: symlink" >/dev/null 2>&1 &&
  [ "$(git -C "$REPO_SYM" ls-tree HEAD link.md | cut -d' ' -f1)" = '120000' ]; then
  echo "ok 10 - staged symlink is ignored by markdown hook"
else
  echo "not ok 10 - staged symlink handling failed"
fi

# Test 11: front matter formatting is checked according to rules
if [ "$(<"$WORK/md.t20.rc")" -eq 0 ]; then
  echo "ok 11 - front matter formatting conforms to markdown-format specification"
else
  echo "not ok 11 - formatted front matter failed validation"
fi
