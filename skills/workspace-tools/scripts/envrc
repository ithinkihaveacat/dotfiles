#!/usr/bin/env bash
set -euo pipefail

# Tests: skills/workspace-tools/tests/test-envrc

SCRIPT_NAME=$(basename "$0")
ENVRC_FILE=".envrc"

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME [options] <command> [args...]

Manage configuration blocks within a .envrc file. Blocks are delimited by
managed marker comments so multiple configurations can co-exist safely. The
'env' block holds environment variables managed with set/unset/get.

Options:
  --output FILE  Path to the output file (default: .envrc)
  --help         Display this help message and exit

Commands:
  create <type> [args...]  Create a configuration block
  delete <type>            Delete an entire configuration block
  show <type>              Print a block's content
  list                     List active blocks
  set VAR VALUE            Set an environment variable in the env block
                           (creates the block if needed)
  unset VAR                Remove an environment variable from the env block
  get VAR                  Print a variable's value from any managed block
  catalog                  List available configuration types
  migrate skills [--dry-run] [--force]
                           Replace a legacy 'skills' block (from before
                           'skill' defaults): link its skills into the
                           workspace with 'skill add', then delete the block

Types:
  node [VERSION]           Adds Node.js direnv layout (default version: 24)
  ruby [VERSION]           Adds Ruby direnv layout (default version: 3.4)
  uv                       Adds Python uv direnv layout
  firebase <PROJECT_ID>    Adds Firebase project variables
  appengine <APP_ID> [URL] Adds Google App Engine variables
  block <NAME>             Adds a raw block named NAME; content is read from
                           stdin

Examples:
  $SCRIPT_NAME create node 22
  $SCRIPT_NAME create uv
  $SCRIPT_NAME list
  $SCRIPT_NAME set API_ORIGIN https://api.example.com
  $SCRIPT_NAME get API_ORIGIN
  $SCRIPT_NAME create block corp <corp-fragment.sh
  $SCRIPT_NAME delete node
  $SCRIPT_NAME migrate skills --dry-run

'set' writes single-quoted values, so values are always literal data: shell
syntax like \$(...) is never evaluated when direnv loads the file. 'get' reads
the file statically (no shell is executed) and unquotes simple single- or
double-quoted values.

'migrate skills' runs 'skill -C DIR' in the .envrc's directory. Names already
linked there or already defaults are skipped. Negated names ('-NAME', '!NAME')
have no equivalent yet and are dropped with a warning. The block is kept, and
the exit status is 1, if 'skill add' fails or, without --force, if a name does
not resolve or a line is not understood, so nothing is lost silently.
--dry-run (-n) prints the actions without changing anything. With no 'skills'
block it does nothing and exits 0.
EOF
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output)
      ENVRC_FILE="$2"
      shift 2
      ;;
    --help)
      usage
      ;;
    -*)
      echo "$SCRIPT_NAME: unknown option: $1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage
fi

COMMAND="$1"
shift

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$SCRIPT_NAME: $1 not found"
    exit 127
  }
}

is_known_type() {
  case "$1" in
    node | ruby | uv | firebase | appengine | block)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

block_exists() {
  [[ -f "$ENVRC_FILE" ]] && grep -qF "# >>> envrc managed block: $1 >>>" "$ENVRC_FILE"
}

# Print the lines between (excluding) a block's markers
get_block_content() {
  local mark_begin="# >>> envrc managed block: $1 >>>"
  local mark_end="# <<< envrc managed block: $1 <<<"
  awk -v s="$mark_begin" -v e="$mark_end" \
    '$0==s{b=1; next} $0==e{b=0; next} b{print}' "$ENVRC_FILE"
}

# Safely remove an existing managed block
remove_block() {
  local type="$1"
  local mark_begin="# >>> envrc managed block: $type >>>"
  local mark_end="# <<< envrc managed block: $type <<<"

  if [[ -f "$ENVRC_FILE" ]]; then
    local tmp
    tmp=$(mktemp)
    awk -v s="$mark_begin" -v e="$mark_end" \
      '$0==s{b=1; next} $0==e{b=0; next} !b{print}' "$ENVRC_FILE" >"$tmp"
    mv "$tmp" "$ENVRC_FILE"
  fi
}

# Append a new managed block
append_block() {
  local type="$1"
  local content="$2"
  local mark_begin="# >>> envrc managed block: $type >>>"
  local mark_end="# <<< envrc managed block: $type <<<"
  if [[ ! -f "$ENVRC_FILE" ]]; then
    printf '%s\n\n' '# -*- sh -*-' >"$ENVRC_FILE"
  fi
  touch "$ENVRC_FILE"
  {
    echo "$mark_begin"
    echo "$content"
    echo "$mark_end"
  } >>"$ENVRC_FILE"
}

allow_direnv() {
  if [[ "$ENVRC_FILE" == ".envrc" ]] && command -v direnv >/dev/null 2>&1; then
    direnv allow
    echo "$SCRIPT_NAME: changes take effect at the next prompt (run 'direnv reload' to apply them now)" >&2
  fi
}

# Replace a block's content (creating the block if it does not exist)
write_block() {
  remove_block "$1"
  append_block "$1" "$2"
}

# Quote a string in single quotes for literal inclusion in shell source
sq() {
  local s="$1"
  s="${s//\'/\'\\\'\'}"
  printf "'%s'" "$s"
}

# Strip simple single or double quotes from a value read from the file
unquote_value() {
  local v="$1"
  if [[ ${#v} -ge 2 && "$v" == \'*\' ]]; then
    v="${v:1:${#v}-2}"
    v="${v//\'\\\'\'/\'}"
  elif [[ ${#v} -ge 2 && "$v" == \"*\" ]]; then
    v="${v:1:${#v}-2}"
  fi
  printf '%s' "$v"
}

valid_var_name() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

# Print the name of the first managed block whose content exports VAR, if any
block_exporting_var() {
  [[ -f "$ENVRC_FILE" ]] || return 0
  awk -v var="$1" '
    /^# >>> envrc managed block: .* >>>$/ {
      name = $0
      sub(/^# >>> envrc managed block: /, "", name)
      sub(/ >>>$/, "", name)
      b = 1
      next
    }
    /^# <<< envrc managed block: .* <<<$/ { b = 0; next }
    b && $0 ~ ("^[[:space:]]*export[[:space:]]+" var "=") { print name; exit }
  ' "$ENVRC_FILE"
}

# Succeed if VAR is exported somewhere outside any managed block
var_exported_outside_blocks() {
  [[ -f "$ENVRC_FILE" ]] || return 1
  awk -v var="$1" '
    /^# >>> envrc managed block: .* >>>$/ { b = 1; next }
    /^# <<< envrc managed block: .* <<<$/ { b = 0; next }
    !b && $0 ~ ("^[[:space:]]*export[[:space:]]+" var "=") { found = 1; exit }
    END { exit !found }
  ' "$ENVRC_FILE"
}

cmd_list() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
  fi

  if [[ $# -ge 1 ]]; then
    echo "$SCRIPT_NAME list: unexpected argument: '$1'" >&2
    exit 1
  fi

  if [[ ! -f "$ENVRC_FILE" ]]; then
    echo "No active configurations (no $ENVRC_FILE found)"
    return
  fi

  local active_types
  active_types=$(sed -n 's/^# >>> envrc managed block: \(.*\) >>>/\1/p' "$ENVRC_FILE")

  if [[ -z "$active_types" ]]; then
    echo "No active configurations in $ENVRC_FILE"
  else
    echo "Active configurations in $ENVRC_FILE:"
    echo "  ${active_types//$'\\n'/$'\\n'  }"
  fi
}

cmd_catalog() {
  echo "Available types:"
  echo "  node [VERSION]           Node.js direnv layout"
  echo "  ruby [VERSION]           Ruby direnv layout"
  echo "  uv                       Python uv direnv layout"
  echo "  firebase PROJECT_ID      Firebase project variables"
  echo "  appengine APP_ID [URL]   Google App Engine variables"
  echo "  block NAME               Raw block; content is read from stdin"
}

cmd_show() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
  fi

  if [[ $# -lt 1 ]]; then
    echo "$SCRIPT_NAME show: missing configuration type" >&2
    exit 1
  fi

  local type="$1"
  if ! block_exists "$type"; then
    echo "$SCRIPT_NAME show: no '$type' block in $ENVRC_FILE" >&2
    exit 1
  fi
  get_block_content "$type"
}

cmd_set() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
  fi

  if [[ $# -lt 2 ]]; then
    echo "$SCRIPT_NAME set: usage: $SCRIPT_NAME set VAR VALUE" >&2
    exit 1
  fi

  local var="$1" value="$2"
  if ! valid_var_name "$var"; then
    echo "$SCRIPT_NAME set: invalid variable name: $var" >&2
    exit 1
  fi

  local owner
  owner=$(block_exporting_var "$var")
  if [[ -n "$owner" && "$owner" != "env" ]]; then
    echo "$SCRIPT_NAME set: $var is managed by the '$owner' block in $ENVRC_FILE" >&2
    exit 1
  fi
  if var_exported_outside_blocks "$var"; then
    echo "$SCRIPT_NAME: warning: $ENVRC_FILE already exports $var outside a managed block" >&2
  fi

  local content line kept=""
  if block_exists env; then
    content=$(get_block_content env)
    while IFS= read -r line; do
      if [[ "$line" =~ ^[[:space:]]*export[[:space:]]+$var= ]]; then
        continue
      fi
      kept="${kept:+$kept$'\n'}$line"
    done <<<"$content"
  fi
  kept="${kept:+$kept$'\n'}export $var=$(sq "$value")"

  write_block env "$kept"
  echo "$SCRIPT_NAME: set $var in $ENVRC_FILE" >&2
  allow_direnv
}

cmd_unset() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
  fi

  if [[ $# -lt 1 ]]; then
    echo "$SCRIPT_NAME unset: variable name required" >&2
    exit 1
  fi

  local var="$1"
  if ! valid_var_name "$var"; then
    echo "$SCRIPT_NAME unset: invalid variable name: $var" >&2
    exit 1
  fi

  local owner
  owner=$(block_exporting_var "$var")
  if [[ "$owner" != "env" ]]; then
    if [[ -n "$owner" ]]; then
      echo "$SCRIPT_NAME unset: $var is managed by the '$owner' block in $ENVRC_FILE" \
        "(use '$SCRIPT_NAME delete $owner' to remove that block)" >&2
    else
      echo "$SCRIPT_NAME unset: $var not set in the env block of $ENVRC_FILE" >&2
    fi
    exit 1
  fi

  local content line kept=""
  content=$(get_block_content env)
  while IFS= read -r line; do
    if [[ "$line" =~ ^[[:space:]]*export[[:space:]]+$var= ]]; then
      continue
    fi
    kept="${kept:+$kept$'\n'}$line"
  done <<<"$content"

  if [[ -z "${kept//[[:space:]]/}" ]]; then
    remove_block env
    echo "$SCRIPT_NAME: unset $var and removed the empty env block from $ENVRC_FILE" >&2
  else
    write_block env "$kept"
    echo "$SCRIPT_NAME: unset $var in $ENVRC_FILE" >&2
  fi
  allow_direnv
}

cmd_get() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
  fi

  if [[ $# -lt 1 ]]; then
    echo "$SCRIPT_NAME get: variable name required" >&2
    exit 1
  fi

  local var="$1"
  if ! valid_var_name "$var"; then
    echo "$SCRIPT_NAME get: invalid variable name: $var" >&2
    exit 1
  fi

  if [[ ! -f "$ENVRC_FILE" ]]; then
    echo "$SCRIPT_NAME get: no $ENVRC_FILE found" >&2
    exit 1
  fi

  local line
  line=$(awk -v var="$var" '
    /^# >>> envrc managed block: .* >>>$/ { b = 1; next }
    /^# <<< envrc managed block: .* <<<$/ { b = 0; next }
    b && $0 ~ ("^[[:space:]]*export[[:space:]]+" var "=") { print; exit }
  ' "$ENVRC_FILE")
  if [[ -z "$line" ]]; then
    echo "$SCRIPT_NAME get: $var not found in any managed block of $ENVRC_FILE" >&2
    exit 1
  fi

  line="${line#"${line%%[![:space:]]*}"}"
  line="${line#export}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line#"$var"=}"
  printf '%s\n' "$(unquote_value "$line")"
}

cmd_delete() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
  fi

  if [[ $# -lt 1 ]]; then
    echo "$SCRIPT_NAME delete: missing configuration type" >&2
    exit 1
  fi

  local type="$1"
  if ! block_exists "$type"; then
    echo "$SCRIPT_NAME delete: no '$type' block in $ENVRC_FILE" >&2
    return
  fi
  remove_block "$type"

  echo "$SCRIPT_NAME: deleted '$type' configuration block from $ENVRC_FILE" >&2
  allow_direnv
}

# Print the names in a legacy 'skills' block, one per line, as written
# (negations included). Understands 'skills NAME...' lines (any number) and the
# older 'export AGENT_REQUIRED_SKILLS="$AGENT_REQUIRED_SKILLS NAME..."' form.
# Any other non-comment line is printed to fd 3 instead.
read_legacy_skills() {
  local line trimmed rest
  # shellcheck disable=SC2016 # a literal '$AGENT_REQUIRED_SKILLS' is matched
  local legacy_re='^export[[:space:]]+AGENT_REQUIRED_SKILLS="\$AGENT_REQUIRED_SKILLS([^"]*)"$'
  while IFS= read -r line; do
    trimmed="${line#"${line%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    if [[ -z "$trimmed" || "$trimmed" == "#"* ]]; then
      continue
    fi
    if [[ "$trimmed" == "skills" ]]; then
      continue
    elif [[ "$trimmed" == skills[[:space:]]* ]]; then
      rest="${trimmed#skills}"
    elif [[ "$trimmed" =~ $legacy_re ]]; then
      rest="${BASH_REMATCH[1]}"
    else
      printf '%s\n' "$trimmed" >&3
      continue
    fi
    # Word-split without globbing (names like '!foo' or '*' stay literal).
    set -f
    # shellcheck disable=SC2086 # deliberate word splitting of the name list
    printf '%s\n' $rest
    set +f
  done <<<"$(get_block_content skills)"
}

# Print the first column of 'skill ... list' (the link names), space-padded
# for membership tests: " a b c ".
skill_link_names() {
  local names
  names=$(skill "$@" list 2>/dev/null | awk '{print $1}' | tr '\n' ' ') || names=""
  printf ' %s ' "$names"
}

cmd_migrate() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
  fi

  local type="" dry_run=0 force=0 arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run | -n) dry_run=1 ;;
      --force) force=1 ;;
      -*)
        echo "$SCRIPT_NAME migrate: unknown option: $arg" >&2
        exit 1
        ;;
      *)
        if [[ -n "$type" ]]; then
          echo "$SCRIPT_NAME migrate: unexpected argument: '$arg'" >&2
          exit 1
        fi
        type="$arg"
        ;;
    esac
  done
  if [[ "$type" != "skills" ]]; then
    echo "$SCRIPT_NAME migrate: usage: $SCRIPT_NAME migrate skills [--dry-run] [--force]" >&2
    exit 1
  fi

  if ! block_exists skills; then
    echo "$SCRIPT_NAME migrate: no 'skills' block in $ENVRC_FILE; nothing to migrate" >&2
    return 0
  fi

  local dir names unknown
  dir=$(dirname "$ENVRC_FILE")
  unknown=$(read_legacy_skills 3>&1 >/dev/null)
  names=$(read_legacy_skills 3>/dev/null)

  local positives=() name
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    case "$name" in
      -* | !*)
        echo "$SCRIPT_NAME migrate: warning: dropping '$name': opting a workspace" \
          "out of a default skill has no equivalent yet" >&2
        ;;
      *) positives+=("$name") ;;
    esac
  done <<<"$names"

  local failed=0 unresolved=() to_add=() linked defaults src base
  if [[ ${#positives[@]} -gt 0 ]]; then
    require skill
    linked=$(skill_link_names -C "$dir")
    defaults=$(skill_link_names --scope defaults)
    for name in "${positives[@]}"; do
      if ! src=$(skill -C "$dir" resolve "$name" 2>/dev/null) || [[ -z "$src" ]]; then
        unresolved+=("$name")
        echo "$SCRIPT_NAME migrate: warning: cannot resolve skill '$name'" >&2
        continue
      fi
      base=$(basename "$src")
      if [[ "$linked" == *" $base "* ]]; then
        echo "$SCRIPT_NAME migrate: '$name' is already linked" >&2
      elif [[ "$defaults" == *" $base "* ]]; then
        echo "$SCRIPT_NAME migrate: '$name' is a default ('skill add --defaults' links it)" >&2
      else
        to_add+=("$name")
      fi
    done
  fi

  if [[ ${#to_add[@]} -gt 0 ]]; then
    if [[ $dry_run -eq 1 ]]; then
      echo "$SCRIPT_NAME migrate: would run: skill -C $dir add ${to_add[*]}" >&2
    elif skill -C "$dir" add --quiet "${to_add[@]}"; then
      echo "$SCRIPT_NAME migrate: added ${to_add[*]}" >&2
    else
      echo "$SCRIPT_NAME migrate: error: 'skill add ${to_add[*]}' failed" >&2
      failed=1
    fi
  fi

  local keep_reason=""
  if [[ $failed -eq 1 ]]; then
    keep_reason="a skill could not be added"
  elif [[ $force -eq 0 && ${#unresolved[@]} -gt 0 ]]; then
    keep_reason="unresolved: ${unresolved[*]}"
  elif [[ $force -eq 0 && -n "$unknown" ]]; then
    keep_reason="unrecognized line(s): $(printf '%s' "$unknown" | tr '\n' ';')"
  fi
  if [[ -n "$keep_reason" ]]; then
    local kept="kept"
    [[ $dry_run -eq 0 ]] || kept="would keep"
    echo "$SCRIPT_NAME migrate: $kept the skills block in $ENVRC_FILE ($keep_reason)" >&2
    [[ $failed -eq 1 ]] ||
      echo "$SCRIPT_NAME migrate: to drop it anyway: $SCRIPT_NAME migrate skills --force" >&2
    exit 1
  fi

  if [[ $dry_run -eq 1 ]]; then
    echo "$SCRIPT_NAME migrate: would delete the skills block from $ENVRC_FILE" >&2
    return 0
  fi

  remove_block skills
  echo "$SCRIPT_NAME: deleted the 'skills' block from $ENVRC_FILE" >&2
  if ! grep -qv -e '^[[:space:]]*$' -e '^# -\*- sh -\*-$' "$ENVRC_FILE"; then
    echo "$SCRIPT_NAME migrate: $ENVRC_FILE is now empty (kept)" >&2
  fi
  if [[ "$ENVRC_FILE" == ".envrc" ]]; then
    allow_direnv
  elif command -v direnv >/dev/null 2>&1; then
    echo "$SCRIPT_NAME migrate: run 'direnv allow $dir' to approve the change" >&2
  fi
}

cmd_create() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
  fi

  if [[ $# -lt 1 ]]; then
    echo "$SCRIPT_NAME create: missing configuration type" >&2
    exit 1
  fi

  local type="$1"
  shift
  local content=""
  local block_name="$type"

  case "$type" in
    node)
      if [[ -z "${NODE_VERSIONS:-}" || ! -d "$NODE_VERSIONS" ]]; then
        echo "$SCRIPT_NAME: error: NODE_VERSIONS not set, or not a directory" >&2
        exit 1
      fi
      local version="${1:-24}"
      content=$(
        cat <<EOF
use node $version
layout node
EOF
      )
      ;;

    ruby)
      if [[ -z "${RUBY_VERSIONS:-}" || ! -d "$RUBY_VERSIONS" ]]; then
        echo "$SCRIPT_NAME: error: RUBY_VERSIONS not set, or not a directory" >&2
        exit 1
      fi
      local version="${1:-3.4}"
      content=$(
        cat <<EOF
use ruby $version
layout ruby
EOF
      )
      ;;

    uv)
      content="layout uv"
      ;;

    block)
      if [[ $# -lt 1 ]]; then
        echo "$SCRIPT_NAME create block: missing block NAME" >&2
        exit 1
      fi
      block_name="$1"
      case "$block_name" in
        git-identity-beebo | node | ruby | uv | firebase | appengine | env | block)
          echo "$SCRIPT_NAME create block: '$block_name' is a reserved block name" >&2
          exit 1
          ;;
      esac
      if [[ ! "$block_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "$SCRIPT_NAME create block: invalid block name: $block_name" >&2
        exit 1
      fi
      if [[ -t 0 ]]; then
        echo "$SCRIPT_NAME create block: content must be provided on stdin" >&2
        exit 1
      fi
      content=$(cat)
      if [[ -z "${content//[[:space:]]/}" ]]; then
        echo "$SCRIPT_NAME create block: empty content on stdin" >&2
        exit 1
      fi
      ;;

    firebase)
      if [[ $# -lt 1 ]]; then
        echo "$SCRIPT_NAME create firebase: missing PROJECT_ID" >&2
        exit 1
      fi
      require firebase
      local project_id="$1"
      local project_url="${2:-https://${project_id}.firebaseapp.com}/"

      if ! firebase projects:list | grep -q "$project_id"; then
        echo "$SCRIPT_NAME: error: $project_id not a configured project (see firebase projects:list)" >&2
        exit 1
      fi

      content=$(
        cat <<EOF
export FIREBASE_PROJECT_ID="$project_id"
export FIREBASE_PROJECT_URL="$project_url"
EOF
      )
      ;;

    appengine)
      if [[ $# -lt 1 ]]; then
        echo "$SCRIPT_NAME create appengine: missing APP_ID" >&2
        exit 1
      fi
      local app_id="$1"
      local url="${2:-}"
      content=$(
        cat <<EOF
export GAE_APP_ID="$app_id"
export GAE_URL="$url"
EOF
      )
      ;;

    *)
      echo "$SCRIPT_NAME: unknown configuration type: $type" >&2
      exit 1
      ;;
  esac

  write_block "$block_name" "$content"

  echo "$SCRIPT_NAME: created '$block_name' configuration block in $ENVRC_FILE" >&2
  allow_direnv
}

case "$COMMAND" in
  help)
    usage
    ;;
  create)
    cmd_create "$@"
    ;;
  delete)
    cmd_delete "$@"
    ;;
  list)
    cmd_list "$@"
    ;;
  migrate)
    cmd_migrate "$@"
    ;;
  show)
    cmd_show "$@"
    ;;
  set)
    cmd_set "$@"
    ;;
  unset)
    cmd_unset "$@"
    ;;
  get)
    cmd_get "$@"
    ;;
  catalog | types)
    cmd_catalog
    ;;
  *)
    echo "$SCRIPT_NAME: unknown command: $COMMAND" >&2
    echo "Try '$SCRIPT_NAME --help' for more information." >&2
    exit 1
    ;;
esac
