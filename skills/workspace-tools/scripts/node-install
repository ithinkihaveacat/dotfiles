#!/usr/bin/env bash

# Installs a specific version of Node.js to a given prefix directory.
# Based on https://github.com/wilmoore/nodejs-install

# Tests: skills/workspace-tools/tests/test-node-install (--default)

set -o errexit
set -o errtrace
set -o nounset

readonly DEFAULT_PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/node/versions"
# The per-user default is a link beside the versions directory, so neither
# --installed nor direnv's 'use node' (which globs node-v*) mistakes it for a
# version.
readonly DEFAULT_LINK="${XDG_DATA_HOME:-$HOME/.local/share}/node/default"

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] VERSION [PREFIX]
       $(basename "$0") --list
       $(basename "$0") --installed
       $(basename "$0") --default [VERSION]

Downloads and installs a specific version of Node.js.

Arguments:
  VERSION     Node.js version to install. Supports partial versions:
              - "22.13.1" installs exactly v22.13.1
              - "22.13" installs the latest v22.13.x
              - "22" installs the latest v22.x.x
  PREFIX      Directory where Node.js will be installed (optional).
              A subdirectory named node-vVERSION will be created.
              Default: \$XDG_DATA_HOME/node/versions or ~/.local/share/node/versions

Options:
  -l, --list       List all available remote Node.js versions
  -i, --installed  List all installed Node.js versions
  --default [VERSION]
                   Install VERSION if it is missing (succeeding if it is
                   already installed) and make it the per-user default,
                   \$XDG_DATA_HOME/node/default; print its path. Without
                   VERSION, print the current default's path
  --help           Display this help message and exit

Examples:
  # Install latest Node.js 22.x
  $(basename "$0") 22

  # List available versions
  $(basename "$0") --list

  # List installed versions
  $(basename "$0") --installed

  # Make the latest Node.js 24.x the default outside direnv workspaces
  $(basename "$0") --default 24

The default is for machines whose package manager has no recent enough
Node.js: put \$XDG_DATA_HOME/node/default/bin on PATH to use it. Global npm
packages are unaffected by switching it, provided npm's prefix (~/.npmrc) is
outside the version directories.
EOF
  exit 0
}

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

# Infer operating system identifier for Node.js downloads.
get_os() {
  uname | tr '[:upper:]' '[:lower:]'
}

# Infer architecture identifier for Node.js downloads.
get_arch() {
  local machine
  machine=$(uname -m)
  case "$machine" in
    x86_64)
      echo "x64"
      ;;
    aarch64 | arm64)
      echo "arm64"
      ;;
    armv7l)
      echo "armv7l"
      ;;
    *)
      echo "$(basename "$0"): unsupported architecture: $machine" >&2
      exit 1
      ;;
  esac
}

# Build platform identifier (e.g., linux-x64, darwin-arm64).
get_platform() {
  echo "$(get_os)-$(get_arch)"
}

# List all downloadable Node.js versions.
list_versions() {
  curl -fsSL https://nodejs.org/dist/ |
    grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' |
    sort -t. -u -k 1.2,1n -k 2,2n -k 3,3n
}

# List locally installed versions.
list_installed() {
  local dir="${1:-$DEFAULT_PREFIX}"
  if [[ ! -d "$dir" ]]; then
    echo "$(basename "$0"): no versions found in $dir" >&2
    return
  fi

  find "$dir" -maxdepth 1 -name "node-v*" -type d |
    sed 's|.*/node-||' |
    sort -V
}

# Resolve a partial version to the highest matching full version.
# Supports: "24" -> "24.x.x", "24.1" -> "24.1.x", "24.1.0" -> "24.1.0"
# Returns the full version number (without 'v' prefix) or empty if not found.
resolve_version() {
  local input="$1"
  local prefix="${2:-}"
  local pattern

  # An exact version that is already installed needs no network.
  if [[ "$input" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && -n "$prefix" && -d "$prefix/node-v$input" ]]; then
    echo "$input"
    return
  fi

  # Count dots to determine version specificity
  # Note: Use arithmetic expansion to handle macOS wc whitespace padding
  local dots
  dots=$(($(echo "$input" | tr -cd '.' | wc -c)))

  case "$dots" in
    0) pattern="^v${input}\\." ;; # "24" matches "v24.*"
    1) pattern="^v${input}\\." ;; # "24.1" matches "v24.1.*"
    2) pattern="^v${input}$" ;;   # "24.1.0" matches exactly
    *) pattern="^v${input}$" ;;
  esac

  list_versions | grep -E "$pattern" | tail -1 | tr -d 'v'
}

# Handle --help first so it works even without dependencies installed.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
fi

require curl
require tar

# Download and extract Node.js $1 into $2, removing the partial directory on
# failure. Progress goes to stderr; only the caller prints to stdout.
install_version() {
  local version=$1 target=$2 url
  url="https://nodejs.org/dist/v$version/node-v$version-$(get_platform).tar.gz"
  mkdir -p "$target"
  # shellcheck disable=SC2064 # expand $target now
  trap "rm -rf '$target'" EXIT
  echo "Downloading Node.js v$version for $(get_platform)..." >&2
  curl -fL# "$url" | tar xz --strip-components=1 -C "$target"
  trap - EXIT
}

# Resolve VERSION_INPUT against PREFIX into VERSION, or exit with an error.
resolve_or_exit() {
  VERSION=$(resolve_version "$VERSION_INPUT" "$PREFIX")
  if [[ -z "$VERSION" ]]; then
    echo "$(basename "$0"): no Node.js version matching '$VERSION_INPUT' found" >&2
    echo "Use '$(basename "$0") --list' to see available versions." >&2
    exit 1
  fi
}

# Handle --list, --installed and --default before checking argument count
case "${1:-}" in
  -l | --list)
    list_versions
    exit 0
    ;;
  -i | --installed)
    PREFIX="${2:-$DEFAULT_PREFIX}"
    list_installed "$PREFIX"
    exit 0
    ;;
  --default)
    if [[ $# -gt 2 ]]; then
      echo "$(basename "$0"): --default takes at most one argument (VERSION)" >&2
      exit 1
    fi
    if [[ $# -eq 1 ]]; then
      if [[ ! -L "$DEFAULT_LINK" ]]; then
        echo "$(basename "$0"): no default Node.js version ($DEFAULT_LINK does not exist)" >&2
        exit 1
      fi
      if [[ ! -d "$DEFAULT_LINK/" ]]; then
        echo "$(basename "$0"): default Node.js version is missing: $DEFAULT_LINK -> $(readlink "$DEFAULT_LINK")" >&2
        exit 1
      fi
      echo "$(dirname "$DEFAULT_LINK")/$(readlink "$DEFAULT_LINK")"
      exit 0
    fi
    if [[ -e "$DEFAULT_LINK" && ! -L "$DEFAULT_LINK" ]]; then
      echo "$(basename "$0"): refusing to replace $DEFAULT_LINK: not a symbolic link" >&2
      exit 1
    fi
    VERSION_INPUT=$(echo "$2" | tr -d 'vV')
    PREFIX="$DEFAULT_PREFIX"
    resolve_or_exit
    TARGET="$PREFIX/node-v$VERSION"
    if [[ ! -d "$TARGET" ]]; then
      install_version "$VERSION" "$TARGET"
    fi
    # Relative, so the link names the version it selects.
    new="$(basename "$PREFIX")/node-v$VERSION"
    old=$(readlink "$DEFAULT_LINK" 2>/dev/null || true)
    if [[ "$old" != "$new" ]]; then
      ln -sfn "$new" "$DEFAULT_LINK"
      echo "default: node-v$VERSION${old:+ (was $(basename "$old"))}" >&2
    fi
    echo "$TARGET"
    exit 0
    ;;
esac

# Show help if no arguments provided
if [[ $# -lt 1 ]]; then
  usage
fi

# Parse positional arguments
VERSION_INPUT=$(echo "$1" | tr -d 'vV')
PREFIX="${2:-$DEFAULT_PREFIX}"

# Resolve partial version to full version (e.g., "24" -> "24.1.0")
resolve_or_exit

TARGET="$PREFIX/node-v$VERSION"

# Check for existing installation
if [[ -d "$TARGET" ]]; then
  echo "$(basename "$0"): '$TARGET' already exists" >&2
  exit 1
fi

install_version "$VERSION" "$TARGET"

echo "$TARGET"
echo "Tip: use direnv to switch Node.js versions. See ~/.direnvrc for usage." >&2
