#!/usr/bin/env bash

# Installs a specific version of Node.js to a given prefix directory.
# Based on https://github.com/wilmoore/nodejs-install

# Tests: skills/workspace-tools/tests/test-node-install

set -o errexit
set -o errtrace
set -o nounset
set -o pipefail

readonly DEFAULT_PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/node/versions"
# The per-user default is a link beside the versions directory, so neither
# --installed nor direnv's 'use node' (which globs node-v*) mistakes it for a
# version.
readonly DEFAULT_LINK="${XDG_DATA_HOME:-$HOME/.local/share}/node/default"

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] VERSION [PREFIX]
       $(basename "$0") --list
       $(basename "$0") --installed [--paths] [PREFIX]
       $(basename "$0") --paths [PREFIX]
       $(basename "$0") --default [VERSION]

Downloads and installs a specific version of Node.js.

Arguments:
  VERSION     Node.js version to install. Supports partial versions:
              - "22.13.1" installs exactly v22.13.1
              - "22.13" installs the latest v22.13.x
              - "22" installs the latest v22.x.x
  PREFIX      Directory where Node.js will be installed (optional).
              Each version is installed in a PREFIX/node-vVERSION directory.
              Default: \$XDG_DATA_HOME/node/versions or ~/.local/share/node/versions

Options:
  -l, --list       List all available remote Node.js versions
  -i, --installed  List installed Node.js version tags (vX.Y.Z, installed under
                   PREFIX/node-vX.Y.Z; combine with --paths for full paths)
  --paths          Print full PREFIX/node-vX.Y.Z directory paths for installed
                   versions
  --default [VERSION]
                   Install VERSION if it is missing (succeeding if it is
                   already installed) and make it the per-user default,
                   \$XDG_DATA_HOME/node/default; print its path. Without
                   VERSION, print the current default's path
  --help, -h       Display this help message and exit

Environment:
  AGENT_OFFLINE    Never use the network; fail on uncached downloads or --list
  XDG_DATA_HOME    Base directory for versions and default link
                   (default: ~/.local/share)

Examples:
  # Install latest Node.js 22.x
  $(basename "$0") 22

  # List available versions
  $(basename "$0") --list

  # List installed versions (tags or full paths)
  $(basename "$0") --installed
  $(basename "$0") --installed --paths

  # Make the latest Node.js 24.x the default outside direnv workspaces
  $(basename "$0") --default 24

The default is for machines whose package manager has no recent enough
Node.js: put \$XDG_DATA_HOME/node/default/bin (~/.local/share/node/default/bin)
on PATH to use it. Global npm packages are unaffected by switching it,
provided npm's prefix (~/.npmrc) is outside the version directories.
EOF
  exit 0
}

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

is_offline() {
  case "$(printf '%s' "${AGENT_OFFLINE:-}" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | on) return 0 ;;
    *) return 1 ;;
  esac
}

# Infer operating system identifier for Node.js downloads.
get_os() {
  uname | tr '[:upper:]' '[:lower:]'
}

# Infer architecture identifier for Node.js downloads.
get_arch() {
  local machine
  machine=$(uname -m)
  case "$machine" in
    x86_64)
      echo "x64"
      ;;
    aarch64 | arm64)
      echo "arm64"
      ;;
    armv7l)
      echo "armv7l"
      ;;
    *)
      echo "$(basename "$0"): unsupported architecture: $machine" >&2
      exit 1
      ;;
  esac
}

# Build platform identifier (e.g., linux-x64, darwin-arm64).
get_platform() {
  echo "$(get_os)-$(get_arch)"
}

# List all downloadable Node.js versions.
list_versions() {
  if is_offline; then
    echo "$(basename "$0"): refusing to fetch https://nodejs.org/dist/ (offline mode); unset AGENT_OFFLINE to allow it" >&2
    return 1
  fi
  require curl
  curl -fsSL https://nodejs.org/dist/ |
    grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' |
    sort -t. -u -k 1.2,1n -k 2,2n -k 3,3n
}

# List locally installed versions.
list_installed() {
  local dir="${1:-$DEFAULT_PREFIX}" show_paths="${2:-0}"
  if [[ ! -d "$dir" ]]; then
    echo "$(basename "$0"): no versions found in $dir" >&2
    return
  fi

  local tags tag
  tags=$(
    find "$dir" -maxdepth 1 -name "node-v*" -type d |
      sed 's|.*/node-||' |
      sort -V
  )
  if [[ -z "$tags" ]]; then
    return
  fi
  if [[ "$show_paths" -eq 1 ]]; then
    while IFS= read -r tag; do
      [[ -n "$tag" ]] && printf '%s/node-%s\n' "${dir%/}" "$tag"
    done <<<"$tags"
  else
    printf '%s\n' "$tags"
  fi
}

# Resolve a partial version to the highest matching full version.
# Supports: "24" -> "24.x.x", "24.1" -> "24.1.x", "24.1.0" -> "24.1.0"
# Returns the full version number (without 'v' prefix) or empty if not found.
resolve_version() {
  local input="$1"
  local prefix="${2:-}"
  local pattern

  # An exact version that is already installed needs no network.
  if [[ "$input" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && -n "$prefix" && -d "$prefix/node-v$input" ]]; then
    echo "$input"
    return
  fi

  # Count dots to determine version specificity
  # Note: Use arithmetic expansion to handle macOS wc whitespace padding
  local dots
  dots=$(($(echo "$input" | tr -cd '.' | wc -c)))

  case "$dots" in
    0) pattern="^v${input}\\." ;; # "24" matches "v24.*"
    1) pattern="^v${input}\\." ;; # "24.1" matches "v24.1.*"
    2) pattern="^v${input}$" ;;   # "24.1.0" matches exactly
    *) pattern="^v${input}$" ;;
  esac

  local versions
  versions=$(list_versions) || return 1
  printf '%s\n' "$versions" | { grep -E "$pattern" || true; } | tail -1 | tr -d 'v'
}

# Download and extract Node.js $1 into $2. It is extracted beside $2 and
# renamed into place, so an interrupted run never leaves a partial $2 for a
# later run to mistake for an installed version. Progress goes to stderr; only
# the caller prints to stdout.
install_version() {
  local version=$1 target=$2 url tmp
  if is_offline; then
    echo "$(basename "$0"): refusing to download Node.js v$version (offline mode); unset AGENT_OFFLINE to allow it" >&2
    exit 1
  fi
  require curl
  require tar
  url="https://nodejs.org/dist/v$version/node-v$version-$(get_platform).tar.gz"
  mkdir -p "$(dirname "$target")"
  tmp=$(mktemp -d "$(dirname "$target")/.node-v$version.XXXXXX")
  # shellcheck disable=SC2064 # expand $tmp now
  trap "rm -rf '$tmp'" EXIT
  echo "Downloading Node.js v$version for $(get_platform)..." >&2
  curl -fL# "$url" | tar xz --strip-components=1 -C "$tmp"
  # A concurrent run may have finished first; keep its copy.
  if [[ -d "$target" ]]; then
    rm -rf "$tmp"
  else
    mv "$tmp" "$target"
  fi
  trap - EXIT
}

# Resolve VERSION_INPUT against PREFIX into VERSION, or exit with an error.
resolve_or_exit() {
  if ! VERSION=$(resolve_version "$VERSION_INPUT" "$PREFIX"); then
    echo "$(basename "$0"): failed to fetch the list of Node.js versions from https://nodejs.org/dist/" >&2
    exit 1
  fi
  if [[ -z "$VERSION" ]]; then
    echo "$(basename "$0"): no Node.js version matching '$VERSION_INPUT' found" >&2
    echo "Use '$(basename "$0") --list' to see available versions." >&2
    exit 1
  fi
}

for ARG in "$@"; do
  case "$ARG" in
    --help | -h) usage ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage
fi

MODE=""
SHOW_PATHS=0
POSITIONALS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -l | --list)
      MODE="list"
      shift
      ;;
    -i | --installed)
      MODE="installed"
      shift
      ;;
    --paths)
      SHOW_PATHS=1
      [[ -z "$MODE" ]] && MODE="installed"
      shift
      ;;
    --default)
      MODE="default"
      shift
      ;;
    -*)
      echo "$(basename "$0"): unknown option: $1" >&2
      exit 1
      ;;
    *)
      POSITIONALS+=("$1")
      shift
      ;;
  esac
done

case "$MODE" in
  list)
    if [[ ${#POSITIONALS[@]} -gt 0 ]]; then
      echo "$(basename "$0"): --list takes no positional arguments" >&2
      exit 1
    fi
    list_versions
    exit 0
    ;;
  installed)
    if [[ ${#POSITIONALS[@]} -gt 1 ]]; then
      echo "$(basename "$0"): --installed takes at most one argument (PREFIX)" >&2
      exit 1
    fi
    PREFIX="${POSITIONALS[0]:-$DEFAULT_PREFIX}"
    list_installed "$PREFIX" "$SHOW_PATHS"
    exit 0
    ;;
  default)
    if [[ ${#POSITIONALS[@]} -gt 1 ]]; then
      echo "$(basename "$0"): --default takes at most one argument (VERSION)" >&2
      exit 1
    fi
    if [[ ${#POSITIONALS[@]} -eq 0 ]]; then
      if [[ ! -L "$DEFAULT_LINK" ]]; then
        echo "$(basename "$0"): no default Node.js version ($DEFAULT_LINK does not exist)" >&2
        exit 1
      fi
      if [[ ! -d "$DEFAULT_LINK/" ]]; then
        echo "$(basename "$0"): default Node.js version is missing: $DEFAULT_LINK -> $(readlink "$DEFAULT_LINK")" >&2
        exit 1
      fi
      echo "$(dirname "$DEFAULT_LINK")/$(readlink "$DEFAULT_LINK")"
      exit 0
    fi
    if [[ -e "$DEFAULT_LINK" && ! -L "$DEFAULT_LINK" ]]; then
      echo "$(basename "$0"): refusing to replace $DEFAULT_LINK: not a symbolic link" >&2
      exit 1
    fi
    VERSION_INPUT=$(echo "${POSITIONALS[0]}" | tr -d 'vV')
    PREFIX="$DEFAULT_PREFIX"
    resolve_or_exit
    TARGET="$PREFIX/node-v$VERSION"
    if [[ ! -d "$TARGET" ]]; then
      install_version "$VERSION" "$TARGET"
    fi
    # Relative, so the link names the version it selects.
    new="$(basename "$PREFIX")/node-v$VERSION"
    old=$(readlink "$DEFAULT_LINK" 2>/dev/null || true)
    if [[ "$old" != "$new" ]]; then
      ln -sfn "$new" "$DEFAULT_LINK"
      echo "default: node-v$VERSION${old:+ (was $(basename "$old"))}" >&2
    fi
    echo "$TARGET"
    exit 0
    ;;
esac

if [[ ${#POSITIONALS[@]} -lt 1 ]]; then
  usage
fi

# Parse positional arguments
VERSION_INPUT=$(echo "${POSITIONALS[0]}" | tr -d 'vV')
PREFIX="${POSITIONALS[1]:-$DEFAULT_PREFIX}"

# Resolve partial version to full version (e.g., "24" -> "24.1.0")
resolve_or_exit

TARGET="$PREFIX/node-v$VERSION"

# Check for existing installation
if [[ -d "$TARGET" ]]; then
  echo "$(basename "$0"): '$TARGET' already exists" >&2
  exit 1
fi

install_version "$VERSION" "$TARGET"

echo "$TARGET"
echo "Tip: use direnv to switch Node.js versions. See ~/.direnvrc for usage." >&2
