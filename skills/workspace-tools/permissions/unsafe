# Commands that 'permission apply' must not pre-approve.
# An agent must never be able to edit its own allowlist unprompted.
permission add
permission clean
permission remove
permission rm
# 'envrc create block' writes arbitrary stdin content into .envrc, which
# direnv executes as shell on the next load; always prompt for it.
envrc create block
# 'envrc delete' removes managed configuration blocks.
envrc delete
# Modifying or destructive hook commands must not be run unprompted by agents.
# 'hook add' installs new commit hooks and can fetch remote code (e.g. gerrit).
hook add
hook clean
hook remove
hook rm

# 'ruby-install' compiles Ruby from source for several minutes and writes
# into $RUBY_VERSIONS; always prompt. 'node-install' only downloads official
# release binaries, so it stays pre-approved.
ruby-install
