# Baseline default skills linked into the user scope (~/.claude/skills,
# ~/.agents/skills, ~/.gemini/config/skills) by install.sh.
#
# install.sh reconciles --scope user against the union of etc/skill/defaults
# across ~/.dotfiles and active overlays, plus optional
# ${XDG_CONFIG_HOME:-~/.config}/skill/defaults, removing unlisted managed
# symlinks automatically. Prefix a name with '-' (e.g. '-taskgo') to exclude an
# inherited entry on a specific overlay or machine.
agent-tools
coding-standards
workspace-tools
agent-config
technical-writing
taskgo
