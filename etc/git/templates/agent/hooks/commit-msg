#!/bin/sh
# git-hooks-agent: commit-msg
# Strips Co-Authored-By trailers, rewraps over-long body/footer lines, and
# enforces commit message formatting.

msg_file="$1"

# Strip Co-Authored-By lines and any trailing blank lines they leave behind,
# preserving git's comment lines (lines beginning with #).
tmpfile=$(mktemp "${msg_file}.XXXXXX") || {
  echo "commit-msg: mktemp failed" >&2
  exit 1
}
if ! awk '
  /^#/               { comments[++nc] = $0; next }
                     { lines[++nl] = $0 }
  END {
    while (nl > 0 && lines[nl] ~ /^[[:space:]]*$/) nl--
    while (nl > 0 && (lines[nl] ~ /^Co-Authored-By:/ || lines[nl] ~ /^TAG=/ || lines[nl] ~ /^CONV=/)) {
      nl--
    }
    while (nl > 0 && lines[nl] ~ /^[[:space:]]*$/) nl--
    for (i = 1; i <= nl; i++) print lines[i]
    for (i = 1; i <= nc; i++) print comments[i]
  }
' "$msg_file" >"$tmpfile"; then
  rm -f "$tmpfile"
  echo "commit-msg: failed to rewrite message file" >&2
  exit 1
fi
mv "$tmpfile" "$msg_file"

# Skip format checks (and the rewrap below) for auto-generated messages.
cleaned=$(grep -v "^#" "$msg_file")
subject=$(printf '%s\n' "$cleaned" | head -1)
case "$subject" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

# Rewrap body/footer lines over 72 characters in place: a deterministic,
# meaning-preserving transform an author (or agent) can't reliably do by
# eye, so there is no reason to reject it and force a round trip. Opt out
# with: git config hooks.commitMsgWrap false
wrap_enabled=1
case "$(git config hooks.commitMsgWrap 2>/dev/null)" in
  false | 0 | no) wrap_enabled=0 ;;
esac

if [ "$wrap_enabled" -eq 1 ]; then
  if command -v uv >/dev/null 2>&1; then
    # A cold uv cache, a missing interpreter, or no network can all make
    # this fail; when it does, fall back to the strict check below rather
    # than silently letting an over-long line through.
    if ! cat <<'PYEOF' | uv run --script - "$msg_file"; then
# /// script
# requires-python = ">=3.9"
# dependencies = []
# ///
"""Rewrap a commit message's body/footer to 72 characters in place."""
import re
import subprocess
import sys
import textwrap

WIDTH = 72

FENCE_RE = re.compile(r"^(\s*)(`{3,}|~{3,})")
BULLET_RE = re.compile(r"^(\s*)([-*+]|\d+[.)])(\s+)(.*)$")
LEADING_WS_RE = re.compile(r"^[ \t]*")


def find_trailer_start(lines):
    """Index where a trailing git-trailer block begins in lines, or None."""
    if not lines:
        return None
    text = "\n".join(lines) + "\n"
    try:
        result = subprocess.run(
            ["git", "interpret-trailers", "--only-trailers", "--only-input", "--no-divider"],
            input=text,
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    trailer_lines = result.stdout.splitlines()
    if not trailer_lines or len(trailer_lines) > len(lines):
        return None
    start = len(lines) - len(trailer_lines)
    if lines[start:] == trailer_lines:
        return start
    return None


def wrap_block(lines):
    """Reflow prose/bullets to WIDTH; pass fences, tables and indented
    blocks through untouched."""
    out = []
    i = 0
    n = len(lines)

    prose_buffer = []
    bullet_marker = None
    bullet_indent = None
    bullet_buffer = []

    def flush_prose():
        nonlocal prose_buffer
        if prose_buffer:
            text = " ".join(prose_buffer)
            wrapped = textwrap.wrap(text, width=WIDTH, break_long_words=False, break_on_hyphens=False)
            out.extend(wrapped or [""])
            prose_buffer = []

    def flush_bullet():
        nonlocal bullet_marker, bullet_indent, bullet_buffer
        if bullet_marker is not None:
            text = " ".join(bullet_buffer)
            indent = " " * len(bullet_marker)
            wrapped = textwrap.wrap(
                text,
                width=WIDTH,
                initial_indent=bullet_marker,
                subsequent_indent=indent,
                break_long_words=False,
                break_on_hyphens=False,
            )
            out.extend(wrapped or [bullet_marker.rstrip()])
            bullet_marker = None
            bullet_indent = None
            bullet_buffer = []

    while i < n:
        line = lines[i]

        fence_match = FENCE_RE.match(line)
        if fence_match:
            flush_prose()
            flush_bullet()
            token = fence_match.group(2)
            out.append(line)
            i += 1
            close_re = re.compile(r"^\s*" + re.escape(token) + r"\s*$")
            while i < n:
                out.append(lines[i])
                closed = bool(close_re.match(lines[i]))
                i += 1
                if closed:
                    break
            continue

        if line.strip() == "":
            flush_prose()
            flush_bullet()
            out.append(line)
            i += 1
            continue

        if line.lstrip().startswith("|") or line.count("|") >= 2:
            flush_prose()
            flush_bullet()
            out.append(line)
            i += 1
            continue

        bullet_match = BULLET_RE.match(line)
        if bullet_match and bullet_indent is None:
            flush_prose()
            lead, marker_char, spaces, text = bullet_match.groups()
            marker = lead + marker_char + spaces
            bullet_marker = marker
            bullet_indent = len(marker)
            bullet_buffer = [text] if text.strip() else []
            i += 1
            continue

        if bullet_indent is not None:
            leading = LEADING_WS_RE.match(line).group(0)
            if len(leading.expandtabs()) >= bullet_indent and line.strip() != "":
                bullet_buffer.append(line.strip())
                i += 1
                continue
            flush_bullet()
            continue

        leading = LEADING_WS_RE.match(line).group(0)
        if "\t" in leading or len(leading) >= 4:
            flush_prose()
            out.append(line)
            i += 1
            continue

        prose_buffer.append(line.strip())
        i += 1

    flush_prose()
    flush_bullet()
    return out


def wrap_lines(lines):
    """Wrap a full message given as a list of lines (subject first)."""
    if not lines:
        return lines
    subject = lines[0]
    rest = lines[1:]

    trailer_start = find_trailer_start(rest)
    if trailer_start is None:
        body, trailer = rest, []
    else:
        body, trailer = rest[:trailer_start], rest[trailer_start:]

    return [subject] + wrap_block(body) + trailer


def main():
    path = sys.argv[1]
    with open(path, encoding="utf-8") as f:
        text = f.read()
    lines = text.splitlines()

    # git appends comment lines (diff summary, status hints) below the
    # message; split them off so wrapping never touches them.
    comment_start = next((i for i, line in enumerate(lines) if line.startswith("#")), len(lines))
    message_lines = lines[:comment_start]
    comment_lines = lines[comment_start:]

    new_message_lines = wrap_lines(message_lines)
    if new_message_lines == message_lines:
        return

    new_text = "\n".join(new_message_lines + comment_lines)
    if text.endswith("\n"):
        new_text += "\n"
    with open(path, "w", encoding="utf-8") as f:
        f.write(new_text)
    print("commit-msg: rewrapped body/footer text to fit 72 characters", file=sys.stderr)


if __name__ == "__main__":
    main()
PYEOF
      echo "commit-msg: uv run failed; falling back to strict 72-character check" >&2
      wrap_enabled=0
    fi
  else
    echo "commit-msg: uv not found; falling back to strict 72-character check" >&2
    wrap_enabled=0
  fi
fi

# Re-extract message content: the rewrap step above may have changed it.
cleaned=$(grep -v "^#" "$msg_file")
subject=$(printf '%s\n' "$cleaned" | head -1)

# Collect every formatting violation so callers can fix the message in one pass.
errors=$(
  # Subject must follow conventional commits: type(scope)!: description
  if ! printf '%s\n' "$subject" | grep -qE '^[a-z][a-z0-9-]*(\([^)]+\))?!?: .+'; then
    echo "commit-msg: subject must follow 'type(scope): description' format"
  fi

  # Subject line must not exceed 50 characters.
  subj_len=${#subject}
  if [ "$subj_len" -gt 50 ]; then
    echo "commit-msg: subject is $subj_len characters (limit: 50)"
  fi

  # If the message has a body, line 2 must be blank.
  line_count=$(printf '%s\n' "$cleaned" | wc -l | tr -d ' ')
  if [ "$line_count" -gt 1 ]; then
    line2=$(printf '%s\n' "$cleaned" | sed -n '2p')
    if [ -n "$line2" ]; then
      echo "commit-msg: line 2 must be blank (separates subject from body)"
    fi
  fi

  # Body and footer lines must not exceed 72 characters. The rewrap step
  # above already enforces this when it ran, so only check here when it
  # didn't (opted out, or uv was unavailable/failed).
  if [ "$wrap_enabled" -eq 0 ]; then
    printf '%s\n' "$cleaned" | awk '
    NR > 2 && length > 72 {
      printf "commit-msg: line %d is %d characters (limit: 72)\n", NR, length
    }
  '
  fi
)

if [ -n "$errors" ]; then
  printf '%s\n' "$errors" >&2
  exit 1
fi

exit 0
