#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
# Installed by the "agent" profile of the 'hook' command as commit-msg.
# Tests: tests/test-hook-agent
# Design decision: Hard dependency on 'uv'. Required 'uv' runtime is checked and
# diagnosed by 'hook add' and 'hook doctor' before hook execution.
"""Strip Co-Authored-By trailers, rewrap over-long body/footer lines, and
enforce commit message formatting."""

import os
import re
import subprocess
import sys
import tempfile
import textwrap

WRAP_WIDTH = 72
SUBJECT_LIMIT = 50

FENCE_RE = re.compile(r"^(\s*)(`{3,}|~{3,})")
BULLET_RE = re.compile(r"^(\s*)([-*+]|\d+[.)])(\s+)(.*)$")
BLOCKQUOTE_RE = re.compile(r"^(\s*)(>+)(\s*)(.*)$")
LEADING_WS_RE = re.compile(r"^[ \t]*")
SETEXT_OR_HR_RE = re.compile(r"^\s*([-=*_])(\s*\1){2,}\s*$")
# Narrower than SETEXT_OR_HR_RE on purpose: only '-'/'=' runs are setext
# underlines. '*'/'_' runs are thematic breaks and must still be wrappable
# paragraph-adjacent content, not treated as a heading delimiter.
SETEXT_DELIM_RE = re.compile(r"^\s{0,3}(-+|=+)\s*$")
SUBJECT_RE = re.compile(r"^[a-z][a-z0-9-]*(\([^)]+\))?!?: .+")
GENERATED_SUBJECT_RE = re.compile(r"^(Merge |Revert |fixup! |squash! )")
DROPPED_TRAILER_RE = re.compile(r"^(Co-Authored-By:|TAG=|CONV=)")


def get_comment_char():
    try:
        res = subprocess.run(
            ["git", "config", "core.commentChar"],
            capture_output=True,
            text=True,
            check=False,
        )
        char = res.stdout.strip()
        if char and char != "auto":
            return char
    except OSError:
        pass
    return "#"


def strip_generated_trailers(lines, comment_char="#"):
    """Drop Co-Authored-By/TAG=/CONV= trailers and the blank lines they leave
    behind, preserving git's own comment lines (lines starting with comment_char) by
    moving them after the real content regardless of where they appeared."""
    comments = [line for line in lines if line.startswith(comment_char)]
    content = [line for line in lines if not line.startswith(comment_char)]

    def is_blank(line):
        return line.strip() == ""

    while content and is_blank(content[-1]):
        content.pop()
    while content and DROPPED_TRAILER_RE.match(content[-1]):
        content.pop()
    while content and is_blank(content[-1]):
        content.pop()

    return content + comments


def find_trailer_start(lines):
    """Index where a trailing git-trailer block begins in lines, or None."""
    if not lines:
        return None
    text = "\n".join(lines) + "\n"
    try:
        result = subprocess.run(
            [
                "git",
                "interpret-trailers",
                "--only-trailers",
                "--only-input",
                "--no-divider",
            ],
            input=text,
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    trailer_lines = result.stdout.splitlines()
    if not trailer_lines or len(trailer_lines) > len(lines):
        return None
    start = len(lines) - len(trailer_lines)
    candidate_text = "\n" + "\n".join(lines[start:]) + "\n"
    try:
        check_result = subprocess.run(
            [
                "git",
                "interpret-trailers",
                "--only-trailers",
                "--only-input",
                "--no-divider",
            ],
            input=candidate_text,
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    if check_result.stdout.splitlines() == trailer_lines:
        return start
    return None


def wrap_block(lines):
    """Reflow prose/bullets/blockquotes to WRAP_WIDTH; pass fences, tables and
    indented blocks through untouched. A run that already fits WRAP_WIDTH on
    every line is left byte-identical rather than being rejoined."""
    out = []
    i = 0
    n = len(lines)

    prose_buffer, prose_raw = [], []
    bullet_marker, bullet_indent = None, None
    bullet_buffer, bullet_raw = [], []
    quote_marker = None
    quote_buffer, quote_raw = [], []

    def all_within_width(raws):
        return all(len(r) <= WRAP_WIDTH for r in raws)

    def get_hard_suffix(raws):
        if not raws:
            return ""
        last_raw = raws[-1].rstrip("\r\n")
        if last_raw.endswith("  "):
            return "  "
        if last_raw.endswith("\\"):
            return "\\"
        return ""

    def flush_prose():
        nonlocal prose_buffer, prose_raw
        if prose_buffer:
            if all_within_width(prose_raw):
                out.extend(prose_raw)
            else:
                hard_suffix = get_hard_suffix(prose_raw)
                text = " ".join(prose_buffer)
                if hard_suffix == "\\" and text.endswith("\\"):
                    text = text[:-1].rstrip()
                eff_width = max(1, WRAP_WIDTH - len(hard_suffix))
                wrapped = textwrap.wrap(
                    text,
                    width=eff_width,
                    break_long_words=False,
                    break_on_hyphens=False,
                )
                if wrapped and hard_suffix:
                    wrapped[-1] += hard_suffix
                out.extend(wrapped or [""])
            prose_buffer, prose_raw = [], []

    def flush_bullet():
        nonlocal bullet_marker, bullet_indent, bullet_buffer, bullet_raw
        if bullet_marker is not None:
            if all_within_width(bullet_raw):
                out.extend(bullet_raw)
            else:
                hard_suffix = get_hard_suffix(bullet_raw)
                text = " ".join(bullet_buffer)
                if hard_suffix == "\\" and text.endswith("\\"):
                    text = text[:-1].rstrip()
                eff_width = max(1, WRAP_WIDTH - len(hard_suffix))
                indent = " " * len(bullet_marker)
                wrapped = textwrap.wrap(
                    text,
                    width=eff_width,
                    initial_indent=bullet_marker,
                    subsequent_indent=indent,
                    break_long_words=False,
                    break_on_hyphens=False,
                )
                if wrapped and hard_suffix:
                    wrapped[-1] += hard_suffix
                out.extend(wrapped or [bullet_marker.rstrip()])
            bullet_marker, bullet_indent = None, None
            bullet_buffer, bullet_raw = [], []

    def flush_quote():
        nonlocal quote_marker, quote_buffer, quote_raw
        if quote_marker is not None:
            if all_within_width(quote_raw):
                out.extend(quote_raw)
            else:
                hard_suffix = get_hard_suffix(quote_raw)
                text = " ".join(quote_buffer)
                if hard_suffix == "\\" and text.endswith("\\"):
                    text = text[:-1].rstrip()
                eff_width = max(1, WRAP_WIDTH - len(hard_suffix))
                wrapped = textwrap.wrap(
                    text,
                    width=eff_width,
                    initial_indent=quote_marker,
                    subsequent_indent=quote_marker,
                    break_long_words=False,
                    break_on_hyphens=False,
                )
                if wrapped and hard_suffix:
                    wrapped[-1] += hard_suffix
                out.extend(wrapped or [quote_marker.rstrip()])
            quote_marker = None
            quote_buffer, quote_raw = [], []

    while i < n:
        line = lines[i]

        fence_match = FENCE_RE.match(line)
        if fence_match:
            flush_prose()
            flush_bullet()
            flush_quote()
            token = fence_match.group(2)
            out.append(line)
            i += 1
            char = token[0]
            count = len(token)
            close_re = re.compile(
                r"^\s*" + re.escape(char) + r"{" + str(count) + r",}\s*$"
            )
            while i < n:
                out.append(lines[i])
                closed = bool(close_re.match(lines[i]))
                i += 1
                if closed:
                    break
            continue

        if line.strip() == "":
            flush_prose()
            flush_bullet()
            flush_quote()
            out.append(line)
            i += 1
            continue

        if line.lstrip().startswith("|") or line.count("|") >= 2:
            flush_prose()
            flush_bullet()
            flush_quote()
            out.append(line)
            i += 1
            continue

        setext_or_hr_match = SETEXT_OR_HR_RE.match(line)
        if setext_or_hr_match:
            flush_prose()
            flush_bullet()
            flush_quote()
            out.append(line)
            i += 1
            continue

        # Blockquote lines (">", possibly nested as ">>") get their own
        # run, keyed on the exact quote-depth prefix so distinct depths
        # never get merged into one reflow.
        quote_match = BLOCKQUOTE_RE.match(line)
        if quote_match:
            flush_prose()
            flush_bullet()
            lead, marks, spaces, text = quote_match.groups()
            marker = lead + marks + (spaces or " ")
            is_hard_break = line.rstrip("\r\n").endswith("  ") or line.rstrip(
                "\r\n"
            ).endswith("\\")
            # A quoted line that itself opens a bullet always starts its own
            # run, the same way a bare bullet does — otherwise it gets
            # folded into the prior quoted item's reflowed text, and its
            # marker becomes literal text mid-paragraph.
            starts_bullet = bool(BULLET_RE.match(text))
            if not text.strip():
                flush_quote()
                out.append(line)
            elif (
                quote_marker is not None
                and marker == quote_marker
                and not starts_bullet
            ):
                quote_buffer.append(text.strip())
                quote_raw.append(line)
                if is_hard_break:
                    flush_quote()
            else:
                flush_quote()
                quote_marker = marker
                quote_buffer = [text.strip()]
                quote_raw = [line]
                if is_hard_break:
                    flush_quote()
            i += 1
            continue
        else:
            flush_quote()

        # A line that itself opens a bullet (at any indent, e.g. a nested
        # child) always starts a new bullet run rather than being folded
        # into whatever bullet is currently active — otherwise a nested
        # item's marker gets swallowed into the parent's reflowed text.
        bullet_match = BULLET_RE.match(line)
        if bullet_match:
            flush_prose()
            flush_bullet()
            lead, marker_char, spaces, text = bullet_match.groups()
            marker = lead + marker_char + spaces
            bullet_marker = marker
            bullet_indent = len(marker)
            bullet_buffer = [text] if text.strip() else []
            bullet_raw = [line]
            is_hard_break = line.rstrip("\r\n").endswith("  ") or line.rstrip(
                "\r\n"
            ).endswith("\\")
            i += 1
            if is_hard_break:
                flush_bullet()
            continue

        leading = LEADING_WS_RE.match(line).group(0)
        leading_len = len(leading.expandtabs())
        code_threshold = (
            bullet_indent + 4 if bullet_indent and bullet_indent >= 4 else 4
        )
        if "\t" in leading or leading_len >= code_threshold:
            flush_prose()
            flush_bullet()
            out.append(line)
            i += 1
            continue

        if bullet_indent is not None:
            if leading_len >= bullet_indent and line.strip() != "":
                is_hard_break = line.rstrip("\r\n").endswith("  ") or line.rstrip(
                    "\r\n"
                ).endswith("\\")
                bullet_buffer.append(line.strip())
                bullet_raw.append(line)
                i += 1
                if is_hard_break:
                    flush_bullet()
                continue
            flush_bullet()
            continue

        is_hard_break = line.rstrip("\r\n").endswith("  ") or line.rstrip(
            "\r\n"
        ).endswith("\\")

        next_line = lines[i + 1] if i + 1 < n else None
        if (
            not is_hard_break
            and line.strip()
            and next_line is not None
            and SETEXT_DELIM_RE.match(next_line)
        ):
            # A setext heading: the title (this line, plus whatever is
            # already buffered from earlier lines of the same paragraph)
            # and its underline must stay verbatim, or wrapping the title
            # leaves the underline applying only to the last wrapped line.
            out.extend(prose_raw)
            out.append(line)
            out.append(next_line)
            prose_buffer, prose_raw = [], []
            i += 2
            continue

        prose_buffer.append(line.strip())
        prose_raw.append(line)
        i += 1
        if is_hard_break:
            flush_prose()

    flush_prose()
    flush_bullet()
    flush_quote()
    return out


def wrap_lines(lines):
    """Wrap a full message given as a list of lines (subject first)."""
    if not lines:
        return lines
    subject = lines[0]
    rest = lines[1:]

    trailer_start = find_trailer_start(rest)
    if trailer_start is None:
        body, trailer = rest, []
    else:
        body, trailer = rest[:trailer_start], rest[trailer_start:]

    return [subject, *wrap_block(body), *trailer]


def rewrap_message(message_lines):
    """Rewrap a message's body/footer to WRAP_WIDTH; returns (new_lines,
    changed)."""
    new_lines = wrap_lines(message_lines)
    return new_lines, new_lines != message_lines


def wrap_enabled():
    result = subprocess.run(
        ["git", "config", "--bool", "hooks.commitMsgWrap"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode == 0:
        return result.stdout.strip() == "true"
    return True


def split_comments(lines, comment_char="#"):
    """git appends comment lines (diff summary, status hints) below the
    message; split them off so checks and wrapping never touch them."""
    comment_start = next(
        (i for i, line in enumerate(lines) if line.startswith(comment_char)), len(lines)
    )
    return lines[:comment_start], lines[comment_start:]


def check_format(cleaned, checked_length):
    """Collect every formatting violation so callers can fix the message in
    one pass."""
    errors = []
    subject = cleaned[0] if cleaned else ""

    if not SUBJECT_RE.match(subject):
        errors.append(
            "commit-msg: subject must follow 'type(scope): description' format"
        )

    if len(subject) > SUBJECT_LIMIT:
        errors.append(
            f"commit-msg: subject is {len(subject)} characters (limit: {SUBJECT_LIMIT})"
        )

    if len(cleaned) > 1 and cleaned[1] != "":
        errors.append("commit-msg: line 2 must be blank (separates subject from body)")

    # Body and footer lines must not exceed WRAP_WIDTH characters. The rewrap
    # step already enforces this when it ran, so only check here otherwise.
    if checked_length:
        for lineno, line in enumerate(cleaned[2:], start=3):
            if len(line) > WRAP_WIDTH:
                errors.append(
                    f"commit-msg: line {lineno} is {len(line)} characters (limit: {WRAP_WIDTH})"
                )

    return errors


SCRIPT_NAME = os.path.basename(sys.argv[0]) if sys.argv[0] else "commit-msg"


def usage(out=sys.stdout):
    print(
        f"""Usage: {SCRIPT_NAME} [OPTIONS] COMMIT_MSG_FILE

Strip Co-Authored-By trailers, rewrap over-long body/footer lines, and enforce
commit message formatting.

Arguments:
  COMMIT_MSG_FILE   Path to the commit message file

Options:
  -h, --help        Display this help message and exit

Examples:
  # Validate and rewrap a git commit message file
  {SCRIPT_NAME} .git/COMMIT_EDITMSG""",
        file=out,
    )


def usage_short(out=sys.stderr):
    print(
        f"""Usage: {SCRIPT_NAME} [OPTIONS] COMMIT_MSG_FILE

Strip Co-Authored-By trailers, rewrap over-long body/footer lines, and enforce
commit message formatting.

Examples:
  {SCRIPT_NAME} .git/COMMIT_EDITMSG

Try '{SCRIPT_NAME} --help' for more information.""",
        file=out,
    )


def main():
    args = sys.argv[1:]
    path = None
    for arg in args:
        if arg in ("--help", "-h"):
            usage()
            sys.exit(0)
        elif arg.startswith("-"):
            print(f"{SCRIPT_NAME}: unknown option: {arg}", file=sys.stderr)
            print(f"Try '{SCRIPT_NAME} --help' for more information.", file=sys.stderr)
            sys.exit(1)
        elif path is None:
            path = arg
        else:
            print(f"{SCRIPT_NAME}: unexpected extra argument: {arg}", file=sys.stderr)
            print(f"Try '{SCRIPT_NAME} --help' for more information.", file=sys.stderr)
            sys.exit(1)

    if not path:
        usage_short()
        sys.exit(1)

    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()

    comment_char = get_comment_char()
    lines = strip_generated_trailers(lines, comment_char)

    message_lines, comment_lines = split_comments(lines, comment_char)
    subject = message_lines[0] if message_lines else ""
    if GENERATED_SUBJECT_RE.match(subject):
        write_lines(path, message_lines + comment_lines)
        return

    wrap_did_run = wrap_enabled()
    if wrap_did_run:
        try:
            message_lines, changed = rewrap_message(message_lines)
            if changed:
                print(
                    "commit-msg: rewrapped body/footer text to fit 72 characters",
                    file=sys.stderr,
                )
        except Exception as e:
            print(
                f"commit-msg: rewrap failed ({e}); falling back to strict 72-character check",
                file=sys.stderr,
            )
            wrap_did_run = False

    write_lines(path, message_lines + comment_lines)

    errors = check_format(message_lines, checked_length=not wrap_did_run)
    if errors:
        print("\n".join(errors), file=sys.stderr)
        sys.exit(1)


def write_lines(path, lines):
    # Every line gets a trailing newline, matching git's own commit message
    # file convention regardless of what the file looked like on disk before.
    # Written via a same-directory temp file + rename so a write failure
    # (disk full, interrupted process) cannot truncate the author's draft.
    text = "".join(line + "\n" for line in lines)
    directory = os.path.dirname(path) or "."
    fd, tmp_path = tempfile.mkstemp(dir=directory, prefix=os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp_path, path)
    except BaseException:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        try:
            sys.stderr.write("\n")
            sys.stderr.flush()
        except Exception:
            pass
        sys.exit(130)
    except BrokenPipeError:
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(141)

