#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
# Installed by the "agent" profile of the 'hook' command as commit-msg.
# Tests: tests/test-hook-agent
"""Strip Co-Authored-By trailers, rewrap over-long body/footer lines, and
enforce commit message formatting."""

import re
import subprocess
import sys
import textwrap

WRAP_WIDTH = 72
SUBJECT_LIMIT = 50

FENCE_RE = re.compile(r"^(\s*)(`{3,}|~{3,})")
BULLET_RE = re.compile(r"^(\s*)([-*+]|\d+[.)])(\s+)(.*)$")
BLOCKQUOTE_RE = re.compile(r"^(\s*)(>+)(\s*)(.*)$")
LEADING_WS_RE = re.compile(r"^[ \t]*")
SUBJECT_RE = re.compile(r"^[a-z][a-z0-9-]*(\([^)]+\))?!?: .+")
GENERATED_SUBJECT_RE = re.compile(r"^(Merge |Revert |fixup! |squash! )")
DROPPED_TRAILER_RE = re.compile(r"^(Co-Authored-By:|TAG=|CONV=)")


def strip_generated_trailers(lines):
    """Drop Co-Authored-By/TAG=/CONV= trailers and the blank lines they leave
    behind, preserving git's own comment lines (lines starting with '#') by
    moving them after the real content regardless of where they appeared."""
    comments = [line for line in lines if line.startswith("#")]
    content = [line for line in lines if not line.startswith("#")]

    def is_blank(line):
        return line.strip() == ""

    while content and is_blank(content[-1]):
        content.pop()
    while content and DROPPED_TRAILER_RE.match(content[-1]):
        content.pop()
    while content and is_blank(content[-1]):
        content.pop()

    return content + comments


def find_trailer_start(lines):
    """Index where a trailing git-trailer block begins in lines, or None."""
    if not lines:
        return None
    text = "\n".join(lines) + "\n"
    try:
        result = subprocess.run(
            [
                "git",
                "interpret-trailers",
                "--only-trailers",
                "--only-input",
                "--no-divider",
            ],
            input=text,
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    trailer_lines = result.stdout.splitlines()
    if not trailer_lines or len(trailer_lines) > len(lines):
        return None
    start = len(lines) - len(trailer_lines)
    candidate_text = "\n" + "\n".join(lines[start:]) + "\n"
    try:
        check_result = subprocess.run(
            [
                "git",
                "interpret-trailers",
                "--only-trailers",
                "--only-input",
                "--no-divider",
            ],
            input=candidate_text,
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    if check_result.stdout.splitlines() == trailer_lines:
        return start
    return None


def wrap_block(lines):
    """Reflow prose/bullets/blockquotes to WRAP_WIDTH; pass fences, tables and
    indented blocks through untouched. A run that already fits WRAP_WIDTH on
    every line is left byte-identical rather than being rejoined."""
    out = []
    i = 0
    n = len(lines)

    prose_buffer, prose_raw = [], []
    bullet_marker, bullet_indent = None, None
    bullet_buffer, bullet_raw = [], []
    quote_marker = None
    quote_buffer, quote_raw = [], []

    def all_within_width(raws):
        return all(len(r) <= WRAP_WIDTH for r in raws)

    def get_hard_suffix(raws):
        if not raws:
            return ""
        last_raw = raws[-1].rstrip("\r\n")
        if last_raw.endswith("  "):
            return "  "
        if last_raw.endswith("\\"):
            return "\\"
        return ""

    def flush_prose():
        nonlocal prose_buffer, prose_raw
        if prose_buffer:
            if all_within_width(prose_raw):
                out.extend(prose_raw)
            else:
                hard_suffix = get_hard_suffix(prose_raw)
                text = " ".join(prose_buffer)
                if hard_suffix == "\\" and text.endswith("\\"):
                    text = text[:-1].rstrip()
                eff_width = max(1, WRAP_WIDTH - len(hard_suffix))
                wrapped = textwrap.wrap(
                    text,
                    width=eff_width,
                    break_long_words=False,
                    break_on_hyphens=False,
                )
                if wrapped and hard_suffix:
                    wrapped[-1] += hard_suffix
                out.extend(wrapped or [""])
            prose_buffer, prose_raw = [], []

    def flush_bullet():
        nonlocal bullet_marker, bullet_indent, bullet_buffer, bullet_raw
        if bullet_marker is not None:
            if all_within_width(bullet_raw):
                out.extend(bullet_raw)
            else:
                hard_suffix = get_hard_suffix(bullet_raw)
                text = " ".join(bullet_buffer)
                if hard_suffix == "\\" and text.endswith("\\"):
                    text = text[:-1].rstrip()
                eff_width = max(1, WRAP_WIDTH - len(hard_suffix))
                indent = " " * len(bullet_marker)
                wrapped = textwrap.wrap(
                    text,
                    width=eff_width,
                    initial_indent=bullet_marker,
                    subsequent_indent=indent,
                    break_long_words=False,
                    break_on_hyphens=False,
                )
                if wrapped and hard_suffix:
                    wrapped[-1] += hard_suffix
                out.extend(wrapped or [bullet_marker.rstrip()])
            bullet_marker, bullet_indent = None, None
            bullet_buffer, bullet_raw = [], []

    def flush_quote():
        nonlocal quote_marker, quote_buffer, quote_raw
        if quote_marker is not None:
            if all_within_width(quote_raw):
                out.extend(quote_raw)
            else:
                hard_suffix = get_hard_suffix(quote_raw)
                text = " ".join(quote_buffer)
                if hard_suffix == "\\" and text.endswith("\\"):
                    text = text[:-1].rstrip()
                eff_width = max(1, WRAP_WIDTH - len(hard_suffix))
                wrapped = textwrap.wrap(
                    text,
                    width=eff_width,
                    initial_indent=quote_marker,
                    subsequent_indent=quote_marker,
                    break_long_words=False,
                    break_on_hyphens=False,
                )
                if wrapped and hard_suffix:
                    wrapped[-1] += hard_suffix
                out.extend(wrapped or [quote_marker.rstrip()])
            quote_marker = None
            quote_buffer, quote_raw = [], []

    while i < n:
        line = lines[i]

        fence_match = FENCE_RE.match(line)
        if fence_match:
            flush_prose()
            flush_bullet()
            flush_quote()
            token = fence_match.group(2)
            out.append(line)
            i += 1
            char = token[0]
            count = len(token)
            close_re = re.compile(
                r"^\s*" + re.escape(char) + r"{" + str(count) + r",}\s*$"
            )
            while i < n:
                out.append(lines[i])
                closed = bool(close_re.match(lines[i]))
                i += 1
                if closed:
                    break
            continue

        if line.strip() == "":
            flush_prose()
            flush_bullet()
            flush_quote()
            out.append(line)
            i += 1
            continue

        if line.lstrip().startswith("|") or line.count("|") >= 2:
            flush_prose()
            flush_bullet()
            flush_quote()
            out.append(line)
            i += 1
            continue

        # Blockquote lines (">", possibly nested as ">>") get their own
        # run, keyed on the exact quote-depth prefix so distinct depths
        # never get merged into one reflow.
        quote_match = BLOCKQUOTE_RE.match(line)
        if quote_match:
            flush_prose()
            flush_bullet()
            lead, marks, spaces, text = quote_match.groups()
            marker = lead + marks + (spaces or " ")
            is_hard_break = line.rstrip("\r\n").endswith("  ") or line.rstrip(
                "\r\n"
            ).endswith("\\")
            if not text.strip():
                flush_quote()
                out.append(line)
            elif quote_marker is not None and marker == quote_marker:
                quote_buffer.append(text.strip())
                quote_raw.append(line)
                if is_hard_break:
                    flush_quote()
            else:
                flush_quote()
                quote_marker = marker
                quote_buffer = [text.strip()]
                quote_raw = [line]
                if is_hard_break:
                    flush_quote()
            i += 1
            continue
        else:
            flush_quote()

        # A line that itself opens a bullet (at any indent, e.g. a nested
        # child) always starts a new bullet run rather than being folded
        # into whatever bullet is currently active — otherwise a nested
        # item's marker gets swallowed into the parent's reflowed text.
        bullet_match = BULLET_RE.match(line)
        if bullet_match:
            flush_prose()
            flush_bullet()
            lead, marker_char, spaces, text = bullet_match.groups()
            marker = lead + marker_char + spaces
            bullet_marker = marker
            bullet_indent = len(marker)
            bullet_buffer = [text] if text.strip() else []
            bullet_raw = [line]
            is_hard_break = line.rstrip("\r\n").endswith("  ") or line.rstrip(
                "\r\n"
            ).endswith("\\")
            i += 1
            if is_hard_break:
                flush_bullet()
            continue

        if bullet_indent is not None:
            leading = LEADING_WS_RE.match(line).group(0)
            if len(leading.expandtabs()) >= bullet_indent and line.strip() != "":
                is_hard_break = line.rstrip("\r\n").endswith("  ") or line.rstrip(
                    "\r\n"
                ).endswith("\\")
                bullet_buffer.append(line.strip())
                bullet_raw.append(line)
                i += 1
                if is_hard_break:
                    flush_bullet()
                continue
            flush_bullet()
            continue

        leading = LEADING_WS_RE.match(line).group(0)
        if "\t" in leading or len(leading) >= 4:
            flush_prose()
            out.append(line)
            i += 1
            continue

        is_hard_break = line.rstrip("\r\n").endswith("  ") or line.rstrip(
            "\r\n"
        ).endswith("\\")
        prose_buffer.append(line.strip())
        prose_raw.append(line)
        i += 1
        if is_hard_break:
            flush_prose()

    flush_prose()
    flush_bullet()
    flush_quote()
    return out


def wrap_lines(lines):
    """Wrap a full message given as a list of lines (subject first)."""
    if not lines:
        return lines
    subject = lines[0]
    rest = lines[1:]

    trailer_start = find_trailer_start(rest)
    if trailer_start is None:
        body, trailer = rest, []
    else:
        body, trailer = rest[:trailer_start], rest[trailer_start:]

    return [subject, *wrap_block(body), *trailer]


def rewrap_message(message_lines):
    """Rewrap a message's body/footer to WRAP_WIDTH; returns (new_lines,
    changed)."""
    new_lines = wrap_lines(message_lines)
    return new_lines, new_lines != message_lines


def wrap_enabled():
    result = subprocess.run(
        ["git", "config", "hooks.commitMsgWrap"],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.stdout.strip() not in ("false", "0", "no")


def split_comments(lines):
    """git appends comment lines (diff summary, status hints) below the
    message; split them off so checks and wrapping never touch them."""
    comment_start = next(
        (i for i, line in enumerate(lines) if line.startswith("#")), len(lines)
    )
    return lines[:comment_start], lines[comment_start:]


def check_format(cleaned, checked_length):
    """Collect every formatting violation so callers can fix the message in
    one pass."""
    errors = []
    subject = cleaned[0] if cleaned else ""

    if not SUBJECT_RE.match(subject):
        errors.append(
            "commit-msg: subject must follow 'type(scope): description' format"
        )

    if len(subject) > SUBJECT_LIMIT:
        errors.append(
            f"commit-msg: subject is {len(subject)} characters (limit: {SUBJECT_LIMIT})"
        )

    if len(cleaned) > 1 and cleaned[1] != "":
        errors.append("commit-msg: line 2 must be blank (separates subject from body)")

    # Body and footer lines must not exceed WRAP_WIDTH characters. The rewrap
    # step already enforces this when it ran, so only check here otherwise.
    if checked_length:
        for lineno, line in enumerate(cleaned[2:], start=3):
            if len(line) > WRAP_WIDTH:
                errors.append(
                    f"commit-msg: line {lineno} is {len(line)} characters (limit: {WRAP_WIDTH})"
                )

    return errors


def main():
    path = sys.argv[1]
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()

    lines = strip_generated_trailers(lines)

    message_lines, comment_lines = split_comments(lines)
    subject = message_lines[0] if message_lines else ""
    if GENERATED_SUBJECT_RE.match(subject):
        write_lines(path, message_lines + comment_lines)
        return

    wrap_did_run = wrap_enabled()
    if wrap_did_run:
        try:
            message_lines, changed = rewrap_message(message_lines)
            if changed:
                print(
                    "commit-msg: rewrapped body/footer text to fit 72 characters",
                    file=sys.stderr,
                )
        except Exception as e:
            print(
                f"commit-msg: rewrap failed ({e}); falling back to strict 72-character check",
                file=sys.stderr,
            )
            wrap_did_run = False

    write_lines(path, message_lines + comment_lines)

    errors = check_format(message_lines, checked_length=not wrap_did_run)
    if errors:
        print("\n".join(errors), file=sys.stderr)
        sys.exit(1)


def write_lines(path, lines):
    # Every line gets a trailing newline, matching git's own commit message
    # file convention regardless of what the file looked like on disk before.
    text = "".join(line + "\n" for line in lines)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


if __name__ == "__main__":
    main()
