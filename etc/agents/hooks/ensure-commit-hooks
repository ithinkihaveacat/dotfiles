#!/usr/bin/env bash
# PreToolUse hook body shared by agents: run directly by Claude Code (registered
# in ~/.claude/settings.json by install.sh) and wrapped by agy/hooks/PreToolUse.
#
# Lazily runs 'hook -C <repo> apply --quiet' right before an agent executes a
# shell tool call containing 'git commit', ensuring the 10-agent commit-msg
# hook is installed in user-owned repositories cloned or entered mid-session
# without injecting personal commit-message rules into third-party clones.
#
# Reads the tool call JSON on stdin and accepts both the Antigravity/Jetski and
# Claude Code payload shapes. It never writes output and always exits 0, so it
# can never block a tool call or alter a permission decision; callers that must
# answer with a decision do so themselves.

exec >/dev/null 2>&1
trap 'exit 0' EXIT

# Respect explicit opt-out via empty AGENT_REQUIRED_HOOKS="".
if [ "${AGENT_REQUIRED_HOOKS+set}" = set ] && [ -z "$AGENT_REQUIRED_HOOKS" ]; then
  exit 0
fi

if [ -t 0 ]; then
  exit 0
fi

payload=$(cat)

# Pure-bash fast path (<1.5ms, zero subprocesses): ignore the ~98% of commands
# that do not mention both 'git' and 'commit'.
case "$payload" in
  *git*commit* | *commit*git*) ;;
  *) exit 0 ;;
esac

command -v jq >/dev/null 2>&1 || exit 0
command -v git >/dev/null 2>&1 || exit 0

resolve_script_root() {
  local target="${BASH_SOURCE[0]}" tdir
  while [ -L "$target" ]; do
    tdir=$(cd -P "$(dirname "$target")" 2>/dev/null && pwd) || return 1
    target=$(readlink "$target")
    [[ "$target" != /* ]] && target="$tdir/$target"
  done
  tdir=$(cd -P "$(dirname "$target")" 2>/dev/null && pwd) || return 1
  cd -P "$tdir/../../.." 2>/dev/null && pwd
}

DOTFILES_ROOT=$(resolve_script_root 2>/dev/null || true)

HOOK_BIN=""
if command -v hook >/dev/null 2>&1; then
  HOOK_BIN="hook"
elif [ -n "$DOTFILES_ROOT" ] && [ -x "$DOTFILES_ROOT/skills/workspace-tools/scripts/hook" ]; then
  HOOK_BIN="$DOTFILES_ROOT/skills/workspace-tools/scripts/hook"
else
  exit 0
fi

eval "$(
  printf '%s' "$payload" | jq -r '
    "CMD=" + ((
      .toolCall.args.CommandLine //
      .toolCall.args.command //
      .tool_input.command //
      .tool_input.CommandLine //
      .input.command //
      ""
    ) | @sh),
    "TOOL_CWD=" + ((
      .toolCall.args.Cwd //
      .toolCall.args.Directory //
      .tool_input.Cwd //
      .cwd //
      ""
    ) | @sh),
    "WS_PATHS=" + ((
      (.workspacePaths // []) | map(@sh) | join(" ")
    ))
  ' 2>/dev/null || true
)"

[[ "${CMD:-}" =~ (^|[^[:alnum:]_-])git[[:space:]].*commit([^[:alnum:]_-]|$) ]] || exit 0

HOME_REAL=$(cd "$HOME" 2>/dev/null && pwd -P) || HOME_REAL="$HOME"
BASE_CWD="${TOOL_CWD:-}"

remote_owner_slug() {
  local url="$1" rest=""
  case "$url" in
    "" | /* | ./* | ../* | file://*) return 0 ;;
    *://*)
      rest="${url#*://}"
      case "$rest" in
        */*) rest="${rest#*/}" ;;
        *) return 0 ;;
      esac
      ;;
    *:*)
      rest="${url#*:}"
      rest="${rest#/}"
      ;;
    *) return 0 ;;
  esac
  rest="${rest%/}"
  case "$rest" in
    */*) printf '%s\n' "${rest%%/*}" ;;
  esac
}

DOTFILES_OWNER=""
if [ -n "$DOTFILES_ROOT" ]; then
  df_origin=$(git -C "$DOTFILES_ROOT" config --get remote.origin.url 2>/dev/null || true)
  DOTFILES_OWNER=$(remote_owner_slug "$df_origin")
fi

has_header_marker() {
  local file="$1" re="$2" n=0 line
  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  while [ "$n" -lt 5 ] && IFS= read -r line; do
    n=$((n + 1))
    if [[ "$line" =~ $re ]]; then
      return 0
    fi
  done <"$file"
  return 1
}

is_personal_overlay_root() {
  case "$1" in
    "$HOME_REAL/.dotfiles" | "$HOME_REAL/.private" | "$HOME_REAL/.corp" | "$HOME_REAL/.ssh" | "$HOME_REAL/.projects")
      return 0
      ;;
  esac
  return 1
}

is_owned_repo() {
  local top="$1" hooks_dir="$2" opt common_dir common_parent
  local remotes upstream_url canon_url has_upstream=0 first_remote canon_owner
  local cfg_email cfg_name email_local root_id root_ae root_an

  opt=$(git -C "$top" config --local --bool hooks.agent 2>/dev/null || true)
  case "$opt" in
    true) return 0 ;;
    false) return 1 ;;
  esac

  is_personal_overlay_root "$top" && return 0

  common_dir=$(git -C "$top" rev-parse --git-common-dir 2>/dev/null || true)
  if [ -n "$common_dir" ]; then
    case "$common_dir" in
      /*) ;;
      *) common_dir="$top/$common_dir" ;;
    esac
    common_parent=$(cd -P "$common_dir/.." 2>/dev/null && pwd) || common_parent=""
    [ -n "$common_parent" ] && is_personal_overlay_root "$common_parent" && return 0
  fi

  has_header_marker "$hooks_dir/commit-msg" '^# (git-)?hooks?-multiplexer([: ]|$)' && return 0

  remotes=$(git -C "$top" remote 2>/dev/null || true)
  [ -n "$remotes" ] || return 0

  upstream_url=$(git -C "$top" config --get remote.upstream.url 2>/dev/null || true)
  if [ -n "$upstream_url" ]; then
    canon_url="$upstream_url"
    has_upstream=1
  else
    canon_url=$(git -C "$top" config --get remote.origin.url 2>/dev/null || true)
    if [ -z "$canon_url" ]; then
      first_remote="${remotes%%$'\n'*}"
      canon_url=$(git -C "$top" config --get "remote.$first_remote.url" 2>/dev/null || true)
    fi
  fi

  canon_owner=$(remote_owner_slug "$canon_url")
  [ -n "$DOTFILES_OWNER" ] && [ "$canon_owner" = "$DOTFILES_OWNER" ] && return 0

  cfg_email=$(git -C "$top" config --get user.email 2>/dev/null || true)
  cfg_name=$(git -C "$top" config --get user.name 2>/dev/null || true)
  email_local="${cfg_email%%@*}"
  if [ -n "$email_local" ] && [ "${#email_local}" -ge 3 ]; then
    [ "$canon_owner" = "$email_local" ] && return 0
    case "$canon_url" in
      *"/$email_local/"* | *":$email_local/"* | *"/$email_local-"* | *":personal/$email_local"*)
        return 0
        ;;
    esac
  fi

  if [ "$has_upstream" -eq 0 ]; then
    root_id=$(git -C "$top" rev-list --max-parents=0 HEAD -n 1 2>/dev/null || true)
    if [ -n "$root_id" ]; then
      root_ae=$(git -C "$top" log -n 1 --format='%ae' "$root_id" 2>/dev/null || true)
      root_an=$(git -C "$top" log -n 1 --format='%an' "$root_id" 2>/dev/null || true)
      if [ -n "$cfg_email" ] && [ "$root_ae" = "$cfg_email" ]; then
        return 0
      fi
      if [ -n "$cfg_name" ] && [ "$root_an" = "$cfg_name" ]; then
        return 0
      fi
    fi
  fi

  return 1
}

ensure_repo_hooks() {
  local dir="$1" base="${2:-}" top hooks_dir
  [ -n "$dir" ] || return 0
  case "$dir" in
    \~) dir="$HOME" ;;
    \~/*) dir="$HOME/${dir#\~/}" ;;
  esac
  case "$dir" in
    /*) ;;
    *)
      [ -n "$base" ] || return 0
      dir="$base/$dir"
      ;;
  esac
  [ -d "$dir" ] || return 0

  top=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || return 0
  top=$(cd "$top" 2>/dev/null && pwd -P) || return 0
  # Never install git hooks into the home directory itself.
  [ "$top" != "$HOME_REAL" ] || return 0

  hooks_dir=$(git -C "$top" rev-parse --git-path hooks 2>/dev/null) || return 0
  case "$hooks_dir" in
    /*) ;;
    *) hooks_dir="$top/$hooks_dir" ;;
  esac

  # Skip repositories where .git/hooks or commit-msg is a symlink (such as
  # multi-repository checkouts pointing into shared hook directories).
  [ ! -L "$hooks_dir" ] || return 0
  [ ! -L "$hooks_dir/commit-msg" ] || return 0

  # Only auto-install personal commit-message hooks in user-owned or opted-in
  # repositories, leaving third-party clones untouched.
  is_owned_repo "$top" "$hooks_dir" || return 0

  # Fast path: if the default profile ('agent') is in effect, 10-agent is
  # already installed, and no retired pre-multiplexer 00-legacy copy needs
  # cleanup, skip invoking 'hook'.
  if [ "${AGENT_REQUIRED_HOOKS-agent}" = "agent" ] &&
    [ -x "$hooks_dir/commit-msg.d/10-agent" ] &&
    ! has_header_marker "$hooks_dir/commit-msg.d/00-legacy" '^# git-hooks?-(agent|markdown|node):([[:space:]]|$)'; then
    return 0
  fi

  "$HOOK_BIN" -C "$top" apply --quiet || true
}

# 1. Check the explicit tool working directory (if provided) and each session
# workspace path.
if [ -n "$BASE_CWD" ]; then
  ensure_repo_hooks "$BASE_CWD"
fi
eval "ws_list=(${WS_PATHS:-})"
for ws in "${ws_list[@]:-}"; do
  [ -n "$ws" ] || continue
  [ -n "$BASE_CWD" ] || BASE_CWD="$ws"
  ensure_repo_hooks "$ws"
done

# 2. Check any directories targeted via 'git -C <dir>', 'cd <dir>', or
# 'pushd <dir>' inside the command string.
prev=""
norm_cmd="${CMD//&&/ }"
norm_cmd="${norm_cmd//;/ }"
norm_cmd="${norm_cmd//|/ }"
for tok in $norm_cmd; do
  clean="${tok#\"}"
  clean="${clean%\"}"
  clean="${clean#\'}"
  clean="${clean%\'}"
  case "$prev" in
    -C | cd | pushd)
      ensure_repo_hooks "$clean" "$BASE_CWD"
      ;;
  esac
  case "$clean" in
    -C?*)
      ensure_repo_hooks "${clean#-C}" "$BASE_CWD"
      ;;
  esac
  prev="$clean"
done
