#!/usr/bin/env bash
# Installed via ~/.gemini/config/hooks (symlinked by install.sh).
# Runs once at the beginning of a new conversation session (Turn 0).

set -euo pipefail

# Auto-archive sessions when AGY_ARCHIVE_ON_START=1 is set in the environment
# (e.g. by CLI wrapper functions) so CLI sessions stay out of the default UI
# sidebar while preserving all trajectory and brain data on disk.
if [[ "${AGY_ARCHIVE_ON_START:-0}" == 1 && -n "${ANTIGRAVITY_CONVERSATION_ID:-}" ]]; then
  app_data_dir="${AGY_APP_DATA_DIR:-$HOME/.gemini/antigravity}"
  annotations_dir="$app_data_dir/annotations"
  annotation_file="$annotations_dir/${ANTIGRAVITY_CONVERSATION_ID}.pbtxt"
  mkdir -p "$annotations_dir"
  if [[ ! -f "$annotation_file" ]] || [[ "$(<"$annotation_file")" != *"archived: true"* ]]; then
    printf 'archived: true\n' >>"$annotation_file"
  fi
fi
