#!/usr/bin/env bash
# Installed via ~/.gemini/config/hooks (symlinked by install.sh).
#
# Lazily runs 'hook -C <repo> apply --quiet' right before an agent executes a
# shell tool call containing 'git commit', ensuring the 10-agent commit-msg
# hook is installed even in repositories cloned or entered mid-session.
#
# In Jetski/Antigravity, PreToolUse hooks fail closed and rewrite an empty
# decision ("{}") to "deny", whereas {"decision":"allow"} is a permission
# no-op that delegates to normal permission evaluation. Redirect all internal
# output to /dev/null and emit {"decision":"allow"} unconditionally on EXIT so
# this hook can never block or alter permission decisions.

exec 3>&1 >/dev/null 2>&1
trap 'printf "{\"decision\":\"allow\"}\n" >&3; exit 0' EXIT

# Respect explicit opt-out via empty AGENT_REQUIRED_HOOKS="".
if [ "${AGENT_REQUIRED_HOOKS+set}" = set ] && [ -z "$AGENT_REQUIRED_HOOKS" ]; then
  exit 0
fi

if [ -t 0 ]; then
  exit 0
fi

payload=$(cat)

# Pure-bash fast path (<1.5ms, zero subprocesses): ignore the ~98% of commands
# that do not mention both 'git' and 'commit'.
case "$payload" in
  *git*commit* | *commit*git*) ;;
  *) exit 0 ;;
esac

command -v jq >/dev/null 2>&1 || exit 0
command -v git >/dev/null 2>&1 || exit 0

HOOK_BIN=""
if command -v hook >/dev/null 2>&1; then
  HOOK_BIN="hook"
else
  script_dir=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd) || exit 0
  candidate="$script_dir/../../../../skills/workspace-tools/scripts/hook"
  if [ -x "$candidate" ]; then
    HOOK_BIN="$candidate"
  else
    exit 0
  fi
fi

eval "$(
  printf '%s' "$payload" | jq -r '
    "CMD=" + ((
      .toolCall.args.CommandLine //
      .toolCall.args.command //
      .tool_input.command //
      .tool_input.CommandLine //
      .input.command //
      ""
    ) | @sh),
    "TOOL_CWD=" + ((
      .toolCall.args.Cwd //
      .toolCall.args.Directory //
      .tool_input.Cwd //
      .cwd //
      ""
    ) | @sh),
    "WS_PATHS=" + ((
      (.workspacePaths // []) | map(@sh) | join(" ")
    ))
  ' 2>/dev/null || true
)"

[[ "${CMD:-}" =~ (^|[^[:alnum:]_-])git[[:space:]].*commit([^[:alnum:]_-]|$) ]] || exit 0

HOME_REAL=$(cd "$HOME" 2>/dev/null && pwd -P) || HOME_REAL="$HOME"
BASE_CWD="${TOOL_CWD:-}"

ensure_repo_hooks() {
  local dir="$1" base="${2:-}" top hooks_dir
  [ -n "$dir" ] || return 0
  case "$dir" in
    \~) dir="$HOME" ;;
    \~/*) dir="$HOME/${dir#\~/}" ;;
  esac
  case "$dir" in
    /*) ;;
    *)
      [ -n "$base" ] || return 0
      dir="$base/$dir"
      ;;
  esac
  [ -d "$dir" ] || return 0

  top=$(cd "$dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null) || return 0
  top=$(cd "$top" 2>/dev/null && pwd -P) || return 0
  # Never install git hooks into the home directory itself.
  [ "$top" != "$HOME_REAL" ] || return 0

  hooks_dir=$(git -C "$top" rev-parse --git-path hooks 2>/dev/null) || return 0
  case "$hooks_dir" in
    /*) ;;
    *) hooks_dir="$top/$hooks_dir" ;;
  esac

  # Skip repositories where .git/hooks or commit-msg is a symlink (such as
  # Android/GoB 'repo' checkouts pointing into shared .repo/repo/hooks).
  [ ! -L "$hooks_dir" ] || return 0
  [ ! -L "$hooks_dir/commit-msg" ] || return 0

  # Fast path: if the default profile ('agent') is in effect and 10-agent is
  # already installed, skip invoking 'hook'.
  if [ "${AGENT_REQUIRED_HOOKS-agent}" = "agent" ] && [ -x "$hooks_dir/commit-msg.d/10-agent" ]; then
    return 0
  fi

  "$HOOK_BIN" -C "$top" apply --quiet || true
}

# 1. Check the explicit tool working directory (if provided) and each session
# workspace path.
if [ -n "$BASE_CWD" ]; then
  ensure_repo_hooks "$BASE_CWD"
fi
eval "ws_list=(${WS_PATHS:-})"
for ws in "${ws_list[@]:-}"; do
  [ -n "$ws" ] || continue
  [ -n "$BASE_CWD" ] || BASE_CWD="$ws"
  ensure_repo_hooks "$ws"
done

# 2. Check any directories targeted via 'git -C <dir>', 'cd <dir>', or
# 'pushd <dir>' inside the command string.
prev=""
norm_cmd="${CMD//&&/ }"
norm_cmd="${norm_cmd//;/ }"
norm_cmd="${norm_cmd//|/ }"
for tok in $norm_cmd; do
  clean="${tok#\"}"
  clean="${clean%\"}"
  clean="${clean#\'}"
  clean="${clean%\'}"
  case "$prev" in
    -C | cd | pushd)
      ensure_repo_hooks "$clean" "$BASE_CWD"
      ;;
  esac
  case "$clean" in
    -C?*)
      ensure_repo_hooks "${clean#-C}" "$BASE_CWD"
      ;;
  esac
  prev="$clean"
done
