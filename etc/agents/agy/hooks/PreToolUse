#!/usr/bin/env bash
# Installed via ~/.gemini/config/hooks (symlinked by install.sh).
#
# Runs ../../hooks/ensure-commit-hooks, which lazily installs the 10-agent
# commit-msg hook before a 'git commit' tool call.
#
# In Jetski/Antigravity, PreToolUse hooks fail closed and rewrite an empty
# decision ("{}") to "deny", whereas {"decision":"allow"} is a permission
# no-op that delegates to normal permission evaluation. Redirect all internal
# output to /dev/null and emit {"decision":"allow"} unconditionally on EXIT so
# this hook can never block or alter permission decisions.

exec 3>&1 >/dev/null 2>&1
trap 'printf "{\"decision\":\"allow\"}\n" >&3; exit 0' EXIT

script_dir=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd) || exit 0
"$script_dir/../../hooks/ensure-commit-hooks" || true
