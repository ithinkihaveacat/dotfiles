{
  "default": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "./hooks/SessionStart",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/PreToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
