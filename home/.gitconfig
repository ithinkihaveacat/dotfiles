# -*- sh -*-

# Documented in git-config(1).

[user]
    name = Michael Stillwell
    # Modify locally via git config --local user.email mstillwell@workplace.com or
    # GIT_AUTHOR_EMAIL environment variable
    email = mjs@beebo.org

[core]
    excludesfile = ~/.gitignore.global

[diff]
    mnemonicprefix = true
    # https://github.com/blog/2288-git-2-11-has-been-released
    indentHeuristic = true
    compactionHeuristic = true
    relative = true # operate on subdirectories of current directory, not whole repo

[fetch]
    prune = true

[alias]
    # Debug by setting env var GIT_TRACE=1.

    # https://wikileaks.org/ciav7p1/cms/page_1179773.html
    aliases = !git config --get-regexp 'alias.*' | colrm 1 6 | sed 's/[ ]/ = /' | sort
    # Show the object type
    type = cat-file -t
    # e.g. git cat master:path/to/file.txt
    cat = cat-file -p
    stat = status -sb
    # Show ignored files
    ls-ignored = status --ignored

    # Reset to HEAD
    reset-hard = reset --hard HEAD
    # Delete untracked files and directories (doesn't work if no commit...)
    reset-harder = !git reset --hard HEAD && git clean -df
    # Delete ignored files (doesn't work if no initial commit...)
    reset-hardest = !git reset --hard HEAD && git clean -xdf

    # Sets "master" branch to track "origin/master"
    branch-set-master-track-origin = branch master --set-upstream-to origin/master
    # "Verbose" listing of local branches (shows what remote they track) (-avv = all, -rvv = remote)
    branch-local-verbose = branch -lvv

    # Ignore package-lock.json, yarn.lock when displaying diffs
    diff-no-lock = !git diff $1 -- . ':(exclude,top)**/package-lock.json' ':(exclude,top)package-lock.json' ':(exclude,top)**/yarn.lock' ':(exclude,top)yarn.lock'

    # Cloning and naming things notes (no good alias...):
    #
    # git clone --origin upstream # changes name to "upstream", but adds tracking info
    # git remote rename <old> <new>
    # git branch --unset-upstream # removes tracking info (but need to change into repo dir, can use cd $(ls -t | head -1)...)
    # git branch -u origin/master # current branch tracks origin/master (but need to fetch first)
    #
    # Example of handling arguments:
    #clone-upstream = "!git clone --origin upstream \"$1\" && cd $(ls -t | head -1) && git branch --unset-upstream #"

    # usage: git date-created foo/bar/baz.txt
    # May not be completely correct: http://stackoverflow.com/a/25633731/11543
    date-created = -c pager.log=false log --pretty=%aI --follow --diff-filter=A
    # usage: git date-modified foo/bar/baz.txt
    date-modified = -c pager.log=false log --pretty=%aI -n 1

    spush = stash -u
    spop = stash pop
    sapply = stash apply

    # Given a ref, returns merge commits that involved that ref
    show-merged-by = "!f() { git log --ancestry-path --merges $1..$(git rev-parse --abbrev-ref HEAD); }; f"

    # Like "git branch", but sorted by last modified date
    # http://stackoverflow.com/a/10693888/11543
    branch-by-date = for-each-ref --sort=-committerdate refs/heads/ --format='%(refname:short) (%(committerdate:short))'

    # Skip/ignore local changes to a file (see also --assume-unchanged)
    # https://codeclimber.net.nz/archive/2016/12/19/ignoring-files-on-git-but-just-for-a-while-with-assume-unchanged/#comment-3264877345
    skip = update-index --skip-worktree
    unskip = update-index --no-skip-worktree
    ls-skipped = "!git ls-files -v | grep ^S | cut -c 3-"

    # Like "git status", but takes a reference
    diff-status = !git --no-pager diff --name-status

    # For gerrit (if get an error on first push, set remote via "git branch -u myremote")
    push-gerrit = !git push $(dirname $(git rev-parse --abbrev-ref '@{upstream}')) HEAD:refs/for/$(basename $(git rev-parse --abbrev-ref '@{upstream}'))

    # Push local commits on the current branch to a remote topic branch and open a draft PR
    # without checking out a local branch. Usage: git push-pr [-h|--help] [-f|--force] [BRANCH]
    push-pr = "!f() { set -e; force=0; has_branch=0; branch=''; while [ $# -gt 0 ]; do case \"$1\" in -h|--help) printf 'Usage: git push-pr [-h|--help] [-f|--force] [BRANCH]\\n'; return 0 ;; -f|--force) force=1; shift ;; --) shift; if [ $# -gt 0 ] && [ \"$has_branch\" = 0 ]; then branch=$1; has_branch=1; shift; fi; if [ $# -gt 0 ]; then echo \"git push-pr: unexpected argument: $1\" >&2; return 1; fi ;; -*) echo \"git push-pr: unknown option: $1\" >&2; return 1 ;; *) if [ \"$has_branch\" = 1 ]; then echo \"git push-pr: unexpected argument: $1\" >&2; return 1; fi; branch=$1; has_branch=1; shift ;; esac; done; command -v gh >/dev/null 2>&1 || { echo 'git push-pr: gh not found' >&2; return 127; }; cur=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || { echo 'git push-pr: detached HEAD' >&2; return 1; }; up=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || { echo 'git push-pr: current branch has no upstream' >&2; return 1; }; git rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1 || { echo \"git push-pr: upstream '$up' cannot be resolved\" >&2; return 1; }; up_remote=$(git config --get \"branch.$cur.remote\" 2>/dev/null || true); [ -n \"$up_remote\" ] || up_remote=${up%%/*}; base=$(git config --get \"branch.$cur.merge\" 2>/dev/null || true); base=${base#refs/heads/}; [ -n \"$base\" ] || base=${up#\"$up_remote\"/}; push_remote=$(git config --get \"branch.$cur.pushRemote\" 2>/dev/null || true); if [ -z \"$push_remote\" ]; then push_remote=$(git config --get remote.pushDefault 2>/dev/null || true); if [ -n \"$push_remote\" ] && ! git remote get-url \"$push_remote\" >/dev/null 2>&1; then push_remote=''; fi; fi; remote=${push_remote:-$up_remote}; git -c diff.relative=false diff --quiet && git -c diff.relative=false diff --cached --quiet || { echo 'git push-pr: uncommitted changes present; commit them first' >&2; return 1; }; ahead=$(git rev-list --count \"$up..HEAD\"); [ \"$ahead\" -gt 0 ] || { echo \"git push-pr: no commits on '$cur' ahead of '$up'\" >&2; return 1; }; if [ -n \"$(git ls-files --others --exclude-standard)\" ]; then echo 'git push-pr: note: untracked files present (not included in PR)' >&2; fi; first_sha=$(git rev-list --reverse \"$up..HEAD\" | sed -n '1p'); title=$(git log -1 --format=%s \"$first_sha\"); if [ \"$has_branch\" = 0 ]; then slug=$(printf '%s\\n' \"$title\" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cs 'a-z0-9\\n' '-' | sed 's/^-*//; s/-*$//' | cut -c1-40 | sed 's/-*$//'); branch=\"pr/${slug:-update}\"; else branch=${branch#refs/heads/}; branch=${branch#\"$remote/\"}; branch=${branch#\"$up_remote/\"}; fi; [ -n \"$branch\" ] || { echo 'git push-pr: empty target branch' >&2; return 1; }; [ \"$branch\" != \"$base\" ] || { echo \"git push-pr: target branch cannot be '$base'\" >&2; return 1; }; up_slug=''; head_owner=''; if [ \"$remote\" != \"$up_remote\" ]; then u=$(git remote get-url \"$up_remote\" 2>/dev/null || true); case \"$u\" in file://*) ;; https://*/*/*|http://*/*/*|ssh://*/*/*) s=${u#*://}; p=${s#*/}; p=${p#/}; p=${p%.git}; p=${p%/}; case \"$p\" in */*) case \"${p#*/}\" in ''|*/*) ;; *) up_slug=$p ;; esac ;; esac ;; *@*:*/*) p=${u#*:}; p=${p#/}; p=${p%.git}; p=${p%/}; case \"$p\" in */*) case \"${p#*/}\" in ''|*/*) ;; *) up_slug=$p ;; esac ;; esac ;; esac; u=$(git remote get-url \"$remote\" 2>/dev/null || true); case \"$u\" in file://*) ;; https://*/*/*|http://*/*/*|ssh://*/*/*) s=${u#*://}; p=${s#*/}; p=${p#/}; p=${p%.git}; p=${p%/}; case \"$p\" in */*) case \"${p#*/}\" in ''|*/*) ;; *) head_owner=${p%%/*} ;; esac ;; esac ;; *@*:*/*) p=${u#*:}; p=${p#/}; p=${p%.git}; p=${p%/}; case \"$p\" in */*) case \"${p#*/}\" in ''|*/*) ;; *) head_owner=${p%%/*} ;; esac ;; esac ;; esac; fi; if [ \"$force\" = 1 ]; then refspec=\"+HEAD:refs/heads/$branch\"; else refspec=\"HEAD:refs/heads/$branch\"; fi; git push \"$remote\" \"$refspec\"; if [ \"$remote\" = \"$up_remote\" ]; then existing=$(gh pr list --head \"$branch\" --state open --json url,isCrossRepository --jq 'map(select(.isCrossRepository | not)) | .[0].url // empty'); pr_head=$branch; set --; else if [ -n \"$up_slug\" ]; then set -- -R \"$up_slug\"; else set --; fi; if [ -n \"$head_owner\" ]; then existing=$(gh pr list \"$@\" --head \"$branch\" --state open --json url,headRepositoryOwner --jq 'map(select(.headRepositoryOwner.login == \"'\"$head_owner\"'\")) | .[0].url // empty'); pr_head=\"$head_owner:$branch\"; else existing=$(gh pr list \"$@\" --head \"$branch\" --state open --json url,isCrossRepository --jq 'map(select(.isCrossRepository)) | .[0].url // empty'); pr_head=$branch; fi; fi; if [ -n \"$existing\" ]; then printf '%s\\n' \"$existing\"; return 0; fi; if [ \"$ahead\" -eq 1 ]; then body=$(git log -1 --format=%b \"$first_sha\"); else body=$(git log --reverse --format='- %s' \"$up..HEAD\"); fi; gh pr create \"$@\" --draft --head \"$pr_head\" --base \"$base\" --title \"$title\" --body \"$body\"; }; f"

    # Add staged changes to previous commit (useful for gerrit: stage
    # the change you want, then run this--no comment needed)
    commit-amend = commit --amend --no-edit

    # Show tracked files; useful for piping to entr
    tracked = ls-tree -r HEAD --name-only

    # Remove node_modules (dangerous!)
    clean-node-modules = "!find . -type d -name node_modules -prune -print -exec rm -rf {} +"

    checkout-main = "!git checkout main > /dev/null || git checkout master"


[advice]
    pushNonFastForward = false
    statusHints = true

[remote]
    # Triangular workflow for forks: pull from branch.<name>.remote (e.g.
    # upstream/main), push to origin by default.
    pushDefault = origin

[push]
    autoSetupRemote = true
    default = simple

[merge]
    defaultToUpstream = true

[hooks]
    #preCommitRegexp = rawlog|console\\.log

[init]
    defaultBranch = main

[color]
    ui = auto

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[gitreview]
    # https://www.mediawiki.org/wiki/Gerrit/git-review
	remote = origin

[http]
	cookiefile = ~/.gitcookies

[pager]
	branch = false

[pull]
    # Push and pull should be symmetric; see https://felipec.wordpress.com/2021/07/05/git-update/
    ff = only

# TODO: Conditionalise on directory (e.g. if split into personal and work repos)
# https://utf9k.net/blog/conditional-gitconfig/
[repo]
    superprojectChoiceExpire = 1759399951
    superprojectChoice = true

[credential "https://github.com"]
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = !gh auth git-credential

[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:**/ithinkihaveacat/dotfiles"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:**/ithinkihaveacat/dotfiles.git"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:git@*:ithinkihaveacat/dotfiles"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:git@*:ithinkihaveacat/dotfiles.git"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig

[includeIf "gitdir:~/.private/"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:**/ithinkihaveacat/private"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:**/ithinkihaveacat/private.git"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:git@*:ithinkihaveacat/private"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:git@*:ithinkihaveacat/private.git"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig

[includeIf "gitdir:~/.ssh/"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:**/ithinkihaveacat/ssh"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:**/ithinkihaveacat/ssh.git"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:git@*:ithinkihaveacat/ssh"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig
[includeIf "hasconfig:remote.*.url:git@*:ithinkihaveacat/ssh.git"]
	path = ~/.dotfiles/etc/git/pr-only.gitconfig

[include]
	path = ~/.gitconfig.local
