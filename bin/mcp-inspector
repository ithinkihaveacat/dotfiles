#!/usr/bin/env bash

usage() {
  cat <<EOF
Usage: $(basename "$0") COMMAND|FILE|URL [ARGS...]

Interactive inspector for Model Context Protocol (MCP) servers.

If the first argument is an executable command, it runs the inspector for that command.
If the first argument is a JSON configuration file, it lists available servers or
runs the inspector for a specific server if a second argument is provided.
If the first argument is an http:// or https:// URL, it runs the inspector against
that URL as an HTTP/SSE MCP server.

Arguments:
  COMMAND|FILE|URL  The command to run, path to an MCP config JSON file, or the
                    URL of an HTTP/SSE MCP server.
  ARGS...           Arguments for the command, the name of the server in the
                    config file, or extra flags forwarded to the inspector
                    (e.g. --cli, --header, --use-stored-auth) for a URL target.

Options:
  --help        Display this help message and exit

Examples:
  # Run inspector for a specific command
  $(basename "$0") npx -y sqlite-mcp-server /path/to/db.sqlite

  # List servers from a config file
  $(basename "$0") mcp-config.json

  # Run inspector for a specific server from a config file
  $(basename "$0") mcp-config.json my-server

  # Run inspector against a remote HTTP server, e.g. one behind OAuth; the web
  # UI's own OAuth panel is where you enter a Client ID/Secret, so neither
  # touches the command line
  $(basename "$0") https://example.com/mcp

  # Re-run non-interactively after authenticating once via the web UI above
  $(basename "$0") https://example.com/mcp --cli --use-stored-auth --method tools/list
EOF
  exit 0
}

usage_short() {
  cat <<EOF >&2
Usage: $(basename "$0") COMMAND|FILE|URL [ARGS...]

Interactive inspector for Model Context Protocol (MCP) servers.

Examples:
  $(basename "$0") npx -y sqlite-mcp-server /path/to/db.sqlite

Try '$(basename "$0") --help' for more information.
EOF
  exit 1
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
fi

if [ -z "${1:-}" ]; then
  usage_short
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require npx
require jq

# If the first argument is an http(s) URL, run the inspector against it as an
# HTTP/SSE MCP server. Checked before the executable/file branches below so a
# URL never falls through to the "not found, and is not a file" error.
if [[ "$1" =~ ^https?:// ]]; then

  URL="$1"
  shift

  # Default to web mode: its OAuth panel takes a Client ID/Secret typed into
  # the browser, so a confidential client's secret never touches argv, shell
  # history, or `ps`. Skip the default if the caller already picked a mode.
  MODE=(--web)
  for arg in "$@"; do
    case "$arg" in
      --web | --cli | --tui) MODE=() ;;
    esac
  done

  for arg in "$@"; do
    if [[ "$arg" == "--client-secret" ]]; then
      echo "$(basename "$0"): warning: --client-secret puts the secret in argv/shell history; prefer running without a mode flag once to authenticate via the web UI, then '--cli --use-stored-auth' afterwards" >&2
      break
    fi
  done

  npx @modelcontextprotocol/inspector "${MODE[@]}" --transport http --server-url "$URL" "$@"
  exit $?

fi

# If the first argument is an executable, run it with the inspector.
if command -v "$1" >/dev/null 2>&1; then

  npx @modelcontextprotocol/inspector "$@"
  exit $?

fi

# Otherwise, treat the first argument as a JSON config file.
CONFIG_FILE="$1"
SERVER_NAME="${2:-}"

if [ ! -f "$CONFIG_FILE" ]; then
  echo "$(basename "$0"): Error: Command '$1' not found, and is not a file." >&2
  exit 1
fi

if [ -z "$SERVER_NAME" ]; then

  # If no server name is given, list the available servers from the config file.
  echo "Available servers:"
  jq -r '.mcpServers | keys[]' "$CONFIG_FILE"

else

  # If a server name is provided, run the inspector with the server's config.

  # Check if the server key exists in the JSON file.
  if ! jq -e ".mcpServers.\"$SERVER_NAME\"" "$CONFIG_FILE" >/dev/null; then
    echo "$(basename "$0"): Error: Server '$SERVER_NAME' not found in $CONFIG_FILE" >&2
    exit 1
  fi

  # Extract the command and arguments from the JSON file.
  CMD=$(jq -r ".mcpServers.\"$SERVER_NAME\".command" "$CONFIG_FILE")
  # Use mapfile/readarray for safety
  readarray -t ARGS < <(jq -r ".mcpServers.\"$SERVER_NAME\".args[]" "$CONFIG_FILE")

  # Pass through any errors from jq.
  if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    echo "$(basename "$0"): Error: Could not parse command or args for server '$SERVER_NAME' in '$CONFIG_FILE'." >&2
    exit 1
  fi

  npx @modelcontextprotocol/inspector "$CMD" "${ARGS[@]}"

fi
