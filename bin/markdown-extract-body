#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") < INPUT_FILE

Extracts the core "body" of the text from a Markdown document, removing repetitive
headers, footers, sidebars, and other boilerplate.

Input:
  stdin       The Markdown content to process.

Options:
  --help      Display this help message and exit

Environment:
  GEMINI_API_KEY                 Required. Your Gemini API key.
  MARKDOWN_EXTRACT_BODY_OFFLINE  Refuse to use the network. This tool caches
                                 nothing, so offline mode fails immediately
                                 rather than serving a stale answer. Falls back
                                 to AGENT_OFFLINE when unset.
  AGENT_OFFLINE                  Workspace-wide offline policy (see above).

Examples:
  cat article.md | $(basename "$0") > article-body.md
EOF
  exit 0
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require curl
require jq

# Refuse to run when the environment declares there is no network. Every run is
# a fresh model call against a new prompt, so there is nothing cached to serve
# and offline mode fails here rather than on a connect timeout. The per-tool
# variable wins when set (including when set to 0, to exempt this tool from a
# workspace-wide policy) -- see coding-standards/references/caching.md.
require_network() {
  local var="$1" value
  [[ -n "${!var+x}" ]] || var="AGENT_OFFLINE"
  value="${!var:-}"
  case "$(echo "$value" | tr '[:upper:]' '[:lower:]')" in
    1 | true | yes | on)
      echo "$(basename "$0"): offline ($var=$value) and no cached answer: this command calls the Gemini API" >&2
      echo "$(basename "$0"): re-run where there is network, or set $1=0 to exempt this tool" >&2
      exit 1
      ;;
  esac
}

require_network MARKDOWN_EXTRACT_BODY_OFFLINE

# Read stdin into a variable
if [ -t 0 ]; then
  echo "$(basename "$0"): Error: No input provided on stdin." >&2
  usage
fi
GEMINI_API_KEY="${GEMINI_API_KEY:-}"
if [[ -z "${GEMINI_API_KEY:-}" ]]; then
  echo "$(basename "$0"): GEMINI_API_KEY environment variable not set" >&2
  exit 1
fi

MODEL="gemini-2.5-flash-lite"
URL="https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent"

SYSTEM_INSTRUCTION=$(
  cat <<'EOF'
You are an expert content extractor. Your task is to take a raw Markdown document (which may contain website boilerplate like navigation menus, "Related Stories" sidebars, footers, share buttons, and advertisements) and extract ONLY the core article or body content.

### Guidelines:

1.  **Remove Boilerplate:** Delete all headers, footers, navigation links, "Read also" lists, "Share this" sections, and advertisements.
2.  **Preserve Core Content:** Keep the main title and the entire narrative body text of the article.
3.  **Exclude Metadata Blocks:** Remove publication dates, bylines, and categories if they appear as separate blocks before the main content starts.
4.  **Maintain Formatting:** Preserve the Markdown formatting (bolding, headers, lists, links) of the core content.
5.  **No Commentary:** Return ONLY the cleaned Markdown. Do not add introductory or concluding remarks.
6.  **Output:** The output should be ready to publish as a standalone Markdown file.

### Example:

Input:
    Menu | Home | News
    Related: 5 tips for success
    # The Real Story
    By Jane Doe
    Published on Jan 1
    Share on Twitter
    This is the first paragraph.
    Subscribe now!
    Footer stuff

Output:
    # The Real Story
    
    This is the first paragraph.
EOF
)

# Construct the JSON payload using jq for safety
REQUEST_BODY=$(jq -Rs \
  --arg system_instruction "$SYSTEM_INSTRUCTION" \
  '{ 
    system_instruction: { 
      parts: [{ text: $system_instruction }] 
    }, 
    contents: [ 
      { 
        role: "user", 
        parts: [ 
          { text: . }
        ] 
      } 
    ], 
    generationConfig: { 
      temperature: 0.1
    }
  }')

# Execute the request
# Read the status via -w '%{http_code}' rather than trusting curl's exit code:
# it is "000" only when no HTTP response arrived at all, which is what separates
# a blocked or absent network from an API that answered with an error. Capturing
# the exit code also stops a failed curl from killing the script silently under
# `set -e`, before any of the handling below can run.
CURL_STATUS=0
RAW=$(echo "${REQUEST_BODY}" | curl -sS -X POST \
  -H "x-goog-api-key: $GEMINI_API_KEY" \
  -H "Content-Type: application/json" \
  -d @- -w '\n%{http_code}' \
  "${URL}" 2>/dev/null) || CURL_STATUS=$?

HTTP_STATUS="${RAW##*$'\n'}"
RESPONSE="${RAW%$'\n'*}"

# Classify by status first: -w emits a three-digit code whenever a response
# arrived, and "000" when none did. The exit code cannot make that distinction
# -- in a `jq | curl` pipeline `pipefail` reports the pipeline's status, so a
# curl that answered fine can still surface as non-zero -- so it is reported
# here for diagnosis only. It becomes meaningful again on the 2xx path below.
if [[ ! "$HTTP_STATUS" =~ ^[0-9]{3}$ || "$HTTP_STATUS" == "000" ]]; then
  echo "$(basename "$0"): could not reach $URL (curl exit $CURL_STATUS, http ${HTTP_STATUS:-none}: network unreachable, DNS failure, or blocked egress)" >&2
  exit 1
fi

# Only on a 2xx does the exit code say something the status cannot: whether the
# body finished arriving. A response truncated mid-transfer still reads as HTTP
# 200, and would otherwise reach the parser below and be reported as the model
# returning nothing -- a refusal, rather than the transport failure it is.
if [[ "$HTTP_STATUS" == 2?? && $CURL_STATUS -ne 0 ]]; then
  echo "$(basename "$0"): $URL returned HTTP $HTTP_STATUS but the body did not finish transferring (curl exit $CURL_STATUS)" >&2
  exit 1
fi

if [[ "$HTTP_STATUS" != 2?? ]]; then
  ERROR_MSG=$(echo "$RESPONSE" | jq -r '.error.message // empty' 2>/dev/null || true)
  echo "$(basename "$0"): API error (HTTP $HTTP_STATUS): ${ERROR_MSG:-no error message in response}" >&2
  exit 1
fi

# Extract and output the text response
TEXT=$(echo "$RESPONSE" | jq -r '.candidates[0].content.parts[0].text // empty')

if [[ -z "$TEXT" ]]; then
  # Fallback: sometimes the model might block content or return explicit refusal
  FINISH_REASON=$(echo "$RESPONSE" | jq -r '.candidates[0].finishReason // "UNKNOWN"')
  echo "$(basename "$0"): No response text received. Finish Reason: $FINISH_REASON" >&2
  exit 1
fi

echo "$TEXT"
