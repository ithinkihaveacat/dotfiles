#!/usr/bin/env bash

# See ~/.gitconfig for push-gerrit alias.

usage() {
  cat <<EOF
Usage: $(basename "$0")

Downloads and installs the Gerrit commit-msg hook for the current repository.

The hook is copied rather than installed as a trampoline: it is fetched from
gerrit-review.googlesource.com and has no source in this dotfiles tree for a
trampoline to point at.

Options:
  --help      Display this help message and exit
EOF
  exit 0
}

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  usage
fi

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require git
require curl
require git-hook-multiplexer

git rev-parse --git-dir >/dev/null 2>&1 || {
  echo "$(basename "$0"): error: not a git repository" >&2
  exit 1
}
TMPDIR=$(mktemp -d)
trap 'rm -rf -- "$TMPDIR"' EXIT

GERRIT_HOOK_URL=https://gerrit-review.googlesource.com/tools/hooks/commit-msg
if ! curl -sSLo "$TMPDIR/commit-msg" "$GERRIT_HOOK_URL"; then
  echo "$(basename "$0"): failed to fetch $GERRIT_HOOK_URL" >&2
  exit 1
fi
chmod +x "$TMPDIR/commit-msg"

git-hook-multiplexer install --copy commit-msg 50-gerrit "$TMPDIR/commit-msg"
