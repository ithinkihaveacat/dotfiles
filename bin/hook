#!/usr/bin/env bash

# Targets Bash version 3.2.57(1)-release
# Tests: tests/test-hook

set -euo pipefail

SCRIPT_NAME=$(basename "$0")

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME <command> [arguments]

Manage this repository's git hooks. Hooks are grouped into profiles; each
profile installs one or more sub-hooks through a multiplexer at
.git/hooks/<hook-name>, so profiles coexist with each other and with hooks
from other tools.

A sub-hook is installed as a trampoline: a generated stub whose body execs
the hook source where it lives in this dotfiles tree. Editing that source
changes the behaviour of every repository the profile is installed into,
with no re-install step, and a source that has gone away fails the hook
loudly rather than being silently skipped.

A pre-existing hook not managed by this tool is preserved as
.git/hooks/<hook-name>.d/00-legacy and continues to run first. Removing the
last managed sub-hook restores it as the plain hook.

Commands:
  apply             Synchronize this repository's hooks to match
                    AGENT_REQUIRED_HOOKS (idempotent)
  add PROFILE...    Add a hook profile
  remove PROFILE... Remove a hook profile, leaving other hooks in place
                    (alias: rm)
  list              List the hooks installed in this repository (alias: ls)
  catalog           List the hook profiles available to add
  doctor            Report missing, drifted or unmanaged hooks (read-only)
  clean             Remove every profile this tool manages, leaving
                    third-party hooks and 00-legacy in place

Options:
  --copy            add/apply: copy the hook source instead of installing a
                    trampoline to it, for a machine with no dotfiles tree
  --all             clean: delete the entire hooks directory, including
                    third-party hooks; requires --force
  --force           clean --all: confirm the deletion
  --help, -h        Display this help message and exit

Environment:
  AGENT_REQUIRED_HOOKS  Whitespace-separated profiles 'apply' installs
                        (default: agent). Profiles it does not name are
                        removed, the way 'skill apply' synchronizes skills.
  HOOK_OFFLINE          Set to 1 to fail rather than fetch a profile whose
                        hook is downloaded (gerrit).
  AGENT_OFFLINE         Workspace-wide offline policy, used when
                        HOOK_OFFLINE is unset.

Examples:
  $SCRIPT_NAME apply
  $SCRIPT_NAME add node
  $SCRIPT_NAME list
  $SCRIPT_NAME doctor
  $SCRIPT_NAME remove gerrit
  env AGENT_REQUIRED_HOOKS='agent node' $SCRIPT_NAME apply
EOF
  exit 0
}

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "$SCRIPT_NAME: $1 not found" >&2
    exit 127
  }
}

die() {
  echo "$SCRIPT_NAME $cmd: $*" >&2
  exit 1
}

# Hook sources live alongside the dotfiles tree, two levels up from this
# script: bin/hook -> etc/git/hooks/.
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null && pwd)
SOURCE_ROOT="$SCRIPT_DIR/../etc/git/hooks"

GERRIT_HOOK_URL=https://gerrit-review.googlesource.com/tools/hooks/commit-msg

# ---------------------------------------------------------------------------
# Profile catalog
# ---------------------------------------------------------------------------

PROFILES="agent node gerrit"

# Each profile expands to one or more "<hook-name>:<key>" pairs. Keys carry a
# numeric prefix so the run order within a hook is explicit.
profile_pairs() {
  case "$1" in
    agent) echo "commit-msg:10-agent" ;;
    node) echo "pre-commit:10-node" ;;
    gerrit) echo "commit-msg:50-gerrit" ;;
    *) return 1 ;;
  esac
}

profile_summary() {
  case "$1" in
    agent) echo "Commit message format and Co-Authored-By trailer hygiene" ;;
    node) echo "prettier formatting of staged .ts and .md files" ;;
    gerrit) echo "Gerrit Change-Id trailer (downloaded, installed as a copy)" ;;
  esac
}

# The source file a profile installs for a given hook name. A profile with no
# source in this tree (gerrit) fetches one instead; see fetch_profile_source.
profile_source() {
  case "$1" in
    agent | node) printf '%s\n' "$SOURCE_ROOT/$1/$2" ;;
    *) return 1 ;;
  esac
}

offline() {
  local flag="${HOOK_OFFLINE:-${AGENT_OFFLINE:-}}"
  [ -n "$flag" ] && [ "$flag" != "0" ]
}

# Downloads a profile's hook into $1 and echoes the path. Only gerrit needs
# this; a downloaded hook has no home in this tree for a trampoline to point
# at, so it is always installed with --copy.
fetch_profile_source() {
  local profile="$1" dir="$2"
  case "$profile" in
    gerrit)
      require curl
      if offline; then
        die "refusing to fetch $GERRIT_HOOK_URL (offline mode); unset HOOK_OFFLINE/AGENT_OFFLINE to allow it"
      fi
      if ! curl -sSLo "$dir/commit-msg" "$GERRIT_HOOK_URL"; then
        die "failed to fetch $GERRIT_HOOK_URL"
      fi
      chmod +x "$dir/commit-msg"
      printf '%s\n' "$dir/commit-msg"
      ;;
    *) return 1 ;;
  esac
}

is_profile() {
  profile_pairs "$1" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Multiplexer plumbing
# ---------------------------------------------------------------------------

LEGACY_KEY="00-legacy"

MULTIPLEXER_MARKER="hook-multiplexer"
# Recognize every spelling this marker has had, so a hook installed by an
# older version of this tool is treated as managed-but-stale (refreshed in
# place) rather than as a foreign hook to be demoted to 00-legacy.
#
# Anchored to a comment line in the header, not matched anywhere in the file:
# a foreign hook that merely mentions this tool (in a path, a comment or an
# error message) must still be recognized as foreign and preserved, not
# silently overwritten as if we had written it.
MULTIPLEXER_MARKER_RE='^# (git-)?hooks?-multiplexer([: ]|$)'
MARKER_SCAN_LINES=5

TRAMPOLINE_MARKER="hook-trampoline"

# The multiplexer body is deliberately free of per-hook substitutions: it
# derives its sub-hook directory from "$0", which git sets to the path it
# invoked the hook by. One constant body therefore serves every hook name,
# which is also what lets doctor compare it byte-for-byte against this
# function's output and call the difference drift.
multiplexer_content() {
  cat <<EOF
#!/bin/sh
# $MULTIPLEXER_MARKER
# This file is managed by '$SCRIPT_NAME'. Do not edit directly.

HOOKS_DIR="\$0.d"

# Buffer stdin so multiple hooks can read the same stream. Skip a terminal
# so running the hook by hand does not block waiting for EOF.
STDIN_TMP=\$(mktemp)
trap 'rm -f "\$STDIN_TMP"' EXIT
if [ ! -t 0 ]; then
  cat > "\$STDIN_TMP"
fi

if [ -d "\$HOOKS_DIR" ]; then
  for hook in "\$HOOKS_DIR"/*; do
    [ -e "\$hook" ] || continue
    if [ -x "\$hook" ]; then
      "\$hook" "\$@" < "\$STDIN_TMP" || exit \$?
    fi
  done
fi
EOF
}

# A trampoline names its source on the marker line so doctor can find the
# target again without a side-car record, and so anyone reading the installed
# hook can see where the real code lives.
trampoline_content() {
  cat <<EOF
#!/bin/sh
# $TRAMPOLINE_MARKER -> $1
# Generated by '$SCRIPT_NAME'. Do not edit; edit the source above.

exec "$1" "\$@"
EOF
}

# The source a trampoline execs, or empty if the file is not a trampoline
# (a --copy install, or a third-party sub-hook we did not write). Older
# spellings of the marker are read so their stubs are reported as drift
# rather than mistaken for opaque copies.
trampoline_target() {
  local n=0 line
  [ -f "$1" ] || return 0
  while [ "$n" -lt "$MARKER_SCAN_LINES" ] && IFS= read -r line; do
    n=$((n + 1))
    case "$line" in
      "# $TRAMPOLINE_MARKER -> "*)
        printf '%s\n' "${line#"# $TRAMPOLINE_MARKER -> "}"
        return 0
        ;;
      "# git-$TRAMPOLINE_MARKER -> "*)
        printf '%s\n' "${line#"# git-$TRAMPOLINE_MARKER -> "}"
        return 0
        ;;
    esac
  done <"$1"
  return 0
}

is_managed_multiplexer() {
  local n=0 line
  [ -f "$1" ] || return 1
  while [ "$n" -lt "$MARKER_SCAN_LINES" ] && IFS= read -r line; do
    n=$((n + 1))
    if [[ "$line" =~ $MULTIPLEXER_MARKER_RE ]]; then
      return 0
    fi
  done <"$1"
  return 1
}

abs_path() {
  local dir base
  dir=$(dirname "$1")
  base=$(basename "$1")
  if ! dir=$(cd "$dir" 2>/dev/null && pwd); then
    die "cannot resolve directory of $1"
  fi
  printf '%s/%s\n' "$dir" "$base"
}

count_entries() {
  local n=0 f
  for f in "$1"/*; do
    [ -e "$f" ] || continue
    n=$((n + 1))
  done
  printf '%s' "$n"
}

install_multiplexer() {
  local dst="$1" subdir="$1.d"
  mkdir -p "$(dirname "$dst")"

  if [ -f "$dst" ] && ! is_managed_multiplexer "$dst"; then
    mkdir -p "$subdir"
    if [ -e "$subdir/$LEGACY_KEY" ]; then
      die "refusing to overwrite $subdir/$LEGACY_KEY with the unmanaged hook at $dst"
    fi
    echo "$SCRIPT_NAME $cmd: moving existing unmanaged hook to $subdir/$LEGACY_KEY" >&2
    mv "$dst" "$subdir/$LEGACY_KEY"
  fi

  multiplexer_content >"$dst"
  chmod +x "$dst"
}

install_subhook() { # install_subhook HOOK_NAME KEY SOURCE [COPY]
  local name="$1" key="$2" src="$3" copy="${4:-$copy_mode}"
  local dst="$HOOKS_DIR/$name" subdir="$HOOKS_DIR/$name.d"

  [ -f "$src" ] || die "hook source not found: $src"

  install_multiplexer "$dst"
  mkdir -p "$subdir"
  if [ "$copy" = yes ]; then
    cp "$src" "$subdir/$key"
  else
    trampoline_content "$(abs_path "$src")" >"$subdir/$key"
  fi
  chmod +x "$subdir/$key"
  echo "$SCRIPT_NAME $cmd: installed $key to $subdir/$key" >&2
}

remove_subhook() { # remove_subhook HOOK_NAME KEY
  local name="$1" key="$2"
  local dst="$HOOKS_DIR/$name" subdir="$HOOKS_DIR/$name.d"
  local remaining

  [ -e "$subdir/$key" ] || return 0
  rm -f "$subdir/$key"
  echo "$SCRIPT_NAME $cmd: removed $subdir/$key" >&2

  # Tear the multiplexer down only once nothing of ours is left under it, and
  # only if it is ours to tear down. A 00-legacy hook displaced on install is
  # put back exactly where it was found.
  [ -d "$subdir" ] || return 0
  is_managed_multiplexer "$dst" || return 0
  remaining=$(count_entries "$subdir")
  if [ "$remaining" -eq 0 ]; then
    rmdir "$subdir"
    rm -f "$dst"
    echo "$SCRIPT_NAME $cmd: removed the now-empty multiplexer at $dst" >&2
  elif [ "$remaining" -eq 1 ] && [ -e "$subdir/$LEGACY_KEY" ]; then
    mv "$subdir/$LEGACY_KEY" "$dst"
    rmdir "$subdir"
    echo "$SCRIPT_NAME $cmd: restored the pre-existing hook at $dst" >&2
  fi
}

# One of: ok, missing_multiplexer, unmanaged_multiplexer, drifted_multiplexer,
# missing_subhook, drifted_subhook, orphaned_subhook.
subhook_state() { # subhook_state HOOK_NAME KEY
  local name="$1" key="$2"
  local dst="$HOOKS_DIR/$name" sub="$HOOKS_DIR/$name.d/$key" target

  if [ ! -f "$dst" ]; then
    echo "missing_multiplexer"
    return
  fi
  if ! is_managed_multiplexer "$dst"; then
    echo "unmanaged_multiplexer"
    return
  fi
  if ! cmp -s <(multiplexer_content) "$dst"; then
    echo "drifted_multiplexer"
    return
  fi
  if [ ! -x "$sub" ]; then
    echo "missing_subhook"
    return
  fi
  target=$(trampoline_target "$sub")
  if [ -n "$target" ]; then
    # A trampoline cannot carry stale hook *content* — it execs the source
    # every time — so the only failures left are a target that has gone away
    # and a stub this version would no longer generate.
    if [ ! -x "$target" ]; then
      echo "orphaned_subhook"
      return
    fi
    if ! cmp -s <(trampoline_content "$target") "$sub"; then
      echo "drifted_subhook"
      return
    fi
  fi
  echo "ok"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

required_profiles() {
  # Unset means the default profile set; set-but-empty means "no hooks", the
  # same distinction 'skill' draws for AGENT_REQUIRED_SKILLS.
  local declared="${AGENT_REQUIRED_HOOKS-agent}"
  # shellcheck disable=SC2086 # deliberate: a whitespace-separated profile list
  printf '%s\n' $declared
}

# Must be called as a statement, never inside a command substitution: the
# EXIT trap belongs to the shell that will still be running when the
# directory is used, and a subshell would fire it the moment it exits.
SCRATCH=""
ensure_scratch() {
  if [ -z "$SCRATCH" ]; then
    SCRATCH=$(mktemp -d)
    trap 'rm -rf -- "$SCRATCH"' EXIT
  fi
}

add_profile() {
  local profile="$1" pair name key src
  is_profile "$profile" || die "unknown profile: $profile (try '$SCRIPT_NAME catalog')"

  for pair in $(profile_pairs "$profile"); do
    name="${pair%%:*}"
    key="${pair#*:}"
    if src=$(profile_source "$profile" "$name"); then
      install_subhook "$name" "$key" "$src"
    else
      # A downloaded hook has no source here to track, so it is copied.
      ensure_scratch
      src=$(fetch_profile_source "$profile" "$SCRATCH")
      install_subhook "$name" "$key" "$src" yes
    fi
  done
}

remove_profile() {
  local profile="$1" pair
  is_profile "$profile" || die "unknown profile: $profile (try '$SCRIPT_NAME catalog')"
  for pair in $(profile_pairs "$profile"); do
    remove_subhook "${pair%%:*}" "${pair#*:}"
  done
}

# A profile counts as installed if any of its sub-hooks is present, so a
# half-installed profile is still visible to apply/clean/doctor.
profile_installed() {
  local profile="$1" pair
  for pair in $(profile_pairs "$profile"); do
    [ -e "$HOOKS_DIR/${pair%%:*}.d/${pair#*:}" ] && return 0
  done
  return 1
}

cmd_apply() {
  local wanted profile found
  wanted=$(required_profiles)

  for profile in $wanted; do
    is_profile "$profile" || die "unknown profile in AGENT_REQUIRED_HOOKS: $profile"
  done

  for profile in $PROFILES; do
    found=no
    for want in $wanted; do
      [ "$want" = "$profile" ] && found=yes
    done
    if [ "$found" = yes ]; then
      add_profile "$profile"
    elif profile_installed "$profile"; then
      remove_profile "$profile"
    fi
  done

  if [ -z "$wanted" ]; then
    echo "$SCRIPT_NAME apply: AGENT_REQUIRED_HOOKS is empty; no hooks to install" >&2
  fi
}

cmd_list() {
  local name dst subdir entry key target state any=no
  for dst in "$HOOKS_DIR"/*; do
    [ -e "$dst" ] || continue
    case "$dst" in *.d | *.sample) continue ;; esac
    name=$(basename "$dst")
    subdir="$dst.d"
    any=yes
    if is_managed_multiplexer "$dst"; then
      echo "$name"
      [ -d "$subdir" ] || continue
      for entry in "$subdir"/*; do
        [ -e "$entry" ] || continue
        key=$(basename "$entry")
        target=$(trampoline_target "$entry")
        if [ "$key" = "$LEGACY_KEY" ]; then
          state="preserved"
        elif [ -n "$target" ]; then
          state="managed -> $target"
        else
          state="copy"
        fi
        printf '  %-12s %s\n' "$key" "$state"
      done
    else
      printf '%s\n  %-12s %s\n' "$name" "-" "unmanaged (not installed by $SCRIPT_NAME)"
    fi
  done
  [ "$any" = yes ] || echo "$SCRIPT_NAME list: no hooks installed in $(git rev-parse --show-toplevel)" >&2
}

cmd_catalog() {
  local profile pair names
  for profile in $PROFILES; do
    names=""
    for pair in $(profile_pairs "$profile"); do
      names="$names ${pair%%:*}"
    done
    printf '%-8s %-12s %s\n' "$profile" "${names# }" "$(profile_summary "$profile")"
  done
}

report() { # report TAG MESSAGE
  printf '%-7s %s\n' "[$1]" "$2"
}

cmd_doctor() {
  local rc=0 profile pair name key state
  for profile in $(required_profiles); do
    if ! is_profile "$profile"; then
      report ERROR "$profile: not a known profile (try '$SCRIPT_NAME catalog')"
      rc=1
      continue
    fi
    for pair in $(profile_pairs "$profile"); do
      name="${pair%%:*}"
      key="${pair#*:}"
      state=$(subhook_state "$name" "$key")
      case "$state" in
        ok)
          report OK "$profile: $name installed and current"
          ;;
        unmanaged_multiplexer)
          report WARN "$profile: $name exists but was not installed by $SCRIPT_NAME"
          printf '        run '\''%s add %s'\'' to take it over (the existing hook is preserved)\n' "$SCRIPT_NAME" "$profile"
          rc=1
          ;;
        drifted_multiplexer | drifted_subhook)
          report WARN "$profile: $name was installed by an older version"
          printf '        run '\''%s add %s'\'' to refresh it\n' "$SCRIPT_NAME" "$profile"
          rc=1
          ;;
        orphaned_subhook)
          report ERROR "$profile: $name points at a source that no longer exists"
          printf '        run '\''%s add %s'\'' to repoint it, or '\''%s remove %s'\''\n' "$SCRIPT_NAME" "$profile" "$SCRIPT_NAME" "$profile"
          rc=1
          ;;
        *)
          report WARN "$profile: $name is not installed"
          printf '        run '\''%s add %s'\''\n' "$SCRIPT_NAME" "$profile"
          rc=1
          ;;
      esac
    done
  done
  return "$rc"
}

cmd_clean() {
  local profile
  if [ "$all_mode" = yes ]; then
    if [ "$force_mode" != yes ]; then
      echo "$SCRIPT_NAME clean: --all deletes every hook in $HOOKS_DIR, including hooks this tool did not install:" >&2
      cmd_list >&2 || true
      echo "$SCRIPT_NAME clean: re-run with --force to confirm" >&2
      exit 1
    fi
    rm -rf "$HOOKS_DIR"
    echo "$SCRIPT_NAME clean: removed $HOOKS_DIR" >&2
    return 0
  fi

  for profile in $PROFILES; do
    if profile_installed "$profile"; then
      remove_profile "$profile"
    fi
  done
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

if [ "$#" -eq 0 ]; then
  usage
fi

cmd="$1"
shift

case "$cmd" in
  help | --help | -h) usage ;;
esac

copy_mode=no
all_mode=no
force_mode=no
args=()
for arg in "$@"; do
  case "$arg" in
    --help | -h) usage ;;
    --copy) copy_mode=yes ;;
    --all) all_mode=yes ;;
    --force) force_mode=yes ;;
    -*)
      echo "$SCRIPT_NAME $cmd: unknown option: $arg" >&2
      echo "Try '$SCRIPT_NAME --help' for more information." >&2
      exit 1
      ;;
    *) args+=("$arg") ;;
  esac
done

require git

# --git-path resolves core.hooksPath and linked worktrees (where hooks live in
# the common git dir, not the per-worktree one).
HOOKS_DIR=$(git rev-parse --git-path hooks 2>/dev/null) || {
  echo "$SCRIPT_NAME $cmd: not a git repository" >&2
  exit 1
}

case "$cmd" in
  apply) cmd_apply ;;
  add)
    [ "${#args[@]}" -gt 0 ] || die "profile required (try '$SCRIPT_NAME catalog')"
    for profile in "${args[@]}"; do add_profile "$profile"; done
    ;;
  remove | rm)
    [ "${#args[@]}" -gt 0 ] || die "profile required (try '$SCRIPT_NAME list')"
    for profile in "${args[@]}"; do remove_profile "$profile"; done
    ;;
  list | ls) cmd_list ;;
  catalog) cmd_catalog ;;
  doctor) cmd_doctor ;;
  clean) cmd_clean ;;
  *)
    echo "$SCRIPT_NAME: unknown command: $cmd" >&2
    echo "Try '$SCRIPT_NAME --help' for more information." >&2
    exit 1
    ;;
esac
