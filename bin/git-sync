#!/usr/bin/env bash

# Ensure exactly one argument is provided
if [ "$#" -ne 1 ]; then
    echo "Usage: git sync <destination_directory>"
    exit 1
fi

DEST_DIR="$1"

# Check if we are inside a Git repository and get the absolute path to the root
if ! REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "Error: Not a git repository (or any of the parent directories)."
    exit 1
fi

# Create the destination directory if it does not already exist
mkdir -p "$DEST_DIR"

echo "Syncing repository: $REPO_ROOT"
echo "Destination: $DEST_DIR"

# Run rsync. 
# Note the trailing slashes on the source and destination variables; 
# these are critical in rsync to ensure we sync directory contents, not the directory itself.
rsync -av --delete \
      --filter=':- .gitignore' \
      --exclude='.git/' \
      "$REPO_ROOT/" "$DEST_DIR/"

echo "Sync complete."