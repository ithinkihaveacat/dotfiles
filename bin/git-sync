#!/usr/bin/env bash

# Tests: tests/test-git-sync

set -euo pipefail

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo >&2 "$(basename "$0"): $1 not found"
    exit 127
  }
}

require git
require rsync

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] DESTINATION_DIRECTORY

Mirror the current Git repository working tree to a destination directory.

Synchronizes files using rsync, respecting .gitignore rules and excluding Git
metadata (.git/) while preserving file attributes and pruning deleted files.

Arguments:
  DESTINATION_DIRECTORY  Target directory to synchronize repository contents to.

Options:
  -n, --dry-run          Perform a trial run with no changes made
  --help, -h             Display this help message and exit

Examples:
  # Sync repository to a destination directory
  $(basename "$0") /tmp/project-mirror

  # Preview files that would be synchronized without making changes
  $(basename "$0") --dry-run /tmp/project-mirror
EOF
  exit 0
}

usage_short() {
  cat <<EOF >&2
Usage: $(basename "$0") [OPTIONS] DESTINATION_DIRECTORY

Mirror the current Git repository working tree to a destination directory.

Examples:
  $(basename "$0") /tmp/project-mirror

Try '$(basename "$0") --help' for more information.
EOF
  exit 1
}

DRY_RUN=false
DEST_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help | -h)
      usage
      ;;
    -n | --dry-run)
      DRY_RUN=true
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "$(basename "$0"): unrecognized option '$1'" >&2
      echo "Try '$(basename "$0") --help' for more information." >&2
      exit 1
      ;;
    *)
      if [[ -n "$DEST_DIR" ]]; then
        echo "$(basename "$0"): extra operand '$1'" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
      fi
      DEST_DIR="$1"
      shift
      ;;
  esac
done

if [[ -z "$DEST_DIR" && $# -gt 0 ]]; then
  DEST_DIR="$1"
  shift
  if [[ $# -gt 0 ]]; then
    echo "$(basename "$0"): extra operand '$1'" >&2
    echo "Try '$(basename "$0") --help' for more information." >&2
    exit 1
  fi
fi

if [[ -z "$DEST_DIR" ]]; then
  usage_short
fi

if ! REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "$(basename "$0"): not a git repository (or any of the parent directories)" >&2
  exit 1
fi

resolve_abs_path() {
  local target="$1"
  if [[ -d "$target" ]]; then
    (cd "$target" && pwd -P)
  else
    local parent
    parent=$(dirname "$target")
    if [[ -d "$parent" ]]; then
      echo "$(cd "$parent" && pwd -P)/$(basename "$target")"
    else
      if [[ "$target" == /* ]]; then
        echo "$target"
      else
        echo "$PWD/$target"
      fi
    fi
  fi
}

DEST_ABS=$(resolve_abs_path "$DEST_DIR")
REPO_ABS=$(cd "$REPO_ROOT" && pwd -P)

if [[ "$DEST_ABS" == "$REPO_ABS" ]]; then
  echo "$(basename "$0"): destination cannot be the source repository: $DEST_DIR" >&2
  exit 1
fi

if [[ "$DEST_ABS" == "$REPO_ABS"/* ]]; then
  echo "$(basename "$0"): destination cannot be inside the source repository: $DEST_DIR" >&2
  exit 1
fi

if [[ "$DRY_RUN" == "false" ]]; then
  mkdir -p "$DEST_DIR"
fi

RSYNC_ARGS=(-av --delete --filter=':- .gitignore' --exclude='.git/')
if [[ "$DRY_RUN" == "true" ]]; then
  RSYNC_ARGS+=(-n)
fi

rsync "${RSYNC_ARGS[@]}" "$REPO_ROOT/" "$DEST_DIR/"
