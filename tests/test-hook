#!/usr/bin/env bash

# Tests: tests/test-hook

# The hook bodies written by write_src below are single-quoted on purpose:
# "$LOG" is expanded by the generated hook when git runs it, not here.
# shellcheck disable=SC2016

set -u

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REAL_BIN="$DIR/../bin/hook"

# Isolate from the user's/system git config (signing, hooks, templates).
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

echo "1..39"

# Test 1: --help exits zero and documents every command
if out=$("$REAL_BIN" --help 2>&1) &&
  printf '%s' "$out" | grep -q 'apply' &&
  printf '%s' "$out" | grep -q 'add' &&
  printf '%s' "$out" | grep -q 'remove' &&
  printf '%s' "$out" | grep -q 'list' &&
  printf '%s' "$out" | grep -q 'catalog' &&
  printf '%s' "$out" | grep -q 'doctor' &&
  printf '%s' "$out" | grep -q 'clean'; then
  echo "ok 1 - --help documents every command"
else
  echo "not ok 1 - --help missing or incomplete"
fi

# Test 2: bare invocation is an explicit help request (exit 0)
if "$REAL_BIN" >/dev/null 2>&1; then
  echo "ok 2 - bare invocation prints help and exits zero"
else
  echo "not ok 2 - bare invocation should exit zero"
fi

WORK=$(mktemp -d "/tmp/hook-test.XXXXXX")
trap 'rm -rf "$WORK"' EXIT

# A stub 'prettier' on PATH, so 'add node'/'apply' pass their dependency
# check on a machine with no real prettier install: these tests exercise the
# multiplexer/doctor/copy plumbing around the node profile, via a fake
# pre-commit source below, not prettier itself. 'npx' is stubbed to fail too,
# so the check falls through to this 'prettier' the same way it would on a
# machine with npx installed but no prettier resolvable through it, instead
# of depending on whatever a real npx happens to find on the host running
# this suite.
PRETTIER_STUB="$WORK/prettier-stub"
mkdir -p "$PRETTIER_STUB"
printf '%s\n' '#!/bin/sh' 'echo 3.0.0-stub' >"$PRETTIER_STUB/prettier"
chmod +x "$PRETTIER_STUB/prettier"
printf '%s\n' '#!/bin/sh' 'exit 1' >"$PRETTIER_STUB/npx"
chmod +x "$PRETTIER_STUB/npx"
PATH="$PRETTIER_STUB:$PATH"
export PATH

# A stand-in dotfiles tree, so the mechanics below can edit and delete hook
# sources without touching the ones this repository actually ships. 'hook'
# resolves its sources relative to its own location, so a copy of the script
# in this tree serves sources from this tree.
DF="$WORK/df"
mkdir -p "$DF/bin" "$DF/etc/git/hooks/agent" "$DF/etc/git/hooks/node"
cp "$REAL_BIN" "$DF/bin/hook"
BIN="$DF/bin/hook"
AGENT_SRC="$DF/etc/git/hooks/agent/commit-msg"
NODE_SRC="$DF/etc/git/hooks/node/pre-commit"

write_src() { # write_src PATH BODY...
  local path="$1"
  shift
  printf '%s\n' '#!/bin/sh' "$@" >"$path"
  chmod +x "$path"
}

write_src "$AGENT_SRC" 'echo agent >> "$LOG"'
write_src "$NODE_SRC" 'echo node >> "$LOG"'

new_repo() { # new_repo NAME -> prints repo path
  local repo="$WORK/$1"
  mkdir -p "$repo"
  git -C "$repo" init -q
  printf '%s\n' "$repo"
}

REPO=$(new_repo main)
export LOG="$REPO/log.txt"

# Test 3: doctor is non-zero before anything is installed
if ! (cd "$REPO" && "$BIN" doctor) >/dev/null 2>&1; then
  echo "ok 3 - doctor flags an unconfigured repository"
else
  echo "not ok 3 - doctor should exit non-zero with no hooks installed"
fi

# Test 4: add writes a managed multiplexer and executable sub-hook
if (cd "$REPO" && "$BIN" add agent) >/dev/null 2>&1 &&
  [ -x "$REPO/.git/hooks/commit-msg" ] &&
  grep -q 'hook-multiplexer' "$REPO/.git/hooks/commit-msg" &&
  [ -x "$REPO/.git/hooks/commit-msg.d/10-agent" ] &&
  (cd "$REPO" && "$BIN" doctor) >/dev/null 2>&1 &&
  (cd "$REPO" && "$BIN" list) 2>/dev/null | grep -q '10-agent'; then
  echo "ok 4 - add writes a multiplexed hook that doctor and list both see"
else
  echo "not ok 4 - add did not produce the expected layout"
fi

# Test 5: the sub-hook is a trampoline naming its source, not a copy of it
if grep -Fq "hook-trampoline -> $AGENT_SRC" "$REPO/.git/hooks/commit-msg.d/10-agent" &&
  ! grep -q 'echo agent' "$REPO/.git/hooks/commit-msg.d/10-agent"; then
  echo "ok 5 - the installed sub-hook is a trampoline to its source"
else
  echo "not ok 5 - the sub-hook is a copy rather than a trampoline"
fi

# Test 6: editing the source changes an already-installed hook with no
# re-install step. This is the whole point of the trampoline.
rm -f "$LOG"
write_src "$AGENT_SRC" 'echo v1 >> "$LOG"'
"$REPO/.git/hooks/commit-msg" msgfile </dev/null
write_src "$AGENT_SRC" 'echo v2 >> "$LOG"'
"$REPO/.git/hooks/commit-msg" msgfile </dev/null
if [ "$(cat "$LOG")" = "v1
v2" ]; then
  echo "ok 6 - editing the source propagates with no re-install"
else
  echo "not ok 6 - the installed hook did not follow its source"
fi

# Test 7: a pre-existing foreign hook is preserved as 00-legacy and runs first
LEGACY_REPO=$(new_repo legacy)
printf '#!/bin/sh\necho legacy >> "%s/log.txt"\n' "$LEGACY_REPO" >"$LEGACY_REPO/.git/hooks/commit-msg"
chmod +x "$LEGACY_REPO/.git/hooks/commit-msg"
write_src "$AGENT_SRC" 'echo agent >> "$LOG"'
(cd "$LEGACY_REPO" && LOG="$LEGACY_REPO/log.txt" "$BIN" add agent) >/dev/null 2>&1
LOG="$LEGACY_REPO/log.txt" "$LEGACY_REPO/.git/hooks/commit-msg" msgfile </dev/null
if [ -x "$LEGACY_REPO/.git/hooks/commit-msg.d/00-legacy" ] &&
  [ "$(cat "$LEGACY_REPO/log.txt")" = "legacy
agent" ]; then
  echo "ok 7 - foreign hook preserved as 00-legacy and runs first"
else
  echo "not ok 7 - legacy hook not preserved or wrong order"
fi

# Test 8: a failing sub-hook aborts the chain with its exit code
printf '#!/bin/sh\nexit 42\n' >"$LEGACY_REPO/.git/hooks/commit-msg.d/05-fail"
chmod +x "$LEGACY_REPO/.git/hooks/commit-msg.d/05-fail"
rm -f "$LEGACY_REPO/log.txt"
LOG="$LEGACY_REPO/log.txt" "$LEGACY_REPO/.git/hooks/commit-msg" msgfile </dev/null 2>/dev/null
rc=$?
if [ "$rc" -eq 42 ] && grep -q 'legacy' "$LEGACY_REPO/log.txt" &&
  ! grep -q 'agent' "$LEGACY_REPO/log.txt"; then
  echo "ok 8 - failing sub-hook propagates exit code and stops the chain"
else
  echo "not ok 8 - expected exit 42 and no later hooks (got rc=$rc)"
fi
rm -f "$LEGACY_REPO/.git/hooks/commit-msg.d/05-fail"

# Test 9: re-adding is idempotent (a managed hook is not demoted to legacy)
(cd "$REPO" && "$BIN" add agent) >/dev/null 2>&1
if [ ! -e "$REPO/.git/hooks/commit-msg.d/00-legacy" ] &&
  (cd "$REPO" && "$BIN" doctor) >/dev/null 2>&1; then
  echo "ok 9 - re-adding is idempotent"
else
  echo "not ok 9 - re-adding created 00-legacy or broke doctor"
fi

# Test 10: every sub-hook sees the full stdin (buffered, not consumed)
printf '#!/bin/sh\ncat >> "%s/stdin.txt"\n' "$REPO" >"$REPO/.git/hooks/commit-msg.d/20-b"
chmod +x "$REPO/.git/hooks/commit-msg.d/20-b"
write_src "$AGENT_SRC" 'cat >> "$LOG"'
rm -f "$LOG" "$REPO/stdin.txt"
printf 'refs\n' | "$REPO/.git/hooks/commit-msg" msgfile
if grep -q 'refs' "$LOG" && grep -q 'refs' "$REPO/stdin.txt"; then
  echo "ok 10 - stdin is buffered and replayed to every sub-hook"
else
  echo "not ok 10 - sub-hooks did not each receive stdin"
fi

# Test 11: doctor reports a hook it did not install, and says how to adopt it
UNMANAGED_REPO=$(new_repo unmanaged)
printf '#!/bin/sh\n' >"$UNMANAGED_REPO/.git/hooks/commit-msg"
out=$(cd "$UNMANAGED_REPO" && "$BIN" doctor 2>&1)
if [ -n "$out" ] && printf '%s' "$out" | grep -q '^\[WARN\]' &&
  printf '%s' "$out" | grep -q 'not installed by hook' &&
  ! (cd "$UNMANAGED_REPO" && "$BIN" doctor) >/dev/null 2>&1; then
  echo "ok 11 - doctor reports an unmanaged hook with a canonical WARN tag"
else
  echo "not ok 11 - unexpected doctor output for an unmanaged hook"
fi

# Test 12: an install from an older version of this tool (the plural
# git-hooks-multiplexer marker, and a copied rather than trampolined
# sub-hook) is reported as drift rather than ok, and re-adding refreshes it
# in place instead of demoting the still-working multiplexer to 00-legacy.
OLD_REPO=$(new_repo old)
mkdir -p "$OLD_REPO/.git/hooks/commit-msg.d"
printf '#!/bin/sh\n# git-hooks-multiplexer: commit-msg\n' >"$OLD_REPO/.git/hooks/commit-msg"
chmod +x "$OLD_REPO/.git/hooks/commit-msg"
printf '#!/bin/sh\n' >"$OLD_REPO/.git/hooks/commit-msg.d/10-agent"
chmod +x "$OLD_REPO/.git/hooks/commit-msg.d/10-agent"
out=$(cd "$OLD_REPO" && "$BIN" doctor 2>&1)
if printf '%s' "$out" | grep -q 'older version' &&
  (cd "$OLD_REPO" && "$BIN" add agent) >/dev/null 2>&1 &&
  [ ! -e "$OLD_REPO/.git/hooks/commit-msg.d/00-legacy" ] &&
  (cd "$OLD_REPO" && "$BIN" doctor) >/dev/null 2>&1; then
  echo "ok 12 - a pre-rename install reports drift and is refreshed in place"
else
  echo "not ok 12 - unexpected handling of a pre-rename install"
fi

# Test 13: a source that has gone away is a doctor finding and makes the hook
# fail loudly, rather than being silently skipped
ORPHAN_REPO=$(new_repo orphan)
write_src "$NODE_SRC" 'exit 0'
(cd "$ORPHAN_REPO" && "$BIN" add node) >/dev/null 2>&1
rm -f "$NODE_SRC"
rc=0
"$ORPHAN_REPO/.git/hooks/pre-commit" </dev/null >/dev/null 2>&1 || rc=$?
out=$(cd "$ORPHAN_REPO" && AGENT_REQUIRED_HOOKS=node "$BIN" doctor 2>&1)
if printf '%s' "$out" | grep -q '^\[ERROR\]' &&
  printf '%s' "$out" | grep -q 'no longer exists' && [ "$rc" -ne 0 ]; then
  echo "ok 13 - a missing source is reported and fails the hook loudly"
else
  echo "not ok 13 - a missing source was not caught (rc=$rc)"
fi
write_src "$NODE_SRC" 'echo node >> "$LOG"'

# Test 14: --copy installs a snapshot that does not track its source
COPY_REPO=$(new_repo copy)
write_src "$NODE_SRC" 'echo copied >> "$LOG"'
(cd "$COPY_REPO" && "$BIN" add --copy node) >/dev/null 2>&1
rm -f "$NODE_SRC"
LOG="$COPY_REPO/log.txt" "$COPY_REPO/.git/hooks/pre-commit" </dev/null
if (cd "$COPY_REPO" && AGENT_REQUIRED_HOOKS=node "$BIN" doctor) >/dev/null 2>&1 &&
  grep -q 'copied' "$COPY_REPO/log.txt"; then
  echo "ok 14 - --copy installs a snapshot that survives its source"
else
  echo "not ok 14 - --copy did not install a self-contained hook"
fi
write_src "$NODE_SRC" 'echo node >> "$LOG"'

# Test 15: removing one sub-hook leaves the others in place
if (cd "$REPO" && "$BIN" remove agent) >/dev/null 2>&1 &&
  [ ! -e "$REPO/.git/hooks/commit-msg.d/10-agent" ] &&
  [ -x "$REPO/.git/hooks/commit-msg.d/20-b" ] &&
  [ -x "$REPO/.git/hooks/commit-msg" ]; then
  echo "ok 15 - remove drops one sub-hook and leaves the rest"
else
  echo "not ok 15 - remove disturbed the other sub-hooks"
fi

# Test 16: removing the last managed sub-hook restores 00-legacy as the plain
# hook and takes the multiplexer down with it
rm -f "$LEGACY_REPO/log.txt"
if (cd "$LEGACY_REPO" && "$BIN" remove agent) >/dev/null 2>&1 &&
  [ ! -d "$LEGACY_REPO/.git/hooks/commit-msg.d" ] &&
  [ -x "$LEGACY_REPO/.git/hooks/commit-msg" ] &&
  ! grep -q 'hook-multiplexer' "$LEGACY_REPO/.git/hooks/commit-msg"; then
  LOG="$LEGACY_REPO/log.txt" "$LEGACY_REPO/.git/hooks/commit-msg" msgfile </dev/null
  if [ "$(cat "$LEGACY_REPO/log.txt")" = "legacy" ]; then
    echo "ok 16 - the pre-existing hook is restored when the last one goes"
  else
    echo "not ok 16 - the restored hook does not run"
  fi
else
  echo "not ok 16 - 00-legacy was not restored as the plain hook"
fi

# Test 17: removing the last sub-hook where there was no pre-existing hook
# removes the multiplexer and its directory entirely
rm -f "$REPO/.git/hooks/commit-msg.d/20-b"
EMPTY_REPO=$(new_repo empty)
(cd "$EMPTY_REPO" && "$BIN" add agent) >/dev/null 2>&1
if (cd "$EMPTY_REPO" && "$BIN" remove agent) >/dev/null 2>&1 &&
  [ ! -e "$EMPTY_REPO/.git/hooks/commit-msg" ] &&
  [ ! -d "$EMPTY_REPO/.git/hooks/commit-msg.d" ]; then
  echo "ok 17 - an emptied multiplexer removes itself"
else
  echo "not ok 17 - the multiplexer outlived its last sub-hook"
fi

# Test 18: a foreign hook that merely mentions this tool in its text is still
# recognized as foreign, preserved as 00-legacy, and not silently overwritten
MENTION_REPO=$(new_repo mention)
printf '#!/bin/sh\n# installed by hand; see hook-multiplexer for the managed variant\necho mention >> "%s/log.txt"\n' "$MENTION_REPO" >"$MENTION_REPO/.git/hooks/commit-msg"
chmod +x "$MENTION_REPO/.git/hooks/commit-msg"
(cd "$MENTION_REPO" && "$BIN" add agent) >/dev/null 2>&1
rm -f "$MENTION_REPO/log.txt"
LOG="$MENTION_REPO/log.txt" "$MENTION_REPO/.git/hooks/commit-msg" msgfile </dev/null
if [ -x "$MENTION_REPO/.git/hooks/commit-msg.d/00-legacy" ] &&
  grep -q 'mention' "$MENTION_REPO/log.txt"; then
  echo "ok 18 - a foreign hook naming this tool is preserved, not clobbered"
else
  echo "not ok 18 - a foreign hook naming this tool was overwritten"
fi

# Test 19: apply synchronizes to AGENT_REQUIRED_HOOKS, installing what it
# names and removing the managed profiles it does not
SYNC_REPO=$(new_repo sync)
(cd "$SYNC_REPO" && AGENT_REQUIRED_HOOKS='agent node' "$BIN" apply) >/dev/null 2>&1
before=0
[ -e "$SYNC_REPO/.git/hooks/commit-msg.d/10-agent" ] &&
  [ -e "$SYNC_REPO/.git/hooks/pre-commit.d/10-node" ] && before=1
(cd "$SYNC_REPO" && AGENT_REQUIRED_HOOKS='node' "$BIN" apply) >/dev/null 2>&1
if [ "$before" -eq 1 ] &&
  [ ! -e "$SYNC_REPO/.git/hooks/commit-msg" ] &&
  [ -e "$SYNC_REPO/.git/hooks/pre-commit.d/10-node" ]; then
  echo "ok 19 - apply installs what is declared and removes what is not"
else
  echo "not ok 19 - apply did not synchronize to AGENT_REQUIRED_HOOKS"
fi

# Test 20: catalog lists the profiles available to add
if out=$(cd "$REPO" && "$BIN" catalog 2>&1) &&
  printf '%s' "$out" | grep -q '^agent' &&
  printf '%s' "$out" | grep -q '^node' &&
  printf '%s' "$out" | grep -q '^gerrit'; then
  echo "ok 20 - catalog lists every profile"
else
  echo "not ok 20 - catalog is missing profiles"
fi

# Test 21: clean removes the profiles this tool manages and leaves a hook it
# did not install alone
CLEAN_REPO=$(new_repo clean)
(cd "$CLEAN_REPO" && AGENT_REQUIRED_HOOKS='agent node' "$BIN" apply) >/dev/null 2>&1
printf '#!/bin/sh\nexit 0\n' >"$CLEAN_REPO/.git/hooks/pre-push"
chmod +x "$CLEAN_REPO/.git/hooks/pre-push"
if (cd "$CLEAN_REPO" && "$BIN" clean) >/dev/null 2>&1 &&
  [ ! -e "$CLEAN_REPO/.git/hooks/commit-msg" ] &&
  [ ! -e "$CLEAN_REPO/.git/hooks/pre-commit" ] &&
  [ -x "$CLEAN_REPO/.git/hooks/pre-push" ]; then
  echo "ok 21 - clean removes managed profiles and spares foreign hooks"
else
  echo "not ok 21 - clean removed too much or too little"
fi

# Test 22: clean --all refuses without --force, then deletes everything
if ! (cd "$CLEAN_REPO" && "$BIN" clean --all) >/dev/null 2>&1 &&
  [ -x "$CLEAN_REPO/.git/hooks/pre-push" ] &&
  (cd "$CLEAN_REPO" && "$BIN" clean --all --force) >/dev/null 2>&1 &&
  [ ! -d "$CLEAN_REPO/.git/hooks" ]; then
  echo "ok 22 - clean --all requires --force before deleting foreign hooks"
else
  echo "not ok 22 - clean --all did not honour the --force guard"
fi

# Test 23: a fetched profile is downloaded into a scratch directory that
# outlives the fetch, and installed as a copy rather than a trampoline. curl
# is stubbed so this needs no network; HOOK_OFFLINE=0 opts back in when the
# suite is run under AGENT_OFFLINE=1, which also pins that the per-tool
# variable wins over the workspace-wide one.
FETCH_REPO=$(new_repo fetch)
STUB="$WORK/stub"
mkdir -p "$STUB"
cat >"$STUB/curl" <<'STUBEOF'
#!/bin/sh
out=""
while [ $# -gt 0 ]; do
  case $1 in
    -o | -sSLo) out=$2; shift 2 ;;
    *) shift ;;
  esac
done
[ -n "$out" ] || exit 1
printf '#!/bin/sh\necho gerrit-stub\n' > "$out"
STUBEOF
chmod +x "$STUB/curl"
if (cd "$FETCH_REPO" && PATH="$STUB:$PATH" HOOK_OFFLINE=0 "$BIN" add gerrit) >/dev/null 2>&1 &&
  [ -x "$FETCH_REPO/.git/hooks/commit-msg.d/50-gerrit" ] &&
  grep -q 'gerrit-stub' "$FETCH_REPO/.git/hooks/commit-msg.d/50-gerrit" &&
  ! grep -q 'hook-trampoline' "$FETCH_REPO/.git/hooks/commit-msg.d/50-gerrit"; then
  echo "ok 23 - a fetched profile is installed as a copy of the download"
else
  echo "not ok 23 - the fetched hook did not survive into the installed copy"
fi

# Test 24: offline mode refuses to fetch rather than hanging or half-installing
OFFLINE_REPO=$(new_repo offline)
out=$(cd "$OFFLINE_REPO" && HOOK_OFFLINE=1 "$BIN" add gerrit 2>&1)
rc=$?
if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -q 'offline mode' &&
  [ ! -e "$OFFLINE_REPO/.git/hooks/commit-msg" ]; then
  echo "ok 24 - offline mode refuses to fetch and installs nothing"
else
  echo "not ok 24 - offline mode did not fail cleanly (rc=$rc)"
fi

# Test 25: doctor reports an installed profile absent from AGENT_REQUIRED_HOOKS
UNWANTED_REPO=$(new_repo unwanted)
(cd "$UNWANTED_REPO" && AGENT_REQUIRED_HOOKS='agent node' "$BIN" apply) >/dev/null 2>&1
out=$(cd "$UNWANTED_REPO" && AGENT_REQUIRED_HOOKS='agent' "$BIN" doctor 2>&1)
rc=$?
if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -q 'installed but not in AGENT_REQUIRED_HOOKS'; then
  echo "ok 25 - doctor diagnoses profiles outside AGENT_REQUIRED_HOOKS"
else
  echo "not ok 25 - doctor did not flag unrequired profile (rc=$rc)"
fi

# Test 26: trampoline targets with special characters are shell-quoted safely
PATH_REPO="$WORK/repo with spaces & \$dollar"
mkdir -p "$PATH_REPO"
git -C "$PATH_REPO" init -q
(cd "$PATH_REPO" && "$BIN" add agent) >/dev/null 2>&1
if grep -q "exec '" "$PATH_REPO/.git/hooks/commit-msg.d/10-agent" &&
  (cd "$PATH_REPO" && "$BIN" doctor) >/dev/null 2>&1; then
  echo "ok 26 - trampoline target is safely shell-quoted"
else
  echo "not ok 26 - trampoline target quoting failed"
fi

# Test 27: zero-argument commands reject positional arguments
ZERO_REPO=$(new_repo zeroarg)
rc=0
out=$(cd "$ZERO_REPO" && "$BIN" clean node 2>&1) || rc=$?
if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -q 'takes no positional arguments'; then
  echo "ok 27 - zero-argument command rejects positional arguments"
else
  echo "not ok 27 - zero-argument command accepted positional arguments (rc=$rc)"
fi

# Test 28: opaque subhook without copy or trampoline marker is reported as drift
OPAQUE_REPO=$(new_repo opaque)
(cd "$OPAQUE_REPO" && "$BIN" add agent) >/dev/null 2>&1
printf '#!/bin/sh\necho custom\n' >"$OPAQUE_REPO/.git/hooks/commit-msg.d/10-agent"
out=$(cd "$OPAQUE_REPO" && "$BIN" doctor 2>&1)
rc=$?
if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -q 'installed by an older version'; then
  echo "ok 28 - opaque subhook is reported as drift by doctor"
else
  echo "not ok 28 - opaque subhook was accepted as current (rc=$rc)"
fi

# Test 29: a foreign pre-commit hook containing 'prettier' is preserved as 00-legacy
FOREIGN_PRETTIER_REPO=$(new_repo foreignprettier)
cat >"$FOREIGN_PRETTIER_REPO/.git/hooks/pre-commit" <<'EOF'
#!/bin/bash
npx prettier --check .
EOF
chmod +x "$FOREIGN_PRETTIER_REPO/.git/hooks/pre-commit"
if (cd "$FOREIGN_PRETTIER_REPO" && "$BIN" add node) >/dev/null 2>&1 &&
  [ -x "$FOREIGN_PRETTIER_REPO/.git/hooks/pre-commit.d/00-legacy" ] &&
  [ -x "$FOREIGN_PRETTIER_REPO/.git/hooks/pre-commit.d/10-node" ]; then
  echo "ok 29 - foreign hook with prettier is preserved as 00-legacy on install"
else
  echo "not ok 29 - foreign hook with prettier was overwritten or deleted"
fi

# Test 30: removing sub-hook verifies multiplexer and sub-hook ownership before deletion
FOREIGN_MULTIPLEXER_REPO=$(new_repo foreignmult)
mkdir -p "$FOREIGN_MULTIPLEXER_REPO/.git/hooks/commit-msg.d"
echo "#!/bin/sh" >"$FOREIGN_MULTIPLEXER_REPO/.git/hooks/commit-msg"
echo "#!/bin/sh" >"$FOREIGN_MULTIPLEXER_REPO/.git/hooks/commit-msg.d/10-agent"
chmod +x "$FOREIGN_MULTIPLEXER_REPO/.git/hooks/commit-msg" "$FOREIGN_MULTIPLEXER_REPO/.git/hooks/commit-msg.d/10-agent"
if (cd "$FOREIGN_MULTIPLEXER_REPO" && "$BIN" remove agent) >/dev/null 2>&1 &&
  [ -e "$FOREIGN_MULTIPLEXER_REPO/.git/hooks/commit-msg.d/10-agent" ]; then
  echo "ok 30 - remove verifies multiplexer ownership before deleting sub-hook"
else
  echo "not ok 30 - remove deleted sub-hook under foreign multiplexer"
fi

# Test 31: HOOK_OFFLINE=false overrides AGENT_OFFLINE=1
OFFLINE_REPO=$(new_repo offline_test)
out=$(cd "$OFFLINE_REPO" && HOOK_OFFLINE=false AGENT_OFFLINE=1 "$BIN" add gerrit 2>&1) || true
if printf '%s' "$out" | grep -q 'offline mode'; then
  echo "not ok 31 - HOOK_OFFLINE=false did not override AGENT_OFFLINE=1"
else
  echo "ok 31 - HOOK_OFFLINE=false correctly overrides AGENT_OFFLINE=1"
fi

# Test 32: 'add node' refuses when npx exists but no prettier is actually
# runnable through it or on PATH -- mirrors the exact probe the installed
# pre-commit hook uses at commit time, rather than just checking npx exists.
NPX_ONLY_STUB="$WORK/npx-only"
mkdir -p "$NPX_ONLY_STUB"
printf '%s\n' '#!/bin/sh' 'exit 1' >"$NPX_ONLY_STUB/npx"
chmod +x "$NPX_ONLY_STUB/npx"
GIT_DIR_ON_PATH=$(dirname "$(command -v git)")
NPX_ONLY_REPO=$(new_repo npxonly)
if ! (cd "$NPX_ONLY_REPO" && PATH="$NPX_ONLY_STUB:$GIT_DIR_ON_PATH:/usr/bin:/bin" "$BIN" add node) >/dev/null 2>&1; then
  echo "ok 32 - add node refuses when npx exists but no prettier is runnable"
else
  echo "not ok 32 - add node accepted an npx with no runnable prettier"
fi

# Test 33: remove drops an owned sub-hook even if its multiplexer was since
# deleted or replaced by hand -- ownership of the sub-hook is checked on its
# own content, not gated on the multiplexer above it, so cleanup converges.
ORPHANED_MULTIPLEXER_REPO=$(new_repo orphanedmult)
(cd "$ORPHANED_MULTIPLEXER_REPO" && "$BIN" add agent) >/dev/null 2>&1
printf '#!/bin/sh\necho replaced\n' >"$ORPHANED_MULTIPLEXER_REPO/.git/hooks/commit-msg"
chmod +x "$ORPHANED_MULTIPLEXER_REPO/.git/hooks/commit-msg"
if (cd "$ORPHANED_MULTIPLEXER_REPO" && "$BIN" remove agent) >/dev/null 2>&1 &&
  [ ! -e "$ORPHANED_MULTIPLEXER_REPO/.git/hooks/commit-msg.d/10-agent" ] &&
  grep -q replaced "$ORPHANED_MULTIPLEXER_REPO/.git/hooks/commit-msg"; then
  echo "ok 33 - remove drops an owned sub-hook even under a replaced multiplexer"
else
  echo "not ok 33 - remove left an owned sub-hook behind under a replaced multiplexer"
fi

# Test 34: 'apply' does not re-fetch an already-current gerrit profile, so
# running it from the post-checkout hook on every checkout doesn't hit the
# network (and doesn't fail offline) once the profile is installed.
REFETCH_REPO=$(new_repo refetch)
REFETCH_STUB="$WORK/refetch-stub"
mkdir -p "$REFETCH_STUB"
COUNT_FILE="$WORK/curl-count"
: >"$COUNT_FILE"
cat >"$REFETCH_STUB/curl" <<STUBEOF
#!/bin/sh
echo x >> "$COUNT_FILE"
out=""
while [ \$# -gt 0 ]; do
  case \$1 in
    -o | -sSLo) out=\$2; shift 2 ;;
    *) shift ;;
  esac
done
[ -n "\$out" ] || exit 1
printf '#!/bin/sh\necho gerrit-stub\n' > "\$out"
STUBEOF
chmod +x "$REFETCH_STUB/curl"
(cd "$REFETCH_REPO" && PATH="$REFETCH_STUB:$PATH" HOOK_OFFLINE=0 AGENT_REQUIRED_HOOKS=gerrit "$BIN" apply) >/dev/null 2>&1
(cd "$REFETCH_REPO" && PATH="$REFETCH_STUB:$PATH" HOOK_OFFLINE=0 AGENT_REQUIRED_HOOKS=gerrit "$BIN" apply) >/dev/null 2>&1
if [ "$(wc -l <"$COUNT_FILE")" -eq 1 ]; then
  echo "ok 34 - apply does not re-fetch an already-current gerrit profile"
else
  echo "not ok 34 - apply re-fetched a gerrit profile that was already current"
fi

# Test 35: options are rejected on subcommands they don't apply to, instead
# of being silently ignored (e.g. 'list --force' succeeding as a no-op).
if ! (cd "$REPO" && "$BIN" list --force) >/dev/null 2>&1 &&
  ! (cd "$REPO" && "$BIN" doctor --all) >/dev/null 2>&1 &&
  ! (cd "$REPO" && "$BIN" clean --copy) >/dev/null 2>&1; then
  echo "ok 35 - options outside their documented subcommands are rejected"
else
  echo "not ok 35 - an option outside its subcommand was silently accepted"
fi

# Test 36: missing dependency failure exits 127
NO_PRETTIER_STUB="$WORK/no-prettier"
mkdir -p "$NO_PRETTIER_STUB"
printf '%s\n' '#!/bin/sh' 'exit 1' >"$NO_PRETTIER_STUB/npx"
chmod +x "$NO_PRETTIER_STUB/npx"
MISSING_DEP_REPO=$(new_repo missingdep)
rc=0
(cd "$MISSING_DEP_REPO" && PATH="$NO_PRETTIER_STUB:$GIT_DIR_ON_PATH:/usr/bin:/bin" "$BIN" add node) >/dev/null 2>&1 || rc=$?
if [ "$rc" -eq 127 ]; then
  echo "ok 36 - missing dependency failure exits 127"
else
  echo "not ok 36 - missing dependency failure should exit 127 (got $rc)"
fi

# Test 37: explicit 'add gerrit' re-fetches when already current
: >"$COUNT_FILE"
(cd "$REFETCH_REPO" && PATH="$REFETCH_STUB:$PATH" HOOK_OFFLINE=0 "$BIN" add gerrit) >/dev/null 2>&1
if [ "$(wc -l <"$COUNT_FILE")" -eq 1 ]; then
  echo "ok 37 - explicit 'add gerrit' re-fetches when already current"
else
  echo "not ok 37 - explicit 'add gerrit' did not re-fetch"
fi

# Test 38: catalog succeeds outside a git repository
NON_REPO_DIR=$(mktemp -d "/tmp/non-repo.XXXXXX")
rc=0
cat_out=$(cd "$NON_REPO_DIR" && "$BIN" catalog 2>&1) || rc=$?
rm -rf "$NON_REPO_DIR"
if [ "$rc" -eq 0 ] && printf '%s' "$cat_out" | grep -q '^agent'; then
  echo "ok 38 - catalog runs outside a git repository"
else
  echo "not ok 38 - catalog failed outside a git repository (rc=$rc)"
fi

# Test 39: clean --force without --all is rejected
rc=0
(cd "$REPO" && "$BIN" clean --force) >/dev/null 2>&1 || rc=$?
if [ "$rc" -ne 0 ]; then
  echo "ok 39 - clean --force without --all is rejected"
else
  echo "not ok 39 - clean --force without --all was accepted"
fi

