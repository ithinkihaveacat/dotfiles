#!/usr/bin/env bash

# Tests: tests/test-install-only (install.sh --only)

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../install.sh"

if ! command -v uv >/dev/null 2>&1; then
  echo "1..0 # SKIP uv not available"
  exit 0
fi

echo "1..5"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/home"

# Test 1: unknown part
status=0
output=$("$BIN" --only bogus 2>&1) || status=$?
if [[ $status -eq 1 && "$output" == *"--only: unknown part 'bogus'"* ]]; then
  echo "ok 1 - --only rejects an unknown part"
else
  echo "not ok 1 - --only rejects an unknown part (status $status)"
fi

# Test 2: missing argument
status=0
output=$("$BIN" --only 2>&1) || status=$?
if [[ $status -eq 1 && "$output" == *"--only requires an argument"* ]]; then
  echo "ok 2 - --only requires an argument"
else
  echo "not ok 2 - --only requires an argument (status $status)"
fi

# Tests 3-5: verify-only run against an empty cache and an empty HOME. The
# index points at an unroutable address so a stray network request fails
# instead of silently succeeding.
status=0
output=$(HOME="$TMP/home" UV_OFFLINE=1 UV_CACHE_DIR="$TMP/cache" \
  UV_TOOL_DIR="$TMP/tools" UV_TOOL_BIN_DIR="$TMP/tool-bin" \
  UV_DEFAULT_INDEX="http://127.0.0.1:9/simple" "$BIN" --only uv 2>&1) || status=$?
if [[ $status -ne 0 && "$output" == *"not available offline"* ]]; then
  echo "ok 3 - offline --only uv against an empty cache exits non-zero"
else
  echo "not ok 3 - offline --only uv against an empty cache exits non-zero (status $status)"
  printf '%s\n' "$output" | sed 's/^/# /'
fi

if [[ "$output" == *"missing  skills/coding-standards/scripts/shell-format"* ]]; then
  echo "ok 4 - offline --only uv names the uncached uvx wrapper"
else
  echo "not ok 4 - offline --only uv names the uncached uvx wrapper"
fi

# --only must not touch anything outside the uv part: no dotfile symlinks.
if [[ -z "$(find "$TMP/home" -mindepth 1 -maxdepth 1 ! -name .local)" ]]; then
  echo "ok 5 - --only uv leaves HOME alone apart from ~/.local"
else
  echo "not ok 5 - --only uv leaves HOME alone apart from ~/.local"
  find "$TMP/home" -mindepth 1 -maxdepth 1 | sed 's/^/# /'
fi
