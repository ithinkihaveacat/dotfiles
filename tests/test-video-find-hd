#!/usr/bin/env bash

# Tests: tests/test-video-find-hd

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../bin/video-find-hd"

TMPDIR=$(mktemp -d)
OUTPUT=$(mktemp)
trap 'rm -rf "$TMPDIR"; rm -f "$OUTPUT"' EXIT

STUB_BIN="$TMPDIR/bin"
GOOD_DIR="$TMPDIR/nested"
mkdir -p "$STUB_BIN" "$GOOD_DIR"

cat >"$STUB_BIN/ffprobe" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
file="${@: -1}"
if [[ "$*" == *"format=bit_rate"* ]]; then
  case "$file" in
    *hd-fallback.mp4) echo "4000000" ;;
    *) echo "N/A" ;;
  esac
  exit 0
fi
case "$file" in
  *hd-good.mp4) echo "1280|720|4000000" ;;
  *hd-fallback.mp4) echo "1280|720|N/A" ;;
  *hd-low.mp4) echo "1280|720|800000" ;;
  *sd-high.mp4) echo "640|360|4000000" ;;
  *) exit 1 ;;
esac
EOF
chmod +x "$STUB_BIN/ffprobe"
export PATH="$STUB_BIN:$PATH"

GOOD_VIDEO="$GOOD_DIR/hd-good.mp4"
FALLBACK_VIDEO="$GOOD_DIR/hd-fallback.mp4"
LOW_BITRATE_VIDEO="$TMPDIR/hd-low.mp4"
LOW_RES_VIDEO="$TMPDIR/sd-high.mp4"
: >"$GOOD_VIDEO"
: >"$FALLBACK_VIDEO"
: >"$LOW_BITRATE_VIDEO"
: >"$LOW_RES_VIDEO"

echo "1..4"

if "$BIN" --help >"$OUTPUT" 2>&1 && grep -q "Usage: video-find-hd" "$OUTPUT"; then
  echo "ok 1 - help output includes usage"
else
  echo "not ok 1 - help output failed"
  sed 's/^/# /' "$OUTPUT"
fi

if "$BIN" >"$OUTPUT" 2>&1; then
  echo "not ok 2 - missing operand should fail"
  sed 's/^/# /' "$OUTPUT"
elif grep -q "missing directory operand" "$OUTPUT"; then
  echo "ok 2 - missing operand is reported"
else
  echo "not ok 2 - missing operand message not found"
  sed 's/^/# /' "$OUTPUT"
fi

RESULT=$("$BIN" "$TMPDIR")
EXPECTED=$(printf '%s\n%s' "$FALLBACK_VIDEO" "$GOOD_VIDEO")
if [[ "$RESULT" == "$EXPECTED" ]]; then
  echo "ok 3 - only qualifying HD videos are listed (including format=bit_rate fallback)"
else
  echo "not ok 3 - unexpected qualifying files"
  printf '%s\n' "$RESULT" | sed 's/^/# /'
fi

RESULT=$("$BIN" --min-width 1920 "$TMPDIR")
if [[ -z "$RESULT" ]]; then
  echo "ok 4 - stricter size filter excludes 720p results"
else
  echo "not ok 4 - stricter size filter should have excluded all files"
  printf '%s\n' "$RESULT" | sed 's/^/# /'
fi
