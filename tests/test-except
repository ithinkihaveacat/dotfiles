#!/usr/bin/env fish

# Tests: tests/test-except

set -l dir (path dirname (status filename))
source $dir/../fish/functions/except.fish

echo "1..7"

set -g test_num 0

function assert_equal --argument-names actual expected description
    set -g test_num (math $test_num + 1)
    if test "$actual" = "$expected"
        echo "ok $test_num - $description"
        return 0
    else
        echo "not ok $test_num - $description"
        echo "#   expected: (string escape -- $expected)"
        echo "#   got:      (string escape -- $actual)"
        return 1
    end
end

function assert_contains --argument-names output pattern description
    set -g test_num (math $test_num + 1)
    if string match -q -- "*$pattern*" "$output"
        echo "ok $test_num - $description"
        return 0
    else
        echo "not ok $test_num - $description"
        echo "#   pattern not found in output: (string escape -- $pattern)"
        echo "#   got: (string escape -- $output)"
        return 1
    end
end

# Test 1: Piped string exclusion (-s)
set -l out (printf '%s\n' alpha beta gamma | except -s beta | string join '\n')
assert_equal "$out" "alpha\ngamma" "piped string exclusion with -s"

# Test 2: Piped glob exclusion (--stdin)
set -l out (printf '%s\n' foo.txt bar.txt baz.log | except --stdin '*.txt' | string join '\n')
assert_equal "$out" "baz.log" "piped glob pattern exclusion with --stdin"

# Test 3: Piped multiple exclusions (-s)
set -l out (printf '%s\n' one two three four five | except -s one 't*' | string join '\n')
assert_equal "$out" "four\nfive" "piped multiple exclusion arguments with -s"

# Test 4: Piped passthrough with no arguments (-s)
set -l out (printf '%s\n' cat dog | except -s | string join '\n')
assert_equal "$out" "cat\ndog" "passthrough when no exclusion arguments provided with -s"

# Test 5: Leading dash items are silently dropped for safety
set -l out (printf '%s\n' foo.txt -rf bar.txt --force baz.log | except -s '*.txt' | string join '\n')
assert_equal "$out" "baz.log" "silently excludes leading-dash items for flag-injection safety"

# Test 6: Standalone directory globbing (default mode, no pipe)
set -l work (mktemp -d)
touch $work/foo.txt $work/-rf $work/bar.txt $work/baz.log
pushd $work >/dev/null
set -l out (except '*.txt' | string join '\n')
popd >/dev/null
rm -rf $work
assert_equal "$out" "baz.log" "standalone directory globbing excludes *.txt and drops -rf"

# Test 7: --help flag prints usage
set -l out (except --help | string join '\n')
assert_contains "$out" "Usage: except" "--help displays usage information"
