#!/usr/bin/env bash

# Tests: tests/test-git-sync

set -u

# Isolate from global/system git config (signing, hooks, templates).
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../bin/git-sync"

echo "1..18"

# Test 1: --help exits zero and includes required sections
if out=$("$BIN" --help 2>&1) &&
  [[ "$out" == *'Usage:'* ]] &&
  [[ "$out" == *'Options:'* ]] &&
  [[ "$out" == *'Examples:'* ]] &&
  [[ "$out" == *'--enable'* ]] &&
  [[ "$out" == *'--disable'* ]] &&
  [[ "$out" == *'--dry-run'* ]]; then
  echo "ok 1 - --help documents usage, options, and examples"
else
  echo "not ok 1 - --help output incomplete or failed"
fi

# Test 2: -h alias works
if "$BIN" -h >/dev/null 2>&1; then
  echo "ok 2 - -h alias works"
else
  echo "not ok 2 - -h alias failed"
fi

# Test 3: unrecognized option exits 1 with error on stderr
err_out=$("$BIN" --invalid-flag 2>&1 || true)
rc=0
"$BIN" --invalid-flag >/dev/null 2>&1 || rc=$?
if [ "$rc" -eq 1 ] && [[ "$err_out" == *"unrecognized option '--invalid-flag'"* ]]; then
  echo "ok 3 - unrecognized option exits 1 with error"
else
  echo "not ok 3 - unrecognized option handling failed (rc=$rc)"
fi

WORK=$(mktemp -d "/tmp/git-sync-test.XXXXXX")
trap 'rm -rf "$WORK"' EXIT

# Test 4: running outside a git repository exits 1
NON_REPO="$WORK/non-repo"
mkdir -p "$NON_REPO"
rc=0
err_out=$(cd "$NON_REPO" && "$BIN" 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && [[ "$err_out" == *'not a git repository'* ]]; then
  echo "ok 4 - non-git repository execution fails cleanly with exit code 1"
else
  echo "not ok 4 - non-git repository handling failed (rc=$rc)"
fi

# Test 5: missing dependency exits 127
STUB_DIR="$WORK/stubs"
mkdir -p "$STUB_DIR"
ln -s "$(command -v bash)" "$STUB_DIR/bash"
rc=0
err_out=$(PATH="$STUB_DIR" "$BIN" --help 2>&1) || rc=$?
if [ "$rc" -eq 127 ] && [[ "$err_out" == *'git not found'* ]]; then
  echo "ok 5 - missing dependency (git) exits 127"
else
  echo "not ok 5 - missing dependency expected 127 (got $rc: $err_out)"
fi

# Setup a local remote bare repo and a working clone
BARE_REMOTE="$WORK/remote.git"
git init --bare -q "$BARE_REMOTE"

REPO="$WORK/local-repo"
git clone -q "$BARE_REMOTE" "$REPO"
git -C "$REPO" -c user.name="Test" -c user.email="test@example.com" checkout -q -b main
echo "initial" >"$REPO/file.txt"
git -C "$REPO" add file.txt
git -C "$REPO" -c user.name="Test" -c user.email="test@example.com" commit -q -m "initial commit"
git -C "$REPO" push -q -u origin main >/dev/null 2>&1
git -C "$BARE_REMOTE" symbolic-ref HEAD refs/heads/main

# Test 6: extra positional arguments are rejected
rc=0
err_out=$(cd "$REPO" && "$BIN" extra 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && [[ "$err_out" == *"extra operand 'extra'"* ]]; then
  echo "ok 6 - extra positional operand is rejected"
else
  echo "not ok 6 - extra positional operand handling failed (rc=$rc)"
fi

# Test 7: mutually exclusive --enable and --disable
rc=0
err_out=$(cd "$REPO" && "$BIN" --enable --disable 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && [[ "$err_out" == *'cannot specify both --enable and --disable'* ]]; then
  echo "ok 7 - mutually exclusive --enable and --disable rejected"
else
  echo "not ok 7 - mutually exclusive flags handling failed (rc=$rc)"
fi

# Test 8: detached HEAD state is rejected
DETACHED_COMMIT=$(git -C "$REPO" rev-parse HEAD)
git -C "$REPO" checkout -q "$DETACHED_COMMIT"
git -C "$REPO" config --local sync.enabled true
rc=0
err_out=$(cd "$REPO" && "$BIN" 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && [[ "$err_out" == *'cannot sync in detached HEAD state'* ]]; then
  echo "ok 8 - detached HEAD state is rejected"
else
  echo "not ok 8 - detached HEAD state handling failed (rc=$rc)"
fi
git -C "$REPO" checkout -q main
git -C "$REPO" config --local --unset sync.enabled

# Test 9: repository without remotes is rejected
NO_REMOTE_REPO="$WORK/no-remote"
git init -q "$NO_REMOTE_REPO"
git -C "$NO_REMOTE_REPO" -c user.name="Test" -c user.email="test@example.com" commit --allow-empty -q -m "init"
git -C "$NO_REMOTE_REPO" config --local sync.enabled true
rc=0
err_out=$(cd "$NO_REMOTE_REPO" && "$BIN" 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && [[ "$err_out" == *'no remote repositories configured'* ]]; then
  echo "ok 9 - repository without remotes is rejected"
else
  echo "not ok 9 - repository without remotes handling failed (rc=$rc)"
fi

# Test 10: sync not enabled exits 1 with actionable message
rc=0
err_out=$(cd "$REPO" && "$BIN" 2>&1) || rc=$?
if [ "$rc" -eq 1 ] &&
  [[ "$err_out" == *'sync is not enabled for this repository'* ]] &&
  [[ "$err_out" == *'--enable'* ]]; then
  echo "ok 10 - unconfigured repository exits 1 with actionable enable message"
else
  echo "not ok 10 - unconfigured repository error handling failed (rc=$rc)"
fi

# Test 11: --disable on unconfigured repo exits 0
rc=0
out=$(cd "$REPO" && "$BIN" --disable 2>&1) || rc=$?
if [ "$rc" -eq 0 ] && [[ "$out" == *'sync is not enabled for this repository'* ]]; then
  echo "ok 11 - --disable on unconfigured repository exits 0"
else
  echo "not ok 11 - --disable on unconfigured repo failed (rc=$rc)"
fi

# Test 12: --enable sets sync.enabled to true and executes sync
echo "second" >>"$REPO/file.txt"
git -C "$REPO" -c user.name="Test" -c user.email="test@example.com" commit -q -am "second commit"
rc=0
out=$(cd "$REPO" && "$BIN" --enable 2>&1) || rc=$?
val=$(git -C "$REPO" config --local --get sync.enabled 2>/dev/null || true)
if [ "$rc" -eq 0 ] && [ "$val" = "true" ] && [[ "$out" == *'enabled sync for this repository'* ]]; then
  echo "ok 12 - --enable sets sync.enabled to true and executes sync"
else
  echo "not ok 12 - --enable failed (rc=$rc, val=$val)"
fi

# Test 13: bare execution succeeds when sync.enabled is true
echo "third" >>"$REPO/file.txt"
git -C "$REPO" -c user.name="Test" -c user.email="test@example.com" commit -q -am "third commit"
rc=0
(cd "$REPO" && "$BIN") >/dev/null 2>&1 || rc=$?
remote_head=$(git -C "$BARE_REMOTE" rev-parse refs/heads/main)
local_head=$(git -C "$REPO" rev-parse HEAD)
if [ "$rc" -eq 0 ] && [ "$remote_head" = "$local_head" ]; then
  echo "ok 13 - bare execution succeeds and pushes commits when sync.enabled is true"
else
  echo "not ok 13 - bare execution failed (rc=$rc)"
fi

# Test 14: --disable unsets sync.enabled
rc=0
out=$(cd "$REPO" && "$BIN" --disable 2>&1) || rc=$?
val=$(git -C "$REPO" config --local --get sync.enabled 2>/dev/null || true)
if [ "$rc" -eq 0 ] && [ -z "$val" ] && [[ "$out" == *'disabled sync for this repository'* ]]; then
  echo "ok 14 - --disable unsets sync.enabled"
else
  echo "not ok 14 - --disable unsetting failed (rc=$rc, val=$val)"
fi

# Test 15: sync.enabled = false in local config is rejected
git -C "$REPO" config --local sync.enabled false
rc=0
err_out=$(cd "$REPO" && "$BIN" 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && [[ "$err_out" == *'sync is not enabled for this repository'* ]]; then
  echo "ok 15 - sync.enabled set to false is rejected"
else
  echo "not ok 15 - sync.enabled = false handling failed (rc=$rc)"
fi
git -C "$REPO" config --local --unset sync.enabled

# Test 16: --force syncs without sync.enabled configured
echo "fourth" >>"$REPO/file.txt"
git -C "$REPO" -c user.name="Test" -c user.email="test@example.com" commit -q -am "fourth commit"
rc=0
(cd "$REPO" && "$BIN" --force) >/dev/null 2>&1 || rc=$?
remote_head=$(git -C "$BARE_REMOTE" rev-parse refs/heads/main)
local_head=$(git -C "$REPO" rev-parse HEAD)
if [ "$rc" -eq 0 ] && [ "$remote_head" = "$local_head" ]; then
  echo "ok 16 - --force syncs without sync.enabled configured"
else
  echo "not ok 16 - --force failed (rc=$rc)"
fi

# Test 17: --dry-run performs trial run without modifying remote or failing
git -C "$REPO" config --local sync.enabled true
echo "fifth" >>"$REPO/file.txt"
git -C "$REPO" -c user.name="Test" -c user.email="test@example.com" commit -q -am "fifth commit"
rc=0
out=$(cd "$REPO" && "$BIN" --dry-run 2>&1) || rc=$?
remote_head=$(git -C "$BARE_REMOTE" rev-parse refs/heads/main)
local_head=$(git -C "$REPO" rev-parse HEAD)
if [ "$rc" -eq 0 ] && [ "$remote_head" != "$local_head" ] && [[ "$out" == *'dry-run:'* ]]; then
  echo "ok 17 - --dry-run performs trial run without modifying remote"
else
  echo "not ok 17 - --dry-run failed (rc=$rc)"
fi

# Test 18: autostash shelves dirty changes, syncs, and restores dirty changes
echo "sixth" >>"$REPO/file.txt"
git -C "$REPO" -c user.name="Test" -c user.email="test@example.com" commit -q -am "sixth commit"
echo "uncommitted dirty change" >>"$REPO/file.txt"
rc=0
(cd "$REPO" && "$BIN") >/dev/null 2>&1 || rc=$?
remote_head=$(git -C "$BARE_REMOTE" rev-parse refs/heads/main)
local_head=$(git -C "$REPO" rev-parse HEAD)
if [ "$rc" -eq 0 ] && [ "$remote_head" = "$local_head" ] && grep -q "uncommitted dirty change" "$REPO/file.txt"; then
  echo "ok 18 - autostash preserves uncommitted dirty changes across sync"
else
  echo "not ok 18 - autostash failed (rc=$rc)"
fi
