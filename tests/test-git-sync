#!/usr/bin/env bash

# Tests: tests/test-git-sync

set -u

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../bin/git-sync"

echo "1..21"

# Test 1: --help exits zero and includes required sections
if out=$("$BIN" --help 2>&1) &&
  printf '%s' "$out" | grep -q 'Usage:' &&
  printf '%s' "$out" | grep -q 'Commands:' &&
  printf '%s' "$out" | grep -q 'Options:' &&
  printf '%s' "$out" | grep -q 'Examples:' &&
  printf '%s' "$out" | grep -q -- '--dry-run'; then
  echo "ok 1 - --help documents usage, commands, options, and examples"
else
  echo "not ok 1 - --help output incomplete or failed"
fi

# Test 2: -h alias works
if "$BIN" -h >/dev/null 2>&1; then
  echo "ok 2 - -h alias works"
else
  echo "not ok 2 - -h alias failed"
fi

# Test 3: unrecognized option exits 1 with error on stderr
err_out=$("$BIN" --invalid-flag 2>&1 || true)
rc=0
"$BIN" --invalid-flag >/dev/null 2>&1 || rc=$?
if [ "$rc" -eq 1 ] && printf '%s' "$err_out" | grep -q "unrecognized option '--invalid-flag'"; then
  echo "ok 3 - unrecognized option exits 1 with error"
else
  echo "not ok 3 - unrecognized option handling failed (rc=$rc)"
fi

WORK=$(mktemp -d "/tmp/git-sync-test.XXXXXX")
trap 'rm -rf "$WORK"' EXIT

# Test 4: running outside a git repository exits 1
NON_REPO="$WORK/non-repo"
mkdir -p "$NON_REPO"
rc=0
err_out=$(cd "$NON_REPO" && "$BIN" list 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && printf '%s' "$err_out" | grep -q "not a git repository"; then
  echo "ok 4 - non-git repository execution fails cleanly with exit code 1"
else
  echo "not ok 4 - non-git repository handling failed (rc=$rc)"
fi

# Test 5: missing dependency exits 127
STUB_DIR="$WORK/stubs"
mkdir -p "$STUB_DIR"
ln -s "$(command -v bash)" "$STUB_DIR/bash"
ln -s "$(command -v git)" "$STUB_DIR/git"
rc=0
err_out=$(PATH="$STUB_DIR" "$BIN" list 2>&1) || rc=$?
if [ "$rc" -eq 127 ] && printf '%s' "$err_out" | grep -q "rsync not found"; then
  echo "ok 5 - missing dependency (rsync) exits 127"
else
  echo "not ok 5 - missing dependency expected 127 (got $rc: $err_out)"
fi

# Setup a test Git repository
REPO="$WORK/test-repo"
mkdir -p "$REPO"
git -C "$REPO" init -q
echo "file1 content" >"$REPO/file1.txt"
echo "ignored content" >"$REPO/ignored.log"
echo "*.log" >"$REPO/.gitignore"
git -C "$REPO" add file1.txt .gitignore
git -C "$REPO" -c user.name="Test" -c user.email="test@example.com" commit -q -m "initial commit"
echo "untracked unignored" >"$REPO/untracked.txt"

# Test 6: bare invocation with no targets registered exits 1 with guidance
rc=0
err_out=$(cd "$REPO" && "$BIN" 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && printf '%s' "$err_out" | grep -q "no sync targets registered"; then
  echo "ok 6 - bare invocation with no targets registered exits 1"
else
  echo "not ok 6 - bare invocation should exit 1 when empty (rc=$rc)"
fi

# Test 7: list with no targets registered exits 0
rc=0
list_out=$(cd "$REPO" && "$BIN" list 2>&1) || rc=$?
if [ "$rc" -eq 0 ] && printf '%s' "$list_out" | grep -q "No sync targets registered."; then
  echo "ok 7 - list with no targets registered exits 0"
else
  echo "not ok 7 - list should exit 0 when empty (rc=$rc)"
fi

# Test 8: add without required arguments fails
rc=0
err_out=$(cd "$REPO" && "$BIN" add 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && printf '%s' "$err_out" | grep -q "missing required arguments"; then
  echo "ok 8 - add without arguments fails"
else
  echo "not ok 8 - add without arguments should fail (rc=$rc)"
fi

# Test 9: add with reserved name fails
rc=0
err_out=$(cd "$REPO" && "$BIN" add list /tmp/dest 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && printf '%s' "$err_out" | grep -q "is a reserved command name"; then
  echo "ok 9 - add with reserved name is rejected"
else
  echo "not ok 9 - add with reserved name should fail (rc=$rc)"
fi

# Test 10: add with invalid target name fails
rc=0
err_out=$(cd "$REPO" && "$BIN" add "bad name!" /tmp/dest 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && printf '%s' "$err_out" | grep -q "invalid target name"; then
  echo "ok 10 - add with invalid target name is rejected"
else
  echo "not ok 10 - add with invalid target name should fail (rc=$rc)"
fi

# Test 11: add destination as repo root is rejected
rc=0
err_out=$(cd "$REPO" && "$BIN" add root "$REPO" 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && printf '%s' "$err_out" | grep -q "destination cannot be the source repository"; then
  echo "ok 11 - add destination as repo root is rejected"
else
  echo "not ok 11 - add destination as repo root should fail (rc=$rc)"
fi

# Test 12: add destination inside repo is rejected
rc=0
err_out=$(cd "$REPO" && "$BIN" add inner "$REPO/subdir" 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && printf '%s' "$err_out" | grep -q "destination cannot be inside the source repository"; then
  echo "ok 12 - add destination inside repo is rejected"
else
  echo "not ok 12 - add destination inside repo should fail (rc=$rc)"
fi

# Test 13: add registers a target in git config and creates destination
DEST1="$WORK/mirror1"
add_out=$(cd "$REPO" && "$BIN" add backup "$DEST1")
DEST1_ABS=$(cd "$DEST1" && pwd -P)
if [ "$(git -C "$REPO" config --get sync.target.backup)" = "$DEST1_ABS" ] &&
  [ -d "$DEST1" ] &&
  printf '%s' "$add_out" | grep -q "Registered sync target 'backup'"; then
  echo "ok 13 - add registers target in git config"
else
  echo "not ok 13 - add failed to register target in git config"
fi

# Test 14: list displays registered targets
list_out=$(cd "$REPO" && "$BIN" list)
if printf '%s' "$list_out" | grep -q "backup" &&
  printf '%s' "$list_out" | grep -q "$DEST1_ABS"; then
  echo "ok 14 - list displays registered targets"
else
  echo "not ok 14 - list did not show registered target"
fi

# Test 15: sync to named target copies files and respects exclusions
(cd "$REPO" && "$BIN" backup) >/dev/null 2>&1
if [ -f "$DEST1/file1.txt" ] &&
  [ -f "$DEST1/untracked.txt" ] &&
  [ ! -e "$DEST1/.git" ] &&
  [ ! -e "$DEST1/ignored.log" ]; then
  echo "ok 15 - sync copies files, respects .gitignore, and excludes .git/"
else
  echo "not ok 15 - sync to named target content verification failed"
fi

# Test 16: sync prunes deleted files
rm -f "$REPO/untracked.txt"
(cd "$REPO" && "$BIN" backup) >/dev/null 2>&1
if [ ! -e "$DEST1/untracked.txt" ]; then
  echo "ok 16 - deleted files are pruned in destination"
else
  echo "not ok 16 - deleted file was not pruned"
fi

# Test 17: sync to multiple targets via 'all'
DEST2="$WORK/mirror2"
(cd "$REPO" && "$BIN" add cloud "$DEST2") >/dev/null 2>&1
(cd "$REPO" && "$BIN" all) >/dev/null 2>&1
if [ -f "$DEST1/file1.txt" ] && [ -f "$DEST2/file1.txt" ]; then
  echo "ok 17 - sync all synchronizes multiple targets"
else
  echo "not ok 17 - sync all failed to sync both targets"
fi

# Test 18: --dry-run does not write new changes
echo "new dry file" >"$REPO/dry.txt"
(cd "$REPO" && "$BIN" --dry-run backup) >/dev/null 2>&1
if [ ! -e "$DEST1/dry.txt" ]; then
  echo "ok 18 - --dry-run does not write files to destination"
else
  echo "not ok 18 - --dry-run wrote file to destination"
fi
rm -f "$REPO/dry.txt"

# Test 19: destination directory missing reports error
DEST_TEMP="$WORK/missing_dest"
(cd "$REPO" && "$BIN" add temp "$DEST_TEMP") >/dev/null 2>&1
rm -rf "$DEST_TEMP"
rc=0
err_out=$(cd "$REPO" && "$BIN" temp 2>&1) || rc=$?
if [ "$rc" -eq 1 ] && printf '%s' "$err_out" | grep -q "destination directory does not exist"; then
  echo "ok 19 - missing destination directory fails with clear error"
else
  echo "not ok 19 - missing destination directory should fail (rc=$rc)"
fi
(cd "$REPO" && "$BIN" rm temp) >/dev/null 2>&1

# Test 20: invocation from deep subdirectory works
NESTED_SUBDIR="$REPO/a/deep/nested/dir"
mkdir -p "$NESTED_SUBDIR"
echo "nested content" >"$NESTED_SUBDIR/nested.txt"
(cd "$NESTED_SUBDIR" && "$BIN" backup) >/dev/null 2>&1
if [ -f "$DEST1/a/deep/nested/dir/nested.txt" ]; then
  echo "ok 20 - invocation from nested subdirectory mirrors entire repo"
else
  echo "not ok 20 - nested invocation failed"
fi

# Test 21: remove unregisters target
(cd "$REPO" && "$BIN" rm cloud) >/dev/null 2>&1
if [ -z "$(git -C "$REPO" config --get sync.target.cloud)" ]; then
  echo "ok 21 - remove unregisters target from git config"
else
  echo "not ok 21 - remove failed to unregister target"
fi
