#!/usr/bin/env bash

# Tests: tests/test-fish-completions
#
# Checks every fish completion file against the command it completes:
#
# - A skill script's completion lives in its skill, as
#   skills/SKILL/completions/NAME.fish beside skills/SKILL/scripts/NAME, and
#   fish/completions/ holds only completions for bin/ scripts and fish
#   functions.
# - The options a script's --help defines (indented lines that start with a
#   dash) are all completed, and, for a script without subcommands, every
#   completed option is defined by --help. A subcommand's options are not
#   listed in the top-level --help, so the second check would misfire there.

if ! command -v fish >/dev/null 2>&1; then
  echo "1..0 # SKIP fish not installed"
  exit 0
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
cd "$ROOT" || exit 1

test_num=0
failed=0

ok() {
  test_num=$((test_num + 1))
  echo "ok $test_num - $1"
}

not_ok() {
  test_num=$((test_num + 1))
  failed=1
  echo "not ok $test_num - $1"
  shift
  local line
  for line in "$@"; do
    echo "#   $line"
  done
}

# Options defined by help text on stdin, one per line (--long or -s). Only the
# option column of an indented line that starts with an option counts, so
# options mentioned in prose or in another command's examples do not. Every
# script that takes --help also takes -h, whether or not its help says so.
help_options() {
  local line spec word
  local -a words
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]+-{1,2}[A-Za-z0-9] ]] || continue
    spec=${line#"${line%%[![:space:]]*}"}
    spec=${spec%%  *}
    read -r -a words <<<"${spec//[\[\],|]/ }"
    [[ ${words[0]} =~ ^-{1,2}[A-Za-z0-9][A-Za-z0-9-]*(=.*)?$ ]] || continue
    for word in "${words[@]}"; do
      case $word in
        --[A-Za-z0-9]*)
          word=${word#--}
          printf -- '--%s\n' "${word%%[!A-Za-z0-9-]*}"
          [[ $word == help ]] && printf -- '-h\n'
          ;;
        -[A-Za-z0-9])
          printf '%s\n' "$word"
          ;;
      esac
    done
  done
}

# Completions collected in one fish --no-config invocation into WORK/comp.<idx>.
check_options() {
  local name=$1 comp_file=$2 help_file=$3 rc_file=$4
  local help status=0 expected actual missing extra
  local -a details=()

  read -r status <"$rc_file"
  help=$(<"$help_file")
  if [[ $status -ne 0 ]]; then
    not_ok "$name: --help exits 0" "exit status $status" "${help%%$'\n'*}"
    return
  fi

  expected=$(help_options <<<"$help" | sort -u)
  actual=$(
    sed -E "s/'([^'\\\\]|\\\\.)*'//g" "$comp_file" |
      { grep -oE ' -[lso] [^ ]+' || true; } |
      sed -E 's/^ -l /--/; s/^ -s /-/; s/^ -o /-/' |
      sort -u
  )

  missing=$(comm -23 <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") | { grep . || true; } | tr '\n' ' ')
  [[ -n $missing ]] && details+=("in --help but not completed: $missing")

  if ! grep -qF ' -n ' "$comp_file"; then
    extra=$(comm -13 <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") | { grep . || true; } | tr '\n' ' ')
    [[ -n $extra ]] && details+=("completed but not in --help: $extra")
  fi

  if [[ ${#details[@]} -eq 0 ]]; then
    ok "$name: completion matches --help"
  else
    not_ok "$name: completion matches --help" "${details[@]}"
  fi
}

WORK=$(mktemp -d)
trap 'rm -rf -- "$WORK"' EXIT

declare -a item_kind=() item_arg1=() item_arg2=() item_arg3=()
declare -a check_indices=() fish_args=()

for file in skills/*/completions/*.fish; do
  [[ -e $file ]] || continue
  name=$(basename "$file" .fish)
  skill_dir=${file%/completions/*}
  script="$skill_dir/scripts/$name"
  idx=${#item_kind[@]}
  if [[ ! -x $script ]]; then
    item_kind+=("not_ok")
    item_arg1+=("$file: completes a script in its skill")
    item_arg2+=("no executable $script")
    item_arg3+=("")
    continue
  fi
  item_kind+=("check")
  item_arg1+=("$name")
  item_arg2+=("$file")
  item_arg3+=("$script")
  check_indices+=("$idx")
  fish_args+=("$WORK/comp.$idx" "$file" "$name")
done

for file in fish/completions/*.fish; do
  [[ -e $file ]] || continue
  name=$(basename "$file" .fish)
  idx=${#item_kind[@]}
  if [[ -L bin/$name ]]; then
    item_kind+=("not_ok")
    item_arg1+=("$file: completes a bin/ script or fish function")
    item_arg2+=("bin/$name links to $(readlink "bin/$name"); move the completion into that skill's completions/")
    item_arg3+=("")
  elif [[ -f bin/$name && -x bin/$name ]]; then
    item_kind+=("check")
    item_arg1+=("$name")
    item_arg2+=("$file")
    item_arg3+=("bin/$name")
    check_indices+=("$idx")
    fish_args+=("$WORK/comp.$idx" "$file" "$name")
  elif [[ -f fish/functions/$name.fish ]]; then
    item_kind+=("ok")
    item_arg1+=("$file: completes a fish function")
    item_arg2+=("")
    item_arg3+=("")
  else
    item_kind+=("not_ok")
    item_arg1+=("$file: completes a bin/ script or fish function")
    item_arg2+=("no bin/$name or fish/functions/$name.fish")
    item_arg3+=("")
  fi
done

if [[ ${#check_indices[@]} -gt 0 ]]; then
  # Collect all completions in a single fish process, clearing prior rules per cmd.
  # shellcheck disable=SC2016 # $argv and $i are expanded by fish, not bash
  fish --no-config -c '
    set -l n (count $argv)
    for i in (seq 1 3 $n)
      set -l out $argv[$i]
      set -l file $argv[(math $i + 1)]
      set -l cmd $argv[(math $i + 2)]
      complete -e -c $cmd
      source $file
      and complete -c $cmd > $out
    end
  ' "${fish_args[@]}"

  JOBS=8
  declare -a pids=()
  for idx in "${check_indices[@]}"; do
    script=${item_arg3[$idx]}
    (
      rc=0
      NO_COLOR=1 "$script" --help >"$WORK/help.$idx" 2>&1 </dev/null || rc=$?
      printf '%s\n' "$rc" >"$WORK/rc.$idx"
    ) &
    pids+=("$!")
    if [[ ${#pids[@]} -ge $JOBS ]]; then
      wait "${pids[0]}" || true
      pids=("${pids[@]:1}")
    fi
  done
  for pid in "${pids[@]}"; do
    wait "$pid" || true
  done
fi

for idx in "${!item_kind[@]}"; do
  case "${item_kind[$idx]}" in
    check)
      check_options "${item_arg1[$idx]}" "$WORK/comp.$idx" "$WORK/help.$idx" "$WORK/rc.$idx"
      ;;
    ok)
      ok "${item_arg1[$idx]}"
      ;;
    not_ok)
      not_ok "${item_arg1[$idx]}" "${item_arg2[$idx]}"
      ;;
  esac
done

echo "1..$test_num"
exit "$failed"
