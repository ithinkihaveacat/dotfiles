#!/usr/bin/env bash

# Tests: tests/test-fish-adb-completions

if ! command -v fish >/dev/null 2>&1; then
  echo "1..0 # SKIP fish not installed"
  exit 0
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
FUNCTION_FILE="$DIR/../fish/functions/__fish_android_devices.fish"
COMPLETIONS_DIR="$DIR/../fish/completions"

exec fish --no-config -c "
source '$FUNCTION_FILE'

echo '1..6'

set -g test_num 0

function assert_equal --argument-names actual expected description
    set -g test_num (math \$test_num + 1)
    if test \"\$actual\" = \"\$expected\"
        echo \"ok \$test_num - \$description\"
        return 0
    else
        echo \"not ok \$test_num - \$description\"
        echo \"#   expected: (string escape -- \$expected)\"
        echo \"#   got:      (string escape -- \$actual)\"
        return 1
    end
end

function assert_contains --argument-names output pattern description
    set -g test_num (math \$test_num + 1)
    if string match -q -- \"*\$pattern*\" \"\$output\"
        echo \"ok \$test_num - \$description\"
        return 0
    else
        echo \"not ok \$test_num - \$description\"
        echo \"#   pattern not found in output: (string escape -- \$pattern)\"
        echo \"#   got: (string escape -- \$output)\"
        return 1
    end
end

# Test 1: Mock adb devices -l parsing with diverse outputs
function adb
    if test \"\$argv[1]\" = 'devices'; and test \"\$argv[2]\" = '-l'
        printf '* daemon not running; starting now at tcp:5037\n'
        printf '* daemon started successfully\n'
        printf 'List of devices attached\n'
        printf '3C051JEAVL00D8         device usb:2-1.2 product:selene model:Pixel_Watch_3 device:selene transport_id:4\n'
        printf '67271LSIGL005V         device usb:2-1.1.1 product:merritt_lte model:Pixel_Watch_6 device:merritt_lte transport_id:5\n'
        printf 'emulator-5554          device product:sdk_gwear_arm64 model:sdk_gwear_arm64 device:emu64a transport_id:1\n'
        printf 'ONLY_MODEL             device model:JustModel transport_id:6\n'
        printf 'ONLY_PROD              device product:JustProduct transport_id:7\n'
        printf 'UNAUTH_DEVICE          unauthorized usb:2-2\n'
        printf 'OFFLINE_DEVICE         offline\n'
        printf '\n'
    end
end

set -l out (__fish_android_devices | string join '\n')
set -l expected (printf '%s\t%s\n' \
    3C051JEAVL00D8 'selene Pixel_Watch_3' \
    67271LSIGL005V 'merritt_lte Pixel_Watch_6' \
    emulator-5554 'sdk_gwear_arm64 sdk_gwear_arm64' \
    ONLY_MODEL 'JustModel' \
    ONLY_PROD 'JustProduct' \
    UNAUTH_DEVICE 'unauthorized' \
    OFFLINE_DEVICE 'offline' | string join '\n')
assert_equal \"\$out\" \"\$expected\" '__fish_android_devices parses adb devices -l output correctly'

# Test 2: Completion for adb-device-properties -s prefix
source '$COMPLETIONS_DIR/adb-device-properties.fish'
set -l comp_short (complete -C'adb-device-properties -s 3')
set -l exp_short (printf '%s\t%s' 3C051JEAVL00D8 'selene Pixel_Watch_3')
assert_equal \"\$comp_short\" \"\$exp_short\" 'adb-device-properties -s 3 completes device serial'

# Test 3: Completion for adb-device-properties --serial prefix
set -l comp_long (complete -C'adb-device-properties --serial 6')
set -l exp_long (printf '%s\t%s' 67271LSIGL005V 'merritt_lte Pixel_Watch_6')
assert_equal \"\$comp_long\" \"\$exp_long\" 'adb-device-properties --serial 6 completes device serial'

# Test 4: Completion for adb-screenshot -s
source '$COMPLETIONS_DIR/adb-screenshot.fish'
set -l comp_screenshot (complete -C'adb-screenshot -s emu')
set -l exp_emu (printf '%s\t%s' emulator-5554 'sdk_gwear_arm64 sdk_gwear_arm64')
assert_equal \"\$comp_screenshot\" \"\$exp_emu\" 'adb-screenshot -s completes emulator device'

# Test 5: Completion for adb-activities -s
source '$COMPLETIONS_DIR/adb-activities.fish'
set -l comp_activities (complete -C'adb-activities -s UNAUTH')
set -l exp_unauth (printf '%s\t%s' UNAUTH_DEVICE 'unauthorized')
assert_equal \"\$comp_activities\" \"\$exp_unauth\" 'adb-activities -s completes unauthorized device'

# Test 6: Completion for packagename -s
source '$COMPLETIONS_DIR/packagename.fish'
set -l comp_pkg (complete -C'packagename -s 3')
set -l exp_pkg (printf '%s\t%s' 3C051JEAVL00D8 'selene Pixel_Watch_3')
assert_equal \"\$comp_pkg\" \"\$exp_pkg\" 'packagename -s 3 completes device serial'
"
