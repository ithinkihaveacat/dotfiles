#!/usr/bin/env bash

# Tests: tests/test-prefetch-tools

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
BIN="$DIR/../bin/prefetch-tools"

if ! command -v uv >/dev/null 2>&1 || ! command -v uvx >/dev/null 2>&1; then
  echo "1..0 # SKIP uv not available"
  exit 0
fi

echo "1..5"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# Test 1: --help
status=0
output=$("$BIN" --help 2>&1) || status=$?
if [[ $status -eq 0 && "$output" == *"Usage: prefetch-tools"* ]]; then
  echo "ok 1 - --help prints usage and exits 0"
else
  echo "not ok 1 - --help prints usage and exits 0 (status $status)"
fi

# Test 2: -h matches --help
if [[ "$("$BIN" -h 2>&1)" == "$output" ]]; then
  echo "ok 2 - -h is an alias for --help"
else
  echo "not ok 2 - -h is an alias for --help"
fi

# Test 3: unknown option
status=0
output=$("$BIN" --bogus 2>&1) || status=$?
if [[ $status -eq 1 && "$output" == *"prefetch-tools: unknown option: --bogus"* ]]; then
  echo "ok 3 - unknown option exits 1 with an error"
else
  echo "not ok 3 - unknown option exits 1 with an error (status $status)"
fi

# Tests 4-5: offline against an empty cache. AGENT_OFFLINE must imply --check,
# so nothing is fetched; the index points at an unroutable address so a stray
# network request fails instead of silently succeeding.
status=0
output=$(AGENT_OFFLINE=1 UV_CACHE_DIR="$TMP/cache" \
  UV_DEFAULT_INDEX="http://127.0.0.1:9/simple" "$BIN" 2>&1) || status=$?
if [[ $status -eq 1 && "$output" == *"not available offline"* ]]; then
  echo "ok 4 - offline run against an empty cache exits 1"
else
  echo "not ok 4 - offline run against an empty cache exits 1 (status $status)"
  printf '%s\n' "$output" | sed 's/^/# /'
fi

if [[ "$output" == *"missing  skills/coding-standards/scripts/shell-format"* ]]; then
  echo "ok 5 - offline run names the uncached uvx wrapper"
else
  echo "not ok 5 - offline run names the uncached uvx wrapper"
fi
